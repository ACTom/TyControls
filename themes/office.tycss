/* office — Microsoft Office (Fluent). A neutral near-white workspace with a single
   signature move: an ACCENT-COLOURED caption band (Word/Excel/PowerPoint), kept in
   BOTH modes. Set --accent to rebrand the whole identity at runtime — Word-blue by
   default (#2B579A), Excel-green, PowerPoint-orange, etc.

   Genuinely native, NOT zoomed: Fluent's flat surfaces, small 2px radii, thin
   #C8C6C4→#8A8886 hairlines and tight command-bar padding. Nativeness comes from
   colour + border + radius, never from size — controls inherit the base 9px font.

   DUAL-MODE. The palette (surfaces, fields, ink, borders, accent) lives in the
   @mode light / @mode dark blocks; control rules only reference var(--…), so
   switching Controller.Mode recolours everything. @mode light = the classic
   near-white Fluent look. @mode dark = Office dark: #252423 window / #1B1A19
   content / #292827 wells + light ink, with the accent caption band kept in BOTH
   modes. The runtime accent-picker recolours through var(--accent). */

/* ── Palette: light = classic Fluent, dark = Office dark ─────────────────── */
@mode light {
  :root {
    --accent:        #2B579A;   /* Office blue — the runtime accent-picker recolours everything */
    --surface:       #F3F2F1;   /* Fluent neutral window; also default-button hover face */
    --field:         #FFFFFF;   /* white content + input wells + default button face */
    --pressed:       #EDEBE9;   /* pressed neutral: button :active + progress track */
    --ink:           #201F1E;   /* near-black text */
    --muted:         #A19F9D;   /* disabled / secondary ink */
    --line:          #C8C6C4;   /* thin neutral hairline */
    --line-field:    #8A8886;   /* stronger field / default-button border */
    --hover-overlay: #0000000A; /* faint neutral wash for ghost hover */
  }
}

@mode dark {
  :root {
    --accent:        #2B579A;   /* same brand seed — the picker recolours through it */
    --surface:       #252423;   /* Office-dark window; also default-button hover face */
    --field:         #292827;   /* raised dark input wells + default button face */
    --pressed:       #1B1A19;   /* deep content tone: button :active + progress track */
    --ink:           #FFFFFF;   /* light text on the dark canvas */
    --muted:         #797775;   /* disabled / secondary ink */
    --line:          #3B3A39;   /* subtle hairline on dark */
    --line-field:    #484644;   /* stronger field / default-button border on dark */
    --hover-overlay: #FFFFFF14; /* faint light wash for ghost hover on dark */
  }
}

/* Window: flat neutral canvas. */
TyForm { background: var(--surface); }

/* Title bar: the accent caption band — the whole identity, white text in BOTH modes. */
TyTitleBar {
  background: var(--accent);
  color: on(var(--accent));
  border-radius: 0;
}
TyCaptionButton {
  background: transparent;
  color: on(var(--accent));
  border-radius: 0;
}
TyCaptionButton:hover  { background: alpha(on(var(--accent)), 0.18); color: on(var(--accent)); }
TyCaptionButton:active { background: alpha(on(var(--accent)), 0.30); color: on(var(--accent)); }

/* Labels: theme ink on the canvas. */
TyLabel { color: var(--ink); }

/* Default button: white face, thin field-strength border, tight command-bar padding.
   Hover recedes to the neutral window tone; pressed reads a touch deeper. Flat, quiet. */
TyButton {
  background: var(--field);
  color: var(--ink);
  border: 1px solid var(--line-field);
  border-radius: 2px;
  font-weight: normal;
  padding: 5px 10px;
}
TyButton:hover {
  background: var(--surface);
  color: var(--ink);
  border: 1px solid var(--line);
}
TyButton:active {
  background: var(--pressed);
  color: var(--ink);
  border: 1px solid var(--line-field);
}
TyButton:focus  { outline: 2px var(--accent); outline-offset: 1px; }
TyButton:disabled {
  background: var(--surface);
  color: var(--muted);
  border: 1px solid var(--line);
}

/* Primary: solid accent, white ink, Fluent's semibold weight + a hairline shadow. */
TyButton.primary {
  background: var(--accent);
  color: on(var(--accent));
  border: 1px solid var(--accent);
  border-radius: 2px;
  font-weight: 600;
  padding: 5px 10px;
  shadow: 0 1 2 #00000024;
}
TyButton.primary:hover  { background: darken(var(--accent), 8);  border: 1px solid darken(var(--accent), 8); }
TyButton.primary:active { background: darken(var(--accent), 16); border: 1px solid darken(var(--accent), 16); shadow: 0 0 0 #00000000; }
TyButton.primary:disabled {
  background: alpha(var(--accent), 0.40);
  color: alpha(on(var(--accent)), 0.75);
  border: 1px solid alpha(var(--accent), 0.40);
  shadow: 0 0 0 #00000000;
}

/* Ghost: chrome-less until touched — a command-bar affordance, faint neutral wash. */
TyButton.ghost {
  background: transparent;
  color: var(--accent);
  border: 1px solid transparent;
  border-radius: 2px;
  font-weight: normal;
  padding: 5px 10px;
}
TyButton.ghost:hover  { background: var(--hover-overlay); color: var(--accent); border: 1px solid transparent; }
TyButton.ghost:active { background: var(--pressed);       color: var(--accent); border: 1px solid transparent; }
TyButton.ghost:disabled { background: transparent; color: var(--muted); border: 1px solid transparent; }

/* Fields: bright wells, stronger hairline, accent focus. */
TyEdit {
  background: var(--field);
  color: var(--ink);
  border: 1px solid var(--line-field);
  border-radius: 2px;
  padding: 5px 8px;
}
TyEdit:hover    { border: 1px solid var(--ink); }
TyEdit:focus    { border: 1px solid var(--accent); outline: 2px alpha(var(--accent), 0.35); outline-offset: 0px; }
TyEdit:disabled { background: var(--surface); color: var(--muted); border: 1px solid var(--line); }

TyComboBox {
  background: var(--field);
  color: var(--ink);
  border: 1px solid var(--line-field);
  border-radius: 2px;
  padding: 5px 8px;
}
TyComboBox:hover    { border: 1px solid var(--ink); }
TyComboBox:focus    { border: 1px solid var(--accent); outline: 2px alpha(var(--accent), 0.35); outline-offset: 0px; }
TyComboBox:disabled { background: var(--surface); color: var(--muted); border: 1px solid var(--line); }

/* Check box: white indicator, thin field border, accent tick (color inks the check). */
TyCheckBox {
  background: var(--field);
  color: var(--accent);
  border: 1px solid var(--line-field);
  border-radius: 2px;
}
TyCheckBox:hover    { background: var(--field); color: var(--accent); border: 1px solid var(--accent); border-radius: 2px; }
TyCheckBox:active   { background: alpha(var(--accent), 0.12); color: var(--accent); border: 1px solid var(--accent); border-radius: 2px; }
TyCheckBox:disabled { background: var(--surface); color: var(--muted); border: 1px solid var(--line); border-radius: 2px; }

/* Radio: mirror the check box — white well, accent dot, thin field border, circular. */
TyRadioButton {
  background: var(--field);
  color: var(--accent);
  border: 1px solid var(--line-field);
  border-radius: 8px;
}
TyRadioButton:hover    { background: var(--field); color: var(--accent); border: 1px solid var(--accent); border-radius: 8px; }
TyRadioButton:active   { background: alpha(var(--accent), 0.12); color: var(--accent); border: 1px solid var(--accent); border-radius: 8px; }
TyRadioButton:disabled { background: var(--surface); color: var(--muted); border: 1px solid var(--line); border-radius: 8px; }

/* Progress: flat neutral groove, solid accent fill. */
TyProgressBar {
  background: var(--pressed);
  border: 1px solid var(--line);
  border-radius: 2px;
}
TyProgressFill {
  background: var(--accent);
  border-radius: 2px;
}
