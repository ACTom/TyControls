/* office — an ORIGINAL "inspired-by" skin evoking the Microsoft Office Ribbon era
   (a fresh interpretation, not a pixel clone). The signature move: an ACCENT-COLOURED
   title band, just like Word/Excel/PowerPoint. Set --accent to recolour the whole
   brand identity at runtime — Word-blue by default, Excel-green (#217346),
   PowerPoint-orange (#B7472A), etc. Otherwise a flat, thin-bordered, Fluent-ish
   surface with 2px radii and a solid accent primary button.

   NOW DUAL-MODE. The palette (surfaces, fields, ink, borders, accent) lives in the
   @mode light / @mode dark blocks below; the control rules only reference var(--…),
   so switching Controller.Mode recolours the whole skin. NON-colour structure
   (render-style, radii, gradients, padding, font-weight) is identical across modes.
   @mode light = the classic near-white Office look. @mode dark = an Office BLACK
   theme: ~#1B1A19 / #323130 dark surfaces + light ink, with the accent title band
   kept in BOTH modes (the coloured band is the whole point). The runtime
   accent-picker still recolours everything via var(--accent). */

/* ── Palette: light = the current look, dark = Office black ──────────────── */
@mode light {
  :root {
    --accent:     #2B579A;   /* Word blue — the runtime accent-picker recolours everything */
    --surface:    #F3F2F1;   /* near-white Fluent neutral background */
    --field:      #FFFFFF;   /* white input wells */
    --ink:        #201F1E;   /* near-black text */
    --muted:      #A19F9D;   /* disabled / secondary ink */
    --line:       #C8C6C4;   /* thin neutral hairline border */
    --line-field: #8A8886;   /* slightly stronger field border */
  }
}

@mode dark {
  :root {
    --accent:     #3A6BC0;   /* Word blue, brightened a touch for contrast on black — still var(--accent) */
    --surface:    #1B1A19;   /* Office-dark canvas (near-black neutral) */
    --field:      #323130;   /* raised dark input wells */
    --ink:        #F3F2F1;   /* light text on the dark canvas */
    --muted:      #797775;   /* disabled / secondary ink */
    --line:       #3B3A39;   /* subtle hairline border on dark */
    --line-field: #605E5C;   /* slightly stronger field border on dark */
  }
}

/* Window: flat canvas. */
TyForm { background: var(--surface); }

/* Title bar: the accent band — the whole point of this skin (kept in BOTH modes). */
TyTitleBar {
  background: var(--accent);
  color: on(var(--accent));
  border-radius: 0;
}
TyCaptionButton {
  background: transparent;
  color: on(var(--accent));
  border-radius: 0;
}
TyCaptionButton:hover  { background: alpha(on(var(--accent)), 0.18); color: on(var(--accent)); }
TyCaptionButton:active { background: alpha(on(var(--accent)), 0.30); color: on(var(--accent)); }

/* Labels: theme ink on the canvas. */
TyLabel { color: var(--ink); }

/* Buttons: flat, thin-bordered, quiet — the ribbon/command-bar feel.
   Hover tints toward the accent; pressed reads slightly deeper. */
TyButton {
  background: var(--field);
  color: var(--ink);
  border: 1px solid var(--line);
  border-radius: 2px;
  font-weight: normal;
  padding: 6px 12px;
}
TyButton:hover {
  background: alpha(var(--accent), 0.10);
  color: var(--ink);
  border: 1px solid alpha(var(--accent), 0.45);
}
TyButton:active {
  background: alpha(var(--accent), 0.20);
  color: var(--ink);
  border: 1px solid var(--accent);
}
TyButton:focus  { outline: 2px var(--accent); outline-offset: 1px; }
TyButton:disabled {
  background: var(--surface);
  color: var(--muted);
  border: 1px solid var(--line);
}

/* Primary: solid accent, readable ink, the emphasised command. */
TyButton.primary {
  background: var(--accent);
  color: on(var(--accent));
  border: 1px solid var(--accent);
  border-radius: 2px;
  font-weight: bold;
}
TyButton.primary:hover  { background: darken(var(--accent), 8);  border: 1px solid darken(var(--accent), 8); }
TyButton.primary:active { background: darken(var(--accent), 16); border: 1px solid darken(var(--accent), 16); }
TyButton.primary:disabled {
  background: alpha(var(--accent), 0.40);
  color: alpha(on(var(--accent)), 0.75);
  border: 1px solid alpha(var(--accent), 0.40);
}

/* Ghost: chrome-less until touched — a toolbar/command-bar affordance. */
TyButton.ghost {
  background: transparent;
  color: var(--accent);
  border: 1px solid transparent;
  border-radius: 2px;
}
TyButton.ghost:hover  { background: alpha(var(--accent), 0.10); color: var(--accent); border: 1px solid transparent; }
TyButton.ghost:active { background: alpha(var(--accent), 0.20); color: var(--accent); border: 1px solid transparent; }
TyButton.ghost:disabled { background: transparent; color: var(--muted); border: 1px solid transparent; }

/* Fields: dark/light wells, thin stronger border, accent focus ring. */
TyEdit {
  background: var(--field);
  color: var(--ink);
  border: 1px solid var(--line-field);
  border-radius: 2px;
  padding: 5px 8px;
}
TyEdit:hover    { border: 1px solid var(--ink); }
TyEdit:focus    { border: 1px solid var(--accent); outline: 2px alpha(var(--accent), 0.35); outline-offset: 0px; }
TyEdit:disabled { background: var(--surface); color: var(--muted); border: 1px solid var(--line); }

TyComboBox {
  background: var(--field);
  color: var(--ink);
  border: 1px solid var(--line-field);
  border-radius: 2px;
  padding: 5px 8px;
}
TyComboBox:hover    { border: 1px solid var(--ink); }
TyComboBox:focus    { border: 1px solid var(--accent); outline: 2px alpha(var(--accent), 0.35); outline-offset: 0px; }
TyComboBox:disabled { background: var(--surface); color: var(--muted); border: 1px solid var(--line); }

/* Check box: field-coloured indicator, thin border, accent tick (color inks the check). */
TyCheckBox {
  background: var(--field);
  color: var(--accent);
  border: 1px solid var(--line-field);
  border-radius: 2px;
}
TyCheckBox:hover    { background: var(--field); color: var(--accent); border: 1px solid var(--accent); border-radius: 2px; }
TyCheckBox:active   { background: alpha(var(--accent), 0.12); color: var(--accent); border: 1px solid var(--accent); border-radius: 2px; }
TyCheckBox:disabled { background: var(--surface); color: var(--muted); border: 1px solid var(--line); border-radius: 2px; }

/* Radio: mirror the check box — field well, accent dot, thin field border. */
TyRadioButton {
  background: var(--field);
  color: var(--accent);
  border: 1px solid var(--line-field);
  border-radius: 8px;
}
TyRadioButton:hover    { background: var(--field); color: var(--accent); border: 1px solid var(--accent); border-radius: 8px; }
TyRadioButton:active   { background: alpha(var(--accent), 0.12); color: var(--accent); border: 1px solid var(--accent); border-radius: 8px; }
TyRadioButton:disabled { background: var(--surface); color: var(--muted); border: 1px solid var(--line); border-radius: 8px; }

/* Progress: flat track, solid accent fill. */
TyProgressBar {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 2px;
}
TyProgressFill {
  background: var(--accent);
  border-radius: 2px;
}
