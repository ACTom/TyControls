/* Bootstrap — an original ty-controls skin faithful to Bootstrap 5's flat web look, DUAL-MODE.
   White body (BS default body IS #fff, not gray-100), 6px (.375rem) field/button radii, soft grey field
   borders (#CED4DA) with a lightened-accent focus border + a 4px .25-alpha accent ring. Default button = btn-light
   (light-grey face, dark ink, normal weight), primary = solid #0D6EFD brand blue, ghost = btn-outline-primary.
   LIGHT: white surfaces + white body, #212529 ink. DARK (data-bs-theme=dark): #212529 body, #2B3035 field wells,
   #495057 borders, #343A40 button face, light #DEE2E6 ink. Only the PALETTE flips per @mode — every radius,
   padding, border-width, render-style and font-weight is shared. --accent stays the #0D6EFD brand seed in BOTH
   modes, so the runtime accent-picker recolours every primary / focus / progress surface through it. Flat, weight
   normal, tight padding — nativeness comes from colour + border + radius, never from size. */

/* --- palette: light ------------------------------------------------------ */
@mode light {
  :root {
    --accent:            #0D6EFD;   /* Bootstrap primary blue (brand seed)        */
    --danger:            #DC3545;   /* $danger — BS red-500                       */
    --window:            #FFFFFF;   /* body-bg — BS default is white              */
    --surface:           #FFFFFF;   /* title bar / cards / field wells            */
    --field-border:      #CED4DA;   /* gray-400 input border                      */
    --border:            #DEE2E6;   /* gray-300 dividers / btn-light border       */
    --ink:               #212529;   /* gray-900 body text                         */
    --muted:             #6C757D;   /* gray-600 caption glyphs                    */
    --subtle:            #E9ECEF;   /* gray-200 hover fill / disabled well        */
    --track:             #E9ECEF;   /* progress track                             */
    --cap-active:        #DEE2E6;   /* caption-button pressed fill                */
    --btn-face:          #F8F9FA;   /* btn-light face                             */
    --btn-border:        #DEE2E6;   /* btn-light border                           */
    --btn-hover:         #E9ECEF;   /* btn-light :hover face                      */
    --btn-hover-border:  #C6C9CB;   /* btn-light :hover border                    */
    --btn-active:        #DDE0E3;   /* btn-light :active face                     */
    --btn-active-border: #BABDBF;   /* btn-light :active border                   */
  }
}

/* --- palette: dark (data-bs-theme=dark) ---------------------------------- */
@mode dark {
  :root {
    --accent:            #0D6EFD;   /* SAME brand seed — picker recolours through it */
    --danger:            #DC3545;   /* SAME $danger — BS 5.3 dark keeps red-500   */
    --window:            #212529;   /* dark body-bg                               */
    --surface:           #2B3035;   /* field wells / slightly-elevated title bar  */
    --field-border:      #495057;   /* gray-700 input border                      */
    --border:            #495057;   /* dividers / button border                   */
    --ink:               #DEE2E6;   /* light body text                           */
    --muted:             #ADB5BD;   /* caption glyphs                             */
    --subtle:            #343A40;   /* elevated hover fill / disabled well        */
    --track:             #343A40;   /* progress track                             */
    --cap-active:        #495057;   /* caption-button pressed fill                */
    --btn-face:          #343A40;   /* default button face                        */
    --btn-border:        #495057;   /* default button border                      */
    --btn-hover:         #3B4147;   /* :hover face (lighter)                      */
    --btn-hover-border:  #545B62;   /* :hover border                              */
    --btn-active:        #41474D;   /* :active face                               */
    --btn-active-border: #5C636A;   /* :active border                             */
  }
}

/* ---- Window & chrome ---------------------------------------------------- */
TyForm {
  background: var(--window);
  color: var(--ink);
}

TyTitleBar {
  background: var(--surface);
  color: var(--ink);
  border-radius: 0;
}

TyCaptionButton {
  background: var(--surface);
  color: var(--muted);
  border-radius: 4px;
}
TyCaptionButton:hover {
  background: var(--subtle);
  color: var(--ink);
}
TyCaptionButton:active {
  background: var(--cap-active);
  color: var(--ink);
}

/* ---- Text --------------------------------------------------------------- */
TyLabel {
  color: var(--ink);
}

/* ---- Buttons ------------------------------------------------------------ */
/* Default = btn-light: light-grey face, dark ink, NORMAL weight, tight padding */
TyButton, TySpeedButton, TyGlyphContainerButton, TyRibbonAppMenu {
  background: var(--btn-face);
  color: var(--ink);
  border: 1px solid var(--btn-border);
  border-radius: 6px;
  render-style: flat;
  font-weight: normal;
  padding: 6px 10px;
}
TyButton:hover, TySpeedButton:hover, TyGlyphContainerButton:hover, TyRibbonAppMenu:hover {
  background: var(--btn-hover);
  border-color: var(--btn-hover-border);
}
TyButton:active, TySpeedButton:active, TyGlyphContainerButton:active, TyRibbonAppMenu:active {
  background: var(--btn-active);
  border-color: var(--btn-active-border);
}
TyButton:focus, TySpeedButton:focus, TyGlyphContainerButton:focus, TyRibbonAppMenu:focus {
  outline: 4px alpha(var(--btn-border), 0.5);
  outline-offset: 0px;
}
TyButton:disabled, TySpeedButton:disabled, TyGlyphContainerButton:disabled, TyRibbonAppMenu:disabled {
  background: var(--btn-face);
  border-color: var(--btn-border);
  color: var(--ink);
  opacity: 0.65;
}

/* Primary = btn-primary: solid brand blue, white ink */
TyButton.primary, TySpeedButton.primary, TyGlyphContainerButton.primary, TyRibbonAppMenu.primary {
  background: var(--accent);
  color: on(var(--accent));
  border: 1px solid var(--accent);
  border-radius: 6px;
  render-style: flat;
  font-weight: normal;
  padding: 6px 10px;
}
TyButton.primary:hover, TySpeedButton.primary:hover, TyGlyphContainerButton.primary:hover,
TyRibbonAppMenu.primary:hover {
  background: darken(var(--accent), 8);
  border-color: darken(var(--accent), 12);
}
TyButton.primary:active, TySpeedButton.primary:active, TyGlyphContainerButton.primary:active,
TyRibbonAppMenu.primary:active {
  background: darken(var(--accent), 11);
  border-color: darken(var(--accent), 15);
}
TyButton.primary:focus, TySpeedButton.primary:focus, TyGlyphContainerButton.primary:focus,
TyRibbonAppMenu.primary:focus {
  outline: 4px alpha(var(--accent), 0.5);
  outline-offset: 0px;
}
TyButton.primary:disabled, TySpeedButton.primary:disabled,
TyGlyphContainerButton.primary:disabled, TyRibbonAppMenu.primary:disabled {
  background: var(--accent);
  border-color: var(--accent);
  color: on(var(--accent));
  opacity: 0.65;
}

/* Danger = btn-danger: solid red-500, white ink */
TyButton.danger, TySpeedButton.danger, TyGlyphContainerButton.danger, TyRibbonAppMenu.danger {
  background: var(--danger);
  color: on(var(--danger));
  border: 1px solid var(--danger);
  border-radius: 6px;
  render-style: flat;
  font-weight: normal;
  padding: 6px 10px;
}
TyButton.danger:hover, TySpeedButton.danger:hover, TyGlyphContainerButton.danger:hover, TyRibbonAppMenu.danger:hover {
  background: darken(var(--danger), 8);
  border-color: darken(var(--danger), 12);
}
TyButton.danger:active, TySpeedButton.danger:active, TyGlyphContainerButton.danger:active,
TyRibbonAppMenu.danger:active {
  background: darken(var(--danger), 11);
  border-color: darken(var(--danger), 15);
}
TyButton.danger:focus, TySpeedButton.danger:focus, TyGlyphContainerButton.danger:focus, TyRibbonAppMenu.danger:focus {
  outline: 4px alpha(var(--danger), 0.5);
  outline-offset: 0px;
}
TyButton.danger:disabled, TySpeedButton.danger:disabled, TyGlyphContainerButton.danger:disabled,
TyRibbonAppMenu.danger:disabled {
  background: var(--danger);
  border-color: var(--danger);
  color: on(var(--danger));
  opacity: 0.65;
}

/* Ghost = btn-outline-primary: transparent, blue ink + blue border; fills on hover */
TyButton.ghost, TySpeedButton.ghost, TyGlyphContainerButton.ghost, TyRibbonAppMenu.ghost {
  background: transparent;
  color: var(--accent);
  border: 1px solid var(--accent);
  border-radius: 6px;
  render-style: flat;
  font-weight: normal;
  padding: 6px 10px;
}
TyButton.ghost:hover, TySpeedButton.ghost:hover, TyGlyphContainerButton.ghost:hover, TyRibbonAppMenu.ghost:hover {
  background: var(--accent);
  color: on(var(--accent));
  border-color: var(--accent);
}
TyButton.ghost:active, TySpeedButton.ghost:active, TyGlyphContainerButton.ghost:active, TyRibbonAppMenu.ghost:active {
  background: darken(var(--accent), 8);
  color: on(var(--accent));
  border-color: darken(var(--accent), 8);
}
TyButton.ghost:focus, TySpeedButton.ghost:focus, TyGlyphContainerButton.ghost:focus, TyRibbonAppMenu.ghost:focus {
  outline: 4px alpha(var(--accent), 0.5);
  outline-offset: 0px;
}
TyButton.ghost:disabled, TySpeedButton.ghost:disabled, TyGlyphContainerButton.ghost:disabled,
TyRibbonAppMenu.ghost:disabled {
  background: transparent;
  color: var(--accent);
  border-color: var(--accent);
  opacity: 0.65;
}

/* ---- Inputs ------------------------------------------------------------- */
TyEdit {
  background: var(--surface);
  color: var(--ink);
  border: 1px solid var(--field-border);
  border-radius: 6px;
  render-style: flat;
  padding: 4px 8px;
}
TyEdit:focus {
  border-color: lighten(var(--accent), 20);
  outline: 4px alpha(var(--accent), 0.25);
  outline-offset: 0px;
}
TyEdit:disabled {
  background: var(--subtle);
  color: var(--muted);
  border-color: var(--field-border);
}

TyComboBox {
  background: var(--surface);
  color: var(--ink);
  border: 1px solid var(--field-border);
  border-radius: 6px;
  render-style: flat;
  padding: 4px 8px;
}
TyComboBox:focus {
  border-color: lighten(var(--accent), 20);
  outline: 4px alpha(var(--accent), 0.25);
  outline-offset: 0px;
}
TyComboBox:disabled {
  background: var(--subtle);
  color: var(--muted);
  border-color: var(--field-border);
}

/* ---- Checkbox (white well, gray-300 border, accent fill when checked) ---- */
TyCheckBox {
  background: var(--surface);
  color: var(--ink);
  border: 1px solid var(--border);
  border-radius: 4px;
  render-style: flat;
}
TyCheckBox:hover {
  border-color: var(--accent);
}
TyCheckBox:active {
  border-color: darken(var(--accent), 10);
}
TyCheckBox:focus {
  outline: 4px alpha(var(--accent), 0.25);
  outline-offset: 1px;
}
TyCheckBox:selected {
  background: var(--accent);
  border-color: var(--accent);
  color: on(var(--accent));
}
TyCheckBox:disabled {
  background: var(--subtle);
  border-color: var(--border);
  color: var(--muted);
  opacity: 0.65;
}

/* ---- Radio (same treatment; the control rounds it into a dot) ----------- */
TyRadioButton {
  background: var(--surface);
  color: var(--ink);
  border: 1px solid var(--border);
  render-style: flat;
}
TyRadioButton:hover {
  border-color: var(--accent);
}
TyRadioButton:active {
  border-color: darken(var(--accent), 10);
}
TyRadioButton:focus {
  outline: 4px alpha(var(--accent), 0.25);
  outline-offset: 1px;
}
TyRadioButton:selected {
  background: var(--accent);
  border-color: var(--accent);
  color: on(var(--accent));
}
TyRadioButton:disabled {
  background: var(--subtle);
  border-color: var(--border);
  color: var(--muted);
  opacity: 0.65;
}

/* ---- Progress ----------------------------------------------------------- */
TyProgressBar {
  background: var(--track);
  border-radius: 6px;
  render-style: flat;
}
TyProgressFill {
  background: var(--accent);
  border-radius: 6px;
  render-style: flat;
}

/* ---- Cards, tags & badges ----------------------------------------------- */
/* Mode-invariant metrics. BS gives .card-header and .card-footer the SAME box
   (.5rem padding above and below a 1.5rem line), so the 36/44 fallback split
   isn't Bootstrap — both bands are 40. Geometry never flips per @mode. */
:root {
  --card-header-height:   40;   /* .card-header: .5rem*2 + a 1.5rem line */
  --card-actions-height:  40;   /* .card-footer: BS caps it identically  */
}

/* .card: one flat well, a single 1px gray hairline, .375rem corners and 1rem of
   inset (.card-body). No shadow — BS ships .card flat and leaves the lift to the
   .shadow utilities, so a skin-wide shadow would be someone else's Bootstrap. */
TyCard {
  background: var(--surface);
  color: var(--ink);
  border: 1px solid var(--border);
  border-radius: 6px;
  render-style: flat;
  padding: 16px;
}
/* BS has no .card:hover of its own, so 'hoverable' borrows btn-light's border
   darkening rather than inventing a lift BS never uses. */
TyCard:hover {
  border-color: var(--btn-hover-border);
}
TyCard:disabled {
  opacity: 0.65;
}

/* .card-header: the cap tint is BS 5.3's rgba(body-color, .03) — a wash of the
   INK, so it darkens the white body and lightens the dark one from this one rule.
   Weight normal: .card-header carries no font-weight in BS (the band is made by
   tint + hairline, not by heavy type), and this skin is weight-normal throughout.
   No padding — falling back to the card's 1rem is what lines the title up with the
   body, exactly as BS's matching .card-header / .card-body padding does. */
TyCardHeader {
  background: alpha(var(--ink), 0.03);
  color: var(--ink);
  border-color: var(--border);   /* the border-bottom hairline */
  border-width: 1px;
  font-weight: normal;
}
/* .card-footer: same cap tint, hairline on the other side. */
TyCardActions {
  background: alpha(var(--ink), 0.03);
  border-color: var(--border);
  border-width: 1px;
}

/* Tags are .badge: borderless solid chips at the same .375rem radius as every
   other surface here — .rounded-pill is opt-in in BS, so nothing goes round.
   Neutral = .bg-light/.text-dark, on the gray-200 wash rather than gray-100 so the
   chip still reads against a white card. */
TyTag {
  background: var(--subtle);
  color: var(--ink);
  border-radius: 6px;
  render-style: flat;
  padding: 0px 8px;
}
TyTag.accent { background: var(--accent); color: on(var(--accent)); }   /* .text-bg-primary */
TyTag.danger { background: var(--danger); color: on(var(--danger)); }   /* .text-bg-danger  */
/* No :hover — a BS .badge is a static chip; only its x lights up. */
TyTag:disabled {
  opacity: 0.65;
}

/* The x is .btn-close: a muted glyph, same ink as the caption buttons'. BS ships
   .btn-close-white precisely because a dark x dies on a solid chip — same problem
   here, so the variants re-ink it through on(). */
TyTagClose        { color: var(--muted); }
TyTagClose.accent { color: on(var(--accent)); }
TyTagClose.danger { color: on(var(--danger)); }
/* Hover chip: an ink wash, not an opaque fill — one value has to darken the grey
   chip and the blue/red ones alike, and it flips with --ink in dark mode (where
   this skin's hovers lighten). 4px = the caption-button chip's corner. */
TyTagClose:hover  { background: alpha(var(--ink), 0.15); border-radius: 4px; }

/* .badge: a small rounded RECT at .375rem, NOT a pill — .rounded-pill is opt-in in
   BS, so the inherited round accent pill is wrong here. Solid primary + bold IS
   .text-bg-primary, the one place this weight-normal skin wants 700; the accent
   picker recolours it along with every other primary surface. Side padding a touch
   over the base's: BS's .badge is airier across (.65em) than down (.35em), and with
   the vertical pinned at 0 that ratio has to come from the sides alone. */
TyBadge {
  background: var(--accent);
  color: on(var(--accent));
  border-radius: 6px;
  font-weight: bold;
  padding: 0px 5px;
}
