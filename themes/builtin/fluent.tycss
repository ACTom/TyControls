/* fluent — Microsoft Fluent 2 (Windows 11 / Teams / Office web), authentic.
   Flat white chrome, hairline neutral fields with a #0F6CBD focus, 4px radii,
   tight native padding (buttons 5x10), regular-weight default buttons and a
   semibold primary — the real Fluent split. DUAL-MODE: @mode light is Win11
   light (white form, #242424 ink); @mode dark is Fluent 2 dark (#292929 form,
   #1F1F1F fields, #479EF5 accent). Non-colour structure is mode-invariant —
   only the palette flips, and --accent seeds every accent surface so the
   runtime accent-picker recolours either mode. */

/* ── Mode-invariant scalars (geometry, opacity) ── */
:root {
  --radius:       4px;
  --radius-check: 3px;
  --radius-pill:  100px;
  --disabled:     0.45;
  --on-titlebar: var(--ink);   /* ink for controls hosted on the title bar */
}

/* ── LIGHT palette — Windows 11 / Office web light ── */
@mode light {
  :root {
    /* SEED — brand + Fluent neutral ramp */
    --accent:          #0F6CBD;   /* Fluent brand primary */
    --form:            #FFFFFF;    /* window backdrop (pure white) */
    --field:           #FFFFFF;    /* input wells */
    --ink:             #242424;    /* neutral foreground */
    --muted:           #616161;    /* secondary text */
    --border:          #D1D1D1;    /* hairline field / button stroke */
    --btn-face:        #FFFFFF;    /* default-button face */
    --btn-hover:       #F5F5F5;    /* default-button hover fill */
    --btn-hover-bord:  #C7C7C7;    /* default-button hover stroke */
    --btn-active:      #EBEBEB;    /* default-button pressed fill */
    --check-border:    #616161;    /* unchecked indicator stroke */
    --ghost-hover:     #00000008;  /* subtle / caption hover wash */
    --pressed:         #EBEBEB;    /* subtle / caption pressed wash */
    --track:           #E6E6E6;    /* progress track */
    --chip:            #F5F5F5;    /* tag / chip fill (Fluent neutralBackground3) */
    --danger:          #C42B1C;    /* close-button red */
    --btn-shadow:      #0000000F;  /* whisper of elevation */

    /* MAP — derive accent states so the accent-picker follows */
    --accent-hover:  darken(var(--accent), 7%);    /* ~#115EA3 */
    --accent-active: darken(var(--accent), 15%);   /* ~#0E4775 */
    --on-accent:     on(var(--accent));            /* readable ink -> #FFFFFF */
    --danger-hover:  darken(var(--danger), 7%);    /* ~#B6281A */
    --danger-active: darken(var(--danger), 15%);   /* ~#A72518 */
    --on-danger:     on(var(--danger));            /* readable ink -> #FFFFFF */
    --on-titlebar: var(--ink);   /* ink for controls hosted on the title bar */
}
}

/* ── DARK palette — Fluent 2 dark ── */
@mode dark {
  :root {
    /* SEED — brand (brighter for dark contrast) + dark neutral ramp */
    --accent:          #479EF5;   /* Fluent dark brand primary */
    --form:            #292929;    /* window backdrop */
    --field:           #1F1F1F;    /* input wells */
    --ink:             #FFFFFF;    /* light foreground */
    --muted:           #ADADAD;    /* secondary text */
    --border:          #404040;    /* hairline field / button stroke */
    --btn-face:        #383838;    /* default-button face */
    --btn-hover:       #3D3D3D;    /* default-button hover fill */
    --btn-hover-bord:  #525252;    /* default-button hover stroke */
    --btn-active:      #333333;    /* default-button pressed fill */
    --check-border:    #ADADAD;    /* unchecked indicator stroke */
    --ghost-hover:     #FFFFFF14;  /* subtle / caption hover wash */
    --pressed:         #454545;    /* subtle / caption pressed wash */
    --track:           #4D4D4D;    /* progress track */
    --chip:            #383838;    /* tag / chip fill (Fluent neutralBackground3) */
    --danger:          #D13438;    /* dark close-button red */
    --btn-shadow:      #00000040;  /* whisper of elevation */

    /* MAP — derive accent states so the accent-picker follows */
    --accent-hover:  lighten(var(--accent), 9%);   /* ~#62ABF5 */
    --accent-active: darken(var(--accent), 8%);    /* ~#2886DE */
    --on-accent:     on(var(--accent));            /* readable ink on accent */
    --danger-hover:  lighten(var(--danger), 9%);   /* ~#D5464A */
    --danger-active: darken(var(--danger), 8%);    /* ~#C03034 */
    --on-danger:     on(var(--danger));            /* readable ink on danger */
    --on-titlebar: var(--ink);   /* ink for controls hosted on the title bar */
}
}

/* Window backdrop. */
TyForm { background: var(--form); }

/* Chrome: flat white/dark band, regular caption ink (Win11 is not bold). */
TyTitleBar, TyRibbonQuickAccess {
  background: var(--form);
  color: var(--ink);
  border-radius: 0;
}

/* Caption buttons: transparent, square hover wash; close goes Fluent-red. */
TyCaptionButton        { background: transparent; color: var(--ink); border-radius: 0; }
TyCaptionButton:hover  { background: var(--ghost-hover); }
TyCaptionButton:active { background: var(--pressed); }
TyCaptionButton.close:hover  { background: var(--danger); color: #FFFFFF; }
TyCaptionButton.close:active { background: darken(var(--danger), 10%); color: #FFFFFF; }

TyLabel, TyHtmlLabel, TyLinkLabel, TyShadowLabel, TyGlowLabel, TyDivider, TyCharImage          { color: var(--ink); }
TyLabel:disabled, TyHtmlLabel:disabled, TyLinkLabel:disabled, TyShadowLabel:disabled, TyGlowLabel:disabled, TyDivider:disabled, TyCharImage:disabled { opacity: var(--disabled); }

/* ── Buttons ─────────────────────────────────────────────────────────────
   Default (secondary): white face, hairline neutral stroke, 4px radius,
   REGULAR weight, tight 5x10 padding — the authentic Fluent default. */
TyButton, TySpeedButton, TyGlyphContainerButton, TyRibbonAppMenu, TyButtonGroup, TyUpDown {
  background: var(--btn-face);
  color: var(--ink);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 5px 10px;
  font-weight: normal;
  shadow: 0 1 1 var(--btn-shadow);
}
TyButton:hover, TySpeedButton:hover, TyGlyphContainerButton:hover, TyRibbonAppMenu:hover, TyButtonGroup:hover, TyUpDown:hover    { background: var(--btn-hover);  border-color: var(--btn-hover-bord); }
TyButton:active, TySpeedButton:active, TyGlyphContainerButton:active, TyRibbonAppMenu:active, TyButtonGroup:active, TyUpDown:active   { background: var(--btn-active); border-color: var(--border); }
TyButton:focus, TySpeedButton:focus, TyGlyphContainerButton:focus, TyRibbonAppMenu:focus, TyButtonGroup:focus, TyUpDown:focus    { border-color: var(--accent); outline: 2px var(--accent); outline-offset: 1px; }TyButton:disabled, TySpeedButton:disabled, TyGlyphContainerButton:disabled, TyRibbonAppMenu:disabled, TyButtonGroup:disabled, TyUpDown:disabled { opacity: var(--disabled); }

/* Primary: solid accent, white ink, semibold (Fluent primary IS 600). */
TyButton.primary, TySpeedButton.primary, TyGlyphContainerButton.primary, TyRibbonAppMenu.primary, TyButtonGroup.primary, TyUpDown.primary {
  background: var(--accent);
  color: var(--on-accent);
  border: 1px solid var(--accent);
  border-radius: var(--radius);
  padding: 5px 10px;
  font-weight: 600;
  shadow: 0 1 1 var(--btn-shadow);
}TyButton.primary:hover, TySpeedButton.primary:hover, TyGlyphContainerButton.primary:hover, TyRibbonAppMenu.primary:hover, TyButtonGroup.primary:hover, TyUpDown.primary:hover    { background: var(--accent-hover);  border-color: var(--accent-hover); }TyButton.primary:active, TySpeedButton.primary:active, TyGlyphContainerButton.primary:active, TyRibbonAppMenu.primary:active, TyButtonGroup.primary:active, TyUpDown.primary:active   { background: var(--accent-active); border-color: var(--accent-active); }TyButton.primary:focus, TySpeedButton.primary:focus, TyGlyphContainerButton.primary:focus, TyRibbonAppMenu.primary:focus, TyButtonGroup.primary:focus, TyUpDown.primary:focus    { outline: 2px var(--accent); outline-offset: 1px; }TyButton.primary:disabled, TySpeedButton.primary:disabled, TyGlyphContainerButton.primary:disabled, TyRibbonAppMenu.primary:disabled, TyButtonGroup.primary:disabled, TyUpDown.primary:disabled { opacity: var(--disabled); }

/* Danger: primary's shape driven by the Fluent red — solid fill, white ink,
   semibold; the destructive twin of the primary button. */
TyButton.danger, TySpeedButton.danger, TyGlyphContainerButton.danger, TyRibbonAppMenu.danger, TyButtonGroup.danger, TyUpDown.danger {
  background: var(--danger);
  color: var(--on-danger);
  border: 1px solid var(--danger);
  border-radius: var(--radius);
  padding: 5px 10px;
  font-weight: 600;
  shadow: 0 1 1 var(--btn-shadow);
}TyButton.danger:hover, TySpeedButton.danger:hover, TyGlyphContainerButton.danger:hover, TyRibbonAppMenu.danger:hover, TyButtonGroup.danger:hover, TyUpDown.danger:hover    { background: var(--danger-hover);  border-color: var(--danger-hover); }TyButton.danger:active, TySpeedButton.danger:active, TyGlyphContainerButton.danger:active, TyRibbonAppMenu.danger:active, TyButtonGroup.danger:active, TyUpDown.danger:active   { background: var(--danger-active); border-color: var(--danger-active); }TyButton.danger:focus, TySpeedButton.danger:focus, TyGlyphContainerButton.danger:focus, TyRibbonAppMenu.danger:focus, TyButtonGroup.danger:focus, TyUpDown.danger:focus    { outline: 2px var(--danger); outline-offset: 1px; }TyButton.danger:disabled, TySpeedButton.danger:disabled, TyGlyphContainerButton.danger:disabled, TyRibbonAppMenu.danger:disabled, TyButtonGroup.danger:disabled, TyUpDown.danger:disabled { opacity: var(--disabled); }

/* Ghost (Fluent "subtle"): transparent, regular weight, faint hover wash. */
TyButton.ghost, TySpeedButton.ghost, TyGlyphContainerButton.ghost, TyRibbonAppMenu.ghost, TyButtonGroup.ghost, TyUpDown.ghost {
  background: transparent;
  color: var(--ink);
  border: 1px solid transparent;
  border-radius: var(--radius);
  padding: 5px 10px;
  font-weight: normal;
}TyButton.ghost:hover, TySpeedButton.ghost:hover, TyGlyphContainerButton.ghost:hover, TyRibbonAppMenu.ghost:hover, TyButtonGroup.ghost:hover, TyUpDown.ghost:hover    { background: var(--ghost-hover); }TyButton.ghost:active, TySpeedButton.ghost:active, TyGlyphContainerButton.ghost:active, TyRibbonAppMenu.ghost:active, TyButtonGroup.ghost:active, TyUpDown.ghost:active   { background: var(--pressed); }TyButton.ghost:selected, TySpeedButton.ghost:selected, TyGlyphContainerButton.ghost:selected, TyRibbonAppMenu.ghost:selected, TyButtonGroup.ghost:selected, TyUpDown.ghost:selected { background: alpha(var(--accent), 0.12); color: var(--accent); }TyButton.ghost:focus, TySpeedButton.ghost:focus, TyGlyphContainerButton.ghost:focus, TyRibbonAppMenu.ghost:focus, TyButtonGroup.ghost:focus, TyUpDown.ghost:focus    { outline: 2px var(--accent); outline-offset: 1px; }TyButton.ghost:disabled, TySpeedButton.ghost:disabled, TyGlyphContainerButton.ghost:disabled, TyRibbonAppMenu.ghost:disabled, TyButtonGroup.ghost:disabled, TyUpDown.ghost:disabled { opacity: var(--disabled); }

/* ── Inputs ──────────────────────────────────────────────────────────────
   Field well, hairline neutral border, tight padding; focus lights accent. */
TyEdit {
  background: var(--field);
  color: var(--ink);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 4px 8px;
}
TyEdit:hover    { border-color: var(--btn-hover-bord); }
TyEdit:focus    { border-color: var(--accent); outline: 2px alpha(var(--accent), 0.3); outline-offset: 1px; }
TyEdit:disabled { opacity: var(--disabled); }
/* An edit EMBEDDED in another control's field -- the editable combo box puts a real TTyEdit
   over its text zone. The host already drew the field and owns the focus ring; a second frame
   inside the first is what pushed the drop chevron into the gap between them. This has to be
   repeated in every theme that writes ANY TyEdit rule, because doing so suppresses the whole
   built-in TyEdit rule set for this typeKey -- variants included. */
TyEdit.embedded         { border-width: 0; border-radius: 0; }
TyEdit.embedded:hover   { border-color: transparent; }
TyEdit.embedded:focus   { border-color: transparent; outline: 0px transparent; }

TyComboBox {
  background: var(--field);
  color: var(--ink);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 4px 8px;
}
TyComboBox:hover    { border-color: var(--btn-hover-bord); }
TyComboBox:focus    { border-color: var(--accent); outline: 2px alpha(var(--accent), 0.3); outline-offset: 1px; }
TyComboBox:disabled { opacity: var(--disabled); }

/* Checkbox: stroked white well; checked fills accent with an on-accent tick. */
TyCheckBox {
  background: var(--field);
  color: var(--ink);
  border: 1px solid var(--check-border);
  border-radius: var(--radius-check);
  padding: 3px;
}
TyCheckBox:hover    { border-color: var(--accent); }
TyCheckBox:active   { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
TyCheckBox:focus    { outline: 2px var(--accent); outline-offset: 2px; }
TyCheckBox:disabled { opacity: var(--disabled); }

/* Radio: same well, circular; checked fills accent. */
TyRadioButton {
  background: var(--field);
  color: var(--ink);
  border: 1px solid var(--check-border);
  border-radius: var(--radius-pill);
  padding: 3px;
}
TyRadioButton:hover    { border-color: var(--accent); }
TyRadioButton:active   { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
TyRadioButton:focus    { outline: 2px var(--accent); outline-offset: 2px; }
TyRadioButton:disabled { opacity: var(--disabled); }

/* Progress: fully-rounded track with a fully-rounded accent fill. */
TyProgressBar {
  background: var(--track);
  border-width: 0;
  border-radius: var(--radius-pill);
}
TyProgressBar:disabled { opacity: var(--disabled); }

TyProgressFill {
  background: var(--accent);
  border-radius: var(--radius-pill);
}

/* ── Card + Tag ──────────────────────────────────────────────────────────
   Surfaces, not decoration. The card is Fluent's OUTLINE card: one flat
   sheet held by a neutral hairline — white-on-white in light, #292929 on
   #292929 in dark, where the stroke is the only thing telling them apart,
   so the hairline is structural here, not trim. Tags are Fluent 2 rounded
   RECTS (shape="rounded", 4px), never pills; only the badge is circular. */

TyCard {
  background: var(--form);
  color: var(--ink);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 12px;
  shadow: 0 1 2 var(--btn-shadow);
}
/* 'hoverable' = the neutral wash a default button takes (neutralBackground1Hover). */
TyCard:hover    { background: var(--btn-hover); border-color: var(--btn-hover-bord); }
TyCard:disabled { opacity: var(--disabled); }

/* Title band: never tinted — Fluent divides with a neutralStroke hairline, so the
   band is the card's own sheet plus a rule under it. Semibold like the primary
   button (600, not bold); no padding of its own, so the title lines up with the
   body on the card's 12px inset. */
TyCardHeader {
  color: var(--ink);
  border-color: var(--border);
  border-width: 1px;
  font-weight: 600;
}
/* Actions rail: the same hairline, this time above the strip. */
TyCardActions { border-color: var(--border); border-width: 1px; }

/* Pill: Fluent's filled tag — neutral chip fill, no stroke, 4px rounded rect. */
TyTag {
  background: var(--chip);
  color: var(--ink);
  border-radius: var(--radius);
  padding: 0px 8px;
}
/* Brand/danger tags TINT their own hue and ink in it: Fluent's brand tag is
   brandBackground2, not a solid block. Same 0.12 wash the ghost button's
   :selected already uses — and it keeps the x readable, which a solid fill
   under a neutral x would not. */
TyTag.accent   { background: alpha(var(--accent), 0.12); color: var(--accent); }
TyTag.danger   { background: alpha(var(--danger), 0.12); color: var(--danger); }
TyTag:disabled { opacity: var(--disabled); }

/* The x stays neutral on every variant (Fluent never brands its dismiss); its
   hover chip takes the PRESSED wash, because the faint --ghost-hover would
   vanish against the tag's own fill. */
TyTagClose       { color: var(--muted); }
TyTagClose:hover { background: var(--pressed); color: var(--ink); border-radius: var(--radius); }

/* Badge: Fluent's Badge IS circular, so the inherited round pill is right in
   shape — but it must ride THIS file's --radius-pill and the Fluent semibold
   rather than the base's --radius-round/bold, and seed from --accent so the
   runtime accent-picker recolours it in either mode. */
TyBadge {
  background: var(--accent);
  color: var(--on-accent);
  border-radius: var(--radius-pill);
  font-weight: 600;
}

/* Controls hosted ON the title bar. A skin that paints the bar in a strong colour leaves an
   ordinary button's surface-tuned ink nearly invisible there; the control appends the
   'on-titlebar' variant automatically (TyStyleClassFor), so this is the only place a theme
   has to say what belongs on its own bar. Composed with whatever class the host set, so a
   ghost button on a title bar stays a ghost button and only its ink moves. */
TyButton.on-titlebar, TySpeedButton.on-titlebar, TyGlyphButton.on-titlebar,
TyGlyphContainerButton.on-titlebar, TyDropDownButton.on-titlebar,
TyMenuButton.on-titlebar, TyColorButton.on-titlebar, TyButtonGroup.on-titlebar,
TyLabel.on-titlebar, TyCheckBox.on-titlebar, TyToggleSwitch.on-titlebar {
  color: var(--on-titlebar);
}
