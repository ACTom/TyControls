/* breeze — KDE Plasma "Breeze", re-authored to feel GENUINELY NATIVE, DUAL-MODE.
   Breeze's identity is flatness: grey #EFF0F1 chrome, clean white fields, thin
   #BCC0C4 hairlines, small 3px corners, the #3DAEE9 Breeze blue that lights up
   borders on hover/focus. LIGHT is Breeze-light; DARK is Breeze-dark (#232629
   chrome, #1B1E20 wells, #31363B raised buttons, light #EFF0F1 ink). Every
   mode-flipping colour is a --var overridden per @mode; the flat render-style,
   3px radii, tight padding and normal weight are identical across modes. --accent
   is the Breeze-blue brand seed so the runtime picker still re-tints everything. */

/* Mode-invariant seed: the Breeze blue brand accent (runtime-picker overridable). */
:root { --accent: #3DAEE9; }

/* LIGHT palette — Breeze-light. */
@mode light {
  :root {
    --surface:           #EFF0F1;   /* window body                             */
    --titlebar:          #E3E5E7;   /* header band, a touch darker than window */
    --ink:               #232627;   /* primary text                            */
    --ink-disabled:      #A0A4A8;   /* muted / disabled text                   */
    --on-accent:         #FFFFFF;   /* ink on solid accent fills               */
    --danger:            #DA4453;   /* Breeze negative / destructive red       */
    --field:             #FFFFFF;   /* white input well                        */
    --field-border:      #BCC0C4;   /* hairline field border                   */
    --field-hover-brd:   #9DA5AB;   /* field hover edge                        */
    --field-disabled:    #F4F5F6;   /* disabled well                           */
    --btn-face:          #FCFCFC;   /* near-white button face                  */
    --btn-border:        #BCC0C4;   /* button hairline                         */
    --btn-hover-face:    #F3FAFE;   /* hover face, faint blue wash             */
    --btn-active-face:   #E7F4FB;   /* press face, deeper blue wash            */
    --check-bg:          #FFFFFF;   /* checkbox / radio well                   */
    --check-border:      #9DA1A5;   /* checkbox / radio edge                   */
    --groove:            #D3D6D9;   /* progress groove                         */
    --groove-border:     #BCC0C4;   /* progress groove edge                    */
    --border-disabled:   #D8DCDF;   /* disabled edge                           */
    --btn-shadow:        #0000000F;   /* whisper-soft lift (Breeze is near-flat) */
    --caption-hover:     darken(#E3E5E7, 6);   /* caption hover wash           */
    --caption-active:    darken(#E3E5E7, 11);  /* caption press wash           */
  }
}

/* DARK palette — Breeze-dark. Same structure, only the colours flip; shadows off. */
@mode dark {
  :root {
    --surface:           #232629;
    --titlebar:          #2A2E32;
    --ink:               #EFF0F1;
    --ink-disabled:      #6E7377;
    --on-accent:         #FFFFFF;
    --danger:            #DA4453;
    --field:             #1B1E20;
    --field-border:      #31363B;
    --field-hover-brd:   #454A4F;
    --field-disabled:    #26292C;
    --btn-face:          #31363B;
    --btn-border:        #3E4348;
    --btn-hover-face:    #3B4045;
    --btn-active-face:   #2A2E32;
    --check-bg:          #1B1E20;
    --check-border:      #5A5F63;
    --groove:            #1B1E20;
    --groove-border:     #31363B;
    --border-disabled:   #2E3236;
    --btn-shadow:        #00000000;
    --caption-hover:     lighten(#2A2E32, 7);
    --caption-active:    lighten(#2A2E32, 12);
  }
}

/* Window: the flat Breeze surface. */
TyForm          { background: var(--surface); }

/* Title bar: header band, a hair darker than the window, with high-contrast ink. */
TyTitleBar, TyRibbonQuickAccess      { background: var(--titlebar); color: var(--ink); border-radius: 3; }
TyCaptionButton { render-style: flat; background: transparent; color: var(--ink); border-radius: 3; }
TyCaptionButton:hover        { background: var(--caption-hover); color: var(--ink); }
TyCaptionButton:active       { background: var(--caption-active); color: var(--ink); }
TyCaptionButton:disabled     { background: transparent; color: var(--ink-disabled); }
TyCaptionButton.close:hover  { background: #DA4453; color: #FFFFFF; }
TyCaptionButton.close:active { background: #C0392B; color: #FFFFFF; }

TyLabel, TyHtmlLabel, TyLinkLabel, TyShadowLabel, TyGlowLabel, TyDivider, TyCharImage         { color: var(--ink); }

/* Buttons: flat near-white face, #BCC0C4 hairline, 3px corners, tight padding.
   Hover lights the border Breeze-blue over a faint blue face; press deepens it. */
TyButton, TySpeedButton, TyGlyphContainerButton, TyRibbonAppMenu, TyButtonGroup, TyUpDown                { render-style: flat; background: var(--btn-face); color: var(--ink); border: 1px solid var(--btn-border); border-radius: 3; padding: 5px 9px; font-weight: normal; shadow: 0 1 2 var(--btn-shadow); }
TyButton:hover, TySpeedButton:hover, TyGlyphContainerButton:hover, TyRibbonAppMenu:hover, TyButtonGroup:hover, TyUpDown:hover          { background: var(--btn-hover-face); color: var(--ink); border-color: var(--accent); }
TyButton:active, TySpeedButton:active, TyGlyphContainerButton:active, TyRibbonAppMenu:active, TyButtonGroup:active, TyUpDown:active         { background: var(--btn-active-face); color: var(--ink); border-color: var(--accent); }
TyButton:focus, TySpeedButton:focus, TyGlyphContainerButton:focus, TyRibbonAppMenu:focus, TyButtonGroup:focus, TyUpDown:focus          { outline: 1 var(--accent); outline-offset: 1px; }
TyButton:disabled, TySpeedButton:disabled, TyGlyphContainerButton:disabled,
TyRibbonAppMenu:disabled       { background: var(--field-disabled); color: var(--ink-disabled); border-color: var(--border-disabled); shadow: 0 0 0 #00000000; }

/* Primary: solid Breeze-blue fill, white ink, same tight footprint. */
TyButton.primary, TySpeedButton.primary, TyGlyphContainerButton.primary, TyRibbonAppMenu.primary, TyButtonGroup.primary, TyUpDown.primary          { render-style: flat; background: var(--accent); color: var(--on-accent); border: 1px solid var(--accent); border-radius: 3; padding: 5px 9px; font-weight: normal; }
TyButton.primary:hover, TySpeedButton.primary:hover, TyGlyphContainerButton.primary:hover,
TyRibbonAppMenu.primary:hover    { background: lighten(var(--accent), 8); border-color: lighten(var(--accent), 8); color: var(--on-accent); }
TyButton.primary:active, TySpeedButton.primary:active, TyGlyphContainerButton.primary:active,
TyRibbonAppMenu.primary:active   { background: darken(var(--accent), 10); border-color: darken(var(--accent), 10); color: var(--on-accent); }
TyButton.primary:focus, TySpeedButton.primary:focus, TyGlyphContainerButton.primary:focus,
TyRibbonAppMenu.primary:focus    { outline: 1 var(--accent); outline-offset: 2px; }
TyButton.primary:disabled, TySpeedButton.primary:disabled,
TyGlyphContainerButton.primary:disabled, TyRibbonAppMenu.primary:disabled { background: alpha(var(--accent), 0.4); border-color: transparent; color: var(--on-accent); }

/* Danger: solid Breeze-negative fill, white ink, same tight footprint as primary. */
TyButton.danger, TySpeedButton.danger, TyGlyphContainerButton.danger, TyRibbonAppMenu.danger, TyButtonGroup.danger, TyUpDown.danger          { render-style: flat; background: var(--danger); color: var(--on-accent); border: 1px solid var(--danger); border-radius: 3; padding: 5px 9px; font-weight: normal; }
TyButton.danger:hover, TySpeedButton.danger:hover, TyGlyphContainerButton.danger:hover,
TyRibbonAppMenu.danger:hover    { background: lighten(var(--danger), 8); border-color: lighten(var(--danger), 8); color: var(--on-accent); }
TyButton.danger:active, TySpeedButton.danger:active, TyGlyphContainerButton.danger:active,
TyRibbonAppMenu.danger:active   { background: darken(var(--danger), 10); border-color: darken(var(--danger), 10); color: var(--on-accent); }
TyButton.danger:focus, TySpeedButton.danger:focus, TyGlyphContainerButton.danger:focus,
TyRibbonAppMenu.danger:focus    { outline: 1 var(--danger); outline-offset: 2px; }
TyButton.danger:disabled, TySpeedButton.danger:disabled, TyGlyphContainerButton.danger:disabled,
TyRibbonAppMenu.danger:disabled { background: alpha(var(--danger), 0.4); border-color: transparent; color: var(--on-accent); }

/* Ghost: borderless accent text; hover paints a translucent Breeze-blue wash. */
TyButton.ghost, TySpeedButton.ghost, TyGlyphContainerButton.ghost, TyRibbonAppMenu.ghost, TyButtonGroup.ghost, TyUpDown.ghost          { render-style: flat; background: transparent; color: var(--accent); border: 1px solid transparent; border-radius: 3; padding: 5px 9px; font-weight: normal; }
TyButton.ghost:hover, TySpeedButton.ghost:hover, TyGlyphContainerButton.ghost:hover,
TyRibbonAppMenu.ghost:hover    { background: alpha(var(--accent), 0.12); color: var(--accent); border-color: transparent; }
TyButton.ghost:active, TySpeedButton.ghost:active, TyGlyphContainerButton.ghost:active,
TyRibbonAppMenu.ghost:active   { background: alpha(var(--accent), 0.20); color: var(--accent); border-color: transparent; }
TyButton.ghost:disabled, TySpeedButton.ghost:disabled, TyGlyphContainerButton.ghost:disabled,
TyRibbonAppMenu.ghost:disabled { background: transparent; color: var(--ink-disabled); border-color: transparent; }

/* Fields: crisp white (dark: deep) wells, hairline border, accent edge on focus. */
TyEdit          { render-style: flat; background: var(--field); color: var(--ink); border: 1px solid var(--field-border); border-radius: 3; padding: 4px 6px; }
TyEdit:hover    { border-color: var(--field-hover-brd); }
TyEdit:focus    { border-color: var(--accent); outline: 1 alpha(var(--accent), 0.5); outline-offset: 0px; }
TyEdit:disabled { background: var(--field-disabled); color: var(--ink-disabled); border-color: var(--border-disabled); }

TyComboBox          { render-style: flat; background: var(--field); color: var(--ink); border: 1px solid var(--field-border); border-radius: 3; padding: 4px 6px; }
TyComboBox:hover    { border-color: var(--field-hover-brd); }
TyComboBox:focus    { border-color: var(--accent); outline: 1 alpha(var(--accent), 0.5); outline-offset: 0px; }
TyComboBox:disabled { background: var(--field-disabled); color: var(--ink-disabled); border-color: var(--border-disabled); }

/* Check box: white well, #9DA1A5 edge, accent tick, 2px corners. Hover/active
   light the edge blue; checked flips to a solid accent box with a white tick. */
TyCheckBox           { background: var(--check-bg); color: var(--accent); border: 1px solid var(--check-border); border-radius: 2; }
TyCheckBox:hover     { background: var(--check-bg); color: var(--accent); border: 1px solid var(--accent); border-radius: 2; }
TyCheckBox:active    { background: var(--check-bg); color: var(--accent); border: 1px solid var(--accent); border-radius: 2; }
TyCheckBox:selected  { background: var(--accent); color: var(--on-accent); border: 1px solid var(--accent); border-radius: 2; }
TyCheckBox:disabled  { background: var(--field-disabled); color: var(--ink-disabled); border: 1px solid var(--border-disabled); border-radius: 2; }

/* Radio: same treatment as the check box (the control paints the circle itself). */
TyRadioButton           { background: var(--check-bg); color: var(--accent); border: 1px solid var(--check-border); border-radius: 2; }
TyRadioButton:hover     { background: var(--check-bg); color: var(--accent); border: 1px solid var(--accent); border-radius: 2; }
TyRadioButton:active    { background: var(--check-bg); color: var(--accent); border: 1px solid var(--accent); border-radius: 2; }
TyRadioButton:selected  { background: var(--accent); color: var(--on-accent); border: 1px solid var(--accent); border-radius: 2; }
TyRadioButton:disabled  { background: var(--field-disabled); color: var(--ink-disabled); border: 1px solid var(--border-disabled); border-radius: 2; }

/* Progress: a thin groove with a solid Breeze-blue fill. */
TyProgressBar   { render-style: flat; background: var(--groove); color: var(--ink); border: 1px solid var(--groove-border); border-radius: 3; }
TyProgressFill  { background: var(--accent); border-radius: 2; }

/* ---- Card + Tag + Badge ---- */

/* Card: the Plasma page recipe — a view between a tinted header toolbar and a tinted
   footer button box. The face is var(--field) because in Breeze an input well and a
   content view are ONE colour role (white on light, #1B1E20 on dark), so the card sits
   in the window exactly the way a Dolphin view does: one #BCC0C4 hairline, the 3px
   corner every surface here gets, and the buttons' whisper-soft lift — which the dark
   palette already zeroes, because Breeze-dark casts nothing. :hover lights the frame
   Breeze-blue, the same answer a button or a field gives, so 'hoverable' costs no new
   idea. Disabled greys the surface explicitly: Breeze dims by colour, never by fade. */
TyCard          { render-style: flat; background: var(--field); color: var(--ink); border: 1px solid var(--field-border); border-radius: 3; padding: 9px; shadow: 0 1 2 var(--btn-shadow); }
TyCard:hover    { border-color: var(--accent); }
TyCard:disabled { background: var(--field-disabled); color: var(--ink-disabled); border-color: var(--border-disabled); shadow: 0 0 0 #00000000; }

/* Header + actions: tinted bands — the window grey laid over the view and cut off by the
   same hairline. That is literally how a System Settings page is built, and it is what
   separates Breeze from the other flat skins, which leave the bands transparent. Bold is
   reserved for a heading; buttons and badges keep this skin's normal weight. Padding is
   left unset on purpose, so the title sits on the card's own 9px gutter, level with the
   body. */
TyCardHeader  { background: var(--surface); color: var(--ink); border: 1px solid var(--field-border); font-weight: bold; }
TyCardActions { background: var(--surface); border: 1px solid var(--field-border); }

/* Tag: a Kirigami chip, i.e. a miniature Breeze button — near-white face, hairline, 3px
   corners, NOT a round pill: nothing in this language is round-ended, so the base layer's
   pill idiom stops at the badge. The 8px gutter sits between the button's 9px and the
   field's 6px, which is where a chip belongs. Hover lights the edge blue like every other
   Breeze control; the two variants fill solid and brighten on hover exactly as
   .primary/.danger do — including their white ink, since --on-accent is this file's ink
   for any solid fill. */
TyTag                { render-style: flat; background: var(--btn-face); color: var(--ink); border: 1px solid var(--btn-border); border-radius: 3; padding: 0px 8px; }
TyTag:hover          { border-color: var(--accent); }
TyTag.accent         { background: var(--accent); color: var(--on-accent); border: 1px solid var(--accent); }
TyTag.accent:hover   { background: lighten(var(--accent), 8); border-color: lighten(var(--accent), 8); color: var(--on-accent); }
TyTag.danger         { background: var(--danger); color: var(--on-accent); border: 1px solid var(--danger); }
TyTag.danger:hover   { background: lighten(var(--danger), 8); border-color: lighten(var(--danger), 8); color: var(--on-accent); }
TyTag:disabled       { background: var(--field-disabled); color: var(--ink-disabled); border-color: var(--border-disabled); }

/* Tag close 'x': muted at rest (--ink-disabled is this file's secondary ink), and its
   hover chip is the ghost button's translucent Breeze-blue wash on the checkbox's 2px
   corner — Breeze answers hover with blue, never with red; only the window's own close
   button earns the red. On a solid accent/danger pill a grey x would sink into the fill,
   so there the ink is the white the pill already uses and the chip is a white wash.
   :disabled has to come back to grey EXPLICITLY: TyTag:disabled greys the pill away from
   its variant fill, but the variant's white ink is set on the x's own key and states
   resolve after variants, so without this rule a disabled accent/danger tag would keep a
   white x on the near-white disabled pill — an x that is simply not there. */
TyTagClose              { color: var(--ink-disabled); }
TyTagClose:hover        { background: alpha(var(--accent), 0.12); color: var(--accent); border-radius: 2; }
TyTagClose.accent       { color: var(--on-accent); }
TyTagClose.accent:hover { background: alpha(var(--on-accent), 0.20); color: var(--on-accent); border-radius: 2; }
TyTagClose.danger       { color: var(--on-accent); }
TyTagClose.danger:hover { background: alpha(var(--on-accent), 0.20); color: var(--on-accent); border-radius: 2; }
TyTagClose:disabled     { color: var(--ink-disabled); }

/* Badge: Breeze blue, white numerals, round. The inherited base pill already has the
   right shape — Plasma's counters (task manager, Kickoff) really are circular even though
   the rest of this language stops at 3px — but its numerals are bold, and nothing here is
   bold except a heading. The tight 0/4 padding is the same air the whole skin runs on. */
TyBadge { background: var(--accent); color: var(--on-accent); border-radius: var(--radius-round); font-weight: normal; padding: 0px 4px; }
