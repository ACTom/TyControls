/* adwaita — GNOME libadwaita, re-authored to read GENUINELY NATIVE (not "zoomed").
   Restrained and flat. LIGHT: soft off-white window, a slightly darker flat headerbar with
   dark ink, crisp white fields, hairline borders, gentle 6px radii, and the GNOME blue as the
   single accent. DARK: ~#242424 surfaces, a #303030 headerbar, ~#1E1E1E fields, light ink,
   subtle borders, the same blue. Only the PALETTE flips per @mode — every radius/gradient/
   padding/render-style is shared. Default buttons are NORMAL weight with compact 5x9 padding so
   short CJK/label captions fit without truncation. --accent is the brand seed the picker recolours. */

/* --- palette: light ------------------------------------------------------ */
@mode light {
  :root {
    --accent:       #3584E4;   /* GNOME blue — brand/accent seed              */
    --danger:       #E01B24;   /* GNOME red 3 — destructive action             */
    --window:       #FAFAFA;   /* window background                            */
    --header:       #EBEBEB;   /* headerbar / title bar (a touch darker)       */
    --card:         #FFFFFF;   /* card surface — white, above the window       */
    --field:        #FFFFFF;   /* text-entry wells                             */
    --ink:          #2E3436;   /* primary dark text                            */
    --muted:        #9A9996;   /* disabled / secondary ink                     */
    --border:       #DCDCDC;   /* hairline separators & field edges            */
    --btn-face:     #FFFFFF;   /* default button face (top gradient stop)      */
    --btn-face2:    #F6F6F6;   /* default button face (bottom gradient stop)   */
    --btn-border:   #DBDBDB;   /* default button edge                          */
    --btn-hover:    #F2F2F2;   /* default button hover fill                    */
    --btn-active:   #E8E8E8;   /* default button pressed fill                  */
    --check-border: #C0C0C0;   /* checkbox / radio edge                        */
    --track:        #DCDCDC;   /* progress trough                              */
    --ghost-hover:  #0000000D; /* flat/ghost hover wash                        */
    --ghost-active: #0000001A; /* flat/ghost pressed wash                      */
    --shadow:       #0000001A; /* subtle button lift                           */
  }
}

/* --- palette: dark ------------------------------------------------------- */
@mode dark {
  :root {
    --accent:       #3584E4;   /* same GNOME blue — brand/accent seed          */
    --danger:       #C01C28;   /* GNOME red 4 — destructive action, dark       */
    --window:       #242424;   /* window background                            */
    --header:       #303030;   /* headerbar / title bar                        */
    --card:         #303030;   /* card surface — a step above the window       */
    --field:        #1E1E1E;   /* text-entry wells                             */
    --ink:          #FFFFFF;   /* primary light text                           */
    --muted:        #8A8A8A;   /* disabled / secondary ink                     */
    --border:       #3A3A3A;   /* subtle separators & field edges              */
    --btn-face:     #363636;   /* default button face (top gradient stop)      */
    --btn-face2:    #323232;   /* default button face (bottom gradient stop)   */
    --btn-border:   #4A4A4A;   /* default button edge                          */
    --btn-hover:    #404040;   /* default button hover fill                    */
    --btn-active:   #2E2E2E;   /* default button pressed fill                  */
    --check-border: #5A5A5A;   /* checkbox / radio edge                        */
    --track:        #3A3A3A;   /* progress trough                              */
    --ghost-hover:  #FFFFFF14; /* flat/ghost hover wash                        */
    --ghost-active: #FFFFFF26; /* flat/ghost pressed wash                      */
    --shadow:       #00000040; /* subtle button lift                           */
  }
}

/* --- window + chrome ----------------------------------------------------- */
TyForm            { background: var(--window); }
TyTitleBar, TyRibbonQuickAccess        { background: var(--header); color: var(--ink); border-bottom: 1px solid var(--border); border-radius: 0; }
TyCaptionButton   { render-style: flat; background: transparent; color: var(--ink); border-radius: 6; }
TyCaptionButton:hover  { background: var(--ghost-hover);  color: var(--ink); }
TyCaptionButton:active { background: var(--ghost-active); color: var(--ink); }
TyCaptionButton.close:hover  { background: var(--ghost-hover);  color: var(--ink); }
TyCaptionButton.close:active { background: var(--ghost-active); color: var(--ink); }

TyLabel, TyHtmlLabel, TyLinkLabel, TyShadowLabel, TyGlowLabel, TyDivider, TyCharImage           { color: var(--ink); }

/* --- buttons ------------------------------------------------------------- */
/* Native GNOME default: near-white face with a whisper of top-to-bottom shading, a hairline
   edge, a 6px radius, a soft lift, and NORMAL-weight ink. Compact 5x9 padding. */
TyButton, TySpeedButton, TyGlyphContainerButton, TyRibbonAppMenu, TyButtonGroup, TyUpDown                { render-style: flat; background: linear-gradient(90deg, var(--btn-face), var(--btn-face2)); color: var(--ink); border: 1px solid var(--btn-border); border-radius: 6; padding: 5px 9px; font-weight: normal; shadow: 0 1 1 var(--shadow); }
TyButton:hover, TySpeedButton:hover, TyGlyphContainerButton:hover, TyRibbonAppMenu:hover, TyButtonGroup:hover, TyUpDown:hover          { background: var(--btn-hover);  border-color: darken(var(--btn-border), 5); }
TyButton:active, TySpeedButton:active, TyGlyphContainerButton:active, TyRibbonAppMenu:active, TyButtonGroup:active, TyUpDown:active         { background: var(--btn-active); border-color: darken(var(--btn-border), 10); shadow: 0 0 0 transparent; }
TyButton:focus, TySpeedButton:focus, TyGlyphContainerButton:focus, TyRibbonAppMenu:focus, TyButtonGroup:focus, TyUpDown:focus          { border-color: var(--accent); outline: 2 alpha(var(--accent), 0.4); outline-offset: 1; }
TyButton:disabled, TySpeedButton:disabled, TyGlyphContainerButton:disabled,
TyRibbonAppMenu:disabled       { background: var(--btn-face); color: var(--muted); border-color: lighten(var(--btn-border), 2); shadow: 0 0 0 transparent; }

/* Suggested-action = solid accent, auto-contrast ink, NORMAL weight (GNOME never bolds it). */
TyButton.primary, TySpeedButton.primary, TyGlyphContainerButton.primary, TyRibbonAppMenu.primary, TyButtonGroup.primary, TyUpDown.primary          { background: var(--accent); color: on(var(--accent)); border: 1px solid darken(var(--accent), 8); border-radius: 6; padding: 5px 9px; font-weight: normal; shadow: 0 1 1 var(--shadow); }
TyButton.primary:hover, TySpeedButton.primary:hover, TyGlyphContainerButton.primary:hover,
TyRibbonAppMenu.primary:hover    { background: lighten(var(--accent), 6); border-color: darken(var(--accent), 4); }
TyButton.primary:active, TySpeedButton.primary:active, TyGlyphContainerButton.primary:active,
TyRibbonAppMenu.primary:active   { background: darken(var(--accent), 10); border-color: darken(var(--accent), 16); shadow: 0 0 0 transparent; }
TyButton.primary:focus, TySpeedButton.primary:focus, TyGlyphContainerButton.primary:focus,
TyRibbonAppMenu.primary:focus    { border-color: darken(var(--accent), 12); outline: 2 alpha(var(--accent), 0.5); outline-offset: 1; }
TyButton.primary:disabled, TySpeedButton.primary:disabled,
TyGlyphContainerButton.primary:disabled, TyRibbonAppMenu.primary:disabled { background: alpha(var(--accent), 0.4); color: alpha(#FFFFFF, 0.85); border-color: transparent; shadow: 0 0 0 transparent; }

/* Destructive-action = the same solid slab as suggested-action, driven by GNOME red instead. */
TyButton.danger, TySpeedButton.danger, TyGlyphContainerButton.danger, TyRibbonAppMenu.danger, TyButtonGroup.danger, TyUpDown.danger          { background: var(--danger); color: on(var(--danger)); border: 1px solid darken(var(--danger), 8); border-radius: 6; padding: 5px 9px; font-weight: normal; shadow: 0 1 1 var(--shadow); }
TyButton.danger:hover, TySpeedButton.danger:hover, TyGlyphContainerButton.danger:hover,
TyRibbonAppMenu.danger:hover    { background: lighten(var(--danger), 6); border-color: darken(var(--danger), 4); }
TyButton.danger:active, TySpeedButton.danger:active, TyGlyphContainerButton.danger:active,
TyRibbonAppMenu.danger:active   { background: darken(var(--danger), 10); border-color: darken(var(--danger), 16); shadow: 0 0 0 transparent; }
TyButton.danger:focus, TySpeedButton.danger:focus, TyGlyphContainerButton.danger:focus,
TyRibbonAppMenu.danger:focus    { border-color: darken(var(--danger), 12); outline: 2 alpha(var(--danger), 0.5); outline-offset: 1; }
TyButton.danger:disabled, TySpeedButton.danger:disabled, TyGlyphContainerButton.danger:disabled,
TyRibbonAppMenu.danger:disabled { background: alpha(var(--danger), 0.4); color: alpha(#FFFFFF, 0.85); border-color: transparent; shadow: 0 0 0 transparent; }

/* Flat/ghost = borderless; a faint wash appears on interaction. */
TyButton.ghost, TySpeedButton.ghost, TyGlyphContainerButton.ghost, TyRibbonAppMenu.ghost, TyButtonGroup.ghost, TyUpDown.ghost          { render-style: flat; background: transparent; color: var(--ink); border: 1px solid transparent; border-radius: 6; padding: 5px 9px; font-weight: normal; shadow: 0 0 0 transparent; }
TyButton.ghost:hover, TySpeedButton.ghost:hover, TyGlyphContainerButton.ghost:hover,
TyRibbonAppMenu.ghost:hover    { background: var(--ghost-hover);  border-color: transparent; }
TyButton.ghost:active, TySpeedButton.ghost:active, TyGlyphContainerButton.ghost:active,
TyRibbonAppMenu.ghost:active   { background: var(--ghost-active); border-color: transparent; }
TyButton.ghost:disabled, TySpeedButton.ghost:disabled, TyGlyphContainerButton.ghost:disabled,
TyRibbonAppMenu.ghost:disabled { background: transparent; color: var(--muted); border-color: transparent; }

/* --- text inputs --------------------------------------------------------- */
TyEdit            { background: var(--field); color: var(--ink); border: 1px solid var(--border); border-radius: 6; padding: 5px 8px; }
TyEdit:hover      { border-color: darken(var(--border), 8); }
TyEdit:focus      { border-color: var(--accent); outline: 2 alpha(var(--accent), 0.45); outline-offset: 1; }
TyEdit:disabled   { background: var(--window); color: var(--muted); border-color: lighten(var(--border), 3); }

TyComboBox        { background: var(--field); color: var(--ink); border: 1px solid var(--border); border-radius: 6; padding: 5px 8px; }
TyComboBox:hover  { border-color: darken(var(--border), 8); }
TyComboBox:focus  { border-color: var(--accent); outline: 2 alpha(var(--accent), 0.45); outline-offset: 1; }
TyComboBox:disabled { background: var(--window); color: var(--muted); border-color: lighten(var(--border), 3); }

/* --- checkbox ------------------------------------------------------------ */
/* White well, hairline edge, accent tick; checked = solid-accent box with white tick. */
TyCheckBox        { background: var(--field); color: var(--accent); border: 1px solid var(--check-border); border-radius: 5; }
TyCheckBox:hover  { border-color: var(--accent); }
TyCheckBox:active { background: var(--accent); color: #FFFFFF; border: 1px solid var(--accent); border-radius: 5; }
TyCheckBox:disabled { background: var(--window); color: var(--muted); border-color: lighten(var(--check-border), 3); }

/* --- radio --------------------------------------------------------------- */
TyRadioButton        { background: var(--field); color: var(--accent); border: 1px solid var(--check-border); }
TyRadioButton:hover  { border-color: var(--accent); }
TyRadioButton:active { background: var(--accent); color: #FFFFFF; border: 1px solid var(--accent); }
TyRadioButton:disabled { background: var(--window); color: var(--muted); border-color: lighten(var(--check-border), 3); }

/* --- progress ------------------------------------------------------------ */
/* Slim, fully-rounded trough with a solid accent fill. */
TyProgressBar     { background: var(--track); border: none; border-radius: 100; }
TyProgressFill    { background: var(--accent); border-radius: 100; }

/* --- cards --------------------------------------------------------------- */
/* libadwaita's .card is ONE elevated surface: white on the light window, a step lighter
   than the window in dark. GNOME rounds a card harder than a button (12 vs 6) but keeps
   the same hairline edge and the same gentle lift; boxed-list padding breathes sideways
   (12) more than up/down (10). */
TyCard            { background: var(--card); color: var(--ink); border: 1px solid var(--border); border-radius: 12; padding: 10px 12px; shadow: 0 1 2 var(--shadow); }
TyCard:hover      { border-color: darken(var(--border), 8); shadow: 0 1 3 var(--shadow); }
TyCard:disabled   { color: var(--muted); border-color: lighten(var(--border), 3); shadow: 0 0 0 transparent; }

/* Header and actions are bands on that one surface — GNOME tints neither, a hairline
   separator is the whole treatment. The header takes no padding of its own, so the title
   lines up with the body; it IS bold (the normal-weight rule above is about buttons, and
   a card title is a GNOME heading). */
TyCardHeader          { color: var(--ink); border: 1px solid var(--border); font-weight: bold; }
TyCardHeader:disabled { color: var(--muted); }
TyCardActions         { border: 1px solid var(--border); }

/* --- tags ---------------------------------------------------------------- */
/* GNOME's pill: the button's flat face (a tag is a label, so it takes the face without
   the button's shading), a hairline edge, fully-round ends. It does NOT light up on
   hover — a status pill isn't a button, only its x reacts. The two variants are the same
   solid slabs as the suggested- and destructive-action buttons, dimmed the same way. */
TyTag                 { background: var(--btn-face2); color: var(--ink); border: 1px solid var(--btn-border); border-radius: 100; padding: 0px 9px; }
TyTag.accent          { background: var(--accent); color: on(var(--accent)); border-color: darken(var(--accent), 8); }
TyTag.danger          { background: var(--danger); color: on(var(--danger)); border-color: darken(var(--danger), 8); }
TyTag:disabled        { color: var(--muted); border-color: lighten(var(--btn-border), 2); }
TyTag.accent:disabled { background: alpha(var(--accent), 0.4); color: alpha(#FFFFFF, 0.85); border-color: transparent; }
TyTag.danger:disabled { background: alpha(var(--danger), 0.4); color: alpha(#FFFFFF, 0.85); border-color: transparent; }

/* The x has no resting rule on purpose: it borrows the pill's own ink, which is already
   the right one on all three faces. Hover gives it GNOME's round flat-button wash. */
TyTagClose:hover  { background: var(--ghost-hover); border-radius: 100; }

/* --- badge --------------------------------------------------------------- */
/* The suggested-action button's little sibling: same solid accent slab, same auto-contrast
   ink, same NORMAL weight (GNOME never bolds an accent — the inherited pill's bold is not
   this desktop). Fully round, and no edge or lift: a badge is a marker, not a control. */
TyBadge           { background: var(--accent); color: on(var(--accent)); border-radius: 100; font-weight: normal; padding: 0px 4px; }