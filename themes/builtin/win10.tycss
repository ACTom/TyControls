/* win10 — an authentic Windows 10 (flat Metro / Fluent-1) skin, DUAL-MODE.
   The language is FLAT, SHARP, SQUARE: solid surfaces, hairline 1px borders, zero
   corner radius, one signature accent that the runtime accent-picker can recolour
   (every blue derives from --accent; the pale button washes derive from it too).
     @mode light = classic Win10: #F3F3F3 window, WHITE title bar with black text,
                   white fields with a #7A7A7A border that turns #0078D7 on focus,
                   #E1E1E1 default buttons, #0078D7 primary.
     @mode dark  = Win10 dark: #202020 window, #2B2B2B title bar, #333 fields/buttons,
                   a brighter #4CC2FF accent — SAME flat/square geometry, normal weight.
   Only the COLOURS flip between modes; radius, border width and font-weight are identical. */

/* ---- LIGHT palette ---- */
@mode light {
  :root {
    --accent:  #0078D7;   /* Windows 10 signature blue — brand seed */
    --danger:  #E81123;   /* Windows 10 red — the caption close-button red */
    --surface: #F3F3F3;   /* window / app background (OS grey) */
    --field:   #FFFFFF;   /* editable well */
    --ink:     #000000;   /* primary text — Win10 uses black */
    --ink-dim: #A0A0A0;   /* disabled text */

    /* title bar + caption chrome (white bar, black ink) */
    --titlebar-bg:     #FFFFFF;
    --titlebar-border: #E1E1E1;
    --caption-hover:   #E5E5E5;
    --caption-active:  #CCCCCC;

    /* fields */
    --field-border:       #7A7A7A;
    --field-hover-border:  #171717;

    /* default button */
    --button-face:   #E1E1E1;
    --button-border: #ADADAD;

    /* checkbox / radio */
    --checkbox-well:   #FFFFFF;
    --checkbox-border: #333333;

    /* progress */
    --progress-track: #E6E6E6;

    /* disabled chrome */
    --disabled-border: #E0E0E0;

    /* accent-derived button washes — follow the accent-picker (≈ #E5F1FB / #CCE4F7) */
    --accent-wash:        lighten(var(--accent), 84%);
    --accent-wash-strong: lighten(var(--accent), 74%);

    /* disabled primary */
    --primary-disabled-bg:  #CCCCCC;
    --primary-disabled-ink: #FFFFFF;
  }
}

/* ---- DARK palette ---- */
@mode dark {
  :root {
    --accent:  #4CC2FF;   /* brightened Win10 blue for dark surfaces — brand seed */
    --danger:  #E74856;   /* brightened Win10 red for dark surfaces */
    --surface: #202020;   /* window / app background */
    --field:   #333333;   /* editable well */
    --ink:     #FFFFFF;   /* primary text */
    --ink-dim: #6E6E6E;   /* disabled text */

    /* title bar + caption chrome */
    --titlebar-bg:     #2B2B2B;
    --titlebar-border: #3A3A3A;
    --caption-hover:   #3A3A3A;
    --caption-active:  #4A4A4A;

    /* fields */
    --field-border:       #555555;
    --field-hover-border:  #999999;

    /* default button */
    --button-face:   #333333;
    --button-border: #555555;

    /* checkbox / radio */
    --checkbox-well:   #2D2D2D;
    --checkbox-border: #555555;

    /* progress */
    --progress-track: #333333;

    /* disabled chrome */
    --disabled-border: #383838;

    /* accent-derived button washes — follow the accent-picker */
    --accent-wash:        mix(var(--accent), var(--surface), 22%);
    --accent-wash-strong: mix(var(--accent), var(--surface), 38%);

    /* disabled primary */
    --primary-disabled-bg:  #333333;
    --primary-disabled-ink: #777777;
  }
}

/* Window: solid, quiet surface. */
TyForm { background: var(--surface); }

/* Title bar: solid bar (white in light, near-black in dark) with a single hairline
   divider all round. Flat, square. */
TyTitleBar      { background: var(--titlebar-bg); color: var(--ink); border: 1px solid var(--titlebar-border); border-radius: 0; }
TyCaptionButton { render-style: flat; background: transparent; color: var(--ink); border-radius: 0; }
TyCaptionButton:hover        { background: var(--caption-hover); color: var(--ink); }
TyCaptionButton:active       { background: var(--caption-active); color: var(--ink); }
TyCaptionButton.close:hover  { background: #E81123; color: #FFFFFF; }
TyCaptionButton.close:active { background: #F1707A; color: #FFFFFF; }

/* Labels: primary ink on the surface. */
TyLabel { color: var(--ink); }

/* Default button: #E1E1E1 face, #ADADAD hairline border, black text, square.
   :hover — pale accent wash (#E5F1FB) with an accent border; :active — deeper wash. */
TyButton          { render-style: flat; background: var(--button-face); color: var(--ink); border: 1px solid var(--button-border); border-radius: 0; padding: 6px; font-weight: normal; }
TyButton:hover    { background: var(--accent-wash); color: var(--ink); border: 1px solid var(--accent); }
TyButton:active   { background: var(--accent-wash-strong); color: var(--ink); border: 1px solid var(--accent); }
TyButton:focus    { outline: 1 var(--accent); outline-offset: 1px; }
TyButton:disabled { background: var(--surface); color: var(--ink-dim); border: 1px solid var(--disabled-border); }

/* Primary button: solid accent fill, white text, accent border. Hover/press darken it. */
TyButton.primary          { render-style: flat; background: var(--accent); color: on(var(--accent)); border: 1px solid var(--accent); border-radius: 0; padding: 6px; font-weight: normal; }
TyButton.primary:hover    { background: darken(var(--accent), 8%);  border: 1px solid darken(var(--accent), 8%);  color: on(var(--accent)); }
TyButton.primary:active   { background: darken(var(--accent), 16%); border: 1px solid darken(var(--accent), 16%); color: on(var(--accent)); }
TyButton.primary:focus    { outline: 1 var(--accent); outline-offset: 1px; }
TyButton.primary:disabled { background: var(--primary-disabled-bg); color: var(--primary-disabled-ink); border: 1px solid var(--primary-disabled-bg); }

/* Danger button: mirrors primary in the Win10 red — solid fill, white text, red border. Hover/press darken it. */
TyButton.danger          { render-style: flat; background: var(--danger); color: on(var(--danger)); border: 1px solid var(--danger); border-radius: 0; padding: 6px; font-weight: normal; }
TyButton.danger:hover    { background: darken(var(--danger), 8%);  border: 1px solid darken(var(--danger), 8%);  color: on(var(--danger)); }
TyButton.danger:active   { background: darken(var(--danger), 16%); border: 1px solid darken(var(--danger), 16%); color: on(var(--danger)); }
TyButton.danger:focus    { outline: 1 var(--danger); outline-offset: 1px; }
TyButton.danger:disabled { background: var(--primary-disabled-bg); color: var(--primary-disabled-ink); border: 1px solid var(--primary-disabled-bg); }

/* Ghost button: no chrome at rest — accent-tinted text; pale accent wash on interaction. */
TyButton.ghost          { render-style: flat; background: transparent; color: var(--accent); border: 1px solid transparent; border-radius: 0; padding: 6px; font-weight: normal; }
TyButton.ghost:hover    { background: var(--accent-wash); color: var(--accent); border: 1px solid transparent; }
TyButton.ghost:active   { background: var(--accent-wash-strong); color: var(--accent); border: 1px solid transparent; }
TyButton.ghost:disabled { background: transparent; color: var(--ink-dim); border: 1px solid transparent; }

/* Fields: crisp white wells, #7A7A7A hairline border, square. Border darkens on hover,
   turns accent on focus — the Windows 10 text-box behaviour. */
TyEdit          { render-style: flat; background: var(--field); color: var(--ink); border: 1px solid var(--field-border); border-radius: 0; padding: 4px; }
TyEdit:hover    { border: 1px solid var(--field-hover-border); }
TyEdit:focus    { border: 1px solid var(--accent); }
TyEdit:disabled { background: var(--surface); color: var(--ink-dim); border: 1px solid var(--disabled-border); }

TyComboBox          { render-style: flat; background: var(--field); color: var(--ink); border: 1px solid var(--field-border); border-radius: 0; padding: 4px; }
TyComboBox:hover    { border: 1px solid var(--field-hover-border); }
TyComboBox:focus    { border: 1px solid var(--accent); }
TyComboBox:disabled { background: var(--surface); color: var(--ink-dim); border: 1px solid var(--disabled-border); }

/* Check box: white well, #333 stroked border, accent tick. Border/wash go accent on interaction. */
TyCheckBox          { background: var(--checkbox-well); color: var(--accent); border: 1px solid var(--checkbox-border); border-radius: 0; }
TyCheckBox:hover    { background: var(--checkbox-well); color: var(--accent); border: 1px solid var(--accent); border-radius: 0; }
TyCheckBox:active   { background: var(--accent-wash-strong); color: var(--accent); border: 1px solid var(--accent); border-radius: 0; }
TyCheckBox:disabled { background: var(--surface); color: var(--ink-dim); border: 1px solid var(--disabled-border); border-radius: 0; }

/* Radio button: mirrors the check box — same stroked well, accent dot. */
TyRadioButton          { background: var(--checkbox-well); color: var(--accent); border: 1px solid var(--checkbox-border); border-radius: 0; }
TyRadioButton:hover    { background: var(--checkbox-well); color: var(--accent); border: 1px solid var(--accent); border-radius: 0; }
TyRadioButton:active   { background: var(--accent-wash-strong); color: var(--accent); border: 1px solid var(--accent); border-radius: 0; }
TyRadioButton:disabled { background: var(--surface); color: var(--ink-dim); border: 1px solid var(--disabled-border); border-radius: 0; }

/* Progress: #E6E6E6 flat track, hairline border, solid accent fill, square. */
TyProgressBar  { render-style: flat; background: var(--progress-track); border: 1px solid var(--field-border); border-radius: 0; }
TyProgressFill { background: var(--accent); border-radius: 0; }