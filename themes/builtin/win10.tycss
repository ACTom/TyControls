/* win10 — an authentic Windows 10 (flat Metro / Fluent-1) skin, DUAL-MODE.
   The language is FLAT, SHARP, SQUARE: solid surfaces, hairline 1px borders, zero
   corner radius, one signature accent that the runtime accent-picker can recolour
   (every blue derives from --accent; the pale button washes derive from it too).
     @mode light = classic Win10: #F3F3F3 window, WHITE title bar with black text,
                   white fields with a #7A7A7A border that turns #0078D7 on focus,
                   #E1E1E1 default buttons, #0078D7 primary.
     @mode dark  = Win10 dark: #202020 window, #2B2B2B title bar, #333 fields/buttons,
                   a brighter #4CC2FF accent — SAME flat/square geometry, normal weight.
   Only the COLOURS flip between modes; radius, border width and font-weight are identical. */

/* ---- LIGHT palette ---- */
@mode light {
  :root {
    --accent:  #0078D7;   /* Windows 10 signature blue — brand seed */
    --danger:  #E81123;   /* Windows 10 red — the caption close-button red */
    --surface: #F3F3F3;   /* window / app background (OS grey) */
    --field:   #FFFFFF;   /* editable well */
    --ink:     #000000;   /* primary text — Win10 uses black */
    --ink-dim: #A0A0A0;   /* disabled text */

    /* title bar + caption chrome (white bar, black ink) */
    --titlebar-bg:     #FFFFFF;
    --titlebar-border: #E1E1E1;
    --caption-hover:   #E5E5E5;
    --caption-active:  #CCCCCC;

    /* fields */
    --field-border:       #7A7A7A;
    --field-hover-border:  #171717;

    /* default button */
    --button-face:   #E1E1E1;
    --button-border: #ADADAD;

    /* checkbox / radio */
    --checkbox-well:   #FFFFFF;
    --checkbox-border: #333333;

    /* progress */
    --progress-track: #E6E6E6;

    /* disabled chrome */
    --disabled-border: #E0E0E0;

    /* accent-derived button washes — follow the accent-picker (≈ #E5F1FB / #CCE4F7) */
    --accent-wash:        lighten(var(--accent), 84%);
    --accent-wash-strong: lighten(var(--accent), 74%);

    /* disabled primary */
    --primary-disabled-bg:  #CCCCCC;
    --primary-disabled-ink: #FFFFFF;
  }
}

/* ---- DARK palette ---- */
@mode dark {
  :root {
    --accent:  #4CC2FF;   /* brightened Win10 blue for dark surfaces — brand seed */
    --danger:  #E74856;   /* brightened Win10 red for dark surfaces */
    --surface: #202020;   /* window / app background */
    --field:   #333333;   /* editable well */
    --ink:     #FFFFFF;   /* primary text */
    --ink-dim: #6E6E6E;   /* disabled text */

    /* title bar + caption chrome */
    --titlebar-bg:     #2B2B2B;
    --titlebar-border: #3A3A3A;
    --caption-hover:   #3A3A3A;
    --caption-active:  #4A4A4A;

    /* fields */
    --field-border:       #555555;
    --field-hover-border:  #999999;

    /* default button */
    --button-face:   #333333;
    --button-border: #555555;

    /* checkbox / radio */
    --checkbox-well:   #2D2D2D;
    --checkbox-border: #555555;

    /* progress */
    --progress-track: #333333;

    /* disabled chrome */
    --disabled-border: #383838;

    /* accent-derived button washes — follow the accent-picker */
    --accent-wash:        mix(var(--accent), var(--surface), 22%);
    --accent-wash-strong: mix(var(--accent), var(--surface), 38%);

    /* disabled primary */
    --primary-disabled-bg:  #333333;
    --primary-disabled-ink: #777777;
  }
}

/* Window: solid, quiet surface. */
TyForm { background: var(--surface); }

/* Title bar: solid bar (white in light, near-black in dark) with a single hairline
   divider all round. Flat, square. */
TyTitleBar, TyRibbonQuickAccess      { background: var(--titlebar-bg); color: var(--ink); border: 1px solid var(--titlebar-border); border-radius: 0; }
TyCaptionButton { render-style: flat; background: transparent; color: var(--ink); border-radius: 0; }
TyCaptionButton:hover        { background: var(--caption-hover); color: var(--ink); }
TyCaptionButton:active       { background: var(--caption-active); color: var(--ink); }
TyCaptionButton.close:hover  { background: #E81123; color: #FFFFFF; }
TyCaptionButton.close:active { background: #F1707A; color: #FFFFFF; }

/* Labels: primary ink on the surface. */
TyLabel, TyHtmlLabel, TyLinkLabel, TyShadowLabel, TyGlowLabel, TyDivider, TyCharImage { color: var(--ink); }

/* Default button: #E1E1E1 face, #ADADAD hairline border, black text, square.
   :hover — pale accent wash (#E5F1FB) with an accent border; :active — deeper wash. */
TyButton, TySpeedButton, TyGlyphContainerButton, TyRibbonAppMenu, TyButtonGroup, TyUpDown          { render-style: flat; background: var(--button-face); color: var(--ink); border: 1px solid var(--button-border); border-radius: 0; padding: 6px; font-weight: normal; }
TyButton:hover, TySpeedButton:hover, TyGlyphContainerButton:hover, TyRibbonAppMenu:hover, TyButtonGroup:hover, TyUpDown:hover    { background: var(--accent-wash); color: var(--ink); border: 1px solid var(--accent); }
TyButton:active, TySpeedButton:active, TyGlyphContainerButton:active, TyRibbonAppMenu:active, TyButtonGroup:active, TyUpDown:active   { background: var(--accent-wash-strong); color: var(--ink); border: 1px solid var(--accent); }
TyButton:focus, TySpeedButton:focus, TyGlyphContainerButton:focus, TyRibbonAppMenu:focus, TyButtonGroup:focus, TyUpDown:focus    { outline: 1 var(--accent); outline-offset: 1px; }
TyButton:disabled, TySpeedButton:disabled, TyGlyphContainerButton:disabled,
TyRibbonAppMenu:disabled { background: var(--surface); color: var(--ink-dim); border: 1px solid var(--disabled-border); }

/* Primary button: solid accent fill, white text, accent border. Hover/press darken it. */
TyButton.primary, TySpeedButton.primary, TyGlyphContainerButton.primary, TyRibbonAppMenu.primary, TyButtonGroup.primary, TyUpDown.primary          { render-style: flat; background: var(--accent); color: on(var(--accent)); border: 1px solid var(--accent); border-radius: 0; padding: 6px; font-weight: normal; }
TyButton.primary:hover, TySpeedButton.primary:hover, TyGlyphContainerButton.primary:hover,
TyRibbonAppMenu.primary:hover    { background: darken(var(--accent), 8%);  border: 1px solid darken(var(--accent), 8%);  color: on(var(--accent)); }
TyButton.primary:active, TySpeedButton.primary:active, TyGlyphContainerButton.primary:active,
TyRibbonAppMenu.primary:active   { background: darken(var(--accent), 16%); border: 1px solid darken(var(--accent), 16%); color: on(var(--accent)); }
TyButton.primary:focus, TySpeedButton.primary:focus, TyGlyphContainerButton.primary:focus,
TyRibbonAppMenu.primary:focus    { outline: 1 var(--accent); outline-offset: 1px; }
TyButton.primary:disabled, TySpeedButton.primary:disabled,
TyGlyphContainerButton.primary:disabled, TyRibbonAppMenu.primary:disabled { background: var(--primary-disabled-bg); color: var(--primary-disabled-ink); border: 1px solid var(--primary-disabled-bg); }

/* Danger button: mirrors primary in the Win10 red — solid fill, white text, red border. Hover/press darken it. */
TyButton.danger, TySpeedButton.danger, TyGlyphContainerButton.danger, TyRibbonAppMenu.danger, TyButtonGroup.danger, TyUpDown.danger          { render-style: flat; background: var(--danger); color: on(var(--danger)); border: 1px solid var(--danger); border-radius: 0; padding: 6px; font-weight: normal; }
TyButton.danger:hover, TySpeedButton.danger:hover, TyGlyphContainerButton.danger:hover,
TyRibbonAppMenu.danger:hover    { background: darken(var(--danger), 8%);  border: 1px solid darken(var(--danger), 8%);  color: on(var(--danger)); }
TyButton.danger:active, TySpeedButton.danger:active, TyGlyphContainerButton.danger:active,
TyRibbonAppMenu.danger:active   { background: darken(var(--danger), 16%); border: 1px solid darken(var(--danger), 16%); color: on(var(--danger)); }
TyButton.danger:focus, TySpeedButton.danger:focus, TyGlyphContainerButton.danger:focus,
TyRibbonAppMenu.danger:focus    { outline: 1 var(--danger); outline-offset: 1px; }
TyButton.danger:disabled, TySpeedButton.danger:disabled, TyGlyphContainerButton.danger:disabled,
TyRibbonAppMenu.danger:disabled { background: var(--primary-disabled-bg); color: var(--primary-disabled-ink); border: 1px solid var(--primary-disabled-bg); }

/* Ghost button: no chrome at rest — accent-tinted text; pale accent wash on interaction. */
TyButton.ghost, TySpeedButton.ghost, TyGlyphContainerButton.ghost, TyRibbonAppMenu.ghost, TyButtonGroup.ghost, TyUpDown.ghost          { render-style: flat; background: transparent; color: var(--accent); border: 1px solid transparent; border-radius: 0; padding: 6px; font-weight: normal; }
TyButton.ghost:hover, TySpeedButton.ghost:hover, TyGlyphContainerButton.ghost:hover,
TyRibbonAppMenu.ghost:hover    { background: var(--accent-wash); color: var(--accent); border: 1px solid transparent; }
TyButton.ghost:active, TySpeedButton.ghost:active, TyGlyphContainerButton.ghost:active,
TyRibbonAppMenu.ghost:active   { background: var(--accent-wash-strong); color: var(--accent); border: 1px solid transparent; }
TyButton.ghost:disabled, TySpeedButton.ghost:disabled, TyGlyphContainerButton.ghost:disabled,
TyRibbonAppMenu.ghost:disabled { background: transparent; color: var(--ink-dim); border: 1px solid transparent; }

/* Fields: crisp white wells, #7A7A7A hairline border, square. Border darkens on hover,
   turns accent on focus — the Windows 10 text-box behaviour. */
TyEdit          { render-style: flat; background: var(--field); color: var(--ink); border: 1px solid var(--field-border); border-radius: 0; padding: 4px; }
TyEdit:hover    { border: 1px solid var(--field-hover-border); }
TyEdit:focus    { border: 1px solid var(--accent); }
TyEdit:disabled { background: var(--surface); color: var(--ink-dim); border: 1px solid var(--disabled-border); }

TyComboBox          { render-style: flat; background: var(--field); color: var(--ink); border: 1px solid var(--field-border); border-radius: 0; padding: 4px; }
TyComboBox:hover    { border: 1px solid var(--field-hover-border); }
TyComboBox:focus    { border: 1px solid var(--accent); }
TyComboBox:disabled { background: var(--surface); color: var(--ink-dim); border: 1px solid var(--disabled-border); }

/* Check box: white well, #333 stroked border, accent tick. Border/wash go accent on interaction. */
TyCheckBox          { background: var(--checkbox-well); color: var(--accent); border: 1px solid var(--checkbox-border); border-radius: 0; }
TyCheckBox:hover    { background: var(--checkbox-well); color: var(--accent); border: 1px solid var(--accent); border-radius: 0; }
TyCheckBox:active   { background: var(--accent-wash-strong); color: var(--accent); border: 1px solid var(--accent); border-radius: 0; }
TyCheckBox:disabled { background: var(--surface); color: var(--ink-dim); border: 1px solid var(--disabled-border); border-radius: 0; }

/* Radio button: mirrors the check box — same stroked well, accent dot. */
TyRadioButton          { background: var(--checkbox-well); color: var(--accent); border: 1px solid var(--checkbox-border); border-radius: 0; }
TyRadioButton:hover    { background: var(--checkbox-well); color: var(--accent); border: 1px solid var(--accent); border-radius: 0; }
TyRadioButton:active   { background: var(--accent-wash-strong); color: var(--accent); border: 1px solid var(--accent); border-radius: 0; }
TyRadioButton:disabled { background: var(--surface); color: var(--ink-dim); border: 1px solid var(--disabled-border); border-radius: 0; }

/* Progress: #E6E6E6 flat track, hairline border, solid accent fill, square. */
TyProgressBar  { render-style: flat; background: var(--progress-track); border: 1px solid var(--field-border); border-radius: 0; }
TyProgressFill { background: var(--accent); border-radius: 0; }

/* ---- Card + Tag + Badge ---- */

/* Card: a solid content sheet (white in light, #333 in dark) lifted off the grey
   window by a single hairline — the same fill + 1px border + zero radius recipe as
   every other surface here, and no shadow: Win10 content sits IN the plane, it never
   floats above it. :hover is the Win10 tile/button affordance — the border lights up
   in the accent. Disabled follows the file's usual recipe (flat surface, dim ink,
   pale border) rather than a blanket fade. */
TyCard          { background: var(--field); color: var(--ink); border: 1px solid var(--button-border); border-radius: 0; padding: 12px; }
TyCard:hover    { border: 1px solid var(--accent); }
TyCard:disabled { background: var(--surface); color: var(--ink-dim); border: 1px solid var(--disabled-border); }

/* Header + actions bands: NO tinted band — Win10 is flat, so the title is set off by
   nothing but a hairline. That hairline is the CARD's own --button-border, i.e. the very
   border it sits inside — NOT the title bar's divider: --titlebar-border is toned against
   --titlebar-bg, and on the card's --field fill it all but disappears in dark mode
   (#3A3A3A on #333333). Bold is reserved for headings in this skin (buttons and badges
   stay normal weight). Padding is left unset on purpose, so the title lines up with the
   body on the card's own gutter. */
TyCardHeader  { color: var(--ink); border: 1px solid var(--button-border); font-weight: bold; }
TyCardActions { border: 1px solid var(--button-border); }

/* Tag: a flat SQUARE chip, not a round pill — Win10 has no round-ended anything, so the
   base layer's --radius-round is overridden to 0. The default chip is the button face and
   its hairline, i.e. the same quiet chrome the default button wears; the two variants fill
   solid in the accent-picker blue / the Win10 red, with on() picking their ink. */
TyTag          { background: var(--button-face); color: var(--ink); border: 1px solid var(--button-border); border-radius: 0; padding: 0px 8px; }
TyTag.accent   { background: var(--accent); color: on(var(--accent)); border: 1px solid var(--accent); }
TyTag.danger   { background: var(--danger); color: on(var(--danger)); border: 1px solid var(--danger); }
TyTag:disabled { background: var(--surface); color: var(--ink-dim); border: 1px solid var(--disabled-border); }

/* Tag close 'x': dim ink at rest, and on hover it takes the Win10 caption-close treatment —
   a square red chip with white-on-red ink, because that is what an 'x' does in this OS.
   Here it goes through var(--danger) so it brightens with the dark palette; only the real
   caption button hard-codes #E81123, since the OS close red never follows the accent picker. */
TyTagClose       { color: var(--ink-dim); }
TyTagClose:hover { background: var(--danger); color: on(var(--danger)); border-radius: 0; }

/* Badge: a solid accent counter with SQUARE corners. The inherited base badge is a round
   modern pill; Win10's badges (taskbar counters, live-tile markers) are hard-edged blocks
   like everything else in this language, and their numerals are not bold. */
TyBadge { background: var(--accent); color: on(var(--accent)); border-radius: 0; font-weight: normal; padding: 0px 4px; }