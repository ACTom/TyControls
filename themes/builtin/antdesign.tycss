/* Ant Design v5 — an ORIGINAL "inspired-by" ty-controls skin, DUAL-MODE, tuned to feel genuinely native.
   Ant's chrome is flat and airy: pure-white surfaces, hair-thin #D9D9D9 borders, 6px radii, near-black 88%
   ink and the #1677FF brand blue. No gradients, no bevels — depth comes only from a whisper of drop shadow.
   LIGHT: a WHITE #FFFFFF canvas and surfaces (the demo has no cards, so the window itself is white), a
   flat borderless title band. DARK: #141414 canvas, #1F1F1F surfaces/fields, #424242 borders,
   #FFFFFFD9 ink, the blue nudged to #1668DC for contrast. Only the PALETTE flips per @mode — radii, padding,
   font-weight and shadow shape are shared. --accent stays the brand seed in both modes, so the runtime
   accent-picker recolours the whole skin through it; the #4096FF hover / #0958D9 active shades are derived
   from --accent with lighten()/darken() so they track the picked colour. No font-size is set — controls
   inherit the compact 9px base (no "zoomed" look) — and only tight 4px/10px button padding keeps CJK labels
   like "绿色 Green" from truncating. */

/* --- palette: light ------------------------------------------------------ */
@mode light {
  :root {
    --accent:         #1677FF;   /* brand blue — primary fill, focus ring, checkbox tick, progress fill */
    --danger:         #FF4D4F;   /* Ant error red — danger-button fill                                  */
    --window:         #F0F2F5;   /* AntD layout gray — white cards float on it (the demo IS cards)       */
    --surface:        #FFFFFF;   /* title bar, button face, field wells, checkbox                       */
    --ink:            #000000E0;  /* near-black 88% primary text                                        */
    --muted:          #000000A6;  /* caption-button ink                                                 */
    --ink-disabled:   #00000040;  /* disabled text                                                      */
    --border:         #D9D9D9;   /* hair-line borders & field edges                                     */
    --disabled-fill:  #F5F5F5;   /* disabled surface fill                                                */
    --track:          #F5F5F5;   /* progress trough                                                      */
    --tag-fill:       #FAFAFA;   /* neutral tag chip fill — Ant's #FAFAFA                                */
    --tag-accent-ink: var(--accent);  /* preset-tag ink: Ant's LIGHT preset ink is the seed itself       */
    --tag-danger-ink: var(--danger);  /* ditto for the error preset                                      */
    --listgroup-accent-ink: var(--accent);  /* sider open-group + selected-item ink: the seed reads on a light tint */
    --cap-hover:      #0000000F;  /* caption-button hover overlay                                        */
    --cap-active:     #00000017;  /* caption-button pressed overlay                                      */
    --shadow-soft:    #0000000A;  /* default-button drop shadow (0 1 0)                                  */
    --shadow-primary: #1677FF1A;  /* primary-button accent-tinted drop shadow (0 2 0)                    */
    --shadow-danger:  #FF4D4F1A;  /* danger-button red-tinted drop shadow (0 2 0)                        */
  }
}

/* --- palette: dark ------------------------------------------------------- */
@mode dark {
  :root {
    --accent:         #1668DC;   /* brand blue, brightened a touch for dark-mode contrast */
    --danger:         #DC4446;   /* Ant error red, deepened for dark-mode contrast         */
    --window:         #141414;   /* deep neutral canvas                                    */
    --surface:        #1F1F1F;   /* title bar, button face, field wells, checkbox         */
    --ink:            #FFFFFFD9;  /* light 85% primary text                                */
    --muted:          #FFFFFFA6;  /* caption-button ink                                    */
    --ink-disabled:   #FFFFFF40;  /* disabled text                                         */
    --border:         #424242;   /* subtle borders & field edges                          */
    --disabled-fill:  #262626;   /* disabled surface fill                                  */
    --track:          #303030;   /* progress trough                                        */
    --tag-fill:       #FFFFFF0A;  /* neutral tag chip fill — a 4% white wash               */
    --tag-accent-ink: lighten(var(--accent), 30);  /* Ant LIGHTENS preset ink on dark:     */
    --tag-danger-ink: lighten(var(--danger), 20);  /* the seed alone is too dark to read   */
    --listgroup-accent-ink: lighten(var(--accent), 30);  /* dark: lighten like the tag ink — raw seed on the dark pill is only ~2.9:1 */
    --cap-hover:      #FFFFFF14;  /* caption-button hover overlay                           */
    --cap-active:     #FFFFFF1F;  /* caption-button pressed overlay                        */
    --shadow-soft:    #00000030;  /* default-button drop shadow (deeper on dark)           */
    --shadow-primary: #1668DC40;  /* primary-button accent-tinted glow                     */
    --shadow-danger:  #DC444640;  /* danger-button red-tinted glow                         */
  }
}

/* Window: a plain surface canvas — no cards, so the window itself is white in light mode. */
TyForm { background: var(--window); color: var(--ink); }

/* Title bar: flat surface header with primary ink (Ant's title area is borderless — flat). */
TyTitleBar      { background: var(--surface); color: var(--ink); border-radius: 0; }
TyCaptionButton { background: transparent; color: var(--muted); border-radius: 0; }
TyCaptionButton:hover  { background: var(--cap-hover); color: var(--ink); }
TyCaptionButton:active { background: var(--cap-active); color: var(--ink); }

TyLabel { color: var(--ink); }

/* Default button: white face, #D9D9D9 hairline, 88% ink, 6px radius, a 0 1 0 whisper of shadow. On hover the
   border + text lift to #4096FF (lighten of accent); on press they sink to #0958D9 (darken). Tight padding. */
TyButton, TySpeedButton, TyGlyphContainerButton, TyRibbonAppMenu                { background: var(--surface); color: var(--ink); border: 1px solid var(--border); border-radius: 6; padding: 4px 10px; font-weight: normal; shadow: 0 1 0 var(--shadow-soft); }
TyButton:hover, TySpeedButton:hover, TyGlyphContainerButton:hover, TyRibbonAppMenu:hover          { background: var(--surface); color: lighten(var(--accent), 12); border-color: lighten(var(--accent), 12); }
TyButton:active, TySpeedButton:active, TyGlyphContainerButton:active, TyRibbonAppMenu:active         { background: var(--surface); color: darken(var(--accent), 12); border-color: darken(var(--accent), 12); }
TyButton:focus, TySpeedButton:focus, TyGlyphContainerButton:focus, TyRibbonAppMenu:focus          { border-color: var(--accent); outline: 2 alpha(var(--accent), 0.12); outline-offset: 0; }
TyButton:disabled, TySpeedButton:disabled, TyGlyphContainerButton:disabled,
TyRibbonAppMenu:disabled       { background: var(--disabled-fill); color: var(--ink-disabled); border-color: var(--border); shadow: 0 0 0 transparent; }

/* Primary button: solid accent fill, white ink, 6px radius, a faint accent-tinted 0 2 0 shadow. */
TyButton.primary, TySpeedButton.primary, TyGlyphContainerButton.primary, TyRibbonAppMenu.primary          { background: var(--accent); color: on(var(--accent)); border: 1px solid var(--accent); border-radius: 6; padding: 4px 10px; font-weight: normal; shadow: 0 2 0 var(--shadow-primary); }
TyButton.primary:hover, TySpeedButton.primary:hover, TyGlyphContainerButton.primary:hover,
TyRibbonAppMenu.primary:hover    { background: lighten(var(--accent), 12); border-color: lighten(var(--accent), 12); color: on(var(--accent)); }
TyButton.primary:active, TySpeedButton.primary:active, TyGlyphContainerButton.primary:active,
TyRibbonAppMenu.primary:active   { background: darken(var(--accent), 12); border-color: darken(var(--accent), 12); color: on(var(--accent)); }
TyButton.primary:focus, TySpeedButton.primary:focus, TyGlyphContainerButton.primary:focus,
TyRibbonAppMenu.primary:focus    { outline: 2 alpha(var(--accent), 0.2); outline-offset: 1px; }
TyButton.primary:disabled, TySpeedButton.primary:disabled,
TyGlyphContainerButton.primary:disabled, TyRibbonAppMenu.primary:disabled { background: var(--disabled-fill); color: var(--ink-disabled); border-color: var(--border); shadow: 0 0 0 transparent; }

/* Danger button: primary's twin driven by Ant's #FF4D4F error red — solid fill, white ink, red-tinted 0 2 0 shadow. */
TyButton.danger, TySpeedButton.danger, TyGlyphContainerButton.danger, TyRibbonAppMenu.danger          { background: var(--danger); color: on(var(--danger)); border: 1px solid var(--danger); border-radius: 6; padding: 4px 10px; font-weight: normal; shadow: 0 2 0 var(--shadow-danger); }
TyButton.danger:hover, TySpeedButton.danger:hover, TyGlyphContainerButton.danger:hover,
TyRibbonAppMenu.danger:hover    { background: lighten(var(--danger), 12); border-color: lighten(var(--danger), 12); color: on(var(--danger)); }
TyButton.danger:active, TySpeedButton.danger:active, TyGlyphContainerButton.danger:active,
TyRibbonAppMenu.danger:active   { background: darken(var(--danger), 12); border-color: darken(var(--danger), 12); color: on(var(--danger)); }
TyButton.danger:focus, TySpeedButton.danger:focus, TyGlyphContainerButton.danger:focus,
TyRibbonAppMenu.danger:focus    { outline: 2 alpha(var(--danger), 0.2); outline-offset: 1px; }
TyButton.danger:disabled, TySpeedButton.danger:disabled, TyGlyphContainerButton.danger:disabled,
TyRibbonAppMenu.danger:disabled { background: var(--disabled-fill); color: var(--ink-disabled); border-color: var(--border); shadow: 0 0 0 transparent; }

/* Ghost = Ant's link/text button: transparent, accent text, a faint #1677FF14 wash on interaction. */
TyButton.ghost, TySpeedButton.ghost, TyGlyphContainerButton.ghost, TyRibbonAppMenu.ghost          { background: transparent; color: var(--accent); border: 1px solid transparent; border-radius: 6; padding: 4px 10px; font-weight: normal; }
TyButton.ghost:hover, TySpeedButton.ghost:hover, TyGlyphContainerButton.ghost:hover,
TyRibbonAppMenu.ghost:hover    { background: alpha(var(--accent), 0.08); color: var(--accent); }
TyButton.ghost:active, TySpeedButton.ghost:active, TyGlyphContainerButton.ghost:active,
TyRibbonAppMenu.ghost:active   { background: alpha(var(--accent), 0.15); color: darken(var(--accent), 12); }
TyButton.ghost:disabled, TySpeedButton.ghost:disabled, TyGlyphContainerButton.ghost:disabled,
TyRibbonAppMenu.ghost:disabled { background: transparent; color: var(--ink-disabled); }

/* Fields: white wells, #D9D9D9 hairline, #4096FF border on hover, #1677FF border + a soft accent ring on focus. */
TyEdit            { background: var(--surface); color: var(--ink); border: 1px solid var(--border); border-radius: 6; padding: 4px 11px; }
TyEdit:hover      { border-color: lighten(var(--accent), 12); }
TyEdit:focus      { border-color: var(--accent); outline: 2 alpha(var(--accent), 0.12); outline-offset: 0; }
TyEdit:disabled   { background: var(--disabled-fill); color: var(--ink-disabled); border-color: var(--border); }

TyComboBox          { background: var(--surface); color: var(--ink); border: 1px solid var(--border); border-radius: 6; padding: 4px 11px; }
TyComboBox:hover    { border-color: lighten(var(--accent), 12); }
TyComboBox:focus    { border-color: var(--accent); outline: 2 alpha(var(--accent), 0.12); outline-offset: 0; }
TyComboBox:disabled { background: var(--disabled-fill); color: var(--ink-disabled); border-color: var(--border); }

/* Check box: a small white well, #D9D9D9 hairline, #1677FF tick, 4px radius; border warms to accent. */
TyCheckBox          { background: var(--surface); color: var(--accent); border: 1px solid var(--border); border-radius: 4; }
TyCheckBox:hover    { border-color: lighten(var(--accent), 12); }
TyCheckBox:active   { background: var(--surface); color: var(--accent); border: 1px solid var(--accent); border-radius: 4; }
TyCheckBox:disabled { background: var(--disabled-fill); color: var(--ink-disabled); border-color: var(--border); }

/* Radio: same well, rounded fully by the control; hairline warms to accent, accent dot drawn in color. */
TyRadioButton          { background: var(--surface); color: var(--accent); border: 1px solid var(--border); }
TyRadioButton:hover    { border-color: lighten(var(--accent), 12); }
TyRadioButton:disabled { background: var(--disabled-fill); color: var(--ink-disabled); border-color: var(--border); }

/* Progress: a #F5F5F5 pill trough with a solid #1677FF pill fill (Ant's rounded bar). */
TyProgressBar  { background: var(--track); border-radius: 100; }
TyProgressFill { background: var(--accent); border-radius: 100; }

/* --- Card + Tag + Badge -------------------------------------------------- */

/* Card: Ant's canonical card — a white surface, a #D9D9D9 hairline, 6px radius and NO shadow at rest (a
   bordered AntD card is flat; the hairline is the whole frame). 'hoverable' is the only lift: the border stays
   put and a soft shadow blooms under it — the base layer's TyCard:hover would recolour the border with ITS own
   --border-hover, so pin border-color here. Body padding is 12px, not Ant's 24px: that 24 is sized for a 14px
   font and this skin runs the compact 9px base. The 36/44 fallback band heights already match Ant's small-card
   proportions, so no --card-header-height / --card-actions-height override. */
TyCard          { background: var(--surface); color: var(--ink); border: 1px solid var(--border); border-radius: var(--radius); padding: var(--pad-card); }
TyCard:hover    { border-color: var(--border); shadow: 0 2 8 var(--shadow-soft); }
TyCard:disabled { background: var(--disabled-fill); color: var(--ink-disabled); border-color: var(--border); }

/* Header + actions are BANDS drawn on the card's own surface, not frames — so border-color/border-width here is
   the separator hairline, not a box. Ant's card head is transparent over the card, so neither band takes a
   background. The title is the one piece of bold in this flat skin (Ant's head is fontWeightStrong); no padding
   on the band, so the title falls back to the card's own 12px and lines up with the body. */
TyCardHeader  { color: var(--ink); border-color: var(--border); border-width: 1px; font-weight: bold; }
TyCardActions { border-color: var(--border); border-width: 1px; }

/* Tag: an Ant tag is a small 2px-radius CHIP, not a round pill — the base layer's --radius-round would give it
   round ends, so the radius is pinned here. Neutral = Ant's #FAFAFA fill behind the same #D9D9D9 hairline every
   field in this skin wears; disabled greys the fill + ink like every other disabled rule in this file. */
TyTag          { background: var(--tag-fill); color: var(--ink); border: 1px solid var(--border); border-radius: 2; padding: 0px 8px; }
TyTag:disabled { background: var(--disabled-fill); color: var(--ink-disabled); border-color: var(--border); }

/* The variants are Ant's PRESET tags, and Ant's presets are tints, not solid fills: a ~10% wash of the seed, a
   ~35% wash of it for the border, and a seed-toned ink (#E6F4FF / #91CAFF / #1677FF for blue). Driving the FILL
   and the BORDER off alpha(seed) lets one rule serve both modes — the wash composites over #FFFFFF in light and
   over #1F1F1F in dark, landing on Ant's own dark tints — and keeps them tracking the runtime accent-picker.
   The INK cannot ride that trick: this skin's dark --accent (#1668DC) is DARKER than its light one (#1677FF)
   — it is Ant's dark colorPrimary, sized to carry WHITE button text — so the raw seed on a dark tint is a dark
   ink on a dark wash (~2.9:1 at the 9px base). Ant lightens its dark preset ink for exactly this reason, so the
   ink comes from --tag-*-ink, which is the seed in light and a lightened seed in dark (still picker-tracked).
   Only these two: a success/warning tag would need new seed colours, which is a palette decision, not a tag one. */
TyTag.accent { background: alpha(var(--accent), 0.10); color: var(--tag-accent-ink); border-color: alpha(var(--accent), 0.35); }
TyTag.danger { background: alpha(var(--danger), 0.10); color: var(--tag-danger-ink); border-color: alpha(var(--danger), 0.35); }

/* The x: Ant gives it no hover chip at all — it just strengthens from a 65% ink to full — so the base layer's
   --overlay-hover chip is cleared rather than restyled. On a preset tag the x carries the tag's own tinted ink,
   so the variants restate it (the chip is cleared per-rule, as the buttons here restate too). Each pair is the
   SAME gesture: rest at 65% of its ink, hover at full. The neutral pair spells that with the palette's own
   --muted/--ink (--muted IS #…A6 = 65% of --ink); the variants spell it with alpha(--tag-*-ink, 0.65) -> the
   ink itself. Strengthening must NOT be darken() here: in dark mode 'stronger' is LIGHTER, and darkening a
   dark-mode preset ink walks it INTO its own tint. Going to full --tag-*-ink is right in both modes. */
TyTagClose              { color: var(--muted); }
TyTagClose:hover        { background: transparent; color: var(--ink); }
TyTagClose.accent       { color: alpha(var(--tag-accent-ink), 0.65); }
TyTagClose.accent:hover { background: transparent; color: var(--tag-accent-ink); }
TyTagClose.danger       { color: alpha(var(--tag-danger-ink), 0.65); }
TyTagClose.danger:hover { background: transparent; color: var(--tag-danger-ink); }

/* Badge: Ant's count badge is RED, not brand-blue — it rides on colorError and only <Badge status> reaches for
   the palette — so the inherited accent pill is wrong here and this one takes --danger. Round-ended through the
   same 100 the progress pill uses, and normal weight: the card title is the only bold in this skin, and a 9px
   badge digit is exactly as legible as the 9px label on a primary button. (Ant's white 1px separator ring has
   no equivalent: shadow is offsetX/offsetY/blur/color, with no spread.) */
TyBadge { background: var(--danger); color: on(var(--danger)); border-radius: 100; font-weight: normal; padding: 0px 4px; }

/* --- Sider (ListGroupPanel) — Ant Design Pro's navigation rail ------------ */

/* Ant's sider is airy and flat. The GROUP row carries NO background (the panel surface shows
   through — none of the old grey band): just muted secondary ink and a right chevron, and when the
   group is OPEN its ink lifts to the brand blue. A SELECTED child is Ant v5's #E6F4FF pill — a ~10%
   wash of the seed with brand-blue ink — written as alpha(--accent) so it composites to #E6F4FF over
   the white light surface and to Ant's own dark selected tint over #1F1F1F, and tracks the runtime
   accent-picker (the exact TyTag.accent idiom above). Hover is a whisper 6% seed wash. The ink on
   both accent cues comes from --listgroup-accent-ink (seed in light, lightened seed in dark) for the
   same reason the tags lighten theirs — this skin's dark --accent is a dark blue that reads at only
   ~2.9:1 on its own tint. Rows stay normal weight (the card title is this skin's only bold). The base
   layer's --on-surface / --surface-hover / --selection / --radius are RESTATED here in this skin's own
   vars, so the sider flips with the dark @mode instead of resolving against the base palette. */
/* padding is RESTATED, not inherited: any rule for a typeKey suppresses the whole base layer for
   it (UserHasTypeKey), so leaving padding off the base rule here made it 0 — the sider rows sat
   flush against the panel border. 14px inline is Ant's sider breathing room. */
TyListGroupHeader          { color: var(--muted); font-weight: normal; padding: 0px 14px; }
TyListGroupHeader:hover    { color: var(--ink); }
TyListGroupHeader:selected { color: var(--listgroup-accent-ink); }   /* the group is OPEN */
TyListGroupItem          { color: var(--ink); border-radius: 6; padding: 0px 14px; }
TyListGroupItem:hover    { background: alpha(var(--accent), 0.06); }
TyListGroupItem:active   { background: alpha(var(--accent), 0.10); color: var(--listgroup-accent-ink); }   /* selected: Ant's #E6F4FF pill */

/* Airy Ant-Pro rhythm: 36px group bands and 40px item rows (the metric token wins over the control's
   26/24 property fallback). Identical in both modes, so one top-level :root — as bootstrap/classic
   declare their mode-invariant metrics; only the colour palette flips per @mode. */
:root {
  --listgroup-header-height: 36;
  --listgroup-item-height:   40;
}

/* Ant Design Pro table: the selected row is a light accent TINT with normal ink,
   not a solid-blue fill — so the green/orange/blue status text still reads on it.
   */
TyGridCell:selected { background: alpha(var(--accent), 0.10); color: var(--on-surface); }
TyGridCell:hover    { background: alpha(var(--accent), 0.05); }
