/* office — Microsoft Office (Fluent). A neutral near-white workspace with a single
   signature move: an ACCENT-COLOURED caption band (Word/Excel/PowerPoint), kept in
   BOTH modes. Set --accent to rebrand the whole identity at runtime — Word-blue by
   default (#2B579A), Excel-green, PowerPoint-orange, etc.

   Genuinely native, NOT zoomed: Fluent's flat surfaces, small 2px radii, thin
   #C8C6C4→#8A8886 hairlines and tight command-bar padding. Nativeness comes from
   colour + border + radius, never from size — controls inherit the base 9px font.

   DUAL-MODE. The palette (surfaces, fields, ink, borders, accent) lives in the
   @mode light / @mode dark blocks; control rules only reference var(--…), so
   switching Controller.Mode recolours everything. @mode light = the classic
   near-white Fluent look. @mode dark = Office dark: #252423 window / #1B1A19
   content / #292827 wells + light ink, with the accent caption band kept in BOTH
   modes. The runtime accent-picker recolours through var(--accent). */

/* ── Palette: light = classic Fluent, dark = Office dark ─────────────────── */
@mode light {
  :root {
    --accent:        #2B579A;   /* Office blue — the runtime accent-picker recolours everything */
    --danger:        #A4262C;   /* Office error red — fixed, never follows the accent-picker */
    --surface:       #F3F2F1;   /* Fluent neutral window; also default-button hover face */
    --field:         #FFFFFF;   /* white content + input wells + default button face */
    --pressed:       #EDEBE9;   /* pressed neutral: button :active + progress track */
    --ink:           #201F1E;   /* near-black text */
    --muted:         #A19F9D;   /* disabled / secondary ink */
    --line:          #C8C6C4;   /* thin neutral hairline */
    --line-field:    #8A8886;   /* stronger field / default-button border */
    --hover-overlay: #0000000A; /* faint neutral wash for ghost hover */
  }
}

@mode dark {
  :root {
    --accent:        #2B579A;   /* same brand seed — the picker recolours through it */
    --danger:        #D13438;   /* lighter Office error red — lifts off the dark canvas */
    --surface:       #252423;   /* Office-dark window; also default-button hover face */
    --field:         #292827;   /* raised dark input wells + default button face */
    --pressed:       #1B1A19;   /* deep content tone: button :active + progress track */
    --ink:           #FFFFFF;   /* light text on the dark canvas */
    --muted:         #797775;   /* disabled / secondary ink */
    --line:          #3B3A39;   /* subtle hairline on dark */
    --line-field:    #484644;   /* stronger field / default-button border on dark */
    --hover-overlay: #FFFFFF14; /* faint light wash for ghost hover on dark */
  }
}

/* Window: flat neutral canvas. */
TyForm { background: var(--surface); }

/* Title bar: the accent caption band — the whole identity, white text in BOTH modes. */
TyTitleBar, TyRibbonQuickAccess {
  background: var(--accent);
  color: on(var(--accent));
  border-radius: 0;
}
TyCaptionButton {
  background: transparent;
  color: on(var(--accent));
  border-radius: 0;
}
TyCaptionButton:hover  { background: alpha(on(var(--accent)), 0.18); color: on(var(--accent)); }
TyCaptionButton:active { background: alpha(on(var(--accent)), 0.30); color: on(var(--accent)); }

/* Labels: theme ink on the canvas. */
TyLabel, TyHtmlLabel, TyLinkLabel, TyShadowLabel, TyGlowLabel, TyDivider, TyCharImage { color: var(--ink); }

/* Default button: white face, thin field-strength border, tight command-bar padding.
   Hover recedes to the neutral window tone; pressed reads a touch deeper. Flat, quiet. */
TyButton, TySpeedButton, TyGlyphContainerButton, TyRibbonAppMenu, TyButtonGroup, TyUpDown {
  background: var(--field);
  color: var(--ink);
  border: 1px solid var(--line-field);
  border-radius: 2px;
  font-weight: normal;
  padding: 5px 10px;
}
TyButton:hover, TySpeedButton:hover, TyGlyphContainerButton:hover, TyRibbonAppMenu:hover, TyButtonGroup:hover, TyUpDown:hover {
  background: var(--surface);
  color: var(--ink);
  border: 1px solid var(--line);
}
TyButton:active, TySpeedButton:active, TyGlyphContainerButton:active, TyRibbonAppMenu:active, TyButtonGroup:active, TyUpDown:active {
  background: var(--pressed);
  color: var(--ink);
  border: 1px solid var(--line-field);
}
TyButton:focus, TySpeedButton:focus, TyGlyphContainerButton:focus, TyRibbonAppMenu:focus, TyButtonGroup:focus, TyUpDown:focus  { outline: 2px var(--accent); outline-offset: 1px; }
TyButton:disabled, TySpeedButton:disabled, TyGlyphContainerButton:disabled, TyRibbonAppMenu:disabled, TyButtonGroup:disabled, TyUpDown:disabled {
  background: var(--surface);
  color: var(--muted);
  border: 1px solid var(--line);
}

/* Primary: solid accent, white ink, Fluent's semibold weight + a hairline shadow. */
TyButton.primary, TySpeedButton.primary, TyGlyphContainerButton.primary, TyRibbonAppMenu.primary, TyButtonGroup.primary, TyUpDown.primary {
  background: var(--accent);
  color: on(var(--accent));
  border: 1px solid var(--accent);
  border-radius: 2px;
  font-weight: 600;
  padding: 5px 10px;
  shadow: 0 1 2 #00000024;
}
TyButton.primary:hover, TySpeedButton.primary:hover, TyGlyphContainerButton.primary:hover,
TyRibbonAppMenu.primary:hover  { background: darken(var(--accent), 8);  border: 1px solid darken(var(--accent), 8); }
TyButton.primary:active, TySpeedButton.primary:active, TyGlyphContainerButton.primary:active,
TyRibbonAppMenu.primary:active { background: darken(var(--accent), 16); border: 1px solid darken(var(--accent), 16); shadow: 0 0 0 #00000000; }
TyButton.primary:disabled, TySpeedButton.primary:disabled,
TyGlyphContainerButton.primary:disabled, TyRibbonAppMenu.primary:disabled {
  background: alpha(var(--accent), 0.40);
  color: alpha(on(var(--accent)), 0.75);
  border: 1px solid alpha(var(--accent), 0.40);
  shadow: 0 0 0 #00000000;
}

/* Danger: the primary chip inked with Office's error red — same solid Fluent face,
   semibold weight and hairline shadow, but fixed, so the accent-picker can't soften it. */
TyButton.danger, TySpeedButton.danger, TyGlyphContainerButton.danger, TyRibbonAppMenu.danger, TyButtonGroup.danger, TyUpDown.danger {
  background: var(--danger);
  color: on(var(--danger));
  border: 1px solid var(--danger);
  border-radius: 2px;
  font-weight: 600;
  padding: 5px 10px;
  shadow: 0 1 2 #00000024;
}
TyButton.danger:hover, TySpeedButton.danger:hover, TyGlyphContainerButton.danger:hover,
TyRibbonAppMenu.danger:hover  { background: darken(var(--danger), 8);  border: 1px solid darken(var(--danger), 8); }
TyButton.danger:active, TySpeedButton.danger:active, TyGlyphContainerButton.danger:active,
TyRibbonAppMenu.danger:active { background: darken(var(--danger), 16); border: 1px solid darken(var(--danger), 16); shadow: 0 0 0 #00000000; }
TyButton.danger:disabled, TySpeedButton.danger:disabled, TyGlyphContainerButton.danger:disabled,
TyRibbonAppMenu.danger:disabled {
  background: alpha(var(--danger), 0.40);
  color: alpha(on(var(--danger)), 0.75);
  border: 1px solid alpha(var(--danger), 0.40);
  shadow: 0 0 0 #00000000;
}

/* Ghost: chrome-less until touched — a command-bar affordance, faint neutral wash. */
TyButton.ghost, TySpeedButton.ghost, TyGlyphContainerButton.ghost, TyRibbonAppMenu.ghost, TyButtonGroup.ghost, TyUpDown.ghost {
  background: transparent;
  color: var(--accent);
  border: 1px solid transparent;
  border-radius: 2px;
  font-weight: normal;
  padding: 5px 10px;
}
TyButton.ghost:hover, TySpeedButton.ghost:hover, TyGlyphContainerButton.ghost:hover,
TyRibbonAppMenu.ghost:hover  { background: var(--hover-overlay); color: var(--accent); border: 1px solid transparent; }
TyButton.ghost:active, TySpeedButton.ghost:active, TyGlyphContainerButton.ghost:active,
TyRibbonAppMenu.ghost:active { background: var(--pressed);       color: var(--accent); border: 1px solid transparent; }
TyButton.ghost:disabled, TySpeedButton.ghost:disabled, TyGlyphContainerButton.ghost:disabled,
TyRibbonAppMenu.ghost:disabled { background: transparent; color: var(--muted); border: 1px solid transparent; }

/* Fields: bright wells, stronger hairline, accent focus. */
TyEdit {
  background: var(--field);
  color: var(--ink);
  border: 1px solid var(--line-field);
  border-radius: 2px;
  padding: 5px 8px;
}
TyEdit:hover    { border: 1px solid var(--ink); }
TyEdit:focus    { border: 1px solid var(--accent); outline: 2px alpha(var(--accent), 0.35); outline-offset: 0px; }
TyEdit:disabled { background: var(--surface); color: var(--muted); border: 1px solid var(--line); }

TyComboBox {
  background: var(--field);
  color: var(--ink);
  border: 1px solid var(--line-field);
  border-radius: 2px;
  padding: 5px 8px;
}
TyComboBox:hover    { border: 1px solid var(--ink); }
TyComboBox:focus    { border: 1px solid var(--accent); outline: 2px alpha(var(--accent), 0.35); outline-offset: 0px; }
TyComboBox:disabled { background: var(--surface); color: var(--muted); border: 1px solid var(--line); }

/* Check box: white indicator, thin field border, accent tick (color inks the check). */
TyCheckBox {
  background: var(--field);
  color: var(--accent);
  border: 1px solid var(--line-field);
  border-radius: 2px;
}
TyCheckBox:hover    { background: var(--field); color: var(--accent); border: 1px solid var(--accent); border-radius: 2px; }
TyCheckBox:active   { background: alpha(var(--accent), 0.12); color: var(--accent); border: 1px solid var(--accent); border-radius: 2px; }
TyCheckBox:disabled { background: var(--surface); color: var(--muted); border: 1px solid var(--line); border-radius: 2px; }

/* Radio: mirror the check box — white well, accent dot, thin field border, circular. */
TyRadioButton {
  background: var(--field);
  color: var(--accent);
  border: 1px solid var(--line-field);
  border-radius: 8px;
}
TyRadioButton:hover    { background: var(--field); color: var(--accent); border: 1px solid var(--accent); border-radius: 8px; }
TyRadioButton:active   { background: alpha(var(--accent), 0.12); color: var(--accent); border: 1px solid var(--accent); border-radius: 8px; }
TyRadioButton:disabled { background: var(--surface); color: var(--muted); border: 1px solid var(--line); border-radius: 8px; }

/* Progress: flat neutral groove, solid accent fill. */
TyProgressBar {
  background: var(--pressed);
  border: 1px solid var(--line);
  border-radius: 2px;
}
TyProgressFill {
  background: var(--accent);
  border-radius: 2px;
}

/* ── Card + Tag + Badge (Ant Design-gap batch 1) ─────────────────────────── */
/* Metric tokens (--card-header-height, --tag-close-size, --badge-*) stay at their
   fallbacks on purpose: this skin's thesis is that nativeness comes from colour,
   border and radius — never from size. */

/* Card: a white content sheet lifted off the neutral window — Fluent's depth-4
   hairline shadow, the thin neutral line, the same 2px radius as every other surface
   here. Body inset keeps the command-bar's 10px rhythm rather than a roomy web-card
   pad. 'hoverable' lifts the way a clickable Fluent card does: the hairline firms up
   to field strength and the shadow deepens — never a colour change. */
TyCard {
  background: var(--field);
  color: var(--ink);
  border: 1px solid var(--line);
  border-radius: 2px;
  padding: 10px;
  shadow: 0 1 2 #00000024;
}
TyCard:hover { border: 1px solid var(--line-field); shadow: 0 2 4 #00000024; }
TyCard:disabled {
  background: var(--surface);
  color: var(--muted);
  border: 1px solid var(--line);
  shadow: 0 0 0 #00000000;
}

/* Card header: Office genuinely does tint its title bands (task-pane and dialog
   headers), so the strip recedes to the neutral window tone exactly the way
   TyButton:hover does, with a hairline rule under it. Semibold, never larger —
   Fluent's title weight on the base font. Padding is left unset so the title lines
   up with the card's own body inset. */
TyCardHeader {
  background: var(--surface);
  color: var(--ink);
  border: 1px solid var(--line);
  font-weight: 600;
}
/* The strips resolve with the CARD's states, so a disabled card would otherwise keep a
   full-strength semibold title over its greyed-out body. Setting a colour above opts out
   of the "no header colour -> the card's own ink" fallback, so the muted ink is spelled
   out here — the same grey-out every other disabled rule in this file performs. */
TyCardHeader:disabled { color: var(--muted); }

/* Card actions: the header's mirror — Office's dialog command strip is the same
   tinted band, fenced off by the same hairline, under the content. */
TyCardActions {
  background: var(--surface);
  border: 1px solid var(--line);
}

/* Tag: a Fluent chip, NOT a pill — the 2px radius is this skin's whole point, so tags
   read as tiny bordered command-bar chips. The neutral face recedes to the window tone
   and leans on the hairline to stay legible on the white card. */
TyTag {
  background: var(--surface);
  color: var(--ink);
  border: 1px solid var(--line);
  border-radius: 2px;
  padding: 0px 8px;
}
/* Variants: the solid faces of the primary / danger buttons, minus the shadow — a tag
   is a label, not something you can press. accent follows the runtime accent-picker;
   danger stays fixed on Office's error red. */
TyTag.accent { background: var(--accent); color: on(var(--accent)); border: 1px solid var(--accent); }
TyTag.danger { background: var(--danger); color: on(var(--danger)); border: 1px solid var(--danger); }
/* Greys out rather than fades: this palette carries no opacity token, and every other
   disabled control here recolours to the muted trio. The state layer resolves after the
   variant, so an accent / danger tag greys out through this one rule too. */
TyTag:disabled { background: var(--surface); color: var(--muted); border: 1px solid var(--line); }

/* Tag close: Fluent's dismiss inherits the pill's own ink, so no colour is set here —
   that is what keeps the x legible on the neutral, accent AND danger faces alike.
   Hover is the ghost button's faint neutral wash, squared off to the same 2px. */
TyTagClose       { border-radius: 2px; }
TyTagClose:hover { background: var(--hover-overlay); }

/* Badge: the counter badge is the one genuinely round thing in Fluent, so the inherited
   pill SHAPE is right for this era — its vocabulary is not. Ink resolves through
   on(var(--accent)), so rebranding to Excel-green or PowerPoint-orange re-inks the
   digits too; the weight is Fluent's semibold, not bold. Size is left alone — nativeness
   never comes from size here, so the badge keeps the base font.
   The radius deliberately over-shoots: unlike the radio's fixed indicator, a badge is
   sized from the MEASURED glyph height, so a literal (8px) would only read round at one
   font size and turn into a rounded rect at any other. Over-shooting lets the painter
   clamp to half the shorter side — round at every size, the way every round badge in
   the pack does it. */
TyBadge {
  background: var(--accent);
  color: on(var(--accent));
  border-radius: 100px;
  font-weight: 600;
  padding: 0px 4px;
}
