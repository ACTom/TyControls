/* ubuntu — a faithful take on Ubuntu's Yaru desktop look (light + dark).
   Native, not "zoomed": flat neutral surfaces, a light headerbar (no aubergine
   band), thin grey borders, 6px radii, the Ubuntu-orange accent, normal-weight
   buttons at compact GTK padding. DUAL-MODE: @mode light = Yaru light; @mode dark
   = Yaru dark (neutral #1E1E1E charcoal, NOT aubergine). Control rules resolve every
   mode-varying colour through var(--…); --accent stays the brand seed in both. */

/* LIGHT — Yaru light. */
@mode light {
  :root {
    --accent:     #E95420;   /* Ubuntu orange — brand seed; runtime picker recolours from here */
    --danger:     #C7162B;   /* Ubuntu/Yaru destructive red */
    --surface:    #FAFAFA;   /* window */
    --card-face:  #FFFFFF;   /* raised card sheet over the window */
    --headerbar:  #F5F5F5;   /* Yaru headerbar */
    --title-ink:  #1D1D1D;   /* caption text */
    --field:      #FFFFFF;   /* input wells */
    --border:     #C7C7C7;   /* field / control hairline */
    --ink:        #1D1D1D;   /* primary text */
    --muted:      #9A9A9A;   /* disabled / secondary ink */
    --btn-face:   #F7F7F7;   /* neutral button face */
    --btn-border: #C7C7C7;   /* button border */
    --btn-hover:  #EFEFEF;   /* button hover face */
    --btn-active: #E6E6E6;   /* button pressed face */
    --check-border: #B0B0B0; /* unchecked checkbox border */
    --track:      #D8D8D8;   /* progress track */
  }
}

/* DARK — Yaru dark: neutral charcoal surfaces, light ink, orange kept vivid. */
@mode dark {
  :root {
    --accent:     #E95420;   /* Ubuntu orange — brand seed, unchanged in dark */
    --danger:     #ED333B;   /* destructive red — lifted for dark contrast */
    --surface:    #1E1E1E;   /* window — Yaru dark neutral */
    --card-face:  #2C2C2C;   /* raised card sheet — lifted off the window */
    --headerbar:  #2C2C2C;   /* dark headerbar */
    --title-ink:  #FFFFFF;   /* caption text */
    --field:      #2C2C2C;   /* input wells */
    --border:     #3D3D3D;   /* field hairline */
    --ink:        #FFFFFF;   /* primary text */
    --muted:      #7A7A7A;   /* disabled / secondary ink */
    --btn-face:   #333333;   /* neutral dark button face */
    --btn-border: #454545;   /* button border */
    --btn-hover:  #3C3C3C;   /* button hover face (lighter in dark) */
    --btn-active: #454545;   /* button pressed face */
    --check-border: #5A5A5A; /* unchecked checkbox border */
    --track:      #3D3D3D;   /* progress track */
  }
}

/* Window & text */
TyForm   { background: var(--surface); }
TyLabel, TyHtmlLabel, TyLinkLabel, TyShadowLabel, TyGlowLabel, TyDivider, TyCharImage  { color: var(--ink); }

/* Title bar — light headerbar matching the window, flat and square. */
TyTitleBar, TyRibbonQuickAccess      { background: var(--headerbar); color: var(--title-ink); border-radius: 0; }
TyCaptionButton { background: transparent; color: var(--title-ink); border-radius: 5px; }
TyCaptionButton:hover  { background: alpha(var(--title-ink), 0.10); color: var(--title-ink); }
TyCaptionButton:active { background: var(--accent); color: on(var(--accent)); }
TyCaptionButton.close:hover  { background: var(--accent); color: on(var(--accent)); }
TyCaptionButton.close:active { background: darken(var(--accent), 8%); color: on(var(--accent)); }

/* Neutral button — flat warm-grey face, thin border, 6px radius, NORMAL weight. */
TyButton, TySpeedButton, TyGlyphContainerButton, TyRibbonAppMenu, TyButtonGroup, TyUpDown          { background: linear-gradient(90deg, lighten(var(--btn-face), 2%), var(--btn-face)); color: var(--ink); border: 1px solid var(--btn-border); border-radius: 6px; padding: 5px 10px; font-weight: normal; shadow: 0 1px 1px #00000012; }
TyButton:hover, TySpeedButton:hover, TyGlyphContainerButton:hover, TyRibbonAppMenu:hover, TyButtonGroup:hover, TyUpDown:hover    { background: var(--btn-hover); border-color: darken(var(--btn-border), 6%); }
TyButton:active, TySpeedButton:active, TyGlyphContainerButton:active, TyRibbonAppMenu:active, TyButtonGroup:active, TyUpDown:active   { background: var(--btn-active); border-color: darken(var(--btn-border), 10%); shadow: 0 0 0 transparent; }
TyButton:focus, TySpeedButton:focus, TyGlyphContainerButton:focus, TyRibbonAppMenu:focus, TyButtonGroup:focus, TyUpDown:focus    { border-color: var(--accent); outline: 2px alpha(var(--accent), 0.40); outline-offset: 1px; }TyButton:disabled, TySpeedButton:disabled, TyGlyphContainerButton:disabled, TyRibbonAppMenu:disabled, TyButtonGroup:disabled, TyUpDown:disabled { background: var(--btn-face); color: var(--muted); border-color: var(--btn-border); opacity: 0.6; shadow: 0 0 0 transparent; }

/* Primary — solid Ubuntu orange, white ink, 6px radius, normal weight (Yaru). */
TyButton.primary, TySpeedButton.primary, TyGlyphContainerButton.primary, TyRibbonAppMenu.primary, TyButtonGroup.primary, TyUpDown.primary          { background: linear-gradient(90deg, lighten(var(--accent), 4%), var(--accent)); color: #FFFFFF; border: 1px solid darken(var(--accent), 6%); border-radius: 6px; padding: 5px 10px; font-weight: normal; shadow: 0 1px 1px #00000018; }TyButton.primary:hover, TySpeedButton.primary:hover, TyGlyphContainerButton.primary:hover, TyRibbonAppMenu.primary:hover, TyButtonGroup.primary:hover, TyUpDown.primary:hover    { background: darken(var(--accent), 5%); border-color: darken(var(--accent), 10%); }TyButton.primary:active, TySpeedButton.primary:active, TyGlyphContainerButton.primary:active, TyRibbonAppMenu.primary:active, TyButtonGroup.primary:active, TyUpDown.primary:active   { background: darken(var(--accent), 11%); border-color: darken(var(--accent), 14%); shadow: 0 0 0 transparent; }TyButton.primary:focus, TySpeedButton.primary:focus, TyGlyphContainerButton.primary:focus, TyRibbonAppMenu.primary:focus, TyButtonGroup.primary:focus, TyUpDown.primary:focus    { outline: 2px alpha(var(--accent), 0.50); outline-offset: 1px; }TyButton.primary:disabled, TySpeedButton.primary:disabled, TyGlyphContainerButton.primary:disabled, TyRibbonAppMenu.primary:disabled, TyButtonGroup.primary:disabled, TyUpDown.primary:disabled { background: alpha(var(--accent), 0.5); border-color: transparent; color: #FFFFFF; opacity: 0.8; shadow: 0 0 0 transparent; }

/* Danger — destructive mirror of primary: solid Yaru red, white ink, normal weight. */
TyButton.danger, TySpeedButton.danger, TyGlyphContainerButton.danger, TyRibbonAppMenu.danger, TyButtonGroup.danger, TyUpDown.danger          { background: linear-gradient(90deg, lighten(var(--danger), 4%), var(--danger)); color: #FFFFFF; border: 1px solid darken(var(--danger), 6%); border-radius: 6px; padding: 5px 10px; font-weight: normal; shadow: 0 1px 1px #00000018; }TyButton.danger:hover, TySpeedButton.danger:hover, TyGlyphContainerButton.danger:hover, TyRibbonAppMenu.danger:hover, TyButtonGroup.danger:hover, TyUpDown.danger:hover    { background: darken(var(--danger), 5%); border-color: darken(var(--danger), 10%); }TyButton.danger:active, TySpeedButton.danger:active, TyGlyphContainerButton.danger:active, TyRibbonAppMenu.danger:active, TyButtonGroup.danger:active, TyUpDown.danger:active   { background: darken(var(--danger), 11%); border-color: darken(var(--danger), 14%); shadow: 0 0 0 transparent; }TyButton.danger:focus, TySpeedButton.danger:focus, TyGlyphContainerButton.danger:focus, TyRibbonAppMenu.danger:focus, TyButtonGroup.danger:focus, TyUpDown.danger:focus    { outline: 2px alpha(var(--danger), 0.50); outline-offset: 1px; }TyButton.danger:disabled, TySpeedButton.danger:disabled, TyGlyphContainerButton.danger:disabled, TyRibbonAppMenu.danger:disabled, TyButtonGroup.danger:disabled, TyUpDown.danger:disabled { background: alpha(var(--danger), 0.5); border-color: transparent; color: #FFFFFF; opacity: 0.8; shadow: 0 0 0 transparent; }

/* Ghost — flat, orange ink, tint on interaction. */
TyButton.ghost, TySpeedButton.ghost, TyGlyphContainerButton.ghost, TyRibbonAppMenu.ghost, TyButtonGroup.ghost, TyUpDown.ghost          { background: transparent; color: var(--accent); border: 1px solid transparent; border-radius: 6px; padding: 5px 10px; font-weight: normal; }TyButton.ghost:hover, TySpeedButton.ghost:hover, TyGlyphContainerButton.ghost:hover, TyRibbonAppMenu.ghost:hover, TyButtonGroup.ghost:hover, TyUpDown.ghost:hover    { background: alpha(var(--accent), 0.10); color: var(--accent); }TyButton.ghost:active, TySpeedButton.ghost:active, TyGlyphContainerButton.ghost:active, TyRibbonAppMenu.ghost:active, TyButtonGroup.ghost:active, TyUpDown.ghost:active   { background: alpha(var(--accent), 0.18); color: darken(var(--accent), 8%); }TyButton.ghost:disabled, TySpeedButton.ghost:disabled, TyGlyphContainerButton.ghost:disabled, TyRibbonAppMenu.ghost:disabled, TyButtonGroup.ghost:disabled, TyUpDown.ghost:disabled { background: transparent; color: var(--muted); opacity: 0.6; }

/* Fields — crisp white wells, thin border, 6px radius, orange focus. */
TyEdit          { background: var(--field); color: var(--ink); border: 1px solid var(--border); border-radius: 6px; padding: 5px 8px; }
TyEdit:focus    { border-color: var(--accent); outline: 2px alpha(var(--accent), 0.30); outline-offset: 0px; }
TyEdit:disabled { background: darken(var(--field), 3%); color: var(--muted); }
TyComboBox          { background: var(--field); color: var(--ink); border: 1px solid var(--border); border-radius: 6px; padding: 5px 8px; }
TyComboBox:focus    { border-color: var(--accent); outline: 2px alpha(var(--accent), 0.30); }
TyComboBox:disabled { background: darken(var(--field), 3%); color: var(--muted); }

/* Check box — white box, grey border, 5px radius; checked fills solid orange. */
TyCheckBox           { background: var(--field); color: var(--accent); border: 1px solid var(--check-border); border-radius: 5px; }
TyCheckBox:hover     { border-color: var(--accent); }
TyCheckBox:active    { background: var(--field); border-color: var(--accent); }
TyCheckBox:selected  { background: var(--accent); color: on(var(--accent)); border-color: var(--accent); }
TyCheckBox:focus     { outline: 2px alpha(var(--accent), 0.35); outline-offset: 2px; }

/* Radio — round mirror of the checkbox. */
TyRadioButton          { background: var(--field); color: var(--accent); border: 1px solid var(--check-border); border-radius: 100px; }
TyRadioButton:hover    { border-color: var(--accent); }
TyRadioButton:selected { background: var(--accent); color: on(var(--accent)); border-color: var(--accent); }
TyRadioButton:focus    { outline: 2px alpha(var(--accent), 0.35); outline-offset: 2px; }

/* Progress — flat pill track, solid orange fill. */
TyProgressBar  { background: var(--track); border: none; border-radius: 100px; }
TyProgressFill { background: var(--accent); border-radius: 100px; }

/* Card — the Yaru sheet: a raised face lifted off the window, thin grey hairline,
   6px radius, a faint shadow like the buttons'. Header and actions are bands on
   that one sheet, and Yaru cards are FLAT — no tinted title strip (a --headerbar
   band would also vanish against the dark card face, which is the same charcoal).
   So both bands are just a separator hairline; the title carries bold ink. */
TyCard          { background: var(--card-face); color: var(--ink); border: 1px solid var(--border); border-radius: 6px; padding: 12px; shadow: 0 1px 2px #00000014; }
TyCard:hover    { border-color: darken(var(--border), 6%); shadow: 0 2px 6px #0000001F; }
TyCard:disabled { opacity: 0.6; }
TyCardHeader    { color: var(--ink); border-color: var(--border); border-width: 1px; font-weight: bold; }
TyCardActions   { border-color: var(--border); border-width: 1px; }

/* Tag — a flat GTK chip: neutral ink-tint pill, round ends, no border (Yaru chips
   are fills, not frames). The tint mirrors the caption button's hover wash, so it
   reads right on both the light and the dark card face. accent/danger fill solid in
   the brand orange / the Yaru red and let on() pick the ink, exactly as the checkbox
   and the caption buttons above already do on the accent: on() reads the orange as a
   dark seed and hands back the white Yaru wants, and it stays right when the runtime
   picker recolours --accent out from under a pinned literal. */
TyTag          { background: alpha(var(--ink), 0.10); color: var(--ink); border-radius: 100px; padding: 0px 8px; }
TyTag.accent   { background: var(--accent); color: on(var(--accent)); }
TyTag.danger   { background: var(--danger); color: on(var(--danger)); }
TyTag:disabled { opacity: 0.6; }

/* Close 'x' — dim secondary ink that darkens into a circular hover chip, the way
   GTK's .circular close buttons behave inside a pill. */
TyTagClose       { color: var(--muted); }
TyTagClose:hover { background: alpha(var(--ink), 0.10); color: var(--ink); border-radius: 100px; }

/* Badge — GNOME Shell's counter pill: a solid accent counter with bold ink. The base
   badge already sits on the accent, but it rounds to the base's 12px; Shell's counters
   are true pills, so restate the shape here (a skin that names a typeKey owns it whole)
   and keep the ink on the seed via on(). */
TyBadge { background: var(--accent); color: on(var(--accent)); border-radius: 100px; font-weight: bold; padding: 0px 4px; }