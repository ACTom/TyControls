/* material3 — Material Design 3 (Material You), re-authored for a GENUINELY NATIVE
   feel. DUAL-MODE: only the PALETTE flips per @mode; every radius, padding, shadow
   and font-weight is shared. Nativeness comes from COLOUR + M3 OUTLINE + PILL RADII
   + SOFT ELEVATION, never from oversized padding (buttons stay compact so short CJK
   captions never truncate). --accent is the brand seed in BOTH modes (the runtime
   accent-picker recolours through it); the visible mode-varying primary is --primary,
   which in light IS the seed and in dark is M3's brightened #D0BCFF tone.
   LIGHT: near-white surface, white outlined fields, #6750A4 primary, #E8DEF8
   secondary-container tonal buttons, dark on-surface ink.
   DARK:  #141218 surface, #1D1B20 fields, #D0BCFF primary on #381E72, #4A4458 tonal
   container, light on-surface ink. */

/* --- palette: light ------------------------------------------------------ */
@mode light {
  :root {
    --accent:     #6750A4;   /* M3 primary — brand/accent seed (picker target)   */
    --primary:    var(--accent); /* visible primary; light == the seed           */
    --on-primary: #FFFFFF;   /* ink on filled primary / checked check-mark        */
    --surface:    #FAFAFA;   /* window + top app bar: near-white surface          */
    --card:       #F7F2FA;   /* card container: M3 surface-container-low          */
    --field:      #FFFFFF;   /* outlined text-field / checkbox well               */
    --outline:    #79747E;   /* M3 outline: field / checkbox / radio stroke       */
    --tonal:      #E8DEF8;   /* secondary-container: tonal (default) button fill   */
    --on-tonal:   #1D192B;   /* on-secondary-container ink                         */
    --danger:     #B3261E;   /* M3 error role: destructive/filled danger fill     */
    --on-danger:  #FFFFFF;   /* on-error ink                                      */
    --track:      #E7E0EC;   /* progress track (surface-variant)                  */
    --ink:        #1C1B1F;   /* primary on-surface ink                            */
    --ink-muted:  #49454F;   /* secondary on-surface ink (caption glyphs)         */
  }
}

/* --- palette: dark ------------------------------------------------------- */
@mode dark {
  :root {
    --accent:     #6750A4;   /* brand seed stays constant across modes            */
    --primary:    #D0BCFF;   /* M3 primary, brightened for dark contrast          */
    --on-primary: #381E72;   /* dark ink on the light-purple filled primary       */
    --surface:    #141218;   /* window + top app bar: darkest tonal surface       */
    --card:       #1D1B20;   /* card container: M3 surface-container-low (dark)   */
    --field:      #1D1B20;   /* outlined text-field / checkbox well               */
    --outline:    #938F99;   /* M3 outline (dark)                                 */
    --tonal:      #4A4458;   /* secondary-container (dark) tonal button fill       */
    --on-tonal:   #E8DEF8;   /* on-secondary-container ink (dark)                  */
    --danger:     #F2B8B5;   /* M3 error role, brightened for dark contrast       */
    --on-danger:  #601410;   /* dark ink on the light-red filled error            */
    --track:      #49454F;   /* progress track (surface-variant, dark)            */
    --ink:        #E6E1E5;   /* primary on-surface ink (light)                    */
    --ink-muted:  #CAC4D0;   /* secondary on-surface ink                          */
  }
}

/* Window: the M3 surface. */
TyForm          { background: var(--surface); }

/* Top app bar: flat surface, on-surface ink, circular icon-button state layers. */
TyTitleBar      { background: var(--surface); color: var(--ink); border-radius: 0; }
TyCaptionButton { background: transparent; color: var(--ink-muted); border-radius: 20px; }
TyCaptionButton:hover  { background: alpha(var(--primary), 0.10); color: var(--ink); }
TyCaptionButton:active { background: alpha(var(--primary), 0.16); color: var(--ink); }

TyLabel         { color: var(--ink); }

/* Default button = M3 "filled tonal": secondary-container fill, tonal ink, full-pill
   20px corners, compact padding, normal weight, faint level-1 elevation. */
TyButton          { background: var(--tonal); color: var(--on-tonal); border-width: 0; border-radius: 20px; padding: 6px 10px; font-weight: normal; shadow: 0 1 2 #0000001F; }
TyButton:hover    { background: mix(var(--tonal), var(--primary), 8%);  shadow: 0 2 4 #00000029; }
TyButton:active   { background: mix(var(--tonal), var(--primary), 12%); shadow: 0 1 2 #0000001F; }
TyButton:selected { background: mix(var(--tonal), var(--primary), 16%); shadow: 0 1 2 #0000001F; }
TyButton:focus    { background: mix(var(--tonal), var(--primary), 12%); outline: 2px var(--primary); outline-offset: 2px; }
TyButton:disabled { background: alpha(var(--ink), 0.08); color: alpha(var(--ink), 0.38); shadow: 0 0 0 #00000000; }

/* Primary = M3 "filled" button: solid primary, on-primary ink, medium (500) weight,
   soft elevation; a white state layer lightens hover/press. */
TyButton.primary          { background: var(--primary); color: var(--on-primary); border-width: 0; border-radius: 20px; padding: 6px 10px; font-weight: 500; shadow: 0 1 3 #00000026; }
TyButton.primary:hover    { background: mix(var(--primary), #FFFFFF, 8%);  shadow: 0 2 6 #00000033; }
TyButton.primary:active   { background: mix(var(--primary), #FFFFFF, 12%); shadow: 0 1 2 #00000026; }
TyButton.primary:selected { background: mix(var(--primary), #FFFFFF, 12%); shadow: 0 1 2 #00000026; }
TyButton.primary:focus    { background: mix(var(--primary), #FFFFFF, 8%);  outline: 2px var(--primary); outline-offset: 2px; }
TyButton.primary:disabled { background: alpha(var(--ink), 0.12); color: alpha(var(--ink), 0.38); shadow: 0 0 0 #00000000; }

/* Danger = the same M3 "filled" button in the error role: solid error, on-error ink,
   medium (500) weight, soft elevation; a white state layer lightens hover/press. */
TyButton.danger          { background: var(--danger); color: var(--on-danger); border-width: 0; border-radius: 20px; padding: 6px 10px; font-weight: 500; shadow: 0 1 3 #00000026; }
TyButton.danger:hover    { background: mix(var(--danger), #FFFFFF, 8%);  shadow: 0 2 6 #00000033; }
TyButton.danger:active   { background: mix(var(--danger), #FFFFFF, 12%); shadow: 0 1 2 #00000026; }
TyButton.danger:selected { background: mix(var(--danger), #FFFFFF, 12%); shadow: 0 1 2 #00000026; }
TyButton.danger:focus    { background: mix(var(--danger), #FFFFFF, 8%);  outline: 2px var(--danger); outline-offset: 2px; }
TyButton.danger:disabled { background: alpha(var(--ink), 0.12); color: alpha(var(--ink), 0.38); shadow: 0 0 0 #00000000; }

/* Ghost = M3 "text" button: no fill/border, primary ink, tonal state layer on hover. */
TyButton.ghost          { background: transparent; color: var(--primary); border-width: 0; border-radius: 20px; padding: 6px 10px; font-weight: normal; shadow: 0 0 0 #00000000; }
TyButton.ghost:hover    { background: alpha(var(--primary), 0.08); color: var(--primary); }
TyButton.ghost:active   { background: alpha(var(--primary), 0.12); color: var(--primary); }
TyButton.ghost:selected { background: alpha(var(--primary), 0.12); color: var(--primary); }
TyButton.ghost:focus    { background: alpha(var(--primary), 0.10); outline: 2px var(--primary); outline-offset: 0px; }
TyButton.ghost:disabled { background: transparent; color: alpha(var(--ink), 0.38); }

/* Fields = M3 "outlined" text field: 1px outline stroke, small 4px corner; hover
   darkens the outline to on-surface, focus swaps to a 2px primary outline. */
TyEdit          { background: var(--field); color: var(--ink); border: 1px solid var(--outline); border-radius: 4px; padding: 4px 8px; }
TyEdit:hover    { border-color: var(--ink); }
TyEdit:focus    { border: 2px solid var(--primary); }
TyEdit:disabled { background: alpha(var(--ink), 0.04); color: alpha(var(--ink), 0.38); border-color: alpha(var(--ink), 0.12); }

TyComboBox          { background: var(--field); color: var(--ink); border: 1px solid var(--outline); border-radius: 4px; padding: 4px 8px; }
TyComboBox:hover    { border-color: var(--ink); }
TyComboBox:focus    { border: 2px solid var(--primary); }
TyComboBox:disabled { background: alpha(var(--ink), 0.04); color: alpha(var(--ink), 0.38); border-color: alpha(var(--ink), 0.12); }

/* Checkbox: unchecked = field well, 2px M3 outline, near-square 2px radius. Checked
   (:active) fills with primary and inks the check-mark with on-primary. */
TyCheckBox          { background: var(--field); color: var(--primary); border: 2px solid var(--outline); border-radius: 2px; }
TyCheckBox:hover    { border-color: var(--primary); }
TyCheckBox:active   { background: var(--primary); color: var(--on-primary); border: 2px solid var(--primary); border-radius: 2px; }
TyCheckBox:disabled { background: alpha(var(--ink), 0.04); color: alpha(var(--ink), 0.38); border-color: alpha(var(--ink), 0.20); }

/* Radio: circular M3 control; selected fills the target with primary. */
TyRadioButton          { background: var(--field); color: var(--primary); border: 2px solid var(--outline); border-radius: 100px; }
TyRadioButton:hover    { border-color: var(--primary); }
TyRadioButton:active   { background: var(--primary); color: var(--on-primary); border: 2px solid var(--primary); border-radius: 100px; }
TyRadioButton:selected { background: var(--primary); color: var(--on-primary); border: 2px solid var(--primary); border-radius: 100px; }
TyRadioButton:disabled { background: alpha(var(--ink), 0.04); color: alpha(var(--ink), 0.38); border-color: alpha(var(--ink), 0.20); }

/* Linear progress: surface-variant track, solid primary fill, both fully pill-rounded. */
TyProgressBar   { background: var(--track);   border-radius: 100px; }
TyProgressFill  { background: var(--primary); border-radius: 100px; }

/* --- card + tag + badge -------------------------------------------------- */

/* M3 "elevated card": the card is its OWN tonal surface, never an outlined box.
   Elevation here is TONE first, shadow second — over the dark palette's #141218 a
   shadow is all but invisible, so a card left at the window colour would vanish;
   surface-container-low is what lifts it, and it reads in both modes. 12px = M3's
   medium shape. 16px is the spec's card inset: the header's compact-padding thesis
   is a BUTTON rule (it keeps short CJK captions from truncating), and a card holds
   content, not a caption. Hover only lifts level 1 -> level 2, reusing the very
   shadow pair the buttons already use. */
TyCard          { background: var(--card); color: var(--ink); border-width: 0; border-radius: 12px; padding: 16px; shadow: 0 1 2 #0000001F; }
TyCard:hover    { shadow: 0 2 4 #00000029; }
TyCard:disabled { background: alpha(var(--ink), 0.04); color: alpha(var(--ink), 0.38); shadow: 0 0 0 #00000000; }

/* No separator hairline and no tinted band on either strip: M3 divides a card by
   whitespace and type weight, never by rules — and this skin gets its structure from
   elevation, not from borders. The header's padding stays unset on purpose so the
   title inherits the card's 16px and lines up with the body; the title is M3
   "title-medium" = the same 500 weight the filled buttons carry, not bold. */
TyCardHeader    { color: var(--ink); border-width: 0; font-weight: 500; }
TyCardActions   { border-width: 0; }

/* Chips ARE the M3 tag, and they are the one M3 component that is not a pill: 8px
   (small shape) corners, a 1px outline round a transparent container, on-surface
   label — an M3 assist/filter chip at rest, hover lit by the usual 8% state layer.
   Horizontal air follows this file's compact discipline (the buttons' 10px); vertical
   is 0 because the type sets the height. Disabled neutralises the chip to M3's
   on-surface washes — 12% container, 38% label, 12% outline — which is also what
   the filled variants below fall back to. */
TyTag           { background: transparent; color: var(--ink); border: 1px solid var(--outline); border-radius: 8px; padding: 0px 10px; }
TyTag:hover     { background: alpha(var(--ink), 0.08); }
TyTag:disabled  { background: alpha(var(--ink), 0.12); color: alpha(var(--ink), 0.38); border-color: alpha(var(--ink), 0.12); }

/* The variants are the two roles the palette actually seeds. Both are FILLED chips —
   M3 drops a chip's outline the moment it takes a container — lightened by the same
   white state layer the filled buttons use, so a tag and a button of the same role
   never disagree. */
TyTag.accent       { background: var(--primary); color: var(--on-primary); border-width: 0; }
TyTag.accent:hover { background: mix(var(--primary), #FFFFFF, 8%); }
TyTag.danger       { background: var(--danger); color: var(--on-danger); border-width: 0; }
TyTag.danger:hover { background: mix(var(--danger), #FFFFFF, 8%); }

/* The x is M3's trailing "remove" icon: on-surface-variant ink on the outlined chip,
   and the container's own ink on the filled ones (TyTagClose resolves with the tag's
   StyleClass, so the variants can say so). :hover is the circular state layer M3 puts
   under every icon target; it deliberately sets no colour, so a filled chip's x keeps
   its contrast while the pointer is on it. */
TyTagClose          { color: var(--ink-muted); }
TyTagClose:hover    { background: alpha(var(--ink), 0.12); border-radius: 100px; }
TyTagClose:disabled { color: alpha(var(--ink), 0.38); }
TyTagClose.accent   { color: var(--on-primary); }
TyTagClose.danger   { color: var(--on-danger); }

/* An M3 badge is an ERROR-role component, not an accent one — Material's own badge
   defaults to the error container with on-error ink, so the inherited accent pill is
   simply the wrong role here (and this key also drives TyButton's built-in badge, which
   is exactly where M3 puts red badges anyway). Fully round, 4px of horizontal air,
   label is M3 "label-small" = 500; the dot and inset keep the built-in metrics. */
TyBadge         { background: var(--danger); color: var(--on-danger); border-radius: 100px; font-weight: 500; padding: 0px 4px; }
