/* Classic 3D skin — inspired by the Windows 9x look (an ORIGINAL take, not a pixel clone).
   Shows the v3 skin engine composing: render-style bevels (D + B2), a grey system palette,
   square corners, and a gradient title bar (B1). Loaded as a FILE by the theming example.

   DUAL-MODE: Win95 has no dark mode, so dark is a documented NO-OP — the WHOLE window must
   render byte-identical to light. Duplicating classic's own palette verbatim (the old state)
   is not enough for that: the skin styles only its OWN typeKeys, and the BASE layer's seeds
   (--surface/--on-surface/--border, TyBuiltinBaseModeCss) still swap per mode underneath — so
   every base-fallback surface (list box, panel, status bar, memo, …) turned dark while the
   grey 3D chrome stayed light: a mixed window (the aero bug's twin; test.modecoherence pins
   both). ENFORCEMENT: the @mode dark block restates classic's own palette AND pins those base
   seeds to their light values (--border is already classic's own #808080 in both blocks), so
   the base layer's derived family (--input-bg, --chrome-bar-bg, --muted, …) re-derives to the
   exact light results. If the base ever grows another mode-swapped seed, the coherence guard
   goes red here — pin the new seed the same way. */

/* Mode-invariant metrics. Win9x caption buttons were small squares in the top-right, so the
   classic skin shrinks the title-bar buttons from the 46px default via the --caption-button-width
   theme metric (device px are DPI-scaled from this logical value). A card's title band is a
   caption band in this idiom (see TyCardHeader), so it is caption-short too — not the tall
   36px band a modern skin wants. */
:root {
  --caption-button-width:    25;   /* small squarish caption buttons */
  --caption-button-margin:    3;   /* horizontal gap: buttons ↔ right edge / caption */
  --caption-button-margin-y:  6;   /* vertical gap: buttons ↔ title-bar top & bottom */
  --caption-button-gap:       4;   /* gap between adjacent buttons */
  --card-header-height:      24;   /* the card's caption band, sized like a Win9x caption */
  --on-titlebar: var(--title-ink);   /* ink for controls hosted on the title bar */
}

/* --accent is the brand seed; the runtime accent-picker recolours the skin through it. */
@mode light {
  :root {
    --accent:       #10318C;   /* brand seed — title-bar dark stop + progress fill */
    --title-mid:    #7BA2E0;   /* title-bar gradient mid stop */
    --title-light:  #A6CAF0;   /* title-bar gradient light stop */
    --title-ink:    #FFFFFF;   /* title-bar caption text */
    --face:         #C0C0C0;   /* grey 3D system surface */
    --face-hover:   #C8C8C8;   /* lightly lit face on hover */
    --ink:          #000000;   /* primary text */
    --ink-disabled: #808080;   /* greyed text */
    --ink-inverse:  #FFFFFF;   /* ink on a FILLED accent/maroon chip — badge, tag variants */
    --danger:       #800000;   /* destructive ink — the system-palette dark red (maroon) */
    --field:        #FFFFFF;   /* white input well */
    --border:       #808080;   /* stroked indicator / edge grey */
    --on-titlebar: var(--title-ink);   /* ink for controls hosted on the title bar */
}
}
@mode dark {
  :root {
    --accent:       #10318C;   /* identical to light — dark is a whole-window no-op (header) */
    --title-mid:    #7BA2E0;
    --title-light:  #A6CAF0;
    --title-ink:    #FFFFFF;
    --face:         #C0C0C0;
    --face-hover:   #C8C8C8;
    --ink:          #000000;
    --ink-disabled: #808080;
    --ink-inverse:  #FFFFFF;
    --danger:       #800000;
    --field:        #FFFFFF;
    --border:       #808080;
    /* Base-seed pins (see header): hold the BASE layer's mode-swapped seeds at their light
       values so base-fallback controls (list box, panel, status bar, …) stay light too —
       without these, dark mode renders a mixed window. Values = the base light seeds
       (TyBuiltinBaseModeCss); --border needs no pin, classic's own #808080 above covers it. */
    --surface:      #FFFFFF;
    --on-surface:   #1F2937;
    --on-titlebar: var(--title-ink);   /* ink for controls hosted on the title bar */
}
}

TyForm          { background: var(--face); }
TyTitleBar, TyRibbonQuickAccess      { background: linear-gradient(0deg, var(--accent), var(--title-mid), var(--title-light)); color: var(--title-ink); border-radius: 0; }

/* Caption buttons: raised grey 3D squares (the Win9x look), FLOATING with gaps — the title bar
   shows between and around them (--caption-button-margin / --caption-button-gap in :root).
   Pressed = sunken (inset3d), the classic push-button feel. */
TyCaptionButton        { render-style: bevel3d; background: var(--face); color: var(--ink); }
TyCaptionButton:active { render-style: inset3d; background: var(--face); color: var(--ink); }

TyLabel, TyHtmlLabel, TyLinkLabel, TyShadowLabel, TyGlowLabel, TyDivider, TyCharImage         { color: var(--ink); }

/* Buttons: raised bevel at rest, sunken (pressed) on :active — the classic push-button feel.
   'render-style: bevel3d' alone gives the outset bevel, square corners and edge colours
   derived from the grey face; no need to spell out border-style/width/color/radius. */
TyButton, TySpeedButton, TyGlyphContainerButton, TyRibbonAppMenu, TyButtonGroup, TyUpDown                { render-style: bevel3d; background: var(--face); color: var(--ink); font-weight: normal; padding: 6px; }
TyButton:hover, TySpeedButton:hover, TyGlyphContainerButton:hover, TyRibbonAppMenu:hover, TyButtonGroup:hover, TyUpDown:hover          { render-style: bevel3d; background: var(--face-hover); color: var(--ink); }
TyButton:active, TySpeedButton:active, TyGlyphContainerButton:active, TyRibbonAppMenu:active, TyButtonGroup:active, TyUpDown:active         { render-style: inset3d;  background: var(--face); color: var(--ink); }TyButton:disabled, TySpeedButton:disabled, TyGlyphContainerButton:disabled, TyRibbonAppMenu:disabled, TyButtonGroup:disabled, TyUpDown:disabled       { render-style: bevel3d; background: var(--face); color: var(--ink-disabled); }
TyButton.primary, TySpeedButton.primary, TyGlyphContainerButton.primary, TyRibbonAppMenu.primary, TyButtonGroup.primary, TyUpDown.primary        { render-style: bevel3d; background: var(--face); color: var(--ink); }TyButton.primary:hover, TySpeedButton.primary:hover, TyGlyphContainerButton.primary:hover, TyRibbonAppMenu.primary:hover, TyButtonGroup.primary:hover, TyUpDown.primary:hover  { render-style: bevel3d; background: var(--face-hover); }TyButton.primary:active, TySpeedButton.primary:active, TyGlyphContainerButton.primary:active, TyRibbonAppMenu.primary:active, TyButtonGroup.primary:active, TyUpDown.primary:active { render-style: inset3d;  background: var(--face); }
/* Danger: Win9x never tinted a button FACE — the grey 3D face IS the system look — so the
   destructive variant speaks through maroon label ink instead. Each state restates the ink:
   the plain TyButton:hover/:active rules above also set 'color' and are applied AFTER
   TyButton.danger, so an unstated colour would fall back to --ink. */
TyButton.danger, TySpeedButton.danger, TyGlyphContainerButton.danger, TyRibbonAppMenu.danger, TyButtonGroup.danger, TyUpDown.danger         { render-style: bevel3d; background: var(--face); color: var(--danger); }TyButton.danger:hover, TySpeedButton.danger:hover, TyGlyphContainerButton.danger:hover, TyRibbonAppMenu.danger:hover, TyButtonGroup.danger:hover, TyUpDown.danger:hover   { render-style: bevel3d; background: var(--face-hover); color: var(--danger); }TyButton.danger:active, TySpeedButton.danger:active, TyGlyphContainerButton.danger:active, TyRibbonAppMenu.danger:active, TyButtonGroup.danger:active, TyUpDown.danger:active  { render-style: inset3d;  background: var(--face); color: var(--danger); }
TyButton.ghost, TySpeedButton.ghost, TyGlyphContainerButton.ghost, TyRibbonAppMenu.ghost, TyButtonGroup.ghost, TyUpDown.ghost          { render-style: bevel3d; background: var(--face); color: var(--ink); }TyButton.ghost:active, TySpeedButton.ghost:active, TyGlyphContainerButton.ghost:active, TyRibbonAppMenu.ghost:active, TyButtonGroup.ghost:active, TyUpDown.ghost:active   { render-style: inset3d;  background: var(--face); }

/* Fields: sunken white wells. */
TyEdit          { render-style: inset3d; background: var(--field); color: var(--ink); padding: 4px 6px; }
/* An edit EMBEDDED in another control's field -- the editable combo box puts a real TTyEdit
   over its text zone. The host already drew the field and owns the focus ring; a second frame
   inside the first is what pushed the drop chevron into the gap between them. This has to be
   repeated in every theme that writes ANY TyEdit rule, because doing so suppresses the whole
   built-in TyEdit rule set for this typeKey -- variants included. */
TyEdit.embedded         { border-width: 0; border-radius: 0; }
TyEdit.embedded:hover   { border-color: transparent; }
TyEdit.embedded:focus   { border-color: transparent; outline: 0px transparent; }
TyComboBox      { render-style: inset3d; background: var(--field); color: var(--ink); padding: 4px 6px; }

/* Check box: a white well with a grey border (the indicator box is stroked, not beveled). */
TyCheckBox      { background: var(--field); color: var(--ink); border: 1px solid var(--border); border-radius: 0; }
TyCheckBox:active { background: var(--field); color: var(--ink); border: 1px solid var(--border); border-radius: 0; }

/* Progress: a sunken grey track with a solid blue fill. */
TyProgressBar   { render-style: inset3d; background: var(--face); }
TyProgressFill  { background: var(--accent); border-radius: 0; }

/* Cards, tags and badges have no Win9x ancestor at all. Rather than import the modern
   round-pill look wholesale, each is rebuilt from parts this era DID have: the raised panel,
   the stroked box and the caption bar. Square corners throughout — nothing here is round. */

/* Card: a raised grey panel — the "grouped box" of this era — so the whole surface takes the
   same outset bevel as a button. Hover lights the face like every other 3D control here, and
   disabled greys the ink rather than fading the panel, exactly as TyButton:disabled does.
   Unlike the buttons above, the card SPELLS OUT the bevel border instead of letting
   'render-style' imply it: the card insets its header/actions bands by the declared border
   width, and an implied border is invisible to that measurement — the caption band would then
   paint over the panel's own raised edge and flatten the top of the card. The values restate
   exactly what bevel3d derives (2px outset, edges shaded from the face), so the frame is
   unchanged; :hover restates them against the lit face for the same reason. */
TyCard          { render-style: bevel3d; background: var(--face); color: var(--ink); border: 2px outset var(--face); padding: 8px; }
TyCard:hover    { render-style: bevel3d; background: var(--face-hover); color: var(--ink); border: 2px outset var(--face-hover); }
TyCard:disabled { render-style: bevel3d; background: var(--face); color: var(--ink-disabled); }
/* Title band: a titled panel of this era announced itself with a CAPTION, so the header wears
   the title bar's own gradient and caption ink — the card reads as a little window pane.
   The grey line under it is the shadow half of the classic etched divider. */
TyCardHeader    { background: linear-gradient(0deg, var(--accent), var(--title-mid), var(--title-light)); color: var(--title-ink); border: 1px solid var(--border); font-weight: bold; }
/* Actions rail: no band of its own — the strip IS the panel face, like a dialog's button row;
   only the etched divider above it separates the two. */
TyCardActions   { border: 1px solid var(--border); }

/* Tags: a tag isn't pressable, so it takes the stroked box the check-box indicator uses rather
   than a bevel — a small white boxed label with square ends (a round-ended pill is two decades
   out of period here). The variants swap only the fill and its ink; every tag keeps the same
   grey outline, so a row of them reads as one family. */
TyTag               { background: var(--field); color: var(--ink); border: 1px solid var(--border); border-radius: 0; padding: 0px 6px; }
TyTag.accent        { background: var(--accent); color: var(--ink-inverse); }
TyTag.danger        { background: var(--danger); color: var(--ink-inverse); }
/* Disabled drops the variant fill back to the grey face and greys the ink — how this era said
   "inert"; the skin never fades a control out with opacity. State rules are applied AFTER the
   .accent/.danger rules above, so this one line neutralises every variant. */
TyTag:disabled      { background: var(--face); color: var(--ink-disabled); }
/* The x: full-strength ink (this era had no half-toned affordances), restated per variant
   because a black x would sink into a filled tag. Hovering it lights a square grey chip — the
   same "hot" face the caption buttons give — and the x on that chip is black again. */
TyTagClose          { color: var(--ink); }
TyTagClose.accent   { color: var(--ink-inverse); }
TyTagClose.danger   { color: var(--ink-inverse); }
TyTagClose:hover    { background: var(--face-hover); color: var(--ink); border-radius: 0; }
TyTagClose:disabled { color: var(--ink-disabled); }

/* Badge: a hard little counter box with square corners — the round accent pill it would
   otherwise inherit is a 2010s notification bubble that simply didn't exist here. White-on-blue
   was this era's one "look at me" pairing (it IS the selection highlight), so the badge borrows
   it: accent fill, inverse ink, bold, and no bevel — at this size a 3D edge would eat the
   digits. The default --badge-* metrics already give a tight box, so the skin leaves them. */
TyBadge         { background: var(--accent); color: var(--ink-inverse); border-radius: 0; font-weight: bold; padding: 0px 4px; }

/* Controls hosted ON the title bar. A skin that paints the bar in a strong colour leaves an
   ordinary button's surface-tuned ink nearly invisible there; the control appends the
   'on-titlebar' variant automatically (TyStyleClassFor), so this is the only place a theme
   has to say what belongs on its own bar. Composed with whatever class the host set, so a
   ghost button on a title bar stays a ghost button and only its ink moves. */
TyButton.on-titlebar, TySpeedButton.on-titlebar, TyGlyphButton.on-titlebar,
TyGlyphContainerButton.on-titlebar, TyDropDownButton.on-titlebar,
TyMenuButton.on-titlebar, TyColorButton.on-titlebar, TyButtonGroup.on-titlebar,
TyLabel.on-titlebar, TyCheckBox.on-titlebar, TyToggleSwitch.on-titlebar {
  color: var(--on-titlebar);
}
