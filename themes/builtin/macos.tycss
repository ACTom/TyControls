/* macOS — an authentic Aqua / Big Sur+ take, DUAL-MODE. Nativeness comes from colour,
   hairline borders, 6px corners, a whisper of a vertical gloss and a soft accent focus
   ring — never from size (controls inherit the base 9px, buttons stay tight so CJK/short
   labels never truncate). Only the PALETTE flips per @mode; every radius, gradient shape,
   padding, weight and shadow geometry is shared. --accent is the brand seed in both modes,
   so the runtime accent-picker recolours the whole skin through it. */

/* --- palette: light (macOS light, system grey) --------------------------- */
@mode light {
  :root {
    --accent:               #007AFF;   /* macOS system blue — seeds every accent/primary surface */
    --danger:               #FF3B30;   /* Apple systemRed — destructive actions */
    --surface:              #ECECEC;   /* window chrome */
    --field:                #FFFFFF;   /* editable wells */
    --border:               #C6C6C6;   /* hairline field / button border */
    --ink:                  #1D1D1F;   /* near-black label text */

    /* title bar + caption buttons */
    --titlebar-bg:          #E8E8E8;
    --titlebar-ink:         #000000;
    --caption-ink:          #5B5B5D;
    --caption-ink-hover:    #1D1D1F;
    --overlay:              #000000;   /* hover/press wash base (caption glyphs, tag chips) */

    /* default button */
    --btn-face-top:         #FFFFFF;
    --btn-face-bot:         #F3F3F3;
    --btn-ink:              #1D1D1F;
    --btn-shadow:           #0000001A;
    --btn-hover-top:        #FFFFFF;
    --btn-hover-bot:        #ECECEC;
    --btn-active-top:       #E9E9E9;
    --btn-active-bot:       #DEDEDE;
    --btn-active-border:    #BFBFBF;
    --btn-disabled-bg:      #F2F2F2;
    --btn-disabled-ink:     #A6A6A8;
    --btn-disabled-border:  #DCDCDC;

    /* primary button */
    --primary-shadow:        #00000026;
    --primary-shadow-active: #0000001A;
    --primary-disabled-mix:  #FFFFFF;   /* accent blends toward this for disabled */
    --primary-disabled-ink:  #FFFFFF;

    /* fields */
    --field-hover-border:   #B0B0B0;
    --field-disabled-bg:    #F5F5F5;
    --field-disabled-ink:   #A6A6A8;
    --field-disabled-border:#E0E0E0;

    /* check / radio */
    --check-border:         #B0B0B0;
    --check-active-bg:      #F0F0F0;
    --check-disabled-bg:    #F5F5F5;
    --check-disabled-ink:   #C4C4C4;
    --check-disabled-border:#DCDCDC;

    /* progress */
    --track:                #D9D9D9;
    --track-border:         #C6C6C6;

    /* card */
    --card-face:            #FFFFFF;   /* a card is a sheet ON the window, not a sunken well */
  }
}

/* --- palette: dark (macOS dark) ------------------------------------------ */
@mode dark {
  :root {
    --accent:               #0A84FF;   /* system blue for dark mode */
    --danger:               #FF453A;   /* systemRed for dark mode */
    --surface:              #323232;   /* window chrome */
    --field:                #1E1E1E;   /* editable wells */
    --border:               #48484A;   /* hairline field / button border */
    --ink:                  #F5F5F7;   /* light label text */

    /* title bar + caption buttons */
    --titlebar-bg:          #2A2A2A;
    --titlebar-ink:         #F5F5F7;
    --caption-ink:          #AEAEB2;
    --caption-ink-hover:    #F5F5F7;
    --overlay:              #FFFFFF;   /* hover/press wash base (caption glyphs, tag chips) */

    /* default button */
    --btn-face-top:         #5A5A5C;
    --btn-face-bot:         #48484A;
    --btn-ink:              #FFFFFF;
    --btn-shadow:           #00000040;
    --btn-hover-top:        #6A6A6C;
    --btn-hover-bot:        #545456;
    --btn-active-top:       #48484A;
    --btn-active-bot:       #3A3A3C;
    --btn-active-border:    #565658;
    --btn-disabled-bg:      #2A2A2C;
    --btn-disabled-ink:     #6E6E73;
    --btn-disabled-border:  #333335;

    /* primary button */
    --primary-shadow:        #00000059;
    --primary-shadow-active: #00000040;
    --primary-disabled-mix:  #323232;   /* accent blends toward the dark surface for disabled */
    --primary-disabled-ink:  #E5E5E7;

    /* fields */
    --field-hover-border:   #5A5A5C;
    --field-disabled-bg:    #252527;
    --field-disabled-ink:   #6E6E73;
    --field-disabled-border:#333335;

    /* check / radio */
    --check-border:         #565658;
    --check-active-bg:      #333335;
    --check-disabled-bg:    #252527;
    --check-disabled-ink:   #58585A;
    --check-disabled-border:#333335;

    /* progress */
    --track:                #3A3A3C;
    --track-border:         #48484A;

    /* card */
    --card-face:            #3A3A3C;   /* lifts above the chrome; --field (#1E1E1E) would sink */
  }
}

/* Window + unified title bar (flat system grey, hairline-rounded top). */
TyForm          { background: var(--surface); }
TyTitleBar, TyRibbonQuickAccess      { background: var(--titlebar-bg); color: var(--titlebar-ink); border-radius: 6 6 0 0; }
TyCaptionButton { background: transparent; color: var(--caption-ink); border-radius: 4; }
TyCaptionButton:hover  { background: alpha(var(--overlay), 0.08); color: var(--caption-ink-hover); }
TyCaptionButton:active { background: alpha(var(--overlay), 0.14); }

TyLabel, TyHtmlLabel, TyLinkLabel, TyShadowLabel, TyGlowLabel, TyDivider, TyCharImage         { color: var(--ink); }

/* Default button: white→grey vertical gloss, hairline, 6px corners, soft shadow, tight padding. */
TyButton, TySpeedButton, TyGlyphContainerButton, TyRibbonAppMenu, TyButtonGroup, TyUpDown                { background: linear-gradient(90deg, var(--btn-face-top), var(--btn-face-bot)); color: var(--btn-ink); border: 1px solid var(--border); border-radius: 6; padding: 4px 10px; font-weight: normal; shadow: 0 1 1 var(--btn-shadow); }
TyButton:hover, TySpeedButton:hover, TyGlyphContainerButton:hover, TyRibbonAppMenu:hover, TyButtonGroup:hover, TyUpDown:hover          { background: linear-gradient(90deg, var(--btn-hover-top), var(--btn-hover-bot)); }
TyButton:active, TySpeedButton:active, TyGlyphContainerButton:active, TyRibbonAppMenu:active, TyButtonGroup:active, TyUpDown:active         { background: linear-gradient(90deg, var(--btn-active-top), var(--btn-active-bot)); border-color: var(--btn-active-border); shadow: 0 0 0 transparent; }
TyButton:focus, TySpeedButton:focus, TyGlyphContainerButton:focus, TyRibbonAppMenu:focus, TyButtonGroup:focus, TyUpDown:focus          { border-color: var(--accent); outline: 3 alpha(var(--accent), 0.35); outline-offset: 1; }
TyButton:disabled, TySpeedButton:disabled, TyGlyphContainerButton:disabled,
TyRibbonAppMenu:disabled       { background: var(--btn-disabled-bg); color: var(--btn-disabled-ink); border-color: var(--btn-disabled-border); opacity: 0.55; shadow: 0 0 0 transparent; }

/* Primary (the default macOS action button): accent gloss, white ink, NOT bold. */
TyButton.primary, TySpeedButton.primary, TyGlyphContainerButton.primary, TyRibbonAppMenu.primary, TyButtonGroup.primary, TyUpDown.primary        { background: linear-gradient(90deg, lighten(var(--accent), 8%), var(--accent)); color: on(var(--accent)); border: 1px solid darken(var(--accent), 8%); border-radius: 6; padding: 4px 10px; font-weight: normal; shadow: 0 1 2 var(--primary-shadow); }
TyButton.primary:hover, TySpeedButton.primary:hover, TyGlyphContainerButton.primary:hover,
TyRibbonAppMenu.primary:hover  { background: linear-gradient(90deg, lighten(var(--accent), 12%), lighten(var(--accent), 4%)); }
TyButton.primary:active, TySpeedButton.primary:active, TyGlyphContainerButton.primary:active,
TyRibbonAppMenu.primary:active { background: linear-gradient(90deg, var(--accent), darken(var(--accent), 8%)); shadow: 0 1 1 var(--primary-shadow-active); }
TyButton.primary:focus, TySpeedButton.primary:focus, TyGlyphContainerButton.primary:focus,
TyRibbonAppMenu.primary:focus  { outline: 3 alpha(var(--accent), 0.35); outline-offset: 1; }
TyButton.primary:disabled, TySpeedButton.primary:disabled,
TyGlyphContainerButton.primary:disabled, TyRibbonAppMenu.primary:disabled { background: mix(var(--accent), var(--primary-disabled-mix), 55%); color: var(--primary-disabled-ink); border-color: mix(var(--accent), var(--primary-disabled-mix), 40%); opacity: 0.6; shadow: 0 0 0 transparent; }

/* Danger (a destructive macOS action button): systemRed gloss, white ink, NOT bold —
   the primary material driven by --danger, so it shares primary's shadow/disabled recipe. */
TyButton.danger, TySpeedButton.danger, TyGlyphContainerButton.danger, TyRibbonAppMenu.danger, TyButtonGroup.danger, TyUpDown.danger         { background: linear-gradient(90deg, lighten(var(--danger), 8%), var(--danger)); color: on(var(--danger)); border: 1px solid darken(var(--danger), 8%); border-radius: 6; padding: 4px 10px; font-weight: normal; shadow: 0 1 2 var(--primary-shadow); }
TyButton.danger:hover, TySpeedButton.danger:hover, TyGlyphContainerButton.danger:hover,
TyRibbonAppMenu.danger:hover   { background: linear-gradient(90deg, lighten(var(--danger), 12%), lighten(var(--danger), 4%)); }
TyButton.danger:active, TySpeedButton.danger:active, TyGlyphContainerButton.danger:active,
TyRibbonAppMenu.danger:active  { background: linear-gradient(90deg, var(--danger), darken(var(--danger), 8%)); shadow: 0 1 1 var(--primary-shadow-active); }
TyButton.danger:focus, TySpeedButton.danger:focus, TyGlyphContainerButton.danger:focus,
TyRibbonAppMenu.danger:focus   { border-color: darken(var(--danger), 8%); outline: 3 alpha(var(--danger), 0.35); outline-offset: 1; }
TyButton.danger:disabled, TySpeedButton.danger:disabled, TyGlyphContainerButton.danger:disabled,
TyRibbonAppMenu.danger:disabled { background: mix(var(--danger), var(--primary-disabled-mix), 55%); color: var(--primary-disabled-ink); border-color: mix(var(--danger), var(--primary-disabled-mix), 40%); opacity: 0.6; shadow: 0 0 0 transparent; }

/* Ghost: transparent accent-text button, faint accent wash on interaction. */
TyButton.ghost, TySpeedButton.ghost, TyGlyphContainerButton.ghost, TyRibbonAppMenu.ghost, TyButtonGroup.ghost, TyUpDown.ghost          { background: transparent; color: var(--accent); border: 1px solid transparent; border-radius: 6; padding: 4px 10px; font-weight: normal; shadow: 0 0 0 transparent; }
TyButton.ghost:hover, TySpeedButton.ghost:hover, TyGlyphContainerButton.ghost:hover,
TyRibbonAppMenu.ghost:hover    { background: alpha(var(--accent), 0.10); color: darken(var(--accent), 6%); }
TyButton.ghost:active, TySpeedButton.ghost:active, TyGlyphContainerButton.ghost:active,
TyRibbonAppMenu.ghost:active   { background: alpha(var(--accent), 0.18); }
TyButton.ghost:disabled, TySpeedButton.ghost:disabled, TyGlyphContainerButton.ghost:disabled,
TyRibbonAppMenu.ghost:disabled { background: transparent; color: var(--btn-disabled-ink); opacity: 0.55; }

/* Fields: white wells, hairline border, soft accent focus ring. */
TyEdit          { background: var(--field); color: var(--ink); border: 1px solid var(--border); border-radius: 6; padding: 4px 8px; }
TyEdit:hover    { border-color: var(--field-hover-border); }
TyEdit:focus    { border-color: var(--accent); outline: 3 alpha(var(--accent), 0.35); outline-offset: 0; }
TyEdit:disabled { background: var(--field-disabled-bg); color: var(--field-disabled-ink); border-color: var(--field-disabled-border); }

TyComboBox          { background: var(--field); color: var(--ink); border: 1px solid var(--border); border-radius: 6; padding: 4px 8px; }
TyComboBox:hover    { border-color: var(--field-hover-border); }
TyComboBox:focus    { border-color: var(--accent); outline: 3 alpha(var(--accent), 0.35); outline-offset: 0; }
TyComboBox:disabled { background: var(--field-disabled-bg); color: var(--field-disabled-ink); border-color: var(--field-disabled-border); }

/* Check box: white well, #B0B0B0 rim, accent fill when checked, 4px corners. */
TyCheckBox          { background: var(--field); color: var(--accent); border: 1px solid var(--check-border); border-radius: 4; }
TyCheckBox:hover    { border-color: var(--accent); }
TyCheckBox:active   { background: var(--check-active-bg); border-color: var(--accent); }
TyCheckBox:selected { background: var(--accent); color: on(var(--accent)); border-color: darken(var(--accent), 8%); border-radius: 4; }
TyCheckBox:focus    { border-color: var(--accent); outline: 3 alpha(var(--accent), 0.35); outline-offset: 1; }
TyCheckBox:disabled { background: var(--check-disabled-bg); color: var(--check-disabled-ink); border-color: var(--check-disabled-border); }

/* Radio: same material as the check box (the control paints the circle). */
TyRadioButton          { background: var(--field); color: var(--accent); border: 1px solid var(--check-border); }
TyRadioButton:hover    { border-color: var(--accent); }
TyRadioButton:active   { background: var(--check-active-bg); border-color: var(--accent); }
TyRadioButton:selected { background: var(--accent); color: on(var(--accent)); border-color: darken(var(--accent), 8%); }
TyRadioButton:focus    { border-color: var(--accent); outline: 3 alpha(var(--accent), 0.35); outline-offset: 1; }
TyRadioButton:disabled { background: var(--check-disabled-bg); color: var(--check-disabled-ink); border-color: var(--check-disabled-border); }

/* Progress: soft grey track, flat accent fill, both fully rounded. */
TyProgressBar   { background: var(--track); color: var(--ink); border: 1px solid var(--track-border); border-radius: 100; }
TyProgressFill  { background: var(--accent); border-radius: 100; }

/* --- card + tag + badge (Ant Design-gap batch 1) ------------------------- */

/* Card: an Aqua box — a plain sheet on the window chrome, hairline, the shared 6px corner
   and the same soft shadow the buttons cast (a card is only a bigger member of the family). */
TyCard          { background: var(--card-face); color: var(--ink); border: 1px solid var(--border); border-radius: 6; padding: 12px; shadow: 0 1 3 var(--btn-shadow); }
TyCard:hover    { border-color: var(--field-hover-border); shadow: 0 2 6 var(--btn-shadow); }
TyCard:disabled { opacity: 0.55; }

/* Title / actions bands: hairline rules, never a tinted strip — a tinted caption band is a
   Win9x/Office move; a Mac box separates with a rule and names itself with a bold title.
   No font-size: like every control here the title takes the inherited size. */
TyCardHeader  { color: var(--ink); border: 1px solid var(--border); font-weight: bold; }
TyCardActions { border: 1px solid var(--border); }

/* Tag: a Mail-style address token — flat fill, hairline, fully round ends (the 100 radius is
   clamped to half height, same as the progress bar). Neutral fill is the caption's wash base
   at caption strength, so it flips with the mode; the hairline is what makes it an object on
   the grey chrome, exactly as it does for the fields. */
TyTag          { background: alpha(var(--overlay), 0.08); color: var(--ink); border: 1px solid var(--border); border-radius: 100; padding: 0px 8px; }
/* Variants: flat accent / systemRed with the darkened rim the primary button and the checked
   box wear. No gloss — the gloss is this skin's button material and a tag is a label. */
TyTag.accent   { background: var(--accent); color: on(var(--accent)); border-color: darken(var(--accent), 8%); }
TyTag.danger   { background: var(--danger); color: on(var(--danger)); border-color: darken(var(--danger), 8%); }
TyTag:disabled { opacity: 0.55; }

/* The x: same species as a caption-button glyph — a muted mark that takes a wash chip under
   the pointer, round rather than the caption's 4px square because it sits inside a capsule.
   The variants re-ink it: a grey glyph would be unreadable on the accent / systemRed fills.
   Hover only lays the chip down, so each variant keeps its own ink. */
TyTagClose        { color: alpha(var(--ink), 0.5); }
TyTagClose.accent { color: on(var(--accent)); }
TyTagClose.danger { color: on(var(--danger)); }
TyTagClose:hover  { background: alpha(var(--overlay), 0.12); border-radius: 100; }

/* Badge: the Dock's count bubble — systemRed, white, bold, round. NOT --accent: on a Mac a
   number riding a control means unread / attention, and that colour is systemRed; the blue
   is the brand seed the user re-picks at runtime, which would say something else entirely. */
TyBadge { background: var(--danger); color: on(var(--danger)); border-radius: 100; font-weight: bold; padding: 0px 4px; }
