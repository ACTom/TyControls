/* Aero — authentic Windows 7 "Aero" glossy glass. Light steel-glass window, wet-gloss
   3-stop buttons, thin cool blue borders, 3px corners, crisp white fields, soft shadow.
   Gradient angle note: 90deg runs TOP->BOTTOM, so the first stop is the top sheen.

   DUAL-MODE: Aero glass is inherently light and has no natural dark variant, so @mode dark is
   made IDENTICAL to @mode light — the palette below is duplicated verbatim in both blocks.
   --accent stays the brand seed (used via var(--accent) in both modes) so the runtime
   accent-picker still recolours the whole skin. */

/* Mode-invariant derived value: focus ring is always the accent at 55% (accent is per-mode). */
:root {
  --focus-ring: alpha(var(--accent), 0.55);
}

/* ---- LIGHT palette (authentic Aero glass) ---- */
@mode light {
  :root {
    --accent:            #2C7FD6;   /* brand blue — runtime accent-picker recolours from here */
    --ink:               #1E2B3A;   /* cool dark-slate body text */
    --titlebar-ink:      #0A1A2A;   /* deep glass-caption ink */

    --form-1:            #EEF3F9;   /* window steel-glass wash, top */
    --form-2:            #DCE6F0;   /* window steel-glass wash, bottom */

    --titlebar-1:        #E4EEF7;   /* Aero glass caption, top sheen */
    --titlebar-2:        #C4D8EC;   /* Aero glass caption, base */

    --field-bg:          #FFFFFF;   /* crisp white field well */
    --field-border:      #7DA2CE;   /* cool blue field / check border */
    --field-focus:       #3C7FB1;   /* focus border blue */

    --btn-1:             #FDFEFF;   /* button gloss: wet upper sheen */
    --btn-2:             #ECF2F9;   /* button gloss: mid */
    --btn-3:             #DBE7F4;   /* button gloss: deeper base */
    --btn-border:        #718DB5;   /* button cool steel border */
    --btn-shadow:        #00000014; /* soft neutral drop shadow */

    --btn-h1:            #EAF6FD;   /* hover glow, top */
    --btn-h2:            #D2ECFB;   /* hover glow, base */

    --btn-a1:            #C4DCF0;   /* pressed, top (darker -> sunken) */
    --btn-a2:            #D9E9F8;   /* pressed, base (lifts back up) */

    --check-bg:          #FFFFFF;   /* white check box well */

    --track:             #DCE6F0;   /* progress track */
    --progress-border:   #A7C0D8;   /* progress track border */

    --glass:             #FFFFFF;   /* white glass base for translucent lifts */

    --close:             #E04747;   /* close-button warm glow */
    --close-active:      #C23030;
    --close-ink:         #FFFFFF;

    --danger:            #E04747;   /* destructive red — the Aero close-glass red */

    --primary-shadow:    #10467A33; /* deeper accent shadow under primary */
    --danger-shadow:     #7A101033; /* deeper red shadow under danger */
  }
}

/* ---- DARK palette (Aero has no natural dark variant — IDENTICAL to light) ---- */
@mode dark {
  :root {
    --accent:            #2C7FD6;
    --ink:               #1E2B3A;
    --titlebar-ink:      #0A1A2A;

    --form-1:            #EEF3F9;
    --form-2:            #DCE6F0;

    --titlebar-1:        #E4EEF7;
    --titlebar-2:        #C4D8EC;

    --field-bg:          #FFFFFF;
    --field-border:      #7DA2CE;
    --field-focus:       #3C7FB1;

    --btn-1:             #FDFEFF;
    --btn-2:             #ECF2F9;
    --btn-3:             #DBE7F4;
    --btn-border:        #718DB5;
    --btn-shadow:        #00000014;

    --btn-h1:            #EAF6FD;
    --btn-h2:            #D2ECFB;

    --btn-a1:            #C4DCF0;
    --btn-a2:            #D9E9F8;

    --check-bg:          #FFFFFF;

    --track:             #DCE6F0;
    --progress-border:   #A7C0D8;

    --glass:             #FFFFFF;

    --close:             #E04747;
    --close-active:      #C23030;
    --close-ink:         #FFFFFF;

    --danger:            #E04747;

    --primary-shadow:    #10467A33;
    --danger-shadow:     #7A101033;
  }
}

/* Window: light steel-glass wash, top lighter, bottom a touch deeper. */
TyForm { background: linear-gradient(90deg, var(--form-1), var(--form-2)); }

/* Title bar: Aero glass — pale sheen fading to steel blue; deep caption ink, normal weight. */
TyTitleBar {
  background: linear-gradient(90deg, var(--titlebar-1), var(--titlebar-2));
  color: var(--titlebar-ink);
  font-weight: normal;
}

/* Caption buttons: glassy translucent lift; a warm red glow on close. */
TyCaptionButton        { background: alpha(var(--glass), 0); color: var(--titlebar-ink); border-radius: 0; }
TyCaptionButton:hover  { background: alpha(var(--glass), 0.55); }
TyCaptionButton:active { background: alpha(var(--glass), 0.78); }
TyCaptionButton.min:hover    { background: alpha(var(--glass), 0.55); }
TyCaptionButton.max:hover    { background: alpha(var(--glass), 0.55); }
TyCaptionButton.close:hover  { background: var(--close); color: var(--close-ink); }
TyCaptionButton.close:active { background: var(--close-active); color: var(--close-ink); }

TyLabel          { background: alpha(var(--glass), 0); color: var(--ink); font-weight: normal; }
TyLabel:disabled { opacity: 0.5; }

/* Buttons: the classic wet-glass gloss — 3-stop vertical gradient (bright sheen -> mid -> deeper
   base), thin cool steel border, 3px corners, a soft neutral shadow. Compact padding so demo
   captions never truncate. */
TyButton {
  background: linear-gradient(90deg, var(--btn-1), var(--btn-2), var(--btn-3));
  color: var(--ink);
  border-color: var(--btn-border);
  border-width: 1px;
  border-radius: 3px;
  padding: 6px;
  font-weight: normal;
  shadow: 0 1 2 var(--btn-shadow);
}
TyButton:hover {
  background: linear-gradient(90deg, var(--btn-h1), var(--btn-h2));
  border-color: var(--field-focus);
}
TyButton:active {
  background: linear-gradient(90deg, var(--btn-a1), var(--btn-a2));
  border-color: var(--field-focus);
  shadow: 0 1 1 var(--btn-shadow);
}
TyButton:focus    { border-color: var(--accent); outline: 2px var(--focus-ring); outline-offset: 1px; }
TyButton:disabled { opacity: 0.5; }

/* Primary: glossy accent glass — bright accent sheen up top fading into the solid accent base. */
TyButton.primary {
  background: linear-gradient(90deg, lighten(var(--accent), 18%), var(--accent));
  color: on(var(--accent));
  border-color: darken(var(--accent), 10%);
  shadow: 0 1 2 var(--primary-shadow);
}
TyButton.primary:hover {
  background: linear-gradient(90deg, lighten(var(--accent), 26%), lighten(var(--accent), 6%));
  border-color: darken(var(--accent), 6%);
}
TyButton.primary:active {
  background: linear-gradient(90deg, darken(var(--accent), 4%), darken(var(--accent), 12%));
  border-color: darken(var(--accent), 16%);
  shadow: 0 1 1 var(--primary-shadow);
}
TyButton.primary:disabled { opacity: 0.5; }

/* Danger: the same wet-glass gloss as primary, driven by the destructive red instead of the accent. */
TyButton.danger {
  background: linear-gradient(90deg, lighten(var(--danger), 18%), var(--danger));
  color: on(var(--danger));
  border-color: darken(var(--danger), 10%);
  shadow: 0 1 2 var(--danger-shadow);
}
TyButton.danger:hover {
  background: linear-gradient(90deg, lighten(var(--danger), 26%), lighten(var(--danger), 6%));
  border-color: darken(var(--danger), 6%);
}
TyButton.danger:active {
  background: linear-gradient(90deg, darken(var(--danger), 4%), darken(var(--danger), 12%));
  border-color: darken(var(--danger), 16%);
  shadow: 0 1 1 var(--danger-shadow);
}
TyButton.danger:disabled { opacity: 0.5; }

/* Ghost: transparent with accent text; fades into a faint glass panel on hover/press. */
TyButton.ghost {
  background: alpha(var(--glass), 0);
  color: var(--accent);
  border-color: alpha(var(--field-border), 0);
  border-width: 1px;
  border-radius: 3px;
  padding: 6px;
  font-weight: normal;
}
TyButton.ghost:hover    { background: alpha(var(--glass), 0.5); border-color: var(--field-focus); }
TyButton.ghost:active   { background: alpha(var(--btn-a1), 0.9); border-color: var(--field-focus); }
TyButton.ghost:selected { background: alpha(var(--btn-a1), 0.95); border-color: var(--accent); }
TyButton.ghost:focus    { outline: 2px var(--focus-ring); outline-offset: 1px; }
TyButton.ghost:disabled { opacity: 0.5; }

/* Fields: crisp white wells, cool blue border, 3px corners, blue focus glow. */
TyEdit {
  background: var(--field-bg);
  color: var(--ink);
  border-color: var(--field-border);
  border-width: 1px;
  border-radius: 3px;
  padding: 4px;
}
TyEdit:hover    { border-color: var(--field-focus); }
TyEdit:focus    { border-color: var(--field-focus); outline: 2px var(--focus-ring); }
TyEdit:disabled { opacity: 0.5; }

TyComboBox {
  background: var(--field-bg);
  color: var(--ink);
  border-color: var(--field-border);
  border-width: 1px;
  border-radius: 3px;
  padding: 4px;
}
TyComboBox:hover    { border-color: var(--field-focus); }
TyComboBox:focus    { border-color: var(--field-focus); outline: 2px var(--focus-ring); }
TyComboBox:disabled { opacity: 0.5; }

/* Check box: white well, cool blue border, 2px corners; accent fill + white tick when checked. */
TyCheckBox {
  background: var(--check-bg);
  color: var(--ink);
  border-color: var(--field-border);
  border-width: 1px;
  border-radius: 2px;
  padding: 4px;
}
TyCheckBox:hover    { border-color: var(--accent); }
TyCheckBox:active   { background: var(--accent); color: on(var(--accent)); border-color: darken(var(--accent), 10%); }
TyCheckBox:focus    { outline: 2px var(--focus-ring); }
TyCheckBox:disabled { opacity: 0.5; }

/* Radio: mirrors the check box (control rounds it into a dot). */
TyRadioButton {
  background: var(--check-bg);
  color: var(--ink);
  border-color: var(--field-border);
  border-width: 1px;
  border-radius: 2px;
  padding: 4px;
}
TyRadioButton:hover    { border-color: var(--accent); }
TyRadioButton:active   { background: var(--accent); color: on(var(--accent)); border-color: darken(var(--accent), 10%); }
TyRadioButton:focus    { outline: 2px var(--focus-ring); }
TyRadioButton:disabled { opacity: 0.5; }

/* Progress: light glass track with a glossy accent fill (bright sheen fading to accent). */
TyProgressBar {
  background: var(--track);
  border-color: var(--progress-border);
  border-width: 1px;
  border-radius: 3px;
}
TyProgressBar:disabled { opacity: 0.5; }

TyProgressFill {
  background: linear-gradient(90deg, lighten(var(--accent), 15%), var(--accent));
  border-radius: 3px;
}

/* ---- Card + Tag (Ant Design-gap batch 1) ---- */

/* Card: an Aero content pane — a white glass sheet lifted off the steel window wash, thin cool
   blue border, the same 3px corners as every other frame here, soft neutral shadow. Hovering
   lifts it the way a glass button lifts: focus-blue rim and a little more shadow. */
TyCard {
  background: linear-gradient(90deg, var(--glass), var(--form-1));
  color: var(--ink);
  border-color: var(--field-border);
  border-width: 1px;
  border-radius: 3px;
  padding: 12px;
  shadow: 0 1 3 var(--btn-shadow);
}
TyCard:hover    { border-color: var(--field-focus); shadow: 0 2 5 var(--btn-shadow); }
TyCard:disabled { opacity: 0.5; }

/* Header band: the card gets its own little Aero caption — the window title bar's glass sheen, so
   the band reads as chrome on the white sheet (the form wash would sink into the card's own
   gradient and vanish). Title ink is a darkened accent: Win7 headings are blue, not black, and
   darkening keeps them legible on the pale glass while still following the accent picker. Weight
   stays normal — nothing in Aero shouts. The separator is the field blue faded right down: a
   hairline, not a second frame inside the card. */
TyCardHeader {
  background: linear-gradient(90deg, var(--titlebar-1), var(--titlebar-2));
  color: darken(var(--accent), 15%);
  border-color: alpha(var(--field-border), 0.55);
  border-width: 1px;
  font-weight: normal;
}

/* Actions band: the window's own steel wash rather than the caption glass — the footer is a
   command strip, not a second title; the same faded hairline sits above it. */
TyCardActions {
  background: linear-gradient(90deg, var(--form-1), var(--form-2));
  border-color: alpha(var(--field-border), 0.55);
  border-width: 1px;
}

/* Tag: a mini glass chiclet — the button's 3-stop wet gloss and cool steel border at the skin's
   3px corners. Round-ended pills belong to a flatter era; Aero's shape language is the chiclet. */
TyTag {
  background: linear-gradient(90deg, var(--btn-1), var(--btn-2), var(--btn-3));
  color: var(--ink);
  border-color: var(--btn-border);
  border-width: 1px;
  border-radius: 3px;
  padding: 0px 8px;
}
/* Variants: the glossy accent / red glass of the primary and danger buttons, shrunk to tag size. */
TyTag.accent {
  background: linear-gradient(90deg, lighten(var(--accent), 18%), var(--accent));
  color: on(var(--accent));
  border-color: darken(var(--accent), 10%);
}
TyTag.danger {
  background: linear-gradient(90deg, lighten(var(--danger), 18%), var(--danger));
  color: on(var(--danger));
  border-color: darken(var(--danger), 10%);
}
TyTag:disabled { opacity: 0.5; }

/* The x: faded slate ink on the glass chiclet, the pill's own on-colour on a coloured one (dark
   slate on accent glass would be unreadable). Hover sinks a thin slate wash under the glyph —
   the skin's own "pressed = darker" gesture, shrunk to chip size. The caption button's white
   glass lift can't come along: it needs the steel titlebar under it, and the tag's own gloss is
   already white at the top, which swallows it. A wash that only DARKENS is the one chip that
   reads on all three bodies, and it leaves each variant's ink above it intact — so the x is
   never restyled per-variant under hover. No red glow here: that belongs to the window's close
   button, not to a tag. */
TyTagClose        { color: alpha(var(--ink), 0.7); }
TyTagClose.accent { color: on(var(--accent)); }
TyTagClose.danger { color: on(var(--danger)); }
TyTagClose:hover  { background: alpha(var(--ink), 0.15); border-radius: 2px; }

/* Badge: the one genuinely round thing in the skin — Aero's glossy orb, accent glass with a bright
   top sheen (an oversized radius clamps to half-height). Bold is the exception the skin allows
   itself: the count is tiny and sits on saturated glass. */
TyBadge {
  background: linear-gradient(90deg, lighten(var(--accent), 18%), var(--accent));
  color: on(var(--accent));
  border-radius: 999px;
  font-weight: bold;
  padding: 0px 4px;
}
