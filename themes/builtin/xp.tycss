/* xp — Windows XP "Luna" (blue), the authentic look (an ORIGINAL take, not a bitmap clone):
   a glossy ROYAL-BLUE caption that STAYS blue top-to-bottom (a bright top highlight + a lower
   gloss band, NOT a fade to white); the signature ALWAYS-ON caption buttons — glossy blue
   min/max + a glossy RED close, rounded squares with white glyphs, slightly inset with a hair
   of gap; the Luna beige client; silver-white rounded buttons with the orange "Luna glow" on
   hover and a blue focus edge; and the green XP progress fill. Accent-driven, so the runtime
   picker recolours the blue chrome. @mode dark == light (Luna has no dark variant).
   90deg = a vertical top->bottom gradient here. */

:root {
  --radius: 3px;
  /* XP caption buttons: small glossy rounded squares (a touch wider than tall), each white-ringed. */
  --caption-button-width:    24;
  --caption-button-margin:    4;
  --caption-button-margin-y:  6;
  --caption-button-gap:       3;
}

/* Light palette = the authentic XP Luna look. */
@mode light {
  :root {
    --accent:       #2F6FE0;   /* Luna royal blue — caption + primary + accent chrome */
    --on-accent:    #FFFFFF;
    --surface:      #ECE9D8;    /* the iconic XP client "beige" */
    --on-surface:   #1B1B1B;
    --field:        #FFFFFF;
    --field-border: #7B9EBD;    /* soft steel-blue field edge */
    --focus:        #E58B00;    /* orange focus edge */
    --btn-border:   #7A94B5;    /* soft blue-grey default-button edge (NOT navy) */
    --danger:       #DC4E31;    /* the Luna close-button red — XP's one destructive colour */
    --on-danger:    on(var(--danger));

    --title-ink:    #FFFFFF;
    /* Glossy RED close-button stops. */
    --close-top:    #F4AB92;
    --close-mid:    #DC4E31;
    --close-bot:    #B23018;
  }
}

/* Dark palette — IDENTICAL to light (no natural dark Luna variant). */
@mode dark {
  :root {
    --accent:       #2F6FE0;
    --on-accent:    #FFFFFF;
    --surface:      #ECE9D8;
    --on-surface:   #1B1B1B;
    --field:        #FFFFFF;
    --field-border: #7B9EBD;
    --focus:        #E58B00;
    --btn-border:   #7A94B5;
    --danger:       #DC4E31;
    --on-danger:    on(var(--danger));

    --title-ink:    #FFFFFF;
    --close-top:    #F4AB92;
    --close-mid:    #DC4E31;
    --close-bot:    #B23018;
  }
}

/* Window: the Luna beige client area, wrapped in the iconic blue XP window frame (drawn on the
   side + bottom edges; the caption bar is the top). */
TyForm { background: var(--surface); border-color: var(--accent); border-width: 3px; }

/* Caption: glossy Luna blue that STAYS blue — a bright highlight at the very top, the body
   blue, then a subtle lower gloss band and a slightly darker bottom edge. Accent-derived. */
TyTitleBar, TyRibbonQuickAccess {
  background: linear-gradient(90deg,
    lighten(var(--accent), 30%) 0%,
    lighten(var(--accent), 6%)  7%,
    darken(var(--accent), 4%)   46%,
    var(--accent)               54%,
    lighten(var(--accent), 6%)  90%,
    darken(var(--accent), 16%)  100%);
  color: var(--title-ink);
  font-weight: bold;
  border-radius: 0;
}

/* Caption buttons: ALWAYS-ON glossy rounded squares. Base (min/max) = glossy blue; .close = the
   iconic glossy red. White glyphs; hover brightens; press darkens. */
TyCaptionButton {
  background: linear-gradient(90deg, lighten(var(--accent), 34%) 0%, lighten(var(--accent), 4%) 46%, darken(var(--accent), 10%) 100%);
  color: #FFFFFF;
  border-color: #FFFFFF;
  border-width: 1px;
  border-radius: 3px;
}
TyCaptionButton:hover        { background: linear-gradient(90deg, lighten(var(--accent), 46%) 0%, lighten(var(--accent), 16%) 46%, var(--accent) 100%); }
TyCaptionButton:active       { background: linear-gradient(90deg, darken(var(--accent), 6%) 0%, darken(var(--accent), 18%) 100%); }
TyCaptionButton.close        { background: linear-gradient(90deg, var(--close-top) 0%, var(--close-mid) 46%, var(--close-bot) 100%); border-color: #FFFFFF; }
TyCaptionButton.close:hover  { background: linear-gradient(90deg, #F9C4AF 0%, #EE6046 46%, #CB3B1E 100%); }
TyCaptionButton.close:active { background: linear-gradient(90deg, #B23018 0%, #8C2310 100%); }

TyLabel, TyHtmlLabel, TyLinkLabel, TyShadowLabel, TyGlowLabel, TyDivider, TyCharImage          { color: var(--on-surface); }
TyLabel:disabled, TyHtmlLabel:disabled, TyLinkLabel:disabled, TyShadowLabel:disabled, TyGlowLabel:disabled, TyDivider:disabled, TyCharImage:disabled { opacity: 0.5; }

/* Default button: silver-white rounded gradient, soft blue-grey edge; orange Luna glow on hover,
   pressed silver, blue+orange focus. */
TyButton, TySpeedButton, TyGlyphContainerButton, TyRibbonAppMenu, TyButtonGroup, TyUpDown {
  background: linear-gradient(90deg, #FDFEFF 0%, #F4F5F1 48%, #E4E6DE 100%);
  color: var(--on-surface);
  border-color: var(--btn-border);
  border-width: 1px;
  border-radius: var(--radius);
  padding: 5px 12px;
  font-weight: normal;
}
TyButton:hover, TySpeedButton:hover, TyGlyphContainerButton:hover, TyRibbonAppMenu:hover, TyButtonGroup:hover, TyUpDown:hover    { background: linear-gradient(90deg, #FFF7E9 0%, #FDE7C4 100%); border-color: #E0A020; }
TyButton:active, TySpeedButton:active, TyGlyphContainerButton:active, TyRibbonAppMenu:active, TyButtonGroup:active, TyUpDown:active   { background: linear-gradient(90deg, #DDE1DA 0%, #ECEEE8 100%); border-color: #6A84A5; }
TyButton:focus, TySpeedButton:focus, TyGlyphContainerButton:focus, TyRibbonAppMenu:focus, TyButtonGroup:focus, TyUpDown:focus    { border-color: var(--accent); outline: 2px var(--focus); outline-offset: 1px; }
TyButton:disabled, TySpeedButton:disabled, TyGlyphContainerButton:disabled, TyRibbonAppMenu:disabled, TyButtonGroup:disabled, TyUpDown:disabled { opacity: 0.5; }

/* Primary = the glossy blue Luna action button (pale-blue top -> accent -> darker bottom). */
TyButton.primary, TySpeedButton.primary, TyGlyphContainerButton.primary, TyRibbonAppMenu.primary, TyButtonGroup.primary, TyUpDown.primary {
  background: linear-gradient(90deg, lighten(var(--accent), 24%) 0%, var(--accent) 55%, darken(var(--accent), 12%) 100%);
  color: var(--on-accent);
  border-color: darken(var(--accent), 22%);
  border-width: 1px;
  border-radius: var(--radius);
  padding: 5px 12px;
  font-weight: normal;
}
TyButton.primary:hover, TySpeedButton.primary:hover, TyGlyphContainerButton.primary:hover,
TyRibbonAppMenu.primary:hover    { background: linear-gradient(90deg, lighten(var(--accent), 34%) 0%, lighten(var(--accent), 8%) 100%); border-color: #E0A020; }
TyButton.primary:active, TySpeedButton.primary:active, TyGlyphContainerButton.primary:active,
TyRibbonAppMenu.primary:active   { background: linear-gradient(90deg, darken(var(--accent), 8%) 0%, darken(var(--accent), 18%) 100%); }
TyButton.primary:focus, TySpeedButton.primary:focus, TyGlyphContainerButton.primary:focus,
TyRibbonAppMenu.primary:focus    { outline: 2px var(--focus); outline-offset: 1px; }
TyButton.primary:disabled, TySpeedButton.primary:disabled,
TyGlyphContainerButton.primary:disabled, TyRibbonAppMenu.primary:disabled { opacity: 0.5; }

/* Danger = the primary button cut from the glossy Luna close-button red instead of the blue. */
TyButton.danger, TySpeedButton.danger, TyGlyphContainerButton.danger, TyRibbonAppMenu.danger, TyButtonGroup.danger, TyUpDown.danger {
  background: linear-gradient(90deg, lighten(var(--danger), 24%) 0%, var(--danger) 55%, darken(var(--danger), 12%) 100%);
  color: var(--on-danger);
  border-color: darken(var(--danger), 22%);
  border-width: 1px;
  border-radius: var(--radius);
  padding: 5px 12px;
  font-weight: normal;
}
TyButton.danger:hover, TySpeedButton.danger:hover, TyGlyphContainerButton.danger:hover,
TyRibbonAppMenu.danger:hover    { background: linear-gradient(90deg, lighten(var(--danger), 34%) 0%, lighten(var(--danger), 8%) 100%); border-color: #E0A020; }
TyButton.danger:active, TySpeedButton.danger:active, TyGlyphContainerButton.danger:active,
TyRibbonAppMenu.danger:active   { background: linear-gradient(90deg, darken(var(--danger), 8%) 0%, darken(var(--danger), 18%) 100%); }
TyButton.danger:focus, TySpeedButton.danger:focus, TyGlyphContainerButton.danger:focus,
TyRibbonAppMenu.danger:focus    { outline: 2px var(--focus); outline-offset: 1px; }
TyButton.danger:disabled, TySpeedButton.danger:disabled, TyGlyphContainerButton.danger:disabled,
TyRibbonAppMenu.danger:disabled { opacity: 0.5; }

/* Ghost: transparent with accent text; a soft blue wash on touch. */
TyButton.ghost, TySpeedButton.ghost, TyGlyphContainerButton.ghost, TyRibbonAppMenu.ghost, TyButtonGroup.ghost, TyUpDown.ghost {
  background: alpha(var(--accent), 0);
  color: var(--accent);
  border-color: alpha(var(--accent), 0);
  border-width: 1px;
  border-radius: var(--radius);
  padding: 5px 12px;
  font-weight: normal;
}
TyButton.ghost:hover, TySpeedButton.ghost:hover, TyGlyphContainerButton.ghost:hover,
TyRibbonAppMenu.ghost:hover    { background: alpha(var(--accent), 0.12); border-color: alpha(var(--accent), 0.40); }
TyButton.ghost:active, TySpeedButton.ghost:active, TyGlyphContainerButton.ghost:active,
TyRibbonAppMenu.ghost:active   { background: alpha(var(--accent), 0.20); }
TyButton.ghost:selected, TySpeedButton.ghost:selected, TyGlyphContainerButton.ghost:selected,
TyRibbonAppMenu.ghost:selected { background: alpha(var(--accent), 0.20); border-color: var(--accent); }
TyButton.ghost:focus, TySpeedButton.ghost:focus, TyGlyphContainerButton.ghost:focus,
TyRibbonAppMenu.ghost:focus    { outline: 2px var(--focus); outline-offset: 1px; }
TyButton.ghost:disabled, TySpeedButton.ghost:disabled, TyGlyphContainerButton.ghost:disabled,
TyRibbonAppMenu.ghost:disabled { opacity: 0.5; }

/* Fields: crisp white wells, steel-blue border, orange focus edge. */
TyEdit {
  background: var(--field);
  color: var(--on-surface);
  border-color: var(--field-border);
  border-width: 1px;
  border-radius: var(--radius);
  padding: 4px 6px;
}
TyEdit:hover    { border-color: var(--accent); }
TyEdit:focus    { border-color: var(--focus); outline: 2px var(--focus); }
TyEdit:disabled { opacity: 0.5; }

TyComboBox {
  background: var(--field);
  color: var(--on-surface);
  border-color: var(--field-border);
  border-width: 1px;
  border-radius: var(--radius);
  padding: 4px 6px;
}
TyComboBox:hover    { border-color: var(--accent); }
TyComboBox:focus    { border-color: var(--focus); outline: 2px var(--focus); }
TyComboBox:disabled { opacity: 0.5; }

/* Check box: white box, blue-grey border, accent tick; checked = solid accent fill. */
TyCheckBox {
  background: var(--field);
  color: var(--accent);
  border-color: var(--field-border);
  border-width: 1px;
  border-radius: 2px;
  padding: 4px;
}
TyCheckBox:hover    { border-color: var(--accent); }
TyCheckBox:active   { background: var(--accent); color: var(--on-accent); border-color: darken(var(--accent), 12%); }
TyCheckBox:focus    { outline: 2px var(--focus); }
TyCheckBox:disabled { opacity: 0.5; }

/* Radio: sibling of the check box, fully rounded. */
TyRadioButton {
  background: var(--field);
  color: var(--accent);
  border-color: var(--field-border);
  border-width: 1px;
  border-radius: 9px;
  padding: 4px;
}
TyRadioButton:hover    { border-color: var(--accent); }
TyRadioButton:active   { background: var(--accent); color: var(--on-accent); border-color: darken(var(--accent), 12%); }
TyRadioButton:focus    { outline: 2px var(--focus); }
TyRadioButton:disabled { opacity: 0.5; }

/* Progress: a sunken white trough with the iconic XP green fill. */
TyProgressBar {
  background: var(--field);
  border-color: var(--field-border);
  border-width: 1px;
  border-radius: 3px;
  render-style: inset3d;
}
TyProgressBar:disabled { opacity: 0.5; }

TyProgressFill {
  background: linear-gradient(90deg, #9BE06B 0%, #6BBF3A 55%, #4E9E27 100%);
  border-radius: 2px;
}

/* Card: the XP Explorer "task pane" — a white panel lifted off the Luna beige, steel-blue edged and
   rounded-ish, with a pale-blue title band. A flat hairline card would be wrong here: in Luna a
   panel ALWAYS announces itself with a blue header, so the band is the point, not decoration. */
TyCard {
  background: var(--field);
  color: var(--on-surface);
  border-color: var(--field-border);
  border-width: 1px;
  border-radius: var(--radius);
  padding: 10px;
}
/* Hoverable = the same orange "Luna glow" the buttons light up with. */
TyCard:hover    { border-color: var(--focus); }
TyCard:disabled { opacity: 0.5; }

/* Title band: pale Luna blue fading a shade deeper, bold dark-blue ink, steel hairline beneath.
   Accent-derived, so the runtime picker recolours it along with the rest of the blue chrome.
   Padding left unset on purpose — the title then lines up with the body text. */
TyCardHeader {
  background: linear-gradient(90deg, lighten(var(--accent), 88%) 0%, lighten(var(--accent), 72%) 100%);
  color: darken(var(--accent), 30%);
  border-color: var(--field-border);
  border-width: 1px;
  font-weight: bold;
}

/* Actions strip: the XP wizard button band — the Luna beige under a steel hairline, so the buttons
   sit on chrome instead of floating on the white body. */
TyCardActions { background: var(--surface); border-color: var(--field-border); border-width: 1px; }

/* Tag: a miniature XP chip, NOT a modern round-ended pill — the raised silver gradient, blue-grey
   edge and 3px corners of the buttons, cut from the beige so it reads on the white card body and on
   the beige form alike. */
TyTag {
  background: linear-gradient(90deg, lighten(var(--surface), 70%) 0%, lighten(var(--surface), 40%) 48%, var(--surface) 100%);
  color: var(--on-surface);
  border-color: var(--btn-border);
  border-width: 1px;
  border-radius: var(--radius);
  padding: 0px 8px;
}
/* The two variants = the glossy primary / close-red buttons, shrunk to chip size. */
TyTag.accent {
  background: linear-gradient(90deg, lighten(var(--accent), 24%) 0%, var(--accent) 55%, darken(var(--accent), 12%) 100%);
  color: var(--on-accent);
  border-color: darken(var(--accent), 22%);
}
TyTag.danger {
  background: linear-gradient(90deg, lighten(var(--danger), 24%) 0%, var(--danger) 55%, darken(var(--danger), 12%) 100%);
  color: var(--on-danger);
  border-color: darken(var(--danger), 22%);
}
TyTag:disabled { opacity: 0.5; }

/* Close 'x': no chip at rest, just ink that follows the chip it sits on (one muted grey would go
   muddy on the glossy blue and red variants — the x resolves with the tag's StyleClass, so it can
   track them). Hover lights a miniature Luna close button: the glossy red with a white glyph,
   the caption bar's gesture at tag scale. */
TyTagClose        { color: var(--on-surface); border-radius: var(--radius); }
TyTagClose.accent { color: var(--on-accent); }
TyTagClose.danger { color: var(--on-danger); }
TyTagClose:hover  { background: linear-gradient(90deg, var(--close-top) 0%, var(--close-mid) 46%, var(--close-bot) 100%); color: var(--on-danger); }

/* Badge: a miniature caption button — the glossy blue rounded square with its white glyph — rather
   than the base layer's flat round pill, which is a decade too modern for Luna. A hair more side
   padding than the base's 4px, because XP chrome is chunky and the gloss needs room to read. */
TyBadge {
  background: linear-gradient(90deg, lighten(var(--accent), 34%) 0%, lighten(var(--accent), 4%) 46%, darken(var(--accent), 10%) 100%);
  color: var(--on-accent);
  border-radius: var(--radius);
  padding: 0px 5px;
  font-weight: bold;
}
