/* win11 — an ORIGINAL "inspired-by" ty-controls skin evoking Windows 11 (Fluent / Mica),
   DUAL-MODE (light + dark). NOT a pixel clone — a ty-controls interpretation tuned to feel
   GENUINELY NATIVE: soft 5px Fluent rounding, VERY subtle 1px hairline borders, faint 2px
   drop shadow, tight native padding (no "zoomed" enlargement), a rounded pill progress bar,
   and the #005FB8 Windows accent. Only the PALETTE flips between @mode light and @mode dark —
   every radius / padding / font-weight / shadow shape stays shared.
   LIGHT = Mica #F3F3F3 window, #FBFBFB button face, #FFFFFF wells, near-invisible #E5E5E5 border.
   DARK  = #202020 window, #2B2B2B cards, #2D2D2D fields, #3A3A3A border, white ink, #60CDFF accent.
   --accent is the brand seed used via var(--accent) in BOTH modes, so the runtime accent-picker
   still recolours the primary / accent surfaces. */

/* ── palette: light (Mica) ───────────────────────────────────────────────── */
@mode light {
  :root {
    /* Brand accent (recoloured by the picker) */
    --accent:  #005FB8;

    /* Destructive action — the Windows critical / close-button red */
    --danger:  #C42B1C;

    /* Mica-ish neutrals */
    --mica:    #F3F3F3;   /* window + title-bar surface */
    --field:   #FFFFFF;   /* text-field wells */
    --card:    #FBFBFB;   /* default button face */
    --ink:     #1A1A1A;   /* primary text */
    --border:        #E5E5E5;   /* very subtle hairline borders */
    --border-hover:  #CFCFCF;
    --border-strong: #8A8A8A;   /* check-box outline */
    --track:         #E6E6E6;   /* progress track */

    /* Solid button hover / press faces */
    --card-hover:  #F5F5F5;
    --card-active: #EFEFEF;

    /* Neutral overlays (subtle Fluent hover/press fills) */
    --hover-fill:  #00000008;
    --active-fill: #00000012;

    /* Faint button drop-shadow colour */
    --shadow-col: #0000000F;

    /* Disabled surfaces */
    --disabled-bg:     #F5F5F5;
    --disabled-ink:    #A0A0A0;
    --disabled-border: #EAEAEA;
    --field-disabled:  #FAFAFA;
    --check-disabled-bg:     #F0F0F0;
    --check-disabled-ink:    #BDBDBD;
    --check-disabled-border: #E0E0E0;
  }
}

/* ── palette: dark ───────────────────────────────────────────────────────── */
@mode dark {
  :root {
    /* Brand accent — brightened for dark-mode contrast (still recoloured by the picker) */
    --accent:  #60CDFF;

    /* Destructive action — lifted critical red so it reads on the dark surface */
    --danger:  #D13438;

    /* Dark neutrals */
    --mica:    #202020;   /* window + title-bar surface */
    --field:   #2D2D2D;   /* text-field wells */
    --card:    #2B2B2B;   /* default button face */
    --ink:     #FFFFFF;   /* primary light text */
    --border:        #3A3A3A;   /* soft dark borders */
    --border-hover:  #4A4A4A;
    --border-strong: #9A9A9A;   /* check-box outline */
    --track:         #454545;   /* progress track */

    /* Solid button hover / press faces (hover lightens, press darkens) */
    --card-hover:  #323232;
    --card-active: #292929;

    /* Neutral overlays (subtle Fluent hover/press fills, now white) */
    --hover-fill:  #FFFFFF0F;
    --active-fill: #FFFFFF17;

    /* Faint button drop-shadow colour (a touch stronger to read on dark) */
    --shadow-col: #00000047;

    /* Disabled surfaces */
    --disabled-bg:     #262626;
    --disabled-ink:    #6B6B6B;
    --disabled-border: #333333;
    --field-disabled:  #272727;
    --check-disabled-bg:     #2A2A2A;
    --check-disabled-ink:    #5A5A5A;
    --check-disabled-border: #3A3A3A;
  }
}

/* ── mode-invariant: accent-derived inks + geometry ──────────────────────── */
:root {
  /* Accent states — derived from --accent so the picker follows in both modes */
  --accent-hover:    lighten(var(--accent), 8%);
  --accent-active:   darken(var(--accent), 8%);
  --accent-border:   darken(var(--accent), 6%);
  --accent-disabled: alpha(var(--accent), 0.40);
  --accent-soft:     alpha(var(--accent), 0.12);   /* subtle selected wash */
  --on-accent:       on(var(--accent));            /* readable ink on accent */
  --on-accent-dim:   alpha(var(--on-accent), 0.85);/* pressed accent ink */

  /* Danger states — same derivation as the accent, driven by the per-mode --danger */
  --danger-hover:    lighten(var(--danger), 8%);
  --danger-active:   darken(var(--danger), 8%);
  --danger-border:   darken(var(--danger), 6%);
  --danger-disabled: alpha(var(--danger), 0.40);
  --on-danger:       on(var(--danger));            /* readable ink on danger */
  --on-danger-dim:   alpha(var(--on-danger), 0.85);/* pressed danger ink */

  /* Secondary ink — derived from the per-mode --ink */
  --ink-dim: alpha(var(--ink), 0.60);

  /* Geometry — Fluent soft rounding; progress is a full pill */
  --radius:      5px;
  --radius-sm:   4px;
  --radius-lg:   8px;    /* a LAYER (card / flyout) rounds softer than the controls on it */
  --radius-pill: 100px;
}

/* Window backdrop — the Mica surface. */
TyForm { background: var(--mica); }

/* Title bar: same Mica surface with primary ink — no coloured band (very Win 11). */
TyTitleBar, TyRibbonQuickAccess { background: var(--mica); color: var(--ink); border-radius: 0; }

/* Caption buttons: square, full-height, transparent → soft hover; close → red. */
TyCaptionButton              { background: alpha(#FFFFFF, 0); color: var(--ink); border-radius: 0; }
TyCaptionButton:hover        { background: var(--hover-fill); }
TyCaptionButton:active       { background: var(--active-fill); }
TyCaptionButton.close:hover  { background: #C42B1C; color: #FFFFFF; }
TyCaptionButton.close:active { background: #B0271A; color: #FFFFFF; }

TyLabel, TyHtmlLabel, TyLinkLabel, TyShadowLabel, TyGlowLabel, TyDivider, TyCharImage          { color: var(--ink); }
TyLabel:disabled, TyHtmlLabel:disabled, TyLinkLabel:disabled, TyShadowLabel:disabled, TyGlowLabel:disabled, TyDivider:disabled, TyCharImage:disabled { color: var(--ink-dim); }

/* Default button: soft-rounded card, near-invisible hairline, faint 2px shadow, TIGHT
   native padding (6px v / 9px h — never enlarged), normal weight. */
TyButton, TySpeedButton, TyGlyphContainerButton, TyRibbonAppMenu, TyButtonGroup, TyUpDown          { background: var(--card); color: var(--ink); border-color: var(--border); border-width: 1px; border-radius: var(--radius); padding: 6px 9px; font-weight: normal; shadow: 0 1 2 var(--shadow-col); }
TyButton:hover, TySpeedButton:hover, TyGlyphContainerButton:hover, TyRibbonAppMenu:hover, TyButtonGroup:hover, TyUpDown:hover    { background: var(--card-hover); border-color: var(--border-hover); }
TyButton:active, TySpeedButton:active, TyGlyphContainerButton:active, TyRibbonAppMenu:active, TyButtonGroup:active, TyUpDown:active   { background: var(--card-active); color: var(--ink-dim); shadow: 0 0 0 #00000000; }
TyButton:focus, TySpeedButton:focus, TyGlyphContainerButton:focus, TyRibbonAppMenu:focus, TyButtonGroup:focus, TyUpDown:focus    { border-color: var(--accent); outline: 2px var(--accent); outline-offset: 1px; }
TyButton:disabled, TySpeedButton:disabled, TyGlyphContainerButton:disabled,
TyRibbonAppMenu:disabled { background: var(--disabled-bg); color: var(--disabled-ink); border-color: var(--disabled-border); shadow: 0 0 0 #00000000; }

/* Primary: solid accent fill, white ink, same tight padding — the default action.
   Normal weight (Win 11 accent buttons are NOT bold). */
TyButton.primary, TySpeedButton.primary, TyGlyphContainerButton.primary, TyRibbonAppMenu.primary, TyButtonGroup.primary, TyUpDown.primary          { background: var(--accent); color: var(--on-accent); border-color: var(--accent-border); border-width: 1px; border-radius: var(--radius); padding: 6px 9px; font-weight: normal; shadow: 0 1 2 var(--shadow-col); }
TyButton.primary:hover, TySpeedButton.primary:hover, TyGlyphContainerButton.primary:hover,
TyRibbonAppMenu.primary:hover    { background: var(--accent-hover); }
TyButton.primary:active, TySpeedButton.primary:active, TyGlyphContainerButton.primary:active,
TyRibbonAppMenu.primary:active   { background: var(--accent-active); color: var(--on-accent-dim); shadow: 0 0 0 #00000000; }
TyButton.primary:focus, TySpeedButton.primary:focus, TyGlyphContainerButton.primary:focus,
TyRibbonAppMenu.primary:focus    { border-color: var(--accent-border); outline: 2px var(--accent); outline-offset: 1px; }
TyButton.primary:disabled, TySpeedButton.primary:disabled,
TyGlyphContainerButton.primary:disabled, TyRibbonAppMenu.primary:disabled { background: var(--accent-disabled); border-color: var(--accent-disabled); color: var(--on-accent); shadow: 0 0 0 #00000000; }

/* Danger: solid critical-red fill — shaped exactly like .primary (same tight padding, same
   normal weight), only the destructive colour replaces the accent. */
TyButton.danger, TySpeedButton.danger, TyGlyphContainerButton.danger, TyRibbonAppMenu.danger, TyButtonGroup.danger, TyUpDown.danger          { background: var(--danger); color: var(--on-danger); border-color: var(--danger-border); border-width: 1px; border-radius: var(--radius); padding: 6px 9px; font-weight: normal; shadow: 0 1 2 var(--shadow-col); }
TyButton.danger:hover, TySpeedButton.danger:hover, TyGlyphContainerButton.danger:hover,
TyRibbonAppMenu.danger:hover    { background: var(--danger-hover); }
TyButton.danger:active, TySpeedButton.danger:active, TyGlyphContainerButton.danger:active,
TyRibbonAppMenu.danger:active   { background: var(--danger-active); color: var(--on-danger-dim); shadow: 0 0 0 #00000000; }
TyButton.danger:focus, TySpeedButton.danger:focus, TyGlyphContainerButton.danger:focus,
TyRibbonAppMenu.danger:focus    { border-color: var(--danger-border); outline: 2px var(--danger); outline-offset: 1px; }
TyButton.danger:disabled, TySpeedButton.danger:disabled, TyGlyphContainerButton.danger:disabled,
TyRibbonAppMenu.danger:disabled { background: var(--danger-disabled); border-color: var(--danger-disabled); color: var(--on-danger); shadow: 0 0 0 #00000000; }

/* Ghost / subtle: transparent + shadowless until hovered; a light Fluent fill appears. */
TyButton.ghost, TySpeedButton.ghost, TyGlyphContainerButton.ghost, TyRibbonAppMenu.ghost, TyButtonGroup.ghost, TyUpDown.ghost          { background: alpha(#000000, 0); color: var(--ink); border-radius: var(--radius); padding: 6px 9px; font-weight: normal; }
TyButton.ghost:hover, TySpeedButton.ghost:hover, TyGlyphContainerButton.ghost:hover,
TyRibbonAppMenu.ghost:hover    { background: var(--hover-fill); }
TyButton.ghost:active, TySpeedButton.ghost:active, TyGlyphContainerButton.ghost:active,
TyRibbonAppMenu.ghost:active   { background: var(--active-fill); color: var(--ink-dim); }
TyButton.ghost:selected, TySpeedButton.ghost:selected, TyGlyphContainerButton.ghost:selected,
TyRibbonAppMenu.ghost:selected { background: var(--accent-soft); color: var(--accent); }
TyButton.ghost:focus, TySpeedButton.ghost:focus, TyGlyphContainerButton.ghost:focus,
TyRibbonAppMenu.ghost:focus    { outline: 2px var(--accent); outline-offset: 1px; }
TyButton.ghost:disabled, TySpeedButton.ghost:disabled, TyGlyphContainerButton.ghost:disabled,
TyRibbonAppMenu.ghost:disabled { color: var(--disabled-ink); }

/* Fields: white wells, hairline border, soft rounding; accent border + ring on focus. */
TyEdit          { background: var(--field); color: var(--ink); border-color: var(--border); border-width: 1px; border-radius: var(--radius); padding: 5px 8px; }
TyEdit:hover    { border-color: var(--border-hover); }
TyEdit:focus    { border-color: var(--accent); outline: 2px var(--accent); }
TyEdit:disabled { background: var(--field-disabled); color: var(--disabled-ink); }

TyComboBox          { background: var(--field); color: var(--ink); border-color: var(--border); border-width: 1px; border-radius: var(--radius); padding: 5px 8px; }
TyComboBox:hover    { border-color: var(--border-hover); }
TyComboBox:focus    { border-color: var(--accent); outline: 2px var(--accent); }
TyComboBox:disabled { background: var(--field-disabled); color: var(--disabled-ink); }

/* Check box: white well, medium hairline outline (stroked, not beveled), radius 4;
   accent fill + white tick when checked (:active). 'color' inks the tick. */
TyCheckBox          { background: var(--field); color: var(--accent); border-color: var(--border-strong); border-width: 1px; border-radius: var(--radius-sm); padding: 4px; }
TyCheckBox:hover    { border-color: var(--accent); }
TyCheckBox:active   { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
TyCheckBox:focus    { outline: 2px var(--accent); outline-offset: 1px; }
TyCheckBox:disabled { background: var(--check-disabled-bg); color: var(--check-disabled-ink); border-color: var(--check-disabled-border); }

/* Radio: same well/outline as the check box (renderer draws the circle). */
TyRadioButton          { background: var(--field); color: var(--accent); border-color: var(--border-strong); border-width: 1px; border-radius: var(--radius-sm); padding: 4px; }
TyRadioButton:hover    { border-color: var(--accent); }
TyRadioButton:active   { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
TyRadioButton:focus    { outline: 2px var(--accent); outline-offset: 1px; }
TyRadioButton:disabled { background: var(--check-disabled-bg); color: var(--check-disabled-ink); border-color: var(--check-disabled-border); }

/* Progress: a rounded PILL track with a rounded accent fill (Win 11 rounded bar). */
TyProgressBar  { background: var(--track); border-width: 0; border-radius: var(--radius-pill); }
TyProgressFill { background: var(--accent); border-radius: var(--radius-pill); }

/* ── Card + Tag (Ant Design-gap batch 1) ─────────────────────────────────── */

/* Card: a Fluent LAYER — the button's card face and near-invisible hairline, the same faint
   2px shadow, but the softer layer corner and a roomier inset (a card holds content, a button
   holds a word). The header / actions strips are BANDS on this one surface: Win 11 never tints
   them, so each carries nothing but its hairline separator. */
TyCard          { background: var(--card); color: var(--ink); border-color: var(--border); border-width: 1px; border-radius: var(--radius-lg); padding: 12px; shadow: 0 1 2 var(--shadow-col); }
/* Hover firms the hairline only, no face change: the pointer crosses a container constantly,
   and a card that repaints its whole surface on every pass is the noise Win 11 avoids. */
TyCard:hover    { border-color: var(--border-hover); }
TyCard:disabled { background: var(--disabled-bg); color: var(--disabled-ink); border-color: var(--disabled-border); shadow: 0 0 0 #00000000; }

/* Title band: no fill (the card face reads straight through) + the hairline rule beneath it.
   Weight 600 is Fluent's "Body Strong" — a semibold title, never the heavy bold of the classic
   skins. No padding of its own, so the title lines up with the body. */
TyCardHeader  { color: var(--ink); border-color: var(--border); border-width: 1px; font-weight: 600; }
TyCardActions { border-color: var(--border); border-width: 1px; }

/* Tag: a Fluent chip. The neutral fill is the TRANSLUCENT overlay rather than a solid tone, so
   one pill reads on the Mica backdrop and on a card face alike; under it the usual hairline,
   and the progress bar's pill radius — Win 11 chips are pill-ended. No shadow: a chip is inline
   furniture, not a lifted layer. */
TyTag          { background: var(--active-fill); color: var(--ink); border-color: var(--border); border-width: 1px; border-radius: var(--radius-pill); padding: 0px 8px; font-weight: normal; }
/* The two colour variants are the solid InfoBadge material — accent / critical fill with the
   darkened border the solid buttons carry. Shaped exactly like the neutral pill; only the
   colour differs. */
TyTag.accent   { background: var(--accent); color: var(--on-accent); border-color: var(--accent-border); }
TyTag.danger   { background: var(--danger); color: var(--on-danger); border-color: var(--danger-border); }
/* Applied after the variants, so a disabled accent / danger tag greys out with the rest. */
TyTag:disabled { background: var(--disabled-bg); color: var(--disabled-ink); border-color: var(--disabled-border); }

/* The close x mirrors the caption buttons: nothing at rest, a soft overlay chip under the
   pointer. Its ink is deliberately UNSET so the x takes the pill's own ink and stays readable
   on the solid accent / danger fills too. The chip uses the press overlay, not the hover one:
   at a 14px slot this skin's resting hover fill is too faint to read as an affordance. */
TyTagClose       { background: alpha(#FFFFFF, 0); border-radius: var(--radius-sm); }
TyTagClose:hover { background: var(--active-fill); }

/* Badge: the Fluent InfoBadge — a solid accent pill in the button's corner at the full pill
   radius, so a single digit lands on a true circle. Normal weight like every other glyph here
   (Win 11's badge digits are caption text, not bold), which is where this skin parts with the
   bold base pill. No font-size, like every other rule in this skin: a control with no theme
   font-size already falls back to --font-size-base on its own, so stating it here would only
   cost the badge an explicitly-set Font.Size (which outranks the token, but not a rule). */
TyBadge { background: var(--accent); color: var(--on-accent); border-radius: var(--radius-pill); font-weight: normal; padding: 0px 4px; }
