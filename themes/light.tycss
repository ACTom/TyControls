/* TyControls — Light theme */
:root {
  /* ── SEED ── 7 colors + 1 metric */
  --accent: #3B82F6; --surface: #FFFFFF; --on-surface: #1F2937;
  --border: #D1D5DB; --danger: #EF4444; --radius: 6px;
  /* The two STATUS seeds (added for TTyAlert/TTyNotification, 2026-07-17). They are seeds, not
     derivations: no hue-shift of --accent or --danger produces a credible green/amber, and a
     control must never invent a colour. There is deliberately no --info seed — in this vocabulary
     (as in Ant's) "info" IS the brand colour, so --info aliases --accent below. */
  --success: #22C55E; --warning: #F59E0B;

  /* ── MAP: directional darken/lighten the body inlines ── */
  --surface-hover:            darken(--surface, 4%);
  --surface-active:           darken(--surface, 10%);
  --surface-chrome:           darken(--surface, 6%);
  /* The fill of the chrome BARS (tool bar, status bar, scroll track), split out from
     --surface-chrome so a skin can sit them flush on the surface WITHOUT writing a rule for
     those typeKeys. That matters: any rule a skin writes for a typeKey suppresses the whole
     base layer for it (see UserHasTypeKey), so a skin that set only `background` on
     TyStatusBar silently lost its colour/border/font too — an invisible status bar. Retuning
     one token has no such cliff. Defaults to --surface-chrome, so nothing moves by itself. */
  --chrome-bar-bg:            var(--surface-chrome);
  /* 斑马纹的隔行底色。比 chrome 淡得多 —— 它是让长表读起来更顺的辅助,不是分区。 */
  --surface-alt:              darken(--surface, 3%);
  /* 评分星的金色。评分是少数几个有约定俗成颜色的元素,但仍走 token —— 皮肤能改。 */
  --rating-star:              #F59E0B;
  --surface-sunk:             darken(--surface, 8%);
  --surface-track:            darken(--surface, 10%);
  --surface-listitem-hover:   darken(--surface, 5%);
  --surface-tab-rest:         darken(--surface, 5%);
  --surface-tab-hover:        darken(--surface, 2%);
  --surface-toggle-off:       darken(--surface, 18%);
  --surface-toggle-off-hover: darken(--surface, 22%);
  --surface-caption-hover:    darken(--surface, 12%);
  --surface-caption-active:   darken(--surface, 20%);
  --border-hover:             darken(--border, 10%);
  --scroll-handle-hover:      darken(--border, 15%);
  --accent-hover:  lighten(--accent, 8%);   --accent-active: darken(--accent, 8%);
  --danger-hover:  lighten(--danger, 8%);   --danger-active: darken(--danger, 8%);
  --danger-press-close: darken(--danger, 10%);

  /* ── ALIAS: semantic ── */
  --focus-ring:       var(--accent);
  --selection:        alpha(var(--accent), 0.30);
  --muted:            alpha(var(--on-surface), 0.5);
  --overlay-hover:    alpha(var(--on-surface), 0.12);
  --disabled-opacity: 0.5;
  --form-bg:          var(--surface-hover);   /* TyForm bg */
  --titlebar-bg:      var(--surface-chrome);  /* TyTitleBar bg */
  --input-bg:         var(--surface);         /* Edit/Check/Radio/Combo/List/Spin/Memo bg */
  --scroll-handle:    var(--border);          /* resting scroll thumb/handle */
  --input-border-hover: var(--border-hover);  /* neutral inputs hover border */
  /* on-* declared here but WIRED only in the §3 bug-fix commit */
  --on-accent:        on(var(--accent));      /* light -> #FFFFFF (== current literal) */
  --on-danger:        on(var(--danger));      /* light -> #FFFFFF */
  --on-success:       on(var(--success));     /* the status seeds get the same on() pairing */
  --on-warning:       on(var(--warning));     /* amber is light -> on() picks a DARK ink here */
  --info:             var(--accent);          /* "info" is the brand colour, not a seed of its own */
  --on-info:          var(--on-accent);

  /* ── COMPONENT: scalars ── */
  --input-border-width: 1px;
  --radius-sm: 3px; --radius-pill: 8px; --radius-round: 12px; --radius-scroll: 4px;
  --font-size-base: 9px; --font-size-title: 9px;

  /* ── 尺寸令牌(密度尺度第一期)───────────────────────────────────────
     经典密度 = 今天的实际值,一个都不动。现代密度由 density-modern.tycss
     覆盖这些名字 —— 它只碰令牌,不碰规则、也不碰颜色,所以对 15 个皮肤
     一视同仁。

     这里**刻意没有** --space-* 数字尺度:经典侧有 5px 9px / 4px 10px /
     0px 14px 这些历史随手值,强推 4 的倍数会让经典漂移 1px,而
     「经典逐字节不变」正是整轮迁移的守卫。尺度只在现代侧存在。 */

  /* 字号。经典三档全是 9px —— 这种扁平本身就是 Win32 时代的特征,
     字号层级是 Web 时代才有的东西。 */
  --font-size-sm: 9px;

  /* 内边距:按**角色**命名,不按尺度命名(见上)。41 条规则归并成 19 个角色。
     值全部取自今天各规则的字面量。 */
  --pad-none:            0px;
  --pad-tight:           2px;
  --pad-control:         4px;
  --pad-tooltip:         5px 9px;
  --pad-button:          6px;
  --pad-container:       8px;
  --pad-card:            12px;
  --pad-empty:           16px;
  --pad-cell:            0px 6px;
  --pad-chip:            0px 8px;
  --pad-badge:           0px 4px;
  --pad-breadcrumb:      2px 4px;
  --pad-breadcrumb-item: 0px 4px;
  --pad-groupbox:        4px 12px;
  --pad-datetime:        4px 6px;
  --pad-segmented:       4px 10px;
  --pad-alert:           8px 12px;
  --pad-notification:    12px 14px;
  --pad-group-header:    0px 14px;

  /* 控件高与图标槽。值取自各控件今天的 published default:
     DefaultRowHeight=22、Header.Height=22、ItemHeight=24、TyDlgEditH=30、
     TyCheckBoxBox/TyAlertIconSize=16。第 3 期把 Pascal 侧的常量迁过来时用。 */
  --control-height: 30px;
  --row-height:     22px;
  --header-height:  22px;
  --item-height:    24px;
  --icon-size:      16px;

  /* -- size tokens: control geometry (density phase 3) --
     classic value == each control's Pascal constant today; the modern
     density pack overrides these names. Runtime geometry is not in the
     golden, so the guard is value==constant + full suite green. */
  --alert-close-gap: 8px;
  --alert-close-size: 14px;
  --alert-icon-gap: 8px;
  --alert-icon-size: 16px;
  --alert-text-gap: 2px;
  --backstage-back-height: 48px;
  --backstage-icon-size: 18px;
  --backstage-icon-x: 14px;
  --backstage-row-height: 42px;
  --backstage-sidebar-width: 190px;
  --backstage-text-inset: 40px;
  --balloon-arrow-size: 8px;
  --badge-dot-size: 8px;
  --badge-inset: 2px;
  --breadcrumb-separator-gap: 2px;
  --breadcrumb-separator-size: 14px;
  --caption-button-width: 46px;
  --card-actions-height: 44px;
  --card-header-height: 36px;
  --cascader-column-width: 120px;
  --cascader-expand-gap: 4px;
  --cascader-expand-size: 12px;
  --cascader-row-height: 24px;
  --chart-tooltip-gap: 10px;
  --chart-tooltip-swatch: 8px;
  --chart-tooltip-swatch-gap: 5px;
  --checkbox-gap: 6px;
  --checkbox-size: 16px;
  --dialog-edit-width: 320px;
  --dialog-padding: 16px;
  --drop-arrow-width: 18px;
  --empty-action-height: 32px;
  --empty-gap: 8px;
  --empty-image-size: 48px;
  --expander-header-height: 26px;
  --field-button-width: 18px;
  --gallery-arrow-width: 18px;
  --gallery-cell-width: 56px;
  --gallery-glyph-pad: 4px;
  --gallery-grid-cell-height: 44px;
  --glyph-button-gap: 6px;
  --grid-comment-mark-size: 7px;
  --header-control-height: 26px;
  --header-section-width: 100px;
  --listgroup-chevron-size: 14px;
  --listgroup-header-height: 26px;
  --listgroup-icon-gap: 6px;
  --listgroup-icon-size: 16px;
  --listgroup-item-height: 24px;
  --listgroup-item-indent: 16px;
  --listgroup-item-inset: 6px;
  --listview-cell-padding: 3px;
  --listview-check-size: 14px;
  --listview-group-header-height: 22px;
  --listview-hgap: 10px;
  --listview-icon-label-width: 88px;
  --listview-label-height: 16px;
  --listview-large-icon-size: 48px;
  --listview-small-icon-size: 16px;
  --listview-small-label-width: 150px;
  --listview-text-margin: 4px;
  --listview-tile-label-width: 150px;
  --listview-vgap: 8px;
  --menu-arrow-slot: 16px;
  --menu-check-slot: 18px;
  --menu-separator-height: 7px;
  --menu-shortcut-gap: 24px;
  --notification-close-size: 14px;
  --notification-gap: 8px;
  --notification-icon-size: 24px;
  --notification-margin: 16px;
  --notification-stack-gap: 8px;
  --notification-width: 340px;
  --pagination-gap: 4px;
  --pagination-glyph-size: 12px;
  --popover-arrow-size: 8px;
  --popover-offset: 4px;
  --popover-title-gap: 6px;
  --qat-height: 26px;
  --qat-width: 120px;
  --ribbon-appmenu-height: 26px;
  --ribbon-appmenu-width: 64px;
  --ribbon-caption-band-height: 18px;
  --scrollbar-size: 12px;
  --segmented-pad: 2px;
  --steps-connector-gap: 8px;
  --steps-connector-length: 32px;
  --steps-gap: 8px;
  --steps-marker-size: 24px;
  --tab-arrow-band: 16px;
  --tab-close-size: 14px;
  --tab-gap: 6px;
  --tab-margin: 6px;
  --tab-min-width: 48px;
  --tab-padding: 12px;
  --tag-close-size: 14px;
  --tag-gap: 4px;
  --titlebar-padding: 8px;
  --transfer-arrow-margin: 3px;
  --transfer-arrow-size: 12px;
  --transfer-button-gap: 6px;
  --transfer-button-height: 26px;
  --transfer-button-width: 32px;
  --transfer-rail-width: 56px;
  --transfer-title-height: 26px;
  --treeselect-drop-height: 220px;
  --font-weight-normal: 400; --font-weight-bold: 700;
  --on-titlebar: var(--on-surface);   /* ink for controls hosted on the title bar */
}

/* Window/form backdrop — a soft off-white behind the white controls. */
TyForm { background: var(--form-bg); }

TyButton, TySpeedButton, TyGlyphContainerButton, TyRibbonAppMenu, TyButtonGroup, TyUpDown {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: var(--pad-button);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-normal);
}
TyButton:hover, TySpeedButton:hover, TyGlyphContainerButton:hover, TyRibbonAppMenu:hover, TyButtonGroup:hover, TyUpDown:hover    { background: var(--surface-hover); border-color: var(--input-border-hover); }
TyButton:focus, TySpeedButton:focus, TyGlyphContainerButton:focus, TyRibbonAppMenu:focus, TyButtonGroup:focus, TyUpDown:focus    { border-color: var(--accent); outline: 2px var(--focus-ring); }
TyButton:active, TySpeedButton:active, TyGlyphContainerButton:active, TyRibbonAppMenu:active, TyButtonGroup:active, TyUpDown:active   { background: var(--surface-active); }TyButton:disabled, TySpeedButton:disabled, TyGlyphContainerButton:disabled, TyRibbonAppMenu:disabled, TyButtonGroup:disabled, TyUpDown:disabled { opacity: var(--disabled-opacity); }
TyButton.primary, TySpeedButton.primary, TyGlyphContainerButton.primary, TyRibbonAppMenu.primary, TyButtonGroup.primary, TyUpDown.primary  { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }TyButton.primary:hover, TySpeedButton.primary:hover, TyGlyphContainerButton.primary:hover, TyRibbonAppMenu.primary:hover, TyButtonGroup.primary:hover, TyUpDown.primary:hover    { background: var(--accent-hover); }TyButton.primary:active, TySpeedButton.primary:active, TyGlyphContainerButton.primary:active, TyRibbonAppMenu.primary:active, TyButtonGroup.primary:active, TyUpDown.primary:active   { background: var(--accent-active); }
TyButton.danger, TySpeedButton.danger, TyGlyphContainerButton.danger, TyRibbonAppMenu.danger, TyButtonGroup.danger, TyUpDown.danger   { background: var(--danger); color: var(--on-danger); border-color: var(--danger); }TyButton.danger:hover, TySpeedButton.danger:hover, TyGlyphContainerButton.danger:hover, TyRibbonAppMenu.danger:hover, TyButtonGroup.danger:hover, TyUpDown.danger:hover     { background: var(--danger-hover); }TyButton.danger:active, TySpeedButton.danger:active, TyGlyphContainerButton.danger:active, TyRibbonAppMenu.danger:active, TyButtonGroup.danger:active, TyUpDown.danger:active    { background: var(--danger-active); }
/* Ghost (VS Code 风格): 平时透明,仅 hover/active/选中显示底色与边框。透明用 alpha(...,0)
   保持纯色,使现有 hover 背景 alpha 淡入有效;边框透明但保留宽度,避免 hover 尺寸跳动。 */
TyButton.ghost, TySpeedButton.ghost, TyGlyphContainerButton.ghost, TyRibbonAppMenu.ghost, TyButtonGroup.ghost, TyUpDown.ghost {
  background: alpha(var(--surface-hover), 0);
  color: var(--on-surface);
  border-color: alpha(var(--border), 0);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: var(--pad-button);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-normal);
}TyButton.ghost:hover, TySpeedButton.ghost:hover, TyGlyphContainerButton.ghost:hover, TyRibbonAppMenu.ghost:hover, TyButtonGroup.ghost:hover, TyUpDown.ghost:hover    { background: var(--surface-hover); border-color: var(--input-border-hover); }TyButton.ghost:active, TySpeedButton.ghost:active, TyGlyphContainerButton.ghost:active, TyRibbonAppMenu.ghost:active, TyButtonGroup.ghost:active, TyUpDown.ghost:active   { background: var(--surface-active); }TyButton.ghost:selected, TySpeedButton.ghost:selected, TyGlyphContainerButton.ghost:selected, TyRibbonAppMenu.ghost:selected, TyButtonGroup.ghost:selected, TyUpDown.ghost:selected { background: var(--surface-active); border-color: var(--accent); }TyButton.ghost:focus, TySpeedButton.ghost:focus, TyGlyphContainerButton.ghost:focus, TyRibbonAppMenu.ghost:focus, TyButtonGroup.ghost:focus, TyUpDown.ghost:focus    { outline: 2px var(--focus-ring); }TyButton.ghost:disabled, TySpeedButton.ghost:disabled, TyGlyphContainerButton.ghost:disabled, TyRibbonAppMenu.ghost:disabled, TyButtonGroup.ghost:disabled, TyUpDown.ghost:disabled { opacity: var(--disabled-opacity); }

TyLabel, TyHtmlLabel, TyLinkLabel, TyShadowLabel, TyGlowLabel, TyDivider, TyCharImage {
  background: alpha(#FFFFFF, 0);
  color: var(--on-surface);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-normal);
}
TyLabel:disabled, TyHtmlLabel:disabled, TyLinkLabel:disabled, TyShadowLabel:disabled, TyGlowLabel:disabled, TyDivider:disabled, TyCharImage:disabled { opacity: var(--disabled-opacity); }

TyEdit {
  background: var(--input-bg);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: var(--pad-control);
  font-size: var(--font-size-base);
}
TyEdit:hover    { border-color: var(--input-border-hover); }
TyEdit:focus    { border-color: var(--accent); outline: 2px var(--focus-ring); }
TyEdit:disabled { opacity: var(--disabled-opacity); }

TyCheckBox {
  background: var(--input-bg);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius-sm);
  padding: var(--pad-control);
}
TyCheckBox:hover    { border-color: var(--accent); }
TyCheckBox:active   { background: var(--accent); color: var(--on-accent); }
TyCheckBox:focus    { outline: 2px var(--focus-ring); }
TyCheckBox:disabled { opacity: var(--disabled-opacity); }

TyRadioButton {
  background: var(--input-bg);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius-pill);
  padding: var(--pad-control);
}
TyRadioButton:hover    { border-color: var(--accent); }
TyRadioButton:active   { background: var(--accent); color: var(--on-accent); }
TyRadioButton:focus { outline: 2px var(--focus-ring); }
TyRadioButton:disabled { opacity: var(--disabled-opacity); }

/* TyScrollBox (the scrolling WELL, which conventionally sinks where a panel lifts) and
   TyExPanel (a collapsible card) used to render as plain panels because they returned
   'TyPanel'. Same values, three separable names. TTyScrollPanel and TTyPaintPanel are
   deliberately NOT here: they add no chrome of their own and keep inheriting. */
TyPanel, TyScrollBox, TyExPanel, TyChart, TyCalculator, TyBevel, TySizeBox, TyControlBar, TyCoolBar, TyColorGrid, TyShape, TyStarShape, TyArrow, TyImageView, TyImage, TyPreviewBox, TyListGroupPanel {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: var(--pad-container);
}
/* The scrolling containers' VIEWPORT (TTyScrollContent — the windowed child that clips the
   scrolled content inside TTyScrollBox / TTyScrollPanel). Background only, ON PURPOSE: the
   frame belongs to the box around it, and a second frame here would land exactly where the
   content is meant to run under — so this is TyScrollBox's surface, alone, under its own key.
   This rule EXISTING AT ALL is the fix, not its value. TTyScrollContent.Paint fills its
   resolved background and nothing else, guarded by `if tpBackground in S.Present`; no layer
   defined this key, so the guard was always False and the viewport painted NOTHING — leaving
   whatever the widgetset erased the window with. TTyForm.ApplyChromeTheme re-seeds that erase
   colour only for SOLID form backgrounds, so on a gradient-form skin (aero) it stays a stale
   light grey: in dark mode the viewport surfaced as a LIGHT patch lining every scroll well.
   Solid on purpose too: the viewport is a real window compositing over that erase colour, so
   a translucent value here would blend with garbage rather than with the page.
   test.modecoherence sweeps this key in BOTH modes and holds it to an opacity floor
   (cMustPaintKeys) — for a paint-nothing-else control, "absent" IS the bug, and the sweep's
   transparent-skip lenience would otherwise wave it straight through. */
TyScrollContent { background: var(--surface); }
/* The collapsible panel's HEADER BAND — caption + chevron ink, and the band's own hover.
   Only `color` is declared, and it is TyPanel's colour, so the caption and caret draw
   exactly as they did when they read the panel's own style. Background is left out ON
   PURPOSE: the band tint is opt-in in the painter (declare one and the band fills; say
   nothing and the panel's single surface shows through un-reblended, which is what
   happens today). font-size / font-weight are likewise omitted so the caption keeps
   following the control's font, as TyPanel declares neither.
   ':hover' on this key is the new axis — the control has tracked band hover all along
   but had no name to repaint through. */
TyExPanelHeader { color: var(--on-surface); }

TyComboBox {
  background: var(--input-bg);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: var(--pad-control);
  font-size: var(--font-size-base);
}
TyComboBox:hover    { border-color: var(--input-border-hover); }
TyComboBox:focus    { border-color: var(--accent); outline: 2px var(--focus-ring); }
TyComboBox:disabled { opacity: var(--disabled-opacity); }

TyScrollBar {
  background: var(--chrome-bar-bg);
  color: var(--scroll-handle);
  border-radius: var(--radius-scroll);
}
TyScrollBar:hover  { color: var(--scroll-handle-hover); }
TyScrollBar:active { color: var(--accent); }
TyScrollBar:focus  { outline: 2px var(--focus-ring); }
TyScrollBar:disabled { opacity: var(--disabled-opacity); }

TyTitleBar, TyRibbonQuickAccess {
  background: var(--titlebar-bg);
  color: var(--on-surface);
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-bold);
}

TyCaptionButton {
  background: alpha(#FFFFFF, 0);
  color: var(--on-surface);
  border-radius: 0px;
}
TyCaptionButton:hover  { background: var(--surface-caption-hover); }
TyCaptionButton:active { background: var(--surface-caption-active); }
TyCaptionButton.close:hover  { background: var(--danger); color: var(--on-danger); }
TyCaptionButton.close:active { background: var(--danger-press-close); color: var(--on-danger); }
TyCaptionButton.min:hover    { background: var(--surface-caption-hover); }
TyCaptionButton.max:hover    { background: var(--surface-caption-hover); }

/* ── v1.1 controls ─────────────────────────────────────────────────────── */

/* TTyValueListEditor is a PROPERTY GRID that happens to be built on the list box, so it
   gets its own frame + row keys (the other five list-box subclasses keep sharing these
   two — they really are lists of strings). Its remaining parts — TyValueListEditorKey,
   -Value, -Expander, -Divider — are deliberately left undefined; see the note at the end
   of this file. */
TyListBox, TyValueListEditor, TyRibbonGallery {
  background: var(--input-bg);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: var(--pad-tight);
}
TyListBox:hover, TyValueListEditor:hover, TyRibbonGallery:hover   { border-color: var(--input-border-hover); }
TyListBox:focus, TyValueListEditor:focus, TyRibbonGallery:focus   { border-color: var(--accent); outline: 2px var(--focus-ring); }
TyListBox:disabled, TyValueListEditor:disabled, TyRibbonGallery:disabled { opacity: var(--disabled-opacity); }

TyListItem, TyValueListEditorRow {
  background: alpha(#000000, 0);
  color: var(--on-surface);
  border-radius: var(--radius);
  padding: var(--pad-control);
}
TyListItem:hover, TyValueListEditorRow:hover  { background: var(--surface-listitem-hover); }
TyListItem:active, TyValueListEditorRow:active { background: var(--accent); color: var(--on-accent); border-radius: 0; }

TyProgressBar {
  background: var(--surface-sunk);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
}
TyProgressBar:disabled { opacity: var(--disabled-opacity); }

TyProgressFill {
  background: var(--accent);
  border-radius: var(--radius);
}

/* --- Instrument family -----------------------------------------------------
   Fourteen unrelated controls used to HARDCODE 'TyGauge' as their own type key, so a
   skin could not tell a star rating from an analogue clock. Each now owns its key and
   they share ONE rule block as a selector list: identical resolved values today, a
   separable hook from today on. Override just TyRating (or just TyRatingStar) in a skin
   and nothing else in the family moves.
   The four selectors after TyHSColorPicker are SUB-PARTS that read the face, not the
   fill: TyMeterTick + TyAnalogClockHand take `color`, TyGearDialTeeth takes `background`.
   They are resolved with an empty state set, which is why they are absent from the
   :disabled rule below. TyColorArea is the colour dialog's HSV square / hue bar — the
   key existed in code since v1 but no theme had ever defined it. */
TyGauge, TyMeter, TyLevelMeter, TyDial, TyGearDial, TyAnalogClock, TyCircularProgress,
TyActivityIndicator, TyActivityBar, TyGearActivityIndicator, TySparkline, TyRating,
TyLColorPicker, TyHSColorPicker, TyMeterTick, TyAnalogClockHand, TyGearDialTeeth, TyColorArea {
  background: var(--surface-sunk);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
}
TyGauge:disabled, TyMeter:disabled, TyLevelMeter:disabled, TyDial:disabled, TyGearDial:disabled,
TyAnalogClock:disabled, TyCircularProgress:disabled, TyActivityIndicator:disabled,
TyActivityBar:disabled, TyGearActivityIndicator:disabled, TySparkline:disabled,
TyRating:disabled, TyLColorPicker:disabled, TyHSColorPicker:disabled { opacity: var(--disabled-opacity); }

/* The lit part of each instrument. Same story: one accent rule, thirteen reachable
   names. TyRatingStar takes no :hover rule on purpose — with none it falls back to this
   block, exactly as the stars painted before; a skin that WANTS a hover tint adds
   'TyRatingStar:hover' and that is the newly-opened axis. */
TyGaugeFill, TyMeterNeedle, TyLevelMeterFill, TyLevelMeterPeak, TyDialPointer,
TyGearDialPointer, TyAnalogClockSecondHand, TyCircularProgressFill, TyActivityIndicatorFill,
TyActivityBarFill, TyGearActivityIndicatorFill, TySparklineFill, TySparklineDot, TyRatingStar {
  background: var(--accent);
  border-radius: var(--radius);
}

/* Themed tooltip surface (TTyHintWindow — replaces the native LCL hint). */
TyHint {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius-sm);
  padding: var(--pad-tooltip);
  font-size: var(--font-size-base);
}

/* Ribbon (Phase-3): the command band surface + the labelled group box. */
TyRibbon, TyRibbonBackstage {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: 0;
  font-size: var(--font-size-base);
}
TyRibbonGroup {
  background: alpha(#FFFFFF, 0);
  color: var(--muted);
  border-color: var(--border);
  border-width: 1px;
  font-size: var(--font-size-base);
}


TyToggleSwitch {
  background: var(--surface-toggle-off);
  color: var(--on-surface);
  border-radius: var(--radius-round);
}
TyToggleSwitch:hover    { background: var(--surface-toggle-off-hover); }
TyToggleSwitch:active   { background: var(--accent); }
TyToggleSwitch:focus { outline: 2px var(--focus-ring); }
TyToggleSwitch:disabled { opacity: var(--disabled-opacity); }

TyTrackBar {
  background: var(--surface-track);
  /* The ShowValue readout's ink. Without it TextColor resolves to the unset default
     $00000000 -- alpha 0 -- so ShowValue reserved the strip, shortened the track and then
     painted the number in a fully transparent colour. It has never been visible in any
     theme, which is why the trackbar example hand-rolled a readout out of a separate
     label instead of using the one the control already has. */
  color: var(--on-surface);
  border-radius: var(--radius-sm);
  padding: var(--pad-none);
}
TyTrackBar:focus    { outline: 2px var(--focus-ring); }
TyTrackBar:disabled { opacity: var(--disabled-opacity); }

TyTrackThumb {
  background: var(--accent);
  border-radius: var(--radius-pill);
}
TyTrackThumb:hover  { background: var(--accent-hover); }
TyTrackThumb:active { background: var(--accent-active); }

/* Hyperlink ink for TTyLinkLabel. Its own key rather than a borrowed accent fill: a theme
   that restyles gauges must not repaint every link, and a theme that wants a different link
   colour must not have to repaint gauges. */
TyLinkLabelLink { color: var(--accent); }


/* TTyToolGroupPanel is a ribbon-style command cluster, not a form group box; it gets its
   own name so a skin can flatten the cluster without flattening every group box. Caption
   PLACEMENT stays TTyGroupBox's top band — this key changes ink and chrome, not layout. */
TyGroupBox, TyToolGroupPanel {
  padding: var(--pad-groupbox);
  background: alpha(#FFFFFF, 0);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
}

/* ── v1.2 controls ─────────────────────────────────────────────────────── */

TyTabControl, TyTabSet {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
}
TyTabControl:hover, TyTabSet:hover  { border-color: var(--input-border-hover); }
TyTabControl:focus, TyTabSet:focus  { border-color: var(--accent); outline: 2px var(--focus-ring); }
TyTabControl:disabled, TyTabSet:disabled { opacity: var(--disabled-opacity); }

/* TTyPageControl mirrors TyTabControl (the tab container); TyTabSheet is the page
   body inside the frame — opaque surface fill only (no border) so it never leaves
   transparent pixels for the OS window backdrop to show through. */
TyPageControl {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
}
TyPageControl:hover  { border-color: var(--input-border-hover); }
TyPageControl:focus  { border-color: var(--accent); outline: 2px var(--focus-ring); }
TyPageControl:disabled { opacity: var(--disabled-opacity); }
TyTabSheet {
  background: var(--surface);
}

TyTab {
  background: var(--surface-tab-rest);
  color: var(--on-surface);
  padding: var(--pad-control);
  border-radius: var(--radius) var(--radius) 0 0;
}
TyTab:hover  { background: var(--surface-tab-hover); }
TyTab:active { background: var(--surface); color: var(--accent); }

/* ── v1.9 controls ─────────────────────────────────────────────────────── */

TySpinEdit {
  background: var(--input-bg);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: var(--pad-control);
  font-size: var(--font-size-base);
}
TySpinEdit:hover    { border-color: var(--input-border-hover); }
TySpinEdit:focus    { border-color: var(--accent); outline: 2px var(--focus-ring); }
TySpinEdit:disabled { opacity: var(--disabled-opacity); }

TyMemo {
  background: var(--input-bg);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: var(--pad-control);
  font-size: var(--font-size-base);
}
TyMemo:hover    { border-color: var(--input-border-hover); }
TyMemo:focus    { border-color: var(--accent); outline: 2px var(--focus-ring); }
TyMemo:disabled { opacity: var(--disabled-opacity); }

TyTextSelection { background: var(--selection); }
TyTextHint      { color: var(--muted); }
TyTabClose      { background: var(--overlay-hover); border-radius: var(--radius); }

TyScrollThumb { background: var(--scroll-handle); border-radius: var(--radius-scroll); }
TyScrollThumb:hover  { background: var(--scroll-handle-hover); }
TyScrollThumb:active { background: var(--accent); }
TyToggleKnob  { background: #FFFFFF; border-radius: var(--radius-round); }

/* 数字角标 (TTyButton badge): 默认 accent 蓝胶囊;padding 上下0、左右4 留横向呼吸。 */
TyBadge {
  background: var(--accent);
  color: var(--on-accent);
  border-radius: var(--radius-round);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-bold);
  padding: var(--pad-badge);
}

/* ── Menu system ───────────────────────────────────────────────────────── */

/* The top application-menu bar (TTyMenuBar surface). */
TyMenuBar {
  background: alpha(#FFFFFF, 0);
  color: var(--on-surface);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-normal);
  padding: var(--pad-tight);
}

/* The dropdown/context popup surface (TTyMenuView, the rendered popup body).
   TyMenuPopup mirrors it for the popup-host selector named in the spec. */
TyMenuView {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: var(--pad-control);
}
TyMenuPopup {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: var(--pad-control);
}

/* A single menu row / bar cell. The base border-color is the separator-line ink. */
TyMenuItem {
  background: alpha(#FFFFFF, 0);
  color: var(--on-surface);
  border-color: var(--border);
  border-radius: var(--radius-sm);
  padding: var(--pad-control);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-normal);
}
TyMenuItem:hover    { background: var(--surface-hover); }
TyMenuItem:active   { background: var(--accent); color: var(--on-accent); }
TyMenuItem:disabled { color: var(--muted); }

/* ── Lightweight trio ──────────────────────────────────────────────────── */

TySplitter {
  background: none;
  color: var(--muted);
}
TySplitter:hover {
  color: var(--accent);
}

TyStatusBar {
  background: var(--chrome-bar-bg);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-normal);
}

/* The separator needs BOTH declarations from this block: `border-color` draws its rule and
   `background` is what keeps it seamless with the bar behind it. Sharing the block is what
   makes that automatic; owning the name is what lets a skin dot/fade/hide just the rule. */
TyToolBar, TyToolSeparator {
  background: var(--chrome-bar-bg);
  border-color: var(--border);
  border-width: var(--input-border-width);
}

/* ── Calendar + DateTimePicker ─────────────────────────────────────────── */

TyCalendar { background: var(--input-bg); color: var(--on-surface); border-color: var(--border); border-width: var(--input-border-width); border-radius: var(--radius); padding: var(--pad-button); font-size: var(--font-size-base); }
TyCalendarTitle { color: var(--on-surface); font-weight: var(--font-weight-bold); font-size: var(--font-size-title); }
TyCalendarTitle:hover { color: var(--accent); }
TyCalendarWeekday { color: var(--muted); font-size: var(--font-size-base); }
TyCalendarCell { background: none; color: var(--on-surface); border-radius: var(--radius-sm); }
TyCalendarCell:hover { background: var(--surface-hover); }
TyCalendarCell:selected { background: var(--accent); color: var(--on-accent); }
TyCalendarCell:disabled { color: var(--muted); }
TyDateTimePicker { background: var(--input-bg); color: var(--on-surface); border-color: var(--border); border-width: var(--input-border-width); border-radius: var(--radius); padding: var(--pad-datetime); font-size: var(--font-size-base); }
TyDateTimePicker:hover { border-color: var(--input-border-hover); }
TyDateTimePicker:focus { border-color: var(--accent); outline: 2px var(--focus-ring); }
TyDateTimePicker:disabled { opacity: var(--disabled-opacity); }
TyDateTimeButton { background: var(--surface-chrome); color: var(--on-surface); }
TyDateTimeButton:hover { background: var(--surface-hover); color: var(--accent); }

/* ── TreeView + ListView ───────────────────────────────────────────────── */
/* TTyListView used to wear the tree's clothes entirely — frame, rows, header, checkbox —
   and worse, its column-header band and its collapsible GROUP band resolved the SAME
   'TyTreeHeader' literal, so the two could never be styled apart. Both now have names
   (TyListViewHeader / TyListViewGroupHeader) and share this one rule, so today they still
   look the same and a skin can finally separate them.
   TyListViewLine and TyListViewMarquee are deliberately left undefined; see the note at
   the end of this file. */

TyTreeView, TyListView { background: var(--input-bg); color: var(--on-surface); border-color: var(--border); border-width: var(--input-border-width); border-radius: var(--radius); padding: var(--pad-tight); font-size: var(--font-size-base); }
TyTreeNode, TyListViewItem { background: none; color: var(--on-surface); }
TyTreeNode:hover, TyListViewItem:hover { background: var(--surface-hover); }
TyTreeNode:selected, TyListViewItem:selected { background: var(--accent); color: var(--on-accent); }
TyTreeNode:disabled, TyListViewItem:disabled { color: var(--muted); }
TyTreeHeader, TyListViewHeader, TyListViewGroupHeader, TyHeaderControl { background: var(--surface-chrome); border-color: var(--border); border-width: var(--input-border-width); color: var(--on-surface); font-size: var(--font-size-base); font-weight: var(--font-weight-bold); }
TyTreeHeaderSection, TyListViewHeaderSection { background: none; color: var(--on-surface); border-color: var(--border); }
TyTreeHeaderSection:hover, TyListViewHeaderSection:hover { background: var(--surface-hover); }
TyTreeHeaderSection:selected, TyListViewHeaderSection:selected { background: var(--surface-active); }

/* --- 数据网格 TTyGrid ------------------------------------------------------
   基层给全套键,新皮肤即使一条网格规则都不写也能正常显示(基层垫在每个主题之下)。
   网格自成一套 typeKey,不借用树/列表的键 —— 借来的键在外观主题层够不着。 */
TyGrid { background: var(--surface); color: var(--on-surface); border-color: var(--border); border-width: var(--input-border-width); border-radius: var(--radius-sm); font-size: var(--font-size-base); }
/* 正文单元格。resting 透明,让网格表面透出来;选中/悬停才上色。 */
TyGridCell { background: none; color: var(--on-surface); padding: var(--pad-cell); }
TyGridCell:hover    { background: var(--surface-hover); }
TyGridCell:selected { background: var(--accent); color: var(--on-accent); }
/* 失焦时的选区(HideSelectionWhenInactive)。给它**自己的键**,不写成
   TyGridCell:selected:disabled —— 语法每个选择器只认一个 :state,
   链式伪状态解析不了(而且借别的键会让外观层够不着,见 TyGridActiveCell)。 */
TyGridCellSelectedInactive { background: alpha(var(--accent), 0.35); color: var(--on-surface); }
/* 焦点格(光标所在)。整行选中模式下,不区分就看不出光标在哪一格。 */
TyGridActiveCell { background: var(--surface-active); color: var(--on-surface); }
/* 选区盖在"用户显式指定了底色"的格上时用这一层(逐格色/行色/条件着色)。
   不透明的选区色会把用户自己标的颜色整块抹掉,而光标总落在刚上色的那一格上。 */
TyGridCellMarked { background: alpha(--accent, 0.42); }
/* 选区外框 + 填充柄。外框给"这块是选中的"一条边界线索(底色只给面);
   柄画在右下角,拖它把选区的值往下铺。
   color 是**柄的描边色** —— 柄与选区底色同为 accent,不描边就等于没画。 */
TyGridSelectionFrame { border-color: var(--accent); border-width: 1px; background: var(--accent); color: var(--surface); }
/* 斑马纹。自己的 typeKey 而不是 TyGridCell:alternate:加伪类要动共享的状态枚举与
   CSS 解析器,会波及每一个控件;而网格的各部件本来就各有各的键。 */
TyGridCellAlt { background: var(--surface-alt); }
/* 冻结区(固定行列)与行头槽:比正文略重,读者一眼能分出"这块不滚动"。 */
TyGridFixed     { background: var(--surface-chrome); color: var(--on-surface); border-color: var(--border); }
TyGridIndicator { background: var(--surface-chrome); color: var(--muted); border-color: var(--border); }
/* 列头带 —— 与树表头同族的观感,但用自己的键。 */
TyGridHeader        { background: var(--surface-chrome); color: var(--on-surface); border-color: var(--border); border-width: var(--input-border-width); font-size: var(--font-size-base); font-weight: var(--font-weight-bold); }
TyGridHeaderSection { background: none; color: var(--on-surface); border-color: var(--border); }
TyGridHeaderSection:hover    { background: var(--surface-hover); }
TyGridHeaderSection:selected { background: var(--surface-active); }
/* 按下态("列头按下去"的观感)。这条规则以前不存在,于是按下的列头解析回 base 的
   `background: none` —— 与静止态一模一样,看不出被按下。与其发布一个控件不照办的标志,
   不如先把缝补上;这条规则补的就是那个缝,控件侧的 goHeaderPushedLook 随后接上。
   取值走 --surface-active(darken(--surface,10%))—— 本库"按下"一律用它
   (见 TyButton:active),不新造硬编码值。它比列头带自己的 --surface-chrome
   (darken 6%)更深,所以按下的那一段在带子上读得出来。
   只写在**基层**这一份:--surface-active 是派生式,各模式的 seed 自己会换,dark 下无需再写一条。
   与 :selected 同值是有意的:两者都是"这一段正被使用",而真正的差别是相对 base
   的 `none` —— 按下去现在有底色了。tests/test.themes 的 golden 第 2 号状态槽
   (STATES[2] = [tysActive])把这条钉住。 */
TyGridHeaderSection:active   { background: var(--surface-active); }
/* 分组表头带(横跨若干列的上层标题)。自己的键 —— 与叶子列头分开配才有意义。 */
TyGridHeaderGroup { background: var(--surface-active); color: var(--on-surface); border-color: var(--border); }
/* 内嵌筛选行。它是"能打字的地方",所以底色跟表面走、边框跟输入框走 ——
   与列头带(chrome 色)刻意区分开,否则用户看不出它可以输入。 */
TyGridFilterRow { background: var(--surface); color: var(--on-surface); border-color: var(--border); border-width: var(--input-border-width); font-size: var(--font-size-base); }
/* Group band (TTyStringGrid grouping) and summary/footer band. Both keys have been
   resolved by the code since grouping landed, but NO theme ever defined them, so they
   fell through to an empty style: no band fill at all, and the ink borrowed the grid
   frame's colour. These two rules SAY that out loud instead of leaving it to a silent
   fallback, and they say it in tokens so a skin can change it.
   `background: none` is the current appearance, deliberately: giving either band the
   conventional chrome tint would be an appearance change, and this pass is a pure
   themability refactor. A skin wanting the tint writes `background: var(--surface-chrome)`.
   Font is left undeclared on purpose (same as TyGridCell) so the bands keep following the
   grid's own font; both keys DO read font-name/-size/-weight if a skin declares them.
   TyGridSummaryRow deliberately has no border-color: RenderFooter never reads one, so a
   declaration here would be dead. A footer hairline needs a code change first. */
TyGridGroupRow   { background: none; color: var(--on-surface); }
TyGridSummaryRow { background: none; color: var(--on-surface); }
/* 格线与选区。格线单独成键,皮肤想去掉格子只需把它设成透明。 */
TyGridLine      { background: var(--border); }
/* 单元格图形。各自成键,不借复选框/进度条的键 —— 借来的键在外观层够不着,
   而且改它会波及那些控件。状态只由单元格自身决定,不掺网格的瞬时状态。 */
TyGridCheckBox           { background: var(--input-bg); border-color: var(--border); border-width: var(--input-border-width); border-radius: var(--radius-sm); color: var(--on-surface); }
TyGridCheckBox:selected  { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
TyGridHyperlink          { color: var(--accent); }
TyGridCommentMark        { color: var(--warning); }
TyGridProgress           { background: var(--surface-chrome); border-radius: var(--radius-sm); }
TyGridProgressFill       { background: var(--accent); }
TyGridRating             { color: var(--rating-star); }
TyGridRatingEmpty        { color: var(--border); }
/* 按钮单元格。三态用自己的键 —— 借 TyButton 的键会让"改网格里的按钮"波及全库按钮。 */
TyGridButton          { background: var(--surface-chrome); color: var(--on-surface); border-color: var(--border); border-width: var(--input-border-width); border-radius: var(--radius-sm); }
TyGridButton:hover    { background: var(--surface-hover); }
TyGridButton:active   { background: var(--surface-active); }
TyGridSelection { background: var(--selection); border-color: var(--accent); }
TyTreeCheckBox, TyListViewCheckBox { background: var(--input-bg); color: var(--on-surface); border-color: var(--border); border-width: var(--input-border-width); border-radius: var(--radius-sm); }
TyTreeCheckBox:active, TyListViewCheckBox:active   { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
TyTreeCheckBox:selected, TyListViewCheckBox:selected { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
TyTreeCheckBox:disabled, TyListViewCheckBox:disabled { color: var(--muted); }

/* ── Card + Tag (Ant Design-gap batch 1) ───────────────────────────────── */

/* One themed surface for the whole card; the header/actions strips are bands drawn
   on it, so they carry only their separator (border-*) and the title's ink. A flat,
   modern card: hairline border, no header band — the separator alone splits it. */
TyCard {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: var(--pad-card);
}
TyCard:hover { border-color: var(--border-hover); }
TyCard:disabled { opacity: var(--disabled-opacity); }
/* No background => a transparent title band over the card's own surface. */
TyCardHeader {
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-bold);
}
TyCardActions { border-color: var(--border); border-width: var(--input-border-width); }

/* Neutral tag = a faint on-surface wash; the variants are StyleClasses, and these two
   land on seeds the palette already has (a 'success'/'warning' tag would need a new
   seed colour + its on() pairing first). */
TyTag {
  background: var(--overlay-hover);
  color: var(--on-surface);
  border-radius: var(--radius-round);
  font-size: var(--font-size-base);
  padding: var(--pad-chip);
}
TyTag.accent { background: var(--accent); color: var(--on-accent); }
TyTag.danger { background: var(--danger); color: var(--on-danger); }
TyTag:disabled { opacity: var(--disabled-opacity); }

TyTagClose       { color: var(--muted); }
TyTagClose:hover { background: var(--overlay-hover); color: var(--on-surface); border-radius: var(--radius-sm); }

/* ── Alert + Notification + Empty + Segmented (Ant Design-gap batch 1) ──── */

/* The inline alert bar. The four variant names are a HARD contract: TTyAlert.AlertType maps
   onto them and draws their icons. A Bootstrap-style tinted banner (pale wash, mid-tint border,
   deep semantic ink) rather than AntD's coloured-icon/neutral-text look — the icon shares the
   bar's `color`, so one ink has to serve both. error rides the EXISTING --danger seed; info is
   --accent (info IS the brand colour here); only success/warning needed new seeds. */
TyAlert {
  background: var(--surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  color: var(--on-surface);
  font-size: var(--font-size-base);
  padding: var(--pad-alert);
}
TyAlert.info    { background: alpha(var(--accent), 0.10);  border-color: alpha(var(--accent), 0.35);  color: var(--accent); }
TyAlert.success { background: alpha(var(--success), 0.10); border-color: alpha(var(--success), 0.35); color: var(--success); }
TyAlert.warning { background: alpha(var(--warning), 0.10); border-color: alpha(var(--warning), 0.35); color: var(--warning); }
TyAlert.error   { background: alpha(var(--danger), 0.10);  border-color: alpha(var(--danger), 0.35);  color: var(--danger); }
TyAlert:disabled { opacity: var(--disabled-opacity); }

TyAlertClose       { color: var(--muted); }
TyAlertClose:hover { background: var(--overlay-hover); color: var(--on-surface); border-radius: var(--radius-sm); }

/* The corner toast. Shaped like TyCard (its nearest kin: a titled surface) so the two agree.
   The variant's `color` is the MARK's ink; the card's own `color` inks title + message. */
TyNotification {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: var(--pad-notification);
  font-size: var(--font-size-base);
}
TyNotification:hover   { border-color: var(--border-hover); }
TyNotification.info    { color: var(--accent); }
TyNotification.success { color: var(--success); }
TyNotification.warning { color: var(--warning); }
TyNotification.error   { color: var(--danger); }

TyNotificationClose       { color: var(--muted); }
TyNotificationClose:hover { background: var(--overlay-hover); color: var(--on-surface); border-radius: var(--radius-sm); }

/* The empty-state placeholder: transparent, because it lies ON the empty list's own surface. */
TyEmpty {
  background: alpha(#FFFFFF, 0);
  color: var(--muted);
  font-size: var(--font-size-base);
  padding: var(--pad-empty);
}
TyEmpty:disabled { opacity: var(--disabled-opacity); }
/* The picture gets its own ink: it must sit far lighter than the message, and one rule
   cannot carry two inks. */
TyEmptyImage { color: var(--border); }

/* The segmented control: a groove holding a lifted thumb. The item radius is deliberately
   SMALLER than the track's, which is what reads as "chip sitting in a slot". */
TySegmented {
  background: var(--overlay-hover);
  color: var(--on-surface);
  border-radius: var(--radius);
  font-size: var(--font-size-base);
}
TySegmented:focus    { outline: 2px var(--focus-ring); }
TySegmented:disabled { opacity: var(--disabled-opacity); }

TySegmentedItem          { color: var(--muted); border-radius: var(--radius-sm);
                           padding: var(--pad-segmented); font-size: var(--font-size-base); }
TySegmentedItem:hover    { background: var(--overlay-hover); color: var(--on-surface); }
TySegmentedItem:selected { background: var(--surface); color: var(--on-surface); }
TySegmentedItem:disabled { color: var(--muted); }

/* ── Pagination + Steps + Breadcrumb + Transfer + TreeSelect + Cascader + Popover ─────── */
/* (Ant Design-gap batches 2 & 3. Each control paints NOTHING without its surface key, so
   these live here in the base: every theme inherits them and can then restyle any of them.) */

/* Pagination: a transparent strip of cells — the page numbers are the chrome, not a bar. */
TyPagination         { background: alpha(#FFFFFF, 0); color: var(--on-surface); font-size: var(--font-size-base); }
TyPagination:disabled { opacity: var(--disabled-opacity); }
TyPaginationItem          { background: alpha(#FFFFFF, 0); color: var(--on-surface);
                            border-color: var(--border); border-width: var(--input-border-width);
                            border-radius: var(--radius-sm); font-size: var(--font-size-base); padding: var(--pad-cell); }
TyPaginationItem:hover    { border-color: var(--accent); color: var(--accent); }
TyPaginationItem:selected { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
TyPaginationItem:disabled { color: var(--muted); border-color: var(--border); }

/* Steps: markers on a rail. The done/current/waiting reading is carried by the item states. */
TySteps         { background: alpha(#FFFFFF, 0); color: var(--on-surface); font-size: var(--font-size-base); }
TySteps:disabled { opacity: var(--disabled-opacity); }
/* The step's status IS its state (TyStepStates): done => :normal, current => :selected,
   waiting => :disabled. So the RESTING rule is the DONE look — an accent ring with an accent
   check — not a neutral one. Getting that backwards (a muted resting rule) makes done and
   waiting identical but for the glyph, which is the whole information the rail exists to carry. */
TyStepsItem          { background: var(--surface); color: var(--accent);
                       border-color: var(--accent); border-width: var(--input-border-width);
                       border-radius: var(--radius-round); font-size: var(--font-size-base); }
TyStepsItem:selected { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
TyStepsItem:hover    { border-color: var(--accent-hover); }
TyStepsItem:disabled { background: var(--surface-track); color: var(--muted); border-color: var(--border); }
/* The connector is a plain filled line: it reads ONLY `background` and draws no text, so it
   deliberately declares no `color` — a colour here would be dead, and (since it would have to
   match the fill to be right) the lint would flag the pair as low-contrast text.
   It takes the states of the step it LEADS TO, so these three rules are what make the trail
   light up exactly as far as you have walked. */
TyStepsConnector          { background: var(--accent); }   /* into a done step: already walked */
TyStepsConnector:selected { background: var(--accent); }   /* into the current step */
TyStepsConnector:disabled { background: var(--border); }   /* not walked yet */

/* Breadcrumb: a transparent trail; the mark takes the BAR's ink (it has no key of its own). */
TyBreadcrumb         { background: alpha(#FFFFFF, 0); color: var(--muted); font-size: var(--font-size-base); padding: var(--pad-breadcrumb); }
TyBreadcrumb:disabled { opacity: var(--disabled-opacity); }
TyBreadcrumbItem          { color: var(--accent); font-size: var(--font-size-base); padding: var(--pad-breadcrumb-item); }
TyBreadcrumbItem:hover    { color: var(--accent-hover); }
/* The last crumb IS the current location: not a link, so it reads as plain ink. */
TyBreadcrumbItem:selected { color: var(--on-surface); }
TyBreadcrumbItem:disabled { color: var(--muted); }

/* Transfer: a frame around two list panes and the move rail. The panes/arrows reuse
   TyListBox / TyButton, which every theme already dresses. */
TyTransfer {
  background: alpha(#FFFFFF, 0);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  font-size: var(--font-size-base);
  padding: var(--pad-none);
}
TyTransfer:disabled { opacity: var(--disabled-opacity); }
TyTransferTitle { background: var(--surface-chrome); color: var(--on-surface);
                  border-color: var(--border); border-width: var(--input-border-width);
                  font-size: var(--font-size-title); font-weight: var(--font-weight-bold); padding: var(--pad-chip); }

/* TTyTreeSelect deliberately has NO key of its own: GetStyleTypeKey returns 'TyComboBox',
   because it IS a combo field — one every theme already dresses, with no key a skin could
   forget. Its popup is a real TyTreeView and is themed by that key. So there is nothing to
   declare here; a `TyTreeSelect { … }` rule would be dead CSS that never resolves. Same
   reasoning as TTyTransfer's move arrows keeping TTyButton's key. */

/* Cascader: the field + its multi-column panel. */
TyCascader {
  background: var(--input-bg);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: var(--pad-control);
  font-size: var(--font-size-base);
}
TyCascader:hover    { border-color: var(--input-border-hover); }
TyCascader:focus    { border-color: var(--accent); outline: 2px var(--focus-ring); }
TyCascader:disabled { opacity: var(--disabled-opacity); }
TyCascaderPanel { background: var(--surface); color: var(--on-surface);
                  border-color: var(--border); border-width: var(--input-border-width);
                  border-radius: var(--radius); }
TyCascaderItem          { background: alpha(#FFFFFF, 0); color: var(--on-surface);
                          font-size: var(--font-size-base); padding: var(--pad-chip); }
TyCascaderItem:hover    { background: var(--surface-listitem-hover); }
TyCascaderItem:selected { background: var(--accent); color: var(--on-accent); }
TyCascaderItem:disabled { color: var(--muted); }

/* Popover: a floating surface that HOSTS controls (that is the gap it fills — Hint/BalloonHint
   can only carry text). The arrow is cut from this same surface, so it needs no key. */
TyPopover {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: var(--pad-container);
  font-size: var(--font-size-base);
}
TyPopoverTitle { color: var(--on-surface); font-size: var(--font-size-title);
                 font-weight: var(--font-weight-bold); }

/* Chart: the chart's own chrome resolves TyPanel; the hover tooltip and the eight series
   slots are the keys it owns. The tooltip reads exactly like TyHint because that is what it
   is — a hint — only painted inside the chart instead of in an OS window. The chart
   paints NO box without this key (no background = nothing to draw on), so it lives here in
   the base for every theme to inherit and then restyle. A skin wanting the box to float can
   add `shadow:` — the control honours it; the base layer stays flat like the rest of light. */
TyChartTooltip {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius-sm);
  padding: var(--pad-tooltip);
  font-size: var(--font-size-base);
}

/* The series palette. A series with no explicit Color rides slot (index mod 8), and each slot
   is a KEY so a skin can retint the data itself — previously these eight hues were a const
   array in the control and no theme could reach them. The values are the Tableau-10 hues the
   code carried, so the base layer draws exactly what it always drew; a skin overrides only the
   slots it cares about. Pie slices use the same slots. `background` is the ink (a series is a
   filled shape); the control keeps its own const as a last-resort fallback. */
TyChartSeries1 { background: #4E79A7; }   /* blue   */
TyChartSeries2 { background: #F28E2B; }   /* orange */
TyChartSeries3 { background: #E15759; }   /* red    */
TyChartSeries4 { background: #76B7B2; }   /* teal   */
TyChartSeries5 { background: #59A14F; }   /* green  */
TyChartSeries6 { background: #EDC948; }   /* yellow */
TyChartSeries7 { background: #B07AA1; }   /* purple */
TyChartSeries8 { background: #FF9DA7; }   /* pink   */

/* ── ListGroupPanel (navigation accordion; own keys, not the tree column header's) ────── */
/* A modern sider: group rows carry NO fill (just muted ink + a right chevron; the OPEN group
   turns accent), and a selected item is a SOFT, INSET, ROUNDED pill — never the old full-bleed
   saturated bar. TTyListGroupPanel insets and rounds the pill in code; the colour/radius here.
   These are their OWN keys so a theme can restyle the sider without touching TreeView/ListView
   column headers, which is what TyTreeHeaderSection (the borrowed key) would have wrecked. */
TyListGroupHeader          { color: var(--muted); font-size: var(--font-size-base); font-weight: var(--font-weight-bold); padding: var(--pad-group-header); }
TyListGroupHeader:hover    { color: var(--on-surface); }
TyListGroupHeader:selected { color: var(--accent); }   /* the group is OPEN */
TyListGroupItem          { color: var(--on-surface); border-radius: var(--radius); font-size: var(--font-size-base); padding: var(--pad-group-header); }
TyListGroupItem:hover    { background: var(--surface-hover); }
TyListGroupItem:active   { background: var(--selection); color: var(--accent); }   /* selected: soft accent pill */
TyListGroupItem:disabled { color: var(--muted); }

/* ── Keys the CODE resolves that this file deliberately does NOT define ─────────────────
   Not drift — each of these is an OPT-IN hook whose painter has an explicit fallback, and
   in every case the fallback is STATE-DEPENDENT, so declaring a fixed value here would
   move pixels rather than preserve them. A skin may declare any of them; the base layer
   stays silent so the fallback keeps winning by default.

     TyListViewLine        background -> else the list view frame's border-color
     TyListViewMarquee     background -> else TyListViewItem:selected's background
     TyValueListEditorKey       color -> else the ROW's colour for the row's current state
     TyValueListEditorValue     color -> else the same
     TyValueListEditorExpander  color -> else the same
     TyValueListEditorDivider   background -> else the row's colour at alpha 0x28

   The row-derived four are the sharp edge: on a selected row the fallback ink is
   --on-accent, so a flat `color: var(--on-surface)` here would turn a selected property
   row's key text unreadable. A skin that wants them must declare the :active/:hover
   variants too.

   Also undefined ON PURPOSE and NOT part of this list: TyGridPanel and TyGridPanelCell
   (the layout grid and its cells are scaffolding, not surfaces — both stay transparent so
   the gutters and the cells alike take the colour of whatever the grid sits on, gradient
   included; their Paint falls back to TyFillParentBg. tests/test.gridpanel.pas asserts no
   theme gives EITHER of them a background, and that a theme which defines one still gets
   it) and TyFormSurface.

   TyGridPanelCell is NOT the data grid's TyGridCell, which IS defined above: the layout
   cell used to answer to that name, which both leaked the data cell's rules onto it and
   left it unreachable from the theme layer. */

/* Controls hosted ON the title bar. A skin that paints the bar in a strong colour leaves an
   ordinary button's surface-tuned ink nearly invisible there; the control appends the
   'on-titlebar' variant automatically (TyStyleClassFor), so this is the only place a theme
   has to say what belongs on its own bar. Composed with whatever class the host set, so a
   ghost button on a title bar stays a ghost button and only its ink moves. */
TyButton.on-titlebar, TySpeedButton.on-titlebar, TyGlyphButton.on-titlebar,
TyGlyphContainerButton.on-titlebar, TyDropDownButton.on-titlebar,
TyMenuButton.on-titlebar, TyColorButton.on-titlebar, TyButtonGroup.on-titlebar,
TyLabel.on-titlebar, TyCheckBox.on-titlebar, TyToggleSwitch.on-titlebar {
  color: var(--on-titlebar);
}
