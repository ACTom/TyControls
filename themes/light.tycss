/* TyControls — Light theme */
:root {
  /* ── SEED ── 7 colors + 1 metric */
  --accent: #3B82F6; --surface: #FFFFFF; --on-surface: #1F2937;
  --border: #D1D5DB; --danger: #EF4444; --radius: 6px;
  /* The two STATUS seeds (added for TTyAlert/TTyNotification, 2026-07-17). They are seeds, not
     derivations: no hue-shift of --accent or --danger produces a credible green/amber, and a
     control must never invent a colour. There is deliberately no --info seed — in this vocabulary
     (as in Ant's) "info" IS the brand colour, so --info aliases --accent below. */
  --success: #22C55E; --warning: #F59E0B;

  /* ── MAP: directional darken/lighten the body inlines ── */
  --surface-hover:            darken(--surface, 4%);
  --surface-active:           darken(--surface, 10%);
  --surface-chrome:           darken(--surface, 6%);
  /* 斑马纹的隔行底色。比 chrome 淡得多 —— 它是让长表读起来更顺的辅助,不是分区。 */
  --surface-alt:              darken(--surface, 3%);
  --surface-sunk:             darken(--surface, 8%);
  --surface-track:            darken(--surface, 10%);
  --surface-listitem-hover:   darken(--surface, 5%);
  --surface-tab-rest:         darken(--surface, 5%);
  --surface-tab-hover:        darken(--surface, 2%);
  --surface-toggle-off:       darken(--surface, 18%);
  --surface-toggle-off-hover: darken(--surface, 22%);
  --surface-caption-hover:    darken(--surface, 12%);
  --surface-caption-active:   darken(--surface, 20%);
  --border-hover:             darken(--border, 10%);
  --scroll-handle-hover:      darken(--border, 15%);
  --accent-hover:  lighten(--accent, 8%);   --accent-active: darken(--accent, 8%);
  --danger-hover:  lighten(--danger, 8%);   --danger-active: darken(--danger, 8%);
  --danger-press-close: darken(--danger, 10%);

  /* ── ALIAS: semantic ── */
  --focus-ring:       var(--accent);
  --selection:        alpha(var(--accent), 0.30);
  --muted:            alpha(var(--on-surface), 0.5);
  --overlay-hover:    alpha(var(--on-surface), 0.12);
  --disabled-opacity: 0.5;
  --form-bg:          var(--surface-hover);   /* TyForm bg */
  --titlebar-bg:      var(--surface-chrome);  /* TyTitleBar bg */
  --input-bg:         var(--surface);         /* Edit/Check/Radio/Combo/List/Spin/Memo bg */
  --scroll-handle:    var(--border);          /* resting scroll thumb/handle */
  --input-border-hover: var(--border-hover);  /* neutral inputs hover border */
  /* on-* declared here but WIRED only in the §3 bug-fix commit */
  --on-accent:        on(var(--accent));      /* light -> #FFFFFF (== current literal) */
  --on-danger:        on(var(--danger));      /* light -> #FFFFFF */
  --on-success:       on(var(--success));     /* the status seeds get the same on() pairing */
  --on-warning:       on(var(--warning));     /* amber is light -> on() picks a DARK ink here */
  --info:             var(--accent);          /* "info" is the brand colour, not a seed of its own */
  --on-info:          var(--on-accent);

  /* ── COMPONENT: scalars ── */
  --input-border-width: 1px;
  --radius-sm: 3px; --radius-pill: 8px; --radius-round: 12px; --radius-scroll: 4px;
  --font-size-base: 9px; --font-size-title: 9px;
  --font-weight-normal: 400; --font-weight-bold: 700;
}

/* Window/form backdrop — a soft off-white behind the white controls. */
TyForm { background: var(--form-bg); }

TyButton {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: 6px;
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-normal);
}
TyButton:hover    { background: var(--surface-hover); border-color: var(--input-border-hover); }
TyButton:focus    { border-color: var(--accent); outline: 2px var(--focus-ring); }
TyButton:active   { background: var(--surface-active); }
TyButton:disabled { opacity: var(--disabled-opacity); }
TyButton.primary  { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
TyButton.primary:hover    { background: var(--accent-hover); }
TyButton.primary:active   { background: var(--accent-active); }
TyButton.danger   { background: var(--danger); color: var(--on-danger); border-color: var(--danger); }
TyButton.danger:hover     { background: var(--danger-hover); }
TyButton.danger:active    { background: var(--danger-active); }
/* Ghost (VS Code 风格): 平时透明,仅 hover/active/选中显示底色与边框。透明用 alpha(...,0)
   保持纯色,使现有 hover 背景 alpha 淡入有效;边框透明但保留宽度,避免 hover 尺寸跳动。 */
TyButton.ghost {
  background: alpha(var(--surface-hover), 0);
  color: var(--on-surface);
  border-color: alpha(var(--border), 0);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: 6px;
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-normal);
}
TyButton.ghost:hover    { background: var(--surface-hover); border-color: var(--input-border-hover); }
TyButton.ghost:active   { background: var(--surface-active); }
TyButton.ghost:selected { background: var(--surface-active); border-color: var(--accent); }
TyButton.ghost:focus    { outline: 2px var(--focus-ring); }
TyButton.ghost:disabled { opacity: var(--disabled-opacity); }

TyLabel {
  background: alpha(#FFFFFF, 0);
  color: var(--on-surface);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-normal);
}
TyLabel:disabled { opacity: var(--disabled-opacity); }

TyEdit {
  background: var(--input-bg);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: 4px;
  font-size: var(--font-size-base);
}
TyEdit:hover    { border-color: var(--input-border-hover); }
TyEdit:focus    { border-color: var(--accent); outline: 2px var(--focus-ring); }
TyEdit:disabled { opacity: var(--disabled-opacity); }

TyCheckBox {
  background: var(--input-bg);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius-sm);
  padding: 4px;
}
TyCheckBox:hover    { border-color: var(--accent); }
TyCheckBox:active   { background: var(--accent); color: var(--on-accent); }
TyCheckBox:focus    { outline: 2px var(--focus-ring); }
TyCheckBox:disabled { opacity: var(--disabled-opacity); }

TyRadioButton {
  background: var(--input-bg);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius-pill);
  padding: 4px;
}
TyRadioButton:hover    { border-color: var(--accent); }
TyRadioButton:active   { background: var(--accent); color: var(--on-accent); }
TyRadioButton:focus { outline: 2px var(--focus-ring); }
TyRadioButton:disabled { opacity: var(--disabled-opacity); }

TyPanel {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: 8px;
}

TyComboBox {
  background: var(--input-bg);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: 4px;
  font-size: var(--font-size-base);
}
TyComboBox:hover    { border-color: var(--input-border-hover); }
TyComboBox:focus    { border-color: var(--accent); outline: 2px var(--focus-ring); }
TyComboBox:disabled { opacity: var(--disabled-opacity); }

TyScrollBar {
  background: var(--surface-chrome);
  color: var(--scroll-handle);
  border-radius: var(--radius-scroll);
}
TyScrollBar:hover  { color: var(--scroll-handle-hover); }
TyScrollBar:active { color: var(--accent); }
TyScrollBar:focus  { outline: 2px var(--focus-ring); }
TyScrollBar:disabled { opacity: var(--disabled-opacity); }

TyTitleBar {
  background: var(--titlebar-bg);
  color: var(--on-surface);
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-bold);
}

TyCaptionButton {
  background: alpha(#FFFFFF, 0);
  color: var(--on-surface);
  border-radius: 0px;
}
TyCaptionButton:hover  { background: var(--surface-caption-hover); }
TyCaptionButton:active { background: var(--surface-caption-active); }
TyCaptionButton.close:hover  { background: var(--danger); color: var(--on-danger); }
TyCaptionButton.close:active { background: var(--danger-press-close); color: var(--on-danger); }
TyCaptionButton.min:hover    { background: var(--surface-caption-hover); }
TyCaptionButton.max:hover    { background: var(--surface-caption-hover); }

/* ── v1.1 controls ─────────────────────────────────────────────────────── */

TyListBox {
  background: var(--input-bg);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: 2px;
}
TyListBox:hover   { border-color: var(--input-border-hover); }
TyListBox:focus   { border-color: var(--accent); outline: 2px var(--focus-ring); }
TyListBox:disabled { opacity: var(--disabled-opacity); }

TyListItem {
  background: alpha(#000000, 0);
  color: var(--on-surface);
  border-radius: var(--radius);
  padding: 4px;
}
TyListItem:hover  { background: var(--surface-listitem-hover); }
TyListItem:active { background: var(--accent); color: var(--on-accent); border-radius: 0; }

TyProgressBar {
  background: var(--surface-sunk);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
}
TyProgressBar:disabled { opacity: var(--disabled-opacity); }

TyProgressFill {
  background: var(--accent);
  border-radius: var(--radius);
}

TyGauge {
  background: var(--surface-sunk);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
}
TyGauge:disabled { opacity: var(--disabled-opacity); }

TyGaugeFill {
  background: var(--accent);
  border-radius: var(--radius);
}

/* Themed tooltip surface (TTyHintWindow — replaces the native LCL hint). */
TyHint {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius-sm);
  padding: 5px 9px;
  font-size: var(--font-size-base);
}

/* Ribbon (Phase-3): the command band surface + the labelled group box. */
TyRibbon {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: 0;
  font-size: var(--font-size-base);
}
TyRibbonGroup {
  background: alpha(#FFFFFF, 0);
  color: var(--muted);
  border-color: var(--border);
  border-width: 1px;
  font-size: var(--font-size-base);
}


TyToggleSwitch {
  background: var(--surface-toggle-off);
  color: var(--on-surface);
  border-radius: var(--radius-round);
}
TyToggleSwitch:hover    { background: var(--surface-toggle-off-hover); }
TyToggleSwitch:active   { background: var(--accent); }
TyToggleSwitch:focus { outline: 2px var(--focus-ring); }
TyToggleSwitch:disabled { opacity: var(--disabled-opacity); }

TyTrackBar {
  background: var(--surface-track);
  border-radius: var(--radius-sm);
  padding: 0px;
}
TyTrackBar:focus    { outline: 2px var(--focus-ring); }
TyTrackBar:disabled { opacity: var(--disabled-opacity); }

TyTrackThumb {
  background: var(--accent);
  border-radius: var(--radius-pill);
}
TyTrackThumb:hover  { background: var(--accent-hover); }
TyTrackThumb:active { background: var(--accent-active); }

TyGroupBox {
  padding: 4px 12px;
  background: alpha(#FFFFFF, 0);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
}

/* ── v1.2 controls ─────────────────────────────────────────────────────── */

TyTabControl {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
}
TyTabControl:hover  { border-color: var(--input-border-hover); }
TyTabControl:focus  { border-color: var(--accent); outline: 2px var(--focus-ring); }
TyTabControl:disabled { opacity: var(--disabled-opacity); }

/* TTyPageControl mirrors TyTabControl (the tab container); TyTabSheet is the page
   body inside the frame — opaque surface fill only (no border) so it never leaves
   transparent pixels for the OS window backdrop to show through. */
TyPageControl {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
}
TyPageControl:hover  { border-color: var(--input-border-hover); }
TyPageControl:focus  { border-color: var(--accent); outline: 2px var(--focus-ring); }
TyPageControl:disabled { opacity: var(--disabled-opacity); }
TyTabSheet {
  background: var(--surface);
}

TyTab {
  background: var(--surface-tab-rest);
  color: var(--on-surface);
  padding: 4px;
  border-radius: var(--radius) var(--radius) 0 0;
}
TyTab:hover  { background: var(--surface-tab-hover); }
TyTab:active { background: var(--surface); color: var(--accent); }

/* ── v1.9 controls ─────────────────────────────────────────────────────── */

TySpinEdit {
  background: var(--input-bg);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: 4px;
  font-size: var(--font-size-base);
}
TySpinEdit:hover    { border-color: var(--input-border-hover); }
TySpinEdit:focus    { border-color: var(--accent); outline: 2px var(--focus-ring); }
TySpinEdit:disabled { opacity: var(--disabled-opacity); }

TyMemo {
  background: var(--input-bg);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: 4px;
  font-size: var(--font-size-base);
}
TyMemo:hover    { border-color: var(--input-border-hover); }
TyMemo:focus    { border-color: var(--accent); outline: 2px var(--focus-ring); }
TyMemo:disabled { opacity: var(--disabled-opacity); }

TyTextSelection { background: var(--selection); }
TyTextHint      { color: var(--muted); }
TyTabClose      { background: var(--overlay-hover); border-radius: var(--radius); }

TyScrollThumb { background: var(--scroll-handle); border-radius: var(--radius-scroll); }
TyScrollThumb:hover  { background: var(--scroll-handle-hover); }
TyScrollThumb:active { background: var(--accent); }
TyToggleKnob  { background: #FFFFFF; border-radius: var(--radius-round); }

/* 数字角标 (TTyButton badge): 默认 accent 蓝胶囊;padding 上下0、左右4 留横向呼吸。 */
TyBadge {
  background: var(--accent);
  color: var(--on-accent);
  border-radius: var(--radius-round);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-bold);
  padding: 0px 4px;
}

/* ── Menu system ───────────────────────────────────────────────────────── */

/* The top application-menu bar (TTyMenuBar surface). */
TyMenuBar {
  background: alpha(#FFFFFF, 0);
  color: var(--on-surface);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-normal);
  padding: 2px;
}

/* The dropdown/context popup surface (TTyMenuView, the rendered popup body).
   TyMenuPopup mirrors it for the popup-host selector named in the spec. */
TyMenuView {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: 4px;
}
TyMenuPopup {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: 4px;
}

/* A single menu row / bar cell. The base border-color is the separator-line ink. */
TyMenuItem {
  background: alpha(#FFFFFF, 0);
  color: var(--on-surface);
  border-color: var(--border);
  border-radius: var(--radius-sm);
  padding: 4px;
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-normal);
}
TyMenuItem:hover    { background: var(--surface-hover); }
TyMenuItem:active   { background: var(--accent); color: var(--on-accent); }
TyMenuItem:disabled { color: var(--muted); }

/* ── Lightweight trio ──────────────────────────────────────────────────── */

TySplitter {
  background: none;
  color: var(--muted);
}
TySplitter:hover {
  color: var(--accent);
}

TyStatusBar {
  background: var(--surface-chrome);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-normal);
}

TyToolBar {
  background: var(--surface-chrome);
  border-color: var(--border);
  border-width: var(--input-border-width);
}

/* ── Calendar + DateTimePicker ─────────────────────────────────────────── */

TyCalendar { background: var(--input-bg); color: var(--on-surface); border-color: var(--border); border-width: var(--input-border-width); border-radius: var(--radius); padding: 6px; font-size: var(--font-size-base); }
TyCalendarTitle { color: var(--on-surface); font-weight: var(--font-weight-bold); }
TyCalendarTitle:hover { color: var(--accent); }
TyCalendarWeekday { color: var(--muted); font-size: var(--font-size-base); }
TyCalendarCell { background: none; color: var(--on-surface); border-radius: var(--radius-sm); }
TyCalendarCell:hover { background: var(--surface-hover); }
TyCalendarCell:selected { background: var(--accent); color: var(--on-accent); }
TyCalendarCell:disabled { color: var(--muted); }
TyDateTimePicker { background: var(--input-bg); color: var(--on-surface); border-color: var(--border); border-width: var(--input-border-width); border-radius: var(--radius); padding: 4px 6px; font-size: var(--font-size-base); }
TyDateTimePicker:hover { border-color: var(--input-border-hover); }
TyDateTimePicker:focus { border-color: var(--accent); outline: 2px var(--focus-ring); }
TyDateTimePicker:disabled { opacity: var(--disabled-opacity); }
TyDateTimeButton { background: var(--surface-chrome); color: var(--on-surface); }
TyDateTimeButton:hover { background: var(--surface-hover); color: var(--accent); }

/* ── TreeView ──────────────────────────────────────────────────────────── */

TyTreeView { background: var(--input-bg); color: var(--on-surface); border-color: var(--border); border-width: var(--input-border-width); border-radius: var(--radius); padding: 2px; font-size: var(--font-size-base); }
TyTreeNode { background: none; color: var(--on-surface); }
TyTreeNode:hover { background: var(--surface-hover); }
TyTreeNode:selected { background: var(--accent); color: var(--on-accent); }
TyTreeNode:disabled { color: var(--muted); }
TyTreeHeader { background: var(--surface-chrome); border-color: var(--border); border-width: var(--input-border-width); color: var(--on-surface); font-size: var(--font-size-base); font-weight: var(--font-weight-bold); }
TyTreeHeaderSection { background: none; color: var(--on-surface); border-color: var(--border); }
TyTreeHeaderSection:hover { background: var(--surface-hover); }
TyTreeHeaderSection:selected { background: var(--surface-active); }

/* --- 数据网格 TTyGrid ------------------------------------------------------
   基层给全套键,新皮肤即使一条网格规则都不写也能正常显示(基层垫在每个主题之下)。
   网格自成一套 typeKey,不借用树/列表的键 —— 借来的键在外观主题层够不着。 */
TyGrid { background: var(--surface); color: var(--on-surface); border-color: var(--border); border-width: var(--input-border-width); border-radius: var(--radius-sm); font-size: var(--font-size-base); }
/* 正文单元格。resting 透明,让网格表面透出来;选中/悬停才上色。 */
TyGridCell { background: none; color: var(--on-surface); padding: 0px 6px; }
TyGridCell:hover    { background: var(--surface-hover); }
TyGridCell:selected { background: var(--accent); color: var(--on-accent); }
/* 焦点格(光标所在)。整行选中模式下,不区分就看不出光标在哪一格。 */
TyGridActiveCell { background: var(--surface-active); color: var(--on-surface); }
/* 斑马纹。自己的 typeKey 而不是 TyGridCell:alternate:加伪类要动共享的状态枚举与
   CSS 解析器,会波及每一个控件;而网格的各部件本来就各有各的键。 */
TyGridCellAlt { background: var(--surface-alt); }
/* 冻结区(固定行列)与行头槽:比正文略重,读者一眼能分出"这块不滚动"。 */
TyGridFixed     { background: var(--surface-chrome); color: var(--on-surface); border-color: var(--border); }
TyGridIndicator { background: var(--surface-chrome); color: var(--muted); border-color: var(--border); }
/* 列头带 —— 与树表头同族的观感,但用自己的键。 */
TyGridHeader        { background: var(--surface-chrome); color: var(--on-surface); border-color: var(--border); border-width: var(--input-border-width); font-size: var(--font-size-base); font-weight: var(--font-weight-bold); }
TyGridHeaderSection { background: none; color: var(--on-surface); border-color: var(--border); }
TyGridHeaderSection:hover    { background: var(--surface-hover); }
TyGridHeaderSection:selected { background: var(--surface-active); }
/* 分组表头带(横跨若干列的上层标题)。自己的键 —— 与叶子列头分开配才有意义。 */
TyGridHeaderGroup { background: var(--surface-active); color: var(--on-surface); border-color: var(--border); }
/* 格线与选区。格线单独成键,皮肤想去掉格子只需把它设成透明。 */
TyGridLine      { background: var(--border); }
/* 单元格图形。各自成键,不借复选框/进度条的键 —— 借来的键在外观层够不着,
   而且改它会波及那些控件。状态只由单元格自身决定,不掺网格的瞬时状态。 */
TyGridCheckBox           { background: var(--input-bg); border-color: var(--border); border-width: var(--input-border-width); border-radius: var(--radius-sm); color: var(--on-surface); }
TyGridCheckBox:selected  { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
TyGridProgress           { background: var(--surface-chrome); border-radius: var(--radius-sm); }
TyGridProgressFill       { background: var(--accent); }
TyGridRating             { color: var(--accent); }
/* 按钮单元格。三态用自己的键 —— 借 TyButton 的键会让"改网格里的按钮"波及全库按钮。 */
TyGridButton          { background: var(--surface-chrome); color: var(--on-surface); border-color: var(--border); border-width: var(--input-border-width); border-radius: var(--radius-sm); }
TyGridButton:hover    { background: var(--surface-hover); }
TyGridButton:active   { background: var(--surface-active); }
TyGridSelection { background: var(--selection); border-color: var(--accent); }
TyTreeCheckBox { background: var(--input-bg); color: var(--on-surface); border-color: var(--border); border-width: var(--input-border-width); border-radius: var(--radius-sm); }
TyTreeCheckBox:active   { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
TyTreeCheckBox:selected { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
TyTreeCheckBox:disabled { color: var(--muted); }

/* ── Card + Tag (Ant Design-gap batch 1) ───────────────────────────────── */

/* One themed surface for the whole card; the header/actions strips are bands drawn
   on it, so they carry only their separator (border-*) and the title's ink. A flat,
   modern card: hairline border, no header band — the separator alone splits it. */
TyCard {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: 12px;
}
TyCard:hover { border-color: var(--border-hover); }
TyCard:disabled { opacity: var(--disabled-opacity); }
/* No background => a transparent title band over the card's own surface. */
TyCardHeader {
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-bold);
}
TyCardActions { border-color: var(--border); border-width: var(--input-border-width); }

/* Neutral tag = a faint on-surface wash; the variants are StyleClasses, and these two
   land on seeds the palette already has (a 'success'/'warning' tag would need a new
   seed colour + its on() pairing first). */
TyTag {
  background: var(--overlay-hover);
  color: var(--on-surface);
  border-radius: var(--radius-round);
  font-size: var(--font-size-base);
  padding: 0px 8px;
}
TyTag.accent { background: var(--accent); color: var(--on-accent); }
TyTag.danger { background: var(--danger); color: var(--on-danger); }
TyTag:disabled { opacity: var(--disabled-opacity); }

TyTagClose       { color: var(--muted); }
TyTagClose:hover { background: var(--overlay-hover); color: var(--on-surface); border-radius: var(--radius-sm); }

/* ── Alert + Notification + Empty + Segmented (Ant Design-gap batch 1) ──── */

/* The inline alert bar. The four variant names are a HARD contract: TTyAlert.AlertType maps
   onto them and draws their icons. A Bootstrap-style tinted banner (pale wash, mid-tint border,
   deep semantic ink) rather than AntD's coloured-icon/neutral-text look — the icon shares the
   bar's `color`, so one ink has to serve both. error rides the EXISTING --danger seed; info is
   --accent (info IS the brand colour here); only success/warning needed new seeds. */
TyAlert {
  background: var(--surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  color: var(--on-surface);
  font-size: var(--font-size-base);
  padding: 8px 12px;
}
TyAlert.info    { background: alpha(var(--accent), 0.10);  border-color: alpha(var(--accent), 0.35);  color: var(--accent); }
TyAlert.success { background: alpha(var(--success), 0.10); border-color: alpha(var(--success), 0.35); color: var(--success); }
TyAlert.warning { background: alpha(var(--warning), 0.10); border-color: alpha(var(--warning), 0.35); color: var(--warning); }
TyAlert.error   { background: alpha(var(--danger), 0.10);  border-color: alpha(var(--danger), 0.35);  color: var(--danger); }
TyAlert:disabled { opacity: var(--disabled-opacity); }

TyAlertClose       { color: var(--muted); }
TyAlertClose:hover { background: var(--overlay-hover); color: var(--on-surface); border-radius: var(--radius-sm); }

/* The corner toast. Shaped like TyCard (its nearest kin: a titled surface) so the two agree.
   The variant's `color` is the MARK's ink; the card's own `color` inks title + message. */
TyNotification {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: 12px 14px;
  font-size: var(--font-size-base);
}
TyNotification:hover   { border-color: var(--border-hover); }
TyNotification.info    { color: var(--accent); }
TyNotification.success { color: var(--success); }
TyNotification.warning { color: var(--warning); }
TyNotification.error   { color: var(--danger); }

TyNotificationClose       { color: var(--muted); }
TyNotificationClose:hover { background: var(--overlay-hover); color: var(--on-surface); border-radius: var(--radius-sm); }

/* The empty-state placeholder: transparent, because it lies ON the empty list's own surface. */
TyEmpty {
  background: alpha(#FFFFFF, 0);
  color: var(--muted);
  font-size: var(--font-size-base);
  padding: 16px;
}
TyEmpty:disabled { opacity: var(--disabled-opacity); }
/* The picture gets its own ink: it must sit far lighter than the message, and one rule
   cannot carry two inks. */
TyEmptyImage { color: var(--border); }

/* The segmented control: a groove holding a lifted thumb. The item radius is deliberately
   SMALLER than the track's, which is what reads as "chip sitting in a slot". */
TySegmented {
  background: var(--overlay-hover);
  color: var(--on-surface);
  border-radius: var(--radius);
  font-size: var(--font-size-base);
}
TySegmented:focus    { outline: 2px var(--focus-ring); }
TySegmented:disabled { opacity: var(--disabled-opacity); }

TySegmentedItem          { color: var(--muted); border-radius: var(--radius-sm);
                           padding: 4px 10px; font-size: var(--font-size-base); }
TySegmentedItem:hover    { background: var(--overlay-hover); color: var(--on-surface); }
TySegmentedItem:selected { background: var(--surface); color: var(--on-surface); }
TySegmentedItem:disabled { color: var(--muted); }

/* ── Pagination + Steps + Breadcrumb + Transfer + TreeSelect + Cascader + Popover ─────── */
/* (Ant Design-gap batches 2 & 3. Each control paints NOTHING without its surface key, so
   these live here in the base: every theme inherits them and can then restyle any of them.) */

/* Pagination: a transparent strip of cells — the page numbers are the chrome, not a bar. */
TyPagination         { background: alpha(#FFFFFF, 0); color: var(--on-surface); font-size: var(--font-size-base); }
TyPagination:disabled { opacity: var(--disabled-opacity); }
TyPaginationItem          { background: alpha(#FFFFFF, 0); color: var(--on-surface);
                            border-color: var(--border); border-width: var(--input-border-width);
                            border-radius: var(--radius-sm); font-size: var(--font-size-base); padding: 0px 6px; }
TyPaginationItem:hover    { border-color: var(--accent); color: var(--accent); }
TyPaginationItem:selected { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
TyPaginationItem:disabled { color: var(--muted); border-color: var(--border); }

/* Steps: markers on a rail. The done/current/waiting reading is carried by the item states. */
TySteps         { background: alpha(#FFFFFF, 0); color: var(--on-surface); font-size: var(--font-size-base); }
TySteps:disabled { opacity: var(--disabled-opacity); }
/* The step's status IS its state (TyStepStates): done => :normal, current => :selected,
   waiting => :disabled. So the RESTING rule is the DONE look — an accent ring with an accent
   check — not a neutral one. Getting that backwards (a muted resting rule) makes done and
   waiting identical but for the glyph, which is the whole information the rail exists to carry. */
TyStepsItem          { background: var(--surface); color: var(--accent);
                       border-color: var(--accent); border-width: var(--input-border-width);
                       border-radius: var(--radius-round); font-size: var(--font-size-base); }
TyStepsItem:selected { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
TyStepsItem:hover    { border-color: var(--accent-hover); }
TyStepsItem:disabled { background: var(--surface-track); color: var(--muted); border-color: var(--border); }
/* The connector is a plain filled line: it reads ONLY `background` and draws no text, so it
   deliberately declares no `color` — a colour here would be dead, and (since it would have to
   match the fill to be right) the lint would flag the pair as low-contrast text.
   It takes the states of the step it LEADS TO, so these three rules are what make the trail
   light up exactly as far as you have walked. */
TyStepsConnector          { background: var(--accent); }   /* into a done step: already walked */
TyStepsConnector:selected { background: var(--accent); }   /* into the current step */
TyStepsConnector:disabled { background: var(--border); }   /* not walked yet */

/* Breadcrumb: a transparent trail; the mark takes the BAR's ink (it has no key of its own). */
TyBreadcrumb         { background: alpha(#FFFFFF, 0); color: var(--muted); font-size: var(--font-size-base); padding: 2px 4px; }
TyBreadcrumb:disabled { opacity: var(--disabled-opacity); }
TyBreadcrumbItem          { color: var(--accent); font-size: var(--font-size-base); padding: 0px 4px; }
TyBreadcrumbItem:hover    { color: var(--accent-hover); }
/* The last crumb IS the current location: not a link, so it reads as plain ink. */
TyBreadcrumbItem:selected { color: var(--on-surface); }
TyBreadcrumbItem:disabled { color: var(--muted); }

/* Transfer: a frame around two list panes and the move rail. The panes/arrows reuse
   TyListBox / TyButton, which every theme already dresses. */
TyTransfer {
  background: alpha(#FFFFFF, 0);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  font-size: var(--font-size-base);
  padding: 0px;
}
TyTransfer:disabled { opacity: var(--disabled-opacity); }
TyTransferTitle { background: var(--surface-chrome); color: var(--on-surface);
                  border-color: var(--border); border-width: var(--input-border-width);
                  font-size: var(--font-size-base); font-weight: var(--font-weight-bold); padding: 0px 8px; }

/* TTyTreeSelect deliberately has NO key of its own: GetStyleTypeKey returns 'TyComboBox',
   because it IS a combo field — one every theme already dresses, with no key a skin could
   forget. Its popup is a real TyTreeView and is themed by that key. So there is nothing to
   declare here; a `TyTreeSelect { … }` rule would be dead CSS that never resolves. Same
   reasoning as TTyTransfer's move arrows keeping TTyButton's key. */

/* Cascader: the field + its multi-column panel. */
TyCascader {
  background: var(--input-bg);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: 4px;
  font-size: var(--font-size-base);
}
TyCascader:hover    { border-color: var(--input-border-hover); }
TyCascader:focus    { border-color: var(--accent); outline: 2px var(--focus-ring); }
TyCascader:disabled { opacity: var(--disabled-opacity); }
TyCascaderPanel { background: var(--surface); color: var(--on-surface);
                  border-color: var(--border); border-width: var(--input-border-width);
                  border-radius: var(--radius); }
TyCascaderItem          { background: alpha(#FFFFFF, 0); color: var(--on-surface);
                          font-size: var(--font-size-base); padding: 0px 8px; }
TyCascaderItem:hover    { background: var(--surface-listitem-hover); }
TyCascaderItem:selected { background: var(--accent); color: var(--on-accent); }
TyCascaderItem:disabled { color: var(--muted); }

/* Popover: a floating surface that HOSTS controls (that is the gap it fills — Hint/BalloonHint
   can only carry text). The arrow is cut from this same surface, so it needs no key. */
TyPopover {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: 8px;
  font-size: var(--font-size-base);
}
TyPopoverTitle { color: var(--on-surface); font-size: var(--font-size-base);
                 font-weight: var(--font-weight-bold); }

/* Chart: the chart's own chrome resolves TyPanel and its series ride a fixed code palette,
   so the hover tooltip is the ONE key it owns. It reads exactly like TyHint because that is
   what it is — a hint — only painted inside the chart instead of in an OS window. The chart
   paints NO box without this key (no background = nothing to draw on), so it lives here in
   the base for every theme to inherit and then restyle. A skin wanting the box to float can
   add `shadow:` — the control honours it; the base layer stays flat like the rest of light. */
TyChartTooltip {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius-sm);
  padding: 5px 9px;
  font-size: var(--font-size-base);
}

/* ── ListGroupPanel (navigation accordion; own keys, not the tree column header's) ────── */
/* A modern sider: group rows carry NO fill (just muted ink + a right chevron; the OPEN group
   turns accent), and a selected item is a SOFT, INSET, ROUNDED pill — never the old full-bleed
   saturated bar. TTyListGroupPanel insets and rounds the pill in code; the colour/radius here.
   These are their OWN keys so a theme can restyle the sider without touching TreeView/ListView
   column headers, which is what TyTreeHeaderSection (the borrowed key) would have wrecked. */
TyListGroupHeader          { color: var(--muted); font-size: var(--font-size-base); font-weight: var(--font-weight-bold); padding: 0px 14px; }
TyListGroupHeader:hover    { color: var(--on-surface); }
TyListGroupHeader:selected { color: var(--accent); }   /* the group is OPEN */
TyListGroupItem          { color: var(--on-surface); border-radius: var(--radius); font-size: var(--font-size-base); padding: 0px 14px; }
TyListGroupItem:hover    { background: var(--surface-hover); }
TyListGroupItem:active   { background: var(--selection); color: var(--accent); }   /* selected: soft accent pill */
TyListGroupItem:disabled { color: var(--muted); }
