/* TyControls — Dark theme */
:root {
  /* ── SEED ── 5 colors + 1 metric */
  --accent:     #60A5FA;
  --surface:    #1E1E1E;
  --on-surface: #E5E7EB;
  --border:     #3F3F46;
  --danger:     #F87171;
  --radius:     6px;

  /* ── MAP: directional darken/lighten the body inlines ── */
  --surface-hover:            lighten(--surface, 8%);
  --surface-active:           darken(--surface, 6%);
  --surface-chrome:           darken(--surface, 4%);
  --surface-sunk:             darken(--surface, 4%);
  --surface-track:            darken(--surface, 4%);
  --surface-listitem-hover:   lighten(--surface, 10%);
  --surface-tab-rest:         lighten(--surface, 12%);
  --surface-tab-hover:        lighten(--surface, 18%);
  --surface-toggle-off:       lighten(--surface, 20%);
  --surface-toggle-off-hover: lighten(--surface, 24%);
  --surface-caption-hover:    lighten(--surface, 16%);
  --surface-caption-active:   lighten(--surface, 24%);
  --border-hover:             lighten(--border, 12%);
  --scroll-handle-hover:      lighten(--border, 25%);
  --accent-hover:  lighten(--accent, 8%);   --accent-active: darken(--accent, 8%);
  --danger-hover:  lighten(--danger, 8%);   --danger-active: darken(--danger, 8%);
  --danger-press-close: darken(--danger, 10%);

  /* ── ALIAS: semantic ── */
  --focus-ring: var(--accent);
  --selection:     alpha(var(--accent), 0.30);
  --muted:         alpha(var(--on-surface), 0.5);
  --overlay-hover: alpha(#FFFFFF, 0.14);
  --disabled-opacity: 0.5;
  --form-bg:          var(--surface);              /* dark Form = raw surface (no darken) */
  --titlebar-bg:      lighten(--surface, 4%);      /* dark TitleBar lifts */
  --input-bg:         lighten(--surface, 4%);      /* dark raised input bg */
  --scroll-handle:    lighten(--border, 10%);      /* resting scroll thumb/handle */
  --input-border-hover: var(--border-hover);       /* neutral inputs hover border */
  /* on-* declared here but WIRED only in the §3 bug-fix commit */
  /* dark accent/danger are LIGHT blues/reds (luma>0.5), so on() picks inkOnLight =
     the dark ink #0B1120 (matches the correct sites, and fixes the white-on-accent
     checkbox/radio bug); inkOnDark #FFFFFF is the fallback for a dark fill. */
  --on-accent: on(var(--accent), #0B1120, #FFFFFF);
  --on-danger: on(var(--danger), #0B1120, #FFFFFF);

  /* ── COMPONENT: scalars ── */
  --input-border-width: 1px;
  --radius-sm: 3px; --radius-pill: 8px; --radius-round: 12px; --radius-scroll: 4px;
  --font-size-base: 9px; --font-size-title: 9px;
  --font-weight-normal: 400; --font-weight-bold: 700;
}

/* Window/form backdrop — the dark surface so the whole window reads as dark. */
TyForm { background: var(--form-bg); }

TyButton, TySpeedButton, TyGlyphContainerButton, TyRibbonAppMenu, TyButtonGroup, TyUpDown {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: 6px;
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-normal);
}
TyButton:hover, TySpeedButton:hover, TyGlyphContainerButton:hover, TyRibbonAppMenu:hover, TyButtonGroup:hover, TyUpDown:hover    { background: var(--surface-hover); border-color: var(--input-border-hover); }
TyButton:focus, TySpeedButton:focus, TyGlyphContainerButton:focus, TyRibbonAppMenu:focus, TyButtonGroup:focus, TyUpDown:focus    { border-color: var(--accent); outline: 2px var(--focus-ring); }
TyButton:active, TySpeedButton:active, TyGlyphContainerButton:active, TyRibbonAppMenu:active, TyButtonGroup:active, TyUpDown:active   { background: var(--surface-active); }
TyButton:disabled, TySpeedButton:disabled, TyGlyphContainerButton:disabled,
TyRibbonAppMenu:disabled { opacity: var(--disabled-opacity); }
TyButton.primary, TySpeedButton.primary, TyGlyphContainerButton.primary, TyRibbonAppMenu.primary, TyButtonGroup.primary, TyUpDown.primary  { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
TyButton.primary:hover, TySpeedButton.primary:hover, TyGlyphContainerButton.primary:hover,
TyRibbonAppMenu.primary:hover    { background: var(--accent-hover); }
TyButton.primary:active, TySpeedButton.primary:active, TyGlyphContainerButton.primary:active,
TyRibbonAppMenu.primary:active   { background: var(--accent-active); }
TyButton.danger, TySpeedButton.danger, TyGlyphContainerButton.danger, TyRibbonAppMenu.danger, TyButtonGroup.danger, TyUpDown.danger   { background: var(--danger); color: var(--on-danger); border-color: var(--danger); }
TyButton.danger:hover, TySpeedButton.danger:hover, TyGlyphContainerButton.danger:hover,
TyRibbonAppMenu.danger:hover     { background: var(--danger-hover); }
TyButton.danger:active, TySpeedButton.danger:active, TyGlyphContainerButton.danger:active,
TyRibbonAppMenu.danger:active    { background: var(--danger-active); }
/* Ghost (VS Code 风格): 平时透明,仅 hover/active/选中显示。alpha(...,0) 保持纯色让淡入有效。 */
TyButton.ghost, TySpeedButton.ghost, TyGlyphContainerButton.ghost, TyRibbonAppMenu.ghost, TyButtonGroup.ghost, TyUpDown.ghost {
  background: alpha(var(--surface-hover), 0);
  color: var(--on-surface);
  border-color: alpha(var(--border), 0);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: 6px;
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-normal);
}
TyButton.ghost:hover, TySpeedButton.ghost:hover, TyGlyphContainerButton.ghost:hover,
TyRibbonAppMenu.ghost:hover    { background: var(--surface-hover); border-color: var(--input-border-hover); }
TyButton.ghost:active, TySpeedButton.ghost:active, TyGlyphContainerButton.ghost:active,
TyRibbonAppMenu.ghost:active   { background: var(--surface-active); }
TyButton.ghost:selected, TySpeedButton.ghost:selected, TyGlyphContainerButton.ghost:selected,
TyRibbonAppMenu.ghost:selected { background: var(--surface-active); border-color: var(--accent); }
TyButton.ghost:focus, TySpeedButton.ghost:focus, TyGlyphContainerButton.ghost:focus,
TyRibbonAppMenu.ghost:focus    { outline: 2px var(--focus-ring); }
TyButton.ghost:disabled, TySpeedButton.ghost:disabled, TyGlyphContainerButton.ghost:disabled,
TyRibbonAppMenu.ghost:disabled { opacity: var(--disabled-opacity); }

TyLabel, TyHtmlLabel, TyLinkLabel, TyShadowLabel, TyGlowLabel, TyDivider, TyCharImage {
  background: alpha(#000000, 0);
  color: var(--on-surface);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-normal);
}
TyLabel:disabled, TyHtmlLabel:disabled, TyLinkLabel:disabled, TyShadowLabel:disabled, TyGlowLabel:disabled, TyDivider:disabled, TyCharImage:disabled { opacity: var(--disabled-opacity); }

TyEdit {
  background: var(--input-bg);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: 4px;
  font-size: var(--font-size-base);
}
TyEdit:hover    { border-color: var(--input-border-hover); }
TyEdit:focus    { border-color: var(--accent); outline: 2px var(--focus-ring); }
TyEdit:disabled { opacity: var(--disabled-opacity); }

TyCheckBox {
  background: var(--input-bg);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius-sm);
  padding: 4px;
}
TyCheckBox:hover    { border-color: var(--accent); }
TyCheckBox:active   { background: var(--accent); color: var(--on-accent); }
TyCheckBox:focus    { outline: 2px var(--focus-ring); }
TyCheckBox:disabled { opacity: var(--disabled-opacity); }

TyRadioButton {
  background: var(--input-bg);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius-pill);
  padding: 4px;
}
TyRadioButton:hover    { border-color: var(--accent); }
TyRadioButton:active   { background: var(--accent); color: var(--on-accent); }
TyRadioButton:focus { outline: 2px var(--focus-ring); }
TyRadioButton:disabled { opacity: var(--disabled-opacity); }

TyPanel, TyScrollBox, TyExPanel, TyChart, TyCalculator, TyBevel, TySizeBox, TyControlBar, TyCoolBar, TyColorGrid, TyShape, TyStarShape, TyArrow, TyImageView, TyImage, TyPreviewBox, TyListGroupPanel {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: 8px;
}

TyComboBox {
  background: var(--input-bg);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: 4px;
  font-size: var(--font-size-base);
}
TyComboBox:hover    { border-color: var(--input-border-hover); }
TyComboBox:focus    { border-color: var(--accent); outline: 2px var(--focus-ring); }
TyComboBox:disabled { opacity: var(--disabled-opacity); }

TyScrollBar {
  background: var(--surface-chrome);
  color: var(--scroll-handle);
  border-radius: var(--radius-scroll);
}
TyScrollBar:hover  { color: var(--scroll-handle-hover); }
TyScrollBar:active { color: var(--accent); }
TyScrollBar:focus  { outline: 2px var(--focus-ring); }
TyScrollBar:disabled { opacity: var(--disabled-opacity); }

TyTitleBar, TyRibbonQuickAccess {
  background: var(--titlebar-bg);
  color: var(--on-surface);
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-bold);
}

TyCaptionButton {
  background: alpha(#000000, 0);
  color: var(--on-surface);
  border-radius: 0px;
}
TyCaptionButton:hover  { background: var(--surface-caption-hover); }
TyCaptionButton:active { background: var(--surface-caption-active); }
TyCaptionButton.close:hover  { background: var(--danger); color: var(--on-danger); }
TyCaptionButton.close:active { background: var(--danger-press-close); color: var(--on-danger); }
TyCaptionButton.min:hover    { background: var(--surface-caption-hover); }
TyCaptionButton.max:hover    { background: var(--surface-caption-hover); }

/* ── v1.1 controls ─────────────────────────────────────────────────────── */

TyListBox, TyValueListEditor, TyRibbonGallery {
  background: var(--input-bg);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: 2px;
}
TyListBox:hover, TyValueListEditor:hover, TyRibbonGallery:hover   { border-color: var(--input-border-hover); }
TyListBox:focus, TyValueListEditor:focus, TyRibbonGallery:focus   { border-color: var(--accent); outline: 2px var(--focus-ring); }
TyListBox:disabled, TyValueListEditor:disabled, TyRibbonGallery:disabled { opacity: var(--disabled-opacity); }

TyListItem, TyValueListEditorRow {
  background: alpha(#000000, 0);
  color: var(--on-surface);
  border-radius: var(--radius);
  padding: 4px;
}
TyListItem:hover, TyValueListEditorRow:hover  { background: var(--surface-listitem-hover); }
TyListItem:active, TyValueListEditorRow:active { background: var(--accent); color: var(--on-accent); border-radius: 0; }

TyProgressBar {
  background: var(--surface-sunk);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
}
TyProgressBar:disabled { opacity: var(--disabled-opacity); }

TyProgressFill {
  background: var(--accent);
  border-radius: var(--radius);
}

TyGauge, TyMeter, TyLevelMeter, TyDial, TyGearDial, TyAnalogClock, TyCircularProgress,
TyActivityIndicator, TyActivityBar, TyGearActivityIndicator, TySparkline, TyRating,
TyLColorPicker, TyHSColorPicker, TyMeterTick, TyAnalogClockHand, TyGearDialTeeth, TyColorArea {
  background: var(--surface-sunk);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
}
TyGauge:disabled, TyMeter:disabled, TyLevelMeter:disabled, TyDial:disabled, TyGearDial:disabled,
TyAnalogClock:disabled, TyCircularProgress:disabled, TyActivityIndicator:disabled,
TyActivityBar:disabled, TyGearActivityIndicator:disabled, TySparkline:disabled,
TyRating:disabled, TyLColorPicker:disabled, TyHSColorPicker:disabled { opacity: var(--disabled-opacity); }

TyGaugeFill, TyMeterNeedle, TyLevelMeterFill, TyLevelMeterPeak, TyDialPointer,
TyGearDialPointer, TyAnalogClockSecondHand, TyCircularProgressFill, TyActivityIndicatorFill,
TyActivityBarFill, TyGearActivityIndicatorFill, TySparklineFill, TySparklineDot, TyRatingStar {
  background: var(--accent);
  border-radius: var(--radius);
}

/* Themed tooltip surface (TTyHintWindow — replaces the native LCL hint). */
TyHint {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius-sm);
  padding: 5px 9px;
  font-size: var(--font-size-base);
}

/* Ribbon (Phase-3): the command band surface + the labelled group box. */
TyRibbon, TyRibbonBackstage {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: 0;
  font-size: var(--font-size-base);
}
TyRibbonGroup {
  background: alpha(#FFFFFF, 0);
  color: var(--muted);
  border-color: var(--border);
  border-width: 1px;
  font-size: var(--font-size-base);
}


TyToggleSwitch {
  background: var(--surface-toggle-off);
  color: var(--on-surface);
  border-radius: var(--radius-round);
}
TyToggleSwitch:hover    { background: var(--surface-toggle-off-hover); }
TyToggleSwitch:active   { background: var(--accent); }
TyToggleSwitch:focus { outline: 2px var(--focus-ring); }
TyToggleSwitch:disabled { opacity: var(--disabled-opacity); }

TyTrackBar {
  background: var(--surface-track);
  border-radius: var(--radius-sm);
  padding: 0px;
}
TyTrackBar:focus    { outline: 2px var(--focus-ring); }
TyTrackBar:disabled { opacity: var(--disabled-opacity); }

TyTrackThumb {
  background: var(--accent);
  border-radius: var(--radius-pill);
}
TyTrackThumb:hover  { background: var(--accent-hover); }
TyTrackThumb:active { background: var(--accent-active); }

/* Hyperlink ink for TTyLinkLabel. Its own key rather than a borrowed accent fill: a theme
   that restyles gauges must not repaint every link, and a theme that wants a different link
   colour must not have to repaint gauges. */
TyLinkLabelLink { color: var(--accent); }


TyGroupBox, TyToolGroupPanel {
  padding: 4px 12px;
  background: alpha(#000000, 0);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
}

/* ── v1.2 controls ─────────────────────────────────────────────────────── */

TyTabControl, TyTabSet {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
}
TyTabControl:hover, TyTabSet:hover  { border-color: var(--input-border-hover); }
TyTabControl:focus, TyTabSet:focus  { border-color: var(--accent); outline: 2px var(--focus-ring); }
TyTabControl:disabled, TyTabSet:disabled { opacity: var(--disabled-opacity); }

/* TTyPageControl mirrors TyTabControl; TyTabSheet is the opaque page body inside. */
TyPageControl {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
}
TyPageControl:hover  { border-color: var(--input-border-hover); }
TyPageControl:focus  { border-color: var(--accent); outline: 2px var(--focus-ring); }
TyPageControl:disabled { opacity: var(--disabled-opacity); }
TyTabSheet {
  background: var(--surface);
}

/* 暗色下无法靠 darken 拉开与内容区的差异(surface 已接近黑),改用 lighten 让
   未选中页签"抬起"于内容之上,选中页签回落到 surface 与内容融合。 */
TyTab {
  background: var(--surface-tab-rest);
  color: var(--on-surface);
  padding: 4px;
  border-radius: var(--radius) var(--radius) 0 0;
}
TyTab:hover  { background: var(--surface-tab-hover); }
TyTab:active { background: var(--surface); color: var(--accent); }

/* ── v1.9 controls ─────────────────────────────────────────────────────── */

TySpinEdit {
  background: var(--input-bg);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: 4px;
  font-size: var(--font-size-base);
}
TySpinEdit:hover    { border-color: var(--input-border-hover); }
TySpinEdit:focus    { border-color: var(--accent); outline: 2px var(--focus-ring); }
TySpinEdit:disabled { opacity: var(--disabled-opacity); }

TyMemo {
  background: var(--input-bg);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: 4px;
  font-size: var(--font-size-base);
}
TyMemo:hover    { border-color: var(--input-border-hover); }
TyMemo:focus    { border-color: var(--accent); outline: 2px var(--focus-ring); }
TyMemo:disabled { opacity: var(--disabled-opacity); }

TyTextSelection { background: var(--selection); }
TyTextHint      { color: var(--muted); }
TyTabClose      { background: var(--overlay-hover); border-radius: var(--radius); }

TyScrollThumb { background: var(--scroll-handle); border-radius: var(--radius-scroll); }
TyScrollThumb:hover  { background: var(--scroll-handle-hover); }
TyScrollThumb:active { background: var(--accent); }
TyToggleKnob  { background: #FFFFFF; border-radius: var(--radius-round); }

/* 数字角标 (TTyButton badge): accent 蓝胶囊。 */
TyBadge {
  background: var(--accent);
  color: var(--on-accent);
  border-radius: var(--radius-round);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-bold);
  padding: 0px 4px;
}

/* ── Menu system ───────────────────────────────────────────────────────── */

/* The top application-menu bar (TTyMenuBar surface). */
TyMenuBar {
  background: alpha(#FFFFFF, 0);
  color: var(--on-surface);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-normal);
  padding: 2px;
}

/* The dropdown/context popup surface (TTyMenuView, the rendered popup body).
   TyMenuPopup mirrors it for the popup-host selector named in the spec. */
TyMenuView {
  background: var(--input-bg);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: 4px;
}
TyMenuPopup {
  background: var(--input-bg);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: 4px;
}

/* A single menu row / bar cell. The base border-color is the separator-line ink. */
TyMenuItem {
  background: alpha(#000000, 0);
  color: var(--on-surface);
  border-color: var(--border);
  border-radius: var(--radius-sm);
  padding: 4px;
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-normal);
}
TyMenuItem:hover    { background: var(--surface-hover); }
TyMenuItem:active   { background: var(--accent); color: var(--on-accent); }
TyMenuItem:disabled { color: var(--muted); }

/* ── Lightweight trio ──────────────────────────────────────────────────── */

TySplitter {
  background: none;
  color: var(--muted);
}
TySplitter:hover {
  color: var(--accent);
}

TyStatusBar {
  background: var(--surface-chrome);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-normal);
}

TyToolBar, TyToolSeparator {
  background: var(--surface-chrome);
  border-color: var(--border);
  border-width: var(--input-border-width);
}

/* ── Calendar + DateTimePicker ─────────────────────────────────────────── */

TyCalendar { background: var(--input-bg); color: var(--on-surface); border-color: var(--border); border-width: var(--input-border-width); border-radius: var(--radius); padding: 6px; font-size: var(--font-size-base); }
TyCalendarTitle { color: var(--on-surface); font-size: var(--font-size-title); font-weight: var(--font-weight-bold); }
TyCalendarTitle:hover { color: var(--accent); }
TyCalendarWeekday { color: var(--muted); font-size: var(--font-size-base); }
TyCalendarCell { background: none; color: var(--on-surface); border-radius: var(--radius-sm); }
TyCalendarCell:hover { background: var(--surface-hover); }
TyCalendarCell:selected { background: var(--accent); color: var(--on-accent); }
TyCalendarCell:disabled { color: var(--muted); }
TyDateTimePicker { background: var(--input-bg); color: var(--on-surface); border-color: var(--border); border-width: var(--input-border-width); border-radius: var(--radius); padding: 4px 6px; font-size: var(--font-size-base); }
TyDateTimePicker:hover { border-color: var(--input-border-hover); }
TyDateTimePicker:focus { border-color: var(--accent); outline: 2px var(--focus-ring); }
TyDateTimePicker:disabled { opacity: var(--disabled-opacity); }
TyDateTimeButton { background: var(--surface-chrome); color: var(--on-surface); }
TyDateTimeButton:hover { background: var(--surface-hover); color: var(--accent); }

/* ── TreeView ──────────────────────────────────────────────────────────── */

TyTreeView, TyListView { background: var(--input-bg); color: var(--on-surface); border-color: var(--border); border-width: var(--input-border-width); border-radius: var(--radius); padding: 2px; font-size: var(--font-size-base); }
TyTreeNode, TyListViewItem { background: none; color: var(--on-surface); }
TyTreeNode:hover, TyListViewItem:hover { background: var(--surface-hover); }
TyTreeNode:selected, TyListViewItem:selected { background: var(--accent); color: var(--on-accent); }
TyTreeNode:disabled, TyListViewItem:disabled { color: var(--muted); }
TyTreeHeader, TyListViewHeader, TyListViewGroupHeader, TyHeaderControl { background: var(--surface-chrome); border-color: var(--border); border-width: var(--input-border-width); color: var(--on-surface); font-size: var(--font-size-base); font-weight: var(--font-weight-bold); }
TyTreeHeaderSection, TyListViewHeaderSection { background: none; color: var(--on-surface); border-color: var(--border); }
TyTreeHeaderSection:hover, TyListViewHeaderSection:hover { background: var(--surface-hover); }
TyTreeHeaderSection:selected, TyListViewHeaderSection:selected { background: var(--surface-active); }
TyTreeCheckBox, TyListViewCheckBox { background: var(--input-bg); color: var(--on-surface); border-color: var(--border); border-width: var(--input-border-width); border-radius: var(--radius-sm); }
TyTreeCheckBox:active, TyListViewCheckBox:active   { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
TyTreeCheckBox:selected, TyListViewCheckBox:selected { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
TyTreeCheckBox:disabled, TyListViewCheckBox:disabled { color: var(--muted); }

/* ── Card + Tag (Ant Design-gap batch 1) ───────────────────────────────── */

/* One themed surface for the whole card; the header/actions strips are bands drawn
   on it, so they carry only their separator (border-*) and the title's ink. A flat,
   modern card: hairline border, no header band — the separator alone splits it.
   暗色下 --form-bg 就是 surface 本身(不 darken),卡片再用 surface 就只剩边框可辨;
   改用 --input-bg 让卡片「抬起」于窗口背景,与 TitleBar / MenuView 同一套做法。 */
TyCard {
  background: var(--input-bg);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: 12px;
}
TyCard:hover { border-color: var(--border-hover); }
TyCard:disabled { opacity: var(--disabled-opacity); }
/* No background => a transparent title band over the card's own surface. */
TyCardHeader {
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-bold);
}
TyCardActions { border-color: var(--border); border-width: var(--input-border-width); }

/* Neutral tag = 暗色下的白色薄雾 (--overlay-hover),对应亮色的 on-surface 薄雾;变体是
   StyleClass,而这两个正好落在调色板已有的 seed 上(success/warning 标签得先加新
   seed 色 + 它的 on() 配对)。 */
TyTag {
  background: var(--overlay-hover);
  color: var(--on-surface);
  border-radius: var(--radius-round);
  font-size: var(--font-size-base);
  padding: 0px 8px;
}
TyTag.accent { background: var(--accent); color: var(--on-accent); }
TyTag.danger { background: var(--danger); color: var(--on-danger); }
TyTag:disabled { opacity: var(--disabled-opacity); }

TyTagClose       { color: var(--muted); }
TyTagClose:hover { background: var(--overlay-hover); color: var(--on-surface); border-radius: var(--radius-sm); }
