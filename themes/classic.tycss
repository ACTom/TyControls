/* Classic 3D skin — inspired by the Windows 9x look (an ORIGINAL take, not a pixel clone).
   Shows the v3 skin engine composing: render-style bevels (D + B2), a grey system palette,
   square corners, and a gradient title bar (B1). Loaded as a FILE by the theming example.
   DUAL-MODE: this skin has no natural dark variant, so @mode dark is IDENTICAL to @mode light. */

/* Mode-invariant metrics. Win9x caption buttons were small squares in the top-right, so the
   classic skin shrinks the title-bar buttons from the 46px default via the --caption-button-width
   theme metric (device px are DPI-scaled from this logical value). */
:root {
  --caption-button-width: 32;
}

/* --accent is the brand seed; the runtime accent-picker recolours the skin through it. */
@mode light {
  :root {
    --accent:       #10318C;   /* brand seed — title-bar dark stop + progress fill */
    --title-mid:    #7BA2E0;   /* title-bar gradient mid stop */
    --title-light:  #A6CAF0;   /* title-bar gradient light stop */
    --title-ink:    #FFFFFF;   /* title-bar caption text */
    --face:         #C0C0C0;   /* grey 3D system surface */
    --face-hover:   #C8C8C8;   /* lightly lit face on hover */
    --ink:          #000000;   /* primary text */
    --ink-disabled: #808080;   /* greyed text */
    --field:        #FFFFFF;   /* white input well */
    --border:       #808080;   /* stroked indicator / edge grey */
  }
}
@mode dark {
  :root {
    --accent:       #10318C;   /* identical to light — no natural dark variant */
    --title-mid:    #7BA2E0;
    --title-light:  #A6CAF0;
    --title-ink:    #FFFFFF;
    --face:         #C0C0C0;
    --face-hover:   #C8C8C8;
    --ink:          #000000;
    --ink-disabled: #808080;
    --field:        #FFFFFF;
    --border:       #808080;
  }
}

TyForm          { background: var(--face); }
TyTitleBar      { background: linear-gradient(0deg, var(--accent), var(--title-mid), var(--title-light)); color: var(--title-ink); border-radius: 0; }

/* Caption buttons: FLAT and flush into the title bar (no raised 3D box), white glyph on the blue
   band, a translucent-white hover/press wash, and the classic red close hover — so they sit
   flush against the title bar instead of reading as three bordered grey buttons. */
TyCaptionButton              { background: alpha(#FFFFFF, 0); color: var(--title-ink); border-radius: 0; }
TyCaptionButton:hover        { background: alpha(#FFFFFF, 0.20); color: var(--title-ink); }
TyCaptionButton:active       { background: alpha(#FFFFFF, 0.32); color: var(--title-ink); }
TyCaptionButton.close:hover  { background: #C0392B; color: #FFFFFF; }
TyCaptionButton.close:active { background: #96271B; color: #FFFFFF; }

TyLabel         { color: var(--ink); }

/* Buttons: raised bevel at rest, sunken (pressed) on :active — the classic push-button feel.
   'render-style: bevel3d' alone gives the outset bevel, square corners and edge colours
   derived from the grey face; no need to spell out border-style/width/color/radius. */
TyButton                { render-style: bevel3d; background: var(--face); color: var(--ink); font-weight: normal; padding: 6px; }
TyButton:hover          { render-style: bevel3d; background: var(--face-hover); color: var(--ink); }
TyButton:active         { render-style: inset3d;  background: var(--face); color: var(--ink); }
TyButton:disabled       { render-style: bevel3d; background: var(--face); color: var(--ink-disabled); }
TyButton.primary        { render-style: bevel3d; background: var(--face); color: var(--ink); }
TyButton.primary:hover  { render-style: bevel3d; background: var(--face-hover); }
TyButton.primary:active { render-style: inset3d;  background: var(--face); }
TyButton.ghost          { render-style: bevel3d; background: var(--face); color: var(--ink); }
TyButton.ghost:active   { render-style: inset3d;  background: var(--face); }

/* Fields: sunken white wells. */
TyEdit          { render-style: inset3d; background: var(--field); color: var(--ink); padding: 4px 6px; }
TyComboBox      { render-style: inset3d; background: var(--field); color: var(--ink); padding: 4px 6px; }

/* Check box: a white well with a grey border (the indicator box is stroked, not beveled). */
TyCheckBox      { background: var(--field); color: var(--ink); border: 1px solid var(--border); border-radius: 0; }
TyCheckBox:active { background: var(--field); color: var(--ink); border: 1px solid var(--border); border-radius: 0; }

/* Progress: a sunken grey track with a solid blue fill. */
TyProgressBar   { render-style: inset3d; background: var(--face); }
TyProgressFill  { background: var(--accent); border-radius: 0; }
