/* Ant Design — an ORIGINAL "inspired-by" ty-controls skin (NOT a pixel-perfect clone), now DUAL-MODE.
   Professional, flat with subtle depth: hair-thin borders, a blue brand accent, 6px radii and crisp ink.
   LIGHT (the original look): a soft #F5F5F5 canvas, white surfaces, #D9D9D9 hairlines, near-black 85% ink,
   the #1677FF brand blue. DARK: ~#141414 canvas, ~#1F1F1F surfaces/fields, ~#FFFFFFD9 ink, #424242 borders,
   the same blue brightened a touch (#1668DC) for contrast. Only the PALETTE flips per @mode — every radius,
   padding, gradient shape, font-weight and render-style is shared. --accent drives every primary/accent
   surface, so the runtime accent-picker recolours the whole skin in both modes (hover/active shades are
   derived from it with lighten()/darken()). */

/* --- palette: light (the original look) ---------------------------------- */
@mode light {
  :root {
    --accent:         #1677FF;   /* brand blue — primary buttons, focus, checks, progress fill */
    --window:         #F5F5F5;   /* soft neutral canvas so surfaces read as raised cards        */
    --surface:        #FFFFFF;   /* title bar, button face, field wells, checkbox              */
    --ink:            #000000D9;  /* near-black 85% primary text                                */
    --muted:          #000000A6;  /* caption-button ink                                         */
    --ink-disabled:   #00000040;  /* disabled text                                              */
    --border:         #D9D9D9;   /* hair-line borders & edges                                   */
    --disabled-fill:  #F5F5F5;   /* disabled surface fill                                       */
    --cap-hover:      #0000000F;  /* caption-button hover overlay                               */
    --cap-active:     #00000017;  /* caption-button pressed overlay                             */
    --track:          #0000000F;  /* progress trough                                            */
    --shadow-soft:    #00000004;  /* default-button drop shadow                                 */
    --shadow-primary: #1677FF1A;  /* primary-button accent-tinted drop shadow                   */
  }
}

/* --- palette: dark ------------------------------------------------------- */
@mode dark {
  :root {
    --accent:         #1668DC;   /* brand blue, brightened a touch for dark-mode contrast */
    --window:         #141414;   /* deep neutral canvas                                    */
    --surface:        #1F1F1F;   /* title bar, button face, field wells, checkbox         */
    --ink:            #FFFFFFD9;  /* light 85% primary text                                */
    --muted:          #FFFFFFA6;  /* caption-button ink                                    */
    --ink-disabled:   #FFFFFF40;  /* disabled text                                         */
    --border:         #424242;   /* subtle borders & edges                                 */
    --disabled-fill:  #262626;   /* disabled surface fill                                  */
    --cap-hover:      #FFFFFF14;  /* caption-button hover overlay                           */
    --cap-active:     #FFFFFF1F;  /* caption-button pressed overlay                         */
    --track:          #FFFFFF14;  /* progress trough                                        */
    --shadow-soft:    #00000040;  /* default-button drop shadow (deeper on dark)            */
    --shadow-primary: #1668DC40;  /* primary-button accent-tinted glow                      */
  }
}

/* Window: a soft neutral canvas so the surfaces read as raised cards. */
TyForm { background: var(--window); color: var(--ink); }

/* Title bar: clean surface header with primary ink (Ant's flat chrome). */
TyTitleBar      { background: var(--surface); color: var(--ink); border-radius: 0; }
TyCaptionButton { background: var(--surface); color: var(--muted); border-radius: 0; }
TyCaptionButton:hover  { background: var(--cap-hover); color: var(--ink); }
TyCaptionButton:active { background: var(--cap-active); color: var(--ink); }

TyLabel { color: var(--ink); }

/* Default button: surface face, hair-line border, primary ink, gentle 6px radius and a
   whisper of depth. On hover the border + text adopt the accent (Ant's signature). */
TyButton                { background: var(--surface); color: var(--ink); border: 1px solid var(--border); border-radius: 6; padding: 5px 15px; font-weight: normal; shadow: 0 2 0 var(--shadow-soft); }
TyButton:hover          { background: var(--surface); color: var(--accent); border-color: var(--accent); }
TyButton:active         { background: var(--surface); color: darken(var(--accent), 12); border-color: darken(var(--accent), 12); }
TyButton:focus          { border-color: var(--accent); outline: 2 alpha(var(--accent), 0.2); outline-offset: 0; }
TyButton:disabled       { background: var(--disabled-fill); color: var(--ink-disabled); border-color: var(--border); shadow: 0 0 0 transparent; }

/* Primary button: solid accent fill, readable ink, faint accent-tinted drop shadow. */
TyButton.primary          { background: var(--accent); color: on(var(--accent)); border: 1px solid var(--accent); border-radius: 6; padding: 5px 15px; font-weight: normal; shadow: 0 2 0 var(--shadow-primary); }
TyButton.primary:hover    { background: lighten(var(--accent), 10); border-color: lighten(var(--accent), 10); color: on(var(--accent)); }
TyButton.primary:active   { background: darken(var(--accent), 8); border-color: darken(var(--accent), 8); color: on(var(--accent)); }
TyButton.primary:focus    { outline: 2 alpha(var(--accent), 0.25); outline-offset: 1px; }
TyButton.primary:disabled { background: var(--disabled-fill); color: var(--ink-disabled); border-color: var(--border); shadow: 0 0 0 transparent; }

/* Ghost button: borderless text button that tints toward the accent on interaction. */
TyButton.ghost          { background: transparent; color: var(--accent); border: 1px solid transparent; border-radius: 6; padding: 5px 15px; font-weight: normal; }
TyButton.ghost:hover    { background: alpha(var(--accent), 0.08); color: var(--accent); }
TyButton.ghost:active   { background: alpha(var(--accent), 0.15); color: darken(var(--accent), 12); }
TyButton.ghost:disabled { background: transparent; color: var(--ink-disabled); }

/* Fields: surface wells with a hair-line border, accent on hover, an accent glow ring on focus. */
TyEdit            { background: var(--surface); color: var(--ink); border: 1px solid var(--border); border-radius: 6; padding: 5px 11px; }
TyEdit:hover      { border-color: var(--accent); }
TyEdit:focus      { border-color: var(--accent); outline: 2 alpha(var(--accent), 0.2); outline-offset: 0; }
TyEdit:disabled   { background: var(--disabled-fill); color: var(--ink-disabled); border-color: var(--border); }

TyComboBox          { background: var(--surface); color: var(--ink); border: 1px solid var(--border); border-radius: 6; padding: 5px 11px; }
TyComboBox:hover    { border-color: var(--accent); }
TyComboBox:focus    { border-color: var(--accent); outline: 2 alpha(var(--accent), 0.2); outline-offset: 0; }
TyComboBox:disabled { background: var(--disabled-fill); color: var(--ink-disabled); border-color: var(--border); }

/* Check box: a small surface well with a hair-line border and an accent tick; the box is
   stroked (render-style would not bevel it), border warms to the accent on interaction. */
TyCheckBox          { background: var(--surface); color: var(--accent); border: 1px solid var(--border); border-radius: 4; }
TyCheckBox:hover    { border-color: var(--accent); }
TyCheckBox:active   { background: var(--surface); color: var(--accent); border: 1px solid var(--accent); border-radius: 4; }
TyCheckBox:disabled { background: var(--disabled-fill); color: var(--ink-disabled); border-color: var(--border); }

/* Progress: a faint rounded trail with a solid accent fill (both pill-rounded). */
TyProgressBar  { background: var(--track); border-radius: 100; }
TyProgressFill { background: var(--accent); border-radius: 100; }
