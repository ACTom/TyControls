/* material3 — an ORIGINAL "inspired-by" take on Material Design 3 (Material You).
   Not a pixel clone: rounded/pill-ish geometry, tonal purple surfaces, soft
   elevation shadows and flat (no-bevel) fills. Single fixed palette.
   --accent is the M3 primary; everything tonal is derived from it via mix()/alpha()
   so the runtime accent-picker recolours the whole skin coherently. */

:root { --accent: #6750A4; }   /* M3 primary purple */

/* Window: the M3 tonal "surface" (a faint purple-tinted white). */
TyForm          { background: #FEF7FF; }

/* Top app bar: a low-elevation tonal surface-container, dark on-surface ink. */
TyTitleBar      { background: mix(#FFFFFF, var(--accent), 8%); color: #1D1B20; border-radius: 0; font-family: Roboto; }
TyCaptionButton { background: transparent; color: #49454F; border-radius: 12px; }
TyCaptionButton:hover  { background: alpha(var(--accent), 0.12); color: #1D1B20; }
TyCaptionButton:active { background: alpha(var(--accent), 0.20); color: #1D1B20; }

TyLabel         { color: #1D1B20; font-family: Roboto; }

/* Default button = M3 "filled tonal": light-purple secondary-container fill,
   dark tonal ink, pill-ish 12px corners, generous 10px padding, faint elevation. */
TyButton          { background: mix(#FFFFFF, var(--accent), 16%); color: darken(var(--accent), 45%); border-width: 0; border-radius: 12px; padding: 10px; font-family: Roboto; font-weight: 500; shadow: 0 1 2 #00000022; }
TyButton:hover    { background: mix(#FFFFFF, var(--accent), 24%); shadow: 0 2 5 #0000002E; }
TyButton:active   { background: mix(#FFFFFF, var(--accent), 32%); shadow: 0 1 2 #00000022; }
TyButton:disabled { background: alpha(#1D1B20, 0.08); color: alpha(#1D1B20, 0.38); shadow: 0 0 0 #00000000; }

/* Primary = M3 "filled" button: solid accent, readable white ink, soft shadow;
   hover/press lighten via a white state layer and lift/settle the elevation. */
TyButton.primary          { background: var(--accent); color: on(var(--accent)); border-width: 0; border-radius: 12px; padding: 10px; font-family: Roboto; font-weight: 500; shadow: 0 1 3 #0000002A; }
TyButton.primary:hover    { background: mix(var(--accent), #FFFFFF, 8%); shadow: 0 2 6 #00000033; }
TyButton.primary:active   { background: mix(var(--accent), #FFFFFF, 14%); shadow: 0 1 2 #0000002A; }
TyButton.primary:disabled { background: alpha(#1D1B20, 0.12); color: alpha(#1D1B20, 0.38); shadow: 0 0 0 #00000000; }

/* Ghost = M3 "text" button: no fill/border, accent ink, tonal state layer on hover. */
TyButton.ghost          { background: transparent; color: var(--accent); border-width: 0; border-radius: 12px; padding: 10px; font-family: Roboto; font-weight: 500; shadow: 0 0 0 #00000000; }
TyButton.ghost:hover    { background: alpha(var(--accent), 0.10); color: var(--accent); }
TyButton.ghost:active   { background: alpha(var(--accent), 0.16); color: var(--accent); }
TyButton.ghost:disabled { background: transparent; color: alpha(#1D1B20, 0.38); }

/* Fields = M3 "outlined" text field: white well, outline stroke, 10px corners;
   hover darkens the outline, focus swaps to a 2px accent outline. */
TyEdit          { background: #FFFFFF; color: #1D1B20; border: 1px solid #79747E; border-radius: 10px; padding: 10px; font-family: Roboto; }
TyEdit:hover    { border-color: #1D1B20; }
TyEdit:focus    { border: 2px solid var(--accent); }
TyEdit:disabled { background: alpha(#1D1B20, 0.04); color: alpha(#1D1B20, 0.38); border-color: alpha(#1D1B20, 0.12); }

TyComboBox          { background: #FFFFFF; color: #1D1B20; border: 1px solid #79747E; border-radius: 10px; padding: 10px; font-family: Roboto; }
TyComboBox:hover    { border-color: #1D1B20; }
TyComboBox:focus    { border: 2px solid var(--accent); }
TyComboBox:disabled { background: alpha(#1D1B20, 0.04); color: alpha(#1D1B20, 0.38); border-color: alpha(#1D1B20, 0.12); }

/* Checkbox: unchecked = white box, 2px outline stroke, small 4px radius.
   Checked resolves :active -> the box fills with accent and the tick inks white. */
TyCheckBox          { background: #FFFFFF; color: var(--accent); border: 2px solid #79747E; border-radius: 4px; }
TyCheckBox:hover    { border-color: var(--accent); }
TyCheckBox:active   { background: var(--accent); color: on(var(--accent)); border: 2px solid var(--accent); border-radius: 4px; }
TyCheckBox:disabled { background: alpha(#1D1B20, 0.04); color: alpha(#1D1B20, 0.38); border-color: alpha(#1D1B20, 0.20); }

/* Linear progress: light tonal track, solid accent fill, both fully pill-rounded. */
TyProgressBar   { background: mix(#FFFFFF, var(--accent), 14%); border-radius: 8px; }
TyProgressFill  { background: var(--accent); border-radius: 8px; }
