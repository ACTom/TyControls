/* material3 — an ORIGINAL "inspired-by" take on Material Design 3 (Material You),
   now DUAL-MODE (light + dark). Not a pixel clone: rounded/pill-ish geometry,
   tonal purple surfaces, soft elevation shadows and flat (no-bevel) fills.
   Only the PALETTE flips per @mode — every radius, mix/gradient shape, padding,
   font-weight and shadow is shared across both modes.
   LIGHT: the original look — a faint purple-tinted-white surface, white fields,
   dark on-surface ink, M3 primary purple.
   DARK: ~#141218 surfaces, ~#1D1B20 fields, light on-surface ink, subtle outline,
   and a lighter tonal purple accent (~#D0BCFF) for contrast — rounded + soft
   elevation kept.
   --accent is the M3 primary in each mode; everything tonal is derived from it via
   mix()/alpha() so the runtime accent-picker recolours the whole skin coherently. */

/* --- palette: light (the original look) ---------------------------------- */
@mode light {
  :root {
    --accent:      #6750A4;   /* M3 primary purple — brand/accent seed        */
    --surface:     #FEF7FF;   /* window: tonal surface (faint purple-white)   */
    --tonal-base:  #FFFFFF;   /* base that accent is mixed into for tonal fills */
    --field:       #FFFFFF;   /* text-entry / checkbox wells                  */
    --ink:         #1D1B20;   /* primary on-surface ink                       */
    --ink-muted:   #49454F;   /* secondary on-surface ink (caption glyphs)    */
    --outline:     #79747E;   /* field / checkbox outline stroke              */
    --btn-ink:     darken(var(--accent), 45%);  /* filled-tonal button ink    */
  }
}

/* --- palette: dark ------------------------------------------------------- */
@mode dark {
  :root {
    --accent:      #D0BCFF;   /* M3 primary, brightened for dark-mode contrast */
    --surface:     #141218;   /* window: darkest tonal surface                */
    --tonal-base:  #1D1B20;   /* dark base that accent is mixed into (elevation) */
    --field:       #1D1B20;   /* text-entry / checkbox wells                  */
    --ink:         #E6E0E9;   /* primary on-surface ink (light)               */
    --ink-muted:   #CAC4D0;   /* secondary on-surface ink                     */
    --outline:     #938F99;   /* field / checkbox outline stroke              */
    --btn-ink:     lighten(var(--accent), 15%);  /* filled-tonal button ink   */
  }
}

/* Window: the M3 tonal "surface". */
TyForm          { background: var(--surface); }

/* Top app bar: a low-elevation tonal surface-container, on-surface ink. */
TyTitleBar      { background: mix(var(--tonal-base), var(--accent), 8%); color: var(--ink); border-radius: 0; font-family: Roboto; }
TyCaptionButton { background: transparent; color: var(--ink-muted); border-radius: 12px; }
TyCaptionButton:hover  { background: alpha(var(--accent), 0.12); color: var(--ink); }
TyCaptionButton:active { background: alpha(var(--accent), 0.20); color: var(--ink); }

TyLabel         { color: var(--ink); font-family: Roboto; }

/* Default button = M3 "filled tonal": light-tonal secondary-container fill,
   tonal ink, pill-ish 12px corners, generous 10px padding, faint elevation. */
TyButton          { background: mix(var(--tonal-base), var(--accent), 16%); color: var(--btn-ink); border-width: 0; border-radius: 12px; padding: 10px; font-family: Roboto; font-weight: 500; shadow: 0 1 2 #00000022; }
TyButton:hover    { background: mix(var(--tonal-base), var(--accent), 24%); shadow: 0 2 5 #0000002E; }
TyButton:active   { background: mix(var(--tonal-base), var(--accent), 32%); shadow: 0 1 2 #00000022; }
TyButton:disabled { background: alpha(var(--ink), 0.08); color: alpha(var(--ink), 0.38); shadow: 0 0 0 #00000000; }

/* Primary = M3 "filled" button: solid accent, auto-contrast ink, soft shadow;
   hover/press lighten via a white state layer and lift/settle the elevation. */
TyButton.primary          { background: var(--accent); color: on(var(--accent)); border-width: 0; border-radius: 12px; padding: 10px; font-family: Roboto; font-weight: 500; shadow: 0 1 3 #0000002A; }
TyButton.primary:hover    { background: mix(var(--accent), #FFFFFF, 8%); shadow: 0 2 6 #00000033; }
TyButton.primary:active   { background: mix(var(--accent), #FFFFFF, 14%); shadow: 0 1 2 #0000002A; }
TyButton.primary:disabled { background: alpha(var(--ink), 0.12); color: alpha(var(--ink), 0.38); shadow: 0 0 0 #00000000; }

/* Ghost = M3 "text" button: no fill/border, accent ink, tonal state layer on hover. */
TyButton.ghost          { background: transparent; color: var(--accent); border-width: 0; border-radius: 12px; padding: 10px; font-family: Roboto; font-weight: 500; shadow: 0 0 0 #00000000; }
TyButton.ghost:hover    { background: alpha(var(--accent), 0.10); color: var(--accent); }
TyButton.ghost:active   { background: alpha(var(--accent), 0.16); color: var(--accent); }
TyButton.ghost:disabled { background: transparent; color: alpha(var(--ink), 0.38); }

/* Fields = M3 "outlined" text field: field well, outline stroke, 10px corners;
   hover darkens the outline to ink, focus swaps to a 2px accent outline. */
TyEdit          { background: var(--field); color: var(--ink); border: 1px solid var(--outline); border-radius: 10px; padding: 10px; font-family: Roboto; }
TyEdit:hover    { border-color: var(--ink); }
TyEdit:focus    { border: 2px solid var(--accent); }
TyEdit:disabled { background: alpha(var(--ink), 0.04); color: alpha(var(--ink), 0.38); border-color: alpha(var(--ink), 0.12); }

TyComboBox          { background: var(--field); color: var(--ink); border: 1px solid var(--outline); border-radius: 10px; padding: 10px; font-family: Roboto; }
TyComboBox:hover    { border-color: var(--ink); }
TyComboBox:focus    { border: 2px solid var(--accent); }
TyComboBox:disabled { background: alpha(var(--ink), 0.04); color: alpha(var(--ink), 0.38); border-color: alpha(var(--ink), 0.12); }

/* Checkbox: unchecked = field well, 2px outline stroke, small 4px radius.
   Checked resolves :active -> the box fills with accent and the tick inks via on(). */
TyCheckBox          { background: var(--field); color: var(--accent); border: 2px solid var(--outline); border-radius: 4px; }
TyCheckBox:hover    { border-color: var(--accent); }
TyCheckBox:active   { background: var(--accent); color: on(var(--accent)); border: 2px solid var(--accent); border-radius: 4px; }
TyCheckBox:disabled { background: alpha(var(--ink), 0.04); color: alpha(var(--ink), 0.38); border-color: alpha(var(--ink), 0.20); }

/* Linear progress: light tonal track, solid accent fill, both fully pill-rounded. */
TyProgressBar   { background: mix(var(--tonal-base), var(--accent), 14%); border-radius: 8px; }
TyProgressFill  { background: var(--accent); border-radius: 8px; }
