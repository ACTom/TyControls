/* Bootstrap — an original ty-controls skin inspired by Bootstrap 5's flat, clean web look, now DUAL-MODE.
   Solid blue primary on white ink, subtle grey secondary/outline, 6px radii, soft-grey field borders and an
   accent focus ring. LIGHT (the original look): white surfaces on a #F8F9FA body, #CED4DA field borders,
   #212529 ink, the #0D6EFD brand blue. DARK (like data-bs-theme=dark): a #212529 body, #2B3035 field wells,
   #495057 borders, light #DEE2E6 ink, the same blue brightened a touch (#3D8BFD) for contrast. Only the
   PALETTE flips per @mode — every radius, padding, border-width, render-style and font-weight is shared, and
   the secondary-button grey shades stay fixed. --accent drives every primary/accent/focus surface, so the
   runtime accent-picker recolours the whole skin in both modes. */

/* --- palette: light (the original look) ---------------------------------- */
@mode light {
  :root {
    --accent:       #0D6EFD;   /* Bootstrap primary blue                       */
    --surface:      #FFFFFF;   /* cards / fields                               */
    --window:       #F8F9FA;   /* body-bg (bootstrap gray-100)                 */
    --border:       #DEE2E6;   /* gray-300 dividers                            */
    --field-border: #CED4DA;   /* gray-400 input border                       */
    --ink:          #212529;   /* gray-900 body text                          */
    --muted:        #6C757D;   /* gray-600 secondary (caption + secondary btn) */
    --subtle:       #E9ECEF;   /* gray-200 hover / disabled fill / track       */
    --cap-active:   #DEE2E6;   /* caption-button pressed fill                  */
  }
}

/* --- palette: dark (data-bs-theme=dark) ---------------------------------- */
@mode dark {
  :root {
    --accent:       #3D8BFD;   /* brand blue, brightened a touch for dark contrast */
    --surface:      #2B3035;   /* field wells / cards                              */
    --window:       #212529;   /* body-bg (bootstrap dark body)                    */
    --border:       #495057;   /* gray-700 dividers                                */
    --field-border: #495057;   /* input border                                    */
    --ink:          #DEE2E6;   /* light body text                                 */
    --muted:        #6C757D;   /* secondary (kept mid-grey for secondary btn)     */
    --subtle:       #343A40;   /* elevated dark fill / disabled / track           */
    --cap-active:   #495057;   /* caption-button pressed fill                     */
  }
}

/* --- mode-invariant: fixed secondary-button grey shades ------------------- */
:root {
  --btn2-hover-bg:      #5C636A;
  --btn2-hover-border:  #565E64;
  --btn2-active-bg:     #565E64;
  --btn2-active-border: #51585E;
}

/* ---- Window & chrome ---------------------------------------------------- */
TyForm {
  background: var(--window);
  color: var(--ink);
}

TyTitleBar {
  background: var(--surface);
  color: var(--ink);
  border-radius: 0;
}

TyCaptionButton {
  background: var(--surface);
  color: var(--muted);
  border-radius: 4px;
}
TyCaptionButton:hover {
  background: var(--subtle);
  color: var(--ink);
}
TyCaptionButton:active {
  background: var(--cap-active);
  color: var(--ink);
}

/* ---- Text --------------------------------------------------------------- */
TyLabel {
  color: var(--ink);
}

/* ---- Buttons ------------------------------------------------------------ */
/* Default = Bootstrap "secondary" grey solid */
TyButton {
  background: var(--muted);
  color: on(var(--muted));
  border: 1px solid var(--muted);
  border-radius: 6px;
  font-weight: normal;
  padding: 7px 14px;
}
TyButton:hover {
  background: var(--btn2-hover-bg);
  border-color: var(--btn2-hover-border);
}
TyButton:active {
  background: var(--btn2-active-bg);
  border-color: var(--btn2-active-border);
}
TyButton:focus {
  outline: 3px alpha(var(--muted), 0.5);
  outline-offset: 1px;
}
TyButton:disabled {
  background: var(--muted);
  border-color: var(--muted);
  color: on(var(--muted));
  opacity: 0.65;
}

/* Primary = solid brand blue, white ink */
TyButton.primary {
  background: var(--accent);
  color: on(var(--accent));
  border: 1px solid var(--accent);
  border-radius: 6px;
}
TyButton.primary:hover {
  background: darken(var(--accent), 8);
  border-color: darken(var(--accent), 12);
}
TyButton.primary:active {
  background: darken(var(--accent), 14);
  border-color: darken(var(--accent), 18);
}
TyButton.primary:focus {
  outline: 3px alpha(var(--accent), 0.5);
  outline-offset: 1px;
}
TyButton.primary:disabled {
  background: var(--accent);
  border-color: var(--accent);
  color: on(var(--accent));
  opacity: 0.65;
}

/* Ghost = outline-primary: transparent fill, blue ink + blue border */
TyButton.ghost {
  background: transparent;
  color: var(--accent);
  border: 1px solid var(--accent);
  border-radius: 6px;
}
TyButton.ghost:hover {
  background: var(--accent);
  color: on(var(--accent));
  border-color: var(--accent);
}
TyButton.ghost:active {
  background: darken(var(--accent), 8);
  color: on(var(--accent));
  border-color: darken(var(--accent), 8);
}
TyButton.ghost:focus {
  outline: 3px alpha(var(--accent), 0.5);
  outline-offset: 1px;
}
TyButton.ghost:disabled {
  background: transparent;
  color: var(--accent);
  border-color: var(--accent);
  opacity: 0.65;
}

/* ---- Inputs ------------------------------------------------------------- */
TyEdit {
  background: var(--surface);
  color: var(--ink);
  border: 1px solid var(--field-border);
  border-radius: 6px;
  padding: 7px 10px;
}
TyEdit:focus {
  border-color: lighten(var(--accent), 15);
  outline: 4px alpha(var(--accent), 0.25);
  outline-offset: 0px;
}
TyEdit:disabled {
  background: var(--subtle);
  color: var(--muted);
  border-color: var(--field-border);
}

TyComboBox {
  background: var(--surface);
  color: var(--ink);
  border: 1px solid var(--field-border);
  border-radius: 6px;
  padding: 7px 10px;
}
TyComboBox:focus {
  border-color: lighten(var(--accent), 15);
  outline: 4px alpha(var(--accent), 0.25);
  outline-offset: 0px;
}
TyComboBox:disabled {
  background: var(--subtle);
  color: var(--muted);
  border-color: var(--field-border);
}

/* ---- Checkbox (stroked indicator: background + border + tick color) ----- */
TyCheckBox {
  background: var(--surface);
  color: var(--ink);
  border: 1px solid var(--field-border);
  border-radius: 4px;
}
TyCheckBox:hover {
  border-color: var(--accent);
}
TyCheckBox:active {
  border-color: darken(var(--accent), 10);
}
TyCheckBox:focus {
  outline: 4px alpha(var(--accent), 0.25);
  outline-offset: 1px;
}
TyCheckBox:selected {
  background: var(--accent);
  border-color: var(--accent);
  color: on(var(--accent));
}
TyCheckBox:disabled {
  background: var(--subtle);
  border-color: var(--field-border);
  color: var(--muted);
  opacity: 0.65;
}

/* ---- Progress ----------------------------------------------------------- */
TyProgressBar {
  background: var(--subtle);
  border-radius: 6px;
}
TyProgressFill {
  background: var(--accent);
  border-radius: 6px;
}
