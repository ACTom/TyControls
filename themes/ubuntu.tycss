/* ubuntu — an ORIGINAL "inspired-by" take on Ubuntu's Yaru look (not a pixel clone).
   Warm & flat: Ubuntu orange accent, an aubergine title-bar band, light warm
   surfaces, crisp white fields, 4px radii and thin warm-grey borders. Single mode. */

:root {
  --accent:     #E95420;   /* Ubuntu orange — brand; runtime accent-picker recolours from here */
  --aubergine:  #2C001E;   /* the classic Ubuntu title-bar band */
  --surface:    #FAFAFA;   /* window / warm off-white */
  --field:      #FFFFFF;   /* input wells */
  --border:     #C7C2BD;   /* thin warm-grey hairline */
  --ink:        #2C2C2C;   /* primary text */
  --muted:      #8E8A85;   /* disabled / secondary ink */
  --btn-face:   #F6F5F4;   /* neutral button face (Yaru "light") */
}

/* Window & text */
TyForm   { background: var(--surface); }
TyLabel  { color: var(--ink); font-family: Ubuntu; }

/* Title bar — aubergine band, white caption, flat and square. */
TyTitleBar      { background: var(--aubergine); color: #FFFFFF; border-radius: 0; font-family: Ubuntu; }
TyCaptionButton { background: var(--aubergine); color: #FFFFFF; border-radius: 4px; }
TyCaptionButton:hover  { background: lighten(var(--aubergine), 14%); color: #FFFFFF; }
TyCaptionButton:active { background: var(--accent); color: on(var(--accent)); }

/* Neutral button — light warm face, thin border, rounded. */
TyButton          { background: var(--btn-face); color: var(--ink); border: 1px solid var(--border); border-radius: 4px; padding: 6px 14px; font-family: Ubuntu; font-weight: bold; }
TyButton:hover    { background: darken(var(--btn-face), 4%); border-color: darken(var(--border), 6%); }
TyButton:active   { background: darken(var(--btn-face), 9%); border-color: darken(var(--border), 12%); }
TyButton:focus    { border-color: var(--accent); outline: 2px alpha(var(--accent), 0.45); outline-offset: 2px; }
TyButton:disabled { background: var(--btn-face); color: var(--muted); border-color: var(--border); opacity: 0.6; }

/* Primary — solid Ubuntu orange, white ink, borderless. */
TyButton.primary          { background: var(--accent); color: on(var(--accent)); border: 1px solid var(--accent); border-radius: 4px; padding: 6px 14px; font-weight: bold; }
TyButton.primary:hover    { background: darken(var(--accent), 6%); border-color: darken(var(--accent), 6%); }
TyButton.primary:active   { background: darken(var(--accent), 12%); border-color: darken(var(--accent), 12%); }
TyButton.primary:focus    { outline: 2px alpha(var(--accent), 0.55); outline-offset: 2px; }
TyButton.primary:disabled { background: alpha(var(--accent), 0.5); border-color: transparent; color: #FFFFFF; opacity: 0.8; }

/* Ghost — flat, orange ink, tint on interaction. */
TyButton.ghost          { background: transparent; color: var(--accent); border: 1px solid transparent; border-radius: 4px; padding: 6px 14px; font-weight: bold; }
TyButton.ghost:hover    { background: alpha(var(--accent), 0.10); color: var(--accent); }
TyButton.ghost:active   { background: alpha(var(--accent), 0.18); color: darken(var(--accent), 8%); }
TyButton.ghost:disabled { background: transparent; color: var(--muted); opacity: 0.6; }

/* Fields — crisp white wells, thin border, orange focus. */
TyEdit          { background: var(--field); color: var(--ink); border: 1px solid var(--border); border-radius: 4px; padding: 5px 8px; font-family: Ubuntu; }
TyEdit:focus    { border-color: var(--accent); outline: 2px alpha(var(--accent), 0.35); outline-offset: 0px; }
TyEdit:disabled { background: darken(var(--field), 4%); color: var(--muted); }
TyComboBox          { background: var(--field); color: var(--ink); border: 1px solid var(--border); border-radius: 4px; padding: 5px 8px; font-family: Ubuntu; }
TyComboBox:focus    { border-color: var(--accent); outline: 2px alpha(var(--accent), 0.35); }
TyComboBox:disabled { background: darken(var(--field), 4%); color: var(--muted); }

/* Check box — stroked white box; checked fills solid orange with a white tick. */
TyCheckBox           { background: var(--field); color: var(--accent); border: 1px solid var(--border); border-radius: 4px; }
TyCheckBox:hover     { border-color: var(--accent); }
TyCheckBox:active    { background: var(--field); border-color: var(--accent); }
TyCheckBox:selected  { background: var(--accent); color: on(var(--accent)); border-color: var(--accent); }
TyCheckBox:focus     { outline: 2px alpha(var(--accent), 0.40); outline-offset: 2px; }

/* Progress — flat warm track, solid orange fill. */
TyProgressBar  { background: #E4E1DE; border: 1px solid var(--border); border-radius: 4px; }
TyProgressFill { background: var(--accent); border-radius: 4px; }
