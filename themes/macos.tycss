/* macOS — an ORIGINAL "inspired-by" Aqua / Big Sur take (not a pixel clone).
   Light gray surfaces, white fields, hairline borders, a system-blue accent,
   soft rounded buttons with a whisper of a top gradient, and a soft focus ring.
   Single fixed light palette. Recolour the whole skin by changing --accent. */

:root {
  --accent:  #0A84FF;   /* macOS system blue — drives every primary/accent surface */
  --surface: #ECECEC;   /* window / control chrome */
  --field:   #FFFFFF;   /* editable wells */
  --border:  #D0D0D0;   /* hairline */
  --ink:     #1D1D1F;   /* near-black label text */
}

/* Window + unified light title bar. */
TyForm          { background: var(--surface); }
TyTitleBar      { background: linear-gradient(0deg, #E4E4E4, #F1F1F1); color: #3A3A3C; border-radius: 6 6 0 0; }
TyCaptionButton { background: transparent; color: #5B5B5D; border-radius: 4; }
TyCaptionButton:hover  { background: alpha(#000000, 0.08); color: #2A2A2C; }
TyCaptionButton:active { background: alpha(#000000, 0.14); }

TyLabel         { color: var(--ink); }

/* Buttons: white face, very subtle top-lighter gradient, hairline, soft shadow, rounded. */
TyButton                { background: linear-gradient(0deg, #F3F3F3, #FFFFFF); color: #1D1D1F; border: 1px solid var(--border); border-radius: 6; padding: 5px 14px; font-weight: normal; shadow: 0 1 2 #0000001F; }
TyButton:hover          { background: linear-gradient(0deg, #ECECEC, #FBFBFB); border-color: #C6C6C6; }
TyButton:active         { background: linear-gradient(0deg, #E0E0E0, #E9E9E9); border-color: #BFBFBF; shadow: 0 0 0 transparent; }
TyButton:focus          { border-color: var(--accent); outline: 3 alpha(var(--accent), 0.40); outline-offset: 1; }
TyButton:disabled       { background: #F2F2F2; color: #A6A6A8; border-color: #DCDCDC; opacity: 0.55; shadow: 0 0 0 transparent; }

/* Primary: solid system-blue pill, white ink, glossy top, soft blue shadow. */
TyButton.primary        { background: linear-gradient(0deg, var(--accent), lighten(var(--accent), 10%)); color: on(var(--accent)); border: 1px solid darken(var(--accent), 8%); border-radius: 6; padding: 5px 14px; font-weight: bold; shadow: 0 1 3 #0A84FF59; }
TyButton.primary:hover  { background: linear-gradient(0deg, lighten(var(--accent), 4%), lighten(var(--accent), 14%)); }
TyButton.primary:active { background: linear-gradient(0deg, darken(var(--accent), 8%), var(--accent)); shadow: 0 1 2 #0A84FF4D; }
TyButton.primary:focus  { outline: 3 alpha(var(--accent), 0.40); outline-offset: 1; }
TyButton.primary:disabled { background: mix(var(--accent), #FFFFFF, 55%); color: #FFFFFF; border-color: mix(var(--accent), #FFFFFF, 40%); opacity: 0.6; shadow: 0 0 0 transparent; }

/* Ghost: text-style blue button, transparent until hovered. */
TyButton.ghost          { background: transparent; color: var(--accent); border: 1px solid transparent; border-radius: 6; padding: 5px 14px; font-weight: normal; shadow: 0 0 0 transparent; }
TyButton.ghost:hover    { background: alpha(var(--accent), 0.10); color: darken(var(--accent), 6%); }
TyButton.ghost:active   { background: alpha(var(--accent), 0.18); }
TyButton.ghost:disabled { background: transparent; color: #A6A6A8; opacity: 0.55; }

/* Fields: clean white wells, hairline border, soft blue focus ring. */
TyEdit          { background: var(--field); color: var(--ink); border: 1px solid var(--border); border-radius: 6; padding: 5px 8px; }
TyEdit:hover    { border-color: #BFBFBF; }
TyEdit:focus    { border-color: var(--accent); outline: 3 alpha(var(--accent), 0.35); outline-offset: 0; }
TyEdit:disabled { background: #F5F5F5; color: #A6A6A8; border-color: #E0E0E0; }

TyComboBox          { background: var(--field); color: var(--ink); border: 1px solid var(--border); border-radius: 6; padding: 5px 8px; }
TyComboBox:hover    { border-color: #BFBFBF; }
TyComboBox:focus    { border-color: var(--accent); outline: 3 alpha(var(--accent), 0.35); outline-offset: 0; }
TyComboBox:disabled { background: #F5F5F5; color: #A6A6A8; border-color: #E0E0E0; }

/* Check box: white rounded well; checked = accent fill with white tick (stroked, not beveled). */
TyCheckBox          { background: var(--field); color: var(--accent); border: 1px solid #B8B8B8; border-radius: 4; }
TyCheckBox:hover    { border-color: var(--accent); }
TyCheckBox:active   { background: #F0F0F0; border-color: var(--accent); }
TyCheckBox:selected { background: var(--accent); color: on(var(--accent)); border-color: darken(var(--accent), 8%); border-radius: 4; }
TyCheckBox:focus    { border-color: var(--accent); outline: 3 alpha(var(--accent), 0.35); outline-offset: 1; }
TyCheckBox:disabled { background: #F5F5F5; color: #C4C4C4; border-color: #DCDCDC; }

/* Progress: soft light-gray track, glossy accent fill, both fully rounded. */
TyProgressBar   { background: #E2E2E2; color: var(--ink); border: 1px solid #D6D6D6; border-radius: 5; }
TyProgressFill  { background: linear-gradient(0deg, var(--accent), lighten(var(--accent), 12%)); border-radius: 5; }
