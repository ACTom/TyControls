/* TyAdvanceChart -- advchart.tycss: the chart's own tokens and rules.

   An add-on of the core's base layer, not a theme of its own. The generated unit
   tyControls.AdvanceChart.Theme compiles this file in (scripts/gen-advchart-theme.ps1; never
   edit that unit by hand) and registers it in its initialization as the add-on "advchart"
   (TyRegisterAddOnCss). Every style model then loads it into its base layer after the whole
   of light.tycss and before the per-mode contrast snippet, so every theme, built-in or not,
   inherits these keys and tokens where it says nothing of its own, exactly as it did when
   they lived in light.tycss. A skin restyles them the way it restyles any other key.

   Everything here is said in light.tycss's vocabulary (--accent, --surface, --on-surface,
   --border, --muted, the type scale ...), so a skin that restyles those gets a matching
   chart for nothing. */

:root {
  /* -- size tokens: the chart's geometry (density phase 3) --
     classic value == the chart's Pascal constant today; a density pack may override
     these names. */
  --advchart-label-margin: 8px;
  --advchart-minor-tick-length: 3px;
  --advchart-name-gap: 15px;
  --advchart-single-tick-length: 6px;
  --advchart-tick-length: 5px;
  --advchart-axispointer-margin: 3px;
  --advchart-tooltip-gap: 20px;
  --advchart-tooltip-gutter: 20px;
  --advchart-tooltip-marker: 10px;
  --advchart-tooltip-marker-gap: 6px;
}

/* The chart control itself: the same frame as a panel's (light.tycss's TyPanel group). */
TyAdvChart {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius);
  padding: var(--pad-container);
}

/* AdvChart: the series palette, DERIVED.

   Item 18 asks for a derived ramp and this is what that buys: a skin that
   restyles --accent gets a matching chart for nothing, and one that restyles
   neither still gets a legible one. The eight TyChartSeries* keys in light.tycss are
   the OLD chart's, and they are eight literals -- exactly what makes a chart look
   pasted on top of a theme instead of drawn in it.

   The ramp walks away from --accent in both directions rather than around a
   hue circle, because a hue rotation has no idea what the theme's accent is for
   and lands on colours a brand would not have chosen. Slot 1 IS the accent, so
   a single-series chart is drawn in the theme's own colour.

   Eight slots, cycled by (index mod 8), matching the old chart so nothing has
   to learn a second rule. */
TyAdvChartSeries1 { background: var(--accent); }
TyAdvChartSeries2 { background: mix(var(--accent), var(--on-surface), 35%); }
TyAdvChartSeries3 { background: lighten(var(--accent), 22%); }
TyAdvChartSeries4 { background: darken(var(--accent), 18%); }
TyAdvChartSeries5 { background: mix(var(--accent), var(--surface), 40%); }
TyAdvChartSeries6 { background: mix(var(--accent), var(--on-surface), 65%); }
TyAdvChartSeries7 { background: lighten(var(--accent), 38%); }
TyAdvChartSeries8 { background: darken(var(--accent), 34%); }
TyAdvChartSeries9 { background: mix(var(--accent), var(--on-surface), 15%); }

/* AdvChart: the axis domain. Eight keys and four metrics, and the COUNT is part
   of the design -- twelve things can be checked by eye across seventeen themes
   and sixty-four cannot, so this is the smallest set that still lets a skin
   restyle an axis without touching the control.

   Every colour DERIVES from a semantic token the theme already defines. A skin
   that restyled --border or --on-surface gets a matching axis for nothing, and
   one that restyled neither still gets a legible one. Not a literal anywhere:
   a hardcoded grey is exactly what makes a chart look pasted on top of a dark
   theme rather than drawn in it.

   These are NEW keys, so every existing skin inherits them from this base layer
   untouched -- which is the only reason a change this wide is safe to make in
   one pass. A skin that later writes any rule for one of them replaces the
   whole key, variants included; that is this library's rule and it is why the
   set is small enough to re-check. */
TyAdvChartAxisLine  { border-color: var(--border); border-width: 1px; }
TyAdvChartAxisTick  { border-color: var(--border); border-width: 1px; }
/* [R5-G] a shown grid's border (grid.show): upstream's tokens.color.neutral30 */
TyAdvChartGridBorder { border-color: #b7b9be; border-width: 1px; }
/* Muted, not full ink: an axis label is a reference, not content. --muted is
   already alpha over --on-surface, so it follows a dark theme by itself. */
TyAdvChartAxisLabel { color: var(--muted); font-size: var(--font-size-base); }
TyAdvChartAxisName  { color: var(--on-surface); font-size: var(--font-size-base); }
/* The heavier label a TIME axis gives its coarse ticks -- the `Mar` in a run
   of day numbers. Upstream carries it as a rich-text style on the time axis'
   own defaults; here it is a key of its own so a skin can make the level
   marker darker, or larger, or nothing special at all. */
TyAdvChartAxisLabelPrimary { color: var(--muted); font-size: var(--font-size-base);
                             font-weight: var(--font-weight-bold); }
/* Alpha over --border, NEVER over --surface. On an image theme a translucent
   surface reads as a bright halo instead of a faint line -- this library has
   shipped that bug once already. */
TyAdvChartSplitLine { border-color: alpha(var(--border), 0.6); border-width: 1px; }
/* The alternating band. Alpha over the ink rather than a grey, so it darkens a
   light theme and lightens a dark one from the same declaration. */
TyAdvChartSplitArea { background: alpha(var(--on-surface), 0.04); }
TyAdvChartMinorTick { border-color: alpha(var(--border), 0.4); border-width: 1px; }
TyAdvChartMinorSplitLine { border-color: alpha(var(--border), 0.35); border-width: 1px; }
/* The ring a pie draws when it has no data at all. Upstream hard-codes
   lightgray; alpha over the ink instead, so it stays faint on either mode. */
TyAdvChartEmptyCircle { background: alpha(var(--on-surface), 0.10); }
/* showBackground: the strip behind a bar, the height of the plot. Upstream
   writes rgba(180,180,180,0.2) into the series default, which is a pale grey
   band across a dark skin; alpha over the ink darkens one and lightens the
   other from the same declaration. */
TyAdvChartBarBackground { background: alpha(var(--on-surface), 0.10); }
/* A TREE'S NODES AND EDGES. Upstream names the colours in the series'
   defaults -- lightsteelblue for a node, a light grey for an edge -- and a
   tree takes no palette slot; here they are keys, so a skin gives its trees
   its own accent and its own line ink. */
TyAdvChartTreeNode { background: alpha(var(--accent), 0.55); }
TyAdvChartTreeEdge { border-color: var(--border); border-width: 1px; }
/* A TREEMAP'S LABELS AND ITS BREADCRUMB. Upstream writes the label white --
   a fixed ink over palette fills, which do not change with the mode, so
   neither does this -- and draws the breadcrumb as a pale chip with
   secondary text: here the chip is alpha over the ink and the text muted,
   so a dark skin gets a dark chip. */
TyAdvChartTreemapLabel { color: #FFFFFF; font-size: var(--font-size-base); }
TyAdvChartBreadcrumb { background: alpha(var(--on-surface), 0.08); color: var(--muted); font-size: var(--font-size-base); }
/* A hovered breadcrumb item. Upstream lifts it to the page's own ground
   (tokens.color.background); the words keep their colour. */
TyAdvChartBreadcrumb:hover { background: var(--surface); color: var(--muted); font-size: var(--font-size-base); }
/* A SANKEY'S LINKS. Upstream fills them a mid grey at 0.2 opacity; here the
   grey is the ink's own muted tone, so a dark skin's links stay grey on
   its ground. */
TyAdvChartSankeyLink { background: var(--muted); }
/* The chart's own title and subtitle. Upstream draws them at 18/bold and
   12/regular; the sizes come from the type scale here so a dense skin gets a
   proportionate title instead of an 18px one on 11px axis labels. */
/* [R5-G] border-color: a title box's default pen (borderWidth above 0) -- upstream's tokens.color.primary */
TyAdvChartTitle { color: var(--on-surface); font-size: var(--font-size-title); font-weight: 700; border-color: #3c3c41; }
TyAdvChartSubtitle { color: var(--muted); font-size: var(--font-size-base); }
/* A label OUTSIDE its mark: the theme's own ink, not anything derived from the
   thing it names. Upstream picks #333 or #ccc by mode; this is the same idea
   said in the theme's vocabulary. */
TyAdvChartLabel { color: var(--on-surface); font-size: var(--font-size-base); }
/* A label INSIDE its mark is a three-band table, not a light/dark pair, and the
   order reads backwards until you see why: on a mid-dark fill you want maximum
   contrast, but on a nearly black one the brightest ink glares and the dimmer
   one is easier to read. Band 1 is therefore LIGHTER than band 2.
     band 0 -- a light mark, so dark ink
     band 1 -- a mid mark, so the brightest ink
     band 2 -- a dark mark, so a softer light ink
   FIXED VALUES, NOT THE SURFACE PAIR: the band is chosen by the MARK's fill,
   which does not change with the mode -- so the ink must not either, or a
   dark skin puts light ink on a light bar. Upstream's #333, #eee, #ccc. */
TyAdvChartLabelOnLight { color: #333333; }
TyAdvChartLabelOnMid   { color: #EEEEEE; }
TyAdvChartLabelOnDark  { color: #CCCCCC; }
/* The legend. Upstream inks the words with tokens.color.secondary and greys a
   deselected item with tokens.color.disabled. This vocabulary has no disabled
   INK token -- only a disabled OPACITY -- so a switched-off item is the chart's
   own ink faded far enough to read as off on either mode. The frame is drawn
   only when the option asks for one, so the last two are dormant on almost
   every chart. */
TyAdvChartLegend { color: var(--muted); font-size: var(--font-size-base); }
TyAdvChartLegendInactive { color: alpha(var(--on-surface), 0.25); }
TyAdvChartLegendBorder { border-color: var(--border); border-width: 1px; }
TyAdvChartLegendBackground { background: var(--surface); }
/* The legend's selector buttons (All / Inv) and the scrolling legend's pager.
   Upstream draws a button as tertiary ink in a pale rounded frame that turns
   the lighter quaternary ink under the pointer, the page arrows in its accent
   with a pale accent for one that cannot go further, and the page count in
   the tertiary ink. Here the ink is the chart's muted one (fainter when
   hovered), the frame the border, and the arrows the skin's own accent. */
TyAdvChartLegendSelector { color: var(--muted); border-color: var(--border); font-size: var(--font-size-base); }
TyAdvChartLegendSelector:hover { color: alpha(var(--on-surface), 0.35); border-color: var(--border); font-size: var(--font-size-base); }
TyAdvChartLegendPageIcon { color: var(--accent); }
TyAdvChartLegendPageIconInactive { color: alpha(var(--accent), 0.25); }
TyAdvChartLegendPageText { color: var(--muted); font-size: var(--font-size-base); }
/* A visualMap's own picture. Upstream inks its texts with tokens.color.
   secondary, the bar's inactive stretch and the frame with a pale grey, the
   handles' rims white and the box transparent. The inactive stretch is the
   chart's own ink faded, like a switched-off legend item; the rim is the
   surface, so a handle reads as cut out of whatever it sits on. The frame is
   drawn only when the option gives it a width. */
TyAdvChartVisualMap { color: var(--muted); font-size: var(--font-size-base); }
TyAdvChartVisualMapInactive { color: alpha(var(--on-surface), 0.2); }
TyAdvChartVisualMapBorder { border-color: var(--border); }
TyAdvChartVisualMapBackground { background: transparent; }
TyAdvChartVisualMapHandle { border-color: var(--surface); }
/* A slider dataZoom. Upstream tints the whole component from its accent: a
   pale frame, the window filled with the accent at a fifth, handles white
   with a pale rim, the brush's move bar the accent at half with a white
   grip, and the data shadow grey outside the window and bluer inside it.
   Here the accent is the skin's own, the grey is the ink faded, and white
   is the surface. The labels beside the handles take the muted ink. */
TyAdvChartDataZoom { color: var(--muted); font-size: var(--font-size-base); }
TyAdvChartDataZoomBorder { border-color: var(--border); }
TyAdvChartDataZoomBackground { background: transparent; }
TyAdvChartDataZoomFiller { background: alpha(var(--accent), 0.2); }
TyAdvChartDataZoomHandle { background: var(--surface); border-color: alpha(var(--accent), 0.35); }
TyAdvChartDataZoomMoveHandle { background: alpha(var(--accent), 0.5); color: var(--surface); }
TyAdvChartDataZoomShadow { background: alpha(var(--on-surface), 0.06); border-color: alpha(var(--on-surface), 0.3); }
TyAdvChartDataZoomShadowSelected { background: alpha(var(--accent), 0.12); border-color: alpha(var(--accent), 0.55); }
/* Under the pointer (or while a handle is dragged) a handle's rim darkens
   and the move bar firms up; a brush across the body is the accent faded. */
TyAdvChartDataZoomHandle:hover { background: var(--surface); border-color: alpha(var(--accent), 0.55); }
TyAdvChartDataZoomMoveHandle:hover { background: alpha(var(--accent), 0.8); color: var(--surface); }
TyAdvChartDataZoomBrush { background: alpha(var(--accent), 0.3); }
/* The toolbox. Upstream draws its icons as hairline outlines in the accent,
   a deeper accent under the pointer, and the title that appears below the
   icon takes that same deeper ink; the bar itself has no ground and no
   frame unless the option asks. The rectangle a zoom drag sweeps out is the
   accent faded right down. */
TyAdvChartToolbox { border-color: var(--accent); font-size: var(--font-size-base); }
TyAdvChartToolbox:hover { border-color: darken(var(--accent), 25%); }
TyAdvChartToolboxBackground { background: transparent; }
TyAdvChartToolboxBorder { border-color: var(--border); }
TyAdvChartToolboxBrush { background: alpha(var(--accent), 0.15); }
/* The brush component's covers. Upstream lays a pale tint over what it
   selects and rims it in a light grey; here the ink faded right down and
   the skin's own border colour. */
TyAdvChartBrush { background: alpha(var(--on-surface), 0.06); border-color: var(--border); }
/* The timeline. Upstream builds the whole slider from its accent in steps:
   the axis line palest, the passed part of it a little deeper, the ticks
   deeper again and a passed tick deeper still, the checkpoint and the
   buttons the accent itself; under the pointer a tick, a button and a label
   take a darker accent. The labels are the muted ink; an empty symbol's
   inside is the surface. */
TyAdvChartTimeline { border-color: alpha(var(--accent), 0.2); background: var(--surface); }
TyAdvChartTimelineProgress { border-color: alpha(var(--accent), 0.45); background: alpha(var(--accent), 0.65); }
TyAdvChartTimelineItem { background: alpha(var(--accent), 0.3); }
TyAdvChartTimelineItem:hover { background: darken(var(--accent), 10%); border-color: darken(var(--accent), 10%); }
TyAdvChartTimelineCheckpoint { background: var(--accent); border-color: var(--accent); }
TyAdvChartTimelineControl { background: var(--accent); border-color: var(--accent); }
TyAdvChartTimelineControl:hover { background: darken(var(--accent), 25%); border-color: darken(var(--accent), 25%); }
TyAdvChartTimelineLabel { color: var(--muted); font-size: var(--font-size-base); }
TyAdvChartTimelineLabel:hover { color: darken(var(--accent), 10%); }
/* What a brush leaves out. Upstream greys the items outside every cover in a
   light neutral; here the skin's border colour, which is that neutral. */
TyAdvChartBrushOut { color: var(--border); }
/* A parallel axis' area select: the band a drag along the axis leaves.
   Upstream fills and rims it in one light blue at 30% opacity (the opacity
   is the chart's, not the skin's); here the accent halfway to the surface. */
TyAdvChartParallelSelect { background: mix(var(--accent), var(--surface), 50%); border-color: mix(var(--accent), var(--surface), 50%); }
/* A thumbnail's box: the small copy of a graph in its corner. Upstream fills
   it with the option's backgroundColor, else its neutral00 token, and rims
   it in its border token; here the skin's surface and border. An author's
   itemStyle colours win. */
TyAdvChartThumbnail { background: var(--surface); border-color: var(--border); }
/* The window over the copy, where the canvas looks. Upstream fills it with
   neutral30 and rims it with neutral40 (the 0.3 opacity is the option's);
   here the skin's border, rimmed a step toward the ink. */
TyAdvChartThumbnailWindow { background: var(--border); border-color: mix(var(--on-surface), var(--border), 25%); }
/* An axis break's area: the zigzag band where a stretch of the axis is cut
   out, over the series. Upstream fills it white at 60% and rims it in its
   border grey, dashed; here the skin's surface at 60% and its border, so a
   dark skin's breaks are dark. The dash is the option's (3, 3 by default). */
TyAdvChartBreakArea { background: alpha(var(--surface), 0.6); border-color: var(--border); border-width: 1px; }
/* A geo component's map. Upstream fills a region with its backgroundTint
   token (a pale blue-grey at half), rims it in its border grey at half a
   pixel and, when the option shows them, writes the region names in its
   tertiary ink. Here a tenth of the accent in the surface, so a dark
   skin's map is a dark one, the skin's border, and the muted ink. The
   half-pixel rim is the option's. */
TyAdvChartGeoArea { background: mix(var(--accent), var(--surface), 90%); border-color: var(--border); }
TyAdvChartGeoLabel { color: var(--muted); font-size: var(--font-size-base); }
/* A map series' regions. Upstream fills them with its background token (a
   near-white blue, lighter than a geo component's tint) and rims them in
   the same border grey; here a twentieth of the accent in the surface, a
   shade lighter than a geo's, and the skin's border. */
TyAdvChartMapArea { background: mix(var(--accent), var(--surface), 95%); border-color: var(--border); }
/* A hovered or selected region and its name. Upstream fills it with its
   highlight token (a warm yellow at 80%) and writes the name in its primary
   ink; here a third of the accent in the surface and the skin's own text
   colour, so the region stands out in any skin. */
TyAdvChartGeoArea:hover { background: mix(var(--accent), var(--surface), 65%); border-color: var(--border); }
TyAdvChartGeoLabel:hover { color: var(--on-surface); font-size: var(--font-size-base); }
/* A decal's symbols, where the decal names no colour of its own -- the aria
   decals that tell the series apart without their colours. Upstream draws
   them rgba(0, 0, 0, 0.2): the readable ink of the surface at 20%, which on
   the light skin's white is exactly that, and white at 20% on a dark one.
   An `empty*` symbol in the pattern is a hollow over the background:
   upstream's neutral00 (#fff), the surface here -- exactly that on the
   light skin, and no white hole on a dark one. */
TyAdvChartDecal { color: alpha(on(var(--surface)), 0.2); background: var(--surface); }
/* The item the keyboard holds. Upstream has no keyboard, so this is the
   library's own focus ring, drawn around the mark: the skin's focus ring, at
   the width the other controls draw theirs. The offset follows the library's
   ring convention (a positive one insets the ring), so a negative one sets it
   off the mark. */
TyAdvChartFocusItem { outline: 2px var(--focus-ring); outline-offset: -3px; }
/* The hover tooltip. TWO keys, because upstream's whole typographic hierarchy
   inside the box is one weight difference -- the name at 400 and the value at
   900, in the same grey -- and one style set cannot say two weights. Said here
   in this vocabulary's own terms instead: the name is the muted ink a label
   takes, the value is full ink and bold.

   The chart paints NO box without a background on the first key (no surface =
   nothing to draw on), which is the same rule TyChartTooltip follows, and it
   is why both live in the base layer for every theme to inherit. A skin
   wanting the box to float adds `shadow:`; the base stays flat like the rest
   of light. The BORDER here is only the fallback -- an item tooltip tints its
   border with the colour of the datum under the pointer, which is what makes
   an ECharts tooltip look attached to the thing it describes. */
TyAdvChartTooltip {
  background: var(--surface);
  color: var(--muted);
  border-color: var(--border);
  border-width: var(--input-border-width);
  border-radius: var(--radius-sm);
  padding: var(--pad-tooltip);
  font-size: var(--font-size-base);
}
TyAdvChartTooltipValue {
  color: var(--on-surface);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-bold);
}
/* The axis pointer: the line that follows the cursor along an axis, the band
   a `shadow` draws instead, and the label at the axis end.

   The line reads like a split line and not like an axis line -- it is a
   reading aid over the plot, not a piece of the frame -- so it takes the same
   --border it does. The BAND is alpha over the ink for the reason every other
   band in this chart is: it darkens a light theme and lightens a dark one from
   one declaration, where upstream's literal rgba grey does neither.

   The LABEL is the one piece here that is meant to stand out: upstream inks it
   white on an indigo chip, which is a colour this vocabulary already has a
   name for. Accent, therefore -- so a re-skinned chart labels its pointer in
   the skin's own colour instead of ECharts'. */
/* A candlestick's two directions. NOT "positive and negative" however they are
   usually described: both compare a datum against ITSELF -- close above open
   against open above close -- and either can happen in a rising market.

   Upstream writes #eb5454 and #47b262, which is the East Asian convention
   (red up, green down) and the opposite of the North American one. This
   library has a --success and a --danger already and they carry exactly the
   right meaning in either convention, so a theme that wants the other way
   round swaps two lines here instead of restyling a chart. */
/* A GAUGE'S READING: the headline number under the needle, and the only thing
   in this vocabulary that had no donor. The chart's own title key is bold but
   is sized off the title scale -- a gauge's reading is the picture, not a
   heading over it -- and every label key is base size. Upstream writes 30px
   and a literal here is the right place for a literal: a skin that wants a
   quieter dial changes this one line. The gauge's name caption takes
   TyAdvChartLabel, its scale takes TyAdvChartAxisLabel, its major ticks take
   TyAdvChartAxisTick and its minor ones TyAdvChartMinorTick, so this is the
   only key the whole series added. */
TyAdvChartGaugeDetail { color: var(--on-surface); font-size: 30px;
                        font-weight: var(--font-weight-bold); }
TyAdvChartCandleUp { background: var(--danger); }
TyAdvChartCandleDown { background: var(--success); }
TyAdvChartAxisPointer { border-color: var(--border); border-width: 1px; }
TyAdvChartAxisPointerShadow { background: alpha(var(--on-surface), 0.10); }
/* [R5-A] upstream's tokens.color.shadow (light and dark alike): the colour of
   the shadows a series or a component casts by default -- a boxplot's
   emphasis, a continuous visualMap's indicator */
TyAdvChartShadow { color: rgba(0, 0, 0, 0.2); }
TyAdvChartAxisPointerLabel {
  background: var(--accent);
  color: var(--on-accent);
  border-radius: var(--radius-sm);
  padding: 5px 7px;
  font-size: var(--font-size-base);
}
/* The loading effect (showLoading): the mask over the chart, its words, and
   the turning arc. Upstream writes a white mask at 0.8, its darkest neutral
   for the words and the first palette colour for the arc -- on a light skin
   exactly this, and on a dark one a mask of its own surface instead of a
   white sheet over a dark chart. The arc's width and radius are geometry the
   cfg sets (5 and 10 by default); only its colour is the skin's. */
TyAdvChartLoading { background: alpha(var(--surface), 0.8); color: var(--on-surface);
                    font-size: var(--font-size-base); }
TyAdvChartLoadingSpinner { border-color: var(--accent); }
