# Shell scripts must keep LF endings or they fail on macOS/Linux ("bad interpreter: bash\r").
*.sh   text eol=lf

# PowerShell scripts are Windows-side; CRLF is fine and avoids editor churn.
*.ps1  text eol=crlf

# Vendored icon-font assets: byte-for-byte, never normalised.
# tyControls.Icons.Lucide.pas carries a SHA-1 over lucide.ttf + codepoints.json and a test
# recomputes it from these files, so a single LF->CRLF conversion on checkout would make the
# drift guard fail on every fresh clone. The .ttf is binary anyway; the JSON is the one that
# would actually have been rewritten.
assets/lucide/**  -text

# Windows Terminal's own defaults.json, byte for byte (CRLF included): the colour-scheme
# tests count its bytes and read its comments and trailing commas as they are upstream.
tests/fixtures/terminal-wt-defaults.json  -text

# The terminal example's ZModem recordings: lrzsz's bytes on the wire and the files it
# sent, byte for byte (tools/terminal-oracle/zmodem-record.sh).
tests/fixtures/terminal-zmodem/**  -text

# The AI samples: hand-written streams, byte for byte (one of them uses CRLF on purpose).
tests/fixtures/themebuilder/ai/**  -text
