# Shell scripts must keep LF endings or they fail on macOS/Linux ("bad interpreter: bash\r").
*.sh   text eol=lf

# PowerShell scripts are Windows-side; CRLF is fine and avoids editor churn.
*.ps1  text eol=crlf

# Vendored icon-font assets: byte-for-byte, never normalised.
# tyControls.Icons.Lucide.pas carries a SHA-1 over lucide.ttf + codepoints.json and a test
# recomputes it from these files, so a single LF->CRLF conversion on checkout would make the
# drift guard fail on every fresh clone. The .ttf is binary anyway; the JSON is the one that
# would actually have been rewritten.
assets/lucide/**  -text

# The harvested ECharts gallery: LF, never converted. tools/advchart-gallery/harvest.js
# regenerates these files, so a CRLF conversion on checkout would make every one of them
# differ from what a re-run produces -- and there is 9.8 MB of them, so the conversion is
# not free either. Same reasoning as the lucide codepoints above.
examples/advchart/gallery/*.json text eol=lf
