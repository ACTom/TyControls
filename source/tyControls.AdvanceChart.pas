function TTyAdvanceChart.CustomView(ASeriesIndex: Integer): TTyCustomView;
begin
  Result := nil;
  if (ASeriesIndex >= 0) and (ASeriesIndex <= High(FCustomViews)) then
    Result := FCustomViews[ASeriesIndex];
end;

function TTyAdvanceChart.CustomPaintSource(AIndex: Integer): TTyGfxEl;
begin
  Result := nil;
  if (AIndex >= 0) and (AIndex <= High(FCustomPaintEls)) then
    Result := FCustomPaintEls[AIndex];
end;

function TTyAdvanceChart.CustomClip(ASeriesIndex: Integer; out ARect: TTyXYWH): Boolean;
var slot: Integer;
begin
  ARect := Default(TTyXYWH);
  slot := SlotOfSeries(ASeriesIndex);
  Result := (slot >= 0) and (slot <= High(FCustomClipOn)) and FCustomClipOn[slot];
  if Result then ARect := FCustomClip[slot];
end;

function TTyAdvanceChart.CuLive: Boolean;
begin
  Result := (FCuAnim <> nil) and (FCuAnim.ClipCount > 0);
end;

{ `coordinateSystem: 'none'` (or ''): resolved on nothing, its dimensions
  getCoordSysDimDefs' x and y }
function TTyAdvanceChart.CustomOnNone(ASlot: Integer): Boolean;
begin
  Result := (ASlot >= 0) and (ASlot <= High(FBindings))
    and (FBindings[ASlot].SeriesType = TyCustomSeriesType)
    and FBindings[ASlot].Resolved and (FBindings[ASlot].Cart = nil)
    and (FBindings[ASlot].Polar = nil) and (FBindings[ASlot].Single = nil)
    and (FBindings[ASlot].CalendarIndex < 0) and (FBindings[ASlot].RadarIndex < 0)
    and ((FBindings[ASlot].CoordSysName = 'none') or (FBindings[ASlot].CoordSysName = ''));
end;

function TTyAdvanceChart.CustomRootInfo(ASeriesIndex, AInside: Integer): TTyCustomElInfo;
var
  view: TTyCustomView;
  el: TTyGfxEl;
begin
  Result := nil;
  view := CustomView(ASeriesIndex);
  if view = nil then Exit;
  el := view.ElOf(AInside);
  if (el <> nil) and (el.Custom is TTyCustomElInfo) then
    Result := TTyCustomElInfo(el.Custom);
end;

{ the visualMap's row of a custom item (its dataIndexInside); False none }
function TTyAdvanceChart.CustomVisualRow(ASlot, ARow: Integer;
  out AVisual: TTyVisualRow): Boolean;
var raw: Integer;
begin
  AVisual := Default(TTyVisualRow);
  Result := False;
  if (ASlot < 0) or (ASlot > High(FBindings)) or (ASlot > High(FStores))
    or (FStores[ASlot] = nil) or (ARow < 0) or (ARow >= FStores[ASlot].Count) then Exit;
  raw := FStores[ASlot].GetRawIndex(ARow);
  if (ASlot > High(FVisualRows)) or (raw < 0) or (raw > High(FVisualRows[ASlot])) then Exit;
  AVisual := FVisualRows[ASlot][raw];
  Result := True;
end;

{ findEventDispatcher from the element up -- a textContent's host, then the
  parents: any with tooltipDisabled }
function TTyAdvanceChart.CustomTipDisabled(AElement: Integer): Boolean;
var el: TTyGfxEl;
begin
  Result := False;
  el := CustomPaintSource(AElement);
  while el <> nil do
  begin
    if (el.Custom is TTyCustomElInfo) and TTyCustomElInfo(el.Custom).TooltipDisabled then
      Exit(True);
    if el.Host <> nil then el := el.Host else el := el.Parent;
  end;
end;

{ ==================== the custom series [Batch 123] ==================== }

type
  { the coordinate system a custom series is drawn on [Batch 124]:
    cusUnknown one with no prepareCustom (nothing is drawn) }
  TTyCuSys = (cusUnknown, cusNone, cusCart, cusPolar, cusSingle, cusCalendar,
    cusMatrix,
    { [Batch 152] coord/geo/prepareCustom.ts }
    cusGeo);

  { THE API a renderItem is handed: CustomView.makeRenderItem's closures over
    the series' data, its visuals and its coordinate system's prepareCustom
    (cartesian, polar, single, calendar [Batch 124]) }
  TTyChartCustomApi = class(TTyCustomApi)
  private
    function Row(AInside: Integer; out ARow: Integer): Boolean;
    function ColumnAt(ADim: Integer): Integer;
    function ItemNode(ARow: Integer): TJSONObject;
    function Lookup(AItem, ASeries: TJSONObject; const APath: array of string): TJSONData;
    function GlobalText(const AKey: string): TJSONData;
    function MakeStyle(AExtra: TJSONObject; ARow: Integer; AEmphasis: Boolean): TJSONObject;
    function ParseOn(AAxis: TTyAxis; const ACell: TTyCustomCell): Double;
  protected
    function DimIndexOf(const AName: string): Integer; override;
    function DoCoord(const ACells: TTyCustomCellArray): TTyDoubleArray; override;
    function DoLayout(const ACells: TTyCustomCellArray): TTyCustomLayout; override;
    function DoMatrix(const AX, AY: TTyCustomCellArray; AClamp: Integer;
      AIgnoreMerge: Boolean; out ALayout: TTyCustomLayout): TTyDoubleArray; override;
  public
    Chart: TTyAdvanceChart;
    Slot, Series: Integer;
    { the coordinate system, and its object [Batch 124] }
    Sys: TTyCuSys;
    Polar: TTyPolar;
    Single: TTySingle;
    Calendar: TTyCalendar;
    { [Batch 147] }
    Matrix: TTyMatrix;
    Geo: TTyGeo;
    Store: TTyDataStore;
    Node: TJSONObject;
    { the dataIndexInside of the running call }
    Current: Integer;
    { device px per css px }
    Scale: Double;
    function Value(ADim: Integer; ADataIndexInside: Integer = -1): Double; overload; override;
    function ValueText(ADim: Integer; ADataIndexInside: Integer = -1): string; overload; override;
    function OrdinalRawValue(ADim: Integer; ADataIndexInside: Integer = -1): string; overload; override;
    function Size(const ADataSize, ADataItem: array of Double): TTyDoubleArray; overload; override;
    function Style(AExtra: TJSONObject = nil; ADataIndexInside: Integer = -1): TJSONObject; override;
    function StyleEmphasis(AExtra: TJSONObject = nil; ADataIndexInside: Integer = -1): TJSONObject; override;
    function Visual(const AType: string; ADataIndexInside: Integer = -1): TJSONData; override;
    function BarLayout(AOpt: TJSONObject): TTyCustomBarLayout; override;
    function CurrentSeriesIndices: TTyIntegerArray; override;
    function Font(AOpt: TJSONObject): string; override;
    function GetWidth: Double; override;
    function GetHeight: Double; override;
    function GetDevicePixelRatio: Double; override;
  end;

function CuNull(A: TJSONData): Boolean; inline;
begin
  Result := (A = nil) or (A.JSONType = jtNull);
end;

function CuTruthy(A: TJSONData): Boolean;
begin
  if A = nil then Exit(False);
  case A.JSONType of
    jtNull: Result := False;
    jtBoolean: Result := A.AsBoolean;
    jtNumber: Result := (A.AsFloat <> 0) and not IsNan(A.AsFloat);
    jtString: Result := A.AsString <> '';
  else
    Result := True;
  end;
end;

procedure CuPut(AObj: TJSONObject; const AKey: string; AValue: TJSONData);
var i: Integer;
begin
  i := AObj.IndexOfName(AKey);
  if i >= 0 then AObj.Items[i] := AValue else AObj.Add(AKey, AValue);
end;

function CuObj(AObj: TJSONObject; const AKey: string): TJSONObject;
var d: TJSONData;
begin
  Result := nil;
  if AObj = nil then Exit;
  d := AObj.Find(AKey);
  if d is TJSONObject then Result := TJSONObject(d);
end;

{ String() of a JSON value the way a join prints it }
function CuText(A: TJSONData): string;
begin
  Result := '';
  if A = nil then Exit;
  case A.JSONType of
    jtString: Result := A.AsString;
    jtNumber: Result := TyJsNumberToString(A.AsFloat);
    jtBoolean: if A.AsBoolean then Result := 'true' else Result := 'false';
    jtNull: Result := 'null';
  end;
end;

function TTyChartCustomApi.Row(AInside: Integer; out ARow: Integer): Boolean;
begin
  if AInside < 0 then ARow := Current else ARow := AInside;
  Result := (Store <> nil) and (ARow >= 0) and (ARow < Store.Count);
end;

{ the store column that reads data dimension ADim (its raw position) }
function TTyChartCustomApi.ColumnAt(ADim: Integer): Integer;
var c: Integer;
begin
  Result := -1;
  if Store = nil then Exit;
  for c := 0 to Store.DimCount - 1 do
    if Store.RawDimPos(c) = ADim then Exit(c);
end;

function TTyChartCustomApi.ItemNode(ARow: Integer): TJSONObject;
var d: TJSONData; raw: Integer;
begin
  Result := nil;
  if (Node = nil) or (Store = nil) then Exit;
  raw := Store.GetRawIndex(ARow);
  d := Node.Find('data');
  if not (d is TJSONArray) or (raw < 0) or (raw >= d.Count) then Exit;
  d := TJSONArray(d).Items[raw];
  if d is TJSONObject then Result := TJSONObject(d);
end;

{ getShallow through the item model: the item's own value, else the
  series' }
function TTyChartCustomApi.Lookup(AItem, ASeries: TJSONObject;
  const APath: array of string): TJSONData;

  function Walk(ARoot: TJSONObject): TJSONData;
  var i: Integer; o: TJSONObject;
  begin
    Result := nil;
    o := ARoot;
    for i := 0 to High(APath) - 1 do
    begin
      o := CuObj(o, APath[i]);
      if o = nil then Exit;
    end;
    if o <> nil then Result := o.Find(APath[High(APath)]);
    if CuNull(Result) then Result := nil;
  end;

begin
  Result := nil;
  if AItem <> nil then Result := Walk(AItem);
  if (Result = nil) and (ASeries <> nil) then Result := Walk(ASeries);
end;

{ the global text style: the option's root textStyle over globalDefault's }
function TTyChartCustomApi.GlobalText(const AKey: string): TJSONData;
var root: TJSONObject;
begin
  Result := nil;
  if (Chart.FOption <> nil) and (Chart.FOption.Root is TJSONObject) then
  begin
    root := CuObj(TJSONObject(Chart.FOption.Root), 'textStyle');
    if root <> nil then Result := root.Find(AKey);
  end;
  if CuNull(Result) then Result := TyMkDefaultTextStyle.Find(AKey);
  if CuNull(Result) then Result := nil;
end;

function TTyChartCustomApi.DimIndexOf(const AName: string): Integer;
var p: Integer;
begin
  Result := -1;
  if Store = nil then Exit;
  for p := 0 to Max(Store.RawWidth, Store.DimCount) - 1 do
    if Store.RawDimName(p) = AName then Exit(p);
end;

function TTyChartCustomApi.Value(ADim: Integer; ADataIndexInside: Integer): Double;
var
  r, col: Integer;
  cell: TTyDataValue;
  t: TTyDimType;
begin
  Result := NaN;
  if not Row(ADataIndexInside, r) then Exit;
  col := ColumnAt(ADim);
  if col >= 0 then Exit(Store.Get(col, r));
  if not TTyDataStore.RawCell(Store.RawItem(r), ADim, cell) then Exit;
  t := Store.RawPosType(ADim);
  { an ordinal dimension no axis interns keeps the value as written }
  if t = ddtOrdinal then
  begin
    if cell.Kind = dvkNumber then Result := cell.Num;
    Exit;
  end;
  Result := TyParseDataValue(cell, t);
end;

function TTyChartCustomApi.ValueText(ADim: Integer; ADataIndexInside: Integer): string;
var
  r, col: Integer;
  cell: TTyDataValue;
begin
  Result := 'undefined';
  if not Row(ADataIndexInside, r) then Exit;
  col := ColumnAt(ADim);
  if col >= 0 then Exit(TyJsNumberToString(Store.Get(col, r)));
  if not TTyDataStore.RawCell(Store.RawItem(r), ADim, cell) then Exit;
  if (Store.RawPosType(ADim) = ddtOrdinal) or (cell.Kind = dvkNone) then
    Exit(TyJsValueText(cell, 'undefined'));
  Result := TyJsNumberToString(Value(ADim, r));
end;

function TTyChartCustomApi.OrdinalRawValue(ADim: Integer; ADataIndexInside: Integer): string;
var r, col: Integer; v: Double;
begin
  Result := 'undefined';
  if not Row(ADataIndexInside, r) then Exit;
  col := ColumnAt(ADim);
  if (col >= 0) and (Store.DimType(col) = ddtOrdinal) and (Store.OrdinalMeta(col) <> nil) then
  begin
    v := Store.Get(col, r);
    if IsNan(v) or (Frac(v) <> 0) or (v < 0) or (v >= Store.CategoryCount(col)) then
      Exit('undefined');
    Exit(Store.CategoryAt(col, Trunc(v)));
  end;
  Result := ValueText(ADim, r);
end;

{ scale.parse of one cell on an axis }
function TTyChartCustomApi.ParseOn(AAxis: TTyAxis; const ACell: TTyCustomCell): Double;
var ord_: Integer; ms: Double;
begin
  Result := NaN;
  if (AAxis = nil) or (ACell.Kind = cckNone) then Exit;
  case AAxis.AxisType of
    atCategory:
      if ACell.Kind = cckText then
      begin
        if AAxis.Categories = nil then Exit;
        ord_ := AAxis.Categories.GetOrdinal(ACell.Text);
        if ord_ >= 0 then Result := ord_;
      end
      else
        Result := TyJsRound(ACell.Num);
    atTime:
      if ACell.Kind = cckText then
      begin
        if TyParseDateMs(ACell.Text, ms, False) then Result := ms;
      end
      else
        Result := TyJsRound(ACell.Num);
  else
    if ACell.Kind = cckText then
    begin
      if ACell.Text = '' then Exit;
      Result := TyJsToNumber(ACell.Text);
    end
    else
      Result := ACell.Num;
  end;
end;

const
  cCuPi: Double = Pi;

function CuMask: TFPUExceptionMask;
begin
  Result := SetExceptionMask([exInvalidOp, exDenormalized, exZeroDivide,
    exOverflow, exUnderflow, exPrecision]);
end;

{ +v of a cell: a text's number, nothing NaN }
function CuNumCell(const ACell: TTyCustomCell): TTyCustomCell;
begin
  Result := ACell;
  if ACell.Kind = cckText then
  begin
    Result.Kind := cckNumber;
    Result.Num := TyJsToNumber(ACell.Text);
  end
  else if ACell.Kind = cckNone then
  begin
    Result.Kind := cckNumber;
    Result.Num := NaN;
  end;
end;

{ a calendar's parseDate of a cell: a number is epoch ms, a text a date }
function CuCalMs(ACal: TTyCalendar; const ACell: TTyCustomCell): Double;
var v: TTyDataValue;
begin
  v := Default(TTyDataValue);
  case ACell.Kind of
    cckNumber:
      begin
        v.Kind := dvkNumber;
        v.Num := ACell.Num;
      end;
    cckText:
      begin
        v.Kind := dvkText;
        v.Text := ACell.Text;
      end;
  else
    v.Kind := dvkNone;
  end;
  Result := ACal.ParseDate(v);
end;

{ the coordinate system's api.coord, in css px: a cartesian's dataToPoint;
  a polar's dataToRadius and dataToAngle through coordToPoint, the radius
  and the angle in radians pushed on; a single's dataToPoint(+v); a
  calendar's dataToPoint (clamped); nothing on no system }
function CuSecond(const ACells: TTyCustomCellArray): TTyCustomCellArray; forward;

function TTyChartCustomApi.DoCoord(const ACells: TTyCustomCellArray): TTyDoubleArray;
var
  lay: TTyCustomLayout;
  b: TTySeriesBinding;
  p: TTyPointF;
  cx, cy: TTyCustomCell;
  rad, ang, t: Double;
  mask: TFPUExceptionMask;
begin
  Result := nil;
  cx := Default(TTyCustomCell);
  cy := Default(TTyCustomCell);
  if Length(ACells) > 0 then cx := ACells[0];
  if Length(ACells) > 1 then cy := ACells[1];
  b := Chart.FBindings[Slot];
  mask := CuMask;
  try
    case Sys of
      cusCart:
        begin
          SetLength(Result, 2);
          Result[0] := NaN;
          Result[1] := NaN;
          if b.Cart = nil then Exit;
          p := b.Cart.DataToPoint([ParseOn(b.XAxis, cx), ParseOn(b.YAxis, cy)]);
          Result[0] := p.X / Scale;
          Result[1] := p.Y / Scale;
        end;
      cusPolar:
        begin
          rad := Polar.RadiusAxis.DataToCoord(ParseOn(Polar.RadiusAxis, cx));
          ang := Polar.AngleAxis.DataToCoord(ParseOn(Polar.AngleAxis, cy));
          p := Polar.CoordToPoint(rad, ang);
          SetLength(Result, 4);
          Result[0] := p.X / Scale;
          Result[1] := p.Y / Scale;
          Result[2] := rad / Scale;
          { angle * Math.PI / 180, in that order }
          t := ang * cCuPi;
          Result[3] := t / 180;
        end;
      cusSingle:
        begin
          p := Single.ValueToPoint(ParseOn(Single.Axis, CuNumCell(cx)));
          SetLength(Result, 2);
          Result[0] := p.X / Scale;
          Result[1] := p.Y / Scale;
        end;
      cusCalendar:
        begin
          p := Calendar.DatePoint(CuCalMs(Calendar, cx), True);
          SetLength(Result, 2);
          Result[0] := p.X / Scale;
          Result[1] := p.Y / Scale;
        end;
      { a matrix cell's centre: one value per direction [Batch 147] }
      cusMatrix:
        Result := DoMatrix(Copy(ACells, 0, 1), CuSecond(ACells), 0, False, lay);
      { a geo's dataToPoint: a region name, or the pair through ToNumber
        [Batch 152] }
      cusGeo:
        begin
          SetLength(Result, 2);
          Result[0] := NaN;
          Result[1] := NaN;
          if Geo = nil then Exit;
          if (Length(ACells) = 1) and (cx.Kind = cckText) then
          begin
            if not Geo.PointOfName(cx.Text, p) then Exit;
          end
          else if not Geo.PointOf(CuNumCell(cx).Num, CuNumCell(cy).Num, p) then Exit;
          Result[0] := p.X / Scale;
          Result[1] := p.Y / Scale;
        end;
    end;
  finally
    ConvertUnmask(mask);
  end;
end;

{ the second cell as one direction's parts: an absent one is one part that
  names nothing (upstream's [undefined]) }
function CuSecond(const ACells: TTyCustomCellArray): TTyCustomCellArray;
begin
  Result := nil;
  SetLength(Result, 1);
  if Length(ACells) > 1 then Result[0] := ACells[1]
  else Result[0] := Default(TTyCustomCell);
end;

{ a matrix's dataToLayout of the parts [Batch 147]: a text a header cell's
  name (the tree's category list), a number an ordinal or a level, nothing
  NaN; the clamp; the merged cells unless ignoreMergeCells [Batch 149]; css
  px }
function TTyChartCustomApi.DoMatrix(const AX, AY: TTyCustomCellArray; AClamp: Integer;
  AIgnoreMerge: Boolean; out ALayout: TTyCustomLayout): TTyDoubleArray;
var
  parts: array[0..1] of TTyDoubleArray;
  r: TTyXYWH;
  loc: TTyMatrixLocRange;
  cl: TTyMatrixClamp;
  k, o: Integer;
  mask: TFPUExceptionMask;

  function CellOf(ADim: Integer; const C: TTyCustomCell): Double;
  begin
    Result := NaN;
    case C.Kind of
      cckNumber: Result := C.Num;
      cckText:
        begin
          o := Matrix.Dims[ADim].Meta.GetOrdinal(C.Text);
          if o >= 0 then Result := o;
        end;
    end;
  end;

begin
  ALayout := Default(TTyCustomLayout);
  Result := nil;
  if (Sys <> cusMatrix) or (Matrix = nil) then Exit;
  SetLength(parts[0], Length(AX));
  for k := 0 to High(AX) do parts[0][k] := CellOf(0, AX[k]);
  SetLength(parts[1], Length(AY));
  for k := 0 to High(AY) do parts[1][k] := CellOf(1, AY[k]);
  case AClamp of
    0: cl := mclNone;
    2: cl := mclBody;
    3: cl := mclCorner;
  else
    cl := mclAll;
  end;
  mask := CuMask;
  try
    Matrix.DataToLayoutRange(parts[0], parts[1], cl, r, loc, AIgnoreMerge);
    ALayout.Valid := True;
    ALayout.Rect.X := r.X / Scale;
    ALayout.Rect.Y := r.Y / Scale;
    ALayout.Rect.Width := r.W / Scale;
    ALayout.Rect.Height := r.H / Scale;
    ALayout.HasLocatorRange := True;
    ALayout.LocatorRange[0][0] := loc[0][0];
    ALayout.LocatorRange[0][1] := loc[0][1];
    ALayout.LocatorRange[1][0] := loc[1][0];
    ALayout.LocatorRange[1][1] := loc[1][1];
    SetLength(Result, 2);
    Result[0] := ALayout.Rect.X + ALayout.Rect.Width / 2;
    Result[1] := ALayout.Rect.Y + ALayout.Rect.Height / 2;
  finally
    ConvertUnmask(mask);
  end;
end;

{ a calendar's api.layout: dataToLayout (clamped), in css px }
function TTyChartCustomApi.DoLayout(const ACells: TTyCustomCellArray): TTyCustomLayout;
var
  c0: TTyCustomCell;
  rc, cc: TTyXYWH;
  mask: TFPUExceptionMask;
begin
  Result := Default(TTyCustomLayout);
  { a matrix cell's [Batch 147] }
  if Sys = cusMatrix then
  begin
    DoMatrix(Copy(ACells, 0, 1), CuSecond(ACells), 0, False, Result);
    Exit;
  end;
  if (Sys <> cusCalendar) or (Calendar = nil) then Exit;
  c0 := Default(TTyCustomCell);
  if Length(ACells) > 0 then c0 := ACells[0];
  mask := CuMask;
  try
    Calendar.DateLayoutXYWH(CuCalMs(Calendar, c0), True, rc, cc);
    Result.Valid := True;
    Result.HasContentRect := True;
    Result.Rect.X := rc.X / Scale;
    Result.Rect.Y := rc.Y / Scale;
    Result.Rect.Width := rc.W / Scale;
    Result.Rect.Height := rc.H / Scale;
    Result.ContentRect.X := cc.X / Scale;
    Result.ContentRect.Y := cc.Y / Scale;
    Result.ContentRect.Width := cc.W / Scale;
    Result.ContentRect.Height := cc.H / Scale;
  finally
    ConvertUnmask(mask);
  end;
end;

{ dataToCoordSize: a category axis' band width, else the span the size
  covers about the item's value -- per axis on a cartesian and a polar
  (dataItem || [0, 0]; the angle in radians), one number on a single axis
  (an undefined item NaN), nothing on a calendar or no system }
function TTyChartCustomApi.Size(const ADataSize, ADataItem: array of Double): TTyDoubleArray;
var
  b: TTySeriesBinding;
  ax: TTyAxis;
  i: Integer;
  val, half, w: Double;
  p1, p2: TTyPointF;
  item: array[0..1] of Double;
  mask: TFPUExceptionMask;
begin
  Result := nil;
  b := Chart.FBindings[Slot];
  mask := CuMask;
  try
    { dataToCoordSize on a geo: each dimension's span about the item through
      dataToPoint [Batch 152] }
    if (Sys = cusGeo) and (Geo <> nil) then
    begin
      if Length(ADataItem) = 0 then
      begin
        item[0] := 0;
        item[1] := 0;
      end
      else
      begin
        item[0] := ADataItem[0];
        if Length(ADataItem) > 1 then item[1] := ADataItem[1] else item[1] := NaN;
      end;
      SetLength(Result, 2);
      for i := 0 to 1 do
      begin
        val := item[i];
        if i <= High(ADataSize) then half := ADataSize[i] / 2 else half := NaN;
        if i = 0 then
        begin
          if not Geo.PointOf(val - half, item[1], p1) then p1 := TyPointF(NaN, NaN);
          if not Geo.PointOf(val + half, item[1], p2) then p2 := TyPointF(NaN, NaN);
          Result[0] := Abs(p1.X / Scale - p2.X / Scale);
        end
        else
        begin
          if not Geo.PointOf(item[0], val - half, p1) then p1 := TyPointF(NaN, NaN);
          if not Geo.PointOf(item[0], val + half, p2) then p2 := TyPointF(NaN, NaN);
          Result[1] := Abs(p1.Y / Scale - p2.Y / Scale);
        end;
      end;
      Exit;
    end;
    case Sys of
      cusCart, cusPolar:
        begin
          if Length(ADataItem) = 0 then
          begin
            item[0] := 0;
            item[1] := 0;
          end
          else
          begin
            item[0] := ADataItem[0];
            if Length(ADataItem) > 1 then item[1] := ADataItem[1] else item[1] := NaN;
          end;
          SetLength(Result, 2);
          for i := 0 to 1 do
          begin
            Result[i] := NaN;
            if Sys = cusCart then
            begin
              if i = 0 then ax := b.XAxis else ax := b.YAxis;
            end
            else if i = 0 then ax := Polar.RadiusAxis
            else ax := Polar.AngleAxis;
            if ax = nil then Continue;
            val := item[i];
            if i <= High(ADataSize) then half := ADataSize[i] / 2 else half := NaN;
            if ax.AxisType = atCategory then w := ax.BandWidth
            else w := Abs(ax.DataToLocal(val - half) - ax.DataToLocal(val + half));
            if (Sys = cusPolar) and (i = 1) then
            begin
              { result * Math.PI / 180: degrees are no pixels }
              w := w * cCuPi;
              Result[i] := w / 180;
            end
            else
              Result[i] := w / Scale;
          end;
        end;
      cusSingle:
        begin
          SetLength(Result, 1);
          ax := Single.Axis;
          if Length(ADataItem) > 0 then val := ADataItem[0] else val := NaN;
          if Length(ADataSize) > 0 then half := ADataSize[0] / 2 else half := NaN;
          if ax.AxisType = atCategory then
            Result[0] := ax.BandWidth / Scale
          else
            Result[0] := Abs(ax.DataToLocal(val - half) - ax.DataToLocal(val + half)) / Scale;
        end;
    end;
  finally
    ConvertUnmask(mask);
  end;
end;

{ api.style / api.styleEmphasis: getItemStyle, the visual colour and
  opacity (normal), the label's text style and config, then
  convertToEC4StyleForCustomSerise, the extra over it, legacy }
function TTyChartCustomApi.MakeStyle(AExtra: TJSONObject; ARow: Integer;
  AEmphasis: Boolean): TJSONObject;
const
  cItem: array[0..12, 0..1] of string = (('fill', 'color'), ('stroke', 'borderColor'),
    ('lineWidth', 'borderWidth'), ('opacity', 'opacity'), ('shadowBlur', 'shadowBlur'),
    ('shadowOffsetX', 'shadowOffsetX'), ('shadowOffsetY', 'shadowOffsetY'),
    ('shadowColor', 'shadowColor'), ('lineDash', 'borderType'),
    ('lineDashOffset', 'borderDashOffset'), ('lineCap', 'borderCap'),
    ('lineJoin', 'borderJoin'), ('miterLimit', 'borderMiterLimit'));
  { convertToEC4RichItem: the text style's keys under their ec4 names }
  cRich: array[0..21, 0..1] of string = (('lineWidth', 'textStrokeWidth'),
    ('font', 'font'), ('fontStyle', 'fontStyle'), ('fontWeight', 'fontWeight'),
    ('fontSize', 'fontSize'), ('fontFamily', 'fontFamily'), ('align', 'textAlign'),
    ('verticalAlign', 'textVerticalAlign'), ('lineHeight', 'textLineHeight'),
    ('width', 'textWidth'), ('height', 'textHeight'),
    ('backgroundColor', 'textBackgroundColor'), ('padding', 'textPadding'),
    ('borderColor', 'textBorderColor'), ('borderWidth', 'textBorderWidth'),
    ('borderRadius', 'textBorderRadius'), ('shadowColor', 'textBoxShadowColor'),
    ('shadowBlur', 'textBoxShadowBlur'), ('shadowOffsetX', 'textBoxShadowOffsetX'),
    ('shadowOffsetY', 'textBoxShadowOffsetY'), ('textShadowColor', 'textShadowColor'),
    ('textShadowBlur', 'textShadowBlur'));
  cFonts: array[0..3] of string = ('fontStyle', 'fontWeight', 'fontSize', 'fontFamily');
var
  item, ts, tc: TJSONObject;
  d, vis, posD: TJSONData;
  i, k: Integer;
  isInside, show: Boolean;
  txt: string;
  hasText: Boolean;
  cells: TTyIntegerArray;
  cell: TTyDataValue;
  vrow: TTyVisualRow;

  function ItemStyleOf(AKey: string): TJSONData;
  begin
    if AEmphasis then Result := Lookup(item, Node, ['emphasis', 'itemStyle', AKey])
    else Result := Lookup(item, Node, ['itemStyle', AKey]);
  end;

  function LabelOf(AKey: string): TJSONData;
  begin
    if AEmphasis then Result := Lookup(item, Node, ['emphasis', 'label', AKey])
    else Result := Lookup(item, Node, ['label', AKey]);
  end;

begin
  item := ItemNode(ARow);
  Result := TJSONObject.Create;
  { getItemStyle }
  for i := 0 to High(cItem) do
  begin
    d := ItemStyleOf(cItem[i, 1]);
    if d = nil then Continue;
    { borderType: getLineDash -- only a dash pattern is a lineDash }
    if cItem[i, 1] = 'borderType' then
    begin
      if not (d is TJSONArray) then Continue;
    end;
    Result.Add(cItem[i, 0], d.Clone);
  end;
  vis := nil;
  if not AEmphasis then
  begin
    { the visual's fill and opacity over it }
    vis := Chart.CustomVisualFill(Slot, ARow);
    if vis <> nil then CuPut(Result, 'fill', vis.Clone);
    { the visual style's opacity: the itemStyle's, a visualMap's over it
      [Batch 124] }
    if Chart.CustomVisualRow(Slot, ARow, vrow) and vrow.OpacitySet then
      CuPut(Result, 'opacity', TJSONFloatNumber.Create(vrow.Opacity))
    else
    begin
      d := ItemStyleOf('opacity');
      if d <> nil then CuPut(Result, 'opacity', d.Clone);
    end;
  end;
  try
    { createTextStyle(labelModel, null, opt with inheritColor, isNotNormal,
      true) }
    ts := TJSONObject.Create;
    tc := TJSONObject.Create;
    try
      d := LabelOf('color');
      if d <> nil then
      begin
        if (d.JSONType = jtString) and (d.AsString = 'inherit') then
        begin
          if (vis <> nil) and (vis.JSONType = jtString) then ts.Add('fill', vis.AsString)
          else ts.Add('fill', '#000');
        end
        else
          ts.Add('fill', d.Clone);
      end;
      for k := 0 to High(cFonts) do
      begin
        d := LabelOf(cFonts[k]);
        if (d = nil) and not AEmphasis then d := GlobalText(cFonts[k]);
        if d <> nil then ts.Add(cFonts[k], d.Clone);
      end;
      d := LabelOf('align');
      if d <> nil then ts.Add('align', d.Clone);
      d := LabelOf('verticalAlign');
      if d <> nil then ts.Add('verticalAlign', d.Clone);
      d := LabelOf('lineHeight');
      if d <> nil then ts.Add('lineHeight', d.Clone);
      d := LabelOf('textBorderColor');
      if d <> nil then ts.Add('stroke', d.Clone);
      d := LabelOf('textBorderWidth');
      if d <> nil then ts.Add('lineWidth', d.Clone);
      { the text: shown, the default label (the label dimensions' values) }
      show := CuTruthy(LabelOf('show'));
      hasText := False;
      txt := '';
      if show then
      begin
        hasText := True;
        if Store.HasLabelPositions then cells := Store.LabelPositions else cells := nil;
        for k := 0 to High(cells) do
        begin
          if not TTyDataStore.RawCell(Store.RawItem(ARow), cells[k], cell) then
            cell := Default(TTyDataValue);
          if k > 0 then txt := txt + ' ';
          txt := txt + TyJsValueText(cell, '');
        end;
      end;
      { createTextConfig }
      d := LabelOf('position');
      if d <> nil then tc.Add('position', d.Clone);
      d := LabelOf('distance');
      if d <> nil then tc.Add('distance', d.Clone)
      else if not AEmphasis then tc.Add('distance', 5);
      d := LabelOf('offset');
      if d <> nil then tc.Add('offset', d.Clone);
      d := LabelOf('rotate');
      if (d <> nil) and (d.JSONType = jtNumber) then tc.Add('rotation', d.AsFloat * Pi / 180);
      { preFetchFromExtra }
      if AExtra <> nil then
      begin
        if CuTruthy(AExtra.Find('textFill')) then CuPut(Result, 'textFill', AExtra.Find('textFill').Clone);
        if CuTruthy(AExtra.Find('textPosition')) then
          CuPut(Result, 'textPosition', AExtra.Find('textPosition').Clone);
      end;
      { convertToEC4StyleForCustomSerise }
      posD := Result.Find('textPosition');
      if not CuTruthy(posD) then
      begin
        if CuTruthy(tc.Find('position')) then CuPut(Result, 'textPosition', tc.Find('position').Clone)
        else CuPut(Result, 'textPosition', TJSONString.Create('inside'));
      end;
      if not CuNull(tc.Find('offset')) then CuPut(Result, 'textOffset', tc.Find('offset').Clone);
      if not CuNull(tc.Find('rotation')) then CuPut(Result, 'textRotation', tc.Find('rotation').Clone);
      if not CuNull(tc.Find('distance')) then CuPut(Result, 'textDistance', tc.Find('distance').Clone);
      posD := Result.Find('textPosition');
      isInside := (posD <> nil) and (posD.JSONType = jtString)
        and (Pos('inside', posD.AsString) > 0);
      { convertToEC4RichItem(out, textStyle): fill to textFill and -- as
        upstream writes it -- a stroke to textStroke as the fill }
      if ts.IndexOfName('fill') >= 0 then CuPut(Result, 'textFill', ts.Find('fill').Clone);
      if ts.IndexOfName('stroke') >= 0 then
      begin
        if ts.IndexOfName('fill') >= 0 then CuPut(Result, 'textStroke', ts.Find('fill').Clone)
        else CuPut(Result, 'textStroke', TJSONNull.Create);
      end;
      for k := 0 to High(cRich) do
        if ts.IndexOfName(cRich[k, 0]) >= 0 then
          CuPut(Result, cRich[k, 1], ts.Find(cRich[k, 0]).Clone);
      if CuNull(Result.Find('textFill')) then
      begin
        if isInside then
        begin
          CuPut(Result, 'textFill', TJSONString.Create('#fff'));
          if not CuTruthy(Result.Find('textStroke')) then
          begin
            d := Result.Find('fill');
            if CuTruthy(d) then CuPut(Result, 'textStroke', d.Clone)
            else CuPut(Result, 'textStroke', TJSONString.Create('#000'));
          end;
          if CuNull(Result.Find('textStrokeWidth')) then
            CuPut(Result, 'textStrokeWidth', TJSONIntegerNumber.Create(2));
        end
        else
        begin
          d := Result.Find('fill');
          if CuTruthy(d) then CuPut(Result, 'textFill', d.Clone)
          else CuPut(Result, 'textFill', TJSONString.Create('#000'));
        end;
      end
      else if isInside then
      begin
        if not CuTruthy(Result.Find('textStroke')) then
        begin
          d := Result.Find('fill');
          if CuTruthy(d) then CuPut(Result, 'textStroke', d.Clone)
          else CuPut(Result, 'textStroke', TJSONString.Create('#000'));
        end;
        if CuNull(Result.Find('textStrokeWidth')) then
          CuPut(Result, 'textStrokeWidth', TJSONIntegerNumber.Create(2));
      end;
      if hasText then CuPut(Result, 'text', TJSONString.Create(txt))
      else CuPut(Result, 'text', TJSONNull.Create);
    finally
      ts.Free;
      tc.Free;
    end;
  finally
    vis.Free;
  end;
  { applyUserPropsAfter }
  if AExtra <> nil then
    for i := 0 to AExtra.Count - 1 do CuPut(Result, AExtra.Names[i], AExtra.Items[i].Clone);
  CuPut(Result, 'legacy', TJSONBoolean.Create(True));
end;

function TTyChartCustomApi.Style(AExtra: TJSONObject; ADataIndexInside: Integer): TJSONObject;
var r: Integer;
begin
  if not Row(ADataIndexInside, r) then r := -1;
  Result := MakeStyle(AExtra, r, False);
end;

function TTyChartCustomApi.StyleEmphasis(AExtra: TJSONObject; ADataIndexInside: Integer): TJSONObject;
var r: Integer;
begin
  if not Row(ADataIndexInside, r) then r := -1;
  Result := MakeStyle(AExtra, r, True);
end;

{ the style visual's fill and stroke; the item visuals a visualMap sets --
  symbol, symbolSize, liftZ [Batch 124]; the rest a custom series has none
  of }
function TTyChartCustomApi.Visual(const AType: string; ADataIndexInside: Integer): TJSONData;
var
  r: Integer;
  vr: TTyVisualRow;
begin
  Result := nil;
  if not Row(ADataIndexInside, r) then r := -1;
  if AType = 'color' then Result := Chart.CustomVisualFill(Slot, r)
  else if AType = 'borderColor' then
  begin
    Result := Lookup(ItemNode(r), Node, ['itemStyle', 'borderColor']);
    if Result <> nil then Result := Result.Clone;
  end
  else if Chart.CustomVisualRow(Slot, r, vr) then
  begin
    if (AType = 'symbol') and vr.SymbolSet then Result := TJSONString.Create(vr.Symbol)
    else if (AType = 'symbolSize') and vr.SizeSet then Result := TJSONFloatNumber.Create(vr.Size)
    else if (AType = 'liftZ') and vr.LiftZSet then Result := TJSONFloatNumber.Create(vr.LiftZ);
  end;
end;

{ computeBarLayoutForCustomSeries on the base axis: a category axis' band,
  anything else -- and every other coordinate system -- undefined }
function TTyChartCustomApi.BarLayout(AOpt: TJSONObject): TTyCustomBarLayout;
var b: TTySeriesBinding;
begin
  Result := nil;
  if Sys <> cusCart then Exit;
  b := Chart.FBindings[Slot];
  if (b.BaseAxis = nil) or (b.BaseAxis.AxisType <> atCategory) then Exit;
  Result := TyCustomBarLayout(b.BaseAxis.BandWidth / Scale, AOpt);
end;

function TTyChartCustomApi.CurrentSeriesIndices: TTyIntegerArray;
var i, j, n, t: Integer;
begin
  Result := nil;
  n := 0;
  for i := 0 to High(Chart.FBindings) do
  begin
    if Chart.FBindings[i].Hidden or (Chart.FBindings[i].SeriesIndex < 0) then Continue;
    SetLength(Result, n + 1);
    Result[n] := Chart.FBindings[i].SeriesIndex;
    Inc(n);
  end;
  { eachSeries: by series index }
  for i := 1 to n - 1 do
  begin
    t := Result[i];
    j := i - 1;
    while (j >= 0) and (Result[j] > t) do
    begin
      Result[j + 1] := Result[j];
      Dec(j);
    end;
    Result[j + 1] := t;
  end;
end;

{ labelStyle.getFont over the global text style }
function TTyChartCustomApi.Font(AOpt: TJSONObject): string;

  function Part(const AKey, ADefault: string): string;
  var d: TJSONData;
  begin
    d := nil;
    if AOpt <> nil then d := AOpt.Find(AKey);
    if not CuTruthy(d) then d := GlobalText(AKey);
    if CuTruthy(d) then Result := CuText(d) else Result := ADefault;
  end;

begin
  Result := Trim(Part('fontStyle', '') + ' ' + Part('fontWeight', '') + ' '
    + Part('fontSize', '12') + 'px ' + Part('fontFamily', 'sans-serif'));
end;

function TTyChartCustomApi.GetWidth: Double;
begin
  Result := (Chart.FLastRect.Right - Chart.FLastRect.Left) / Scale;
end;

function TTyChartCustomApi.GetHeight: Double;
begin
  Result := (Chart.FLastRect.Bottom - Chart.FLastRect.Top) / Scale;
end;

function TTyChartCustomApi.GetDevicePixelRatio: Double;
begin
  Result := Scale;
end;

{ the style visual's fill of a row: the item's own itemStyle colour, the
  series', else its palette colour -- as written where it was written }
function TTyAdvanceChart.CustomVisualFill(ASlot, ARow: Integer): TJSONData;
var
  node, item: TJSONObject;
  d: TJSONData;
  raw, si: Integer;
  vr: TTyVisualRow;
begin
  Result := nil;
  if (FOption = nil) or (ASlot < 0) or (ASlot > High(FBindings)) then Exit;
  { A VISUALMAP'S COLOUR over the item's and the series' (visualEncoding runs
    after the style visuals): a piece's as written, a computed one as its
    rgba() text, an undefined one undefined [Batch 124] }
  if CustomVisualRow(ASlot, ARow, vr) and vr.ColorSet then
  begin
    if vr.ColorText <> '' then Exit(TJSONString.Create(vr.ColorText));
    if vr.Color.Defined then Exit(TJSONString.Create(TyVisualCss(vr.Color)));
    Exit;
  end;
  si := FBindings[ASlot].SeriesIndex;
  d := FOption.ComponentAt('series', si);
  if not (d is TJSONObject) then Exit;
  node := TJSONObject(d);
  item := nil;
  if (ARow >= 0) and (ASlot <= High(FStores)) and (FStores[ASlot] <> nil)
    and (ARow < FStores[ASlot].Count) then
  begin
    raw := FStores[ASlot].GetRawIndex(ARow);
    d := node.Find('data');
    if (d is TJSONArray) and (raw >= 0) and (raw < d.Count)
      and (TJSONArray(d).Items[raw] is TJSONObject) then
      item := TJSONObject(TJSONArray(d).Items[raw]);
  end;
  d := nil;
  if item <> nil then
  begin
    d := item.FindPath('itemStyle.color');
    if CuNull(d) or ((d.JSONType = jtString) and (d.AsString = 'auto')) then d := nil;
  end;
  if d = nil then
  begin
    d := node.FindPath('itemStyle.color');
    if CuNull(d) or ((d.JSONType = jtString) and (d.AsString = 'auto')) then d := nil;
  end;
  if d <> nil then Exit(d.Clone);
  if (si >= 0) and (si <= High(FSeriesColorNone)) and FSeriesColorNone[si] then
    Exit(TJSONString.Create('none'));
  Result := TJSONString.Create(TyCustomColorText(Cardinal(SeriesColor(si))));
end;

procedure TTyAdvanceChart.CustomDims(ASlot: Integer; var ADims: TTySeriesDimArray);
var
  node, enc: TJSONObject;
  d, names: TJSONData;
  outDims: TTySeriesDimArray;
  dim: TTySeriesDim;
  i, k, n: Integer;
  pos: TTyIntegerArray;
  spread: Boolean;

  function PosOf(A: TJSONData): Integer;
  var q: Integer; e: TJSONData; nm: string;
  begin
    Result := -1;
    if A = nil then Exit;
    if A.JSONType = jtNumber then Exit(Trunc(A.AsFloat));
    if (A.JSONType <> jtString) or not (names is TJSONArray) then Exit;
    for q := 0 to names.Count - 1 do
    begin
      e := TJSONArray(names).Items[q];
      if e.JSONType = jtString then nm := e.AsString
      else if (e is TJSONObject) and (TJSONObject(e).Find('name') <> nil) then
        nm := CuText(TJSONObject(e).Find('name'))
      else nm := '';
      if nm = A.AsString then Exit(q);
    end;
  end;

  procedure Positions(A: TJSONData);
  var q, p: Integer;
  begin
    pos := nil;
    if A = nil then Exit;
    if A is TJSONArray then
    begin
      for q := 0 to A.Count - 1 do
      begin
        p := PosOf(A.Items[q]);
        if p < 0 then Continue;
        SetLength(pos, Length(pos) + 1);
        pos[High(pos)] := p;
      end;
    end
    else
    begin
      p := PosOf(A);
      if p >= 0 then
      begin
        SetLength(pos, 1);
        pos[0] := p;
      end;
    end;
  end;

begin
  if FBindings[ASlot].SeriesType <> TyCustomSeriesType then Exit;
  if FOption = nil then Exit;
  d := FOption.ComponentAt('series', FBindings[ASlot].SeriesIndex);
  if not (d is TJSONObject) then Exit;
  node := TJSONObject(d);
  enc := CuObj(node, 'encode');
  if enc = nil then Exit;
  names := node.Find('dimensions');
  spread := False;
  for i := 0 to High(ADims) do
  begin
    Positions(enc.Find(ADims[i].Name));
    if Length(pos) > 1 then spread := True;
  end;
  if not spread then Exit;
  { EVERY POSITION THE ENCODE NAMES IS A COLUMN, each feeding its
    coordinate: both ends of a span size the axis and both are what a
    dataZoom filters on }
  outDims := nil;
  n := 0;
  for i := 0 to High(ADims) do
  begin
    Positions(enc.Find(ADims[i].Name));
    if Length(pos) = 0 then
    begin
      SetLength(outDims, n + 1);
      outDims[n] := ADims[i];
      Inc(n);
      Continue;
    end;
    for k := 0 to High(pos) do
    begin
      dim := ADims[i];
      if k > 0 then dim.Name := ADims[i].Name + IntToStr(k);
      dim.SourceSlot := pos[k] + 1;
      dim.Coord := ADims[i].Name;
      SetLength(outDims, n + 1);
      outDims[n] := dim;
      Inc(n);
    end;
  end;
  ADims := outDims;
end;

procedure TTyAdvanceChart.SolveCustom(APPI: Integer);
var
  i, si, n, p, c, k: Integer;
  view: TTyCustomView;
  node: TJSONObject;
  d: TJSONData;
  key, spec, coord: string;
  ids: TTyStringArray;
  raws: TTyIntegerArray;
  api: TTyChartCustomApi;
  scale, z, zl, lw, x, y, cw, ch, r0, r1: Double;
  area: TTyXYWH;
  st: TTyDataStore;
  alive: TTyBoolArray;
  arr: TJSONArray;
  sys: TTyCuSys;
  names: array of string;
  anim: TTyCustomAnim;
  cal: TTyCalendar;
  pol: TTyPolar;
  sgl: TTySingle;
  mtx: TTyMatrix;
  isCoord: Boolean;

  { getDateInfo's text fields of a range end }
  function CalDate(const AInfo: TTyCalDateInfo): TTyCustomCalDate;

    function Two(AN: Integer): string;
    begin
      if AN < 10 then Result := '0' + IntToStr(AN) else Result := IntToStr(AN);
    end;

  begin
    Result := Default(TTyCustomCalDate);
    Result.Y := IntToStr(AInfo.Y);
    Result.M := Two(AInfo.M);
    Result.D := Two(AInfo.D);
    Result.Day := AInfo.Day;
    Result.Time := AInfo.Time;
    Result.FormatedDate := Result.Y + '-' + Result.M + '-' + Result.D;
  end;

begin
  if APPI > 0 then scale := APPI / 96 else scale := 1;
  if FOption = nil then n := 0 else n := FOption.ComponentCount('series');
  { the views of series that are gone, or are another series now }
  alive := nil;
  SetLength(alive, Max(n, Length(FCustomViews)));
  for i := 0 to High(FBindings) do
    if (FBindings[i].SeriesType = TyCustomSeriesType) and (FBindings[i].SeriesIndex >= 0) then
      alive[FBindings[i].SeriesIndex] := True;
  for i := 0 to High(FCustomViews) do
    if (FCustomViews[i] <> nil) and ((i >= n) or not alive[i]
      or (FCustomViews[i].Key <> FOption.ComponentId('series', i) + #1 + TyCustomSeriesType)) then
      FreeAndNil(FCustomViews[i]);
  if Length(FCustomViews) < n then SetLength(FCustomViews, n);
  FCustomClipOn := nil;
  FCustomClip := nil;
  SetLength(FCustomClipOn, Length(FBindings));
  SetLength(FCustomClip, Length(FBindings));
  for i := 0 to High(FBindings) do
  begin
    if FBindings[i].SeriesType <> TyCustomSeriesType then Continue;
    si := FBindings[i].SeriesIndex;
    if (si < 0) or (si >= n) then Continue;
    key := FOption.ComponentId('series', si) + #1 + TyCustomSeriesType;
    view := FCustomViews[si];
    if view = nil then
    begin
      view := TTyCustomView.Create;
      view.Key := key;
      FCustomViews[si] := view;
    end;
    st := nil;
    if i <= High(FStores) then st := FStores[i];
    { THE COORDINATE SYSTEM, the prepareCustom it has [Batch 124]: a
      cartesian, a polar, a single axis, a calendar -- or none at all }
    sys := cusUnknown;
    pol := nil;
    sgl := nil;
    cal := nil;
    mtx := nil;
    if FBindings[i].Cart <> nil then sys := cusCart
    else if FBindings[i].Polar <> nil then
    begin
      sys := cusPolar;
      pol := TTyPolar(FBindings[i].Polar);
    end
    else if FBindings[i].Single <> nil then
    begin
      sys := cusSingle;
      sgl := TTySingle(FBindings[i].Single);
    end
    else if (FBindings[i].CalendarIndex >= 0) and (FBindings[i].CalendarIndex <= High(FCalendars))
      and (FCalendars[FBindings[i].CalendarIndex] <> nil) then
    begin
      sys := cusCalendar;
      cal := FCalendars[FBindings[i].CalendarIndex];
    end
    { a matrix: prepareCustom's rect, api.coord / api.layout [Batch 147] }
    else if (FBindings[i].MatrixIndex >= 0) and not FBindings[i].MatrixBox
      and (FBindings[i].MatrixIndex <= High(FMatrices))
      and (FMatrices[FBindings[i].MatrixIndex] <> nil) then
    begin
      sys := cusMatrix;
      mtx := FMatrices[FBindings[i].MatrixIndex];
    end
    { a geo [Batch 152] }
    else if GeoOfSlot(i) <> nil then sys := cusGeo
    else if CustomOnNone(i) then sys := cusNone;
    { NOT RENDERED: a series the legend switched off has its group emptied
      (ChartView.remove) and keeps its data; one on a coordinate system with
      no prepareCustom is not drawn }
    if FBindings[i].Hidden or (not FBindings[i].Resolved) or (sys = cusUnknown)
      or (st = nil) then
    begin
      view.RemoveAll;
      { A COORDINATE SYSTEM WITH NO prepareCustom (a radar, a graph's view):
        upstream asserts in its development build and calls undefined in its
        production one; nothing is drawn and the chart says so. A matrix
        does not resolve at all (its binding said so); a geo has its
        prepareCustom [Batch 152]. }
      if FBindings[i].Resolved and not FBindings[i].Hidden and (sys = cusUnknown) then
        FBuild.Note(Format(rsTyChartSeriesCoordSys, [si, FBindings[i].CoordSysName]));
      Continue;
    end;
    d := FOption.ComponentAt('series', si);
    if not (d is TJSONObject) then Continue;
    node := TJSONObject(d);
    AnimRowKeys(st, ids, raws);
    { the handler }
    FCustomHandler := nil;
    spec := '';
    d := node.Find('renderItem');
    if (d <> nil) and (d.JSONType = jtString) then spec := d.AsString;
    if not TyChartFindRenderItem(spec, FCustomHandler) then
    begin
      FCustomHandler := nil;
      FBuild.Note(Format(rsTyChartCustomNoRenderItem, [si, spec]));
    end;
    FCustomMissing := spec;
    { the api and the params of this round }
    api := TTyChartCustomApi.Create;
    api.Chart := Self;
    api.Slot := i;
    api.Series := si;
    api.Store := st;
    api.Node := node;
    api.Current := -1;
    api.Scale := scale;
    api.Sys := sys;
    api.Polar := pol;
    api.Single := sgl;
    api.Calendar := cal;
    api.Matrix := mtx;
    api.Geo := GeoOfSlot(i);
    FCustomApi := api;
    FCustomSlot := i;
    FCustomParams := Default(TTyCustomParams);
    FCustomParams.Context := TJSONObject.Create;
    FCustomParams.SeriesId := FOption.ComponentId('series', si);
    FCustomParams.SeriesName := SeriesModelName(si);
    FCustomParams.SeriesIndex := si;
    FCustomParams.DataInsideLength := st.Count;
    FCustomParams.ActionType := FCustomAction;
    { coordSys: each system's prepareCustom, in css px }
    names := nil;
    case sys of
      cusCart:
        begin
          area := FBindings[i].Cart.GetArea;
          FCustomParams.CoordSys.Type_ := 'cartesian2d';
          FCustomParams.CoordSys.X := area.X / scale;
          FCustomParams.CoordSys.Y := area.Y / scale;
          FCustomParams.CoordSys.Width := area.W / scale;
          FCustomParams.CoordSys.Height := area.H / scale;
          SetLength(names, 2);
          names[0] := 'x';
          names[1] := 'y';
        end;
      cusPolar:
        begin
          { the radius extent, the lesser first }
          pol.AxisExtent(pol.RadiusAxis, r0, r1);
          if r0 > r1 then
          begin
            x := r0;
            r0 := r1;
            r1 := x;
          end;
          FCustomParams.CoordSys.Type_ := 'polar';
          FCustomParams.CoordSys.Cx := pol.CX / scale;
          FCustomParams.CoordSys.Cy := pol.CY / scale;
          FCustomParams.CoordSys.R := r1 / scale;
          FCustomParams.CoordSys.R0 := r0 / scale;
          SetLength(names, 2);
          names[0] := TyPolarRadiusDim;
          names[1] := TyPolarAngleDim;
        end;
      cusSingle:
        begin
          FCustomParams.CoordSys.Type_ := 'singleAxis';
          FCustomParams.CoordSys.X := sgl.Rect.X / scale;
          FCustomParams.CoordSys.Y := sgl.Rect.Y / scale;
          FCustomParams.CoordSys.Width := sgl.Rect.W / scale;
          FCustomParams.CoordSys.Height := sgl.Rect.H / scale;
          SetLength(names, 1);
          names[0] := TySingleDim;
        end;
      cusCalendar:
        begin
          FCustomParams.CoordSys.Type_ := 'calendar';
          FCustomParams.CoordSys.X := cal.Rect.X / scale;
          FCustomParams.CoordSys.Y := cal.Rect.Y / scale;
          FCustomParams.CoordSys.Width := cal.Rect.W / scale;
          FCustomParams.CoordSys.Height := cal.Rect.H / scale;
          FCustomParams.CoordSys.CellWidth := cal.CellW / scale;
          FCustomParams.CoordSys.CellHeight := cal.CellH / scale;
          FCustomParams.CoordSys.RangeStart := CalDate(cal.Range.Start);
          FCustomParams.CoordSys.RangeEnd := CalDate(cal.Range.Stop);
          FCustomParams.CoordSys.Weeks := cal.Range.Weeks;
          FCustomParams.CoordSys.DayCount := cal.Range.AllDay;
          SetLength(names, 2);
          names[0] := TyCalendarTimeDim;
          names[1] := TyCalendarValueDim;
        end;
      cusMatrix:
        begin
          { prepareCustom: the matrix rect; the coordinate dimensions are
            x, y and value }
          FCustomParams.CoordSys.Type_ := TyMatrixCoordSysName;
          FCustomParams.CoordSys.X := mtx.Rect.X / scale;
          FCustomParams.CoordSys.Y := mtx.Rect.Y / scale;
          FCustomParams.CoordSys.Width := mtx.Rect.W / scale;
          FCustomParams.CoordSys.Height := mtx.Rect.H / scale;
          SetLength(names, 3);
          names[0] := TyMatrixXDim;
          names[1] := TyMatrixYDim;
          names[2] := TyMatrixValueDim;
        end;
      { the map's data rect, not pixels, and the view's zoom [Batch 152] }
      cusGeo:
        begin
          FCustomParams.CoordSys.Type_ := 'geo';
          FCustomParams.CoordSys.X := GeoOfSlot(i).DataRect.X;
          FCustomParams.CoordSys.Y := GeoOfSlot(i).DataRect.Y;
          FCustomParams.CoordSys.Width := GeoOfSlot(i).DataRect.W;
          FCustomParams.CoordSys.Height := GeoOfSlot(i).DataRect.H;
          FCustomParams.CoordSys.Zoom := GeoOfSlot(i).Zoom;
          SetLength(names, 2);
          names[0] := TyGeoLngDim;
          names[1] := TyGeoLatDim;
        end;
    else
      begin
        { 'none': no coordSys, the dimensions getCoordSysDimDefs made }
        FCustomParams.CoordSys.Type_ := '';
        SetLength(names, 2);
        names[0] := 'x';
        names[1] := 'y';
      end;
    end;
    { wrapEncodeDef: every coordinate column's data dimension, by position }
    FCustomParams.Encode := TJSONObject.Create;
    for p := 0 to Max(st.RawWidth, st.DimCount) - 1 do
      for c := 0 to st.DimCount - 1 do
      begin
        if st.RawDimPos(c) <> p then Continue;
        coord := st.DimCoord(c);
        if coord = '' then coord := st.DimName(c);
        isCoord := False;
        for k := 0 to High(names) do
          if names[k] = coord then isCoord := True;
        if not isCoord then Continue;
        d := FCustomParams.Encode.Find(coord);
        if not (d is TJSONArray) then
        begin
          arr := TJSONArray.Create;
          FCustomParams.Encode.Add(coord, arr);
        end
        else
          arr := TJSONArray(d);
        arr.Add(p);
      end;
    d := node.Find('itemPayload');
    if CuTruthy(d) and (d is TJSONObject) then
      FCustomParams.ItemPayload := TJSONObject(d.Clone)
    else
      FCustomParams.ItemPayload := TJSONObject.Create;
    d := node.Find('z');
    if (d <> nil) and (d.JSONType = jtNumber) then z := d.AsFloat else z := 2;
    d := node.Find('zlevel');
    if (d <> nil) and (d.JSONType = jtNumber) then zl := d.AsFloat else zl := 0;
    { THE TRANSITIONS' MODEL is the series [Batch 124]: isAnimationEnabled
      (its data count against animationThreshold) under the chart's own
      switch, getAnimationConfig's timing with the update's payload }
    anim := Default(TTyCustomAnim);
    anim.Model := TyAnimSeriesModel(FOption.Root, si, st.Count);
    anim.Model.Payload := FAnimPayload;
    anim.Model.HasPayload := FAnimHasPayload;
    anim.Enabled := AnimAllowed and TyAnimIsEnabled(anim.Model);
    anim.Driver := FCuAnim;
    try
      view.Render(ids, raws, @CustomCall, z, zl, anim);
    finally
      FreeAndNil(FCustomParams.Context);
      FreeAndNil(FCustomParams.Encode);
      FreeAndNil(FCustomParams.ItemPayload);
      FCustomApi := nil;
      FCustomHandler := nil;
      api.Free;
    end;
    if view.Error <> '' then FBuild.Note('series[' + IntToStr(si) + ']: ' + view.Error);
    { createGridClipPath: the grid's area widened by lineStyle.width, its
      width ceiled, a fractional x floored -- a cartesian's only (a polar's
      sector clip is not drawn here) }
    if (sys = cusCart) and CuTruthy(node.Find('clip')) then
    begin
      d := node.FindPath('lineStyle.width');
      if (d <> nil) and (d.JSONType = jtNumber) and not IsNan(d.AsFloat) then lw := d.AsFloat
      else lw := 0;
      x := area.X / scale - lw / 2;
      y := area.Y / scale - lw / 2;
      cw := area.W / scale + lw;
      ch := area.H / scale + lw;
      cw := Ceil(cw);
      if x <> Floor(x) then
      begin
        x := Floor(x);
        cw := cw + 1;
      end;
      FCustomClipOn[i] := True;
      FCustomClip[i] := TyXYWH(x, y, cw, ch);
    end;
  end;
  { THE FLUSH: upstream's setOption ends with a synchronous update that
    steps every clip the render made, so each starts NOW and this paint
    shows the from values [Batch 124] }
  if CuLive then
  begin
    FCuAnim.Update(AnimClock, True);
    AnimArmTimer;
  end;
end;

{ renderItem for one item of the series being rendered }
function TTyAdvanceChart.CustomCall(AIndexInside: Integer): TJSONData;
var
  api: TTyChartCustomApi;
  nLine, nCol: Integer;
begin
  Result := nil;
  api := TTyChartCustomApi(FCustomApi);
  api.Current := AIndexInside;
  FCustomParams.DataIndexInside := AIndexInside;
  FCustomParams.DataIndex := api.Store.GetRawIndex(AIndexInside);
  if not Assigned(FCustomHandler) then Exit;
  try
    Result := FCustomHandler(FCustomParams, api);
  except
    on E: Exception do
    begin
      Result := nil;
      FBuild.Note(Format(rsTyChartCustomRenderItemFailed,
        [FCustomParams.SeriesIndex, FCustomMissing, E.Message]));
    end;
  end;
  { a tree too deep for the readers is no tree -- and the chart says so }
  if (Result <> nil) and TyJsonNestingExceeds(Result.AsJSON, TyOptionMaxNesting,
    nLine, nCol) then
  begin
    FreeAndNil(Result);
    FBuild.Note(Format(rsTyChartCustomRenderItemFailed, [FCustomParams.SeriesIndex,
      FCustomMissing, Format(rsTyOptTooDeep, [TyOptionMaxNesting])]));
  end;
end;

function TTyAdvanceChart.CustomBuild(ASlot: Integer; AList: TTyPaintList;
  APPI: Integer): Integer;
var
  si, i, inside, raw: Integer;
  view: TTyCustomView;
  root, el: TTyGfxEl;
  meas: ITyTextMeasurer;
  ground: TTyGfxGround;
  ctx: TTyGfxPaintCtx;
  scale, maxZ2: Double;
  datum: TTyChartDatumRef;
  clipOn: Boolean;
  clip: TTyRectF;
  all: TTyGfxElArray;

  { doUpdateZ over one item's tree: the running greatest z2 lifts each
    textContent to it + 2 }
  procedure UpdZ(AEl: TTyGfxEl);
  var k: Integer;
  begin
    if AEl.IsGroup then
    begin
      for k := 0 to High(AEl.Children) do UpdZ(AEl.Children[k]);
      Exit;
    end;
    if AEl.Z2 > maxZ2 then maxZ2 := AEl.Z2;
    if AEl.TextContent <> nil then
    begin
      AEl.TextContent.Z := AEl.Z;
      AEl.TextContent.ZLevel := AEl.ZLevel;
      if not IsInfinite(maxZ2) then AEl.TextContent.Z2 := maxZ2 + 2;
    end;
  end;

  procedure Add(AEl: TTyGfxEl; ASilent: Boolean);
  var
    pe: TTyChartElement;
    k: Integer;
    d: TJSONData;
  begin
    { A TEXT OF NO TEXT has no line, so no tspan, so nothing in the display
      list (parsePlainText: `text ? text.split('\n') : []`) -- the empty
      label an ec4 style makes when the label is not shown }
    if AEl.Kind = gkText then
    begin
      d := AEl.Style.Find('text');
      if (d = nil) or (d.JSONType = jtNull) or ((d.JSONType = jtString) and (d.AsString = '')) then
        Exit;
    end;
    if not TyGfxPaintElement(AEl, meas, ctx, pe) then Exit;
    pe.Silent := ASilent;
    pe.Datum := datum;
    pe.Z := Round(AEl.ZLevel) * 100000 + Round(AEl.Z);
    pe.Z2 := Round(AEl.Z2);
    if clipOn then
    begin
      pe.HasClip := True;
      pe.ClipRect := clip;
    end;
    k := AList.Add(pe);
    if Length(FCustomPaintEls) <= k then SetLength(FCustomPaintEls, k + 1);
    FCustomPaintEls[k] := AEl;
    Inc(Result);
  end;

  procedure Walk(AEl: TTyGfxEl; ASilent: Boolean);
  var k: Integer; s: Boolean;
  begin
    if AEl.Ignore then Exit;
    s := ASilent or AEl.Silent;
    if AEl.IsGroup then
    begin
      for k := 0 to High(AEl.Children) do Walk(AEl.Children[k], s);
      Exit;
    end;
    Add(AEl, s);
    if (AEl.TextContent <> nil) and not AEl.TextContent.Ignore then
      Add(AEl.TextContent, s or AEl.TextContent.Silent);
  end;

begin
  Result := 0;
  si := FBindings[ASlot].SeriesIndex;
  view := CustomView(si);
  if (view = nil) or (ASlot > High(FStores)) or (FStores[ASlot] = nil) then Exit;
  if APPI <= 0 then APPI := 96;
  scale := APPI / 96;
  meas := NewTextMeasurer(96);
  { the transforms and the textContents' places }
  TyGfxUpdateTransforms(view.Root);
  MarkerGround(ground.Background, ground.IsDark);
  all := nil;
  TyGfxTraverse(view.Root, all);
  for i := 0 to High(all) do
    if all[i].TextContent <> nil then
    begin
      TyGfxInnerText(all[i], meas, ground);
      TyGfxLabelTransform(all[i].TextContent, all[i].TextContent.HasTransform,
        all[i].TextContent.Transform);
    end;
  ctx := Default(TTyGfxPaintCtx);
  ctx.Scale := scale;
  ctx.HasInk := True;
  ctx.Ink := TTyChartColor(ActiveController.Model.ResolveStyle(GetStyleTypeKey,
    StyleClass, [tysNormal]).TextColor);
  ctx.ImageSize := @GfxImageSize;
  clipOn := (ASlot <= High(FCustomClipOn)) and FCustomClipOn[ASlot];
  if clipOn then
    clip := TyRectF(FCustomClip[ASlot].X * scale, FCustomClip[ASlot].Y * scale,
      (FCustomClip[ASlot].X + FCustomClip[ASlot].W) * scale,
      (FCustomClip[ASlot].Y + FCustomClip[ASlot].H) * scale);
  { which item each root draws }
  for i := 0 to FStores[ASlot].Count - 1 do
  begin
    el := view.ElOf(i);
    if el <> nil then el.Serial := i;
  end;
  for i := 0 to High(view.Root.Children) do
  begin
    root := view.Root.Children[i];
    inside := root.Serial;
    if (inside < 0) or (view.ElOf(inside) <> root) then Continue;
    raw := FStores[ASlot].GetRawIndex(inside);
    datum := TyChartDatum(si, inside, raw);
    maxZ2 := NegInfinity;
    UpdZ(root);
    Walk(root, False);
  end;
end;

{ a custom element's declared state, as its option wrote it: the style's
  fill, stroke, lineWidth and opacity, and the state's z2 }
function StCustomDecl(AInfo: TTyCustomElInfo; AName: TTyStName): TTyStObject;
var
  idx: Integer;
  st: TJSONObject;
  d: TJSONData;
  c: TTyChartColor;

  procedure Colour(const AKey: string; ASt: TTyStKey);
  begin
    d := st.Find(AKey);
    if d = nil then Exit;
    if (d.JSONType = jtNull) or ((d.JSONType = jtString) and TyChartColorIsNone(d.AsString)) then
      TyStSetNone(Result, ASt)
    else if (d.JSONType = jtString) and (d.AsString = 'inherit') and (ASt = stkFill) then
      Result.FillInherit := True
    else if (d.JSONType = jtString) and TyTryParseChartColor(d.AsString, c) then
      TyStSetColor(Result, ASt, c);
  end;

begin
  Result := TyStNoObject;
  if AInfo = nil then Exit;
  case AName of
    stnEmphasis: idx := 0;
    stnBlur: idx := 1;
  else
    idx := 2;
  end;
  st := AInfo.StateStyle[idx];
  if st <> nil then
  begin
    Colour('fill', stkFill);
    Colour('stroke', stkStroke);
    d := st.Find('lineWidth');
    if (d <> nil) and (d.JSONType = jtNumber) then TyStSetNum(Result, stkLineWidth, d.AsFloat);
    d := st.Find('opacity');
    if (d <> nil) and (d.JSONType = jtNumber) then TyStSetNum(Result, stkOpacity, d.AsFloat);
  end;
  if not IsNan(AInfo.StateZ2[idx]) then TyStSetNum(Result, stkZ2, AInfo.StateZ2[idx]);
end;

{ a custom item's elements: every path of its tree has the three states
  updateElOnState gives it, the default proxy and the lift of 1 }
procedure TTyAdvanceChart.StDeclareCustom(ASlot, ARaw: Integer; AList: TTyPaintList);
var
  s, k: Integer;
  item: PTyStItem;
  was: Boolean;

  procedure Declare(var AEl: TTyStElement; AIdx: Integer);
  var
    gel: TTyGfxEl;
    info: TTyCustomElInfo;
    n: TTyStName;
  begin
    gel := CustomPaintSource(AIdx);
    info := nil;
    if (gel <> nil) and (gel.Custom is TTyCustomElInfo) then info := TTyCustomElInfo(gel.Custom);
    AEl.Exists := True;
    AEl.IsPath := True;
    AEl.Proxy := True;
    AEl.LiftOne := True;
    for n := Low(TTyStName) to High(TTyStName) do
    begin
      AEl.HasState[n] := True;
      AEl.Decl[n] := StCustomDecl(info, n);
    end;
    AEl.Rest := StRestOf(AList.Element(AIdx));
  end;

begin
  s := FBindings[ASlot].SeriesIndex;
  item := @FSt[s].Rows[ARaw];
  Declare(item^.Host, FSt[s].HostIdx[ARaw]);
  if Length(item^.Parts) <> Length(FSt[s].PartIdx[ARaw]) then SetLength(item^.Parts, 0);
  was := Length(item^.Parts) > 0;
  SetLength(item^.Parts, Length(FSt[s].PartIdx[ARaw]));
  for k := 0 to High(item^.Parts) do
  begin
    Declare(item^.Parts[k], FSt[s].PartIdx[ARaw][k]);
    if not was then
    begin
      item^.Parts[k].Cur := item^.Parts[k].Rest;
      item^.Parts[k].States := [];
      if item^.Host.States <> [] then TyStUseStates(item^.Parts[k], item^.Host.States);
    end;
  end;
end;

{ ==================== export and loading [Batch 106] ==================== }

function TTyAdvanceChart.ViewHidden(AView: TTyChartView): Boolean;
begin
  Result := FExporting and (AView in FExportExclude);
end;

procedure TTyAdvanceChart.ViewDrew(AView: TTyChartView);
begin
  Include(FViewsDrawn, AView);
end;

function TTyAdvanceChart.LastViewsDrawn: TTyChartViews;
begin
  Result := FViewsDrawn;
end;

procedure TTyAdvanceChart.ExportOptsOrRaise(const AJson: string;
  out AOpts: TTyChartExportOpts);
begin
  if not TyExportOptsOf(AJson, AOpts) then
    raise EArgumentException.Create(rsTyChartExportOptsBad);
end;

{ getDataURL's render. The background first -- the options', else the
  option's, else the skin's frame -- then the chart as an export draws it,
  straight onto a 32-bit bitmap so the alpha a transparent background leaves
  survives. A render at another size or PPI than the window's lays the chart
  out at that size, and the window's layout is put back afterwards: the
  legend, the dataZoom and the hit test answer from it. }
function TTyAdvanceChart.RenderExport(const AOpts: TTyChartExportOpts): TBGRABitmap;
var
  w, h, ppi, ppi0: Integer;
  bg: TTyExportBg;
  chosen, owned: TJSONData;
  P: TTyPainter;
  R: TRect;
  measurer: ITyTextMeasurer;
  el: TTyChartElement;
  drawn: TTyChartViews;
  scratch: TBGRABitmap;
begin
  Result := nil;
  if (Width <= 0) or (Height <= 0) then Exit;
  ppi0 := Font.PixelsPerInch;
  if ppi0 <= 0 then ppi0 := 96;
  TyExportImageSize(Width, Height, ppi0, AOpts.PixelRatio, w, h, ppi);
  if (w <= 0) or (h <= 0) then Exit;
  { `opts.backgroundColor || model.get('backgroundColor')`, and then the
    painter's own: the skin's }
  owned := nil;
  chosen := nil;
  try
    if AOpts.HasBackground then
    begin
      owned := GetJSON(AOpts.BackgroundJson);
      chosen := owned;
    end
    else if FOption <> nil then
    begin
      chosen := FOption.Find('backgroundColor');
      if not TyJsTruthy(chosen) then chosen := nil;
    end;
    bg := TyExportBackgroundOf(chosen);
  finally
    owned.Free;
  end;
  Result := TBGRABitmap.Create(w, h, BGRAPixelTransparent);
  R := Rect(0, 0, w, h);
  measurer := NewTextMeasurer(ppi);
  P := TTyPainter.Create;
  FExporting := True;
  FExportBare := bg.Kind <> ebkTheme;
  FExportExclude := AOpts.Exclude;
  try
    StApplyChanged;
    P.BeginPaintOn(nil, R, ppi, Result);
    { Layer.clear: the whole image, before anything is drawn }
    case bg.Kind of
      ebkSolid, ebkBlack:
        begin
          if bg.Kind = ebkBlack then bg.Color := $FF000000;
          P.BeginPath;
          P.RectPath(0, 0, w, h);
          P.FillPath(TTyColor(bg.Color));
        end;
      ebkGradient, ebkPattern:
        begin
          el := TyChartElement(TyShapeRect(TyRectF(0, 0, w, h)));
          el.Style.HasFill := True;
          el.Style.Alpha := 1;
          if bg.Kind = ebkGradient then el.Style.FillGradient := bg.Gradient
          else el.Style.FillPattern := bg.Pattern;
          TyRenderElement(P, el);
        end;
    end;
    PaintStatic(P, R, ppi, measurer);
    PaintDynamic(P, R, ppi, measurer);
    P.EndPaint;
  finally
    FExportExclude := [];
    P.Free;
    { and back: FExporting stays on through the window's own layout below,
      so that render arms, binds and steps nothing either }
    drawn := FViewsDrawn;
    try
      if (w <> Width) or (h <> Height) or (ppi <> ppi0) then
      begin
        FExportBare := True;
        scratch := TBGRABitmap.Create(Width, Height);
        P := TTyPainter.Create;
        try
          measurer := NewTextMeasurer(ppi0);
          P.BeginPaintOn(nil, Rect(0, 0, Width, Height), ppi0, scratch);
          PaintStatic(P, Rect(0, 0, Width, Height), ppi0, measurer);
          P.EndPaint;
        finally
          P.Free;
          scratch.Free;
        end;
        { the list is the window's again; the cached picture is not }
        StaticDrop;
      end
      else
        { the list was built for the export (its views excluded, nothing bound):
          the window builds its own }
        DropStatic;
    finally
      FExporting := False;
      FExportBare := False;
      FViewsDrawn := drawn;
    end;
    InvalidateFrame;
  end;
end;

procedure TTyAdvanceChart.WriteExport(AStream: TStream; ABmp: TBGRABitmap;
  AType: TTyExportImageType);
var
  jpg: TBGRABitmap;
  writer: TFPWriterJPEG;
begin
  if AType <> eitJpeg then
  begin
    ABmp.SaveToStreamAsPng(AStream);
    Exit;
  end;
  { A CANVAS MAKES A JPEG OF ITS PIXELS OVER OPAQUE BLACK -- the format has
    no alpha -- at its default quality, 0.92 }
  jpg := TBGRABitmap.Create(ABmp.Width, ABmp.Height, BGRABlack);
  writer := TFPWriterJPEG.Create;
  try
    jpg.PutImage(0, 0, ABmp, dmDrawWithTransparency);
    writer.CompressionQuality := 92;
    TFPCustomImage(jpg).SaveToStream(AStream, writer);
  finally
    writer.Free;
    jpg.Free;
  end;
end;

function TTyAdvanceChart.RenderToBitmap(const AOptsJson: string): TBGRABitmap;
var o: TTyChartExportOpts;
begin
  ExportOptsOrRaise(AOptsJson, o);
  Result := RenderExport(o);
end;

procedure TTyAdvanceChart.SaveToStream(AStream: TStream; const AOptsJson: string);
var
  o: TTyChartExportOpts;
  bmp: TBGRABitmap;
begin
  ExportOptsOrRaise(AOptsJson, o);
  bmp := RenderExport(o);
  if bmp = nil then Exit;
  try
    WriteExport(AStream, bmp, o.ImageType);
  finally
    bmp.Free;
  end;
end;

function TTyAdvanceChart.SaveToBytes(const AOptsJson: string): TBytes;
var ms: TMemoryStream;
begin
  Result := nil;
  ms := TMemoryStream.Create;
  try
    SaveToStream(ms, AOptsJson);
    SetLength(Result, ms.Size);
    if ms.Size > 0 then Move(ms.Memory^, Result[0], ms.Size);
  finally
    ms.Free;
  end;
end;

procedure TTyAdvanceChart.SaveToFile(const AFileName: string; const AOptsJson: string);
var
  o: TTyChartExportOpts;
  bmp: TBGRABitmap;
  fs: TFileStream;
  ext: string;
begin
  ExportOptsOrRaise(AOptsJson, o);
  if not o.HasType then
  begin
    ext := LowerCase(ExtractFileExt(AFileName));
    if (ext = '.jpg') or (ext = '.jpeg') then o.ImageType := eitJpeg;
  end;
  bmp := RenderExport(o);
  if bmp = nil then Exit;
  try
    fs := TFileStream.Create(AFileName, fmCreate);
    try
      WriteExport(fs, bmp, o.ImageType);
    finally
      fs.Free;
    end;
  finally
    bmp.Free;
  end;
end;

function TTyAdvanceChart.GetDataURL(const AOptsJson: string): string;
var
  o: TTyChartExportOpts;
  bmp: TBGRABitmap;
  ms: TMemoryStream;
  raw: RawByteString;
begin
  ExportOptsOrRaise(AOptsJson, o);
  bmp := RenderExport(o);
  if bmp = nil then Exit('data:,');
  ms := TMemoryStream.Create;
  try
    WriteExport(ms, bmp, o.ImageType);
    SetLength(raw, ms.Size);
    if ms.Size > 0 then Move(ms.Memory^, raw[1], ms.Size);
  finally
    ms.Free;
    bmp.Free;
  end;
  if o.ImageType = eitJpeg then Result := 'data:image/jpeg;base64,'
  else Result := 'data:image/png;base64,';
  Result := Result + EncodeStringBase64(raw);
end;

procedure TTyAdvanceChart.SaveToPng(const AFileName: string);
var
  o: TTyChartExportOpts;
  bmp: TBGRABitmap;
  fs: TFileStream;
begin
  { the export with no options, a PNG whatever the name says }
  o := Default(TTyChartExportOpts);
  o.ImageType := eitPng;
  bmp := RenderExport(o);
  if bmp = nil then Exit;
  try
    fs := TFileStream.Create(AFileName, fmCreate);
    try
      WriteExport(fs, bmp, eitPng);
    finally
      fs.Free;
    end;
  finally
    bmp.Free;
  end;
end;

{ ---- the loading effect ---- }

function TTyAdvanceChart.LoadLive: Boolean;
begin
  Result := FLoadShown and (FLoadAnim <> nil) and (FLoadAnim.ClipCount > 0)
    and (FAnimMode <> camOff);
end;

procedure TTyAdvanceChart.LoadDrop;
begin
  { freeing the element takes its clips off the driver }
  FreeAndNil(FLoadArc);
end;

procedure TTyAdvanceChart.ShowLoading(const ACfgJson: string);
begin
  ShowLoading('', ACfgJson);
end;

procedure TTyAdvanceChart.ShowLoading(const AName, ACfgJson: string);
var cfg: TTyLoadingCfg;
begin
  if not TyLoadingCfgOf(ACfgJson, rsTyChartLoading, cfg) then
    raise EArgumentException.Create(rsTyChartLoadingCfgBad);
  { hideLoading first, then the name: an unknown one has hidden the old
    effect and shows nothing }
  HideLoading;
  if (AName <> '') and (AName <> 'default') then Exit;
  FLoadCfg := cfg;
  FLoadShown := True;
  if FLoadCfg.ShowSpinner then
  begin
    if FLoadAnim = nil then FLoadAnim := TTyAnimation.Create;
    FLoadArc := TTyAnimBag.Create;
    FLoadArc.Animation := FLoadAnim;
    { the clips start at their first step: the next tick, upstream's next
      frame }
    TyLoadingStartSpinner(FLoadArc);
  end;
  AnimArmTimer;
  InvalidateFrame;
end;

procedure TTyAdvanceChart.HideLoading;
begin
  if not FLoadShown and (FLoadArc = nil) then Exit;
  LoadDrop;
  FLoadShown := False;
  FLoadGeoValid := False;
  AnimArmTimer;
  InvalidateFrame;
end;

function TTyAdvanceChart.LoadingGeometry(out AGeo: TTyLoadingGeometry): Boolean;
begin
  AGeo := FLoadGeo;
  Result := FLoadShown and FLoadGeoValid;
end;

function TTyAdvanceChart.LoadingCfg: TTyLoadingCfg;
begin
  Result := FLoadCfg;
end;

function TTyAdvanceChart.LoadingArcAngles(out AStart, AEnd: Double): Boolean;
begin
  AStart := NaN;
  AEnd := NaN;
  Result := FLoadShown and (FLoadArc <> nil);
  if not Result then Exit;
  AStart := FLoadArc.Num('shape.startAngle');
  AEnd := FLoadArc.Num('shape.endAngle');
end;

function TTyAdvanceChart.LoadingClipCount: Integer;
begin
  if FLoadAnim = nil then Result := 0 else Result := FLoadAnim.ClipCount;
end;

{ default.ts, drawn: the mask over the whole chart, the text hung left /
  middle off its anchor, the arc clockwise from its start to its end with
  round caps. Measured in device px and laid out in CSS px, as upstream's
  numbers are -- at 96 PPI the two are the same bits. }
procedure TTyAdvanceChart.PaintLoading(APainter: TTyPainter; const ARect: TRect;
  APPI: Integer; const AMeasurer: ITyTextMeasurer);
var
  st, spin: TTyStyleSet;
  s, devW, devH, tw, th, cx, cy, r, sweep, a0: Double;
  fontName: string;
  fontSize, weight: Integer;
  ink: TTyColor;
  path: TTyZrPath;
  box: TRect;
begin
  if not FLoadShown then Exit;
  st := ActiveController.Model.ResolveStyle('TyAdvChartLoading', '', []);
  spin := ActiveController.Model.ResolveStyle('TyAdvChartLoadingSpinner', '', []);
  fontName := st.FontName;
  if FLoadCfg.FontFamily <> '' then fontName := FLoadCfg.FontFamily;
  fontSize := ResolveFontSize(st);
  if FLoadCfg.HasFontSize then fontSize := FLoadCfg.FontSizeLogical;
  weight := st.FontWeight;
  if FLoadCfg.HasFontWeight then weight := FLoadCfg.FontWeight;
  if APPI > 0 then s := APPI / 96 else s := 1;
  devW := ARect.Right - ARect.Left;
  devH := ARect.Bottom - ARect.Top;
  tw := 0;
  th := 0;
  if FLoadCfg.Text <> '' then
    AMeasurer.MeasureLine(FLoadCfg.Text, fontName, fontSize, weight, tw, th);
  TyLoadingLayout(devW / s, devH / s, tw / s, FLoadCfg.ShowSpinner,
    FLoadCfg.SpinnerRadius, FLoadGeo);
  FLoadGeoValid := True;

  { the mask }
  case FLoadCfg.MaskColor.Kind of
    likColour: ink := TTyColor(FLoadCfg.MaskColor.Colour);
    likNone: ink := 0;
  else
    if tpBackground in st.Present then ink := st.Background.Color else ink := 0;
  end;
  if TyAlphaOf(ink) > 0 then
  begin
    APainter.BeginPath;
    APainter.RectPath(ARect.Left, ARect.Top, ARect.Right, ARect.Bottom);
    APainter.FillPath(ink);
  end;

  { the text, its left edge on the anchor and its middle on the line }
  case FLoadCfg.TextColor.Kind of
    likColour: ink := TTyColor(FLoadCfg.TextColor.Colour);
    likNone: ink := 0;
  else
    ink := st.TextColor;
  end;
  if (FLoadCfg.Text <> '') and (TyAlphaOf(ink) > 0) then
  begin
    box.Left := ARect.Left + Round(FLoadGeo.TextX * s);
    box.Top := ARect.Top + Round(FLoadGeo.TextY * s - th / 2);
    { to the edge: a left-aligned run needs no right, and a box one pixel
      short would cut its last glyph }
    box.Right := Max(box.Left + Ceil(tw) + 1, ARect.Right);
    box.Bottom := box.Top + Ceil(th);
    APainter.DrawText(box, TyInkText(FLoadCfg.Text), fontName, fontSize, weight,
      ink, taLeftJustify, tlCenter, False, 0, False, Pos(#10, FLoadCfg.Text) > 0);
  end;

  { the spinner: PathProxy's arc, its angles normalised as a canvas takes
    them -- an end behind the start goes the long way round }
  if (not FLoadCfg.ShowSpinner) or (FLoadArc = nil) then Exit;
  case FLoadCfg.Color.Kind of
    likColour: ink := TTyColor(FLoadCfg.Color.Colour);
    likNone: ink := 0;
  else
    if tpBorderColor in spin.Present then ink := spin.BorderColor else ink := 0;
  end;
  r := FLoadGeo.R * s;
  if (TyAlphaOf(ink) = 0) or (FLoadCfg.LineWidth <= 0) or not (r > 0) then Exit;
  cx := ARect.Left + FLoadGeo.CX * s;
  cy := ARect.Top + FLoadGeo.CY * s;
  path := nil;
  TyZrArc(path, cx, cy, r, FLoadArc.Num('shape.startAngle'),
    FLoadArc.Num('shape.endAngle'), False);
  if Length(path) = 0 then Exit;
  a0 := path[0].V[4];
  sweep := path[0].V[5];
  if IsNan(a0) or IsNan(sweep) then Exit;
  APainter.SaveState;
  try
    APainter.SetLineDash([]);
    APainter.SetLineCap(tlcRound);
    APainter.BeginPath;
    APainter.ArcTo(cx, cy, r, a0, a0 + sweep, False);
    APainter.StrokePath(ink, FLoadCfg.LineWidth);
  finally
    APainter.RestoreState;
  end;
end;

{ ==================== appendData [Batch 119] ==================== }

function TTyAdvanceChart.AppendData(ASeriesIndex: Integer;
  const ADataJson: string): Boolean;
var
  d, node, arr: TJSONData;
  nLine, nCol, k: Integer;
begin
  Result := False;
  if (FOption = nil) or not (FOption.Root is TJSONObject) then Exit;
  { too deep is refused before fpjson can recurse into it }
  if TyJsonNestingExceeds(ADataJson, TyOptionMaxNesting, nLine, nCol) then Exit;
  node := FOption.ComponentAt('series', ASeriesIndex);
  if not (node is TJSONObject) then Exit;
  { THE SERIES' OWN ARRAY: upstream's provider pushes into it; a series
    reading a dataset is not taken (upstream would push into the table) }
  arr := TJSONObject(node).Find('data');
  if not (arr is TJSONArray) then Exit;
  try
    d := GetJSON(NulSafeJson(ADataJson));
    NulRestore(d);
  except
    d := nil;
  end;
  if not (d is TJSONArray) then
  begin
    d.Free;
    Exit;
  end;
  try
    { THE UPDATE BEFORE IT: upstream's setOption has laid the chart out by
      the time appendData can run }
    ConvertReady;
    if (FLastPPI > 0) and not FDirty and not FFrozenOn then FrozenCapture;
    for k := 0 to d.Count - 1 do
      TJSONArray(arr).Add(d.Items[k].Clone);
  finally
    d.Free;
  end;
  Result := True;
  if (FLastPPI <= 0) or FDirty then
  begin
    { nothing laid out yet: the first update takes every row }
    FDirty := True;
    Invalidate;
    Exit;
  end;
  { scheduler.unfinished = true; zr.wakeUp() }
  FStreamPending := True;
  AnimArmTimer;
end;

{ ==================== the timeline [Batch 129, C21] ====================

  SliderTimelineView's render and handlers, and the two actions. The
  option, the model and the view's elements are tyControls.AdvChart.Timeline;
  this is what upstream keeps outside them:
  - FTlView: the first timeline model's view, from render to render (its
    checkpoint element lives in it); a notMerge, or the model going, makes
    a new one -- upstream's view is disposed with its model;
  - FTlDue: the play timer _doPlayStop sets at every render (setTimeout
    with playInterval), NaN for none; TimelineTick fires it on the clock
    TimelineNow says, the machine's when that is NaN;
  - FTlAnim: the driver the checkpoint's slide, the progress line's and the
    hover transitions run on;
  - FTlDragging: zrender's Draggable holds the checkpoint;
  - FTlStatesDirty: a hover changed a hoverState -- the next frame applies
    it (applyChangedStates). }

function TlCss(AColour: TTyChartColor): string;
begin
  Result := 'rgba(' + IntToStr((AColour shr 16) and $FF) + ','
    + IntToStr((AColour shr 8) and $FF) + ',' + IntToStr(AColour and $FF) + ','
    + TyJsNumberToString(((AColour shr 24) and $FF) / 255) + ')';
end;

function TTyAdvanceChart.TlInk: TTyTimelineInk;
var
  model: TTyStyleModel;
  st: TTyStyleSet;
begin
  Result := Default(TTyTimelineInk);
  model := ActiveController.Model;
  st := model.ResolveStyle('TyAdvChartTimeline', '', []);
  Result.Line := TlCss(TTyChartColor(st.BorderColor));
  Result.EmptyFill := TlCss(TTyChartColor(st.Background.Color));
  Result.Border := Result.Line;
  st := model.ResolveStyle('TyAdvChartTimelineProgress', '', []);
  Result.Progress := TlCss(TTyChartColor(st.BorderColor));
  Result.ProgressItem := TlCss(TTyChartColor(st.Background.Color));
  st := model.ResolveStyle('TyAdvChartTimelineItem', '', []);
  Result.Item := TlCss(TTyChartColor(st.Background.Color));
  st := model.ResolveStyle('TyAdvChartTimelineItem', '', [tysHover]);
  Result.ItemEmphasis := TlCss(TTyChartColor(st.Background.Color));
  Result.ItemEmphasisBorder := TlCss(TTyChartColor(st.BorderColor));
  st := model.ResolveStyle('TyAdvChartTimelineCheckpoint', '', []);
  Result.Checkpoint := TlCss(TTyChartColor(st.Background.Color));
  Result.CheckpointBorder := TlCss(TTyChartColor(st.BorderColor));
  st := model.ResolveStyle('TyAdvChartTimelineControl', '', []);
  Result.Control := TlCss(TTyChartColor(st.Background.Color));
  Result.ControlBorder := TlCss(TTyChartColor(st.BorderColor));
  st := model.ResolveStyle('TyAdvChartTimelineControl', '', [tysHover]);
  Result.ControlEmphasis := TlCss(TTyChartColor(st.Background.Color));
  Result.ControlEmphasisBorder := TlCss(TTyChartColor(st.BorderColor));
  st := model.ResolveStyle('TyAdvChartTimelineLabel', '', []);
  Result.LabelColour := TlCss(TTyChartColor(st.TextColor));
  Result.FontFamily := st.FontName;
  Result.FontPx := TyFontPxOf(ResolveFontSize(st));
  if Result.FontPx <= 0 then Result.FontPx := 12;
  st := model.ResolveStyle('TyAdvChartTimelineLabel', '', [tysHover]);
  Result.LabelEmphasis := TlCss(TTyChartColor(st.TextColor));
end;

function TTyAdvanceChart.TlClock: Double;
begin
  if IsNan(FTlNow) then Result := TyAnimClockMs else Result := FTlNow;
end;

function TTyAdvanceChart.TlLive: Boolean;
begin
  Result := (FTlAnim <> nil) and (FTlAnim.ClipCount > 0);
end;

function TTyAdvanceChart.TlNode: TJSONObject;
var d: TJSONData;
begin
  Result := nil;
  if FOption = nil then Exit;
  { getComponent('timeline'): the first slot }
  d := FOption.ComponentAt('timeline', 0);
  if d is TJSONObject then Result := TJSONObject(d);
end;

{ getCurrentIndex: the model's option -- its default nought where nothing
  was written; NaN for what is no number }
function TTyAdvanceChart.TlCurrentIndex: Double;
var
  n: TJSONObject;
  d: TJSONData;
begin
  Result := NaN;
  n := TlNode;
  if n = nil then Exit;
  d := n.Find('currentIndex');
  if d = nil then Result := 0
  else if d.JSONType = jtNumber then Result := d.AsFloat;
end;

{ the component's state transition (updateStates): its animation enabled,
  stateAnimation's duration above nought }
function TTyAdvanceChart.TlAnimCfg: TTyTlAnimCfg;
var
  node, root, sa, rsa: TJSONObject;
  d: TJSONData;
  on: Boolean;
  dur, delay: Double;
  easing: string;

  function Get(const AKey: string): TJSONData;
  begin
    Result := nil;
    if sa <> nil then Result := sa.Find(AKey);
    if ((Result = nil) or (Result.JSONType = jtNull)) and (rsa <> nil) then
      Result := rsa.Find(AKey);
    if (Result <> nil) and (Result.JSONType = jtNull) then Result := nil;
  end;

begin
  Result := Default(TTyTlAnimCfg);
  Result.Driver := FTlAnim;
  Result.Allowed := AnimAllowed;
  node := TlNode;
  root := nil;
  if (FOption <> nil) and (FOption.Root is TJSONObject) then root := TJSONObject(FOption.Root);
  { isAnimationEnabled: the timeline's own `animation`, else the root's
    ('auto' when nothing is written) }
  on := Result.Allowed;
  d := nil;
  if node <> nil then d := node.Find('animation');
  if (d = nil) or (d.JSONType = jtNull) then
  begin
    if root <> nil then d := root.Find('animation') else d := nil;
    if (d <> nil) and not TyTlTruthy(d) then on := False;
  end
  else if not TyTlTruthy(d) then on := False;
  if not on then Exit;
  sa := nil;
  rsa := nil;
  if node <> nil then
  begin
    d := node.Find('stateAnimation');
    if d is TJSONObject then sa := TJSONObject(d);
  end;
  if root <> nil then
  begin
    d := root.Find('stateAnimation');
    if d is TJSONObject then rsa := TJSONObject(d);
  end;
  d := Get('duration');
  if d = nil then dur := 300
  else if d.JSONType = jtNumber then dur := d.AsFloat
  else dur := NaN;
  { duration > 0, a comparison NaN fails }
  if not (dur > 0) then Exit;
  d := Get('delay');
  if (d <> nil) and (d.JSONType = jtNumber) then delay := d.AsFloat else delay := 0;
  d := Get('easing');
  if (d <> nil) and (d.JSONType = jtString) then easing := d.AsString
  else if d = nil then easing := 'cubicOut'
  else easing := '';
  Result.HasStateCfg := True;
  Result.StateCfg := TyAnimCfg(dur, delay, easing);
end;

procedure TTyAdvanceChart.SolveTimeline(APPI: Integer);
var
  node, root: TJSONObject;
  s, w, h, interval: Double;
  meas: ITyTextMeasurer;
begin
  node := TlNode;
  if node = nil then
  begin
    { the model went: its view too -- remove() and dispose() clear the timer }
    FreeAndNil(FTlView);
    FTlDue := NaN;
    FTlDragging := False;
    TlArmTimer;
    Exit;
  end;
  if FTlAnim = nil then FTlAnim := TTyAnimation.Create;
  if FTlView = nil then
  begin
    Inc(FTlUidSeq);
    FTlView := TTyTimelineView.Create('ec_tl_' + IntToStr(FTlUidSeq));
    FTlView.Dragging := FTlDragging;
  end;
  if APPI <= 0 then APPI := 96;
  s := APPI / 96;
  w := (FLastRect.Right - FLastRect.Left) / s;
  h := (FLastRect.Bottom - FLastRect.Top) / s;
  root := nil;
  if FOption.Root is TJSONObject then root := TJSONObject(FOption.Root);
  { the layout measures in css px }
  meas := NewTextMeasurer(96);
  { getViewRect in createBoxLayoutReference's container [Batch 154]; a cell
    of no size far off the canvas (upstream's not-a-number view rect draws
    nothing, and an axis of no length is no number to compare here) }
  FTlView.HasRef := ComponentRefCss('timeline', 0, FTlView.Ref);
  if FTlView.HasRef and not TyXYWHHasSize(FTlView.Ref) then
    FTlView.Ref := TyXYWH(TyBoxNowhere, TyBoxNowhere, TyBoxNowhereSize, TyBoxNowhereSize);
  FTlView.Render(node, root, w, h, TlInk, meas, TlAnimCfg,
    FOption.GetBool('useUTC', False));
  { _doPlayStop: the timer cleared, and set again while playing --
    setTimeout(fn, playInterval) from now }
  FTlDue := NaN;
  if FTlView.PlayState then
  begin
    interval := FTlView.PlayInterval;
    if IsNan(interval) then interval := 0;
    FTlDue := TlClock + interval;
  end;
  TlArmTimer;
  FTlStatesDirty := False;
  { the flush: what the render started takes its start now }
  FTlAnim.Update(AnimClock, True);
  AnimArmTimer;
end;

function TTyAdvanceChart.BuildTimeline(AList: TTyPaintList): Integer;
var
  i: Integer;
  ctx: TTyGfxPaintCtx;
  pe: TTyChartElement;
  meas: ITyTextMeasurer;
  el: TTyGfxEl;
begin
  Result := 0;
  if (FTlView = nil) or not FTlView.Shown then Exit;
  FTlView.UpdateTransforms;
  meas := NewTextMeasurer(96);
  ctx := Default(TTyGfxPaintCtx);
  if FLastPPI > 0 then ctx.Scale := FLastPPI / 96 else ctx.Scale := 1;
  ctx.HasInk := False;
  for i := 0 to High(FTlView.Els) do
  begin
    el := FTlView.Els[i];
    if el.Ignore then Continue;
    if not FTlView.Drawable(i, meas) then Continue;
    if not TyGfxPaintElement(el, meas, ctx, pe) then Continue;
    { the pointer is the timeline's own: nothing in the paint list answers
      for it }
    pe.Silent := True;
    pe.Datum := TyChartDatum(-1, -1);
    pe.Z := Round(el.ZLevel) * 100000 + Round(el.Z);
    pe.Z2 := Round(el.Z2);
    AList.Add(pe);
    Inc(Result);
  end;
end;

function TTyAdvanceChart.TlHitAt(AX, AY: Integer; out AEl: Integer): Boolean;
var
  s, x, y: Double;
begin
  Result := False;
  AEl := -1;
  if (FTlView = nil) or not FTlView.Shown or (csDesigning in ComponentState) then Exit;
  if FLastPPI > 0 then s := FLastPPI / 96 else s := 1;
  x := AX / s;
  y := AY / s;
  { zrender's Handler hit-tests nothing outside the canvas }
  if (x < 0) or (y < 0) or (x > (FLastRect.Right - FLastRect.Left) / s)
    or (y > (FLastRect.Bottom - FLastRect.Top) / s) then Exit;
  AEl := FTlView.HitAt(x, y, NewTextMeasurer(96));
  Result := AEl >= 0;
end;

procedure TTyAdvanceChart.TlArmTimer;
var ms: Double;
begin
  if IsNan(FTlNow) and not IsNan(FTlDue) and not (csDesigning in ComponentState) then
  begin
    if FTlTimer = nil then
    begin
      FTlTimer := TTimer.Create(nil);
      FTlTimer.Enabled := False;
      FTlTimer.OnTimer := @TlTimerFired;
    end;
    ms := FTlDue - TyAnimClockMs;
    if ms < 1 then ms := 1;
    if ms > MaxInt then ms := MaxInt;
    FTlTimer.Enabled := False;
    FTlTimer.Interval := Ceil(ms);
    FTlTimer.Enabled := True;
  end
  else if FTlTimer <> nil then
    FTlTimer.Enabled := False;
end;

procedure TTyAdvanceChart.TlTimerFired(Sender: TObject);
begin
  if FTlTimer <> nil then FTlTimer.Enabled := False;
  TimelineTick(TlClock);
end;

procedure TTyAdvanceChart.TimelineTick(ANowMs: Double);
var
  t, cur: Double;
  node: TJSONObject;
begin
  while (not IsNan(FTlDue)) and (FTlDue <= ANowMs) do
  begin
    t := FTlDue;
    FTlDue := NaN;
    { the clock is the timer's due while it runs }
    if not IsNan(FTlNow) then FTlNow := t;
    node := TlNode;
    if node = nil then Break;
    { _changeTimeline(current +/- 1), the model read now }
    cur := TlCurrentIndex;
    if TyTlTruthy(node.Find('rewind')) then TlChange(cur - 1, True)
    else TlChange(cur + 1, True);
  end;
  TlArmTimer;
end;

{ _changeTimeline: the timelineChange action from the view }
procedure TTyAdvanceChart.TlChange(AIndex: Double; AHasIndex: Boolean);
var p: string;
begin
  if FTlView = nil then Exit;
  p := '{"type":"timelineChange"';
  if AHasIndex and not (IsNan(AIndex) or IsInfinite(AIndex)) then
    p := p + ',"currentIndex":' + TyJsNumberToString(AIndex);
  p := p + ',"from":"' + FTlView.Uid + '"}';
  DispatchAction(p);
end;

procedure TTyAdvanceChart.TlClick(AEl: Integer);
var
  r: TTyTlRole;
  cur: Double;
begin
  if (FTlView = nil) or (AEl < 0) or (AEl > High(FTlView.Els)) then Exit;
  r := FTlView.RoleOf(AEl);
  cur := TlCurrentIndex;
  case r.Kind of
    tlrTick, tlrLabel: TlChange(r.Value, True);
    tlrNext: if FTlView.Inverse then TlChange(cur - 1, True) else TlChange(cur + 1, True);
    tlrPrev: if FTlView.Inverse then TlChange(cur + 1, True) else TlChange(cur - 1, True);
    tlrPlay, tlrStop:
      begin
        { _handlePlayClick(!playState): the timer cleared first }
        FTlDue := NaN;
        TlArmTimer;
        if r.Kind = tlrPlay then
          DispatchAction('{"type":"timelinePlayChange","playState":true,"from":"' + FTlView.Uid + '"}')
        else
          DispatchAction('{"type":"timelinePlayChange","playState":false,"from":"' + FTlView.Uid + '"}');
      end;
  end;
end;

procedure TTyAdvanceChart.TlMouseOver(const ATarget: TTyChartEventTarget);
begin
  if (ATarget.HdKind <> 10) or (FTlView = nil) or (ATarget.HdGen <> FTlView.Gen) then Exit;
  if not FTlView.IsDispatcher(ATarget.HdRow) then Exit;
  { singleEnterEmphasis: the flag; the frame applies it }
  FTlView.Hover[ATarget.HdRow] := True;
  FTlStatesDirty := True;
end;

procedure TTyAdvanceChart.TlMouseOut(const ATarget: TTyChartEventTarget);
begin
  if (ATarget.HdKind <> 10) or (FTlView = nil) or (ATarget.HdGen <> FTlView.Gen) then Exit;
  if not FTlView.IsDispatcher(ATarget.HdRow) then Exit;
  if not FTlView.Hover[ATarget.HdRow] then Exit;
  FTlView.Hover[ATarget.HdRow] := False;
  FTlStatesDirty := True;
end;

procedure TTyAdvanceChart.TlApplyStates;
var i: Integer;
begin
  if not FTlStatesDirty then Exit;
  FTlStatesDirty := False;
  if FTlView = nil then Exit;
  for i := 0 to High(FTlView.Els) do FTlView.ApplyStates(i);
  DropStatic;
  InvalidateFrame;
  AnimArmTimer;
end;

procedure TTyAdvanceChart.TlDragStart(const ATarget: TTyChartEventTarget);
begin
  if (ATarget.HdKind <> 10) or (FTlView = nil) or (ATarget.HdGen <> FTlView.Gen) then Exit;
  if (ATarget.HdRow < 0) or (ATarget.HdRow > High(FTlView.Els)) then Exit;
  if FTlView.RoleOf(ATarget.HdRow).Kind <> tlrPointer then Exit;
  FTlDragging := True;
  FTlView.Dragging := True;
end;

{ _pointerChangeTimeline }
procedure TTyAdvanceChart.TlPointerChange(AX, AY: Integer; ATrigger: Boolean);
var
  s, coord: Double;
  target: Integer;
begin
  if (FTlView = nil) or not FTlView.Shown then Exit;
  if FLastPPI > 0 then s := FLastPPI / 96 else s := 1;
  coord := FTlView.DragTo(AX / s, AY / s);
  target := FTlView.NearestTick(coord);
  DropStatic;
  InvalidateFrame;
  if ATrigger or ((target <> TlCurrentIndex) and FTlView.Realtime) then
    TlChange(target, target >= 0);
end;

procedure TTyAdvanceChart.TlDragMove(AX, AY: Integer);
begin
  if not FTlDragging then Exit;
  { _handlePointerDrag: the timer cleared, the checkpoint moved }
  FTlDue := NaN;
  TlArmTimer;
  TlPointerChange(AX, AY, False);
end;

procedure TTyAdvanceChart.TlDragEnd(AX, AY: Integer);
begin
  if not FTlDragging then Exit;
  FTlDragging := False;
  if FTlView <> nil then FTlView.Dragging := False;
  { _handlePointerDragend: a change whatever the index }
  TlPointerChange(AX, AY, True);
end;

{ resetOption('timeline') with the timeline's replaceMerge, and the update
  after it }
procedure TTyAdvanceChart.TlMerge;
var
  node: TJSONObject;
  d: TJSONData;
  rep: array of string;
  k: Integer;

  procedure AddType(A: TJSONData);
  begin
    if (A = nil) or (A.JSONType <> jtString) then Exit;
    if not TyOptionIsComponentType(A.AsString) then Exit;
    SetLength(rep, Length(rep) + 1);
    rep[High(rep)] := A.AsString;
  end;

begin
  rep := nil;
  node := TlNode;
  if node <> nil then
  begin
    d := node.Find('replaceMerge');
    if d is TJSONArray then
    begin
      for k := 0 to d.Count - 1 do AddType(d.Items[k]);
    end
    else
      AddType(d);
  end;
  FMergeOldKeys := AnimViewKeys;
  FMergeOldUtKeys := AnimUtKeys;
  FMergeOldAxes := AxisViewKeys;
  FMergeFirst := True;
  FMergeResize := False;
  MediaViewSize;
  { prepareAndUpdate: an update whose models were merged -- armed as a
    merge's when a frame was merged; without one the same models render
    again, every series updating from where it stands }
  if FOption.TimelineReset(rep, @MergeBefore, @MergePass) then
  begin
    FAnimPending := True;
    FDirty := True;
    Invalidate;
    { and rendered now, inside the dispatch, as prepareAndUpdate does: the
      brushSelect its visual stage dispatches goes with the action
      [milestone D5-D8: the render waited for the next frame] }
    ConvertReady;
  end
  else
    FullUpdate;
end;

procedure TTyAdvanceChart.DoTimelineChange(APayload: TJSONObject);
var
  node, full, ev: TJSONObject;
  d: TJSONData;
  idx: Double;
  values: TTyDoubleArray;
  names: TTyStringArray;
  items: TTyJsonObjArray;
  stop: Boolean;
  k: Integer;
  pp: string;
begin
  node := TlNode;
  { upstream reads the model's replaceMerge whatever there is: without a
    timeline it throws, and nothing happens here }
  if node = nil then Exit;
  stop := False;
  d := APayload.Find('currentIndex');
  if (d <> nil) and (d.JSONType <> jtNull) then
  begin
    full := TyTimelineFullOption(node, TlInk);
    try
      TyTimelineData(full, FOption.GetBool('useUTC', False), values, names, items);
      { setCurrentIndex: `this.option.loop` }
      idx := TyTimelineNormIndex(TyTlJsNum(d), Length(values), TyTlTruthy(full.Find('loop')));
      TyTlPut(node, 'currentIndex', TyTlNumJson(idx));
      { played to the end without a loop: the play stops, and says so }
      if (not TyTlTruthy(full.Find('loop'))) and (idx >= Length(values) - 1)
        and TyTlTruthy(full.Find('autoPlay')) then
      begin
        TyTlPut(node, 'autoPlay', TJSONBoolean.Create(False));
        stop := True;
        pp := '{"type":"timelinePlayChange","playState":false';
        d := APayload.Find('from');
        if d <> nil then pp := pp + ',"from":' + d.AsJSON;
        pp := pp + '}';
        DispatchActionObject(TJSONObject(GetJSON(pp)));
      end;
    finally
      full.Free;
    end;
  end;
  TlMerge;
  { the event: defaults(the model's currentIndex, payload) }
  ev := TJSONObject.Create;
  try
    d := node.Find('currentIndex');
    if d <> nil then ev.Add('currentIndex', d.Clone)
    else ev.Add('currentIndex', TJSONIntegerNumber.Create(0));
    for k := 0 to APayload.Count - 1 do
    begin
      if ev.IndexOfName(APayload.Names[k]) >= 0 then
      begin
        if ev.Find(APayload.Names[k]).JSONType <> jtNull then Continue;
        ev.Delete(APayload.Names[k]);
      end;
      ev.Add(APayload.Names[k], APayload.Items[k].Clone);
    end;
    ev.Elements['type'] := TJSONString.Create('timelinechanged');
    EmitPayloadEvent('timelinechanged', ev.AsJSON);
  finally
    ev.Free;
  end;
  { the action the end dispatched waits for this one -- and this one's
    render came first (TlMerge renders inside the dispatch): the checkpoint
    the second render meets is already sliding, and its
    stopAnimation(forward) puts it at its tick [milestone D5-D8: a merged
    frame waited for the next frame, so the timeline was rendered here]
    [F4b: it is dispatched where the action decides it (api.dispatchAction
    while IN_EC_CYCLE) and waits in the one queue -- after this action's
    update and event, before the brushSelect the update dispatched.] }
end;

procedure TTyAdvanceChart.DoTimelinePlayChange(APayload: TJSONObject);
var
  node, ev: TJSONObject;
  d: TJSONData;
begin
  node := TlNode;
  d := APayload.Find('playState');
  if (node <> nil) and (d <> nil) and (d.JSONType <> jtNull) then
    TyTlPut(node, 'autoPlay', TJSONBoolean.Create(TyTlTruthy(d)));
  { update: every view renders again now (the timer with them), the series
    updating from where they stand }
  FullUpdate;
  ev := TJSONObject(APayload.Clone);
  try
    ev.Elements['type'] := TJSONString.Create('timelineplaychanged');
    EmitPayloadEvent('timelineplaychanged', ev.AsJSON);
  finally
    ev.Free;
  end;
end;

function TTyAdvanceChart.TimelineView: TTyTimelineView;
begin
  Result := FTlView;
end;

function TTyAdvanceChart.TimelineDue: Double;
begin
  Result := FTlDue;
end;

{ ==================== the toolbox [Batch 125, C16] ====================

  ToolboxView's render, its icons' handlers and the features' clicks. The
  model, the layout and the texts are tyControls.AdvChart.Toolbox; this is
  the state upstream keeps between renders, and where it keeps it:
  - FTbPrev: where each toolbox's group stood -- positionElement starts
    from it, so a re-render's arithmetic is not a first render's;
  - FTbStatus: the features' iconStatus ('<toolbox>|<feature>|<icon>'),
    written into the toolbox's option upstream: a notMerge or a restore
    drops it, a merge keeps it;
  - FTbMagicTitle: magicType's titles a stack click flipped (written into
    the feature's option upstream, so the same);
  - FTbLive: each icon element's hover -- the emphasis the hover entered,
    the title shown, and whether entering applied the emphasis state's
    adjusted text. A render makes new elements, so none of it survives one,
    and an element under a still pointer is found again without a
    mouseover (zrender's Handler looks for a removed hover target where it
    was, and finds the new one: no over, no title);
  - FTbZoomActive: the dataZoom feature's _isZoomActive -- the feature
    object outlives a notMerge and a restore;
  - FTbHistory: dataZoom/history's snapshots, the GlobalModel's: a notMerge
    makes a new model, a restore keeps it (the restore BUTTON clears it
    first);
  - FTbSel: setRawRange on the select dataZooms, by axis key;
  - FTbBackup: the option a restore recreates, OptionManager's
    _optionBackup -- the last notMerge's. }

function TTyAdvanceChart.TbTitles: TTyTbTitles;
begin
  Result := Default(TTyTbTitles);
  Result.SaveAsImage := rsTyChartToolboxSaveAsImage;
  Result.Restore := rsTyChartToolboxRestore;
  Result.DataView := rsTyChartToolboxDataView;
  Result.Zoom := rsTyChartToolboxZoom;
  Result.Back := rsTyChartToolboxZoomBack;
  Result.Line := rsTyChartToolboxLine;
  Result.Bar := rsTyChartToolboxBar;
  Result.Stack := rsTyChartToolboxStack;
  Result.Tiled := rsTyChartToolboxTiled;
  Result.DataViewClose := rsMsgBtnClose;
  Result.DataViewRefresh := rsTyChartToolboxDataViewRefresh;
  { the brush feature's [Batch 127] }
  Result.BrushRect := rsTyChartToolboxBrushRect;
  Result.BrushPolygon := rsTyChartToolboxBrushPolygon;
  Result.BrushLineX := rsTyChartToolboxBrushLineX;
  Result.BrushLineY := rsTyChartToolboxBrushLineY;
  Result.BrushKeep := rsTyChartToolboxBrushKeep;
  Result.BrushClear := rsTyChartToolboxBrushClear;
end;

function TTyAdvanceChart.TbScale: Double;
begin
  if FLastPPI > 0 then Result := FLastPPI / 96 else Result := 1;
end;

function TTyAdvanceChart.TbInk: TTyTbInk;
var
  model: TTyStyleModel;
  st: TTyStyleSet;
begin
  model := ActiveController.Model;
  st := model.ResolveStyle('TyAdvChartToolbox', '', []);
  Result.Stroke := TTyChartColor(st.BorderColor);
  Result.FontName := st.FontName;
  Result.FontSizeLogical := ResolveFontSize(st);
  Result.FontWeight := st.FontWeight;
  Result.Title := TTyChartColor(st.TextColor);
  GlobalInk(Result.FontName, Result.FontSizeLogical, Result.FontWeight,
    Result.Title, [ttpSize, ttpWeight, ttpFamily]);
  Result.StrokeHover := TTyChartColor(
    model.ResolveStyle('TyAdvChartToolbox', '', [tysHover]).BorderColor);
  Result.Background := TTyChartColor(
    model.ResolveStyle('TyAdvChartToolboxBackground', '', []).Background.Color);
  Result.Border := TTyChartColor(
    model.ResolveStyle('TyAdvChartToolboxBorder', '', []).BorderColor);
  Result.Brush := TTyChartColor(
    model.ResolveStyle('TyAdvChartToolboxBrush', '', []).Background.Color);
end;

{ a written colour, the skin's where nothing was written; False: `none` }
function TbColour(const C: TTyTbColour; AFallback: TTyChartColor;
  out AColour: TTyChartColor): Boolean;
begin
  AColour := AFallback;
  case C.Kind of
    tbcNone: Exit(False);
    tbcText:
      if not TyTryParseChartColor(C.Text, AColour) then AColour := AFallback;
  end;
  Result := True;
end;

function TTyAdvanceChart.TbStatusOf(ATb: Integer): TStringList;
var
  i: Integer;
  pre, k: string;
begin
  Result := TStringList.Create;
  pre := IntToStr(ATb) + '|';
  for i := 0 to FTbStatus.Count - 1 do
  begin
    k := FTbStatus.Names[i];
    if Copy(k, 1, Length(pre)) = pre then
      Result.Values[Copy(k, Length(pre) + 1, MaxInt)] := FTbStatus.ValueFromIndex[i];
  end;
end;

procedure TTyAdvanceChart.TbSetStatus(ATb: Integer; const AFeature, AIcon,
  AState: string);
begin
  FTbStatus.Values[IntToStr(ATb) + '|' + AFeature + '|' + AIcon] := AState;
end;

function TTyAdvanceChart.TbStatusIs(ATb: Integer; const AFeature,
  AIcon: string): Boolean;
begin
  Result := FTbStatus.Values[IntToStr(ATb) + '|' + AFeature + '|' + AIcon] = 'emphasis';
end;

{ the feature exists and shows: its object lives }
function TTyAdvanceChart.TbHasFeature(ATb: Integer; const AName: string): Boolean;
var d: TJSONData;
begin
  Result := False;
  d := FOption.ComponentAt('toolbox', ATb);
  if not (d is TJSONObject) then Exit;
  d := TJSONObject(d).Find('feature');
  if not (d is TJSONObject) then Exit;
  d := TJSONObject(d).Find(AName);
  if (d = nil) or (d.JSONType = jtNull) then Exit;
  Result := True;
  if d is TJSONObject then
  begin
    d := TJSONObject(d).Find('show');
    if (d <> nil) and (d.JSONType = jtBoolean) and not d.AsBoolean then Result := False;
  end;
end;

procedure TTyAdvanceChart.SolveToolboxes(const AMeasurer: ITyTextMeasurer;
  APPI: Integer);
var
  n, t, i: Integer;
  st: TStringList;
  s, w, h, tw, th: Double;
  ws, hs: TTyDoubleArray;
  ink: TTyTbInk;
  dzOn: Boolean;
  ref: TTyXYWH;
begin
  n := TyToolboxCount(FOption);
  { a toolbox that went takes its view (and where it stood) with it }
  i := Length(FTbPrev);
  SetLength(FTbPrev, n);
  for t := i to n - 1 do FTbPrev[t] := TyPointF(0, 0);
  SetLength(FTbSpecs, n);
  SetLength(FTbLayouts, n);
  i := Length(FTbMagicTitle);
  SetLength(FTbMagicTitle, n);
  for t := i to n - 1 do FTbMagicTitle[t] := '';
  SetLength(FTbLive, n);
  { NEW ELEMENTS: whatever was hovered is found again, not entered }
  Inc(FTbGen);
  s := TbScale;
  w := (FLastRect.Right - FLastRect.Left) / s;
  h := (FLastRect.Bottom - FLastRect.Top) / s;
  ink := TbInk;
  dzOn := False;
  for t := 0 to n - 1 do
  begin
    { the dataZoom feature's buttons, at every render: zoom by the active
      flag, back by the history }
    if TbHasFeature(t, 'dataZoom') then
    begin
      if t = 0 then dzOn := True;
      if FTbZoomActive then TbSetStatus(t, 'dataZoom', 'zoom', 'emphasis')
      else TbSetStatus(t, 'dataZoom', 'zoom', 'normal');
      if TyTbHistoryCount(FTbHistory) > 1 then TbSetStatus(t, 'dataZoom', 'back', 'emphasis')
      else TbSetStatus(t, 'dataZoom', 'back', 'normal');
    end;
    { the brush feature's buttons, at every render [Batch 127] }
    if TbHasFeature(t, 'brush') then TbBrushRender(t);
    st := TbStatusOf(t);
    try
      FTbSpecs[t] := TyToolboxSpecOf(FOption, t, TbTitles, st, FTbMagicTitle[t]);
    finally
      st.Free;
    end;
    { the titles in the default font -- 12 px, whatever the title's own is }
    SetLength(ws, Length(FTbSpecs[t].Icons));
    SetLength(hs, Length(FTbSpecs[t].Icons));
    for i := 0 to High(FTbSpecs[t].Icons) do
    begin
      ws[i] := 0;
      hs[i] := 0;
      if FTbSpecs[t].Icons[i].HasTitle and (FTbSpecs[t].Icons[i].Title <> '')
        and (AMeasurer <> nil) then
      begin
        AMeasurer.MeasureLine(FTbSpecs[t].Icons[i].Title, ink.FontName,
          Round(12 * APPI / 96), 400, tw, th);
        ws[i] := tw / s;
        hs[i] := th / s;
      end;
    end;
    { getLayoutRect and positionElement in createBoxLayoutReference's
      container: a cell or a day for one in a host [Batch 154] }
    ComponentRefCss('toolbox', t, ref);
    FTbLayouts[t] := TyToolboxLayoutOf(FTbSpecs[t], w, h, ref, FTbPrev[t].X,
      FTbPrev[t].Y, ws, hs);
    if FTbLayouts[t].Valid then
      FTbPrev[t] := TyPointF(FTbLayouts[t].GroupX, FTbLayouts[t].GroupY);
    FTbLive[t] := nil;
    SetLength(FTbLive[t], Length(FTbSpecs[t].Icons));
    { the status's emphasis is applied when the update ends -- after the
      adjustment wrote the state: the text's adjusted align comes with it }
    for i := 0 to High(FTbSpecs[t].Icons) do
      FTbLive[t][i].AdjAlign := FTbSpecs[t].Icons[i].Status;
  end;
  { a dataZoom feature that went takes its active flag with it }
  if not dzOn then FTbZoomActive := False;
  { the statuses an update took at its dispatch are spent [Batch 127] }
  FTbBfSnap := False;
  { updateZoomBtnStatus: the select brush's panels, on or off [Batch 127] }
  TbZoomCtlSync;
end;

{ zrender's composition of the group's move and the icon's: a move inside
  the epsilon is no transform at all }
function TbNotAroundZero(V: Double): Boolean;
begin
  Result := (V > 5e-5) or (V < -5e-5);
end;

procedure TTyAdvanceChart.TbIconOrigin(ATb, AIcon: Integer; out AX, AY: Double);
var gx, gy, x, y: Double;
begin
  gx := FTbLayouts[ATb].GroupX;
  gy := FTbLayouts[ATb].GroupY;
  x := FTbSpecs[ATb].Icons[AIcon].X;
  y := FTbSpecs[ATb].Icons[AIcon].Y;
  if TbNotAroundZero(x) or TbNotAroundZero(y) then
  begin
    if TbNotAroundZero(gx) or TbNotAroundZero(gy) then
    begin
      AX := x + gx;
      AY := y + gy;
    end
    else
    begin
      AX := x;
      AY := y;
    end;
  end
  else if TbNotAroundZero(gx) or TbNotAroundZero(gy) then
  begin
    AX := gx;
    AY := gy;
  end
  else
  begin
    AX := 0;
    AY := 0;
  end;
end;

function TTyAdvanceChart.TbEmphasised(ATb, AIcon: Integer): Boolean;
begin
  Result := FTbSpecs[ATb].Icons[AIcon].Status;
  if (ATb <= High(FTbLive)) and (AIcon <= High(FTbLive[ATb])) then
    Result := Result or FTbLive[ATb][AIcon].HoverEmph;
end;

function TTyAdvanceChart.BuildToolboxes(AList: TTyPaintList;
  const AMeasurer: ITyTextMeasurer): Integer;
var
  t, i: Integer;
  ink: TTyTbInk;
  s, ox, oy, tw, th, l, tp: Double;
  el: TTyChartElement;
  c: TTyChartColor;
  sty: TTyTbItemStyle;
  emph: Boolean;
  r: TTyXYWH;
  place: TTyTbTitlePlace;
  rad: array of Double;
  fs: Integer;
  pr: TTyRectF;

  function Blank: TTyChartElement;
  begin
    Result := Default(TTyChartElement);
    Result.Silent := True;
    Result.Datum := TyChartDatum(-1, -1);
    Result.Z := FTbSpecs[t].Z;
    Result.Style.Alpha := 1;
  end;

begin
  Result := 0;
  ink := TbInk;
  s := TbScale;
  for t := 0 to High(FTbLayouts) do
  begin
    if (t > High(FTbSpecs)) or not FTbLayouts[t].Valid then Continue;
    { a group a degenerate icon placed at NaN draws nothing at all }
    if IsNan(FTbLayouts[t].GroupX) or IsNan(FTbLayouts[t].GroupY) then Continue;
    { the background, under the icons }
    r := FTbLayouts[t].Background;
    el := Blank;
    el.Z2 := -1;
    if IsNan(r.X) or IsNan(r.Y) or IsNan(r.W) or IsNan(r.H) then r := Default(TTyXYWH);
    pr := TyRectF(FLastRect.Left + s * (FTbLayouts[t].GroupX + r.X),
      FLastRect.Top + s * (FTbLayouts[t].GroupY + r.Y),
      FLastRect.Left + s * (FTbLayouts[t].GroupX + r.X + r.W),
      FLastRect.Top + s * (FTbLayouts[t].GroupY + r.Y + r.H));
    SetLength(rad, Length(FTbSpecs[t].Radius));
    for i := 0 to High(rad) do rad[i] := FTbSpecs[t].Radius[i] * s;
    if Length(rad) > 0 then el.Shape := TyShapeRoundRect(pr, rad)
    else el.Shape := TyShapeRect(pr);
    if TbColour(FTbSpecs[t].Background, ink.Background, c) and ((c shr 24) <> 0) then
    begin
      el.Style.HasFill := True;
      el.Style.FillColor := c;
    end;
    if (FTbSpecs[t].BorderWidth > 0) and TbColour(FTbSpecs[t].BorderColor, ink.Border, c) then
    begin
      el.Style.StrokeColor := c;
      el.Style.StrokeWidthLogical := FTbSpecs[t].BorderWidth;
    end;
    if el.Style.HasFill or (el.Style.StrokeWidthLogical > 0) then
    begin
      AList.Add(el);
      Inc(Result);
    end;
    { the icons }
    for i := 0 to High(FTbSpecs[t].Icons) do
    begin
      { an image icon is laid out and answers the pointer; it draws nothing --
        nor does a degenerate path, NaN through and through }
      if FTbSpecs[t].Icons[i].IsImage then Continue;
      if IsNan(FTbSpecs[t].Icons[i].PathRect.X) or IsNan(FTbSpecs[t].Icons[i].PathRect.Y)
        or IsNan(FTbSpecs[t].Icons[i].PathRect.W) or IsNan(FTbSpecs[t].Icons[i].PathRect.H) then
        Continue;
      emph := TbEmphasised(t, i);
      sty := TyTbStyleOf(FTbSpecs[t].Icons[i], emph);
      TbIconOrigin(t, i, ox, oy);
      if IsNan(ox) or IsNan(oy) then Continue;
      el := Blank;
      el.Shape := TyMkZrShape(FTbSpecs[t].Icons[i].Path, TyZrLocal(s, s, 0,
        FLastRect.Left + s * ox, FLastRect.Top + s * oy), True);
      if emph then c := ink.StrokeHover else c := ink.Stroke;
      if TbColour(sty.Stroke, c, c) and (sty.LineWidth > 0) then
      begin
        el.Style.StrokeColor := c;
        el.Style.StrokeWidthLogical := sty.LineWidth;
      end;
      if sty.HasFill and TbColour(sty.Fill, 0, c) and (sty.Fill.Kind = tbcText) then
      begin
        el.Style.HasFill := True;
        el.Style.FillColor := c;
      end;
      if sty.HasOpacity and not IsNan(sty.Opacity) then
        el.Style.Alpha := Max(0, Min(1, sty.Opacity));
      AList.Add(el);
      Inc(Result);
    end;
    { the titles under the pointer }
    for i := 0 to High(FTbSpecs[t].Icons) do
    begin
      if (t > High(FTbLive)) or (i > High(FTbLive[t])) or not FTbLive[t][i].TextShown then Continue;
      if not FTbSpecs[t].Icons[i].HasTitle or (FTbSpecs[t].Icons[i].Title = '') then Continue;
      emph := TbEmphasised(t, i);
      place := TyToolboxTitlePlace(FTbSpecs[t], FTbLayouts[t], i,
        FTbLive[t][i].AdjPos, FTbLive[t][i].AdjAlign, emph);
      if IsNan(place.X) or IsNan(place.Y) then Continue;
      el := Blank;
      el.Z2 := 1;
      fs := ink.FontSizeLogical;
      if FTbSpecs[t].Icons[i].TextFontSize > 0 then fs := Round(FTbSpecs[t].Icons[i].TextFontSize);
      tw := 0;
      th := 0;
      if AMeasurer <> nil then
        AMeasurer.MeasureLine(FTbSpecs[t].Icons[i].Title, ink.FontName,
          Round(fs * s), ink.FontWeight, tw, th);
      el.Caption.Text := FTbSpecs[t].Icons[i].Title;
      el.Caption.FontName := ink.FontName;
      el.Caption.FontSizeLogical := fs;
      el.Caption.FontWeight := ink.FontWeight;
      { textFill, else the emphasis fill, else its stroke }
      sty := TyTbStyleOf(FTbSpecs[t].Icons[i], True);
      if FTbSpecs[t].Icons[i].TextFill.Kind = tbcText then
        TbColour(FTbSpecs[t].Icons[i].TextFill, ink.StrokeHover, c)
      else if FTbSpecs[t].Icons[i].Emph.HasFill
        and (FTbSpecs[t].Icons[i].Emph.Fill.Kind = tbcText) then
        TbColour(FTbSpecs[t].Icons[i].Emph.Fill, ink.StrokeHover, c)
      else
        TbColour(sty.Stroke, ink.StrokeHover, c);
      el.Caption.Colour := c;
      el.Caption.X := FLastRect.Left + s * place.X;
      el.Caption.Y := FLastRect.Top + s * place.Y;
      if place.Align = 'center' then el.Caption.AnchorH := tahCentre
      else if place.Align = 'right' then el.Caption.AnchorH := tahRight
      else el.Caption.AnchorH := tahLeft;
      if place.VAlign = 'middle' then el.Caption.AnchorV := tavMiddle
      else if place.VAlign = 'bottom' then el.Caption.AnchorV := tavBottom
      else el.Caption.AnchorV := tavTop;
      case el.Caption.AnchorH of
        tahCentre: l := el.Caption.X - tw / 2;
        tahRight: l := el.Caption.X - tw;
      else
        l := el.Caption.X;
      end;
      case el.Caption.AnchorV of
        tavMiddle: tp := el.Caption.Y - th / 2;
        tavBottom: tp := el.Caption.Y - th;
      else
        tp := el.Caption.Y;
      end;
      el.Shape := TyShapeRect(TyRectF(l, tp, l + tw, tp + th));
      AList.Add(el);
      Inc(Result);
    end;
  end;
  { the brush's cover while it is drawn (the controller's) [Batch 127] }
  if (FTbBrushCtl <> nil) and (Length(FTbBrushCtl.Covers) > 0) then
  begin
    el := Default(TTyChartElement);
    el.Silent := True;
    el.Datum := TyChartDatum(-1, -1);
    el.Z := 10000;
    el.Style.Alpha := 1;
    r := FTbBrushCtl.Covers[0].Main;
    el.Shape := TyShapeRect(TyRectF(FBuild.Viewport.Left + s * r.X,
      FBuild.Viewport.Top + s * r.Y, FBuild.Viewport.Left + s * (r.X + r.W),
      FBuild.Viewport.Top + s * (r.Y + r.H)));
    el.Style.HasFill := True;
    el.Style.FillColor := ink.Brush;
    AList.Add(el);
    Inc(Result);
  end;
end;

function TTyAdvanceChart.TbHitAt(AX, AY: Integer; out ATb, AIcon: Integer): Boolean;
var
  t, i: Integer;
  s, x, y, ox, oy: Double;
  r: TTyXYWH;
begin
  Result := False;
  ATb := -1;
  AIcon := -1;
  if csDesigning in ComponentState then Exit;
  s := TbScale;
  x := (AX - FLastRect.Left) / s;
  y := (AY - FLastRect.Top) / s;
  { zrender's Handler hit-tests nothing outside the canvas }
  if (x < 0) or (y < 0) or (x > (FLastRect.Right - FLastRect.Left) / s)
    or (y > (FLastRect.Bottom - FLastRect.Top) / s) then Exit;
  for t := High(FTbLayouts) downto 0 do
  begin
    if (t > High(FTbSpecs)) or not FTbLayouts[t].Valid then Continue;
    for i := High(FTbSpecs[t].Icons) downto 0 do
    begin
      { rectHover: the element's own rect, through its transform }
      r := TyToolboxIconRect(FTbSpecs[t], FTbSpecs[t].Icons[i], TbEmphasised(t, i));
      TbIconOrigin(t, i, ox, oy);
      { a degenerate icon's NaN rect contains nothing, as a comparison with
        NaN is false }
      if IsNan(r.X) or IsNan(r.Y) or IsNan(r.W) or IsNan(r.H) or IsNan(ox) or IsNan(oy) then
        Continue;
      if (x - ox >= r.X) and (x - ox <= r.X + r.W) and (y - oy >= r.Y)
        and (y - oy <= r.Y + r.H) then
      begin
        ATb := t;
        AIcon := i;
        Exit(True);
      end;
    end;
  end;
end;

procedure TTyAdvanceChart.TbChanged;
begin
  DropStatic;
  FZrDirty := True;
  inherited Invalidate;
end;

{ the icon's mouseover: the title shown at once (its position the
  mouseover's), the emphasis entered at the next frame -- with the state's
  adjusted text config -- unless the element is already in it }
procedure TTyAdvanceChart.TbMouseOver(const ATarget: TTyChartEventTarget);
var t, i: Integer;
begin
  if (ATarget.HdKind <> 8) or (ATarget.HdGen <> FTbGen) then Exit;
  t := ATarget.HdSeries;
  i := ATarget.HdRow;
  if (t > High(FTbLive)) or (i < 0) or (i > High(FTbLive[t])) then Exit;
  FTbLive[t][i].TextShown := FTbSpecs[t].ShowTitle;
  FTbLive[t][i].PendLeave := False;
  if not TbEmphasised(t, i) then FTbLive[t][i].PendEnter := True;
  TbChanged;
end;

{ the icon's mouseout: the emphasis left at the next frame unless the
  feature's status holds it; the title hidden at once }
procedure TTyAdvanceChart.TbMouseOut(const ATarget: TTyChartEventTarget);
var t, i: Integer;
begin
  if (ATarget.HdKind <> 8) or (ATarget.HdGen <> FTbGen) then Exit;
  t := ATarget.HdSeries;
  i := ATarget.HdRow;
  if (t > High(FTbLive)) or (i < 0) or (i > High(FTbLive[t])) then Exit;
  FTbLive[t][i].PendEnter := False;
  if not TbStatusIs(t, FTbSpecs[t].Icons[i].Feature, FTbSpecs[t].Icons[i].Name)
    and FTbLive[t][i].HoverEmph then FTbLive[t][i].PendLeave := True;
  FTbLive[t][i].TextShown := False;
  TbChanged;
end;

{ echarts' _onframe: the hover's emphasis changes applied -- entering brings
  the state's adjusted position and align, leaving takes them away }
procedure TTyAdvanceChart.TbFrame;
var
  t, i: Integer;
  any: Boolean;
begin
  any := False;
  for t := 0 to High(FTbLive) do
    for i := 0 to High(FTbLive[t]) do
    begin
      if FTbLive[t][i].PendEnter then
      begin
        FTbLive[t][i].PendEnter := False;
        FTbLive[t][i].HoverEmph := True;
        FTbLive[t][i].AdjPos := True;
        FTbLive[t][i].AdjAlign := True;
        any := True;
      end;
      if FTbLive[t][i].PendLeave then
      begin
        FTbLive[t][i].PendLeave := False;
        FTbLive[t][i].HoverEmph := False;
        FTbLive[t][i].AdjPos := False;
        FTbLive[t][i].AdjAlign := False;
        any := True;
      end;
    end;
  if any then TbChanged;
end;

procedure TTyAdvanceChart.TbClick(ATb, AIcon: Integer);
var
  f, ic, nm: string;
  h: TTyChartToolboxHandler;
begin
  if (ATb > High(FTbSpecs)) or (AIcon < 0) or (AIcon > High(FTbSpecs[ATb].Icons)) then Exit;
  f := FTbSpecs[ATb].Icons[AIcon].Feature;
  ic := FTbSpecs[ATb].Icons[AIcon].Name;
  if FTbSpecs[ATb].Icons[AIcon].IsUser then
  begin
    { onclick: '@Name' }
    nm := FTbSpecs[ATb].Icons[AIcon].OnClick;
    if TyChartIsHandlerRef(nm) and TyChartFindToolboxHandler(Copy(nm, 2, MaxInt), h) then
      h(Self, f, ic);
    Exit;
  end;
  if f = 'saveAsImage' then TbSaveAsImage(ATb)
  else if f = 'restore' then
  begin
    { history.clear, then the action }
    FTbHistory := nil;
    DispatchAction('{"type":"restore"}');
  end
  else if f = 'dataView' then TbDataView(ATb)
  else if f = 'dataZoom' then
  begin
    if ic = 'zoom' then
    begin
      if FTbZoomActive then
        DispatchAction('{"type":"takeGlobalCursor","key":"dataZoomSelect","dataZoomSelectActive":false}')
      else
        DispatchAction('{"type":"takeGlobalCursor","key":"dataZoomSelect","dataZoomSelectActive":true}');
    end
    else if ic = 'back' then TbBack;
  end
  else if f = 'magicType' then TbMagicType(ATb, ic)
  else if f = 'brush' then TbBrushClick(ic);
end;

function TTyAdvanceChart.ToolboxClick(ATb: Integer; const AFeature, AIcon: string): Boolean;
var i: Integer;
begin
  Result := False;
  if (ATb < 0) or (ATb > High(FTbSpecs)) then Exit;
  for i := 0 to High(FTbSpecs[ATb].Icons) do
    if (FTbSpecs[ATb].Icons[i].Feature = AFeature) and (FTbSpecs[ATb].Icons[i].Name = AIcon) then
    begin
      TbClick(ATb, i);
      Exit(True);
    end;
end;

{ the action's payload as its event carries it: the event's name for its
  type }
function TbEventJson(APayload: TJSONObject; const AName: string): string;
var
  o: TJSONObject;
  i: Integer;
begin
  o := TJSONObject.Create;
  try
    o.Add('type', AName);
    for i := 0 to APayload.Count - 1 do
      if APayload.Names[i] <> 'type' then
        o.Add(APayload.Names[i], APayload.Items[i].Clone);
    Result := TyTbJson(o);
  finally
    o.Free;
  end;
end;

procedure TTyAdvanceChart.TbDoRestore(APayload: TJSONObject);
var h: TTyTbHistory;
begin
  { resetOption('recreate'): new models from the backup -- the same
    GlobalModel, so the history stays }
  h := FTbHistory;
  ApplyNotMerge(FTbBackup);
  FTbHistory := h;
  AfterSetOption(False, True);
  EmitPayloadEvent('restore', TbEventJson(APayload, 'restore'));
end;

function TTyAdvanceChart.TbMagicSeries: TTyMagicSeriesArray;
var
  i, n, slot: Integer;
  d: TJSONData;
  b: TTySeriesBinding;
begin
  n := FOption.ComponentCount('series');
  Result := nil;
  for i := 0 to n - 1 do
  begin
    d := FOption.ComponentAt('series', i);
    if not (d is TJSONObject) then Continue;
    SetLength(Result, Length(Result) + 1);
    Result[High(Result)].Index := i;
    Result[High(Result)].Node := TJSONObject(d);
    Result[High(Result)].SubType := FOption.ComponentSubType('series', i);
    Result[High(Result)].Cartesian := False;
    Result[High(Result)].CatDim := '';
    Result[High(Result)].CatIndex := -1;
    slot := SlotOfSeries(i);
    if slot < 0 then Continue;
    b := FBindings[slot];
    if (b.Cart = nil) or (b.CoordSysName <> 'cartesian2d') then Continue;
    Result[High(Result)].Cartesian := True;
    { getAxesByScale('ordinal')[0]: x before y }
    if (b.XAxis <> nil) and (b.XAxis.AxisType = atCategory) then
    begin
      Result[High(Result)].CatDim := 'x';
      Result[High(Result)].CatIndex := b.XAxis.ComponentIndex;
    end
    else if (b.YAxis <> nil) and (b.YAxis.AxisType = atCategory) then
    begin
      Result[High(Result)].CatDim := 'y';
      Result[High(Result)].CatIndex := b.YAxis.ComponentIndex;
    end;
  end;
end;

procedure TTyAdvanceChart.TbMagicType(ATb: Integer; const AType: string);
var
  fm, opt, ttl, pay: TJSONObject;
  st: TStringList;
  cur: string;
  i: Integer;
begin
  fm := TyToolboxFeatureModel(FOption, ATb, 'magicType', TbTitles);
  if fm = nil then Exit;
  st := TbStatusOf(ATb);
  ttl := nil;
  opt := nil;
  try
    { the titles a stack click wrote into the feature }
    if (ATb <= High(FTbMagicTitle)) and (FTbMagicTitle[ATb] <> '') then
    begin
      if fm.IndexOfName('title') >= 0 then fm.Delete('title');
      fm.Add('title', GetJSON(FTbMagicTitle[ATb]));
    end;
    opt := TyMagicTypeOption(fm, AType, TbMagicSeries, st, cur, ttl);
    if opt = nil then Exit;
    { the statuses it set, on the feature's option }
    for i := 0 to st.Count - 1 do
      if Copy(st.Names[i], 1, 10) = 'magicType|' then
        FTbStatus.Values[IntToStr(ATb) + '|' + st.Names[i]] := st.ValueFromIndex[i];
    pay := TJSONObject.Create;
    try
      pay.Add('type', 'changeMagicType');
      pay.Add('currentType', cur);
      pay.Add('newOption', opt);
      opt := nil;
      if ttl <> nil then
      begin
        pay.Add('newTitle', ttl);
        ttl := nil;
      end;
      pay.Add('featureName', 'magicType');
      DispatchAction(TyTbJson(pay));
    finally
      pay.Free;
    end;
  finally
    opt.Free;
    ttl.Free;
    st.Free;
    fm.Free;
  end;
end;

procedure TTyAdvanceChart.TbDoMagic(APayload: TJSONObject);
var
  d, ft: TJSONData;
  t: Integer;
begin
  d := APayload.Find('newOption');
  if d is TJSONObject then
  begin
    if DoMerge(TyTbJson(d), []) then AfterSetOption(False, True);
  end;
  { the toolbox's render takes newTitle into the feature it names }
  d := APayload.Find('newTitle');
  ft := APayload.Find('featureName');
  if (d <> nil) and (d.JSONType <> jtNull) and (ft <> nil) and (ft.JSONType = jtString)
    and (ft.AsString = 'magicType') then
  begin
    SetLength(FTbMagicTitle, Max(Length(FTbMagicTitle), TyToolboxCount(FOption)));
    for t := 0 to High(FTbMagicTitle) do FTbMagicTitle[t] := TyTbJson(d);
  end;
  EmitPayloadEvent('magictypechanged', TbEventJson(APayload, 'magictypechanged'));
end;

{ getContentFromModel's two kinds of series, from the stores }
function TTyAdvanceChart.TbDataViewContent(out AMeta: TTyDvMetaArray): string;
var
  groups: TTyDvGroupArray;
  lists: TTyDvListArray;
  keys: TTyStringArray;
  i, n, slot, g, k, r, dim: Integer;
  b: TTySeriesBinding;
  st: TTyDataStore;
  key: string;
  cats: TTyOrdinalMeta;
  dims: TTyIntegerArray;
  col: TTyDoubleArray;
  isCat: Boolean;
  nm: string;
begin
  groups := nil;
  lists := nil;
  keys := nil;
  AMeta := nil;
  n := FOption.ComponentCount('series');
  for i := 0 to n - 1 do
  begin
    slot := SlotOfSeries(i);
    if (slot < 0) or (slot > High(FStores)) or (FStores[slot] = nil) then Continue;
    b := FBindings[slot];
    st := FStores[slot];
    isCat := ((b.Cart <> nil) or (b.Polar <> nil)) and (b.BaseAxis <> nil)
      and (b.BaseAxis.AxisType = atCategory) and (b.ValueAxis <> nil);
    nm := FOption.ComponentModelName('series', i);
    if isCat then
    begin
      key := b.BaseAxis.Dim + '_' + IntToStr(b.BaseAxis.ComponentIndex);
      g := -1;
      for k := 0 to High(keys) do
        if keys[k] = key then g := k;
      if g < 0 then
      begin
        g := Length(groups);
        SetLength(groups, g + 1);
        SetLength(keys, g + 1);
        keys[g] := key;
        groups[g].AxisDim := b.BaseAxis.Dim;
        groups[g].AxisIndex := b.BaseAxis.ComponentIndex;
        cats := b.BaseAxis.Categories;
        if cats <> nil then
        begin
          SetLength(groups[g].Categories, cats.Count);
          for k := 0 to cats.Count - 1 do groups[g].Categories[k] := cats.CategoryAt(k);
        end;
        SetLength(AMeta, g + 1);
        AMeta[g].AxisDim := b.BaseAxis.Dim;
        AMeta[g].AxisIndex := b.BaseAxis.ComponentIndex;
      end;
      SetLength(groups[g].Names, Length(groups[g].Names) + 1);
      groups[g].Names[High(groups[g].Names)] := nm;
      dims := st.DimsOfCoord(b.ValueAxis.Dim);
      col := nil;
      if (Length(dims) > 0) and (dims[0] >= 0) then
      begin
        SetLength(col, st.RawCount);
        for r := 0 to st.RawCount - 1 do col[r] := st.GetOriginalByRaw(dims[0], r);
      end;
      SetLength(groups[g].Columns, Length(groups[g].Columns) + 1);
      groups[g].Columns[High(groups[g].Columns)] := col;
    end
    else
    begin
      k := Length(lists);
      SetLength(lists, k + 1);
      lists[k].Name := nm;
      SetLength(lists[k].RowNames, st.RawCount);
      SetLength(lists[k].Rows, st.RawCount);
      for r := 0 to st.RawCount - 1 do
      begin
        lists[k].RowNames[r] := st.GetNameByRaw(r);
        col := nil;
        for dim := 0 to st.DimCount - 1 do
        begin
          { the stack's two columns are in the raw data upstream; no other
            column of the port's own }
          if (Copy(st.DimName(dim), 1, 5) = '__ty_')
            and (Copy(st.DimName(dim), 1, 16) <> '__ty_stackresult')
            and (Copy(st.DimName(dim), 1, 16) <> '__ty_stackedover') then Continue;
          SetLength(col, Length(col) + 1);
          if Copy(st.DimName(dim), 1, 5) = '__ty_' then col[High(col)] := st.GetByRaw(dim, r)
          else col[High(col)] := st.GetOriginalByRaw(dim, r);
        end;
        lists[k].Rows[r] := col;
      end;
    end;
  end;
  Result := TyDataViewText(groups, lists);
end;

function TTyAdvanceChart.ToolboxDataViewText: string;
var meta: TTyDvMetaArray;
begin
  Result := TbDataViewContent(meta);
end;

function TTyAdvanceChart.TbDvFind(const AName: string; out AData: TJSONData): Boolean;
var
  i: Integer;
  d: TJSONData;
begin
  Result := False;
  AData := nil;
  for i := 0 to FOption.ComponentCount('series') - 1 do
    if FOption.ComponentModelName('series', i) = AName then
    begin
      d := FOption.ComponentAt('series', i);
      if d is TJSONObject then AData := TJSONObject(d).Find('data');
      Exit(True);
    end;
end;

procedure TTyAdvanceChart.TbDataView(ATb: Integer);
var
  fm, parsed, pay: TJSONObject;
  meta: TTyDvMetaArray;
  body, title, closeC, refreshC, err: string;
  d: TJSONData;
  ro: Boolean;
begin
  FTbError := '';
  fm := TyToolboxFeatureModel(FOption, ATb, 'dataView', TbTitles);
  if fm = nil then Exit;
  try
    body := TbDataViewContent(meta);
    d := fm.Find('readOnly');
    ro := (d <> nil) and (((d.JSONType = jtBoolean) and d.AsBoolean)
      or ((d.JSONType = jtNumber) and (d.AsFloat <> 0))
      or ((d.JSONType = jtString) and (d.AsString <> '')));
    { lang[0] || title; lang[1], lang[2] the buttons }
    title := '';
    closeC := rsMsgBtnClose;
    refreshC := rsTyChartToolboxDataViewRefresh;
    d := fm.Find('lang');
    if d is TJSONArray then
    begin
      if (TJSONArray(d).Count > 0) and (TJSONArray(d).Items[0].JSONType = jtString) then
        title := TJSONArray(d).Items[0].AsString;
      if (TJSONArray(d).Count > 1) and (TJSONArray(d).Items[1].JSONType = jtString) then
        closeC := TJSONArray(d).Items[1].AsString;
      if (TJSONArray(d).Count > 2) and (TJSONArray(d).Items[2].JSONType = jtString) then
        refreshC := TJSONArray(d).Items[2].AsString;
    end;
    if title = '' then
    begin
      d := fm.Find('title');
      if (d <> nil) and (d.JSONType = jtString) then title := d.AsString;
    end;
  finally
    fm.Free;
  end;
  if not ToolboxShowDataView(title, body, ro, closeC, refreshC) then Exit;
  body := StringReplace(StringReplace(body, #13#10, #10, [rfReplaceAll]), #13, #10, [rfReplaceAll]);
  parsed := TyDataViewParse(body, meta, err);
  if parsed = nil then
  begin
    { upstream throws 'Data view format error' after closing }
    FTbError := Format(rsTyChartToolboxDataViewBad, [err]);
    Exit;
  end;
  pay := TJSONObject.Create;
  try
    pay.Add('type', 'changeDataView');
    pay.Add('newOption', parsed);
    DispatchAction(TyTbJson(pay));
  finally
    pay.Free;
  end;
end;

procedure TTyAdvanceChart.TbDoDataView(APayload: TJSONObject);
var
  d: TJSONData;
  merged: TJSONObject;
begin
  d := APayload.Find('newOption');
  if d is TJSONObject then
  begin
    merged := TyDataViewChange(TJSONObject(d), @TbDvFind);
    try
      if DoMerge(TyTbJson(merged), []) then AfterSetOption(False, True);
    finally
      merged.Free;
    end;
  end;
  EmitPayloadEvent('dataviewchanged', TbEventJson(APayload, 'dataviewchanged'));
end;

function TTyAdvanceChart.ToolboxShowDataView(const ATitle: string;
  var AText: string; AReadOnly: Boolean; const ACloseCaption,
  ARefreshCaption: string): Boolean;
begin
  Result := TyShowDataViewDialog(ATitle, AText, AReadOnly, ACloseCaption, ARefreshCaption);
end;

function TTyAdvanceChart.ToolboxAskFileName(var AFileName: string;
  const AType: string): Boolean;
begin
  Result := TyAskImageFileName(AFileName, AType);
end;

procedure TTyAdvanceChart.TbSaveAsImage(ATb: Integer);
var
  fm: TJSONObject;
  opts, fileName, typ: string;
  handled: Boolean;
begin
  fm := TyToolboxFeatureModel(FOption, ATb, 'saveAsImage', TbTitles);
  try
    opts := TyToolboxSaveOpts(FOption, fm, fileName, typ);
  finally
    fm.Free;
  end;
  handled := False;
  if Assigned(FOnToolboxSaveAsImage) then
    FOnToolboxSaveAsImage(Self, fileName, opts, handled);
  if handled then Exit;
  if not ToolboxAskFileName(fileName, typ) then Exit;
  { getConnectedDataURL: the whole group when it is connected [Batch 141] }
  SaveConnectedToFile(fileName, opts);
end;

procedure TTyAdvanceChart.TbDoTakeCursor(APayload: TJSONObject);
var d: TJSONData;
begin
  d := APayload.Find('key');
  if (d <> nil) and (d.JSONType = jtString) and (d.AsString = 'dataZoomSelect') then
    FTbZoomActive := TyJsTruthy(APayload.Find('dataZoomSelectActive'))
  else
    FTbZoomActive := False;
  { the toolbox renders in the update: its select brush on or off at once
    [Batch 127] }
  TbZoomCtlSync;
  { the brush components' painting option, and their views [Batch 126] }
  BrushTakeCursor(APayload);
  { the visual stage's brushSelect [Batch 127], and the brush feature's
    statuses as this update renders them }
  BrushSelectRun(True);
  TbBrushSnap;
  { update: every view renders again -- the parallel axes' too [Batch 130] }
  FParBrushSkip := -1;
  FDirty := True;
  Invalidate;
  EmitPayloadEvent('globalcursortaken', TbEventJson(APayload, 'globalcursortaken'));
end;

{ the select dataZoom for an axis key ('x0'); -1 for none (findDataZoom:
  the last one) }
function TTyAdvanceChart.TbSelIndexOf(const AKey: string): Integer;
var i, k: Integer;
begin
  Result := -1;
  for i := 0 to High(FZoomSpecs) do
    if FZoomSpecs[i].SubType = 'select' then
      for k := 0 to High(FZoomSpecs[i].Targets) do
        if FZoomSpecs[i].Targets[k].Dim + IntToStr(FZoomSpecs[i].Targets[k].AxisIndex) = AKey then
          Result := i;
end;

procedure TTyAdvanceChart.TbSelPut(const AKey: string; AIsValue: Boolean; A, B: Double);
var i: Integer;
begin
  for i := 0 to High(FTbSel) do
    if FTbSel[i].Key = AKey then
    begin
      FTbSel[i].IsValue := AIsValue;
      FTbSel[i].A := A;
      FTbSel[i].B := B;
      Exit;
    end;
  i := Length(FTbSel);
  SetLength(FTbSel, i + 1);
  FTbSel[i].Key := AKey;
  FTbSel[i].IsValue := AIsValue;
  FTbSel[i].A := A;
  FTbSel[i].B := B;
end;

procedure TTyAdvanceChart.TbDispatchZoom(const ASnap: TTyTbSnapshot);
var
  a: TTyDzAction;
  i, k, n: Integer;
begin
  a := Default(TTyDzAction);
  a.Batch := True;
  a.FromToolbox := True;
  a.FromSlider := -1;
  for i := 0 to High(ASnap) do
  begin
    k := TbSelIndexOf(ASnap[i].Key);
    if k < 0 then Continue;
    n := Length(a.Items);
    SetLength(a.Items, n + 1);
    a.Items[n].DataZoomIndex := k;
    a.Items[n].IsValue := ASnap[i].IsValue;
    a.Items[n].Start := ASnap[i].A;
    a.Items[n].Stop := ASnap[i].B;
  end;
  if Length(a.Items) = 0 then Exit;
  DzDispatch(a);
end;

procedure TTyAdvanceChart.TbBack;
var snap: TTyTbSnapshot;
begin
  snap := TyTbHistoryPop(FTbHistory);
  { the dispatch's update renders the toolbox again: back's status follows
    the history -- and an empty snapshot dispatches nothing, renders
    nothing }
  TbDispatchZoom(snap);
end;

{ updateZoomBtnStatus [Batch 127]: the panels are the grids some select
  dataZoom targets an axis of (makePanelOpts), each typed lineX when only
  its x axes are declared, lineY only its y, else rect; the controller on
  with brushType 'auto' while the zoom is on and there is a panel, off
  otherwise. CSS px. }
procedure TTyAdvanceChart.TbZoomCtlSync;
var
  g, i, k, n: Integer;
  xd, yd: Boolean;
  axis: TTyAxis;
  pn: array of TTyBrushPanel;
  off: TTyBrushOpt;
  s: Double;
begin
  if (FTbBrushCtl = nil) and not FTbZoomActive then Exit;
  if FTbBrushCtl = nil then
  begin
    FTbBrushCtl := TTyBrushController.Create;
    FTbBrushCtl.IsIrrelevant := @BrushIrrelevant;
  end;
  pn := nil;
  FTbBrushGrids := nil;
  if FBuild <> nil then
    for g := 0 to FBuild.GridCount - 1 do
    begin
      xd := False;
      yd := False;
      for i := 0 to High(FZoomSpecs) do
        if FZoomSpecs[i].SubType = 'select' then
          for k := 0 to High(FZoomSpecs[i].Targets) do
          begin
            axis := DzAxis(FZoomSpecs[i].Targets[k].Dim, FZoomSpecs[i].Targets[k].AxisIndex);
            if (axis = nil) or (axis.GridIndex <> FBuild.Grid(g).ComponentIndex) then Continue;
            if FZoomSpecs[i].Targets[k].Dim = 'x' then xd := True else yd := True;
          end;
      if not (xd or yd) then Continue;
      n := Length(pn);
      SetLength(pn, n + 1);
      SetLength(FTbBrushGrids, n + 1);
      pn[n].Id := 'grid--' + ComponentModelId('grid', FBuild.Grid(g).ComponentIndex);
      pn[n].Rect := DzGridRect(g);
      pn[n].GridComponent := FBuild.Grid(g).ComponentIndex;
      if xd and not yd then pn[n].DefaultType := btLineX
      else if yd and not xd then pn[n].DefaultType := btLineY
      else pn[n].DefaultType := btRect;
      FTbBrushGrids[n] := g;
    end;
  s := TbScale;
  FTbBrushCtl.CanvasW := (FLastRect.Right - FLastRect.Left) / s;
  FTbBrushCtl.CanvasH := (FLastRect.Bottom - FLastRect.Top) / s;
  FTbBrushCtl.SetPanels(pn, Length(pn) > 0);
  if FTbZoomActive and (Length(pn) > 0) then
    BrushEnableCtl(FTbBrushCtl, TyBrushDefaultOpt, True)
  else
  begin
    off := TyBrushDefaultOpt;
    off.BrushType := btNone;
    BrushEnableCtl(FTbBrushCtl, off, False);
  end;
end;

procedure TTyAdvanceChart.TbCtlDown(AX, AY: Integer; ADraggable: Boolean);
var x, y: Double;
begin
  if FTbBrushCtl = nil then Exit;
  BrushCss(AX, AY, x, y);
  TbCtlTrigger(FTbBrushCtl.MouseDown(x, y, ADraggable));
end;

procedure TTyAdvanceChart.TbCtlMove(AX, AY: Integer);
var x, y: Double;
begin
  if (FTbBrushCtl = nil) or not FTbBrushCtl.Dragging then Exit;
  BrushCss(AX, AY, x, y);
  TbCtlTrigger(FTbBrushCtl.MouseMove(x, y));
  TbChanged;
end;

procedure TTyAdvanceChart.TbCtlUp(AX, AY: Integer);
var x, y: Double;
begin
  if (FTbBrushCtl = nil) or not FTbBrushCtl.Dragging then Exit;
  BrushCss(AX, AY, x, y);
  TbCtlTrigger(FTbBrushCtl.MouseUp(x, y));
  TbChanged;
end;

{ DataZoomFeature._onBrush: only an end with areas; the cover goes
  (updateCovers([])) and the area is the zoom }
procedure TTyAdvanceChart.TbCtlTrigger(const ATrig: TTyBrushTrigger);
var
  a: TTyBrushArea;
  i, g: Integer;
begin
  if not ATrig.Fired or not ATrig.IsEnd or (Length(ATrig.Areas) = 0) then Exit;
  FTbBrushCtl.UpdateCovers([]);
  TbChanged;
  a := ATrig.Areas[0];
  g := -1;
  for i := 0 to High(FTbBrushCtl.Panels) do
    if a.Opt.HasPanel and (FTbBrushCtl.Panels[i].Id = a.Opt.PanelId)
      and (i <= High(FTbBrushGrids)) then g := FTbBrushGrids[i];
  if (g < 0) or (Length(a.Opt.Range) = 0) then Exit;
  FTbBrushGrid := g;
  for i := 0 to 3 do FTbRange[i] := NaN;
  case a.Opt.BrushType of
    btLineX:
      begin
        FTbBrushType := tbbLineX;
        FTbRange[0] := a.Opt.Range[0][0];
        FTbRange[1] := a.Opt.Range[0][1];
      end;
    btLineY:
      begin
        FTbBrushType := tbbLineY;
        FTbRange[2] := a.Opt.Range[0][0];
        FTbRange[3] := a.Opt.Range[0][1];
      end;
  else
    if Length(a.Opt.Range) < 2 then Exit;
    FTbBrushType := tbbRect;
    FTbRange[0] := a.Opt.Range[0][0];
    FTbRange[1] := a.Opt.Range[0][1];
    FTbRange[2] := a.Opt.Range[1][0];
    FTbRange[3] := a.Opt.Range[1][1];
  end;
  TbBrushEnd;
end;

{ _onBrush: every cartesian of the panel's grid that the feature targets,
  its range in data (pointToData clamped, or the affine inverse), restricted
  to the hosting dataZoom's value spans, rounded to the precision the
  grid's pixels allow; pushed to the history; dispatched }
procedure TTyAdvanceChart.TbBrushEnd;
var
  snap: TTyTbSnapshot;
  keys: TTyStringArray;
  pa, pb: TTyDoubleArray;
  g, c, i, k, n: Integer;
  cart: TTyCartesian2D;
  ax: TTyAxis;
  dim: Integer;
  m: TTyMat2D;
  pt: TTyPointF;
  d0, d1: TTyDoubleArray;
  mm: array[0..1] of Double;
  t: Double;
  key: string;
  zoom: TTyAxisZoom;
  win: TTyDzWindow;
  host: Integer;
  s, px: Double;
  ext: TTyRange;
  prec: Double;
  r: TTyXYWH;

  function DevX(V: Double): Double;
  begin
    Result := FBuild.Viewport.Left + V * s;
  end;

  function DevY(V: Double): Double;
  begin
    Result := FBuild.Viewport.Top + V * s;
  end;

  procedure SetBatch(ADim: Integer; AAxis: TTyAxis; A, B: Double);
  var j: Integer;
  begin
    if AAxis = nil then Exit;
    if ADim = 0 then key := 'x' else key := 'y';
    key := key + IntToStr(AAxis.ComponentIndex);
    if TbSelIndexOf(key) < 0 then Exit;
    ext := AAxis.Scale.GetExtent;
    if ADim = 0 then px := r.W else px := r.H;
    prec := TyAcceptableTickPrecision(ext.Start, ext.Stop, px, 0.5);
    if not IsNan(prec) and not IsInfinite(prec) then
    begin
      A := TyTbRound(A, prec);
      B := TyTbRound(B, prec);
    end;
    for j := 0 to High(snap) do
      if snap[j].Key = key then
      begin
        snap[j].IsValue := True;
        snap[j].A := A;
        snap[j].B := B;
        Exit;
      end;
    j := Length(snap);
    SetLength(snap, j + 1);
    snap[j].Key := key;
    snap[j].IsValue := True;
    snap[j].A := A;
    snap[j].B := B;
  end;

begin
  snap := nil;
  g := FTbBrushGrid;
  if (FBuild = nil) or (g < 0) or (g >= FBuild.GridCount) then Exit;
  s := TbScale;
  r := DzGridRect(g);
  for c := 0 to FBuild.Grid(g).CartesianCount - 1 do
  begin
    cart := FBuild.Grid(g).CartesianByIndex(c);
    if cart = nil then Continue;
    { a cartesian whose x or y axis the feature targets }
    if (cart.AxisByDim('x') = nil) or (cart.AxisByDim('y') = nil) then Continue;
    if (TbSelIndexOf('x' + IntToStr(cart.AxisByDim('x').ComponentIndex)) < 0)
      and (TbSelIndexOf('y' + IntToStr(cart.AxisByDim('y').ComponentIndex)) < 0) then Continue;
    case FTbBrushType of
      tbbRect:
        begin
          if cart.InvTransform(m) then
          begin
            cart.PointToData(TyPointF(DevX(FTbRange[0]), DevY(FTbRange[2])), d0);
            cart.PointToData(TyPointF(DevX(FTbRange[1]), DevY(FTbRange[3])), d1);
          end
          else
          begin
            SetLength(d0, 2);
            SetLength(d1, 2);
            d0[0] := cart.AxisByDim('x').CoordToData(DevX(FTbRange[0]), True);
            d0[1] := cart.AxisByDim('y').CoordToData(DevY(FTbRange[2]), True);
            d1[0] := cart.AxisByDim('x').CoordToData(DevX(FTbRange[1]), True);
            d1[1] := cart.AxisByDim('y').CoordToData(DevY(FTbRange[3]), True);
          end;
          for dim := 0 to 1 do
          begin
            mm[0] := d0[dim];
            mm[1] := d1[dim];
            if mm[0] > mm[1] then
            begin
              t := mm[0];
              mm[0] := mm[1];
              mm[1] := t;
            end;
            if dim = 0 then SetBatch(0, cart.AxisByDim('x'), mm[0], mm[1])
            else SetBatch(1, cart.AxisByDim('y'), mm[0], mm[1]);
          end;
        end;
      tbbLineX, tbbLineY:
        begin
          if FTbBrushType = tbbLineX then
          begin
            ax := cart.AxisByDim('x');
            mm[0] := ax.CoordToData(DevX(FTbRange[0]), True);
            mm[1] := ax.CoordToData(DevX(FTbRange[1]), True);
            dim := 0;
          end
          else
          begin
            ax := cart.AxisByDim('y');
            mm[0] := ax.CoordToData(DevY(FTbRange[2]), True);
            mm[1] := ax.CoordToData(DevY(FTbRange[3]), True);
            dim := 1;
          end;
          if mm[0] > mm[1] then
          begin
            t := mm[0];
            mm[0] := mm[1];
            mm[1] := t;
          end;
          SetBatch(dim, ax, mm[0], mm[1]);
        end;
    end;
  end;
  if Length(snap) = 0 then Exit;
  { the windows before the first brush: each select dataZoom's percent range }
  n := Length(snap);
  SetLength(keys, n);
  SetLength(pa, n);
  SetLength(pb, n);
  for i := 0 to n - 1 do
  begin
    keys[i] := snap[i].Key;
    pa[i] := 0;
    pb[i] := 100;
    k := StrToIntDef(Copy(snap[i].Key, 2, MaxInt), 0);
    if Copy(snap[i].Key, 1, 1) = 'x' then
    begin
      if AxisZoom('xAxis', k, zoom, win, host) then
      begin
        pa[i] := win.Percent[0];
        pb[i] := win.Percent[1];
      end;
    end
    else if AxisZoom('yAxis', k, zoom, win, host) then
    begin
      pa[i] := win.Percent[0];
      pb[i] := win.Percent[1];
    end;
  end;
  TyTbHistoryPush(FTbHistory, snap, keys, pa, pb);
  { the dispatch's update renders the toolbox again (back's status) }
  TbDispatchZoom(snap);
end;

{ the pointer's cursor: an icon's own ('pointer'), and over a brush panel
  the brush's crosshair, which is set after it }
procedure TTyAdvanceChart.TbApplyCursor(AX, AY: Integer);
var
  x, y: Double;
  c, bc: string;
begin
  c := '';
  bc := '';
  if (FEvHover.HdKind = 8) and (FEvHover.Id <> 0) then c := 'pointer';
  { a timeline element's cursor, zrender's default [Batch 129] }
  if (FEvHover.HdKind = 10) and (FEvHover.Id <> 0) then c := 'pointer';
  { a brush cover's piece under the pointer: its own cursor [Batch 126] }
  if (FEvHover.HdKind = 9) and (FEvHover.Id <> 0) and (FEvHover.HdGen >= 0)
    and (FEvHover.HdGen <= Ord(High(TTyBrushPiece))) then
  begin
    { through the controller's group: a parallel axis' is turned
      [Batch 130] }
    if BrushCtlOf(FEvHover.HdSeries) <> nil then
      bc := BrushCtlOf(FEvHover.HdSeries).PieceCursor(TTyBrushPiece(FEvHover.HdGen), True)
    else
      bc := TyBrushPieceCursor(TTyBrushPiece(FEvHover.HdGen), True);
    c := bc;
  end;
  { the select brush's resetCursor [Batch 127] }
  if FTbBrushCtl <> nil then
  begin
    BrushCss(AX, AY, x, y);
    if FTbBrushCtl.Crosshair(x, y) then c := 'crosshair';
  end;
  { the brush controllers' resetCursor: the crosshair in a panel off the
    covers [Batch 126] }
  if BrushCrosshair(AX, AY) then
  begin
    c := 'crosshair';
    bc := 'crosshair';
  end;
  FBrushCursor := bc;
  if c <> '' then
  begin
    FTbCursor := c;
    FDzCursor := c;
    DzApplyCursor;
  end
  else if FTbCursor <> '' then
  begin
    FTbCursor := '';
    FDzCursor := 'default';
    DzApplyCursor;
  end;
end;

{ ---- what the tests read ---- }

procedure TTyAdvanceChart.ToolboxFrame;
begin
  TbFrame;
end;

function TTyAdvanceChart.ToolboxCount: Integer;
begin
  Result := Length(FTbSpecs);
end;

function TTyAdvanceChart.ToolboxSpec(AIndex: Integer): TTyToolboxSpec;
begin
  Result := Default(TTyToolboxSpec);
  if (AIndex >= 0) and (AIndex <= High(FTbSpecs)) then Result := FTbSpecs[AIndex];
end;

function TTyAdvanceChart.ToolboxLayout(AIndex: Integer): TTyToolboxLayout;
begin
  Result := Default(TTyToolboxLayout);
  if (AIndex >= 0) and (AIndex <= High(FTbLayouts)) then Result := FTbLayouts[AIndex];
end;

function TTyAdvanceChart.ToolboxIconState(ATb, AIcon: Integer;
  out AEmphasised, ATitleShown, APosAdjusted, AAlignAdjusted: Boolean): Boolean;
begin
  AEmphasised := False;
  ATitleShown := False;
  APosAdjusted := False;
  AAlignAdjusted := False;
  Result := (ATb >= 0) and (ATb <= High(FTbSpecs)) and (AIcon >= 0)
    and (AIcon <= High(FTbSpecs[ATb].Icons));
  if not Result then Exit;
  AEmphasised := TbEmphasised(ATb, AIcon);
  if (ATb <= High(FTbLive)) and (AIcon <= High(FTbLive[ATb])) then
  begin
    ATitleShown := FTbLive[ATb][AIcon].TextShown;
    APosAdjusted := FTbLive[ATb][AIcon].AdjPos;
    AAlignAdjusted := FTbLive[ATb][AIcon].AdjAlign;
  end;
end;

function TTyAdvanceChart.ToolboxTitle(ATb, AIcon: Integer): TTyTbTitlePlace;
var e, shown, ap, aa: Boolean;
begin
  Result := Default(TTyTbTitlePlace);
  if not ToolboxIconState(ATb, AIcon, e, shown, ap, aa) then Exit;
  Result := TyToolboxTitlePlace(FTbSpecs[ATb], FTbLayouts[ATb], AIcon, ap, aa, e);
end;

function TTyAdvanceChart.ToolboxIconStatus(ATb: Integer; const AFeature,
  AIcon: string): string;
begin
  Result := FTbStatus.Values[IntToStr(ATb) + '|' + AFeature + '|' + AIcon];
end;

function TTyAdvanceChart.ToolboxHistoryCount: Integer;
begin
  Result := TyTbHistoryCount(FTbHistory);
end;

function TTyAdvanceChart.ToolboxCover(out ARect: TTyXYWH): Boolean;
begin
  ARect := Default(TTyXYWH);
  Result := (FTbBrushCtl <> nil) and (Length(FTbBrushCtl.Covers) > 0);
  if Result then ARect := FTbBrushCtl.Covers[0].Main;
end;

{ ==================== the brush components [Batch 126] ====================

  BrushModel / BrushView / the `brush` action over the pure
  tyControls.AdvChart.Brush. The model's areas and painting option live
  here by component index (a merge keeps them; a notMerge, and restore,
  make new models and views); each component's view is a
  TTyBrushController. A full update (Relayout) runs the visual stage's
  layoutCovers and every view's render; the `brush` action runs the same
  update synchronously, every view but the dispatching one ($from) laying
  its covers again; takeGlobalCursor sets the painting option. The
  pointer: zrender's Draggable on a cover's piece (MouseDown / MouseMove /
  MouseUp), the controllers' own handlers after the dataZoom's, the
  cursor in TbApplyCursor. brushSelect's dispatch goes through the
  throttle the first component asks for; what it carries (the selected
  data) is the next batch's, so it is only logged here. }

function TTyAdvanceChart.BrushViewOf: TTyBrushView;
begin
  Result.S := DzScale;
  if FBuild <> nil then
  begin
    Result.OX := FBuild.Viewport.Left;
    Result.OY := FBuild.Viewport.Top;
  end
  else
  begin
    Result.OX := FLastRect.Left;
    Result.OY := FLastRect.Top;
  end;
end;

procedure TTyAdvanceChart.BrushCss(AX, AY: Double; out X, Y: Double);
var v: TTyBrushView;
begin
  v := BrushViewOf;
  X := (AX - v.OX) / v.S;
  Y := (AY - v.OY) / v.S;
end;

{ the components the option has: each one's model from its option; the
  areas, the painting option and the view kept by index }
procedure TTyAdvanceChart.BrushSync;
var n, i, old: Integer;
begin
  n := FOption.ComponentCount('brush');
  old := Length(FBrushCtls);
  for i := n to old - 1 do BrushFreeCtl(FBrushCtls[i]);
  SetLength(FBrushCtls, n);
  for i := old to n - 1 do FBrushCtls[i] := nil;
  SetLength(FBrushSpecs, n);
  SetLength(FBrushAreas, n);
  SetLength(FBrushPaint, n);
  SetLength(FBrushHasPaint, n);
  for i := 0 to n - 1 do
  begin
    FBrushSpecs[i] := TyBrushSpecOf(FOption.ComponentAt('brush', i));
    if FBrushCtls[i] = nil then
    begin
      FBrushCtls[i] := TTyBrushController.Create;
      { isTargetByCursor's onIrrelevantElement [Batch 127] }
      FBrushCtls[i].IsIrrelevant := @BrushIrrelevant;
    end;
  end;
end;

procedure TTyAdvanceChart.BrushReset;
var i: Integer;
begin
  { a view disposed: its controller off (globalPan released) [Batch 127] }
  for i := 0 to High(FBrushCtls) do BrushFreeCtl(FBrushCtls[i]);
  FBrushCtls := nil;
  FBrushSpecs := nil;
  FBrushAreas := nil;
  FBrushPaint := nil;
  FBrushHasPaint := nil;
  FBrushDragOn := False;
  FBrushCursor := '';
end;

{ BrushTargetManager's grid targets: the grids of the x axes, then of the y
  axes, then the grids the finder names, each once; on each the cartesians
  whose x or y axis the finder names. A grid none of whose cartesians is
  named has no representative one -- upstream throws on its panel; here
  it is no target. }
function TTyAdvanceChart.BrushTargets(ABrush: Integer): TTyBrushTargetArray;
var
  fd: TJSONData;
  pf: TTyParsedFinder;
  xs, ys, gs, order, geos: TTyIntegerArray;
  r: TTyXYWH;
  s: Double;
  i, k, gb, c, n: Integer;
  ax: TTyAxis;
  cart: TTyCartesian2D;
  t: TTyBrushTarget;

  procedure AddGrid(AComp: Integer);
  var q: Integer;
  begin
    if AComp < 0 then Exit;
    for q := 0 to High(order) do
      if order[q] = AComp then Exit;
    SetLength(order, Length(order) + 1);
    order[High(order)] := AComp;
  end;

  function Has(const A: TTyIntegerArray; V: Integer): Boolean;
  var q: Integer;
  begin
    for q := 0 to High(A) do
      if A[q] = V then Exit(True);
    Result := False;
  end;

begin
  Result := nil;
  if (FBuild = nil) or (ABrush < 0) or (ABrush > High(FBrushSpecs)) then Exit;
  if FBrushSpecs[ABrush].Finder = '' then Exit;
  fd := GetJSON(FBrushSpecs[ABrush].Finder);
  try
    pf := TyParseFinder(fd, FOption.Keys);
  finally
    fd.Free;
  end;
  xs := TyFinderModels(pf, 'xAxis');
  ys := TyFinderModels(pf, 'yAxis');
  gs := TyFinderModels(pf, 'grid');
  geos := TyFinderModels(pf, 'geo');
  order := nil;
  for i := 0 to High(xs) do
  begin
    ax := DzAxis('x', xs[i]);
    if ax <> nil then AddGrid(ax.GridIndex);
  end;
  for i := 0 to High(ys) do
  begin
    ax := DzAxis('y', ys[i]);
    if ax <> nil then AddGrid(ax.GridIndex);
  end;
  for i := 0 to High(gs) do AddGrid(gs[i]);
  for k := 0 to High(order) do
  begin
    gb := -1;
    for i := 0 to FBuild.GridCount - 1 do
      if FBuild.Grid(i).ComponentIndex = order[k] then
      begin
        gb := i;
        Break;
      end;
    if gb < 0 then Continue;
    t := Default(TTyBrushTarget);
    for c := 0 to FBuild.Grid(gb).CartesianCount - 1 do
    begin
      cart := FBuild.Grid(gb).CartesianByIndex(c);
      if cart = nil then Continue;
      if ((cart.AxisByDim('x') <> nil) and Has(xs, cart.AxisByDim('x').ComponentIndex))
        or ((cart.AxisByDim('y') <> nil) and Has(ys, cart.AxisByDim('y').ComponentIndex)) then
      begin
        n := Length(t.Carts);
        SetLength(t.Carts, n + 1);
        t.Carts[n] := cart;
      end;
    end;
    if Length(t.Carts) = 0 then Continue;
    t.PanelId := 'grid--' + ComponentModelId('grid', order[k]);
    t.GridComponent := order[k];
    t.Grid := gb;
    t.GeoComponent := -1;
    t.Rect := DzGridRect(gb);
    n := Length(Result);
    SetLength(Result, n + 1);
    Result[n] := t;
  end;
  { THE GEOS the finder names [Batch 152]: the panel the data rect through
    the overall matrix, in the brush's CSS px }
  s := DzScale;
  for k := 0 to High(geos) do
  begin
    if (geos[k] < 0) or (geos[k] > High(FGeos)) or (FGeos[geos[k]] = nil)
      or not FGeos[geos[k]].Valid then Continue;
    t := Default(TTyBrushTarget);
    t.PanelId := 'geo--' + ComponentModelId('geo', geos[k]);
    t.GridComponent := -1;
    t.Grid := -1;
    t.GeoComponent := geos[k];
    t.Geo := FGeos[geos[k]];
    r := FGeos[geos[k]].OverallRect;
    t.Rect.X := (r.X - BrushViewOf.OX) / s;
    t.Rect.Y := (r.Y - BrushViewOf.OY) / s;
    t.Rect.W := r.W / s;
    t.Rect.H := r.H / s;
    n := Length(Result);
    SetLength(Result, n + 1);
    Result[n] := t;
  end;
end;

{ findTargetInfo: by the area's panelId when it has one, else by the grid
  its finder reaches (its grid, its x axis' grid, its y axis'); -1 is
  `true`, the global panel }
function TTyAdvanceChart.BrushFindTarget(const ATargets: TTyBrushTargetArray;
  const AArea: TTyBrushArea): Integer;
var
  i, gm, x: Integer;
  fd: TJSONData;
  pf: TTyParsedFinder;
  ax: TTyAxis;
begin
  Result := -1;
  if AArea.Opt.HasPanel and (AArea.Opt.PanelId <> '') then
  begin
    for i := 0 to High(ATargets) do
      if ATargets[i].PanelId = AArea.Opt.PanelId then Exit(i);
    Exit;
  end;
  if AArea.Finder = '' then Exit;
  fd := GetJSON(AArea.Finder);
  try
    pf := TyParseFinder(fd, FOption.Keys);
  finally
    fd.Free;
  end;
  { targetInfoMatchers' geo: the area's geo }
  x := TyFinderModel(pf, 'geo');
  if x >= 0 then
  begin
    for i := 0 to High(ATargets) do
      if ATargets[i].GeoComponent = x then Exit(i);
  end;
  gm := TyFinderModel(pf, 'grid');
  if gm < 0 then
  begin
    x := TyFinderModel(pf, 'xAxis');
    if x >= 0 then
    begin
      ax := DzAxis('x', x);
      if ax <> nil then gm := ax.GridIndex;
    end;
  end;
  if gm < 0 then
  begin
    x := TyFinderModel(pf, 'yAxis');
    if x >= 0 then
    begin
      ax := DzAxis('y', x);
      if ax <> nil then gm := ax.GridIndex;
    end;
  end;
  if gm < 0 then Exit;
  for i := 0 to High(ATargets) do
    if (ATargets[i].GridComponent = gm) and (ATargets[i].Geo = nil) then Exit(i);
end;

{ setInputRanges: every area bound to a target takes its panel, and its
  range from its coordRange -- back through dataToPoint, less the offset
  of the round trip at the size ratio }
{ coordConvert on a target: a grid's cartesian AIndex, or [Batch 152] a
  geo's dataToPoint / pointToData -- a rect by its two corners, a polygon
  by its points (a geo has no axis: no lineX, no lineY) }
function TTyAdvanceChart.BrushConvertOn(const ATarget: TTyBrushTarget; AIndex: Integer;
  AType: TTyBrushType; AToData: Boolean; const AView: TTyBrushView;
  const ARange: TTyBrushRange; AClamp: Boolean; out AValues, AXYMinMax: TTyBrushRange): Boolean;
var
  geo: TTyGeo;
  i: Integer;
  a, b: TTyBrushPair;
  mask: TFPUExceptionMask;

  function Conv(AX, AY: Double): TTyBrushPair;
  var p: TTyPointF; d: TTyGeoPt;
  begin
    Result[0] := NaN;
    Result[1] := NaN;
    if AToData then
    begin
      if geo.DataOf(AView.OX + AX * AView.S, AView.OY + AY * AView.S, d) then
      begin
        Result[0] := d.X;
        Result[1] := d.Y;
      end;
    end
    else if geo.PointOf(AX, AY, p) then
    begin
      Result[0] := (p.X - AView.OX) / AView.S;
      Result[1] := (p.Y - AView.OY) / AView.S;
    end;
  end;

  function Mm(A, B: Double): TTyBrushPair;
  begin
    if A > B then
    begin
      Result[0] := B;
      Result[1] := A;
    end
    else
    begin
      Result[0] := A;
      Result[1] := B;
    end;
  end;

begin
  AValues := nil;
  AXYMinMax := nil;
  if ATarget.Geo = nil then
  begin
    Result := (AIndex >= 0) and (AIndex <= High(ATarget.Carts))
      and TyBrushConvert(AType, AToData, ATarget.Carts[AIndex], AView, ARange, AClamp,
        AValues, AXYMinMax);
    Exit;
  end;
  Result := False;
  geo := TTyGeo(ATarget.Geo);
  mask := GeoMaskFpu;
  try
    case AType of
      btRect:
        begin
          if Length(ARange) < 2 then Exit;
          a := Conv(ARange[0][0], ARange[1][0]);
          b := Conv(ARange[0][1], ARange[1][1]);
          SetLength(AValues, 2);
          AValues[0] := Mm(a[0], b[0]);
          AValues[1] := Mm(a[1], b[1]);
          AXYMinMax := Copy(AValues);
          Result := True;
        end;
      btPolygon:
        begin
          SetLength(AValues, Length(ARange));
          SetLength(AXYMinMax, 2);
          AXYMinMax[0][0] := Infinity;
          AXYMinMax[0][1] := NegInfinity;
          AXYMinMax[1][0] := Infinity;
          AXYMinMax[1][1] := NegInfinity;
          for i := 0 to High(ARange) do
          begin
            a := Conv(ARange[i][0], ARange[i][1]);
            AXYMinMax[0][0] := Math.Min(AXYMinMax[0][0], a[0]);
            AXYMinMax[1][0] := Math.Min(AXYMinMax[1][0], a[1]);
            AXYMinMax[0][1] := Math.Max(AXYMinMax[0][1], a[0]);
            AXYMinMax[1][1] := Math.Max(AXYMinMax[1][1], a[1]);
            AValues[i] := a;
          end;
          Result := True;
        end;
    end;
  finally
    GeoUnmaskFpu(mask);
  end;
end;

procedure TTyAdvanceChart.BrushLayout(ABrush: Integer);
var
  tg: TTyBrushTargetArray;
  i, t: Integer;
  vals, xy: TTyBrushRange;
  sx, sy: Double;
  a: TTyBrushArea;
  v: TTyBrushView;
begin
  if (ABrush < 0) or (ABrush > High(FBrushAreas)) then Exit;
  tg := BrushTargets(ABrush);
  v := BrushViewOf;
  for i := 0 to High(FBrushAreas[ABrush]) do
  begin
    a := FBrushAreas[ABrush][i];
    t := BrushFindTarget(tg, a);
    if not a.Opt.HasRange then
    begin
      a.Opt.HasRange := True;
      a.Opt.Range := nil;
    end;
    if t >= 0 then
    begin
      a.Opt.HasPanel := True;
      a.Opt.PanelId := tg[t].PanelId;
      if a.HasCoordRange and BrushConvertOn(tg[t], 0, a.Opt.BrushType, False, v,
        a.CoordRange, False, vals, xy) then
      begin
        if a.HasOffset then
        begin
          TyBrushScales(xy, a.OffsetXY, sx, sy);
          a.Opt.Range := TyBrushDiff(a.Opt.BrushType, vals, a.Offset, sx, sy);
        end
        else
          a.Opt.Range := vals;
      end;
    end;
    FBrushAreas[ABrush][i] := a;
  end;
end;

{ BrushView._updateController: the panels, the painting option, the covers
  from the model's areas }
procedure TTyAdvanceChart.BrushRender(ABrush: Integer; ARepaint: Boolean);
var
  tg: TTyBrushTargetArray;
  pn: array of TTyBrushPanel;
  i: Integer;
  ctl: TTyBrushController;
  cfg: TTyBrushOptArray;
  off: TTyBrushOpt;
  s: Double;
begin
  if (ABrush < 0) or (ABrush > High(FBrushCtls)) or (FBrushCtls[ABrush] = nil) then Exit;
  ctl := FBrushCtls[ABrush];
  s := DzScale;
  ctl.CanvasW := (FLastRect.Right - FLastRect.Left) / s;
  ctl.CanvasH := (FLastRect.Bottom - FLastRect.Top) / s;
  tg := BrushTargets(ABrush);
  SetLength(pn, Length(tg));
  for i := 0 to High(tg) do
  begin
    pn[i].Id := tg[i].PanelId;
    pn[i].Rect := tg[i].Rect;
    pn[i].DefaultType := btRect;
    pn[i].GridComponent := tg[i].GridComponent;
  end;
  ctl.SetPanels(pn, Length(pn) > 0);
  { through the globalPan mutex [Batch 127] }
  if FBrushHasPaint[ABrush] then BrushEnableCtl(ctl, FBrushPaint[ABrush], False)
  else
  begin
    { a model's brushOption starts empty: no type, drawing off }
    off := TyBrushDefaultOpt;
    off.BrushType := btNone;
    BrushEnableCtl(ctl, off, False);
  end;
  SetLength(cfg, Length(FBrushAreas[ABrush]));
  for i := 0 to High(cfg) do cfg[i] := FBrushAreas[ABrush][i].Opt;
  ctl.UpdateCovers(cfg);
  { inside a paint's layout the list is built next anyway }
  if ARepaint then BrushChanged;
end;

procedure TTyAdvanceChart.BrushPass;
var b: Integer;
begin
  BrushSync;
  for b := 0 to High(FBrushSpecs) do BrushLayout(b);
  for b := 0 to High(FBrushSpecs) do BrushRender(b, False);
end;

{ setOutputRanges: an area on a target gets coordRanges (one per cartesian
  of the target), coordRange the first of them, and __rangeOffset -- the
  first's way back to pixels less the range }
function TTyAdvanceChart.BrushOutput(ABrush: Integer;
  const AAreas: TTyBrushAreaArray): TTyBrushAreaArray;
var
  tg: TTyBrushTargetArray;
  i, t, c, n: Integer;
  vals, xy, back, bxy: TTyBrushRange;
  v: TTyBrushView;
begin
  Result := Copy(AAreas);
  tg := BrushTargets(ABrush);
  v := BrushViewOf;
  for i := 0 to High(Result) do
  begin
    t := BrushFindTarget(tg, Result[i]);
    if t < 0 then Continue;
    for c := 0 to Max(High(tg[t].Carts), Ord(tg[t].Geo <> nil) - 1) do
    begin
      if not BrushConvertOn(tg[t], c, Result[i].Opt.BrushType, True, v,
        Result[i].Opt.Range, True, vals, xy) then Continue;
      Result[i].HasCoordRanges := True;
      n := Length(Result[i].CoordRanges);
      SetLength(Result[i].CoordRanges, n + 1);
      Result[i].CoordRanges[n] := vals;
      if not Result[i].HasCoordRange then
      begin
        Result[i].HasCoordRange := True;
        Result[i].CoordRange := vals;
        if BrushConvertOn(tg[t], c, Result[i].Opt.BrushType, False, v, vals,
          False, back, bxy) then
        begin
          Result[i].HasOffset := True;
          Result[i].Offset := TyBrushDiff(Result[i].Opt.BrushType, back,
            Result[i].Opt.Range, 1, 1);
          Result[i].OffsetXY := bxy;
        end;
      end;
    end;
  end;
end;

{ BrushView._onBrush: the areas in data too; the `brush` action unless it
  is a drag's end (a removeOnClick clearing is dispatched), then brushEnd
  at an end }
procedure TTyAdvanceChart.BrushOnTrigger(ABrush: Integer; const ATrig: TTyBrushTrigger);
var
  areas: TTyBrushAreaArray;
  id, js: string;
begin
  if not ATrig.Fired then Exit;
  if (ABrush < 0) or (ABrush > High(FBrushSpecs)) then Exit;
  areas := BrushOutput(ABrush, ATrig.Areas);
  if not ATrig.IsEnd or ATrig.RemoveOnClick then BrushApplyOwn(ABrush, areas);
  if ATrig.IsEnd then
  begin
    id := ComponentModelId('brush', ABrush);
    { update 'none': the event alone }
    js := '{"type":"brushend","brushId":' + TyBrushJsonStr(id) + ',"areas":'
      + TyBrushAreasJson(areas) + ',"$from":' + TyBrushJsonStr(id) + '}';
    BrushLogEvent('brushend', ABrush, True, areas, js);
    EmitPayloadEvent('brushend', js);
  end;
  BrushChanged;
end;

{ the `brush` action from a brush's own view: setAreas on it, the update
  (updateVisual: layoutCovers, every other view's covers), the event }
procedure TTyAdvanceChart.BrushApplyOwn(ABrush: Integer; const AAreas: TTyBrushAreaArray);
var
  i, b: Integer;
  id, js: string;
begin
  SetLength(FBrushAreas[ABrush], Length(AAreas));
  for i := 0 to High(AAreas) do
    FBrushAreas[ABrush][i] := TyBrushAreaOfOutput(FBrushSpecs[ABrush], AAreas[i]);
  Inc(FBrushActDepth);
  try
    if FBuild <> nil then
    begin
      for b := 0 to High(FBrushSpecs) do BrushLayout(b);
      for b := 0 to High(FBrushSpecs) do
        if b <> ABrush then BrushRender(b);
    end;
    { the visual stage: the selection, its visuals, brushSelect [Batch 127] }
    BrushSelectRun(True);
    id := ComponentModelId('brush', ABrush);
    js := '{"type":"brush","brushId":' + TyBrushJsonStr(id) + ',"areas":'
      + TyBrushAreasJson(AAreas) + ',"$from":' + TyBrushJsonStr(id) + '}';
    BrushLogEvent('brush', ABrush, True, AAreas, js);
    EmitPayloadEvent('brush', js);
  finally
    Dec(FBrushActDepth);
  end;
  if FBrushActDepth = 0 then BrushFlush;
  EmitUpdated;
end;

{ the brush components an action's payload names (brushIndex, else
  brushId, else brushName); none named: all of them }
function TTyAdvanceChart.BrushQuery(APayload: TJSONObject): TTyIntegerArray;
var
  d: TJSONData;
  i, k, n: Integer;
  s: string;
  hit: Boolean;

  procedure Add(AIndex: Integer);
  var q: Integer;
  begin
    if (AIndex < 0) or (AIndex > High(FBrushSpecs)) then Exit;
    for q := 0 to High(Result) do
      if Result[q] = AIndex then Exit;
    n := Length(Result);
    SetLength(Result, n + 1);
    Result[n] := AIndex;
  end;

  function Matches(AData: TJSONData; const AText: string): Boolean;
  var q: Integer;
  begin
    Result := False;
    if AData is TJSONArray then
    begin
      for q := 0 to AData.Count - 1 do
        if (AData.Items[q].JSONType = jtString) and (AData.Items[q].AsString = AText) then
          Exit(True);
    end
    else if AData.JSONType = jtString then Result := AData.AsString = AText
    else if AData.JSONType = jtNumber then Result := TyJsNumberToString(AData.AsFloat) = AText;
  end;

begin
  Result := nil;
  d := APayload.Find('brushIndex');
  if (d <> nil) and (d.JSONType <> jtNull) then
  begin
    if d is TJSONArray then
    begin
      for i := 0 to d.Count - 1 do
        if d.Items[i].JSONType = jtNumber then Add(Trunc(d.Items[i].AsFloat));
    end
    else if d.JSONType = jtNumber then Add(Trunc(d.AsFloat));
    Exit;
  end;
  d := APayload.Find('brushId');
  if (d = nil) or (d.JSONType = jtNull) then d := nil;
  if d <> nil then
  begin
    for k := 0 to High(FBrushSpecs) do
      if Matches(d, ComponentModelId('brush', k)) then Add(k);
    Exit;
  end;
  d := APayload.Find('brushName');
  if (d <> nil) and (d.JSONType <> jtNull) then
  begin
    for k := 0 to High(FBrushSpecs) do
    begin
      s := ComponentModelName('brush', k);
      hit := Matches(d, s);
      if hit then Add(k);
    end;
    Exit;
  end;
  for k := 0 to High(FBrushSpecs) do Add(k);
end;

{ the `brush` action from the API: setAreas on the components it names
  (areas absent: the areas stay), the update, the event with the payload }
procedure TTyAdvanceChart.BrushDoAction(APayload: TJSONObject);
var
  sel: TTyIntegerArray;
  node, fromN: TJSONData;
  parsed, logged: TTyBrushAreaArray;
  b, i, n: Integer;
  a: TTyBrushArea;
  hasFrom: Boolean;
  from, js: string;
begin
  BrushSync;
  sel := BrushQuery(APayload);
  node := APayload.Find('areas');
  logged := nil;
  if node is TJSONArray then
    for b := 0 to High(sel) do
    begin
      parsed := nil;
      for i := 0 to node.Count - 1 do
        if (node.Items[i] is TJSONObject)
          and TyBrushAreaOfJson(FBrushSpecs[sel[b]], TJSONObject(node.Items[i]), a) then
        begin
          n := Length(parsed);
          SetLength(parsed, n + 1);
          parsed[n] := a;
        end;
      FBrushAreas[sel[b]] := parsed;
      if b = 0 then logged := Copy(parsed);
    end;
  fromN := APayload.Find('$from');
  hasFrom := (fromN <> nil) and (fromN.JSONType = jtString);
  if hasFrom then from := fromN.AsString else from := '';
  if FBuild <> nil then
  begin
    for b := 0 to High(FBrushSpecs) do BrushLayout(b);
    { a view the action came from keeps its covers }
    for b := 0 to High(FBrushSpecs) do
      if not (hasFrom and (from = ComponentModelId('brush', b))) then BrushRender(b);
  end;
  { the visual stage: the selection, its visuals, brushSelect [Batch 127] }
  BrushSelectRun(True);
  js := TbEventJson(APayload, 'brush');
  BrushLogEvent('brush', -1, False, logged, js);
  EmitPayloadEvent('brush', js);
  BrushChanged;
end;

procedure TTyAdvanceChart.BrushDoEnd(APayload: TJSONObject);
var js: string;
begin
  js := TbEventJson(APayload, 'brushend');
  BrushLogEvent('brushend', -1, False, nil, js);
  EmitPayloadEvent('brushend', js);
end;

{ brushVisual's setBrushOption on takeGlobalCursor: the payload's
  brushOption for the key 'brush', brushType false for any other; then the
  update renders every view }
procedure TTyAdvanceChart.BrushTakeCursor(APayload: TJSONObject);
var
  d, bo: TJSONData;
  isBrush: Boolean;
  b: Integer;
  off: TTyBrushOpt;
begin
  BrushSync;
  if Length(FBrushSpecs) = 0 then Exit;
  d := APayload.Find('key');
  isBrush := (d <> nil) and (d.JSONType = jtString) and (d.AsString = 'brush');
  bo := APayload.Find('brushOption');
  for b := 0 to High(FBrushSpecs) do
  begin
    if isBrush then
    begin
      { no brushOption: upstream's generateBrushOption answers undefined
        and the update throws; the painting option stays }
      if not (bo is TJSONObject) then Continue;
      FBrushPaint[b] := TyBrushPaintOpt(FBrushSpecs[b], bo);
    end
    else
    begin
      off := TyBrushPaintOpt(FBrushSpecs[b], nil);
      off.BrushType := btNone;
      FBrushPaint[b] := off;
    end;
    FBrushHasPaint[b] := True;
  end;
  if FBuild <> nil then
  begin
    for b := 0 to High(FBrushSpecs) do BrushLayout(b);
    for b := 0 to High(FBrushSpecs) do BrushRender(b);
  end;
  { brushSelect: TbDoTakeCursor's, with or without a brush [Batch 127] }
end;

procedure TTyAdvanceChart.BrushLogEvent(const AType: string; ABrush: Integer;
  AFromSelf: Boolean; const AAreas: TTyBrushAreaArray; const APayload: string);
var n: Integer;
begin
  n := Length(FBrushEvLog);
  SetLength(FBrushEvLog, n + 1);
  FBrushEvLog[n].EventType := AType;
  FBrushEvLog[n].Brush := ABrush;
  FBrushEvLog[n].FromSelf := AFromSelf;
  FBrushEvLog[n].Areas := Copy(AAreas);
  FBrushEvLog[n].Payload := APayload;
end;

function TTyAdvanceChart.BrushClock: Double;
begin
  if IsNan(FBrushNow) then Result := GetTickCount64 else Result := FBrushNow;
end;

{ brushVisual's dispatch of brushSelect: through the throttle the first
  component asks for (createOrUpdate), with every component's areas. Not
  during a brushSelect of its own. }
procedure TTyAdvanceChart.BrushVisual(const ABatch: TTyBrushSelectBatch);
var
  batch: TTyBrushSelectBatch;
  n: Integer;
  now_, due: Double;
  execNow, thr: Boolean;
begin
  if FBrushInSelect then Exit;
  batch := ABatch;
  now_ := BrushClock;
  { only the first component's throttle; none without a brush (an empty
    batch, dispatched at once) [Batch 127] }
  if Length(FBrushSpecs) > 0 then
    thr := TyBrushThrottleConfigure(FBrushThr, FBrushSpecs[0].ThrottleKind,
      FBrushSpecs[0].ThrottleType, FBrushSpecs[0].ThrottleDelay)
  else
    thr := TyBrushThrottleConfigure(FBrushThr, btkNone, '', NaN);
  if not thr then
  begin
    BrushExecSelect(batch, now_);
    Exit;
  end;
  { the call's clearTimeout }
  BrushDropPending(FBrushThr.Timer);
  FBrushThr.Timer := 0;
  TyBrushThrottleCall(FBrushThr, now_, execNow, due);
  if execNow then
  begin
    FBrushThr.LastExec := now_;
    BrushExecSelect(batch, now_);
    Exit;
  end;
  Inc(FBrushPendSeq);
  n := Length(FBrushPend);
  SetLength(FBrushPend, n + 1);
  FBrushPend[n].Id := FBrushPendSeq;
  FBrushPend[n].Due := due;
  FBrushPend[n].Gen := FBrushThr.Gen;
  FBrushPend[n].Batch := batch;
  FBrushThr.Timer := FBrushPendSeq;
  BrushArmTimer;
end;

procedure TTyAdvanceChart.BrushExecSelect(const ABatch: TTyBrushSelectBatch; ATime: Double);
var n: Integer;
begin
  FBrushInSelect := True;
  try
    n := Length(FBrushSelLog);
    SetLength(FBrushSelLog, n + 1);
    FBrushSelLog[n].Time := ATime;
    FBrushSelLog[n].Batch := ABatch;
    { the brushSelect action: its brushselected event, after the event of
      the action whose update dispatched it [Batch 127] -- [F4b] inside an
      action, in the one queue of what that action dispatched, in order }
    if FBatchDefer > 0 then
    begin
      { a batch's items: the update runs once, so does its brushSelect --
        the last state's }
      FBatchBrushJson := BrushSelectedJson(ABatch);
      FBatchBrushHas := True;
    end
    else if FActCycle > 0 then
    begin
      n := Length(FActPending);
      SetLength(FActPending, n + 1);
      FActPending[n] := Default(TTyTipAct);
      FActPending[n].EventJson := BrushSelectedJson(ABatch);
      FBatchBrushQueued := True;
    end
    else
    begin
      n := Length(FBrushEmitQ);
      SetLength(FBrushEmitQ, n + 1);
      FBrushEmitQ[n] := BrushSelectedJson(ABatch);
    end;
  finally
    FBrushInSelect := False;
  end;
end;

procedure TTyAdvanceChart.BrushDropPending(AId: Integer);
var i, k: Integer;
begin
  if AId = 0 then Exit;
  for i := 0 to High(FBrushPend) do
    if FBrushPend[i].Id = AId then
    begin
      for k := i to High(FBrushPend) - 1 do FBrushPend[k] := FBrushPend[k + 1];
      SetLength(FBrushPend, Length(FBrushPend) - 1);
      Exit;
    end;
end;

procedure TTyAdvanceChart.BrushTick(ANow: Double);
var
  best, i, k: Integer;
  t: Double;
  p: TTyBrushPending;
begin
  repeat
    best := -1;
    for i := 0 to High(FBrushPend) do
      if (FBrushPend[i].Due <= ANow) and ((best < 0)
        or (FBrushPend[i].Due < FBrushPend[best].Due)
        or ((FBrushPend[i].Due = FBrushPend[best].Due) and (FBrushPend[i].Id < FBrushPend[best].Id))) then
        best := i;
    if best < 0 then Break;
    p := FBrushPend[best];
    for k := best to High(FBrushPend) - 1 do FBrushPend[k] := FBrushPend[k + 1];
    SetLength(FBrushPend, Length(FBrushPend) - 1);
    { the clock is the timer's due, unless it is behind the last tick }
    t := p.Due;
    if not IsNan(FBrushTickPrev) and (FBrushTickPrev > t) then t := FBrushTickPrev;
    if p.Gen = FBrushThr.Gen then
    begin
      FBrushThr.LastExec := t;
      FBrushThr.Timer := 0;
    end;
    BrushExecSelect(p.Batch, t);
  until False;
  FBrushTickPrev := ANow;
  BrushArmTimer;
  { a timer's brushSelect is an action of its own [Batch 127] }
  if FBrushActDepth = 0 then BrushFlush;
end;

procedure TTyAdvanceChart.BrushArmTimer;
var
  i: Integer;
  due: Double;
begin
  { a test drives the clock itself }
  if not IsNan(FBrushNow) then Exit;
  if Length(FBrushPend) = 0 then
  begin
    if FBrushTimer <> nil then FBrushTimer.Enabled := False;
    Exit;
  end;
  due := FBrushPend[0].Due;
  for i := 1 to High(FBrushPend) do due := Math.Min(due, FBrushPend[i].Due);
  if FBrushTimer = nil then
  begin
    FBrushTimer := TTimer.Create(nil);
    FBrushTimer.OnTimer := @BrushTimerFired;
  end;
  FBrushTimer.Enabled := False;
  FBrushTimer.Interval := Math.Max(1, Ceil(due - BrushClock));
  FBrushTimer.Enabled := True;
end;

procedure TTyAdvanceChart.BrushTimerFired(Sender: TObject);
begin
  FBrushTimer.Enabled := False;
  BrushTick(BrushClock);
end;

{ the topmost cover piece the pointer finds (device px): the brush views'
  groups in component order, the later over the earlier; nothing outside
  the canvas }
function TTyAdvanceChart.BrushPieceAt(AX, AY: Integer; out ABrush, AIndex: Integer;
  out APiece: TTyBrushPiece): Boolean;
var
  b: Integer;
  x, y, s: Double;
begin
  Result := False;
  ABrush := -1;
  AIndex := -1;
  APiece := bpMain;
  if (csDesigning in ComponentState)
    or ((Length(FBrushCtls) = 0) and (Length(FParBrushCtls) = 0)) then Exit;
  BrushCss(AX, AY, x, y);
  s := DzScale;
  if (x < 0) or (y < 0) or (x > (FLastRect.Right - FLastRect.Left) / s)
    or (y > (FLastRect.Bottom - FLastRect.Top) / s) then Exit;
  for b := High(FBrushCtls) downto 0 do
    if (FBrushCtls[b] <> nil) and FBrushCtls[b].PieceAt(x, y, AIndex, APiece) then
    begin
      ABrush := b;
      Exit(True);
    end;
  { the parallel axes' groups, under the brush views' [Batch 130] }
  for b := High(FParBrushCtls) downto 0 do
    if (FParBrushCtls[b] <> nil) and FParBrushCtls[b].PieceAt(x, y, AIndex, APiece) then
    begin
      ABrush := TyParallelBrushBase + b;
      Exit(True);
    end;
end;

{ zrender's Draggable takes a press on a piece (dragstart); the
  controllers' own mousedown still runs -- on a draggable target it only
  ends a track a lost release left }
function TTyAdvanceChart.BrushDragStart(AX, AY: Integer): Boolean;
var
  b, i: Integer;
  pc: TTyBrushPiece;
  x, y: Double;
begin
  Result := BrushPieceAt(AX, AY, b, i, pc);
  if not Result then Exit;
  BrushCss(AX, AY, x, y);
  FBrushDragOn := True;
  FBrushDragBrush := b;
  FBrushDragSerial := BrushCtlOf(b).Covers[i].Serial;
  FBrushDragPiece := pc;
  FBrushDragX := x;
  FBrushDragY := y;
  BrushCtlDown(AX, AY, True);
end;

procedure TTyAdvanceChart.BrushCtlDown(AX, AY: Integer; ADraggable: Boolean);
var
  b: Integer;
  x, y: Double;
begin
  BrushCss(AX, AY, x, y);
  for b := 0 to High(FBrushCtls) do
    if FBrushCtls[b] <> nil then
      BrushOnTrigger(b, FBrushCtls[b].MouseDown(x, y, ADraggable));
  { the parallel axes' controllers [Batch 130] }
  for b := 0 to High(FParBrushCtls) do
    if FParBrushCtls[b] <> nil then
      ParBrushOnTrigger(b, FParBrushCtls[b].MouseDown(x, y, ADraggable));
end;

procedure TTyAdvanceChart.BrushPointerMove(AX, AY: Integer);
var
  b: Integer;
  x, y: Double;
  t: TTyBrushTrigger;
begin
  if (Length(FBrushCtls) = 0) and (Length(FParBrushCtls) = 0) then Exit;
  BrushCss(AX, AY, x, y);
  { Draggable's drag: the delta from the last pointer event }
  if FBrushDragOn and (BrushCtlOf(FBrushDragBrush) <> nil) then
  begin
    t := BrushCtlOf(FBrushDragBrush).Drift(FBrushDragSerial, FBrushDragPiece,
      x - FBrushDragX, y - FBrushDragY);
    FBrushDragX := x;
    FBrushDragY := y;
    BrushTriggerTo(FBrushDragBrush, t);
    BrushChanged;
  end;
  for b := 0 to High(FBrushCtls) do
    if FBrushCtls[b] <> nil then
    begin
      t := FBrushCtls[b].MouseMove(x, y);
      if t.Fired then
      begin
        BrushOnTrigger(b, t);
        BrushChanged;
      end
      else if FBrushCtls[b].Dragging then BrushChanged;
    end;
  { the parallel axes' controllers [Batch 130] }
  for b := 0 to High(FParBrushCtls) do
    if FParBrushCtls[b] <> nil then
    begin
      t := FParBrushCtls[b].MouseMove(x, y);
      if t.Fired then ParBrushOnTrigger(b, t)
      else if FParBrushCtls[b].Dragging then BrushChanged;
    end;
end;

{ Draggable's dragend: the cover's ondragend triggers with isEnd }
procedure TTyAdvanceChart.BrushDragEnd;
var b: Integer;
begin
  if not FBrushDragOn then Exit;
  FBrushDragOn := False;
  b := FBrushDragBrush;
  if BrushCtlOf(b) = nil then Exit;
  BrushTriggerTo(b, BrushCtlOf(b).DragEnd(FBrushDragSerial));
end;

procedure TTyAdvanceChart.BrushCtlUp(AX, AY: Integer);
var
  b: Integer;
  x, y: Double;
  was: Boolean;
begin
  if (Length(FBrushCtls) = 0) and (Length(FParBrushCtls) = 0) then Exit;
  BrushCss(AX, AY, x, y);
  for b := 0 to High(FBrushCtls) do
    if FBrushCtls[b] <> nil then
    begin
      was := FBrushCtls[b].Dragging;
      BrushOnTrigger(b, FBrushCtls[b].MouseUp(x, y));
      if was then BrushChanged;
    end;
  { the parallel axes' controllers [Batch 130] }
  for b := 0 to High(FParBrushCtls) do
    if FParBrushCtls[b] <> nil then
    begin
      was := FParBrushCtls[b].Dragging;
      ParBrushOnTrigger(b, FParBrushCtls[b].MouseUp(x, y));
      if was then BrushChanged;
    end;
end;

function TTyAdvanceChart.BrushCrosshair(AX, AY: Integer): Boolean;
var
  b: Integer;
  x, y: Double;
begin
  Result := False;
  if (Length(FBrushCtls) = 0) and (Length(FParBrushCtls) = 0) then Exit;
  BrushCss(AX, AY, x, y);
  for b := 0 to High(FBrushCtls) do
    if (FBrushCtls[b] <> nil) and FBrushCtls[b].Crosshair(x, y) then Result := True;
  { the parallel axes' controllers [Batch 130] }
  for b := 0 to High(FParBrushCtls) do
    if (FParBrushCtls[b] <> nil) and FParBrushCtls[b].Crosshair(x, y) then Result := True;
end;

procedure TTyAdvanceChart.BrushChanged;
begin
  DropStatic;
  FZrDirty := True;
  inherited Invalidate;
end;

{ the covers: each brush view's group in component order, a group's covers
  in the order they were added; the main shape filled and stroked in the
  cover's style (the skin's where it wrote none), the handles invisible }
function TTyAdvanceChart.BuildBrushes(AList: TTyPaintList): Integer;
var
  b, q, i: Integer;
  ord_: TTyIntegerArray;
  ctl: TTyBrushController;
  cv: TTyBrushCover;
  el: TTyChartElement;
  v: TTyBrushView;
  pts: array of TTyPointF;
  st: TTyStyleSet;
  inkFill, inkStroke, c: TTyChartColor;
  lw: Double;
begin
  Result := 0;
  if Length(FBrushCtls) = 0 then Exit;
  v := BrushViewOf;
  st := ActiveController.Model.ResolveStyle('TyAdvChartBrush', '', []);
  inkFill := TTyChartColor(st.Background.Color);
  inkStroke := TTyChartColor(st.BorderColor);
  for b := 0 to High(FBrushCtls) do
  begin
    ctl := FBrushCtls[b];
    if ctl = nil then Continue;
    ord_ := ctl.GroupOrder;
    for q := 0 to High(ord_) do
    begin
      cv := ctl.Covers[ord_[q]];
      el := Default(TTyChartElement);
      el.Silent := True;
      el.Datum := TyChartDatum(-1, -1);
      el.Z := TyBrushCoverZ;
      el.Style.Alpha := 1;
      if cv.Opt.BrushType = btPolygon then
      begin
        if Length(cv.Points) < 2 then Continue;
        SetLength(pts, Length(cv.Points));
        for i := 0 to High(pts) do
          pts[i] := TyPointF(v.OX + cv.Points[i].X * v.S, v.OY + cv.Points[i].Y * v.S);
        if cv.Closed then el.Shape := TyShapePolygon(pts)
        else el.Shape := TyShapePolyline(pts);
      end
      else
      begin
        if IsNan(cv.Main.X) or IsNan(cv.Main.Y) or IsNan(cv.Main.W) or IsNan(cv.Main.H) then
          Continue;
        el.Shape := TyShapeRect(TyRectF(v.OX + cv.Main.X * v.S, v.OY + cv.Main.Y * v.S,
          v.OX + (cv.Main.X + cv.Main.W) * v.S, v.OY + (cv.Main.Y + cv.Main.H) * v.S));
      end;
      if not (cv.Opt.Style.Fill.Written and (cv.Opt.Style.Fill.Text = 'none')) then
      begin
        c := inkFill;
        if cv.Opt.Style.Fill.Written and not TyTryParseChartColor(cv.Opt.Style.Fill.Text, c) then
          c := inkFill;
        el.Style.HasFill := True;
        el.Style.FillColor := c;
      end;
      lw := cv.Opt.Style.LineWidth;
      if IsNan(lw) then lw := 1;
      if (lw > 0) and not (cv.Opt.Style.Stroke.Written and (cv.Opt.Style.Stroke.Text = 'none')) then
      begin
        c := inkStroke;
        if cv.Opt.Style.Stroke.Written and not TyTryParseChartColor(cv.Opt.Style.Stroke.Text, c) then
          c := inkStroke;
        el.Style.StrokeColor := c;
        el.Style.StrokeWidthLogical := lw;
      end;
      if not IsNan(cv.Opt.Style.Opacity) then
        el.Style.Alpha := Max(0, Min(1, cv.Opt.Style.Opacity));
      AList.Add(el);
      Inc(Result);
    end;
  end;
end;

{ ==================== the selection [Batch 127] ====================

  visualEncoding.ts's brushVisual, the overall visual stage, over the pure
  tyControls.AdvChart.Brush: every brush component in order -- its areas
  with their bounding rects, each series it controls (a brushSelector:
  scatter, effectScatter, bar, candlestick; seriesIndex; controlSeries: the
  area's target grid holds the series' cartesian, or the area is global)
  checked item by item against the item's layout, brushLink spreading a
  selection by data index -- and the inBrush / outOfBrush visuals written
  over the rows the visual stages before it left (FVisualRows, restored from
  FBrushVisBase first: the stage runs again from the same input). A later
  brush writes over an earlier one. An update with a payload (an action's,
  not a setOption's) then dispatches brushSelect through the throttle; its
  brushselected event waits for the action's own event (BrushFlush).

  THE globalPan MUTEX (interactionMutex.ts): one holder, the controller
  that enabled last; a disable releases it only when it holds it. While it
  is held no roam pans (MouseDown). onIrrelevantElement: the topmost
  element under the pointer, a silent one too, belongs to a series on
  another coordinate system above the panel's grid -- its zlevel, then its
  z, higher. }

procedure TTyAdvanceChart.BrushEnableCtl(ACtl: TTyBrushController; const AOpt: TTyBrushOpt;
  AAuto: Boolean);
var was: Boolean;
begin
  if ACtl = nil then Exit;
  was := ACtl.Enabled;
  if AAuto then ACtl.EnableAuto(AOpt) else ACtl.EnableBrush(AOpt);
  { _doDisableBrush releases globalPan when this one holds it, then
    _doEnableBrush takes it }
  if was and (FPanHolder = ACtl.Uid) then FPanHolder := 0;
  if ACtl.Enabled then FPanHolder := ACtl.Uid;
end;

procedure TTyAdvanceChart.BrushFreeCtl(var ACtl: TTyBrushController);
begin
  if ACtl = nil then Exit;
  { dispose: enableBrush(false) }
  if ACtl.Enabled and (FPanHolder = ACtl.Uid) then FPanHolder := 0;
  FreeAndNil(ACtl);
end;

function TTyAdvanceChart.PanTaken: Boolean;
begin
  Result := FPanHolder <> 0;
end;

function TTyAdvanceChart.BrushGlobalPanTaken: Boolean;
begin
  Result := PanTaken;
end;

function TTyAdvanceChart.BrushIrrelevant(const APanel: TTyBrushPanel; AX, AY: Double): Boolean;
var
  v: TTyBrushView;
  idx, slot, si, sz, szl: Integer;
  el: TTyChartElement;
  node, d: TJSONData;
  gz, gzl, diff: Double;
  hasCoord: Boolean;
begin
  Result := False;
  if (APanel.GridComponent < 0) or (FPaintList = nil) or not FPaintListValid then Exit;
  v := BrushViewOf;
  idx := FPaintList.TopElementAt(v.OX + AX * v.S, v.OY + AY * v.S, FPaintListPPI);
  if idx < 0 then Exit;
  el := FPaintList.Element(idx);
  { getComponentByElement: a series' element. A marker's, a legend's, the
    toolbox's, a brush cover -- nothing with a coordinate system -- is not
    irrelevant }
  if (el.Datum.Kind <> ctkSeries) or (el.Datum.SeriesIndex < 0) then Exit;
  si := el.Datum.SeriesIndex;
  slot := SlotOfSeries(si);
  if (slot < 0) or (slot > High(FBindings)) then Exit;
  { its coordinate system's model: the panel's own grid is relevant; a
    series with none (a pie, a funnel) is too }
  if FBindings[slot].Cart <> nil then
  begin
    if (FBindings[slot].XAxis <> nil)
      and (FBindings[slot].XAxis.GridIndex = APanel.GridComponent) then Exit;
    hasCoord := True;
  end
  else
    hasCoord := (FBindings[slot].Polar <> nil) or (FBindings[slot].CalendarIndex >= 0)
      or (FBindings[slot].SeriesType = TyGraphSeriesTypeName)
      or (FBindings[slot].SeriesType = TyTreeSeriesTypeName)
      or (FBindings[slot].SeriesType = 'radar');
  if not hasCoord then Exit;
  { retrieveZInfo: zlevel first, then z; equal is relevant }
  gz := 0;
  gzl := 0;
  node := FOption.ComponentAt('grid', APanel.GridComponent);
  if node is TJSONObject then
  begin
    d := TJSONObject(node).Find('z');
    if (d <> nil) and (d.JSONType = jtNumber) and not IsNan(d.AsFloat) then gz := d.AsFloat;
    d := TJSONObject(node).Find('zlevel');
    if (d <> nil) and (d.JSONType = jtNumber) and not IsNan(d.AsFloat) then gzl := d.AsFloat;
  end;
  if FBindings[slot].SeriesType = 'line' then sz := SeriesIntIn(si, 'z', 3)
  else sz := SeriesIntIn(si, 'z', 2);
  szl := SeriesIntIn(si, 'zlevel', 0);
  diff := szl - gzl;
  if diff = 0 then diff := sz - gz;
  Result := diff > 0;
end;

procedure TTyAdvanceChart.BrushVisCapture;
var i: Integer;
begin
  FBrushVisBase := nil;
  FBrushVisBaseOk := Length(FBrushSpecs) > 0;
  if not FBrushVisBaseOk then Exit;
  SetLength(FBrushVisBase, Length(FVisualRows));
  for i := 0 to High(FVisualRows) do FBrushVisBase[i] := Copy(FVisualRows[i]);
end;

function TTyAdvanceChart.BrushSelectCompute: TTyBrushSelectBatch;
var
  b, i, k, r, raw, n, si, t: Integer;
  reach: TTyBrushReach;
  vis: TTyBrushVisual;
  sel: TTyBrushSelAreaArray;
  tg: TTyBrushTargetArray;
  lays: array of TTyBrushItemLayoutArray;
  layDone: array of Boolean;
  lists: array of TTyIntegerArray;
  linkSel: array of Boolean;
  hasBrush, linked, inB, applies, ctrl: Boolean;
  v: TTyBrushView;
  sv: TTySeriesVisual;
  outColor, baseColor: TTyVisualColor;
  st: TTyDataStore;
  offKey: Integer;
  ov: TTyDataValue;
  item: TTyBrushSelSeries;

  function Live(ASlot: Integer): Boolean;
  begin
    Result := not FBindings[ASlot].Hidden;
  end;

  function HasSelector(ASlot: Integer): Boolean;
  var s: string;
  begin
    s := FBindings[ASlot].SeriesType;
    Result := (s = 'scatter') or (s = 'effectScatter') or (s = 'bar') or (s = 'candlestick');
  end;

  procedure EnsureLayout(ASlot: Integer);
  var q: Integer;
  begin
    if layDone[ASlot] then Exit;
    layDone[ASlot] := True;
    lays[ASlot] := nil;
    if (ASlot > High(FStores)) or (FStores[ASlot] = nil) then Exit;
    sv := TySeriesVisual(0);
    if ASlot <= High(FBarCols) then sv.Bar := FBarCols[ASlot];
    if ASlot <= High(FWhiskers) then sv.Whisker := FWhiskers[ASlot];
    sv.Large := LargeKindOf(ASlot);
    { a series on a geo: the points layout (dataToPoint, unclipped)
      [Batch 152] }
    if (FBindings[ASlot].GeoIndex >= 0) and (GeoOfSlot(ASlot) <> nil) then
      lays[ASlot] := GeoBrushLayouts(ASlot)
    else
      lays[ASlot] := TyBrushItemLayouts(FBindings[ASlot], FStores[ASlot], StackFor(ASlot), sv);
    { the cartesian's device px -> the brush's CSS px }
    for q := 0 to High(lays[ASlot]) do
    begin
      lays[ASlot][q].X := (lays[ASlot][q].X - v.OX) / v.S;
      lays[ASlot][q].Y := (lays[ASlot][q].Y - v.OY) / v.S;
      lays[ASlot][q].W := lays[ASlot][q].W / v.S;
      lays[ASlot][q].H := lays[ASlot][q].H / v.S;
    end;
  end;

  function CheckIn(ASlot, ARow: Integer): Boolean;
  var q: Integer;
  begin
    Result := False;
    if (ASlot > High(lays)) or (ARow > High(lays[ASlot])) then Exit;
    for q := 0 to High(lists[ASlot]) do
      if TyBrushSelects(sel[lists[ASlot][q]], lays[ASlot][ARow]) then Exit(True);
  end;

begin
  Result := nil;
  if Length(FBrushSpecs) = 0 then Exit;
  SetLength(Result, Length(FBrushSpecs));
  for b := 0 to High(FBrushSpecs) do
  begin
    Result[b].BrushIndex := b;
    Result[b].BrushId := ComponentModelId('brush', b);
    Result[b].BrushName := ComponentModelName('brush', b);
    if b <= High(FBrushAreas) then Result[b].Areas := Copy(FBrushAreas[b]);
  end;
  if (FBuild = nil) or (FOption = nil) then Exit;
  { the stage runs again from the rows the stages before it left }
  if FBrushVisBaseOk then
  begin
    SetLength(FVisualRows, Length(FBrushVisBase));
    for i := 0 to High(FBrushVisBase) do FVisualRows[i] := Copy(FBrushVisBase[i]);
  end;
  v := BrushViewOf;
  SetLength(lays, Length(FBindings));
  SetLength(layDone, Length(FBindings));
  for i := 0 to High(layDone) do layDone[i] := False;
  outColor := TyVisualFromChart(TTyChartColor(
    ActiveController.Model.ResolveStyle('TyAdvChartBrushOut', '', []).TextColor));
  offKey := TyOverrideKey('visualMap');
  for b := 0 to High(FBrushSpecs) do
  begin
    reach := TyBrushReachOf(FOption.ComponentAt('brush', b));
    vis := TyBrushVisualOf(FOption.ComponentAt('brush', b));
    SetLength(sel, Length(Result[b].Areas));
    for k := 0 to High(sel) do sel[k] := TyBrushSelAreaOf(Result[b].Areas[k]);
    tg := BrushTargets(b);
    lists := nil;
    SetLength(lists, Length(FBindings));
    linkSel := nil;
    hasBrush := False;
    { step A: each series' areas, and the data indices a linked one selects }
    for i := 0 to High(FBindings) do
    begin
      if not Live(i) or not HasSelector(i) then Continue;
      if not TyBrushControls(reach, FBindings[i].SeriesIndex) then Continue;
      for k := 0 to High(sel) do
      begin
        { controlSeries: a global area, or the target's cartesians hold the
          series' }
        t := BrushFindTarget(tg, Result[b].Areas[k]);
        ctrl := t < 0;
        if not ctrl then
          for r := 0 to High(tg[t].Carts) do
            if tg[t].Carts[r] = FBindings[i].Cart then ctrl := True;
        { a series on the target's geo [Batch 152] }
        if not ctrl and (tg[t].Geo <> nil) and (GeoOfSlot(i) = tg[t].Geo) then ctrl := True;
        if ctrl then
        begin
          n := Length(lists[i]);
          SetLength(lists[i], n + 1);
          lists[i][n] := k;
        end;
        hasBrush := hasBrush or (Length(lists[i]) > 0);
      end;
      if TyBrushLinks(reach, FBindings[i].SeriesIndex) and (Length(lists[i]) > 0)
        and (i <= High(FStores)) and (FStores[i] <> nil) then
      begin
        EnsureLayout(i);
        if Length(linkSel) < FStores[i].Count then
        begin
          n := Length(linkSel);
          SetLength(linkSel, FStores[i].Count);
          for r := n to High(linkSel) do linkSel[r] := False;
        end;
        for r := 0 to FStores[i].Count - 1 do
          if CheckIn(i, r) then linkSel[r] := True;
      end;
    end;
    { step B: every series in the batch; the visuals where the brush applies }
    for i := 0 to High(FBindings) do
    begin
      if not Live(i) then Continue;
      si := FBindings[i].SeriesIndex;
      item := Default(TTyBrushSelSeries);
      item.SeriesIndex := si;
      item.SeriesId := ComponentModelId('series', si);
      item.SeriesName := SeriesModelName(si);
      st := nil;
      if i <= High(FStores) then st := FStores[i];
      if st <> nil then
      begin
        linked := TyBrushLinks(reach, si);
        if linked then applies := hasBrush else applies := Length(lists[i]) > 0;
        if not linked and (Length(lists[i]) > 0) then EnsureLayout(i);
        if applies then
        begin
          if Length(FVisualRows) < Length(FBindings) then
          begin
            SetLength(FVisualRows, Length(FBindings));
            SetLength(FVisualMetas, Length(FBindings));
            SetLength(FVisualLines, Length(FBindings));
          end;
          if FVisualRows[i] = nil then
          begin
            baseColor := TyVisualFromChart(TTyChartColor(SeriesColor(si)));
            SetLength(FVisualRows[i], st.RawCount);
            for r := 0 to High(FVisualRows[i]) do
            begin
              FVisualRows[i][r] := Default(TTyVisualRow);
              FVisualRows[i][r].Color := baseColor;
              FVisualRows[i][r].Opacity := NaN;
            end;
          end;
        end;
        for r := 0 to st.Count - 1 do
        begin
          raw := st.GetRawIndex(r);
          if linked then inB := (r <= High(linkSel)) and linkSel[r]
          else inB := CheckIn(i, r);
          if inB then
          begin
            n := Length(item.DataIndex);
            SetLength(item.DataIndex, n + 1);
            item.DataIndex[n] := raw;
          end;
          if not applies or (raw < 0) or (raw > High(FVisualRows[i])) then Continue;
          { `visualMap: false` on the item opts it out }
          if st.HasOverrideByRaw(raw, offKey) then
          begin
            ov := st.GetOverrideByRaw(raw, offKey);
            if (ov.Kind = dvkBool) and (ov.Num = 0) then Continue;
          end;
          TyBrushApplyVisual(vis.States[inB], vis.OutIsSkin and not inB, outColor,
            FVisualRows[i][raw]);
        end;
      end;
      n := Length(Result[b].Selected);
      SetLength(Result[b].Selected, n + 1);
      Result[b].Selected[n] := item;
    end;
  end;
end;

procedure TTyAdvanceChart.BrushSelectRun(ADispatch: Boolean; ARepaint: Boolean);
var batch: TTyBrushSelectBatch;
begin
  if ADispatch then FBrushPayload := False;
  batch := BrushSelectCompute;
  { the series' visuals changed: the list again (inside a layout it is
    built next anyway) }
  if ARepaint and (Length(FBrushSpecs) > 0) then BrushChanged;
  if ADispatch then BrushVisual(batch);
end;

procedure TTyAdvanceChart.BrushFlush;
var
  q: TTyStringArray;
  i: Integer;
begin
  while Length(FBrushEmitQ) > 0 do
  begin
    q := FBrushEmitQ;
    FBrushEmitQ := nil;
    for i := 0 to High(q) do EmitPayloadEvent('brushselected', q[i]);
  end;
end;

{ the brushSelect action's event: the batch, each item as the action
  handled it (its type the event's, its batch null) }
function TTyAdvanceChart.BrushSelectedJson(const ABatch: TTyBrushSelectBatch): string;
var
  b, s, k: Integer;
  st: TTyStyleSet;
  defFill, defStroke: string;
begin
  { the model's areas whole: the brush's default colours are the skin's
    [milestone D5-D8] }
  st := ActiveController.Model.ResolveStyle('TyAdvChartBrush', '', []);
  defFill := TyBrushColorText(Cardinal(st.Background.Color));
  defStroke := TyBrushColorText(Cardinal(st.BorderColor));
  Result := '{"type":"brushselected","batch":[';
  for b := 0 to High(ABatch) do
  begin
    if b > 0 then Result := Result + ',';
    Result := Result + '{"brushId":' + TyBrushJsonStr(ABatch[b].BrushId)
      + ',"brushIndex":' + IntToStr(ABatch[b].BrushIndex)
      + ',"brushName":' + TyBrushJsonStr(ABatch[b].BrushName)
      + ',"areas":' + TyBrushModelAreasJson(ABatch[b].Areas, defFill, defStroke) + ',"selected":[';
    for s := 0 to High(ABatch[b].Selected) do
    begin
      if s > 0 then Result := Result + ',';
      Result := Result + '{"seriesId":' + TyBrushJsonStr(ABatch[b].Selected[s].SeriesId)
        + ',"seriesIndex":' + IntToStr(ABatch[b].Selected[s].SeriesIndex)
        + ',"seriesName":' + TyBrushJsonStr(ABatch[b].Selected[s].SeriesName)
        + ',"dataIndex":[';
      for k := 0 to High(ABatch[b].Selected[s].DataIndex) do
      begin
        if k > 0 then Result := Result + ',';
        Result := Result + IntToStr(ABatch[b].Selected[s].DataIndex[k]);
      end;
      Result := Result + ']}';
    end;
    Result := Result + '],"type":"brushselected","batch":null}';
  end;
  Result := Result + ']}';
end;

{ axisAreaSelect: the queried parallelAxis models take the intervals and
  the chart updates (parallelVisual's opacities) [Batch 128]; the update's
  visual stage (brushSelect), the toolbox's render and the event }
procedure TTyAdvanceChart.BrushDoAxisAreaSelect(APayload: TJSONObject);
var
  hit: Boolean;
  first: Integer;
begin
  { THE AXES THE QUERY NAMES take the intervals, and the update renders
    them (parallelVisual's opacities) [Batch 128] -- every parallelAxis
    view but the first the query finds (fromAxisAreaSelect), which keeps
    the covers it has [Batch 130] }
  hit := ParallelAreaSelect(APayload, first);
  FParBrushSkip := first;
  if hit or (Length(FParallels) > 0) then
  begin
    FParBrushInAas := True;
    try
      FullUpdate;
    finally
      FParBrushInAas := False;
    end;
  end;
  BrushSync;
  BrushSelectRun(True);
  TbBrushSnap;
  FDirty := True;
  Invalidate;
  EmitPayloadEvent('axisareaselected', TbEventJson(APayload, 'axisareaselected'));
end;

{ ---- the toolbox's brush feature (feature/Brush.ts) ---- }

{ what BrushFeature.render reads off the brush models: the last one's
  brushType and brushOption.brushMode (|| 'single'), and whether any keeps
  an area }
procedure TTyAdvanceChart.TbBrushModelState(out AHas, AMulti, ABrushed: Boolean;
  out AType: TTyBrushType);
var b: Integer;
begin
  AHas := False;
  AMulti := False;
  ABrushed := False;
  AType := btNone;
  for b := 0 to High(FBrushSpecs) do
  begin
    AHas := (b <= High(FBrushHasPaint)) and FBrushHasPaint[b];
    if AHas then
    begin
      AType := FBrushPaint[b].BrushType;
      AMulti := FBrushPaint[b].Multiple;
    end
    else
    begin
      AType := btNone;
      AMulti := False;
    end;
    if (b <= High(FBrushAreas)) and (Length(FBrushAreas[b]) > 0) then ABrushed := True;
  end;
end;

{ an update the port renders later: the feature renders with what the
  models hold now }
procedure TTyAdvanceChart.TbBrushSnap;
begin
  TbBrushModelState(FTbBfSnapHas, FTbBfSnapMulti, FTbBfSnapBrushed, FTbBfSnapType);
  FTbBfSnap := True;
end;

{ BrushFeature.render: every listed type's status -- keep by the mode,
  clear by any area, a type by the brush type -- and the type and mode its
  clicks read }
procedure TTyAdvanceChart.TbBrushRender(ATb: Integer);
var
  fm: TJSONObject;
  d: TJSONData;
  k: Integer;
  has, multi, brushed, on_: Boolean;
  typ: TTyBrushType;
  nm: string;
begin
  if FTbBfSnap then
  begin
    has := FTbBfSnapHas;
    multi := FTbBfSnapMulti;
    brushed := FTbBfSnapBrushed;
    typ := FTbBfSnapType;
  end
  else
    TbBrushModelState(has, multi, brushed, typ);
  FTbBfHas := has;
  FTbBfMulti := multi;
  FTbBfType := typ;
  fm := TyToolboxFeatureModel(FOption, ATb, 'brush', TbTitles);
  if fm = nil then Exit;
  try
    d := fm.Find('type');
    if not (d is TJSONArray) then Exit;
    for k := 0 to d.Count - 1 do
    begin
      if d.Items[k].JSONType <> jtString then Continue;
      nm := d.Items[k].AsString;
      if nm = 'keep' then on_ := multi
      else if nm = 'clear' then on_ := brushed
      else on_ := has and (typ <> btNone) and (TyBrushTypeName(typ) = nm);
      if on_ then TbSetStatus(ATb, 'brush', nm, 'emphasis')
      else TbSetStatus(ATb, 'brush', nm, 'normal');
    end;
  finally
    fm.Free;
  end;
end;

{ BrushFeature.onclick: clear dispatches axisAreaSelect, then the brush
  action with no areas; any other takes the global cursor -- keep flips the
  mode and keeps the type, a type flips itself on or off }
procedure TTyAdvanceChart.TbBrushClick(const AIcon: string);
var bt, bm: string;
begin
  if AIcon = 'clear' then
  begin
    DispatchAction('{"type":"axisAreaSelect","intervals":[]}');
    DispatchAction('{"type":"brush","command":"clear","areas":[]}');
    Exit;
  end;
  if AIcon = 'keep' then
  begin
    if FTbBfHas and (FTbBfType <> btNone) then bt := '"' + TyBrushTypeName(FTbBfType) + '"'
    else if FTbBfHas then bt := 'false'
    else bt := 'null';
    if FTbBfMulti then bm := 'single' else bm := 'multiple';
  end
  else
  begin
    if FTbBfHas and (FTbBfType <> btNone) and (TyBrushTypeName(FTbBfType) = AIcon) then
      bt := 'false'
    else
      bt := TyBrushJsonStr(AIcon);
    if FTbBfMulti then bm := 'multiple' else bm := 'single';
  end;
  DispatchAction('{"type":"takeGlobalCursor","key":"brush","brushOption":{"brushType":'
    + bt + ',"brushMode":"' + bm + '"}}');
end;

