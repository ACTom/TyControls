  { the keyboard and the accessible tree [Batch 144] }
  FKbSeries := -1;
  FKbRow := -1;
  FAccGen := -1;
  FAccLink := TTyAccessibleLink.Create(Self);
  AccessibleRole := larChart;
  AccessibleName := rsTyChartTypeChart;
  FRoamSeries := -1;
  FRoamGeo := -1;
  FGraphDragSlot := -1;
  FSankeyDragSlot := -1;
  FCrumbPressSeries := -1;
  FTmCrumbHoverS := -1;
  FTmCrumbHoverK := -1;
  FDzFrom := -1;
  FDzPanGrid := -1;
  FDzNow := NaN;
  FAnimNow := NaN;
  FAnimMode := camAuto;
