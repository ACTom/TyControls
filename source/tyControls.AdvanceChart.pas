  begin
    Result := (AX >= AR.Left) and (AX <= AR.Right) and (AY >= AR.Top)
      and (AY <= AR.Bottom);
  end;

  function Boxed(AXa, AYa, AW, AH: Double; AAH: TTyTextAnchorH;
    AAV: TTyTextAnchorV): TTyRectF;
  var l, t: Double;
  begin
    case AAH of
      tahLeft: l := AXa;
      tahRight: l := AXa - AW;
    else
      l := AXa - AW / 2;
    end;
    case AAV of
      tavTop: t := AYa;
      tavBottom: t := AYa - AH;
    else
      t := AYa - AH / 2;
    end;
    Result := TyRectF(l, t, l + AW, t + AH);
  end;

begin
  ADatum := TyChartNoDatum;
  Result := False;
  if (FBuild = nil) or (FOption = nil) then Exit;
  meas := nil;
  { the same boxes the chart's mouse events find (EventTargetAt) }
  for g := 0 to FBuild.GridCount - 1 do
  begin
    gb := FBuild.Grid(g);
    for a := 0 to gb.XAxisCount + gb.YAxisCount - 1 do
    begin
      if a < gb.XAxisCount then axObj := gb.XAxis(a)
      else axObj := gb.YAxis(a - gb.XAxisCount);
      if axObj = nil then Continue;
      mainT := axObj.MainType;
      if mainT = '' then mainT := axObj.Dim + 'Axis';
      if AxisTextSilent(FOption.ComponentAt(mainT, axObj.ComponentIndex),
        FOption.Root) then Continue;
      spec := gb.SpecFor(axObj);
      if spec = nil then Continue;
      AxisTextStyles(spec, lblS, nameS);
      if spec^.NamePlacement.Shown then
      begin
        r := TyRectF(spec^.NamePlacement.Rect.X, spec^.NamePlacement.Rect.Y,
          spec^.NamePlacement.Rect.X + spec^.NamePlacement.Rect.W,
          spec^.NamePlacement.Rect.Y + spec^.NamePlacement.Rect.H);
        if Inside(r) then
        begin
          ADatum.Kind := ctkAxisText;
          ADatum.ComponentIndex := g * 1000 + a;
          ADatum.DataIndex := -1;
          Exit(True);
        end;
      end;
      for q := 0 to High(spec^.Placements) do
      begin
        if not spec^.Placements[q].Shown then Continue;
        if Length(spec^.Placements[q].Rt) > 0 then
          r := TyRtDeviceBox(spec^.Placements[q].Rt, spec^.Placements[q].X,
            spec^.Placements[q].Y, spec^.RotationRad, spec^.RtScale)
        else
        begin
          if meas = nil then meas := NewTextMeasurer(FPaintListPPI);
          fw := 0;
          fh := 0;
          if meas <> nil then
            meas.MeasureLine(spec^.Placements[q].Text, lblS.FontName,
              ResolveFontSize(lblS), lblS.FontWeight, fw, fh);
          r := Boxed(spec^.Placements[q].X, spec^.Placements[q].Y, fw, fh,
            spec^.Placements[q].AnchorH, spec^.Placements[q].AnchorV);
        end;
        if not Inside(r) then Continue;
        ADatum.Kind := ctkAxisText;
        ADatum.ComponentIndex := g * 1000 + a;
        ADatum.DataIndex := q;
        Exit(True);
      end;
    end;
  end;
end;

{ the axis of the datum: its main type and index, the text (the name, or
  the label as drawn -- the formattedLabel) and the label's rawLabel
  (scale.getLabel of its tick) }
function TTyAdvanceChart.AxisTextOf(const ADatum: TTyChartDatumRef; out AMainType,
  AName, AValue: string; out AIndex: Integer): Boolean;
var
  g, a: Integer;
  gb: TTyGridBuild;
  axObj: TTyAxis;
  spec: PTyAxisLayoutSpec;
begin
  Result := False;
  AMainType := '';
  AName := '';
  AValue := '';
  AIndex := -1;
  if not IsAxisTextDatum(ADatum) then Exit;
  g := ADatum.ComponentIndex div 1000;
  a := ADatum.ComponentIndex mod 1000;
  if g >= FBuild.GridCount then Exit;
  gb := FBuild.Grid(g);
  if a >= gb.XAxisCount + gb.YAxisCount then Exit;
  if a < gb.XAxisCount then axObj := gb.XAxis(a)
  else axObj := gb.YAxis(a - gb.XAxisCount);
  if axObj = nil then Exit;
  spec := gb.SpecFor(axObj);
  if spec = nil then Exit;
  AMainType := axObj.MainType;
  if AMainType = '' then AMainType := axObj.Dim + 'Axis';
  AIndex := axObj.ComponentIndex;
  if ADatum.DataIndex < 0 then
  begin
    if not spec^.NamePlacement.Shown then Exit;
    AName := spec^.NamePlacement.Text;
  end
  else
  begin
    if ADatum.DataIndex > High(spec^.Placements) then Exit;
    AName := spec^.Placements[ADatum.DataIndex].Text;
    if (axObj.Scale is TTyOrdinalScale) and (ADatum.DataIndex <= High(spec^.TickValues)) then
      AValue := TTyOrdinalScale(axObj.Scale).GetLabel(spec^.TickValues[ADatum.DataIndex])
    else
      AValue := AName;
  end;
  Result := True;
end;

function TTyAdvanceChart.AxisTipSpec(const ADatum: TTyChartDatumRef): TTyTooltipSpec;
var
  mainT, nm, v: string;
  idx: Integer;
  node, tip: TJSONData;
begin
  if not AxisTextOf(ADatum, mainT, nm, v, idx) then
    Exit(TyTooltipSpecOf(FOption, -1, -1));
  Result := TyTooltipSpecOfItem(FOption, mainT, idx, nil, nm);
  { the axis' defaults: `tooltip: {show: false}` under what it writes -- a
    show it does not write is false, before the global's is asked (a null
    one is no value, and the global's stands) }
  node := FOption.ComponentAt(mainT, idx);
  tip := nil;
  if node is TJSONObject then tip := TJSONObject(node).Find('tooltip');
  if not ((tip is TJSONObject) and (TJSONObject(tip).IndexOfName('show') >= 0)) then
    Result.Show := False;
end;

{ setTooltipConfig's formatterParams: componentType, name, <mainType>Index;
  a label's value (rawLabel) and tickIndex besides }
function TTyAdvanceChart.AxisTipParams(const ADatum: TTyChartDatumRef): TTyChartCallbackParams;
var
  mainT, nm, v: string;
  idx: Integer;
begin
  Result := TyChartBlankParams;
  if not AxisTextOf(ADatum, mainT, nm, v, idx) then Exit;
  Result.ComponentType := mainT;
  Result.ComponentIndex := idx;
  Result.AxisIndex := idx;
  Result.Name := nm;
  if ADatum.DataIndex >= 0 then
  begin
    Result.ValueText := v;
    Result.TickIndex := ADatum.DataIndex;
    Result.TargetType := 'axisLabel';
  end
  else
    Result.TargetType := 'axisName';
end;

{ the formatter through formatTpl with the item's $vars -- the name's
  ['name'], a label's ['name', 'isTruncated', 'value', 'tickIndex'],
  HTML-encoded -- else the content (the text) }
function TTyAdvanceChart.AxisTipText(const ADatum: TTyChartDatumRef;
  const ASpec: TTyTooltipSpec): string;
var
  mainT, nm, v, tpl: string;
  idx: Integer;
  params: TTyChartParams;
begin
  Result := '';
  if not AxisTextOf(ADatum, mainT, nm, v, idx) then Exit;
  if not ASpec.HasFormatter then Exit(nm);
  if TyChartIsHandlerRef(ASpec.Formatter) then
  begin
    SetLength(params, 1);
    params[0] := AxisTipParams(ADatum);
    TyChartResolveText(ASpec.Formatter, params, Result);
    Exit;
  end;
  tpl := TyJsReplaceFirst(ASpec.Formatter, '{a}', '{a0}');
  if ADatum.DataIndex >= 0 then
  begin
    tpl := TyJsReplaceFirst(tpl, '{b}', '{b0}');
    tpl := TyJsReplaceFirst(tpl, '{c}', '{c0}');
    tpl := TyJsReplaceFirst(tpl, '{d}', '{d0}');
  end;
  tpl := TyJsReplaceFirst(tpl, '{a0}', GeoEncodeHtml(nm));
  if ADatum.DataIndex >= 0 then
  begin
    { isTruncated is a function upstream: its text is not modelled -- the
      port's labels are never truncated, so `false` }
    tpl := TyJsReplaceFirst(tpl, '{b0}', 'false');
    tpl := TyJsReplaceFirst(tpl, '{c0}', GeoEncodeHtml(v));
    tpl := TyJsReplaceFirst(tpl, '{d0}', IntToStr(ADatum.DataIndex));
  end;
  Result := tpl;
end;

procedure TTyAdvanceChart.MouseDown(Button: TMouseButton; Shift: TShiftState;
  X, Y: Integer);
var
  d: TTyChartDatumRef;
  el, slot, k: Integer;
begin
  TbFrame;
  FPressEl := -1;
  inherited MouseDown(Button, Shift, X, Y);
  if csDesigning in ComponentState then Exit;
  EventDown(Button, X, Y);
  { ParallelView's zrender mousedown, whatever the button: the press a
    click trigger judges the release against [Batch 140] }
  ParExpDown(X, Y);
  { A MIDDLE OR RIGHT PRESS NEITHER ARMS NOR DISARMS. }
  if Button <> mbLeft then Exit;
  FRoamSeries := -1;
  FRoamGeo := -1;
  { THE THUMBNAIL'S RoamController, the first roam listener (z 10): a press
    in its content rect arms it; the graph's own controller arms beside it,
    and the thumbnail consumes the moves [Batch 140] }
  ThumbDown(X, Y);
  { THE PRESS A CLICK IS JUDGED AGAINST, before anything else claims it }
  FPressDatum := HitTestAt(X, Y, el);
  { zrender's _downEl [Batch 153] }
  FPressEl := el;
  FPressCaption := (el >= 0) and (FPaintList <> nil)
    and (FPaintList.Element(el).Caption.FontSizeLogical > 0);
  FPressX := X;
  FPressY := Y;
  FPressArmed := True;
  FGraphDragSlot := -1;
  FSankeyDragSlot := -1;
  { A BREADCRUMB ITEM is over everything: its own click [Batch 115] }
  FCrumbPressed := CrumbAt(X, Y, FCrumbPressSeries, FCrumbPressIndex);
  FCrumbPressX := X;
  FCrumbPressY := Y;
  { A PRESS ON A BRUSH COVER'S PIECE is zrender's Draggable's: the cover
    moves or resizes, and nothing under it hears the press [Batch 126] }
  if BrushDragStart(X, Y) then Exit;
  { A PRESS ON A visualMap's thumb, handle label or in-range bar is zrender's
    Draggable's: no node drag, no pan under it [Batch 116] }
  if VmDragStart(X, Y) then Exit;
  { A PRESS ON A DRAGGABLE NODE IS THE NODE'S, not the view's: zrender's
    Draggable takes it (dragstart), and the RoamController walks up from the
    target and finds `draggable` -- a node's label is its node's. }
  d := HitTestAt(X, Y, el);
  if (d.SeriesIndex >= 0) and not d.IsEdge then
  begin
    slot := SlotOfSeries(d.SeriesIndex);
    if (slot >= 0) and (slot <= High(FGraphNodes))
      and (slot <= High(FGraphLaidOut)) and FGraphLaidOut[slot] then
      for k := 0 to High(FGraphNodes[slot]) do
        if (FGraphNodes[slot][k].Row = d.DataIndex)
          and FGraphNodes[slot][k].Draggable then
        begin
          { a graph on a view, and [F3b] one off a view (cartesian2d, a
            calendar, a matrix, a geo): Draggable drifts the symbol on the
            canvas there }
          if slot <= High(FGraphs) then
          begin
            FGraphDragSlot := slot;
            FGraphDragNode := k;
            FGraphDragX := X;
            FGraphDragY := Y;
            FGraphDragFirst := True;
          end;
          Exit;
        end;
    { a sankey's node, `draggable` along item -> level -> series (default
      true) [Batch 114] }
    if SankeyDragStart(slot, d.DataIndex, X, Y) then Exit;
  end;
  { A PRESS ON A dataZoom (a handle, the move bar, the slider body, a
    zooming grid) is the dataZoom's }
  DataZoomPointer(dpDown, X, Y, Shift, 0);
  { THE BRUSH COMPONENTS' controllers: a press in a panel starts a track,
    not on a draggable element (a slider's handle) [Batch 126] }
  BrushCtlDown(X, Y, FDzDrag.Kind <> dtkNone);
  { THE TOOLBOX'S SELECT BRUSH, a BrushController [Batch 127] }
  TbCtlDown(X, Y, FDzDrag.Kind <> dtkNone);
  { globalPan HELD -- by the toolbox's brush while the zoom is on, by a
    brush component's controller while it draws [Batch 127]: no roam pans
    under it, the inside dataZoom's nor a graph's [Batch 125] }
  if PanTaken then
  begin
    FDzPanGrid := -1;
    Exit;
  end;
  if (FDzDrag.Kind = dtkSlider) or (FDzPanGrid >= 0)
    or ((FDzDownTarget.Kind = dtkSlider) and (FDzDownTarget.Role = dzrClickPanel)) then Exit;
  { the graphs' and [Batch 150] the geos' RoamControllers: the first that
    holds the press arms }
  FRoamSeries := RoamTargetAt(X, Y, False, FRoamGeo);
  FRoamX := X;
  FRoamY := Y;
end;

procedure TTyAdvanceChart.MouseUp(Button: TMouseButton; Shift: TShiftState;
  X, Y: Integer);
var
  d: TTyChartDatumRef;
  el, slot: Integer;
  cap, zrClick: Boolean;
  n: TJSONData;
begin
  TbFrame;
  zrClick := False;
  d := TyChartNoDatum;
  el := -1;
  if Button = mbLeft then
  begin
    FRoamSeries := -1;
    FRoamGeo := -1;
    { dragend [Batch 114] }
    GraphDragEnd;
    FSankeyDragSlot := -1;
    { the target under the release, before anything moves }
    d := HitTestAt(X, Y, el);
    cap := (el >= 0) and (FPaintList <> nil)
      and (FPaintList.Element(el).Caption.FontSizeLogical > 0);
    { zrender's click: pressed and released on the same element, within
      4 px [Batch 153] -- nothing under both is the same too (_downEl ===
      _upEl, both null): the click still reaches the listeners [F4b] }
    zrClick := FPressArmed and (el = FPressEl)
      and (Sqrt(Sqr(X - FPressX) + Sqr(Y - FPressY)) <= 4);
    { zrender's Draggable ends first: a dragged cover's dragend [Batch 126] }
    BrushDragEnd;
    { zrender's mouseup, then the DOM click at the same point }
    DataZoomPointer(dpUp, X, Y, Shift, 0);
    { the brush ends on zrender's mouseup [Batch 125] }
    TbCtlUp(X, Y);
    { and the brush components' controllers [Batch 126] }
    BrushCtlUp(X, Y);
    { the thumbnail's controller lets go; ParallelView's mouseup, after
      the axes' controllers (their views render before it) [Batch 140] }
    FThumbDrag := -1;
    ParExpUp(X, Y);
    DataZoomPointer(dpClick, X, Y, Shift, 0);
    { [F6a] the RoamControllers' mouseup: the pan's cursor given back }
    if not (csDesigning in ComponentState) then CursorAfterUp(X, Y);
    { A CLICK: pressed and released on the same thing -- the same datum, a
      node's disc and its label being different things -- within 4 px. On a
      tree node whose series says `expandAndCollapse: true`, it toggles.
      [Batch 81] }
    if FPressArmed and (d.SeriesIndex >= 0) and not d.IsEdge
      and (d.SeriesIndex = FPressDatum.SeriesIndex)
      and (d.DataIndex = FPressDatum.DataIndex) and not FPressDatum.IsEdge
      and (cap = FPressCaption)
      and (Sqrt(Sqr(X - FPressX) + Sqr(Y - FPressY)) <= 4) then
    begin
      slot := SlotOfSeries(d.SeriesIndex);
      { [Batch 115] a sunburst's piece or return circle; a treemap's
        container -- the target found under the point -- unless the press
        was the breadcrumb's; never outside the canvas (zrender's
        isOutsideBoundary hovers nothing there) }
      if (X < FLastRect.Left) or (X > FLastRect.Right) or (Y < FLastRect.Top)
        or (Y > FLastRect.Bottom) then
      else if (slot >= 0) and (FBindings[slot].SeriesType = TySunburstSeriesTypeName) then
        SunburstClick(d.SeriesIndex, d.DataIndex)
      else if (slot >= 0) and (FBindings[slot].SeriesType = TyTreemapSeriesTypeName)
        and not FCrumbPressed then
        TreemapClick(d.SeriesIndex, X, Y)
      else if (slot >= 0) and (FBindings[slot].SeriesType = TyTreeSeriesTypeName) then
      begin
        n := FOption.ComponentAt('series', d.SeriesIndex);
        if (n <> nil) and (n.JSONType = jtObject) then
        begin
          n := TJSONObject(n).Find('expandAndCollapse');
          { absent is the default, true; anything but JSON true is off }
          if (n = nil) or ((n.JSONType = jtBoolean) and n.AsBoolean) then
            TreeToggle(d.SeriesIndex, d.DataIndex);
        end;
      end;
    end;
    FPressArmed := False;
    { A BREADCRUMB ITEM: pressed and released on it, within 4 px }
    { its click is the item's own onclick, in EventUp [F2a] }
    FCrumbPressed := False;
  end;
  { ParallelView's mouseup hears every button [Batch 140] }
  if (Button <> mbLeft) and not (csDesigning in ComponentState) then ParExpUp(X, Y);
  if not (csDesigning in ComponentState) then EventUp(Button, X, Y);
  { the click through the pointer's listener, after the chart's own
    [Batch 153] }
  if zrClick and not (csDesigning in ComponentState) then
    PtrListener('click', X, Y, d, el);
  inherited MouseUp(Button, Shift, X, Y);
end;

procedure TTyAdvanceChart.CaptureChanged;
begin
  { THE BUTTON CAME UP SOMEWHERE THIS CONTROL WILL NOT HEAR OF, or another
    window took the mouse. Either way the drag is over. A dataZoom's ends as
    a mouseup where the pointer was last would end it -- its commit and all;
    the widgetset's own mouseup, when it follows, finds nothing to end. }
  FRoamSeries := -1;
  FRoamGeo := -1;
  FThumbDrag := -1;
  GraphDragEnd;
  FSankeyDragSlot := -1;
  FPressArmed := False;
  { a visualMap drag ends as a release would end it [Batch 116] }
  VmDragEnd;
  if (FDzDrag.Kind <> dtkNone) or (FDzPanGrid >= 0) then
    DataZoomPointer(dpUp, FDzLastX, FDzLastY, [], 0);
  { a brush ends as a release would end it [Batch 125] }
  TbCtlUp(FEvLastX, FEvLastY);
  { a cover's drag and a brush component's track too [Batch 126] }
  BrushDragEnd;
  BrushCtlUp(FEvLastX, FEvLastY);
  { and the timeline's checkpoint [Batch 129] }
  TlDragEnd(FEvLastX, FEvLastY);
  inherited CaptureChanged;
end;

function TTyAdvanceChart.DoMouseWheel(Shift: TShiftState; WheelDelta: Integer;
  MousePos: TPoint): Boolean;
var
  wd: TTyChartDatumRef;
  wel: Integer;
begin
  { THE HOST'S HANDLER FIRST, and one that takes the wheel keeps it. }
  Result := inherited DoMouseWheel(Shift, WheelDelta, MousePos);
  if Result then Exit;
  if csDesigning in ComponentState then Exit;
  try
    Result := WheelRoam(Shift, WheelDelta, MousePos);
  finally
    { the pointer's global listener hears the wheel too, after the roams
      [Batch 153] }
    wd := HitTestAt(MousePos.X, MousePos.Y, wel);
    PtrListener('mousewheel', MousePos.X, MousePos.Y, wd, wel);
  end;
end;

function TTyAdvanceChart.WheelRoam(Shift: TShiftState; WheelDelta: Integer;
  MousePos: TPoint): Boolean;
var
  s: Double;
  si, gi: Integer;
begin
  Result := False;
  { THE THUMBNAIL'S wheel, the first roam listener (z 10): in its content
    rect it zooms its graph and is consumed [Batch 140] }
  if ThumbWheel(MousePos.X, MousePos.Y, WheelDelta) then Exit(True);
  { a wheel in a zooming grid is the dataZoom's, and stopped there }
  if DataZoomPointer(dpWheel, MousePos.X, MousePos.Y, Shift,
    TyDzZrDelta(WheelDelta)) then Exit(True);
  s := TyGraphWheelScale(WheelDelta);
  if s = 0 then Exit;
  si := RoamTargetAt(MousePos.X, MousePos.Y, True, gi);
  { [Batch 150] a geo's RoamController took it: a geoRoam zoom about the
    pointer, the wheel consumed }
  if gi >= 0 then
  begin
    GeoGesture(gi, False, 0, 0, True, s, MousePos.X, MousePos.Y);
    Exit(True);
  end;
  if si < 0 then Exit;
  if IsTreeSeries(si) then Result := TreeZoom(si, s, MousePos.X, MousePos.Y)
  else if IsSankeySeries(si) then Result := SankeyZoom(si, s, MousePos.X, MousePos.Y)
  { [Batch 115] }
  else if IsTreemapSeries(si) then Result := TreemapWheel(si, s, MousePos.X, MousePos.Y)
  else Result := GraphZoom(si, s, MousePos.X, MousePos.Y);
end;

function TTyAdvanceChart.ConvertOnSingle(ASingle: TTySingle; AValue: TJSONData;
  AFrom: Boolean): TTyConvertResult;
begin
  if AFrom then Result := TySingleFromPixel(ASingle, AValue)
  else Result := TySingleToPixel(ASingle, AValue);
end;

{ [F2a] A GRAPH NODE'S EMPHASIS LABEL show: the item's emphasis.label.show,
  else its own label.show (Series.fillDataTextStyle's defaultEmphasis on a
  data item), else the category's emphasis, else the series' -- whose
  default is true (GraphSeries.defaultOption) }
function GraphEmLabelShow(AItem, ACat, ASeries: TJSONObject): Boolean;
var has: Boolean;
begin
  Result := TyStReadBool([AItem], ['emphasis', 'label', 'show'], has);
  if has then Exit;
  Result := TyStReadBool([AItem], ['label', 'show'], has);
  if has then Exit;
  Result := TyStReadBool([ACat, ASeries], ['emphasis', 'label', 'show'], has);
  if not has then Result := True;
end;

function LnNode(ANode: TJSONObject; const APath: array of string): TJSONData;
var i: Integer; d: TJSONData;
begin
  Result := nil;
  d := ANode;
  for i := 0 to High(APath) do
  begin
    if not (d is TJSONObject) then Exit;
    d := TJSONObject(d).Find(APath[i]);
    if d = nil then Exit;
  end;
  if (d <> nil) and (d.JSONType = jtNull) then Exit;
  Result := d;
end;

{ LinesSeries.formatTooltip: one bare row, the item's name -- `name` read
  through the item model, so a named series lends its name to an unnamed
  item -- else 'from > to', and the raw value unless it is not a number }
function TTyAdvanceChart.LinesTooltip(const ADatum: TTyChartDatumRef;
  out ABlock: TTyTooltipBlock): Boolean;
var
  slot: Integer;
  raw: TTyLinesRaw;
  nm, vt: string;
  d: TJSONData;
  node: TJSONObject;
  noValue: Boolean;
  v: Double;
begin
  ABlock := nil;
  Result := False;
  if (ADatum.Kind <> ctkSeries) or ADatum.IsEdge then Exit;
  slot := SlotOfSeries(ADatum.SeriesIndex);
  if (slot < 0) or (slot > High(FLines)) or not FLines[slot].Valid then Exit;
  if (ADatum.DataIndex < 0) or (ADatum.DataIndex > High(FLines[slot].Raws)) then Exit;
  Result := True;
  raw := FLines[slot].Raws[ADatum.DataIndex];
  node := nil;
  d := FOption.ComponentAt('series', ADatum.SeriesIndex);
  if d is TJSONObject then node := TJSONObject(d);
  if raw.HasName then nm := raw.Name
  else
  begin
    nm := '';
    d := LnNode(node, ['name']);
    if (d <> nil) and (d.JSONType = jtString) then nm := d.AsString
    else if (d <> nil) and (d.JSONType = jtNumber) then nm := TyJsNumberToString(d.AsFloat);
  end;
  if nm = '' then
  begin
    if raw.HasFromName then nm := raw.FromName;
    if raw.HasToName then
    begin
      if raw.HasFromName then nm := nm + ' > ' + raw.ToName
      else nm := raw.ToName;
    end;
  end;
  { makeValueReadable of the name: nothing is '-' }
  if Trim(nm) = '' then nm := '-';
  noValue := True;
  vt := '';
  if raw.RawIsFlat then
  begin
    noValue := False;
    vt := TyTooltipValueText(0);
  end
  else if (not raw.RawNone) and (raw.RawJson <> nil) then
  begin
    v := TyLinesJsNum(raw.RawJson);
    if (raw.RawJson is TJSONArray) and (raw.RawJson.Count <> 1) then v := NaN;
    if raw.RawJson.JSONType = jtObject then v := NaN;
    noValue := IsNan(v);
    if not noValue then
    begin
      if raw.RawJson.JSONType = jtString then vt := raw.RawJson.AsString
      else vt := TyTooltipValueText(v);
    end;
  end;
  ABlock := TTyTooltipBlock.CreateSection('', True);
  ABlock.Add(TTyTooltipBlock.CreateNameValue(ttmNone, 0, nm, False, vt, noValue));
end;

procedure TTyAdvanceChart.HeatmapTipDims(ASlot: Integer;
  const AEnc: TTySeriesEncode; AStore: TTyDataStore);
var tip: TTyIntegerArray;
begin
  if (AStore = nil) or (ASlot < 0) or (ASlot > High(FBindings)) then Exit;
  if FBindings[ASlot].SeriesType <> 'heatmap' then Exit;
  { encode.tooltip, then encode.label, as for any series }
  if Length(AEnc.Tooltip) > 0 then Exit;
  if Length(AEnc.Labels) > 0 then tip := Copy(AEnc.Labels)
  else
  begin
    { createSeriesData(generateCoord: 'value'): the element past x and y is
      a coordinate of its own, not extra, a float -- the last one a label
      suits, and so the tooltip's }
    SetLength(tip, 1);
    tip[0] := 2;
  end;
  AStore.SetTooltipPositions(tip);
end;

function TTyAdvanceChart.SlotOfSeries(ASeriesIndex: Integer): Integer;
var i: Integer;
begin
  for i := 0 to High(FBindings) do
    if FBindings[i].SeriesIndex = ASeriesIndex then Exit(i);
  Result := -1;
end;

function TTyAdvanceChart.NearestRowOn(ASlot: Integer; AX, AY: Double): Integer;
var
  axis: TTyAxis;
  st: TTyDataStore;
  col, i: Integer;
  want, v, d, best: Double;
begin
  Result := -1;
  if (ASlot < 0) or (ASlot > High(FBindings)) or (ASlot > High(FStores)) then Exit;
  axis := FBindings[ASlot].BaseAxis;
  st := FStores[ASlot];
  if (axis = nil) or (st = nil) then Exit;
  col := st.DimIndexOf(axis.Dim);
  if col < 0 then Exit;
  { WHICH COORDINATE THE BASE AXIS READS. Not "x for a line": on a horizontal
    bar chart the spine runs vertically, and asking a y axis about an x pixel
    answers a number that is the right shape and the wrong measurement. The
    binding already knows which of its two axes is the base one. }
  if axis = FBindings[ASlot].XAxis then want := AX else want := AY;
  { CoordToData extrapolates rather than failing, and has no NaN guard of its
    own -- a degenerate axis can hand back one. }
  want := axis.CoordToData(want);
  if IsNan(want) then Exit;
  best := NaN;
  for i := 0 to st.Count - 1 do
  begin
    v := st.Get(col, i);
    if IsNan(v) then Continue;
    d := Abs(v - want);
    if IsNan(best) or (d < best) then
    begin
      best := d;
      Result := i;
    end;
  end;
end;

function TTyAdvanceChart.HitTestAt(AX, AY: Integer): TTyChartDatumRef;
var ignored: Integer;
begin
  Result := HitTestAt(AX, AY, ignored);
end;

function TTyAdvanceChart.HitTestAt(AX, AY: Integer;
  out AElement: Integer): TTyChartDatumRef;
var
  idx, slot, row, bb, bi: Integer;
  bp: TTyBrushPiece;
begin
  Result := TyChartNoDatum;
  AElement := -1;
  if (FPaintList = nil) or not FPaintListValid then Exit;
  { A BRUSH COVER over the item is the target: nothing beneath it is
    hovered or pressed [Batch 126] }
  if BrushPieceAt(AX, AY, bb, bi, bp) then Exit;
  { IN MOTION, WHAT IS DRAWN IS WHAT IS HIT: the frame keeps the list's
    insertion indices, so the element named is the list's [Batch 89] }
  { and AT REST ON A STATE PROXY, where the list keeps the rest values (a
    selected slice is out, a hovered symbol larger) [Batch 94] }
  { the direct test, then the coarse pointer's fallback [Batch 142] }
  idx := ListHitAt(AX, AY);
  if idx < 0 then Exit;
  AElement := idx;
  Result := FPaintList.Element(idx).Datum;
  if Result.SeriesIndex < 0 then Exit;
  { A LARGE BATCH: the row is its own scan's, and a hit without one (a
    candle's path, a bar's clip letting a gap through) names the element
    and no datum [Batch 117] }
  if FPaintList.Element(idx).Shape.Kind = cskLarge then
  begin
    row := LargeRowAt(idx, AX, AY);
    slot := SlotOfSeries(Result.SeriesIndex);
    if (row < 0) or (slot < 0) or (slot > High(FStores)) or (FStores[slot] = nil) then
      Exit(TyChartNoDatum);
    Exit(TyChartDatum(Result.SeriesIndex, row, FStores[slot].GetRawIndex(row)));
  end;
  { A RUN ELEMENT -- one element standing for a whole series, which is what a
    line's stroke is. The list reports it as `(series, -1)`, which
    TyChartDatumValid rejects, and because the hit test answers with the
    topmost element rather than falling through, a hit there would otherwise
    name nothing at all. }
  if Result.DataIndex < 0 then
  begin
    slot := SlotOfSeries(Result.SeriesIndex);
    row := NearestRowOn(slot, AX, AY);
    if row < 0 then
    begin
      AElement := -1;
      Exit(TyChartNoDatum);
    end;
    Result := TyChartDatum(Result.SeriesIndex, row,
      FStores[slot].GetRawIndex(row));
  end;
end;

function TTyAdvanceChart.TipStateKey: string;
var
  i, k: Integer;

  function H(A: Double): string;
  begin
    Result := FloatToStrF(A, ffGeneral, 17, 0, DefaultFormatSettings);
  end;

begin
  Result := BoolToStr(FTipShown, '1', '0') + '|' + H(FTipSnap.X) + ',' + H(FTipSnap.Y)
    + '|' + IntToStr(Ord(FTipSnap.Datum.Kind)) + ',' + IntToStr(FTipSnap.Datum.SeriesIndex)
    + ',' + IntToStr(FTipSnap.Datum.DataIndex) + ',' + IntToStr(FTipSnap.Datum.ComponentIndex)
    + ',' + BoolToStr(FTipSnap.Datum.IsEdge, '1', '0') + ',' + IntToStr(FTipSnap.Element)
    + '|' + FTipSnap.DbcJson + '|' + BoolToStr(FTipSnap.Frozen, '1', '0') + H(FTipSnap.FrozenX)
    + ',' + H(FTipSnap.FrozenY) + '|' + FTipSnap.PosJson;
  for i := 0 to High(FTipSnap.Hits) do
  begin
    Result := Result + '|s' + IntToHex(PtrUInt(FTipSnap.Hits[i].Axis), 16) + H(FTipSnap.Hits[i].Value)
      + ',' + H(FTipSnap.Hits[i].SnapValue);
    for k := 0 to High(FTipSnap.Hits[i].Rows) do
      Result := Result + ',' + IntToStr(FTipSnap.Hits[i].Slots[k]) + ':' + IntToStr(FTipSnap.Hits[i].Rows[k]);
  end;
  for i := 0 to High(FTipHits) do
  begin
    Result := Result + '|p' + IntToHex(PtrUInt(FTipHits[i].Axis), 16) + H(FTipHits[i].Value)
      + ',' + H(FTipHits[i].SnapValue) + BoolToStr(FTipHits[i].Cross, 'c', '');
    for k := 0 to High(FTipHits[i].Rows) do
      Result := Result + ',' + IntToStr(FTipHits[i].Slots[k]) + ':' + IntToStr(FTipHits[i].Rows[k]);
  end;
end;

procedure TTyAdvanceChart.TipInvalidate;
begin
  { zrender marks what changed: a box or a pointer that is where it was
    marks nothing (the frame is asked for as before) }
  if TipStateKey <> FTipPaintedKey then FZrDirty := True;
  InvalidateFrameQuiet;
end;

{ ==================== the tooltip ==================== }

function TTyAdvanceChart.TooltipSpecFor(
  const ADatum: TTyChartDatumRef): TTyTooltipSpec;
var
  kind: TTyMarkerKind;
  blk: TTyMkBlock;
  it, opt: Integer;
  mx: TTyMatrix;
  info: TTyMatrixCellInfo;
begin
  { A MATRIX CELL'S: the matrix's tooltip, the matrix, its name as the
    formatter [Batch 147] }
  if TipIsMatrix(ADatum) then
  begin
    MatrixCellOf(ADatum, mx, info);
    Exit(TyTooltipSpecOfMatrix(FOption, ADatum.ComponentIndex, info.TipName));
  end;
  { A MARKER'S CASCADE IS ITS OWN [Batch 100]: its data item, the marker,
    the global -- never the host series' }
  { [Batch 148] a geo region's: the component item's cascade }
  if IsGeoDatum(ADatum) then Exit(GeoTipSpec(ADatum));
  { [F4c] an axis' name or label: the axis' cascade }
  if IsAxisTextDatum(ADatum) then Exit(AxisTipSpec(ADatum));
  if TipIsMarker(ADatum) then
  begin
    opt := -1;
    if MarkerItemOf(ADatum, kind, blk, it) then
      case kind of
        mkPoint: opt := blk.Points[it].Index;
        mkLine: opt := blk.Lines[it].Index;
        mkArea: opt := blk.Areas[it].Index;
      end
    else
      case ADatum.Kind of
        ctkMarkLine: kind := mkLine;
        ctkMarkArea: kind := mkArea;
      else
        kind := mkPoint;
      end;
    Exit(TyTooltipSpecOfMarker(FOption, ADatum.ComponentIndex,
      TyMarkerKey[kind], opt));
  end;
  { THE RAW ROW, not the view row. A data-item tooltip is written beside the
    datum in the option text, and the option text is the raw order -- a filter
    is a view for readers and has never moved anything in the tree. }
  { A GRAPH LINK has a row of its own, in the LINK list, and a node's tooltip
    written at that position is somebody else's -- so a link takes the
    series'. }
  if ADatum.IsEdge then
    Result := TyTooltipSpecOf(FOption, ADatum.SeriesIndex, -1)
  else
    Result := TyTooltipSpecOf(FOption, ADatum.SeriesIndex, ADatum.RawDataIndex);
end;

function TTyAdvanceChart.TooltipInk(
  const ASpec: TTyTooltipSpec): TTyTooltipInk;
var
  nameS, valueS: TTyStyleSet;
  model: TTyStyleModel;
begin
  model := ActiveController.Model;
  nameS := model.ResolveStyle('TyAdvChartTooltip', StyleClass, [tysNormal]);
  valueS := model.ResolveStyle('TyAdvChartTooltipValue', '', []);

  Result.NameFontName := nameS.FontName;
  Result.NameSizeLogical := ResolveFontSize(nameS);
  Result.NameWeight := nameS.FontWeight;
  Result.NameColour := TTyChartColor(nameS.TextColor);

  Result.ValueFontName := valueS.FontName;
  if Result.ValueFontName = '' then Result.ValueFontName := nameS.FontName;
  Result.ValueSizeLogical := ResolveFontSize(valueS);
  Result.ValueWeight := valueS.FontWeight;
  Result.ValueColour := TTyChartColor(valueS.TextColor);

  { THE OPTION LAST, over whatever the theme said. ECharts' textStyle is one
    object for both roles, so a written colour or size takes BOTH -- the
    hierarchy a theme drew with two keys collapses into one, which is exactly
    what writing `tooltip.textStyle` asks for. }
  if ASpec.HasTextColour then
  begin
    Result.NameColour := ASpec.TextColour;
    Result.ValueColour := ASpec.TextColour;
  end;
  if ASpec.HasTextSize then
  begin
    Result.NameSizeLogical := TyFontSizeFromPx(ASpec.TextSizeLogical);  // CSS px [Batch 83]
    Result.ValueSizeLogical := Result.NameSizeLogical;
  end;

  { UPSTREAM'S OWN HTML RULE -- round(fontSize * 3 / 2) -- and NOT its richText
    one, which is a flat 22 whatever the font is. A library whose themes change
    the type scale cannot carry a constant here: a dense skin at 11px would get
    a box of double-spaced rows and a display skin at 20px would get overlapping
    ones. Recorded as a deliberate divergence. }
  { in the point units the sizes were always given in: a pixel size is
    brought back to its point equivalent first [Batch 83] }
  Result.LineHeightLogical :=
    Round(Max(TyFontPxOf(Result.NameSizeLogical),
      TyFontPxOf(Result.ValueSizeLogical)) * 72 / 96 * 3 / 2);

  Result.MarkerSizeLogical := ActiveController.Metric(
    TyAdvChartTooltipMarkerVar, TyAdvChartTooltipMarker);
  Result.MarkerGapLogical := ActiveController.Metric(
    TyAdvChartTooltipMarkerGapVar, TyAdvChartTooltipMarkerGap);
  Result.GutterLogical := ActiveController.Metric(
    TyAdvChartTooltipGutterVar, TyAdvChartTooltipGutter);
  { The narrow gutter is half the wide one upstream (10 against 20), so it
    follows a skin that retuned the wide one instead of being a fifth metric
    nobody would think to change. }
  Result.GutterCloseLogical := Result.GutterLogical / 2;
  if Result.MarkerSizeLogical < 0 then Result.MarkerSizeLogical := 0;
  if Result.MarkerGapLogical < 0 then Result.MarkerGapLogical := 0;
  if Result.GutterLogical < 0 then Result.GutterLogical := 0;
end;

function TTyAdvanceChart.DatumColour(
  const ADatum: TTyChartDatumRef): TTyChartColor;
var
  slot, idx: Integer;
  perDatum: Boolean;
  el: TTyChartElement;
  v: TTySeriesVisual;
  gi: TTyGraphInk;
begin
  Result := 0;
  { THE SERIES' COLOUR WITH THE ROW'S OVERRIDE, which is what upstream's marker
    is: it reads `style[series.visualDrawType]`, and drawType names the colour
    the visual pipeline WROTE -- not whichever slot a symbol later painted it
    into.

    ASKING THE DRAWN ELEMENT LOOKED RIGHT AND WAS WRONG. A line's default
    marker is an `emptyCircle`: a ring in the series colour over the chart's
    own ground, so its element's FILL is the background, and a tooltip reading
    it drew an invisible white dot on a white box. Falling back to the stroke
    is no answer either, because a bar carries its colour in the fill. What
    the marker names is a SERIES and a ROW, so that is what it asks. }
  { [Batch 100] A MARKER'S is its own visual: the symbol's fill, the line's
    stroke, the area's fill }
  if TipIsMarker(ADatum) then Exit(MarkerColour(ADatum));
  slot := SlotOfSeries(ADatum.SeriesIndex);
  if slot < 0 then Exit;
  { [Batch 100] A SUNBURST SECTOR, A TREEMAP RECTANGLE, A SANKEY NODE: the
    node's colour visual; a sankey link has none (upstream's params.color is
    undefined there) }
  if (FBindings[slot].SeriesType = TySunburstSeriesTypeName)
    and (slot <= High(FSunbursts)) and FSunbursts[slot].Valid then
  begin
    if (ADatum.DataIndex >= 0) and (ADatum.DataIndex <= High(FSunbursts[slot].Nodes)) then
      Result := FSunbursts[slot].Nodes[ADatum.DataIndex].Fill;
    { the return circle's own colour, the theme's where none is named
      [Batch 115] }
    if (ADatum.DataIndex = 0) and not FSunbursts[slot].HasRootFill then
      Result := SunburstInk(slot).RootFill;
    Exit;
  end;
  if (FBindings[slot].SeriesType = TyTreemapSeriesTypeName)
    and (slot <= High(FTreemaps)) and FTreemaps[slot].Valid then
  begin
    if (ADatum.DataIndex >= 0) and (ADatum.DataIndex <= High(FTreemaps[slot].Nodes))
      and FTreemaps[slot].Nodes[ADatum.DataIndex].HasFill then
      Result := FTreemaps[slot].Nodes[ADatum.DataIndex].Fill;
    Exit;
  end;
  if (FBindings[slot].SeriesType = TySankeySeriesTypeName)
    and (slot <= High(FSankeys)) and FSankeys[slot].Valid then
  begin
    if (not ADatum.IsEdge) and (ADatum.DataIndex >= 0)
      and (ADatum.DataIndex <= High(FSankeys[slot].Nodes))
      and FSankeys[slot].Nodes[ADatum.DataIndex].HasColour then
      Result := FSankeys[slot].Nodes[ADatum.DataIndex].Colour;
    Exit;
  end;
  { A CHORD NODE: its colour visual; a ribbon has none (params.color is
    undefined for the edge data) [Batch 120] }
  if (FBindings[slot].SeriesType = TyChordSeriesTypeName)
    and (slot <= High(FChords)) and FChords[slot].Valid then
  begin
    if (not ADatum.IsEdge) and (ADatum.RawDataIndex >= 0)
      and (ADatum.RawDataIndex <= High(FChords[slot].Nodes))
      and FChords[slot].Nodes[ADatum.RawDataIndex].HasColour then
      Result := FChords[slot].Nodes[ADatum.RawDataIndex].Colour;
    Exit;
  end;
  { A PARALLEL ROW'S IS ITS STROKE: drawType 'stroke' [Batch 128] }
  if (FBindings[slot].SeriesType = TyParallelSeriesTypeName)
    and (slot <= High(FParSolved)) and FParSolved[slot].Valid then
  begin
    if (ADatum.DataIndex >= 0) and (ADatum.DataIndex <= High(FParSolved[slot].Rows)) then
      Exit(FParSolved[slot].Rows[ADatum.DataIndex].Stroke);
    Exit(TTyChartColor(SeriesColor(ADatum.SeriesIndex)));
  end;
  { A GRAPH LINK'S COLOUR IS ITS STROKE, found by its own row. }
  if ADatum.IsEdge then
  begin
    if (FBindings[slot].SeriesType = TyGraphSeriesTypeName)
      and (slot <= High(FGraphEdges)) and (slot <= High(FGraphSpecs)) then
    begin
      gi := GraphInk(slot);
      for idx := 0 to High(FGraphEdges[slot]) do
        if FGraphEdges[slot][idx].Row = ADatum.DataIndex then
          Exit(TyGraphEdgeStroke(FGraphSpecs[slot], FGraphEdges[slot], gi, idx));
    end;
    Exit;
  end;
  { A GRAPH NODE'S MARKER IS THE NODE'S FILL -- its category's colour, or its
    own -- found by the node's VIEW row. Not through the paint list: a graph's
    edges number their data in the same space as its nodes, so the first
    element carrying a datum could be an edge. }
  if (FBindings[slot].SeriesType = TyGraphSeriesTypeName)
    and (slot <= High(FGraphNodes)) then
  begin
    gi := GraphInk(slot);
    for idx := 0 to High(FGraphNodes[slot]) do
      if (FGraphNodes[slot][idx].Row = ADatum.DataIndex)
        and (idx <= High(gi.NodeFills)) then
        Exit(gi.NodeFills[idx]);
  end;
  v := TySeriesVisual(TTyChartColor(SeriesColor(ADatum.SeriesIndex)));
  ApplyOptStyle(v, ADatum.SeriesIndex);
  { the marker is the ITEM's colour, so what a visualMap wrote on it too }
  ApplyVisualMaps(v, slot, 0);
  Result := v.Fill;
  if (slot <= High(FStores)) and (FStores[slot] <> nil)
    and (ADatum.DataIndex >= 0) and (ADatum.DataIndex < FStores[slot].Count) then
    Result := TyRowFill(v, FStores[slot], ADatum.DataIndex);

  { SOME SERIES HAVE NO SINGLE COLOUR. A pie's slices take consecutive palette
    slots; a candlestick's bodies are red or green by the datum's own two
    numbers. Asking the SERIES paints every marker of those alike, so for them
    the answer is read off the drawn element -- right here for the same reason
    it was wrong above, because both are FILLED shapes and a filled shape's
    fill IS its colour.

    FOUND BY DATUM, not taken from the hovered element: under an axis trigger
    the pointer is usually nowhere near the mark being described, and the
    element it happens to be over belongs to something else or to nothing. }
  { THE SAME LIST THE LEGEND ASKS. It read `= 'pie'` while a funnel and a
    radar colour by datum in exactly the same way, so their markers took the
    flat series colour and disagreed with the band or the ring under the
    pointer. }
  perDatum := TySeriesLegendByDatum(FBindings[slot].SeriesType)
    or (Length(FStores[slot].DimsOfCoord(
      AxisDimOf(FBindings[slot].ValueAxis))) > 1);
  if perDatum and (FPaintList <> nil) and FPaintListValid then
  begin
    idx := FPaintList.IndexOfDatumInk(ADatum.SeriesIndex, ADatum.DataIndex);
    if idx >= 0 then
    begin
      el := FPaintList.Element(idx);
      if el.Style.HasFill and (el.Style.FillColor <> 0) then
        Result := el.Style.FillColor
      { A RING HAS NO FILL. A radar's row is a stroked polyline, so the colour
        that stands for it is its STROKE -- and a filled-shape-only rule left
        every radar marker on the series colour, which is the one thing a
        series colouring by datum does not have. }
      else if (not el.Style.HasFill) and (el.Style.StrokeColor <> 0)
        and (el.Style.StrokeWidthLogical > 0) then
        Result := el.Style.StrokeColor;
    end;
  end;
end;

function TTyAdvanceChart.TooltipParams(
  const ADatum: TTyChartDatumRef): TTyChartCallbackParams;
var
  mx: TTyMatrix;
  info: TTyMatrixCellInfo;
  slot, i, n: Integer;
  cols: TTyIntegerArray;
  st: TTyDataStore;
  pct: TTyDoubleArray;
  tv: Double;
  tvText: string;
begin
  if TipIsMarker(ADatum) then Exit(MarkerTooltipParams(ADatum));
  { a matrix cell's formatterParams: componentType, name, matrixIndex and
    xyLocator [Batch 147] }
  if MatrixCellOf(ADatum, mx, info) then
  begin
    Result := TyChartBlankParams;
    Result.ComponentType := 'matrix';
    Result.ComponentIndex := ADatum.ComponentIndex;
    Result.Name := info.TipName;
    SetLength(Result.Coord, 2);
    Result.Coord[0] := info.Loc[0];
    Result.Coord[1] := info.Loc[1];
    Exit;
  end;
  Result := TyChartBlankParams;
  Result.ComponentType := 'series';
  Result.SeriesIndex := ADatum.SeriesIndex;
  Result.DataIndex := ADatum.DataIndex;
  Result.RawDataIndex := ADatum.RawDataIndex;
  Result.Color := DatumColour(ADatum);
  slot := SlotOfSeries(ADatum.SeriesIndex);
  if slot < 0 then Exit;
  Result.SeriesType := FBindings[slot].SeriesType;
  Result.SeriesName := SeriesModelName(ADatum.SeriesIndex);
  if slot > High(FStores) then Exit;
  st := FStores[slot];
  if st = nil then Exit;
  if (Result.SeriesType = TyGraphSeriesTypeName)
    or (Result.SeriesType = TyChordSeriesTypeName) then
  begin
    if ADatum.IsEdge then Result.DataType := 'edge'
    else Result.DataType := 'node';
  end;
  { A CHORD LINK: the edge data's params -- its name (the link's id, else
    `source > target` as written) and its own value [Batch 120] }
  if ADatum.IsEdge and (Result.SeriesType = TyChordSeriesTypeName) then
  begin
    if (slot > High(FChords)) or not FChords[slot].Valid then Exit;
    if (ADatum.RawDataIndex < 0) or (ADatum.RawDataIndex > High(FChords[slot].Edges)) then Exit;
    Result.Name := FChords[slot].Edges[ADatum.RawDataIndex].Name;
    if TyChordEdgeRawValue(FChords[slot], ADatum.RawDataIndex, tv, tvText)
      and not IsNan(tv) then
    begin
      SetLength(Result.Values, 1);
      Result.Values[0] := tv;
    end;
    Exit;
  end;
  { A GRAPH LINK IS NAMED BY ITS TWO ENDS, `source > target`, each the name
    upstream's getName answers -- so a link between two bare numbers on a
    category axis reads 'Mon > Tue'. Its value is the link's own, and most
    links have none. }
  if ADatum.IsEdge then
  begin
    if slot > High(FGraphEdges) then Exit;
    for i := 0 to High(FGraphEdges[slot]) do
      if FGraphEdges[slot][i].Row = ADatum.DataIndex then
      begin
        Result.Name := GraphNodeName(slot, FGraphEdges[slot][i].Source)
          + ' > ' + GraphNodeName(slot, FGraphEdges[slot][i].Target);
        if not IsNan(FGraphEdges[slot][i].Value) then
        begin
          SetLength(Result.Values, 1);
          Result.Values[0] := FGraphEdges[slot][i].Value;
        end;
        Break;
      end;
    Exit;
  end;
  if (ADatum.DataIndex < 0) or (ADatum.DataIndex >= st.Count) then Exit;

  { THE NAME UPSTREAM CALLS `data.getName(dataIndex)`. On a category axis it is
    the category; on two value axes there is none, because the default encode
    only assigns an item name "the category way". A line on a value x axis
    therefore shows a dot and a number and no words -- which is upstream's
    picture, not a gap in this. The store answers it, by the same rule the
    label's b placeholder asks. }
  Result.Name := st.GetItemName(ADatum.DataIndex);
  Result.Raw := st.RawItem(ADatum.DataIndex);

  { THE d LETTER, which only a pie and a funnel have: the pie's seats (the
    largest-remainder shares, to percentPrecision) and the funnel's two-place
    share, both over the slices there are. Everywhere else `{d}` is no
    letter at all and a template leaves it as written. }
  if (Result.SeriesType = TyPieSeriesTypeName) and (slot <= High(FPies)) then
  begin
    Result.HasPercent := True;
    pct := TyPieSectorPercents(FPies[slot], FPieSpecs[slot].PercentPrecision);
    for i := 0 to High(FPies[slot].Sectors) do
      if FPies[slot].Sectors[i].Index = ADatum.DataIndex then
        Result.Percent := pct[i];
  end
  else if (Result.SeriesType = TyFunnelSeriesTypeName)
    and (slot <= High(FFunnels)) then
  begin
    Result.HasPercent := True;
    pct := TyFunnelPercents(FFunnels[slot]);
    for i := 0 to High(FFunnels[slot].Items) do
      if FFunnels[slot].Items[i].Index = ADatum.DataIndex then
        Result.Percent := pct[i];
  end;

  { WHICH VALUES, PLURAL. Upstream's `tooltipDims` is every data dimension
    mapped onto the value coordinate -- one for a bar, a line or a pie, and
    FOUR for a candlestick, which is why `mapDimensionsAll` is the plural
    spelling there and `mapDimension` is not. A port that took one column
    showed a candle's highest and called it the value. }
  cols := nil;
  if FBindings[slot].ValueAxis <> nil then
    cols := st.DimsOfCoord(FBindings[slot].ValueAxis.Dim);
  if Length(cols) = 0 then
  begin
    { A pie has no axes at all; its one dimension is the value. }
    n := st.DimCount;
    for i := n - 1 downto 0 do
      if st.DimType(i) <> ddtOrdinal then
      begin
        SetLength(cols, 1);
        cols[0] := i;
        Break;
      end;
  end;
  if Length(cols) = 0 then Exit;
  SetLength(Result.Values, Length(cols));
  SetLength(Result.DimensionNames, Length(cols));
  for i := 0 to High(cols) do
  begin
    Result.Values[i] := st.Get(cols[i], ADatum.DataIndex);
    Result.DimensionNames[i] := st.DimName(cols[i]);
  end;
  { EACH VALUE'S RAW CELL, at the position its dimension was read from. }
  if Result.Raw.Shape = rshNone then Exit;
  SetLength(Result.RawCells, Length(cols));
  SetLength(Result.RawTypes, Length(cols));
  for i := 0 to High(cols) do
  begin
    if not TTyDataStore.RawCell(Result.Raw, st.RawDimPos(cols[i]),
      Result.RawCells[i]) then
      Result.RawCells[i] := Default(TTyDataValue);
    Result.RawTypes[i] := st.DimType(cols[i]);
  end;
end;

type
  { One series' tooltip cells, upstream's defaultSeriesFormatTooltip: the
    texts (inline, joined by two spaces, or one per sub-row), the sub-rows'
    names, and what `order` sorts the series by. Valid False: the store kept
    no raw item or chose no tooltip dimensions, and the caller keeps its own
    rule. }
  TTyTipCells = record
    Valid, MultiLine: Boolean;
    Texts, Names: TTyStringArray;
    { each cell as String() prints it, for a valueFormatter handler }
    Raws: TTyStringArray;
    Sort: TTyDataValue;
  end;

{ makeValueReadable with a type: a TIME is formatted
  `yyyy-MM-dd HH:mm:ss`, in UTC under `useUTC` -- a number as epoch ms, text
  through the date parser (local unless it says otherwise) -- and anything
  that is no date falls to the untyped rules. }
function TipReadable(const ACell: TTyDataValue; AType: TTyDimType;
  AUTC: Boolean): string;
var ms: Double; ok: Boolean;
begin
  if AType = ddtTime then
  begin
    ok := False;
    ms := NaN;
    case ACell.Kind of
      dvkNumber, dvkBool:
        if not (IsNan(ACell.Num) or IsInfinite(ACell.Num)) then
        begin
          ms := TyJsRound(ACell.Num);
          ok := True;
        end;
      dvkText:
        ok := TyParseDateMs(ACell.Text, ms, False);
    end;
    if ok and not IsNan(ms) then
      Exit(TyFormatTime(ms, '{yyyy}-{MM}-{dd} {HH}:{mm}:{ss}', AUTC));
    AType := ddtFloat;
  end;
  Result := TyReadableCell(ACell, AType);
end;

function TipCellsOf(AStore: TTyDataStore; ARow: Integer;
  AUTC: Boolean): TTyTipCells;
var
  raw: TTyRawItem;
  pos: TTyIntegerArray;
  n, i: Integer;
  info: TTyRawDimInfo;
  c: TTyDataValue;
  haveFirst: Boolean;

  procedure Put(APos: Integer; const ACell: TTyDataValue);
  var k: Integer;
  begin
    info := AStore.RawDimInfo(APos);
    k := Length(Result.Texts);
    SetLength(Result.Texts, k + 1);
    SetLength(Result.Names, k + 1);
    SetLength(Result.Raws, k + 1);
    Result.Raws[k] := TyJsValueText(ACell, '');
    Result.Texts[k] := TipReadable(ACell, AStore.RawPosType(APos), AUTC);
    Result.Names[k] := '';
    if info.HasDisplay then Result.Names[k] := info.Display;
    if not haveFirst then
    begin
      Result.Sort := ACell;
      haveFirst := True;
    end;
  end;

begin
  Result := Default(TTyTipCells);
  if (AStore = nil) or not AStore.HasTooltipPositions then Exit;
  raw := AStore.RawItem(ARow);
  if raw.Shape = rshNone then Exit;
  Result.Valid := True;
  haveFirst := False;
  pos := AStore.TooltipPositions;
  n := Length(pos);
  if (n > 1) or ((raw.Shape = rshArray) and (n = 0)) then
  begin
    { SUB-ROWS WHEN ANY POSITION OF THE ITEM HAS A DISPLAY NAME -- every
      position the item has, shown or not; one a short item lacks does not
      count. }
    if raw.Shape = rshArray then
      for i := 0 to Min(High(raw.Cells), AStore.RawWidth - 1) do
      begin
        info := AStore.RawDimInfo(i);
        if info.HasDisplay then Result.MultiLine := True;
      end;
    if n > 0 then
      for i := 0 to n - 1 do
      begin
        if not TTyDataStore.RawCell(raw, pos[i], c) then c := Default(TTyDataValue);
        Put(pos[i], c);
      end
    else
      { NO TOOLTIP DIMENSION: every element the data has a dimension for. }
      for i := 0 to Min(High(raw.Cells), AStore.RawWidth - 1) do
        Put(i, raw.Cells[i]);
    { upstream sorts on the first INLINE value -- which a sub-row series has
      none of. }
    if Result.MultiLine then Result.Sort := Default(TTyDataValue);
  end
  else if n = 1 then
  begin
    if not TTyDataStore.RawCell(raw, pos[0], c) then c := Default(TTyDataValue);
    SetLength(Result.Texts, 1);
    SetLength(Result.Names, 1);
    Result.Texts[0] := TipReadable(c, AStore.RawPosType(pos[0]), AUTC);
    Result.Sort := c;
  end
  else
  begin
    { NOTHING TO CHOOSE FROM and no array: the value itself, untyped. }
    c := Default(TTyDataValue);
    if raw.Shape = rshScalar then c := raw.Scalar;
    SetLength(Result.Texts, 1);
    SetLength(Result.Names, 1);
    Result.Texts[0] := TipReadable(c, ddtFloat, AUTC);
    Result.Sort := c;
  end;
end;

function TipInline(const ACells: TTyTipCells): string;
var i: Integer;
begin
  Result := '';
  for i := 0 to High(ACells.Texts) do
  begin
    if i > 0 then Result := Result + '  ';
    Result := Result + ACells.Texts[i];
  end;
end;

{ A sub-row's name as upstream prints it: makeValueReadable(name, 'ordinal'),
  so a dimension with no display name reads '-'. }
function TipRowName(const AName: string): string;
begin
  Result := TyReadableCell(TyDataText(AName), ddtOrdinal);
end;

function TTyAdvanceChart.RadarTooltip(ASlot, ARow: Integer;
  const AColor: TTyChartColor; const ASpec: TTyTooltipSpec): TTyTooltipBlock;
var
  st: TTyDataStore;
  spec: TTyRadarSpec;
  nm: string;
  j: Integer;
  v: Double;
begin
  st := FStores[ASlot];
  { HEADED BY THE ITEM, or the series when the item has no name -- the
    model's name, auto name included -- and never hidden: a blank reads '-'. }
  nm := st.GetItemName(ARow);
  if nm = '' then nm := SeriesModelName(FBindings[ASlot].SeriesIndex);
  nm := TipRowName(nm);
  Result := TTyTooltipBlock.CreateSection(nm, False);
  { A ROW PER INDICATOR, the PARSED value, sorted by `order` even in an item
    tooltip -- the radar's section asks for it. }
  spec := TyRadarSpecOf(FOption, FBindings[ASlot].RadarIndex);
  for j := 0 to High(spec.Indicators) do
  begin
    if j >= st.DimCount then Break;
    v := st.Get(j, ARow);
    Result.Add(TTyTooltipBlock.CreateNameValue(ttmSubItem, AColor,
      TipRowName(spec.Indicators[j].Name), False, TyTooltipValueText(v),
      False)).SortParam := v;
  end;
  if ASpec.HasOrder then Result.SortBlocks(ASpec.Order);
end;

{ a tree row's name as upstream converts it: a string, a number's text, or
  nothing }
function TTyAdvanceChart.TreeRowName(ASlot, ARow: Integer): string;
var it, d: TJSONData;
begin
  Result := '';
  it := FTrees[ASlot].Hier.Nodes[ARow].Item;
  if not (it is TJSONObject) then Exit;
  d := TJSONObject(it).Find('name');
  if d = nil then Exit;
  if d.JSONType = jtString then Result := d.AsString
  else if d.JSONType = jtNumber then Result := TyJsNumberToString(d.AsFloat);
end;

{ its value: the first of an array; NaN unless a number }
function TTyAdvanceChart.TreeRowValue(ASlot, ARow: Integer): Double;
var it, d: TJSONData;
begin
  Result := NaN;
  it := FTrees[ASlot].Hier.Nodes[ARow].Item;
  if not (it is TJSONObject) then Exit;
  d := TJSONObject(it).Find('value');
  if (d <> nil) and (d.JSONType = jtArray) then
  begin
    if d.Count = 0 then Exit;
    d := d.Items[0];
  end;
  if (d <> nil) and (d.JSONType = jtNumber) then Result := d.AsFloat;
end;

function TTyAdvanceChart.TooltipContent(const ADatum: TTyChartDatumRef;
  const ASpec: TTyTooltipSpec): TTyTooltipBlock;
var
  p: TTyChartCallbackParams;
  seriesName, inlineName, valueText: string;
  haveValue: Boolean;
  slot, i: Integer;
  tv: Double;
  cells: TTyTipCells;
begin
  Result := nil;
  { [Batch 100] a marker's own formatTooltip; a sunburst's, a treemap's and
    a sankey's }
  if TipIsMarker(ADatum) then Exit(MarkerTooltipContent(ADatum));
  { a matrix cell has no content but its formatter's [Batch 147] }
  if ADatum.Kind = ctkMatrix then Exit;
  if HierTooltipContent(ADatum, DatumColour(ADatum), Result) then Exit;
  { a lines row: LinesSeries.formatTooltip [Batch 121] }
  if LinesTooltip(ADatum, Result) then Exit;
  { a map region: MapSeries.formatTooltip [Batch 152] }
  if MapTooltip(ADatum, Result) then Exit;
  p := TooltipParams(ADatum);
  { The DISPLAY name heads the section: an unnamed series has none. }
  seriesName := SeriesNameOf(ADatum.SeriesIndex);
  inlineName := p.Name;
  haveValue := Length(p.Values) > 0;
  valueText := ValuesText(p);
  if haveValue and (valueText = '') then haveValue := False;
  { A GRAPH LINK IS ONE BARE ROW -- upstream's formatTooltip hands back a
    nameValue with no marker and no section, so no series header either,
    named or not. }
  if ADatum.IsEdge then
  begin
    { A LINK WITH NO VALUE HAS NO VALUE CELL -- upstream's noValue is
      `value == null` here -- where a node or a bar with a missing value
      shows '-'. Nothing to decide here: TooltipParams gives a link a value
      only when it has one, so haveValue is already False. }
    if (Trim(inlineName) = '') and not haveValue then Exit;
    Result := TTyTooltipBlock.CreateSection('', True);
    Result.Add(TTyTooltipBlock.CreateNameValue(ttmNone, 0,
      inlineName, False, valueText, not haveValue));
    Exit;
  end;
  slot := SlotOfSeries(ADatum.SeriesIndex);
  { A TREE NODE IS ONE BARE ROW too: its name the path from the real root,
    dotted; its value the first value, and none unless it is a number.
    [Batch 83] }
  if IsTreeDatum(ADatum) and (ADatum.DataIndex > 0)
    and (ADatum.DataIndex <= High(FTrees[slot].Hier.Nodes)) then
  begin
    inlineName := '';
    i := ADatum.DataIndex;
    while i > 0 do
    begin
      if inlineName = '' then inlineName := TreeRowName(slot, i)
      else inlineName := TreeRowName(slot, i) + '.' + inlineName;
      i := FTrees[slot].Hier.Nodes[i].Parent;
    end;
    tv := TreeRowValue(slot, ADatum.DataIndex);
    Result := TTyTooltipBlock.CreateSection('', True);
    Result.Add(TTyTooltipBlock.CreateNameValue(ttmNone, 0, inlineName, False,
      TyTooltipValueText(tv), IsNan(tv)));
    Exit;
  end;
  if (slot >= 0) and (FBindings[slot].RadarIndex >= 0) and (slot <= High(FStores))
    and (FStores[slot] <> nil) and (ADatum.DataIndex >= 0)
    and (ADatum.DataIndex < FStores[slot].Count) then
    Exit(RadarTooltip(slot, ADatum.DataIndex, p.Color, ASpec));
  { A THEMERIVER'S ROW IS ONE BARE ROW: its formatTooltip is a nameValue of
    the row's name and value, no marker, no section -- for the row the
    datum names, which over a layer's polygon is the LAYER'S index, as
    upstream's setItemGraphicEl(idx) leaves it [Batch 118] }
  if (slot >= 0) and (FBindings[slot].SeriesType = TyThemeRiverSeriesTypeName)
    and (slot <= High(FStores)) and (FStores[slot] <> nil) then
  begin
    Result := TTyTooltipBlock.CreateSection('', True);
    if (ADatum.DataIndex >= 0) and (ADatum.DataIndex < FStores[slot].Count) then
    begin
      tv := FStores[slot].Get(1, ADatum.DataIndex);
      Result.Add(TTyTooltipBlock.CreateNameValue(ttmNone, 0,
        FStores[slot].GetItemName(ADatum.DataIndex), False,
        TyTooltipValueText(tv), IsNan(tv)));
    end;
    Exit;
  end;
  cells := Default(TTyTipCells);
  if (slot >= 0) and (slot <= High(FStores)) and (ADatum.DataIndex >= 0)
    and (FStores[slot] <> nil) and (ADatum.DataIndex < FStores[slot].Count) then
    cells := TipCellsOf(FStores[slot], ADatum.DataIndex,
      (FOption <> nil) and FOption.GetBool('useUTC', False));
  if cells.Valid then
  begin
    { SUB-ROWS: the item's own row keeps its name and an EMPTY value -- a
      value cell with nothing in it, not no value cell. }
    if cells.MultiLine then valueText := '' else valueText := TipInline(cells);
    haveValue := True;
  end;
  if (Trim(inlineName) = '') and not haveValue and (Trim(seriesName) = '') then
    Exit;

  { ONE SECTION HOLDING ONE ROW, which is the whole of upstream's default for
    a bar, a line, a scatter and a pie. `noHeader` is decided by whether the
    series was NAMED -- an auto-generated name counts as unnamed upstream, and
    SeriesNameOf answers '' for exactly that case -- and it is a different
    LAYOUT, not a wording change: without a header the section's gap level
    drops from 1 to 0 and the box loses a row. }
  { A NAME OF BLANKS IS STILL A NAME: upstream's isNameSpecified asks only
    whether one was written, and the header then goes through
    makeValueReadable, which never shows nothing -- so it reads '-'. }
  if (seriesName <> '') and (Trim(seriesName) = '') then seriesName := '-';
  { valueFormatter REPLACES THE VALUE CELL: upstream calls it in place of
    makeValueReadable, with the value and the raw index. [Batch 82] }
  if (ASpec.ValueFormatter <> '') and haveValue then
  begin
    { SUB-ROWS ARE FORMATTED ONE BY ONE, each with its own value and NO
      index -- upstream's sub-row fragments carry none -- and the item's own
      row gets the empty list. }
    if cells.MultiLine then
    begin
      valueText := TipValueFormatted(ASpec.ValueFormatter, p, '', True);
      for i := 0 to High(cells.Texts) do
        cells.Texts[i] := TipValueFormatted(ASpec.ValueFormatter, p,
          cells.Raws[i], False);
    end
    else
      valueText := TipValueFormatted(ASpec.ValueFormatter, p);
  end;
  Result := TTyTooltipBlock.CreateSection(seriesName, False);
  Result.Add(TTyTooltipBlock.CreateNameValue(ttmItem, p.Color,
    inlineName, False, valueText, not haveValue));
  { THE SUB-ROWS ARE SIBLINGS of the item row, after it, small-dotted in the
    series' colour. }
  if cells.MultiLine then
    for i := 0 to High(cells.Texts) do
      Result.Add(TTyTooltipBlock.CreateNameValue(ttmSubItem, p.Color,
        TipRowName(cells.Names[i]), False, cells.Texts[i], False));
end;

{ valueFormatter's (value, dataIndex): the value as String() prints the
  row's tooltip dimensions -- one scalar, or several joined -- and the RAW
  index, which is what 6.1 passes. }
function TTyAdvanceChart.TipValueFormatted(const AHandler: string;
  const AParams: TTyChartCallbackParams): string;
var
  prm: TTyChartCallbackParams;
  i: Integer;
begin
  prm := AParams;
  prm.ValueText := '';
  if Length(prm.RawCells) > 0 then
    for i := 0 to High(prm.RawCells) do
    begin
      if i > 0 then prm.ValueText := prm.ValueText + ',';
      prm.ValueText := prm.ValueText + TyJsValueText(prm.RawCells[i], '');
    end
  else
    for i := 0 to High(prm.Values) do
    begin
      if i > 0 then prm.ValueText := prm.ValueText + ',';
      prm.ValueText := prm.ValueText + TyChartValueText(prm.Values[i]);
    end;
  Result := TyChartRunHandler(AHandler, TyChartOneParams(prm));
end;

{ the same with the value text given -- a sub-row's own cell, or the empty
  list an item row with sub-rows gets -- and the index only where upstream
  passes one }
function TTyAdvanceChart.TipValueFormatted(const AHandler: string;
  const AParams: TTyChartCallbackParams; const AValueText: string;
  AWithIndex: Boolean): string;
var prm: TTyChartCallbackParams;
begin
  prm := AParams;
  prm.ValueText := AValueText;
  if not AWithIndex then
  begin
    prm.DataIndex := -1;
    prm.RawDataIndex := -1;
  end;
  Result := TyChartRunHandler(AHandler, TyChartOneParams(prm));
end;

{ The root textStyle over a font the theme resolved: family, size (CSS px),
  weight, and the colour free-standing text takes -- each where written. }
procedure TTyAdvanceChart.GlobalTextOver(var AName: string; var ASize,
  AWeight: Integer; var AHasColour: Boolean; var AColour: Cardinal;
  APick: TTyTextPick);
var
  ts, d: TJSONData;
  col: TTyChartColor;
begin
  if FOption = nil then Exit;
  ts := FOption.Find('textStyle');
  if not (ts is TJSONObject) then Exit;
  d := TJSONObject(ts).Find('fontFamily');
  if (ttpFamily in APick) and (d <> nil) and (d.JSONType = jtString)
    and (d.AsString <> '') then
    AName := d.AsString;
  if ttpSize in APick then
    ASize := TyOptFontSize(TJSONObject(ts).Find('fontSize'), ASize);
  if ttpWeight in APick then
    AWeight := TyFontWeightOf(TJSONObject(ts).Find('fontWeight'), AWeight);
  d := TJSONObject(ts).Find('color');
  if (ttpColour in APick) and (d <> nil) and (d.JSONType = jtString)
    and TyTryParseChartColor(d.AsString, col) then
  begin
    AHasColour := True;
    AColour := col;
  end;
end;

function TTyAdvanceChart.RtGlobal: TTyRtGlobal;
var
  st: TTyStyleSet;
  fname: string;
  fsize, fweight: Integer;
  hasCol: Boolean;
  col: Cardinal;
  root: TJSONObject;
begin
  st := ActiveController.Model.ResolveStyle('TyAdvChartLabel', '', []);
  fname := st.FontName;
  fsize := ResolveFontSize(st);
  fweight := st.FontWeight;
  hasCol := False;
  col := 0;
  GlobalTextOver(fname, fsize, fweight, hasCol, col, [ttpSize, ttpWeight, ttpFamily]);
  root := nil;
  if (FOption <> nil) and (FOption.Root is TJSONObject) then
    root := TJSONObject(FOption.Root);
  Result := TyRtGlobalOf(root, fname, fsize, fweight);
end;

{ An axis text style made what the layout measured: its family and size, its
  weight (an emphasised label keeps the theme's heavier one), and the
  author's colour where one was written. }
procedure TTyAdvanceChart.AxisTextOver(var AStyle: TTyStyleSet;
  const AName: string; ASize, AWeight: Integer; AHasColour: Boolean;
  AColour: Cardinal; AKeepWeight: Boolean);
begin
  AStyle.FontName := AName;
  AStyle.FontSize := ASize;
  Include(AStyle.Present, tpFontSize);
  if not AKeepWeight then AStyle.FontWeight := AWeight;
  if AHasColour then AStyle.TextColor := TTyColor(AColour);
end;

procedure TTyAdvanceChart.AxisTextStyles(ASpec: PTyAxisLayoutSpec;
  out ALabel, AName: TTyStyleSet);
var model: TTyStyleModel;
begin
  model := ActiveController.Model;
  ALabel := model.ResolveStyle('TyAdvChartAxisLabel', '', []);
  AName := model.ResolveStyle('TyAdvChartAxisName', '', []);
  if ASpec = nil then Exit;
  AxisTextOver(ALabel, ASpec^.FontName, ASpec^.FontSizeLogical, ASpec^.FontWeight,
    ASpec^.HasLabelColour, ASpec^.LabelColour, False);
  AxisTextOver(AName, ASpec^.NameFontName, ASpec^.NameFontSizeLogical,
    ASpec^.NameFontWeight, ASpec^.HasNameColour, ASpec^.NameColour, False);
end;

{ ==================== the chart's mouse events [Batch 84] ==================== }

function TTyAdvanceChart.ChartOn(const AType: string;
  AHandler: TTyChartEventHandler; const AQuery: string): Integer;
var
  t: string;
  i: Integer;
begin
  Result := -1;
  t := TyChartEventTypeOf(AType);
  if (t = '') or not Assigned(AHandler) then Exit;
  { THE SAME FUNCTION TWICE FOR ONE TYPE IS KEPT ONCE, whatever the second
    query -- zrender's Eventful.on }
  for i := 0 to High(FEventRegs) do
    if (FEventRegs[i].EventType = t)
      and (TMethod(FEventRegs[i].Handler).Code = TMethod(AHandler).Code)
      and (TMethod(FEventRegs[i].Handler).Data = TMethod(AHandler).Data) then
      Exit(FEventRegs[i].Id);
  Inc(FEventNextId);
  SetLength(FEventRegs, Length(FEventRegs) + 1);
  FEventRegs[High(FEventRegs)].Id := FEventNextId;
  FEventRegs[High(FEventRegs)].EventType := t;
  FEventRegs[High(FEventRegs)].Query := TyEventQueryOf(AQuery);
  FEventRegs[High(FEventRegs)].Handler := AHandler;
  Result := FEventNextId;
end;

procedure TTyAdvanceChart.ChartOff(AId: Integer);
var i, k: Integer;
begin
  for i := 0 to High(FEventRegs) do
    if FEventRegs[i].Id = AId then
    begin
      for k := i to High(FEventRegs) - 1 do FEventRegs[k] := FEventRegs[k + 1];
      SetLength(FEventRegs, Length(FEventRegs) - 1);
      Exit;
    end;
end;

function SeriesIdOf(AOption: TTyChartOption; ASeriesIndex: Integer): string;
var n, d: TJSONData;
begin
  Result := '';
  if AOption = nil then Exit;
  n := AOption.ComponentAt('series', ASeriesIndex);
  if not (n is TJSONObject) then Exit;
  d := TJSONObject(n).Find('id');
  if (d <> nil) and (d.JSONType in [jtString, jtNumber]) then Result := d.AsString;
end;

procedure TTyAdvanceChart.SilenceSeries(AList: TTyPaintList);
var
  silent: array of Boolean;
  i, k: Integer;
  n, d: TJSONData;
  el: TTyChartElement;
  any: Boolean;
begin
  silent := nil;
  SetLength(silent, FOption.ComponentCount('series'));
  any := False;
  for i := 0 to High(silent) do
  begin
    n := FOption.ComponentAt('series', i);
    { `!!seriesModel.get('silent')`: the series' own, or -- null or not
      written -- the option root's, through the model's parent [F4c] }
    d := TyGetShallowRoot(n, FOption.Root, 'silent');
    silent[i] := TyOptTruthy(d);
    any := any or silent[i];
  end;
  if not any then Exit;
  for k := 0 to AList.Count - 1 do
  begin
    el := AList.Element(k);
    if (el.Datum.Kind <> ctkSeries) or (el.Datum.SeriesIndex < 0)
      or (el.Datum.SeriesIndex > High(silent)) or not silent[el.Datum.SeriesIndex] then
      Continue;
    el.Silent := True;
    AList.SetElement(k, el);
  end;
end;

procedure TTyAdvanceChart.StampCursors(AList: TTyPaintList);
var
  k, si, slot, raw, depth: Integer;
  pe: PTyChartElement;
  st, c: string;
  root, series, item, lvl: TJSONObject;
  rootCur: string;

  function CurOf(AObj: TJSONObject; out AValue: string): Boolean;
  var x: TJSONData;
  begin
    Result := False;
    AValue := '';
    if AObj = nil then Exit;
    x := AObj.Find('cursor');
    if (x = nil) or (x.JSONType = jtNull) then Exit;
    Result := True;
    if x.JSONType = jtString then AValue := x.AsString
    else AValue := x.AsJSON;
  end;

  { getShallow('cursor') up the item model's parents: the item, its level
    (treemap, sunburst) or category (graph), the series, the root; '' none }
  function Chain(AItem, AMid, ASeries: TJSONObject): string;
  begin
    if CurOf(AItem, Result) then Exit;
    if CurOf(AMid, Result) then Exit;
    if CurOf(ASeries, Result) then Exit;
    Result := rootCur;
  end;

  function LevelOf(ASeries: TJSONObject; ADepth: Integer): TJSONObject;
  var x: TJSONData;
  begin
    Result := nil;
    if (ASeries = nil) or (ADepth < 0) then Exit;
    x := ASeries.Find('levels');
    if (x is TJSONArray) and (ADepth < TJSONArray(x).Count)
      and (TJSONArray(x).Items[ADepth] is TJSONObject) then
      Result := TJSONObject(TJSONArray(x).Items[ADepth]);
  end;

  function CategoryOf(ASeries, AItem: TJSONObject): TJSONObject;
  var x, cats: TJSONData; ci: Integer;
  begin
    Result := nil;
    if (ASeries = nil) or (AItem = nil) then Exit;
    x := AItem.Find('category');
    if (x = nil) or (x.JSONType <> jtNumber) then Exit;
    ci := Trunc(x.AsFloat);
    cats := ASeries.Find('categories');
    if (cats is TJSONArray) and (ci >= 0) and (ci < TJSONArray(cats).Count)
      and (TJSONArray(cats).Items[ci] is TJSONObject) then
      Result := TJSONObject(TJSONArray(cats).Items[ci]);
  end;

  function GraphDraggable(ASlot, ARow: Integer): Boolean;
  var q: Integer;
  begin
    Result := False;
    if (ASlot < 0) or (ASlot > High(FGraphNodes)) then Exit;
    for q := 0 to High(FGraphNodes[ASlot]) do
      if FGraphNodes[ASlot][q].Row = ARow then Exit(FGraphNodes[ASlot][q].Draggable);
  end;

begin
  if (FOption = nil) or (AList = nil) then Exit;
  root := nil;
  if FOption.Root is TJSONObject then root := TJSONObject(FOption.Root);
  rootCur := '';
  CurOf(root, rootCur);
  for k := 0 to AList.Count - 1 do
  begin
    pe := AList.Ref(k);
    if (pe^.Datum.Kind <> ctkSeries) or (pe^.Datum.SeriesIndex < 0) then Continue;
    if pe^.Silent or pe^.IsGuide then Continue;
    { a label is a text of its own: the prototype's pointer }
    if pe^.Caption.FontSizeLogical > 0 then Continue;
    si := pe^.Datum.SeriesIndex;
    slot := SlotOfSeries(si);
    if slot < 0 then Continue;
    st := FBindings[slot].SeriesType;
    series := StSeriesNode(si);
    c := '';
    { A LARGE BATCH: LargeSymbolDraw's and LargeLineDraw's 'default'; a
      large candlestick takes its series' cursor }
    if pe^.Shape.Kind = cskLarge then
    begin
      if (st = 'scatter') or (st = 'effectScatter') or (st = TyLinesSeriesTypeName) then
        c := 'default'
      else if st = 'candlestick' then
      begin
        if not CurOf(series, c) then c := rootCur;
      end;
    end
    else if pe^.Datum.DataIndex >= 0 then
    begin
      raw := pe^.Datum.RawDataIndex;
      if raw < 0 then raw := pe^.Datum.DataIndex;
      if (st = 'bar') or (st = 'pictorialBar') or (st = 'candlestick')
        or (st = 'scatter') or (st = 'effectScatter') or (st = 'line')
        or (st = 'pie') or (st = TyTreeSeriesTypeName) then
      begin
        { a line's polyline and area have no row; its symbols do }
        item := StItemNode(si, raw);
        c := Chain(item, nil, series);
      end
      else if st = TySunburstSeriesTypeName then
      begin
        item := StItemNode(si, raw);
        depth := -1;
        if (slot <= High(FSunbursts)) and FSunbursts[slot].Valid
          and (raw <= High(FSunbursts[slot].Hier.Nodes)) then
          depth := FSunbursts[slot].Hier.Nodes[raw].Depth;
        c := Chain(item, LevelOf(series, depth), series);
      end
      else if st = TyTreemapSeriesTypeName then
      begin
        { only a leaf's content rect (TreemapView.renderNode) }
        if (pe^.Anim.Role = carTmRect) and (pe^.Anim.Sub = 1) then
        begin
          item := StItemNode(si, raw);
          depth := -1;
          if (slot <= High(FTreemaps)) and FTreemaps[slot].Valid
            and (raw <= High(FTreemaps[slot].Hier.Nodes)) then
            depth := FTreemaps[slot].Hier.Nodes[raw].Depth;
          c := Chain(item, LevelOf(series, depth), series);
        end;
      end
      else if (st = TyGraphSeriesTypeName) and not pe^.Datum.IsEdge then
      begin
        { setDraggable(draggable, !!itemModel.get('cursor')): 'move' on a
          draggable node with no cursor anywhere up its chain }
        item := StItemNode(si, raw);
        lvl := CategoryOf(series, item);
        c := Chain(item, lvl, series);
        if (c = '') and GraphDraggable(slot, pe^.Datum.DataIndex) then c := 'move';
      end
      else if (st = TySankeySeriesTypeName) and not pe^.Datum.IsEdge then
      begin
        { SankeyView: a draggable node's rect is 'move', whatever else }
        if (slot <= High(FSankeys)) and FSankeys[slot].Valid
          and (pe^.Datum.DataIndex <= High(FSankeys[slot].Nodes))
          and TySankeyDraggable(FSankeys[slot], pe^.Datum.DataIndex) then
          c := 'move';
      end;
    end;
    if c = '' then Continue;
    { the cursor does not decide the paint order: written in place [P2] }
    pe^.Cursor := c;
  end;
end;

function TTyAdvanceChart.SeriesEventModel(ASeriesIndex: Integer): TTyEventModel;
var slot: Integer;
begin
  Result := Default(TTyEventModel);
  slot := SlotOfSeries(ASeriesIndex);
  if slot < 0 then Exit;
  Result.Valid := True;
  Result.MainType := 'series';
  Result.SubType := FBindings[slot].SeriesType;
  Result.Index := ASeriesIndex;
  Result.Name := SeriesModelName(ASeriesIndex);
  Result.Id := SeriesIdOf(FOption, ASeriesIndex);
end;

{ A SERIES ITEM'S params: upstream's getDataParams -- the raw index, the value
  as String() prints it (absent when undefined), 'main' for the tree family's
  data type -- or, for the one element that stands for a whole line, the
  series' own params with selfType 'line', and then only when the series
  says triggerEvent. }
function TTyAdvanceChart.SeriesEventTarget(const ADatum: TTyChartDatumRef;
  AElement: Integer): TTyChartEventTarget;
var
  gel: TTyGfxEl;
  slot: Integer;
  p: TTyChartCallbackParams;
  n, d: TJSONData;
  st: string;
  cv: Double;
  cvText: string;
begin
  Result := Default(TTyChartEventTarget);
  Result.Id := AElement + 1;
  if ADatum.SeriesIndex < 0 then Exit;
  slot := SlotOfSeries(ADatum.SeriesIndex);
  if slot < 0 then Exit;
  st := FBindings[slot].SeriesType;
  if ADatum.DataIndex < 0 then
  begin
    n := FOption.ComponentAt('series', ADatum.SeriesIndex);
    d := nil;
    if n is TJSONObject then d := TJSONObject(n).Find('triggerEvent');
    { [F6a] A LINE'S POLYLINE AND ITS AREA (LineView.packEventData): the
      polyline's eventData with triggerEvent true or 'line', the area's
      with true or 'area' -- either with the deprecated triggerLineEvent
      true -- selfType saying which }
    if (st = 'line') and (FPaintList <> nil) and (AElement >= 0)
      and (AElement < FPaintList.Count) then
    begin
      p := TyChartBlankParams;
      if FPaintList.Element(AElement).Anim.Role = carLineArea then p.SelfType := 'area'
      else p.SelfType := 'line';
      if not (((d <> nil) and (d.JSONType = jtBoolean) and d.AsBoolean)
        or ((d <> nil) and (d.JSONType = jtString) and (d.AsString = p.SelfType))) then
      begin
        d := nil;
        if n is TJSONObject then d := TJSONObject(n).Find('triggerLineEvent');
        if not ((d <> nil) and (d.JSONType = jtBoolean) and d.AsBoolean) then Exit;
      end;
    end
    else
    begin
      if not ((d <> nil) and (d.JSONType = jtBoolean) and d.AsBoolean) then Exit;
      p := TyChartBlankParams;
      p.SelfType := st;
    end;
  end
  else
  begin
    p := TooltipParams(ADatum);
    if ADatum.IsEdge then
    begin
      if Length(p.Values) > 0 then p.ValueText := TyChartValueText(p.Values[0]);
    end
    else if p.Raw.Shape <> rshNone then
      p.ValueText := TyRawItemText(p.Raw);
    if p.ValueText = 'undefined' then p.ValueText := '';
    { a chord node's getDataParams: `params.value == null` takes the
      layout's value [Batch 120] }
    if (not ADatum.IsEdge) and (st = TyChordSeriesTypeName)
      and (slot <= High(FChords)) and FChords[slot].Valid
      and TyChordNodeValue(FChords[slot], ADatum.RawDataIndex, cv, cvText) then
      p.ValueText := cvText;
    if (st = TyTreemapSeriesTypeName) or (st = TySunburstSeriesTypeName)
      or (st = TyTreeSeriesTypeName) then
      p.DataType := 'main';
  end;
  p.ComponentType := 'series';
  p.ComponentSubType := st;
  p.ComponentIndex := ADatum.SeriesIndex;
  p.SeriesType := st;
  p.SeriesIndex := ADatum.SeriesIndex;
  p.SeriesName := SeriesModelName(ADatum.SeriesIndex);
  p.SeriesId := SeriesIdOf(FOption, ADatum.SeriesIndex);
  { A CUSTOM ELEMENT'S info rides the event: CustomSeries.getDataParams
    reads the target element's own [Batch 123] }
  gel := CustomPaintSource(AElement);
  if (gel <> nil) and (gel.Info <> nil) then p.Info := gel.Info.AsJSON;
  Result.HasData := True;
  Result.Params := p;
  Result.Model := SeriesEventModel(ADatum.SeriesIndex);
end;

function TriggersEvent(ANode: TJSONData): Boolean;
var d: TJSONData;
begin
  Result := False;
  if not (ANode is TJSONObject) then Exit;
  d := TJSONObject(ANode).Find('triggerEvent');
  Result := (d <> nil) and (d.JSONType = jtBoolean) and d.AsBoolean;
end;

function TTyAdvanceChart.EventTargetAt(AX, AY: Integer): TTyChartEventTarget;
const
  cKindWord: array[TTyChartTargetKind] of string = ('series', 'markPoint',
    'markLine', 'markArea', 'legend', 'legend', 'legend', 'graphic', 'matrix', 'geo',
    'axis');
var
  i, k, g, a, q, idx, slot, nth: Integer;
  lay: TTyTitleLayout;
  r: TTyRectF;
  el: TTyChartElement;
  d: TTyChartDatumRef;
  node: TJSONData;
  gb: TTyGridBuild;
  axObj: TTyAxis;
  spec: PTyAxisLayoutSpec;
  meas: ITyTextMeasurer;
  lblS, nameS: TTyStyleSet;
  fw, fh: Double;
  kind: TTyMarkerKind;
  mk: TTyMkBlock;
  nm, mainT: string;
  gel: TTyGfxEl;
  piece: TTyBrushPiece;
  mxc: TTyMatrix;
  mxInfo: TTyMatrixCellInfo;
  geo: TTyGeo;

  function Inside(const AR: TTyRectF): Boolean;
  begin
    Result := (AX >= AR.Left) and (AX <= AR.Right) and (AY >= AR.Top)
      and (AY <= AR.Bottom);
  end;

  function Hung(AXa, AYa, AW, AH: Double; AAlign: TTyTitleAlign;
    AVAlign: TTyTitleVAlign): TTyRectF;
  var l, t: Double;
  begin
    case AAlign of
      ttaCentre: l := AXa - AW / 2;
      ttaRight: l := AXa - AW;
    else
      l := AXa;
    end;
    case AVAlign of
      ttvMiddle: t := AYa - AH / 2;
      ttvBottom: t := AYa - AH;
    else
      t := AYa;
    end;
    Result := TyRectF(l, t, l + AW, t + AH);
  end;

  function Boxed(AXa, AYa, AW, AH: Double; AAH: TTyTextAnchorH;
    AAV: TTyTextAnchorV): TTyRectF;
  var l, t: Double;
  begin
    case AAH of
      tahLeft: l := AXa;
      tahRight: l := AXa - AW;
    else
      l := AXa - AW / 2;
    end;
    case AAV of
      tavTop: t := AYa;
      tavBottom: t := AYa - AH;
    else
      t := AYa - AH / 2;
    end;
    Result := TyRectF(l, t, l + AW, t + AH);
  end;

begin
  Result := Default(TTyChartEventTarget);
  Result.Params := TyChartBlankParams;
  { THE BRUSH'S COVERS, z 10000 over everything [Batch 126]: no data, only
    zrender's Draggable }
  if BrushPieceAt(AX, AY, k, q, piece) then
  begin
    Result.Id := -((Int64(9) shl 44) + (Int64(k) shl 36)
      + Int64(BrushCtlOf(k).Covers[q].Serial) * 16 + Ord(piece));
    Result.HdKind := 9;
    Result.HdSeries := k;
    Result.HdRow := BrushCtlOf(k).Covers[q].Serial;
    Result.HdGen := Ord(piece);
    Exit;
  end;
  { A BREAK AREA THAT EXPANDS ON A CLICK, zigzagZ (100) over the rest: no
    data, only its group's click [Batch 132] }
  if BreakAreaAt(AX, AY, k, q) then
  begin
    Result.Id := -((Int64(10) shl 44) + Int64(k) * 1000 + q);
    Result.HdKind := 12;
    Result.HdSeries := k;
    Result.HdRow := q;
    Exit;
  end;
  { THE TITLES, over everything but the tooltip: the text and the subtext are
    two targets }
  for i := 0 to High(FTitles) do
  begin
    lay := FTitles[i];
    if not lay.Valid then Continue;
    for k := 0 to 1 do
    begin
      if (k = 1) and not lay.HasSub then Continue;
      if (k = 0) and ((i > High(FTitleSpecs)) or (FTitleSpecs[i].Text = '')) then Continue;
      if k = 0 then r := Hung(lay.TextX, lay.TextY, lay.TextW, lay.TextH, lay.Align, lay.VAlign)
      else r := Hung(lay.SubX, lay.SubY, lay.SubW, lay.SubH, lay.Align, lay.VAlign);
      if not Inside(r) then Continue;
      { [F6a] `textEl.silent = !link && !triggerEvent` (the subtext's by
        sublink): a silent title is no target -- the pointer goes on to
        what is under it }
      if not TriggersEvent(FOption.ComponentAt('title', i)) then
      begin
        node := FOption.ComponentAt('title', i);
        if not (node is TJSONObject) then Continue;
        if k = 0 then node := TJSONObject(node).Find('link')
        else node := TJSONObject(node).Find('sublink');
        if (node = nil) or not (((node.JSONType = jtString) and (node.AsString <> ''))
          or ((node.JSONType = jtNumber) and (node.AsFloat <> 0))
          or ((node.JSONType = jtBoolean) and node.AsBoolean)
          or (node.JSONType in [jtObject, jtArray])) then Continue;
      end;
      Result.Id := -(1000 + 2 * i + k);
      if TriggersEvent(FOption.ComponentAt('title', i)) then
      begin
        Result.HasData := True;
        Result.Params.ComponentType := 'title';
        Result.Params.ComponentIndex := i;
        Result.Model.Valid := True;
        Result.Model.MainType := 'title';
        Result.Model.Index := i;
      end;
      Exit;
    end;
  end;
  { THE TOOLBOX, z 6 [Batch 125]: no data, only its icons' own handlers }
  if TbHitAt(AX, AY, k, q) then
  begin
    Result.Id := -(8000000 + Int64(k) * 10000 + q);
    Result.HdKind := 8;
    Result.HdSeries := k;
    Result.HdRow := q;
    Result.HdGen := FTbGen;
    Exit;
  end;
  { THE TIMELINE, z 4 [Batch 129]: no data, only its elements' own
    handlers; HdRow the element, HdGen the render that made it }
  if TlHitAt(AX, AY, q) then
  begin
    Result.Id := -(10000000 + Int64(q));
    Result.HdKind := 10;
    Result.HdRow := q;
    Result.HdGen := FTlView.Gen;
    Exit;
  end;
  { THE visualMaps, over the series (z 4) [Batch 116]: no data, only their
    own handlers }
  if VmHitAt(AX, AY, k, q) then
  begin
    Result.Id := -(7000000 + Int64(k) * 10000 + q);
    Result.HdKind := 7;
    Result.HdSeries := k;
    Result.HdRow := q;
    if k <= High(FVmLive) then Result.HdGen := FVmLive[k].Gen;
    Exit;
  end;
  { [F2a] A TREEMAP'S BREADCRUMB ITEM, over its series: a highDownDispatcher
    whose ecData holds only eventData -- componentType 'series', selfType
    'breadcrumb', nodeData (Breadcrumb.ts packEventData) -- no dataIndex, so
    no select and no tooltip; HdGen the solve that drew it }
  if CrumbAt(AX, AY, k, q) then
  begin
    slot := SlotOfSeries(k);
    Result.Id := -(11000000000 + Int64(FTmCrumbGen) * 1000000 + Int64(k) * 1000 + q);
    Result.HdKind := 15;
    Result.HdSeries := k;
    Result.HdRow := q;
    Result.HdGen := FTmCrumbGen;
    Result.HasData := True;
    Result.Params.ComponentType := 'series';
    Result.Params.ComponentSubType := TyTreemapSeriesTypeName;
    Result.Params.ComponentIndex := k;
    Result.Params.SeriesType := TyTreemapSeriesTypeName;
    Result.Params.SeriesIndex := k;
    Result.Params.SeriesName := SeriesModelName(k);
    Result.Params.SelfType := 'breadcrumb';
    if (slot >= 0) and (slot <= High(FTreemaps)) and (q <= High(FTreemaps[slot].Crumbs)) then
    begin
      i := FTreemaps[slot].Crumbs[q].Row;
      nm := '';
      if (i >= 0) and (slot <= High(FStores)) and (FStores[slot] <> nil)
        and (i < FStores[slot].Count) then nm := FStores[slot].GetItemName(i);
      Result.Params.NodeData := '{"dataIndex":' + IntToStr(i) + ',"name":"'
        + StringToJSONString(nm) + '"}';
    end;
    Result.Model := SeriesEventModel(k);
    Exit;
  end;
  { THE DISPLAY LIST: series items, their labels, markers, legend items --
    as DRAWN: in motion, or on a state proxy, the frame (its insertion
    indices are the list's) [Batch 94] }
  { the direct test, then the coarse pointer's fallback [Batch 142] }
  idx := ListHitAt(AX, AY);
  if idx >= 0 then
  begin
    el := FPaintList.Element(idx);
    d := el.Datum;
    Result.Id := idx + 1;
    { A LARGE BATCH is one element: the pointer moving from row to row in
      it is no out and no over; the row is the element's handler's (its
      scan), and with none there is no data at all -- no event, no states
      (a large element has none) [Batch 117] }
    if (d.Kind = ctkSeries) and (d.SeriesIndex >= 0) and (el.Shape.Kind = cskLarge) then
    begin
      k := LargeRowAt(idx, AX, AY);
      slot := SlotOfSeries(d.SeriesIndex);
      if (k >= 0) and (slot >= 0) and (slot <= High(FStores)) and (FStores[slot] <> nil) then
      begin
        Result := SeriesEventTarget(TyChartDatum(d.SeriesIndex, k,
          FStores[slot].GetRawIndex(k)), idx);
        { a select dispatcher, no highlight one [F2b] }
        Result.HdKind := 16;
        Result.HdSeries := d.SeriesIndex;
        Result.HdRow := k;
      end;
      Exit;
    end;
    case d.Kind of
      ctkSeries:
        if d.SeriesIndex >= 0 then
        begin
          Result := SeriesEventTarget(d, idx);
          { the dispatcher behind it [Batch 88] }
          Result.HdSeries := d.SeriesIndex;
          Result.HdRow := d.DataIndex;
          Result.HdEdge := d.IsEdge;
          { a gauge's arc is a dispatcher of its own [F2b] }
          Result.HdPeer := el.Anim.Role = carGaugeProgress;
          if d.DataIndex >= 0 then Result.HdKind := 1 else Result.HdKind := 2;
        end;
      ctkMarkPoint, ctkMarkLine, ctkMarkArea:
        begin
          slot := SlotOfSeries(d.ComponentIndex);
          if slot < 0 then Exit;
          if d.Kind = ctkMarkPoint then kind := mkPoint
          else if d.Kind = ctkMarkLine then kind := mkLine
          else kind := mkArea;
          { THE MARKER MODEL'S OWN INDEX among its kind, and its HOST's
            series fields: MarkerModel.getDataParams }
          nth := 0;
          for k := 0 to High(FMarkers) do
          begin
            if FMarkers[k].SeriesIndex = d.ComponentIndex then Break;
            if FMarkers[k].Blocks[kind].Present then Inc(nth);
          end;
          Result.HasData := True;
          Result.Params.ComponentType := cKindWord[d.Kind];
          Result.Params.ComponentSubType := '';
          Result.Params.ComponentIndex := nth;
          Result.Params.SeriesType := FBindings[slot].SeriesType;
          Result.Params.SeriesIndex := d.ComponentIndex;
          Result.Params.SeriesName := SeriesModelName(d.ComponentIndex);
          Result.Params.SeriesId := SeriesIdOf(FOption, d.ComponentIndex);
          Result.Params.DataIndex := d.DataIndex;
          Result.Params.RawDataIndex := d.DataIndex;
          for k := 0 to High(FMarkers) do
            if FMarkers[k].SeriesIndex = d.ComponentIndex then
            begin
              mk := FMarkers[k].Blocks[kind];
              if kind = mkPoint then
              begin
                for q := 0 to High(mk.Points) do
                  if mk.Points[q].DataIndex = d.DataIndex then
                  begin
                    if mk.Points[q].E.Name.Kind = mvkStr then
                      Result.Params.Name := mk.Points[q].E.Name.Str
                    else if mk.Points[q].E.Name.Kind = mvkNum then
                      Result.Params.Name := TyChartValueText(mk.Points[q].E.Name.Num);
                    if mk.Points[q].E.Value.Kind = mvkNum then
                      Result.Params.ValueText := TyChartValueText(mk.Points[q].E.Value.Num)
                    else if mk.Points[q].E.Value.Kind = mvkStr then
                      Result.Params.ValueText := mk.Points[q].E.Value.Str;
                  end;
              end;
              Break;
            end;
          { a query is matched against the host series }
          Result.Model := SeriesEventModel(d.ComponentIndex);
          { ITS ECData HAS A dataIndex, the marker's, and the host's
            seriesIndex: a click on it dispatches select for the HOST
            series' item at that index [Batch 88] }
          Result.HdKind := 3;
          Result.HdSeries := d.ComponentIndex;
          Result.HdRow := d.DataIndex;
        end;
      ctkLegend:
        begin
          if (d.ComponentIndex > High(FLegends))
            or (d.DataIndex > High(FLegends[d.ComponentIndex].Items)) then Exit;
          nm := FLegends[d.ComponentIndex].Items[d.DataIndex].Name;
          { THE ITEM GROUP'S OWN HANDLERS, whatever triggerEvent says: a
            series legend when getSeriesByName finds one -- filtered or not --
            a data legend otherwise (LegendView.ts:208-292) [Batch 93] }
          Result.HdKind := 4;
          Result.HdSeries := d.ComponentIndex;
          Result.HdRow := d.DataIndex;
          Result.HdName := nm;
          for k := 0 to FOption.ComponentCount('series') - 1 do
            if SeriesModelName(k) = nm then
            begin
              Result.HdLegendSeries := True;
              Break;
            end;
          node := FOption.ComponentAt('legend', d.ComponentIndex);
          if not TriggersEvent(node) then Exit;
          Result.HasData := True;
          Result.Params.ComponentType := 'legend';
          Result.Params.ComponentIndex := d.ComponentIndex;
          Result.Params.DataIndex := d.DataIndex;
          Result.Params.RawDataIndex := d.DataIndex;
          Result.Params.ValueText := nm;
          { the series the name is, the first that answers to it }
          for k := 0 to High(FBindings) do
            if SeriesModelName(FBindings[k].SeriesIndex) = nm then
            begin
              Result.Params.SeriesIndex := FBindings[k].SeriesIndex;
              Break;
            end;
          Result.Model.Valid := True;
          Result.Model.MainType := 'legend';
          Result.Model.SubType := 'plain';
          if (node is TJSONObject) and (TJSONObject(node).Get('type', '') = 'scroll') then
            Result.Model.SubType := 'scroll';
          Result.Model.Index := d.ComponentIndex;
        end;
      ctkGraphic:
        begin
          { [Batch 122] a graphic element: its handlers by its id (a label's
            are its host's), and the event data findEventDispatcher finds --
            its own, else the nearest ancestor's }
          Result.HdKind := 8;
          Result.HdRow := d.DataIndex;
          if (d.DataIndex >= 0) and (d.DataIndex <= High(FGfxPaintEl)) then
          begin
            gel := FGfxPaintEl[d.DataIndex];
            if gel.Host <> nil then gel := gel.Host;
            Result.HdName := gel.Id;
            while (gel <> nil) and not gel.HasEventData do gel := gel.Parent;
            if gel <> nil then
            begin
              Result.HasData := True;
              Result.Params.ComponentType := 'graphic';
              Result.Params.ComponentIndex := d.ComponentIndex;
              Result.Params.Name := gel.EventName;
              if gel.Info <> nil then Result.Params.Info := gel.Info.AsJSON;
              Result.Model.Valid := True;
              Result.Model.MainType := 'graphic';
              Result.Model.Index := d.ComponentIndex;
              Result.Model.Id := FOption.ComponentId('graphic', d.ComponentIndex);
            end;
          end;
        end;
      ctkMatrix:
        begin
          { [Batch 147] A MATRIX CELL, its rect or its label: the cell's
            eventData when the matrix says triggerEvent -- componentType,
            matrixIndex, targetType, the label's text as name, the cell's
            value, its locator pair as coord }
          if not MatrixCellOf(d, mxc, mxInfo) then Exit;
          if not mxc.TriggerEvent then Exit;
          Result.HasData := True;
          Result.Params.ComponentType := 'matrix';
          Result.Params.ComponentIndex := d.ComponentIndex;
          Result.Params.TargetType := mxInfo.Target;
          if mxInfo.HasName then Result.Params.Name := mxInfo.Name;
          if mxInfo.HasText then Result.Params.ValueText := mxInfo.Value;
          SetLength(Result.Params.Coord, 2);
          Result.Params.Coord[0] := mxInfo.Loc[0];
          Result.Params.Coord[1] := mxInfo.Loc[1];
          Result.Model.Valid := True;
          Result.Model.MainType := 'matrix';
          Result.Model.Index := d.ComponentIndex;
          Result.Model.Id := FOption.ComponentId('matrix', d.ComponentIndex);
        end;
      ctkGeo:
        begin
          { [Batch 148] a region group's eventData (resetEventTriggerForRegion)
            -- a path's or its text's -- and the group the dispatcher of its
            hover and its click }
          if (d.ComponentIndex < 0) or (d.ComponentIndex > High(FGeos))
            or (FGeos[d.ComponentIndex] = nil) then Exit;
          geo := FGeos[d.ComponentIndex];
          Result.HdKind := 14;
          Result.HdSeries := d.ComponentIndex;
          { [F6b] the hover's group: the raw index (on an SVG map the
            outermost dispatcher over the element; the region's own else) }
          Result.HdRow := d.RawDataIndex;
          Result.HdGen := geo.Gen;
          Result.HdName := geo.GroupName(d.DataIndex);
          Result.HasData := True;
          Result.Params.ComponentType := 'geo';
          Result.Params.ComponentIndex := d.ComponentIndex;
          Result.Params.Name := Result.HdName;
          Result.Params.Region := geo.GroupRegionJson(d.DataIndex);
          Result.Model.Valid := True;
          Result.Model.MainType := 'geo';
          Result.Model.Index := d.ComponentIndex;
          Result.Model.Id := FOption.ComponentId('geo', d.ComponentIndex);
        end;
      ctkLegendSelector, ctkLegendPager:
        begin
          { [Batch 98] no ECData: an identity and a handler, no event }
          if (d.ComponentIndex < 0) or (d.ComponentIndex > High(FLegends)) then Exit;
          if d.Kind = ctkLegendSelector then Result.HdKind := 5
          else Result.HdKind := 6;
          Result.HdSeries := d.ComponentIndex;
          Result.HdRow := d.DataIndex;
        end;
    end;
    Exit;
  end;
  { THE AXES that say triggerEvent: a label's box, the name's }
  if FBuild = nil then Exit;
  meas := nil;
  for g := 0 to FBuild.GridCount - 1 do
  begin
    gb := FBuild.Grid(g);
    for a := 0 to gb.XAxisCount + gb.YAxisCount - 1 do
    begin
      if a < gb.XAxisCount then axObj := gb.XAxis(a)
      else axObj := gb.YAxis(a - gb.XAxisCount);
      if axObj = nil then Continue;
      mainT := axObj.MainType;
      if mainT = '' then mainT := axObj.Dim + 'Axis';
      if not TriggersEvent(FOption.ComponentAt(mainT, axObj.ComponentIndex)) then Continue;
      spec := gb.SpecFor(axObj);
      if spec = nil then Continue;
      AxisTextStyles(spec, lblS, nameS);
      Result.Model.Valid := True;
      Result.Model.MainType := mainT;
      case axObj.AxisType of
        atCategory: Result.Model.SubType := 'category';
        atTime: Result.Model.SubType := 'time';
        atLog: Result.Model.SubType := 'log';
      else
        Result.Model.SubType := 'value';
      end;
      Result.Model.Index := axObj.ComponentIndex;
      Result.Params.ComponentType := mainT;
      Result.Params.ComponentIndex := axObj.ComponentIndex;
      Result.Params.AxisIndex := axObj.ComponentIndex;
      Result.Params.AxisDimension := axObj.Dim;
      if spec^.NamePlacement.Shown
        and Inside(TyRectF(spec^.NamePlacement.Rect.X, spec^.NamePlacement.Rect.Y,
          spec^.NamePlacement.Rect.X + spec^.NamePlacement.Rect.W,
          spec^.NamePlacement.Rect.Y + spec^.NamePlacement.Rect.H)) then
      begin
        Result.Id := -(200000 + g * 100 + a);
        Result.HasData := True;
        Result.Params.TargetType := 'axisName';
        Result.Params.Name := spec^.NamePlacement.Text;
        Exit;
      end;
      for q := 0 to High(spec^.Placements) do
      begin
        if not spec^.Placements[q].Shown then Continue;
        { A BLOCK IS HIT WHERE ITS PIECES ARE: measuring the text of a
          `{primary|Feb}` would box the tag as well [Batch 104] }
        if Length(spec^.Placements[q].Rt) > 0 then
        begin
          if not Inside(TyRtDeviceBox(spec^.Placements[q].Rt, spec^.Placements[q].X,
            spec^.Placements[q].Y, spec^.RotationRad, spec^.RtScale)) then Continue;
        end
        else
        begin
          if meas = nil then meas := NewTextMeasurer(FPaintListPPI);
          fw := 0;
          fh := 0;
          if meas <> nil then
            meas.MeasureLine(spec^.Placements[q].Text, lblS.FontName,
              ResolveFontSize(lblS), lblS.FontWeight, fw, fh);
          if not Inside(Boxed(spec^.Placements[q].X, spec^.Placements[q].Y, fw, fh,
            spec^.Placements[q].AnchorH, spec^.Placements[q].AnchorV)) then Continue;
        end;
        Result.Id := -(100000 + g * 10000 + a * 1000 + q);
        Result.HasData := True;
        Result.Params.TargetType := 'axisLabel';
        Result.Params.TickIndex := q;
        { A BREAK'S LABEL expands its break on a click [Batch 132] }
        if (q <= High(spec^.LabelBreakKind)) and (spec^.LabelBreakKind[q] <> 0) then
        begin
          { eventData.break: the break's start and end [F4a] }
          if spec^.LabelBreakKind[q] = 1 then Result.Params.BreakType := 'start'
          else Result.Params.BreakType := 'end';
          if q <= High(spec^.LabelBreakLo) then
          begin
            Result.Params.BreakStart := spec^.LabelBreakLo[q];
            Result.Params.BreakEnd := spec^.LabelBreakHi[q];
          end;
          Result.HdKind := 13;
          Result.HdSeries := g * 1000 + a;
          Result.HdRow := spec^.LabelBreakIndex[q];
        end;
        if axObj.Scale is TTyOrdinalScale then
        begin
          Result.Params.ValueText := TTyOrdinalScale(axObj.Scale).GetLabel(spec^.TickValues[q]);
          Result.Params.DataIndex := Round(TTyOrdinalScale(axObj.Scale).TickToOrdinal(spec^.TickValues[q]));
          Result.Params.RawDataIndex := Result.Params.DataIndex;
        end
        { eventData.value is the label's rawLabel: scale.getLabel(tick),
          grouped as the label is [F4a] }
        else if axObj.Scale is TTyTimeScale then
          Result.Params.ValueText := TTyTimeScale(axObj.Scale).GetLabel(spec^.TickValues[q])
        else
          Result.Params.ValueText := TyAxisTickLabel(axObj, spec^.TickValues[q], False, '');
        Exit;
      end;
      Result.Model := Default(TTyEventModel);
      Result.Params := TyChartBlankParams;
    end;
  end;
end;

procedure TTyAdvanceChart.EmitChartEvent(const AType: string;
  const ATarget: TTyChartEventTarget; AX, AY: Integer; AHasOffset: Boolean);
var
  ev: TTyChartEvent;
  regs: array of TTyChartEventReg;
  model: TTyEventModel;
  i: Integer;
begin
  ev := Default(TTyChartEvent);
  ev.EventType := AType;
  ev.HasParams := ATarget.HasData;
  if ev.HasParams then ev.Params := ATarget.Params
  else ev.Params := TyChartBlankParams;
  ev.HasOffset := AHasOffset;
  if AHasOffset then
  begin
    ev.OffsetX := AX;
    ev.OffsetY := AY;
  end;
  if ATarget.HasData then model := ATarget.Model
  else model := Default(TTyEventModel);
  if Assigned(FOnChartEvent) then FOnChartEvent(Self, ev);
  { a copy: a handler may register or unregister }
  regs := Copy(FEventRegs);
  for i := 0 to High(regs) do
    if (regs[i].EventType = AType) and TyEventQueryMatches(regs[i].Query, model, ev) then
      regs[i].Handler(Self, ev);
end;

{ zrender's mousemove: an out to what was hovered when the target changes,
  a move to the new one, an over when it changed -- each only where the
  target carries data }
procedure TTyAdvanceChart.EventMove(AX, AY: Integer);
var
  t: TTyChartEventTarget;
  cancel: Boolean;
begin
  FEvLastX := AX;
  FEvLastY := AY;
  { a graphic element dragged [Batch 122] }
  GfxDragMove(AX, AY);
  { zrender #6198: a hovered element an update removed (a visualMap view
    rebuilt) is looked for again where it was hovered [Batch 116] }
  if (FEvHover.Id <> 0) and (FEvHover.HdKind = 7)
    and ((FEvHover.HdSeries > High(FVmLive))
      or (FEvHover.HdGen <> FVmLive[FEvHover.HdSeries].Gen)) then
    FEvHover := EventTargetAt(FEvHoverX, FEvHoverY);
  { a toolbox icon a render replaced: the same [Batch 125] }
  if (FEvHover.Id <> 0) and (FEvHover.HdKind = 8) and (FEvHover.HdGen <> FTbGen) then
    FEvHover := EventTargetAt(FEvHoverX, FEvHoverY);
  { and a timeline element [Batch 129] }
  if (FEvHover.Id <> 0) and (FEvHover.HdKind = 10)
    and ((FTlView = nil) or (FEvHover.HdGen <> FTlView.Gen)) then
    FEvHover := EventTargetAt(FEvHoverX, FEvHoverY);
  { and a geo region a render replaced [Batch 148] }
  if (FEvHover.Id <> 0) and (FEvHover.HdKind = 14) and (GeoOfTarget(FEvHover) = nil) then
    FEvHover := EventTargetAt(FEvHoverX, FEvHoverY);
  { and a breadcrumb item a solve replaced [F2a] }
  if (FEvHover.Id <> 0) and (FEvHover.HdKind = 15) and (FEvHover.HdGen <> FTmCrumbGen) then
    FEvHover := EventTargetAt(FEvHoverX, FEvHoverY);
  if FEvPreset then t := FEvPresetT
  else t := EventTargetAt(AX, AY);
  FEvPreset := False;
  { zrender's isOutsideBoundary: a point off the canvas hovers nothing
    [F2a: the treemap's own hover said so; every hover is the state
    machine's now] }
  if (AX < FLastRect.Left) or (AY < FLastRect.Top) or (AX > FLastRect.Right)
    or (AY > FLastRect.Bottom) then
  begin
    t := Default(TTyChartEventTarget);
    t.Params := TyChartBlankParams;
  end;
  if (FEvHover.Id <> 0) and (t.Id <> FEvHover.Id) then
  begin
    { the element's own mouseout, bubbled [Batch 116] }
    VmElementEvent('mouseout', FEvHover, AX, AY);
    { a graphic element's handlers; a true answer stops the rest [Batch 122] }
    cancel := GfxElementEvent('mouseout', FEvHover, AX, AY);
    TbMouseOut(FEvHover);
    TlMouseOut(FEvHover);
    { echarts' own mouseout first: the dispatcher leaves emphasis [Batch 88] }
    if not cancel then StHoverOut(FEvHover);
    if FEvHover.HasData and not cancel then EmitChartEvent('mouseout', FEvHover, AX, AY);
    { the visualMaps' zr.on('mouseout') }
    VmZrMouseOut;
  end;
  { the element's mousemove, then zrender's Draggable [Batch 116] }
  VmElementEvent('mousemove', t, AX, AY);
  cancel := GfxElementEvent('mousemove', t, AX, AY);
  VmDragMove(AX, AY);
  { [Batch 150] zrender's zr-level mousemove: a geo's RoamController pans
    here -- after the out, before echarts' own mousemove (registered
    zrEventfulCallAtLast) and before the over, both of which name what was
    found under the pointer before the picture moved }
  if not cancel then GeoRoamMove(AX, AY);
  if t.HasData and not cancel then EmitChartEvent('mousemove', t, AX, AY);
  if (t.Id <> 0) and (t.Id <> FEvHover.Id) then
  begin
    VmElementEvent('mouseover', t, AX, AY);
    TbMouseOver(t);
    TlMouseOver(t);
    cancel := GfxElementEvent('mouseover', t, AX, AY);
    if not cancel then StHoverOver(t);
    if t.HasData and not cancel then EmitChartEvent('mouseover', t, AX, AY);
    VmZrMouseOver(t);
  end;
  FEvHover := t;
  FEvHoverX := AX;
  FEvHoverY := AY;
  { zrender's Draggable on the timeline's checkpoint, after the hover was
    found [Batch 129] }
  TlDragMove(AX, AY);
  { the frame's states [Batch 116] }
  VmApplyStates;
  TlApplyStates;
end;

procedure TTyAdvanceChart.EventDown(AButton: TMouseButton; AX, AY: Integer);
var t: TTyChartEventTarget;
begin
  FEvLastX := AX;
  FEvLastY := AY;
  t := EventTargetAt(AX, AY);
  { ANY BUTTON: zrender records the press whichever it was }
  FEvDownId := t.Id;
  FEvUpId := t.Id;
  FEvDownArmed := True;
  FEvDownX := AX;
  FEvDownY := AY;
  GfxDragStart(t, AX, AY);
  { the timeline's checkpoint is draggable [Batch 129] }
  if AButton = mbLeft then TlDragStart(t);
  if GfxElementEvent('mousedown', t, AX, AY) then Exit;
  if t.HasData then EmitChartEvent('mousedown', t, AX, AY);
end;

{ zrender's mouseup, then -- for the left button, as a browser follows it --
  the click: the same target pressed and released, a press point to judge
  it against, within 4 px of it. A click that passes clears the point; one
  that fails does not. }
procedure TTyAdvanceChart.EventUp(AButton: TMouseButton; AX, AY: Integer);
var t: TTyChartEventTarget;
begin
  t := EventTargetAt(AX, AY);
  FEvUpId := t.Id;
  { zrender's Draggable ends before echarts' own handlers [Batch 116] }
  if AButton = mbLeft then VmDragEnd;
  { the timeline's checkpoint: its dragend changes the index [Batch 129] }
  if AButton = mbLeft then TlDragEnd(AX, AY);
  FGfxDragOn := False;
  if not GfxElementEvent('mouseup', t, AX, AY) and t.HasData then
    EmitChartEvent('mouseup', t, AX, AY);
  if AButton <> mbLeft then
  begin
    VmApplyStates;
    Exit;
  end;
  if (FEvDownId <> FEvUpId) or not FEvDownArmed
    or (Sqrt(Sqr(AX - FEvDownX) + Sqr(AY - FEvDownY)) > 4) then
  begin
    VmApplyStates;
    Exit;
  end;
  FEvDownArmed := False;
  { a piece's item group: its onclick [Batch 116] }
  if (t.HdKind = 7) and (t.HdRow >= 100) and (t.HdRow < 1000) then
    VmPieceClick(t.HdSeries, (t.HdRow - 100) div 2);
  { THE ELEMENT'S OWN HANDLER BEFORE ANY zr-LEVEL ONE: a legend item's click
    is downplay, legendToggleSelect, highlight [Batch 93] }
  if t.HdKind = 8 then TbClick(t.HdSeries, t.HdRow)
  { [Batch 129] a timeline element's onclick }
  else if t.HdKind = 10 then TlClick(t.HdRow)
  { a break area's group, a break label's text: expandAxisBreak [Batch 132] }
  else if t.HdKind = 12 then BreakAreaClickAt(t.HdSeries, t.HdRow)
  else if t.HdKind = 13 then BreakExpandClick(t.HdSeries, t.HdRow)
  { [Batch 148] the geo's map group: GeoView._handleRegionClick }
  else if t.HdKind = 14 then GeoRegionClick(t)
  { [F2a] a breadcrumb item's onclick: the zoom or the drill, before the
    chart's own click }
  else if t.HdKind = 15 then TreemapCrumbSelect(t.HdSeries, t.HdRow)
  else if t.HdKind = 4 then LegendClick(t)
  { [Batch 98] the selector's and the pager's own onclick }
  else if t.HdKind = 5 then LegendSelectorClick(t)
  else if t.HdKind = 6 then LegendPagerClick(t);
  { A GRAPHIC ELEMENT'S onclick, up its groups; a true answer stops
    everything at the zrender root [Batch 122] }
  if GfxElementEvent('click', t, AX, AY) then
  begin
    VmApplyStates;
    Exit;
  end;
  { ECHARTS' OWN CLICK HANDLER FIRST: an item click dispatches select or
    unselect, whatever selectedMode says [Batch 88] }
  StClickSelect(t);
  if t.HasData then EmitChartEvent('click', t, AX, AY);
  VmApplyStates;
  TlApplyStates;
end;

procedure TTyAdvanceChart.EventDblClick(AX, AY: Integer);
var t: TTyChartEventTarget;
begin
  t := EventTargetAt(AX, AY);
  if GfxElementEvent('dblclick', t, AX, AY) then Exit;
  if t.HasData then EmitChartEvent('dblclick', t, AX, AY);
end;

procedure TTyAdvanceChart.EventContextMenu(AX, AY: Integer);
var t: TTyChartEventTarget;
begin
  t := EventTargetAt(AX, AY);
  if GfxElementEvent('contextmenu', t, AX, AY) then Exit;
  if t.HasData then EmitChartEvent('contextmenu', t, AX, AY);
end;

{ THE POINTER LEFT THE CANVAS: an out to what it was over, at the last point
  it was seen, then globalout with nothing -- and what was hovered is
  remembered, so coming back onto it is no over }
procedure TTyAdvanceChart.EventLeave(AX, AY: Integer);
var
  none: TTyChartEventTarget;
  cancel: Boolean;
begin
  cancel := False;
  if FEvHover.Id <> 0 then
  begin
    VmElementEvent('mouseout', FEvHover, AX, AY);
    cancel := GfxElementEvent('mouseout', FEvHover, AX, AY);
    TbMouseOut(FEvHover);
    TlMouseOut(FEvHover);
    if not cancel then StHoverOut(FEvHover);
  end;
  if (FEvHover.Id <> 0) and FEvHover.HasData and not cancel then
    EmitChartEvent('mouseout', FEvHover, AX, AY);
  { zr-level: fired with or without a target [Batch 116] }
  VmZrMouseOut;
  VmApplyStates;
  TlApplyStates;
  none := Default(TTyChartEventTarget);
  none.Params := TyChartBlankParams;
  EmitChartEvent('globalout', none, 0, 0, False);
end;

procedure TTyAdvanceChart.DblClick;
begin
  inherited DblClick;
  if not (csDesigning in ComponentState) then EventDblClick(FEvLastX, FEvLastY);
end;

procedure TTyAdvanceChart.DoContextPopup(MousePos: TPoint; var Handled: Boolean);
begin
  if not (csDesigning in ComponentState) then
    EventContextMenu(MousePos.X, MousePos.Y);
  inherited DoContextPopup(MousePos, Handled);
end;

{ ==================== element states and the selection [Batch 88] ==================== }

const
  cStNames: array[TTyStName] of string = ('select', 'emphasis', 'blur');

{ A NaN NEVER MEETS A COMPARISON HERE: an ordered compare of a NaN raises
  with the FPU traps on, and a visualMap can hand a mark a NaN size or
  width. }
function StPositive(AValue: Double): Boolean;
begin
  Result := not IsNan(AValue) and (AValue > 0);
end;

function StSameNum(A, B: Double): Boolean;
begin
  if IsNan(A) or IsNan(B) then Exit(IsNan(A) and IsNan(B));
  Result := A = B;
end;

{ an element's values at rest, as the state machine keeps them: zrender's
  default lineWidth 1 where the port draws no stroke, so a state that only
  names a border colour draws a one-pixel border as upstream does }
procedure StPush(var AArr: TTyIntegerArray; AValue: Integer);
begin
  SetLength(AArr, Length(AArr) + 1);
  AArr[High(AArr)] := AValue;
end;

function StRestOf(const AEl: TTyChartElement): TTyStObject;
begin
  Result := TyStNoObject;
  if AEl.Style.HasFill then TyStSetColor(Result, stkFill, AEl.Style.FillColor)
  else TyStSetNone(Result, stkFill);
  if StPositive(AEl.Style.StrokeWidthLogical) and (AEl.Style.StrokeColor <> 0) then
    TyStSetColor(Result, stkStroke, AEl.Style.StrokeColor)
  else
    TyStSetNone(Result, stkStroke);
  if StPositive(AEl.Style.StrokeWidthLogical) then
    TyStSetNum(Result, stkLineWidth, AEl.Style.StrokeWidthLogical)
  else
    TyStSetNum(Result, stkLineWidth, 1);
  TyStSetNum(Result, stkOpacity, AEl.Style.Alpha);
  TyStSetNum(Result, stkZ2, AEl.Z2);
  TyStSetNum(Result, stkX, 0);
  TyStSetNum(Result, stkY, 0);
  if AEl.Shape.Kind = cskSector then TyStSetNum(Result, stkR, AEl.Shape.R1)
  else TyStSetNum(Result, stkR, 0);
  TyStSetNum(Result, stkScale, 1);
  TyStSetNum(Result, stkIgnore, Ord(AEl.Ignore));
end;

{ [F3d] the rest colour of AKey as the option's gradient object at APath,
  when that is one }
procedure StRestGradient(var ARest: TTyStObject; const ANodes: array of TJSONObject;
  const APath: array of string; AKey: TTyStKey);
var d: TJSONData;
begin
  d := TyStFind(ANodes, APath);
  if TyStIsGradient(d) then
    TyStSetGradient(ARest, AKey, d.AsJSON, ARest.Color[AKey]);
end;

{ a label's: its anchor (the Text's own x / y), its paint order, whether it
  shows; its fill stays absent -- the automatic ink is the port's }
function StLabelRestOf(const AEl: TTyChartElement): TTyStObject;
begin
  Result := TyStNoObject;
  { the label's own opacity: the host's at build, as defaultOpacity hands it
    over [Batch 90] }
  TyStSetNum(Result, stkOpacity, AEl.Style.Alpha);
  TyStSetNum(Result, stkZ2, AEl.Z2);
  TyStSetNum(Result, stkX, AEl.Caption.X);
  TyStSetNum(Result, stkY, AEl.Caption.Y);
  TyStSetNum(Result, stkR, 0);
  TyStSetNum(Result, stkScale, 1);
  TyStSetNum(Result, stkIgnore, Ord(AEl.Ignore));
end;

function StGuideRestOf(const AEl: TTyChartElement): TTyStObject;
begin
  Result := TyStNoObject;
  { the line's ink, width and smooth at rest [Batch 112] }
  TyStSetColor(Result, stkStroke, AEl.Style.StrokeColor);
  TyStSetNum(Result, stkLineWidth, AEl.Style.StrokeWidthLogical);
  TyStSetNum(Result, stkSmooth, AEl.Caption.LgSmooth);
  TyStSetNum(Result, stkOpacity, AEl.Style.Alpha);
  TyStSetNum(Result, stkZ2, AEl.Z2);
  TyStSetNum(Result, stkX, 0);
  TyStSetNum(Result, stkY, 0);
  TyStSetNum(Result, stkR, 0);
  TyStSetNum(Result, stkScale, 1);
  TyStSetNum(Result, stkIgnore, Ord(AEl.Ignore));
end;

{ A MARKER ELEMENT'S NAME [F2b], as states-misc.js names it: mp<k> a
  markPoint's symbol, ml<k> a markLine's segment and ml<k>.from / .to its
  end symbols, ma<k> a markArea's polygon; '#label' after the item's name for
  its words. k is the marker's data index. }
function StMarkPartOf(const AEl: TTyChartElement): string;
begin
  case AEl.Datum.Kind of
    ctkMarkPoint: Result := 'mp';
    ctkMarkLine: Result := 'ml';
  else
    Result := 'ma';
  end;
  Result := Result + IntToStr(AEl.Datum.DataIndex);
  if AEl.Caption.FontSizeLogical > 0 then Result := Result + '#label'
  else if AEl.Anim.Role = carMarkLineFrom then Result := Result + '.from'
  else if AEl.Anim.Role = carMarkLineTo then Result := Result + '.to';
end;

procedure StShiftShape(var AShape: TTyChartShape; ADX, ADY: Double);
var i: Integer;
begin
  if (ADX = 0) and (ADY = 0) then Exit;
  AShape.Bounds.Left := AShape.Bounds.Left + ADX;
  AShape.Bounds.Right := AShape.Bounds.Right + ADX;
  AShape.Bounds.Top := AShape.Bounds.Top + ADY;
  AShape.Bounds.Bottom := AShape.Bounds.Bottom + ADY;
  AShape.CX := AShape.CX + ADX;
  AShape.CY := AShape.CY + ADY;
  AShape.RotCX := AShape.RotCX + ADX;
  AShape.RotCY := AShape.RotCY + ADY;
  for i := 0 to High(AShape.Points) do
  begin
    AShape.Points[i].X := AShape.Points[i].X + ADX;
    AShape.Points[i].Y := AShape.Points[i].Y + ADY;
  end;
  for i := 0 to High(AShape.Cmds) do
  begin
    AShape.Cmds[i].X1 := AShape.Cmds[i].X1 + ADX;
    AShape.Cmds[i].Y1 := AShape.Cmds[i].Y1 + ADY;
    AShape.Cmds[i].X2 := AShape.Cmds[i].X2 + ADX;
    AShape.Cmds[i].Y2 := AShape.Cmds[i].Y2 + ADY;
    AShape.Cmds[i].X := AShape.Cmds[i].X + ADX;
    AShape.Cmds[i].Y := AShape.Cmds[i].Y + ADY;
  end;
  if AShape.HasCmdBounds then
  begin
    AShape.CmdBounds.Left := AShape.CmdBounds.Left + ADX;
    AShape.CmdBounds.Right := AShape.CmdBounds.Right + ADX;
    AShape.CmdBounds.Top := AShape.CmdBounds.Top + ADY;
    AShape.CmdBounds.Bottom := AShape.CmdBounds.Bottom + ADY;
  end;
end;

function SameColourKey(const A, B: TTyStObject; AKey: TTyStKey): Boolean;
begin
  Result := (A.Has[AKey] = B.Has[AKey]) and (A.None[AKey] = B.None[AKey])
    and (A.None[AKey] or ((A.Color[AKey] = B.Color[AKey])
      { [F3d] a gradient is the same only as itself, lifted or not }
      and (A.GradJson[AKey] = B.GradJson[AKey])
      and ((A.GradJson[AKey] = '') or (A.Lifted[AKey] = B.Lifted[AKey]))));
end;

function StColourValue(const AObj: TTyStObject; AKey: TTyStKey): TTyAnimValue; forward;

{ [F3d] a state object's gradient key as the painter draws it }
function StGradientOf(const AObj: TTyStObject; AKey: TTyStKey;
  out AGrad: TTyChartGradient): Boolean;
begin
  Result := (AObj.GradJson[AKey] <> '') and not AObj.None[AKey]
    and TyAnimGradientOfValue(StColourValue(AObj, AKey), AGrad);
end;

{ THE CURRENT VALUES ONTO A MARK. A colour a state did not change is left as
  the build drew it -- a gradient stays a gradient; a lifted colour over a
  gradient fill leaves the gradient too (the port does not lift a ramp). }
procedure StWriteHost(var AEl: TTyChartElement; const AState: TTyStElement;
  AProxied: Boolean);
var c, r: TTyStObject; g: TTyChartGradient;
begin
  c := AState.Cur;
  r := AState.Rest;
  { ON A PROXY the animatable keys are the frame's: the list keeps the rest
    values, and only the paint order and the visibility are written
    [Batch 94] }
  if AProxied then
  begin
    AEl.Z2 := Round(c.Num[stkZ2]);
    AEl.Ignore := c.Num[stkIgnore] <> 0;
    Exit;
  end;
  if not SameColourKey(c, r, stkFill) then
  begin
    if c.None[stkFill] then AEl.Style.HasFill := False
    { [F3d] a state's gradient -- declared, inherited or lifted }
    else if StGradientOf(c, stkFill, g) then
    begin
      AEl.Style.HasFill := True;
      AEl.Style.FillColor := c.Color[stkFill];
      AEl.Style.FillGradient := g;
    end
    else if not (c.Lifted[stkFill] and (AEl.Style.FillGradient.Kind <> cgkNone)) then
    begin
      AEl.Style.HasFill := True;
      AEl.Style.FillColor := c.Color[stkFill];
      AEl.Style.FillGradient := Default(TTyChartGradient);
    end;
  end;
  if not SameColourKey(c, r, stkStroke) then
  begin
    if c.None[stkStroke] then AEl.Style.StrokeColor := 0
    else if StGradientOf(c, stkStroke, g) then
    begin
      AEl.Style.StrokeColor := c.Color[stkStroke];
      AEl.Style.StrokeGradient := g;
    end
    else if not (c.Lifted[stkStroke] and (AEl.Style.StrokeGradient.Kind <> cgkNone)) then
    begin
      AEl.Style.StrokeColor := c.Color[stkStroke];
      AEl.Style.StrokeGradient := Default(TTyChartGradient);
    end;
  end;
  { the width wherever a stroke is drawn -- zrender's own 1 where the build
    had none -- and a changed one anyway }
  if TyStHasColour(c, stkStroke)
    or not StSameNum(c.Num[stkLineWidth], r.Num[stkLineWidth]) then
    AEl.Style.StrokeWidthLogical := c.Num[stkLineWidth];
  if not StSameNum(c.Num[stkOpacity], r.Num[stkOpacity]) then AEl.Style.Alpha := c.Num[stkOpacity];
  AEl.Z2 := Round(c.Num[stkZ2]);
  StShiftShape(AEl.Shape, c.Num[stkX] - r.Num[stkX], c.Num[stkY] - r.Num[stkY]);
  if (AEl.Shape.Kind = cskSector) and not StSameNum(c.Num[stkR], r.Num[stkR]) then
    AEl.Shape.R1 := c.Num[stkR];
  if not StSameNum(c.Num[stkScale], 1) and StPositive(c.Num[stkScale]) then
    AEl.Shape := TyScaleShape(AEl.Shape, c.Num[stkScale]);
  AEl.Ignore := c.Num[stkIgnore] <> 0;
end;

{ A FOLLOWER: another stretch of the host's own path (a candlestick's
  wicks) -- the colours the states changed, the host's opacity and its
  paint order, the same translation [Batch 90] }
procedure StWriteFollower(var AEl: TTyChartElement; const AHost: TTyStElement;
  AProxied: Boolean);
var c, r: TTyStObject;
begin
  c := AHost.Cur;
  r := AHost.Rest;
  if AProxied then
  begin
    AEl.Z2 := AEl.Z2 + Round(c.Num[stkZ2] - r.Num[stkZ2]);
    AEl.Ignore := c.Num[stkIgnore] <> 0;
    Exit;
  end;
  if not SameColourKey(c, r, stkFill) and AEl.Style.HasFill then
  begin
    if c.None[stkFill] then AEl.Style.HasFill := False
    else AEl.Style.FillColor := c.Color[stkFill];
  end;
  if not SameColourKey(c, r, stkStroke) and (AEl.Style.StrokeColor <> 0) then
  begin
    if c.None[stkStroke] then AEl.Style.StrokeColor := 0
    else AEl.Style.StrokeColor := c.Color[stkStroke];
  end;
  if not StSameNum(c.Num[stkLineWidth], r.Num[stkLineWidth]) then
    AEl.Style.StrokeWidthLogical := c.Num[stkLineWidth];
  if not StSameNum(c.Num[stkOpacity], r.Num[stkOpacity]) then
    AEl.Style.Alpha := c.Num[stkOpacity];
  AEl.Z2 := AEl.Z2 + Round(c.Num[stkZ2] - r.Num[stkZ2]);
  StShiftShape(AEl.Shape, c.Num[stkX] - r.Num[stkX], c.Num[stkY] - r.Num[stkY]);
  AEl.Ignore := c.Num[stkIgnore] <> 0;
end;

procedure StWriteLabel(var AEl: TTyChartElement; const AState: TTyStElement;
  AProxied: Boolean);
var c, r: TTyStObject; dx, dy: Double;
begin
  c := AState.Cur;
  r := AState.Rest;
  { on a proxy the place and the opacity are the frame's; the ink is not
    animated (a Text's style animates its opacity only) [Batch 94] }
  if not AProxied then
  begin
    dx := c.Num[stkX] - r.Num[stkX];
    dy := c.Num[stkY] - r.Num[stkY];
    AEl.Caption.X := c.Num[stkX];
    AEl.Caption.Y := c.Num[stkY];
    StShiftShape(AEl.Shape, dx, dy);
  end;
  AEl.Z2 := Round(c.Num[stkZ2]);
  AEl.Ignore := c.Num[stkIgnore] <> 0;
  { blur: the label's opacity, a tenth of it by default [Batch 90] }
  if not AProxied and not StSameNum(c.Num[stkOpacity], r.Num[stkOpacity]) then
    AEl.Style.Alpha := c.Num[stkOpacity];
  { the ink: a colour a state declares, else the hover's own under emphasis }
  if TyStHasColour(c, stkFill) then
  begin
    AEl.Caption.Colour := c.Color[stkFill];
    if Length(AEl.Caption.RtPieces) > 0 then
      AEl.Caption.RtPieces := TyRtReink(AEl.Caption.RtPieces, c.Color[stkFill],
        False, AEl.Caption.StrokeColour, AEl.Caption.StrokeWidthLogical);
  end
  else if stnEmphasis in AState.States then
    TyCaptionToEmphasis(AEl.Caption);
end;

procedure StWriteGuide(var AEl: TTyChartElement; const AState: TTyStElement;
  AProxied: Boolean);
var c, r: TTyStObject;
begin
  c := AState.Cur;
  r := AState.Rest;
  if not AProxied then
    StShiftShape(AEl.Shape, c.Num[stkX] - r.Num[stkX], c.Num[stkY] - r.Num[stkY]);
  AEl.Z2 := Round(c.Num[stkZ2]);
  AEl.Ignore := c.Num[stkIgnore] <> 0;
  if not AProxied and not StSameNum(c.Num[stkOpacity], r.Num[stkOpacity]) then
    AEl.Style.Alpha := c.Num[stkOpacity];
  { the state's lineStyle and smooth (a state that does not say draws it
    straight) [Batch 112] }
  if c.Has[stkStroke] then AEl.Style.StrokeColor := c.Color[stkStroke];
  if c.Has[stkLineWidth] then AEl.Style.StrokeWidthLogical := c.Num[stkLineWidth];
  if c.Has[stkSmooth] and not StSameNum(c.Num[stkSmooth], r.Num[stkSmooth]) then
    AEl.Shape.Cmds := TyLabelLineCmds(AEl.Shape.Points, c.Num[stkSmooth]);
end;

{ AN ITEM'S emphasis.label.show AS THE MODEL HOLDS IT [F2b]: the first
  node that writes it, a data item that writes a label.show of its own
  having it copied (Series.fillDataTextStyle's defaultEmphasis); the series'
  default its type's (ADefault: a funnel's true) or else its normal show
  (mergeDefaultAndTheme's defaultEmphasis -- the same as normal, so no
  change). AHas False when nothing says. }
function StEmphLabelShow(const ANodes: array of TJSONObject; ADefaultTrue: Boolean;
  out AHas: Boolean): Boolean;
var i: Integer; d: TJSONData;
begin
  Result := False;
  AHas := False;
  for i := 0 to High(ANodes) do
  begin
    if ANodes[i] = nil then Continue;
    d := TyStFind([ANodes[i]], ['emphasis', 'label', 'show']);
    if d <> nil then
    begin
      AHas := True;
      Exit(TyStReadBool([ANodes[i]], ['emphasis', 'label', 'show'], AHas));
    end;
    { a data item's own label.show is its emphasis one too }
    if (i = 0) and (High(ANodes) > 0) and (TyStFind([ANodes[i]], ['label', 'show']) <> nil) then
      Exit(TyStReadBool([ANodes[i]], ['label', 'show'], AHas));
  end;
  if ADefaultTrue then
  begin
    AHas := True;
    Result := True;
  end;
end;

function TTyAdvanceChart.StKindOf(ASlot: Integer): TTyStKind;
var t: string;
begin
  Result := sskNone;
  if (ASlot < 0) or (ASlot > High(FBindings)) then Exit;
  { a radar's items, drawn by a builder of its own [F2b; on the overlay
    before]; a calendar's scatter and heatmap are the cartesian ones'
    elements [Batch 90] }
  if FBindings[ASlot].RadarIndex >= 0 then
  begin
    if FBindings[ASlot].SeriesType = 'radar' then Result := sskRadar;
    Exit;
  end;
  t := FBindings[ASlot].SeriesType;
  if t = 'bar' then Result := sskBar
  else if t = TyPieSeriesTypeName then Result := sskPie
  else if (t = 'line') or (t = 'scatter') or (t = 'effectScatter') then
    Result := sskSymbol
  else if t = 'heatmap' then Result := sskRect
  else if t = 'funnel' then Result := sskFunnel
  else if t = 'candlestick' then Result := sskCandle
  else if t = TyPictorialSeriesTypeName then Result := sskPictorial
  else if t = TySunburstSeriesTypeName then Result := sskSunburst
  else if t = 'boxplot' then Result := sskBox
  else if t = TySankeySeriesTypeName then Result := sskSankey
  else if t = TyThemeRiverSeriesTypeName then Result := sskRiver
  else if t = TyChordSeriesTypeName then Result := sskChord
  { a lines series' rows, not in large mode (a batch has no states)
    [Batch 121] }
  else if (t = TyLinesSeriesTypeName) and not ((ASlot <= High(FLines))
    and FLines[ASlot].IsLarge) then Result := sskLines
  { a custom series' items [Batch 123] }
  else if t = TyCustomSeriesType then Result := sskCustom
  { a parallel row's polyline [Batch 128] }
  else if (t = TyParallelSeriesTypeName) and (FBindings[ASlot].Parallel <> nil) then
    Result := sskParallel
  { a map series' regions [Batch 152] }
  else if t = TyMapSeriesTypeName then
    Result := sskMap
  { [F2a] a laid-out graph, a solved tree, a solved treemap }
  else if (t = TyGraphSeriesTypeName) and (ASlot <= High(FGraphLaidOut))
    and FGraphLaidOut[ASlot] then Result := sskGraph
  else if (t = TyTreeSeriesTypeName) and (ASlot <= High(FTrees)) and FTrees[ASlot].Valid then
    Result := sskTree
  else if (t = TyTreemapSeriesTypeName) and (ASlot <= High(FTreemaps))
    and FTreemaps[ASlot].Valid then Result := sskTreemap
  { a gauge's pointers and arcs [F2b; on the overlay before] }
  else if t = TyGaugeSeriesTypeName then
    Result := sskGauge;
  { a line on a calendar is not drawn at all }
  if (FBindings[ASlot].CalendarIndex >= 0) and (t = 'line') then Result := sskNone;
end;

function TTyAdvanceChart.StSeriesNode(ASeriesIndex: Integer): TJSONObject;
var d: TJSONData;
begin
  Result := nil;
  if FOption = nil then Exit;
  d := FOption.ComponentAt('series', ASeriesIndex);
  if d is TJSONObject then Result := TJSONObject(d);
end;

function TTyAdvanceChart.StItemNode(ASeriesIndex, ARaw: Integer): TJSONObject;
var s: TJSONObject; d: TJSONData; slot: Integer;
begin
  Result := nil;
  { A SUNBURST'S DATA IS ITS TREE: the row's own node [Batch 90] }
  slot := SlotOfSeries(ASeriesIndex);
  if (slot >= 0) and (slot <= High(FSunbursts)) and FSunbursts[slot].Valid then
  begin
    if (ARaw >= 0) and (ARaw <= High(FSunbursts[slot].Hier.Nodes))
      and (FSunbursts[slot].Hier.Nodes[ARaw].Item is TJSONObject) then
      Result := TJSONObject(FSunbursts[slot].Hier.Nodes[ARaw].Item);
    Exit;
  end;
  { [F2a] A TREE'S AND A TREEMAP'S DATA IS THEIR HIERARCHY: the row's own
    node; a graph's nodes are `data || nodes` }
  if (slot >= 0) and (FBindings[slot].SeriesType = TyTreeSeriesTypeName)
    and (slot <= High(FTrees)) and FTrees[slot].Valid then
  begin
    if (ARaw >= 0) and (ARaw <= High(FTrees[slot].Hier.Nodes))
      and (FTrees[slot].Hier.Nodes[ARaw].Item is TJSONObject) then
      Result := TJSONObject(FTrees[slot].Hier.Nodes[ARaw].Item);
    Exit;
  end;
  if (slot >= 0) and (FBindings[slot].SeriesType = TyTreemapSeriesTypeName)
    and (slot <= High(FTreemaps)) and FTreemaps[slot].Valid then
  begin
    if (ARaw >= 0) and (ARaw <= High(FTreemaps[slot].Hier.Nodes))
      and (FTreemaps[slot].Hier.Nodes[ARaw].Item is TJSONObject) then
      Result := TJSONObject(FTreemaps[slot].Hier.Nodes[ARaw].Item);
    Exit;
  end;
  if (slot >= 0) and (FBindings[slot].SeriesType = TyGraphSeriesTypeName) then
  begin
    s := StSeriesNode(ASeriesIndex);
    if s = nil then Exit;
    d := s.Find('data');
    if (d = nil) or (d.JSONType = jtNull) then d := s.Find('nodes');
    if (d is TJSONArray) and (ARaw >= 0) and (ARaw < d.Count)
      and (TJSONArray(d).Items[ARaw] is TJSONObject) then
      Result := TJSONObject(TJSONArray(d).Items[ARaw]);
    Exit;
  end;
  { A CHORD'S NODE: its item of `data || nodes` [Batch 120] }
  if (slot >= 0) and (slot <= High(FChords)) and FChords[slot].Valid then
  begin
    if (ARaw >= 0) and (ARaw <= High(FChords[slot].Nodes)) then
      Result := FChords[slot].Nodes[ARaw].Obj;
    Exit;
  end;
  s := StSeriesNode(ASeriesIndex);
  if s = nil then Exit;
  d := s.Find('data');
  if not (d is TJSONArray) then Exit;
  if (ARaw < 0) or (ARaw >= TJSONArray(d).Count) then Exit;
  d := TJSONArray(d).Items[ARaw];
  if d is TJSONObject then Result := TJSONObject(d);
end;

{ tokens.color.primary -- the ink a title is written in, which is how the
  skin says it }
function TTyAdvanceChart.StMemoMatches(ASeries: Integer;
  const ANodes: TTyStNodeArray; const ABlock: string): Boolean;
var k: Integer;
begin
  Result := False;
  if not FStMemoOk or (ASeries <> FStMemoS) or (Length(ANodes) = 0) or (ANodes[0] <> nil)
    or (Length(ANodes) <> Length(FStMemoNodes)) or (ABlock <> FStMemoBlk) then Exit;
  for k := 1 to High(ANodes) do
    if ANodes[k] <> FStMemoNodes[k] then Exit;
  Result := True;
end;

function TTyAdvanceChart.StPrimaryInk: TTyChartColor;
begin
  { ONCE PER SYNC: every row of a bar or a scatter asked the theme for it
    [P2]; outside a sync it is asked afresh }
  if FStInkHeld then Exit(FStInk);
  Result := TTyChartColor(ActiveController.Model.ResolveStyle('TyAdvChartTitle',
    '', []).TextColor);
  if FStInkHold then
  begin
    FStInk := Result;
    FStInkHeld := True;
  end;
end;

procedure TTyAdvanceChart.StDeclareItem(ASlot, ARaw: Integer;
  AList: TTyPaintList; APPI: Integer);
var
  blk: string;
  s, idx, labIdx: Integer;
  lineShow, labRest, labIgn, ownLine, emphLine, seriesLine, labShow, emphLab: Boolean;
  item: PTyStItem;
  ph, pc, pg, pp: PTyChartElement;
  nodes: TTyStNodeArray;
  scale, off, mid, dx, dy, ss, half: Double;
  has, bolder, disabled, was, normalShow, stShow, doScale: Boolean;
  base, obj: TTyStObject;
  spec: TTyChartEmphasisSpec;
  n: TTyStName;
  txt: string;
  c: TTyChartColor;
  k: Integer;
begin
  s := FBindings[ASlot].SeriesIndex;
  if FSt[s].Kind = sskCustom then
  begin
    StDeclareCustom(ASlot, ARaw, AList);
    Exit;
  end;
  { a treemap's rects [F2a] }
  if FSt[s].Kind = sskTreemap then
  begin
    StDeclareTreemap(ASlot, ARaw, AList);
    Exit;
  end;
  { A MAP REGION'S ROW: only its flags matter here -- the region group's
    paths take them through the geo [Batch 152] }
  if FSt[s].Kind = sskMap then
  begin
    item := @FSt[s].Rows[ARaw];
    item^.Host.Exists := True;
    item^.Host.IsPath := True;
    nodes := StNodes(s, ARaw);
    item^.Host.Proxy := not TyStReadBool(nodes, ['emphasis', 'disabled'], has);
    for n := Low(TTyStName) to High(TTyStName) do item^.Host.HasState[n] := True;
    Exit;
  end;
  item := @FSt[s].Rows[ARaw];
  ph := AList.Ref(FSt[s].HostIdx[ARaw]);
  nodes := StNodes(s, ARaw);
  if APPI > 0 then scale := APPI / 96 else scale := 1;

  { ---- the mark ---- }
  item^.Host.Exists := True;
  item^.Host.IsPath := True;
  { a symbol (a line's, a scatter's): the group dispatches, the path draws
    [Batch 90] }
  item^.HasGroup := FSt[s].Kind in [sskSymbol, sskGraph, sskTree];
  { a gauge's pointer: z2EmphasisLift 0 [F2b] }
  item^.Host.NoEmphLift := FSt[s].Kind = sskGauge;
  { emphasis.disabled: no hover dispatcher and no default proxy }
  disabled := TyStReadBool(nodes, ['emphasis', 'disabled'], has);
  item^.Host.Proxy := not disabled;
  for n := Low(TTyStName) to High(TTyStName) do item^.Host.HasState[n] := True;
  item^.Host.Rest := StRestOf(ph^);
  { THE SELECT LOOK the series type brings under what is declared: a bar's
    and a scatter's border in the primary ink (BarSeries.ts:165,
    ScatterSeries.ts:151); a pie's and a line's nothing }
  base := TyStNoObject;
  case FSt[s].Kind of
    sskBar:
      begin
        TyStSetColor(base, stkStroke, StPrimaryInk);
        TyStSetNum(base, stkLineWidth, 2);
      end;
    sskSymbol:
      if not FSt[s].IsLine then TyStSetColor(base, stkStroke, StPrimaryInk);
    { a heatmap's, a funnel's and a pictorial bar's: the border only
      (HeatmapSeries.ts:130, FunnelSeries.ts:200, PictorialBarSeries.ts:173)
      [Batch 90] }
    sskRect, sskFunnel, sskPictorial,
    { a sankey node's: select.itemStyle.borderColor (SankeySeries.ts)
      [Batch 114]; a graph node's (GraphSeries.ts select.itemStyle) [F2a] }
    sskSankey, sskGraph:
      TyStSetColor(base, stkStroke, StPrimaryInk);
  end;
  { a lines row's: its lineStyle's (Line._updateCommonStl) [Batch 121] }
  { [F2b] a radar's polyline: setStatesStylesFromModel(polyline, itemModel,
    'lineStyle') }
  if FSt[s].Kind in [sskLines, sskParallel, sskRadar] then blk := 'lineStyle'
  else blk := 'itemStyle';
  { A ROW WITH NO OBJECT OF ITS OWN reads its states from the rest of its
    chain alone -- as the last such row did, when the chain and the block
    are the same: those three asked once per series in a sync [P2] }
  if FStInkHold and StMemoMatches(s, nodes, blk) then
  begin
    item^.Host.Decl[stnSelect] := FStMemoDecl[0];
    item^.Host.Decl[stnEmphasis] := FStMemoDecl[1];
    item^.Host.Decl[stnBlur] := FStMemoDecl[2];
  end
  else
  begin
    item^.Host.Decl[stnSelect] := TyStOverlay(base,
      TyStReadStyle(nodes, 'select', blk, bolder));
    item^.Host.Decl[stnEmphasis] := TyStReadStyle(nodes, 'emphasis', blk, bolder);
    item^.Host.Decl[stnBlur] := TyStReadStyle(nodes, 'blur', blk, bolder);
    if FStInkHold and (Length(nodes) > 0) and (nodes[0] = nil) then
    begin
      FStMemoOk := True;
      FStMemoS := s;
      FStMemoBlk := blk;
      FStMemoNodes := Copy(nodes, 0, Length(nodes));
      FStMemoDecl[0] := item^.Host.Decl[stnSelect];
      FStMemoDecl[1] := item^.Host.Decl[stnEmphasis];
      FStMemoDecl[2] := item^.Host.Decl[stnBlur];
    end;
  end;
  { [F3d] A GRADIENT AT REST is the option's object (the element's
    style.fill is it): the state's tween starts from it, and the emphasis
    lifts it }
  if blk = 'itemStyle' then
  begin
    if ph^.Style.FillGradient.Kind <> cgkNone then
      StRestGradient(item^.Host.Rest, nodes, ['itemStyle', 'color'], stkFill);
    if ph^.Style.StrokeGradient.Kind <> cgkNone then
      StRestGradient(item^.Host.Rest, nodes, ['itemStyle', 'borderColor'], stkStroke);
  end;
  if FSt[s].Kind = sskCandle then StDeclareCandle(ASlot, ARaw, nodes, item^.Host);
  { a boxplot's emphasis border is 2 wide unless declared (BoxplotSeries.ts
    emphasis.itemStyle); its shadow is not drawn here [Batch 108] }
  if (FSt[s].Kind = sskBox) and not item^.Host.Decl[stnEmphasis].Has[stkLineWidth] then
    TyStSetNum(item^.Host.Decl[stnEmphasis], stkLineWidth, 2);
  { a sunburst blurs to 0.2 unless told (SunburstSeries.ts:274-279) [Batch 90] }
  if (FSt[s].Kind = sskSunburst) and not item^.Host.Decl[stnBlur].Has[stkOpacity] then
    TyStSetNum(item^.Host.Decl[stnBlur], stkOpacity, 0.2);
  dx := 0;
  dy := 0;
  case FSt[s].Kind of
    sskPie:
      begin
        { PieView.ts:128-150: the SERIES' selectedOffset along the mid angle,
          and the emphasis radius the layout's plus scaleSize }
        off := TyStReadNumber([nodes[1]], ['selectedOffset'], has);
        if not has or IsNan(off) then off := 10;
        mid := (ph^.Shape.StartRad + ph^.Shape.EndRad) / 2;
        if IsNan(mid) or IsNan(off) then mid := 0;
        dx := TyJsCos(mid) * (off * scale);
        dy := TyJsSin(mid) * (off * scale);
        TyStSetNum(item^.Host.Decl[stnSelect], stkX, dx);
        TyStSetNum(item^.Host.Decl[stnSelect], stkY, dy);
        doScale := TyStReadBool(nodes, ['emphasis', 'scale'], has);
        if not has then doScale := True;
        if doScale then
        begin
          ss := TyStReadNumber(nodes, ['emphasis', 'scaleSize'], has);
          if not has then ss := 5
          else if IsNan(ss) then ss := 0;
          TyStSetNum(item^.Host.Decl[stnEmphasis], stkR, ph^.Shape.R1 + ss * scale);
        end;
      end;
    sskSymbol:
      begin
        { Symbol.ts:218-357: the path grows by the emphasis ratio -- the
          series' spec read once per sync [P2] }
        if FStInkHold and (FStMemoSpecNode <> nil) and (FStMemoSpecNode = nodes[1]) then
          spec := FStMemoSpec
        else
        begin
          spec := TyChartReadEmphasis(nodes[1]);
          if FStInkHold and (nodes[1] <> nil) then
          begin
            FStMemoSpecNode := nodes[1];
            FStMemoSpec := spec;
          end;
        end;
        if nodes[0] <> nil then
          spec := TyChartMergeEmphasis(spec, TyChartReadEmphasis(nodes[0]));
        half := (ph^.Shape.Bounds.Bottom - ph^.Shape.Bounds.Top) / 2;
        if ph^.Shape.Kind in [cskCircle, cskEllipse] then half := ph^.Shape.R1;
        { a symbol of no size or a NaN one keeps its size }
        if StPositive(half) then
          TyStSetNum(item^.Host.Decl[stnEmphasis], stkScale,
            TyChartSymbolScaleRatio(spec, half / scale));
      end;
    sskPictorial:
      { emphasis.scale (default false): every glyph a tenth larger about its
        own origin (PictorialBarView.ts:920-924) [Batch 90] }
      if TyStReadBool(nodes, ['emphasis', 'scale'], has) then
        TyStSetNum(item^.Host.Decl[stnEmphasis], stkScale, 1.1);
    { [F2a] A GRAPH'S AND A TREE'S NODE IS A Symbol: emphasis.scale along
      item -> category / leaves -> series over its own half size
      (`this._sizeY`, the symbol size as written, before any view scale) }
    sskGraph, sskTree:
      begin
        if FSt[s].Kind = sskGraph then
        begin
          k := StGraphNodeOfRaw(ASlot, ARaw);
          spec := GraphEmphasisOf(ASlot, False, k);
          half := NaN;
          if k >= 0 then
          begin
            if FGraphNodes[ASlot][k].HasSize then half := FGraphNodes[ASlot][k].SizeH / 2
            else half := FGraphSpecs[ASlot].Symbol.HeightPx / 2;
          end;
        end
        else
        begin
          spec := TreeEmphasisOf(ASlot, ARaw);
          half := (ph^.Shape.Bounds.Bottom - ph^.Shape.Bounds.Top) / 2;
          if ph^.Shape.Kind in [cskCircle, cskEllipse] then half := ph^.Shape.R1;
          if FTrees[ASlot].HasView and StPositive(FTrees[ASlot].VZ * FTrees[ASlot].VNS) then
            half := half / (FTrees[ASlot].VZ * FTrees[ASlot].VNS);
        end;
        if StPositive(half) then
          TyStSetNum(item^.Host.Decl[stnEmphasis], stkScale,
            TyChartSymbolScaleRatio(spec, half));
      end;
  end;

  { ---- the other glyphs: the host's declared states on their own rest
    values; a new one takes the host's list [Batch 90] ---- }
  if Length(item^.Parts) <> Length(FSt[s].PartIdx[ARaw]) then
    SetLength(item^.Parts, 0);
  was := Length(item^.Parts) > 0;
  SetLength(item^.Parts, Length(FSt[s].PartIdx[ARaw]));
  for k := 0 to High(item^.Parts) do
  begin
    item^.Parts[k].Exists := True;
    item^.Parts[k].IsPath := True;
    item^.Parts[k].Proxy := item^.Host.Proxy;
    for n := Low(TTyStName) to High(TTyStName) do
    begin
      item^.Parts[k].HasState[n] := True;
      item^.Parts[k].Decl[n] := item^.Host.Decl[n];
    end;
    item^.Parts[k].Rest := StRestOf(AList.Element(FSt[s].PartIdx[ARaw][k]));
    { A LINES END SYMBOL: each state's the line's stroke as its fill (its
      stroke when it is empty) and the line's opacity, where the line's
      state says them; its own proxy lifts and blurs the rest [Batch 121] }
    if FSt[s].Kind = sskLines then
      for n := Low(TTyStName) to High(TTyStName) do
      begin
        obj := TyStNoObject;
        if item^.Host.Decl[n].Has[stkStroke] then
        begin
          if AList.Element(FSt[s].PartIdx[ARaw][k]).Anim.G[10] <> 0 then
            obj.Has[stkStroke] := True
          else
            obj.Has[stkFill] := True;
          if obj.Has[stkStroke] then
          begin
            obj.Color[stkStroke] := item^.Host.Decl[n].Color[stkStroke];
            obj.None[stkStroke] := item^.Host.Decl[n].None[stkStroke];
          end
          else
          begin
            obj.Color[stkFill] := item^.Host.Decl[n].Color[stkStroke];
            obj.None[stkFill] := item^.Host.Decl[n].None[stkStroke];
          end;
        end;
        if item^.Host.Decl[n].Has[stkOpacity] then
          TyStSetNum(obj, stkOpacity, item^.Host.Decl[n].Num[stkOpacity]);
        item^.Parts[k].Decl[n] := obj;
      end;
    { A RADAR ITEM'S OTHER PATHS [F2b] (RadarView.ts:212-229): the polygon
      reads areaStyle and every state its own ignore -- hidden only where
      the polygon is at rest and the state's areaStyle is written nowhere
      (item, series); a symbol reads itemStyle }
    if FSt[s].Kind = sskRadar then
    begin
      pp := AList.Ref(FSt[s].PartIdx[ARaw][k]);
      for n := Low(TTyStName) to High(TTyStName) do
        if pp^.Anim.Role = carRadarArea then
        begin
          obj := TyStReadStyle(nodes, cStNames[n], 'areaStyle', bolder);
          TyStSetNum(obj, stkIgnore, Ord(pp^.Ignore
            and (TyStFind(nodes, [cStNames[n], 'areaStyle']) = nil)));
          item^.Parts[k].Decl[n] := obj;
        end
        else
          item^.Parts[k].Decl[n] := TyStReadStyle(nodes, cStNames[n], 'itemStyle', bolder);
    end;
    if not was then
    begin
      item^.Parts[k].Cur := item^.Parts[k].Rest;
      item^.Parts[k].States := [];
      if item^.Host.States <> [] then
        TyStUseStates(item^.Parts[k], item^.Host.States);
    end;
  end;

  { ---- its label: the host's states, its own select / emphasis / blur
    label style (labelStyle.ts:255-273) ---- }
  idx := FSt[s].LabelIdx[ARaw];
  was := item^.Label_.Exists;
  if (idx < 0) and (FSt[s].Kind = sskPie) then
  begin
    { A PIE ALWAYS OWNS A TEXT (PieView.ts:49-51), hidden when no state shows
      it: it takes its slice's list, a select state of its own (the offset)
      and -- with no emphasis or blur object unless some state's label.show
      created the text's states -- no emphasis lift, but the blur proxy's
      opacity all the same. Nothing of it is drawn. [Batch 90] }
    normalShow := False;
    stShow := False;
    for n := Low(TTyStName) to High(TTyStName) do
      if TyStReadBool(nodes, [cStNames[n], 'label', 'show'], has) and has then
        stShow := True;
    item^.Label_.Exists := True;
    item^.Label_.IsPath := False;
    item^.Label_.Proxy := not disabled;
    item^.Label_.HasState[stnSelect] := True;
    item^.Label_.HasState[stnEmphasis] := stShow;
    item^.Label_.HasState[stnBlur] := stShow;
    obj := TyStNoObject;
    TyStSetNum(obj, stkOpacity, 1);
    TyStSetNum(obj, stkZ2, ph^.Z2 + 2);
    TyStSetNum(obj, stkX, 0);
    TyStSetNum(obj, stkY, 0);
    TyStSetNum(obj, stkR, 0);
    TyStSetNum(obj, stkScale, 1);
    TyStSetNum(obj, stkIgnore, 1);
    item^.Label_.Rest := obj;
    for n := Low(TTyStName) to High(TTyStName) do
      item^.Label_.Decl[n] := TyStNoObject;
    TyStSetNum(item^.Label_.Decl[stnSelect], stkX, dx);
    TyStSetNum(item^.Label_.Decl[stnSelect], stkY, dy);
    if not was then
    begin
      item^.Label_.Cur := item^.Label_.Rest;
      item^.Label_.States := [];
      if item^.Host.Exists and (item^.Host.States <> []) then
        TyStUseStates(item^.Label_, item^.Host.States);
    end;
  end
  else if idx < 0 then
    item^.Label_ := Default(TTyStElement)
  else
  begin
    pc := AList.Ref(idx);
    item^.Label_.Exists := True;
    item^.Label_.IsPath := False;
    item^.Label_.Proxy := not disabled;
    for n := Low(TTyStName) to High(TTyStName) do item^.Label_.HasState[n] := True;
    item^.Label_.Rest := StLabelRestOf(pc^);
    { NORMAL SHOW AS THE LABEL WAS STYLED: hideOverlap hides it later, and
      that is no `show: false` [Batch 103] }
    normalShow := (not pc^.Ignore) or pc^.Caption.LmOverlapHidden;
    for n := Low(TTyStName) to High(TTyStName) do
    begin
      obj := TyStNoObject;
      { ignore = !show only when the state's show differs from the normal one }
      stShow := TyStReadBool(nodes, [cStNames[n], 'label', 'show'], has);
      { a themeRiver's model shows the emphasis label unless told
        (ThemeRiverSeries.ts emphasis.label.show) [Batch 118]; a funnel's
        too (FunnelSeries.defaultOption) [F2b]; a graph's by
        GraphSeries.ts emphasis.label.show [F2a] }
      if (n = stnEmphasis) and (FSt[s].Kind in [sskRiver, sskFunnel]) then
        stShow := StEmphLabelShow(nodes, True, has)
      else if (n = stnEmphasis) and (FSt[s].Kind = sskGraph) then
      begin
        stShow := GraphEmLabelShow(nodes[0], nodes[1], nodes[2]);
        has := True;
      end
      else if n = stnEmphasis then
        stShow := StEmphLabelShow(nodes, False, has);
      if has and (stShow <> normalShow) then TyStSetNum(obj, stkIgnore, Ord(not stShow));
      { hideOverlap's hideEl: a label it hid shows again under emphasis,
        unless that state already says (LabelLayoutHelper.ts hideOverlap)
        [Batch 103] }
      if (n = stnEmphasis) and pc^.Caption.LmEmphShow and not obj.Has[stkIgnore] then
        TyStSetNum(obj, stkIgnore, 0);
      txt := TyStReadString(nodes, [cStNames[n], 'label', 'color'], has);
      if has and (txt <> 'inherit') and (txt <> 'auto')
        and TyTryParseChartColor(txt, c) then
        TyStSetColor(obj, stkFill, c);
      { a declared opacity, the blur proxy's tenth otherwise [Batch 90] }
      ss := TyStReadNumber(nodes, [cStNames[n], 'label', 'opacity'], has);
      if has and not IsNan(ss) then TyStSetNum(obj, stkOpacity, ss)
      { a sunburst's label blurs to 0.1 by its series' default }
      else if (n = stnBlur) and (FSt[s].Kind = sskSunburst) then
        TyStSetNum(obj, stkOpacity, 0.1);
      { a pie's label rides with its slice: the laid-out place plus the offset
        (pie/labelLayout.ts:541-544) }
      if (n = stnSelect) and (FSt[s].Kind = sskPie) then
      begin
        TyStSetNum(obj, stkX, pc^.Caption.X + dx);
        TyStSetNum(obj, stkY, pc^.Caption.Y + dy);
      end;
      item^.Label_.Decl[n] := obj;
    end;
    if not was then
    begin
      item^.Label_.Cur := item^.Label_.Rest;
      item^.Label_.States := [];
      if item^.Host.Exists and (item^.Host.States <> []) then
        TyStUseStates(item^.Label_, item^.Host.States);
    end;
  end;

  { ---- a pie's label line: translated with the slice ---- }
  idx := FSt[s].GuideIdx[ARaw];
  was := item^.Guide.Exists;
  if idx < 0 then
    item^.Guide := Default(TTyStElement)
  else
  begin
    pg := AList.Ref(idx);
    item^.Guide.Exists := True;
    item^.Guide.IsPath := False;
    item^.Guide.Proxy := not disabled;
    for n := Low(TTyStName) to High(TTyStName) do item^.Guide.HasState[n] := True;
    item^.Guide.Rest := StGuideRestOf(pg^);
    { setLabelLineStyle: EVERY STATE ITS OWN IGNORE -- hidden where the label
      is, or where the state's labelLine.show (the normal one by default) is
      false -- its smooth (nought unless the state says) and its lineStyle.
      The label as the line was styled: a pie's before hideOverlap (PieView
      styles it; a line hideOverlap hid with its label then comes back with
      it [Batch 103]), any other's after it. [Batch 112] }
    { a pie's and a funnel's labelLine show by default, and their views style
      the line before the label layout runs }
    ownLine := FSt[s].Kind in [sskPie, sskFunnel];
    lineShow := TyStReadBool(nodes, ['labelLine', 'show'], has);
    if not has then lineShow := ownLine;
    { PieSeries / FunnelSeries _defaultLabelLine [F2b]: the series'
      labelLine.show is ANDed with its label.show, and the emphasis one --
      the normal one unless written -- with its emphasis label.show }
    emphLine := lineShow;
    if ownLine then
    begin
      seriesLine := TyStReadBool([nodes[High(nodes)]], ['labelLine', 'show'], has);
      if not has then seriesLine := True;
      emphLine := TyStReadBool([nodes[High(nodes)]], ['emphasis', 'labelLine', 'show'], has);
      if not has then emphLine := seriesLine;
      labShow := TyStReadBool([nodes[High(nodes)]], ['label', 'show'], has);
      if not has then labShow := True;
      { the series' emphasis label.show: written, the funnel's default, else
        the normal one (defaultEmphasis) }
      emphLab := StEmphLabelShow([nodes[High(nodes)]], FSt[s].Kind = sskFunnel, has);
      if not has then emphLab := labShow;
      emphLine := emphLine and emphLab;
      seriesLine := seriesLine and labShow;
      lineShow := TyStReadBool([nodes[0]], ['labelLine', 'show'], has);
      if not has then lineShow := seriesLine;
      stShow := TyStReadBool([nodes[0]], ['emphasis', 'labelLine', 'show'], has);
      if has then emphLine := stShow;
    end;
    labIdx := FSt[s].LabelIdx[ARaw];
    if labIdx >= 0 then
    begin
      pc := AList.Ref(labIdx);
      if ownLine then
        labRest := pc^.Ignore and not pc^.Caption.LmOverlapHidden
      else
        labRest := pc^.Ignore;
    end
    else
      labRest := True;
    for n := Low(TTyStName) to High(TTyStName) do
    begin
      obj := TyStNoObject;
      stShow := TyStReadBool(nodes, [cStNames[n], 'labelLine', 'show'], has);
      if not has then stShow := lineShow;
      if ownLine and (n = stnEmphasis) then stShow := emphLine;
      if item^.Label_.Exists and item^.Label_.Decl[n].Has[stkIgnore] then
        labIgn := item^.Label_.Decl[n].Num[stkIgnore] <> 0
      else
        labIgn := labRest;
      TyStSetNum(obj, stkIgnore, Ord(labIgn or not stShow));
      TyStSetNum(obj, stkSmooth,
        TyLabelLineSmoothOf(TyStFind(nodes, [cStNames[n], 'labelLine', 'smooth'])));
      txt := TyStReadString(nodes, [cStNames[n], 'labelLine', 'lineStyle', 'color'], has);
      if has and TyTryParseChartColor(txt, c) then TyStSetColor(obj, stkStroke, c);
      ss := TyStReadNumber(nodes, [cStNames[n], 'labelLine', 'lineStyle', 'width'], has);
      if has and not IsNan(ss) then TyStSetNum(obj, stkLineWidth, ss);
      item^.Guide.Decl[n] := obj;
    end;
    TyStSetNum(item^.Guide.Decl[stnSelect], stkX, dx);
    TyStSetNum(item^.Guide.Decl[stnSelect], stkY, dy);
    if not was then
    begin
      item^.Guide.Cur := item^.Guide.Rest;
      item^.Guide.States := [];
      if item^.Host.Exists and (item^.Host.States <> []) then
        TyStUseStates(item^.Guide, item^.Host.States);
    end;
  end;
end;

{ CandlestickView.setBoxCommon (CandlestickView.ts:298-325): every state
  takes the colour of the candle's sign from its own itemStyle -- color or
  color0, borderColor or borderColor0, the colour again for a missing border
  -- and the emphasis border is 2 wide unless declared
  (CandlestickSeries.ts:130-134) [Batch 90] }
procedure TTyAdvanceChart.StDeclareCandle(ASlot, ARaw: Integer;
  const ANodes: array of TJSONObject; var AHost: TTyStElement);
var
  st: TTyDataStore;
  inner, cO, cC, sign: Integer;
  o, c, prev: Double;
  n: TTyStName;
  fill, stroke: string;
  hasF, hasS: Boolean;
  col: TTyChartColor;
begin
  if (ASlot > High(FStores)) or (FStores[ASlot] = nil) then Exit;
  st := FStores[ASlot];
  inner := st.IndexOfRawIndex(ARaw);
  cO := st.DimIndexOf('open');
  cC := st.DimIndexOf('close');
  if (inner < 0) or (cO < 0) or (cC < 0) then Exit;
  { the sign as the layout gives it: a doji takes the previous close's }
  o := st.Get(cO, inner);
  c := st.Get(cC, inner);
  if o > c then sign := -1
  else if o < c then sign := 1
  else
  begin
    sign := 1;
    if inner > 0 then
    begin
      prev := st.Get(cC, inner - 1);
      if not IsNan(prev) and (prev > c) then sign := -1;
    end;
  end;
  for n := Low(TTyStName) to High(TTyStName) do
  begin
    if sign > 0 then
    begin
      fill := TyStReadString(ANodes, [cStNames[n], 'itemStyle', 'color'], hasF);
      stroke := TyStReadString(ANodes, [cStNames[n], 'itemStyle', 'borderColor'], hasS);
    end
    else
    begin
      fill := TyStReadString(ANodes, [cStNames[n], 'itemStyle', 'color0'], hasF);
      stroke := TyStReadString(ANodes, [cStNames[n], 'itemStyle', 'borderColor0'], hasS);
    end;
    if not hasS then
    begin
      stroke := fill;
      hasS := hasF;
    end;
    if hasF and TyTryParseChartColor(fill, col) then TyStSetColor(AHost.Decl[n], stkFill, col);
    if hasS and TyTryParseChartColor(stroke, col) then TyStSetColor(AHost.Decl[n], stkStroke, col);
  end;
  if not AHost.Decl[stnEmphasis].Has[stkLineWidth] then
    TyStSetNum(AHost.Decl[stnEmphasis], stkLineWidth, 2);
end;

{ A GAUGE'S PROGRESS ARC [F2b]: setStatesStylesFromModel(progress,
  itemModel) and toggleHoverEmphasis with the item's emphasis, z2EmphasisLift
  0 (GaugeView.ts:566-573) -- the pointer's own states, on a dispatcher of
  its own. A render makes it anew: no flag survives a full update. }
procedure TTyAdvanceChart.StDeclarePeer(ASlot, ARaw: Integer; AList: TTyPaintList);
var
  s: Integer;
  item: PTyStItem;
  nodes: TTyStNodeArray;
  has, bolder, was: Boolean;
  n: TTyStName;
begin
  s := FBindings[ASlot].SeriesIndex;
  item := @FSt[s].PeerRows[ARaw];
  nodes := StNodes(s, ARaw);
  was := item^.Host.Exists;
  item^.Host.Exists := True;
  item^.Host.IsPath := True;
  item^.Host.NoEmphLift := True;
  item^.Host.Proxy := not TyStReadBool(nodes, ['emphasis', 'disabled'], has);
  for n := Low(TTyStName) to High(TTyStName) do
  begin
    item^.Host.HasState[n] := True;
    item^.Host.Decl[n] := TyStReadStyle(nodes, cStNames[n], 'itemStyle', bolder);
  end;
  item^.Host.Rest := StRestOf(AList.Element(FSt[s].PeerHostIdx[ARaw]));
  item^.Label_ := Default(TTyStElement);
  item^.Guide := Default(TTyStElement);
  if not was or FStRerender then
  begin
    TyStClearItem(item^);
    item^.Host.Cur := item^.Host.Rest;
    item^.Host.States := [];
    item^.Host.HoverState := TyStHoverNormal;
    item^.Host.HighByOuter := 0;
    item^.Host.Selected := False;
  end;
  TyStApplyItem(item^);
end;

function TTyAdvanceChart.StMarkNode(ASeriesIndex: Integer;
  AKind: TTyChartTargetKind): TJSONObject;
var s: TJSONObject; d: TJSONData;
begin
  Result := nil;
  s := StSeriesNode(ASeriesIndex);
  if s = nil then Exit;
  case AKind of
    ctkMarkPoint: d := s.Find('markPoint');
    ctkMarkLine: d := s.Find('markLine');
  else
    d := s.Find('markArea');
  end;
  if d is TJSONObject then Result := TJSONObject(d);
end;

{ THE MARKERS OF A SERIES [F2b] (MarkerView.ts:77-92, util/states.ts):
  blurSeries hands the series it blurred to every component view, and a
  marker view enters blur on all its elements of those series -- the
  markPoint's Symbol (its path and its words), the markLine's Line (the
  segment, the end symbols, the words), the markArea's polygon and words;
  allLeaveBlur takes them out again. Each element's blur state is its
  model's (`blur.itemStyle`, a markLine's `blur.lineStyle`, the end symbols
  taking that line's stroke and opacity, `blur.label`), under the default
  proxy's tenth of its opacity -- unless the marker's emphasis is disabled:
  no proxy, the declared state alone. Markers have no stateTransition
  (MarkerModel.isAnimationEnabled is false here): the list is written. Their
  own hover and the select / emphasis states stay as they were. }
procedure TTyAdvanceChart.StDeclareMarks(ASeriesIndex: Integer; AList: TTyPaintList);
var
  k: Integer;
  el: TTyChartElement;
  node: TJSONObject;
  nodes: array[0..0] of TJSONObject;
  has, bolder, proxy: Boolean;
  line, obj: TTyStObject;
  ss: Double;
  m: ^TTyStElement;
begin
  SetLength(FSt[ASeriesIndex].Marks, Length(FSt[ASeriesIndex].MarkIdx));
  for k := 0 to High(FSt[ASeriesIndex].MarkIdx) do
  begin
    el := AList.Element(FSt[ASeriesIndex].MarkIdx[k]);
    node := StMarkNode(ASeriesIndex, el.Datum.Kind);
    nodes[0] := node;
    proxy := not TyStReadBool(nodes, ['emphasis', 'disabled'], has);
    m := @FSt[ASeriesIndex].Marks[k];
    begin
      m^ := Default(TTyStElement);
      m^.Exists := True;
      m^.Proxy := proxy;
      m^.HasState[stnBlur] := True;
      obj := TyStNoObject;
      if el.Caption.FontSizeLogical > 0 then
      begin
        m^.IsPath := False;
        m^.Rest := StLabelRestOf(el);
        ss := TyStReadNumber(nodes, ['blur', 'label', 'opacity'], has);
        if has and not IsNan(ss) then TyStSetNum(obj, stkOpacity, ss);
      end
      else
      begin
        m^.IsPath := True;
        m^.Rest := StRestOf(el);
        if el.Datum.Kind = ctkMarkLine then
        begin
          line := TyStReadStyle(nodes, 'blur', 'lineStyle', bolder);
          if el.Anim.Role in [carMarkLineFrom, carMarkLineTo] then
          begin
            { Line.ts:267-290: the line's stroke as the symbol's fill (its
              stroke for an empty one), the line's opacity }
            if line.Has[stkStroke] then
            begin
              if el.Style.HasFill then
              begin
                obj.Has[stkFill] := True;
                obj.Color[stkFill] := line.Color[stkStroke];
                obj.None[stkFill] := line.None[stkStroke];
              end
              else
              begin
                obj.Has[stkStroke] := True;
                obj.Color[stkStroke] := line.Color[stkStroke];
                obj.None[stkStroke] := line.None[stkStroke];
              end;
            end;
            if line.Has[stkOpacity] then TyStSetNum(obj, stkOpacity, line.Num[stkOpacity]);
          end
          else
            obj := line;
        end
        else
          obj := TyStReadStyle(nodes, 'blur', 'itemStyle', bolder);
      end;
      m^.Decl[stnBlur] := obj;
      m^.Cur := m^.Rest;
      m^.States := [];
    end;
  end;
  StApplyMarks(ASeriesIndex);
end;

procedure TTyAdvanceChart.StSyncMarks(AList: TTyPaintList);
var
  s, k: Integer;
  el: TTyChartElement;
  pe: PTyChartElement;
begin
  if AList = nil then Exit;
  for s := 0 to High(FSt) do
  begin
    FSt[s].MarkIdx := nil;
    FSt[s].MarkPart := nil;
  end;
  for k := 0 to AList.Count - 1 do
  begin
    pe := AList.Ref(k);
    if not (pe^.Datum.Kind in [ctkMarkPoint, ctkMarkLine, ctkMarkArea]) then Continue;
    s := pe^.Datum.ComponentIndex;
    if (s < 0) or (s > High(FSt)) or (FSt[s].Kind = sskNone) then Continue;
    StPush(FSt[s].MarkIdx, k);
    SetLength(FSt[s].MarkPart, Length(FSt[s].MarkIdx));
    FSt[s].MarkPart[High(FSt[s].MarkPart)] := StMarkPartOf(pe^);
  end;
  for s := 0 to High(FSt) do
  begin
    if FSt[s].Kind = sskNone then
    begin
      FSt[s].Marks := nil;
      Continue;
    end;
    StDeclareMarks(s, AList);
    { no transition: the list itself -- a state write, journaled [P2] }
    AList.JournalRecord(True);
    try
      for k := 0 to Min(High(FSt[s].MarkIdx), High(FSt[s].Marks)) do
      begin
        if FSt[s].Marks[k].States = [] then Continue;
        el := AList.Element(FSt[s].MarkIdx[k]);
        if FSt[s].Marks[k].IsPath then StWriteHost(el, FSt[s].Marks[k], False)
        else StWriteLabel(el, FSt[s].Marks[k], False);
        AList.SetElement(FSt[s].MarkIdx[k], el);
      end;
    finally
      AList.JournalRecord(False);
    end;
  end;
end;

function TTyAdvanceChart.StApplyMarks(ASeriesIndex: Integer): Boolean;
var k: Integer;
begin
  Result := False;
  for k := 0 to High(FSt[ASeriesIndex].Marks) do
  begin
    if FSt[ASeriesIndex].IsBlured then
      FSt[ASeriesIndex].Marks[k].HoverState := TyStHoverBlur
    else
      FSt[ASeriesIndex].Marks[k].HoverState := TyStHoverNormal;
    if TyStUseStates(FSt[ASeriesIndex].Marks[k],
      TyStTargetStates(FSt[ASeriesIndex].Marks[k])) then Result := True;
  end;
end;

procedure TTyAdvanceChart.StDeclareLine(ASlot: Integer; AList: TTyPaintList);

  procedure One(var AItem: TTyStItem; const AIdx: TTyIntegerArray;
    const ABlock: string);
  var
    s: Integer;
    nodes: array[0..0] of TJSONObject;
    was, has, bolder: Boolean;
    prev: TTyStNames;
    n: TTyStName;
    obj: TTyStObject;
  begin
    if Length(AIdx) = 0 then
    begin
      AItem := Default(TTyStItem);
      Exit;
    end;
    s := FBindings[ASlot].SeriesIndex;
    nodes[0] := StSeriesNode(s);
    was := AItem.Host.Exists;
    prev := AItem.Host.States;
    AItem.Host.Exists := True;
    AItem.Host.IsPath := True;
    AItem.Host.Proxy := not TyStReadBool(nodes, ['emphasis', 'disabled'], has);
    for n := Low(TTyStName) to High(TTyStName) do AItem.Host.HasState[n] := True;
    AItem.Host.Rest := StRestOf(AList.Element(AIdx[0]));
    for n := Low(TTyStName) to High(TTyStName) do
    begin
      obj := TyStReadStyle(nodes, cStNames[n], ABlock, bolder);
      { LineView.ts:844-847: 'bolder' is the rest width plus one }
      if bolder then
        TyStSetNum(obj, stkLineWidth, AItem.Host.Rest.Num[stkLineWidth] + 1);
      AItem.Host.Decl[n] := obj;
    end;
    if not was then
    begin
      AItem.Host.Cur := AItem.Host.Rest;
      AItem.Host.States := [];
    end
    else if FStRerender then
    begin
      TyStClearItem(AItem);
      if prev <> [] then TyStUseStates(AItem.Host, prev);
    end;
    TyStUseStates(AItem.Host, TyStTargetStates(AItem.Host));
  end;

var s: Integer;
begin
  s := FBindings[ASlot].SeriesIndex;
  One(FSt[s].Run, FSt[s].RunIdx, 'lineStyle');
  One(FSt[s].Area, FSt[s].AreaIdx, 'areaStyle');
end;

procedure TTyAdvanceChart.StSync(AList: TTyPaintList; APPI: Integer);
var
  slot, s, k, raw, n, i, hoverS: Integer;
  ed: TTySelData;
  el: TTyChartElement;
  pe: PTyChartElement;
  gel: TTyGfxEl;
  item: PTyStItem;
  prev: TTyStNames;
  was: Boolean;
begin
  if AList = nil then Exit;
  { a full update since the last sync re-renders: rest, the previous list,
    then the flags (echarts.ts:2667-2748) }
  FStRerender := FStBuiltGen <> FStGen;
  FStBuiltGen := FStGen;
  { THE STATES RUN ON PROXIES [Batch 94] where the render animates, or
    where proxies are bound -- a list that waits for its arming is drawn as
    laid out }
  FStProxied := AnimAllowed or ((FAnimSet <> nil) and (FAnimSet.Count > 0)
    and not FAnimPending);
  { renderSeries' clearStates comes before the render: the proxies back to
    normal at once, the lists kept, before an update's animators exist }
  if FStRerender then StAnimClearAll;
  { a notMerge option's first sync: the reused rows keep their records
    [Batch 96] }
  hoverS := -1;
  if FStCarry <> nil then
  begin
    StCarryApply;
    if FStCarryHoverSeries <= -2 then hoverS := -2 - FStCarryHoverSeries;
  end;
  { the render the records were taken for is this one [Batch 99] }
  FStCarryHeld := False;
  n := 0;
  for slot := 0 to High(FBindings) do
    if FBindings[slot].SeriesIndex >= n then n := FBindings[slot].SeriesIndex + 1;
  if Length(FSt) < n then SetLength(FSt, n);
  for s := 0 to High(FSt) do
  begin
    FSt[s].Kind := sskNone;
    FSt[s].HostIdx := nil;
    FSt[s].LabelIdx := nil;
    FSt[s].GuideIdx := nil;
    FSt[s].RunIdx := nil;
    FSt[s].AreaIdx := nil;
    FSt[s].FollowIdx := nil;
    FSt[s].PartIdx := nil;
    FSt[s].EdgeHostIdx := nil;
    FSt[s].EdgeLabelIdx := nil;
    FSt[s].EdgePartIdx := nil;
    FSt[s].PeerHostIdx := nil;
    FSt[s].PeerFollowIdx := nil;
  end;
  for slot := 0 to High(FBindings) do
  begin
    if slot > High(FStores) then Break;
    if FBindings[slot].Hidden then Continue;
    { a sankey's rows are its nodes, whatever its store holds [Batch 114] }
    if (FStores[slot] = nil) and (StKindOf(slot) <> sskSankey) then Continue;
    s := FBindings[slot].SeriesIndex;
    if s < 0 then Continue;
    FSt[s].Kind := StKindOf(slot);
    FSt[s].IsLine := FBindings[slot].SeriesType = 'line';
    if FSt[s].Kind = sskNone then Continue;
    if FSt[s].Kind = sskSankey then
    begin
      if (slot > High(FSankeys)) or not FSankeys[slot].Valid then
      begin
        FSt[s].Kind := sskNone;
        Continue;
      end;
      k := Length(FSankeys[slot].Nodes);
      n := Length(FSankeys[slot].Edges);
      if Length(FSt[s].EdgeRows) < n then SetLength(FSt[s].EdgeRows, n);
      SetLength(FSt[s].EdgeHostIdx, n);
      SetLength(FSt[s].EdgeLabelIdx, n);
      for i := 0 to n - 1 do
      begin
        FSt[s].EdgeHostIdx[i] := -1;
        FSt[s].EdgeLabelIdx[i] := -1;
      end;
    end
    else
      k := FStores[slot].RawCount;
    { A CHORD: its nodes the store's rows, its ribbons by raw link index
      [Batch 120] }
    if FSt[s].Kind = sskChord then
    begin
      if (slot > High(FChords)) or not FChords[slot].Valid then
      begin
        FSt[s].Kind := sskNone;
        Continue;
      end;
      n := Length(FChords[slot].Edges);
      if Length(FSt[s].EdgeRows) < n then SetLength(FSt[s].EdgeRows, n);
      SetLength(FSt[s].EdgeHostIdx, n);
      SetLength(FSt[s].EdgeLabelIdx, n);
      for i := 0 to n - 1 do
      begin
        FSt[s].EdgeHostIdx[i] := -1;
        FSt[s].EdgeLabelIdx[i] := -1;
      end;
    end;
    { [F2a] A GRAPH'S EDGES by their place in the solved list; A TREE'S by
      the node that draws them }
    if FSt[s].Kind in [sskGraph, sskTree] then
    begin
      if FSt[s].Kind = sskGraph then n := Length(FGraphEdges[slot]) else n := k;
      if Length(FSt[s].EdgeRows) < n then SetLength(FSt[s].EdgeRows, n);
      SetLength(FSt[s].EdgeHostIdx, n);
      SetLength(FSt[s].EdgeLabelIdx, n);
      SetLength(FSt[s].EdgePartIdx, n);
      for i := 0 to n - 1 do
      begin
        FSt[s].EdgeHostIdx[i] := -1;
        FSt[s].EdgeLabelIdx[i] := -1;
        FSt[s].EdgePartIdx[i] := nil;
      end;
    end;
    if Length(FSt[s].Rows) < k then SetLength(FSt[s].Rows, k);
    SetLength(FSt[s].HostIdx, k);
    SetLength(FSt[s].LabelIdx, k);
    SetLength(FSt[s].GuideIdx, k);
    SetLength(FSt[s].FollowIdx, k);
    SetLength(FSt[s].PartIdx, k);
    for i := 0 to k - 1 do
    begin
      FSt[s].HostIdx[i] := -1;
      FSt[s].LabelIdx[i] := -1;
      FSt[s].GuideIdx[i] := -1;
    end;
    { a gauge's arcs [F2b] }
    if FSt[s].Kind = sskGauge then
    begin
      if Length(FSt[s].PeerRows) < k then SetLength(FSt[s].PeerRows, k);
      SetLength(FSt[s].PeerHostIdx, k);
      SetLength(FSt[s].PeerFollowIdx, k);
      for i := 0 to k - 1 do FSt[s].PeerHostIdx[i] := -1;
    end;
  end;
  { A SERIES NOT DRAWN HAS NO ELEMENTS: a legend that switched it off took
    its view's group away, and switched back on it is drawn by new elements
    -- no flags, no states (render's `chart.remove`) [Batch 93] }
  for s := 0 to High(FSt) do
    if FSt[s].Kind = sskNone then
    begin
      FSt[s].Rows := nil;
      FSt[s].EdgeRows := nil;
      FSt[s].Run := Default(TTyStItem);
      FSt[s].Area := Default(TTyStItem);
      FSt[s].IsBlured := False;
      FSt[s].PeerRows := nil;
      FSt[s].Marks := nil;
    end;
  { WHICH ELEMENT IS WHICH: the mark, its label (a placed caption), its
    label line, and a line's polyline and area }
  for k := 0 to AList.Count - 1 do
  begin
    pe := AList.Ref(k);
    if pe^.Datum.Kind <> ctkSeries then Continue;
    s := pe^.Datum.SeriesIndex;
    if (s < 0) or (s > High(FSt)) or (FSt[s].Kind = sskNone) then Continue;
    { A SANKEY: its links by link index, its nodes by node index [Batch 114] }
    if FSt[s].Kind = sskSankey then
    begin
      raw := pe^.Datum.DataIndex;
      if pe^.Datum.IsEdge then
      begin
        if (raw < 0) or (raw > High(FSt[s].EdgeHostIdx)) then Continue;
        if pe^.Caption.FontSizeLogical > 0 then
        begin
          if FSt[s].EdgeLabelIdx[raw] < 0 then FSt[s].EdgeLabelIdx[raw] := k;
        end
        else if not pe^.Silent and (FSt[s].EdgeHostIdx[raw] < 0) then
          FSt[s].EdgeHostIdx[raw] := k;
        Continue;
      end;
      if (raw < 0) or (raw > High(FSt[s].HostIdx)) then Continue;
      if pe^.Caption.FontSizeLogical > 0 then
      begin
        if FSt[s].LabelIdx[raw] < 0 then FSt[s].LabelIdx[raw] := k;
      end
      else if not pe^.Silent and (FSt[s].HostIdx[raw] < 0) then
        FSt[s].HostIdx[raw] := k;
      Continue;
    end;
    { [F2a] A GRAPH'S EDGE: its line hosts, its arrows (silent) are parts,
      its caption the label }
    if pe^.Datum.IsEdge and (FSt[s].Kind = sskGraph) then
    begin
      raw := StGraphEdgeOfRow(SlotOfSeries(s), pe^.Datum.DataIndex);
      if (raw < 0) or (raw > High(FSt[s].EdgeHostIdx)) then Continue;
      if pe^.Caption.FontSizeLogical > 0 then
      begin
        if FSt[s].EdgeLabelIdx[raw] < 0 then FSt[s].EdgeLabelIdx[raw] := k;
      end
      else if pe^.Silent then
        StPush(FSt[s].EdgePartIdx[raw], k)
      else if FSt[s].EdgeHostIdx[raw] < 0 then
        FSt[s].EdgeHostIdx[raw] := k;
      Continue;
    end;
    { a chord's ribbon, by its raw link index [Batch 120] }
    if pe^.Datum.IsEdge and (FSt[s].Kind = sskChord) then
    begin
      raw := pe^.Datum.RawDataIndex;
      if (raw < 0) or (raw > High(FSt[s].EdgeHostIdx)) then Continue;
      if (pe^.Caption.FontSizeLogical = 0) and not pe^.Silent
        and (FSt[s].EdgeHostIdx[raw] < 0) then
        FSt[s].EdgeHostIdx[raw] := k;
      Continue;
    end;
    if pe^.Datum.IsEdge then Continue;
    if pe^.Datum.DataIndex < 0 then
    begin
      if not FSt[s].IsLine then Continue;
      if pe^.Shape.Kind = cskPolyline then
      begin
        SetLength(FSt[s].RunIdx, Length(FSt[s].RunIdx) + 1);
        FSt[s].RunIdx[High(FSt[s].RunIdx)] := k;
      end
      else if pe^.Shape.Kind = cskPolygon then
      begin
        SetLength(FSt[s].AreaIdx, Length(FSt[s].AreaIdx) + 1);
        FSt[s].AreaIdx[High(FSt[s].AreaIdx)] := k;
      end;
      Continue;
    end;
    slot := SlotOfSeries(s);
    if (slot < 0) or (slot > High(FStores)) or (FStores[slot] = nil) then Continue;
    raw := FStores[slot].GetRawIndex(pe^.Datum.DataIndex);
    if (raw < 0) or (raw > High(FSt[s].HostIdx)) then Continue;
    { A GAUGE: the pointer hosts, the progress arc is the peer, its round
      caps (added just before it) follow it; the title and the reading are
      no label of either -- they have no states [F2b] }
    if FSt[s].Kind = sskGauge then
    begin
      if pe^.Anim.Role = carGaugePointer then
      begin
        if FSt[s].HostIdx[raw] < 0 then FSt[s].HostIdx[raw] := k;
      end
      else if (pe^.Anim.Role = carGaugeProgress) and (FSt[s].PeerHostIdx[raw] < 0) then
      begin
        FSt[s].PeerHostIdx[raw] := k;
        { the end cap rides the arc's end, the start cap is before it }
        if (k >= 1) and (AList.Element(k - 1).Anim.Role = carGaugeCap) then
        begin
          StPush(FSt[s].PeerFollowIdx[raw], k - 1);
          if (k >= 2) and (AList.Element(k - 2).Anim.Role = carNone)
            and (AList.Element(k - 2).Shape.Kind = cskCircle)
            and AList.Element(k - 2).Silent then
            StPush(FSt[s].PeerFollowIdx[raw], k - 2);
        end;
      end;
      Continue;
    end;
    { A RADAR ITEM: its polyline hosts, its polygon and its symbols are
      parts of the same dispatcher, in the order they were built [F2b] }
    if FSt[s].Kind = sskRadar then
    begin
      if pe^.Caption.FontSizeLogical > 0 then Continue;
      if pe^.Anim.Role = carRadarLine then
      begin
        if FSt[s].HostIdx[raw] < 0 then FSt[s].HostIdx[raw] := k;
      end
      else
        StPush(FSt[s].PartIdx[raw], k);
      Continue;
    end;
    { A MAP REGION: the first path of the group is the row's; the geo keeps
      the paths' and the texts' states [Batch 152] }
    if FSt[s].Kind = sskMap then
    begin
      if not pe^.Silent and (pe^.Caption.FontSizeLogical = 0)
        and (FSt[s].HostIdx[raw] < 0) then FSt[s].HostIdx[raw] := k;
      Continue;
    end;
    { A CUSTOM ITEM'S PATHS, in the order its tree draws them: the first
      hosts, the rest are parts with states of their own; a text, an image
      and a textContent take no state here [Batch 123] }
    if FSt[s].Kind = sskCustom then
    begin
      gel := CustomPaintSource(k);
      if (gel = nil) or not gel.StatePath or (gel.Host <> nil) then Continue;
      if FSt[s].HostIdx[raw] < 0 then FSt[s].HostIdx[raw] := k
      else StPush(FSt[s].PartIdx[raw], k);
      Continue;
    end;
    { [F2a] A TREE'S EDGE: under its node's paint order, the node's datum }
    if (FSt[s].Kind = sskTree) and (pe^.Caption.FontSizeLogical = 0)
      and (pe^.Z2 < FTrees[slot].Spec.Z2 + cTyTreeNodeZ2) then
    begin
      if FSt[s].EdgeHostIdx[raw] < 0 then FSt[s].EdgeHostIdx[raw] := k;
      Continue;
    end;
    { [F2a] A TREEMAP'S RECTS: a leaf's content hosts and its background is
      a part, a parent's background hosts; a label is the one its rect
      carries (the content's, a parent's header); a breadcrumb item is no
      row's }
    if FSt[s].Kind = sskTreemap then
    begin
      if pe^.Caption.FontSizeLogical > 0 then
      begin
        i := pe^.Caption.LmHostPlus1 - 1;
        if (i >= 0) and (i < AList.Count) and (AList.Element(i).Anim.Role = carTmRect)
          and (FSt[s].LabelIdx[raw] < 0) then FSt[s].LabelIdx[raw] := k;
      end
      else if pe^.Anim.Role = carTmRect then
      begin
        if (pe^.Anim.Sub = 1) or (pe^.Anim.G[4] = 0) then FSt[s].HostIdx[raw] := k
        else StPush(FSt[s].PartIdx[raw], k);
      end;
      Continue;
    end;
    if pe^.Caption.FontSizeLogical > 0 then
    begin
      if FSt[s].LabelIdx[raw] < 0 then FSt[s].LabelIdx[raw] := k;
    end
    else if pe^.IsGuide then
      FSt[s].GuideIdx[raw] := k
    else if FSt[s].Kind = sskLines then
    begin
      { THE LINE HOSTS, the end symbols after it are parts; the effect
        symbol is no part of the Line group's states [Batch 121] }
      if pe^.Silent then Continue;
      if FSt[s].HostIdx[raw] < 0 then FSt[s].HostIdx[raw] := k
      else StPush(FSt[s].PartIdx[raw], k);
    end
    else if FSt[s].Kind = sskPictorial then
    begin
      { THE GLYPHS ARE THE PATHS, the first the host, the rest parts; the
        inkless bar rect has no states [Batch 90] }
      if pe^.Caption.HostTransparent then Continue;
      if FSt[s].HostIdx[raw] < 0 then FSt[s].HostIdx[raw] := k
      else StPush(FSt[s].PartIdx[raw], k);
    end
    else if FSt[s].Kind = sskCandle then
    begin
      { ONE PATH upstream, body and wicks: the body hosts, the wicks follow
        [Batch 90] }
      if pe^.Silent then Continue;
      if pe^.Anim.Role = carCandleBody then
      begin
        if FSt[s].HostIdx[raw] >= 0 then StPush(FSt[s].FollowIdx[raw], FSt[s].HostIdx[raw]);
        FSt[s].HostIdx[raw] := k;
      end
      else if FSt[s].HostIdx[raw] < 0 then FSt[s].HostIdx[raw] := k
      else StPush(FSt[s].FollowIdx[raw], k);
    end
    else if not pe^.Silent and (FSt[s].HostIdx[raw] < 0) then
      FSt[s].HostIdx[raw] := k;
  end;
  { [F2a] a treemap leaf drawn with no content: its background hosts }
  for s := 0 to High(FSt) do
    if FSt[s].Kind = sskTreemap then
      for raw := 0 to High(FSt[s].HostIdx) do
        if (FSt[s].HostIdx[raw] < 0) and (Length(FSt[s].PartIdx[raw]) > 0) then
        begin
          FSt[s].HostIdx[raw] := FSt[s].PartIdx[raw][0];
          FSt[s].PartIdx[raw] := Copy(FSt[s].PartIdx[raw], 1, Length(FSt[s].PartIdx[raw]) - 1);
        end;
  { the primary ink asked once for every row below (StPrimaryInk), and what
    rows with no object of their own read alike (StDeclareItem) [P2] }
  FStInkHold := True;
  FStInkHeld := False;
  FStMemoOk := False;
  FStMemoSpecNode := nil;
  for slot := 0 to High(FBindings) do
  begin
    s := FBindings[slot].SeriesIndex;
    if (s < 0) or (s > High(FSt)) or (FSt[s].Kind = sskNone) then Continue;
    SelEnsure(slot);
    for raw := 0 to High(FSt[s].Rows) do
    begin
      item := @FSt[s].Rows[raw];
      if (raw > High(FSt[s].HostIdx)) or (FSt[s].HostIdx[raw] < 0) then
      begin
        { gone from the picture: a NEW element if it comes back }
        item^ := Default(TTyStItem);
        Continue;
      end;
      was := item^.Host.Exists;
      prev := item^.Host.States;
      StDeclareItem(slot, raw, AList, APPI);
      if not was then
      begin
        item^.Host.Cur := item^.Host.Rest;
        item^.Host.States := [];
      end
      else if FStRerender then
      begin
        TyStClearItem(item^);
        { A MAP'S REGION GROUPS ARE NEW after a render (MapDraw removes
          them all): no hover is carried, the selection comes back from the
          model below [Batch 152] }
        { [F2b] nor a gauge's: GaugeView makes its pointers and arcs anew
          on every render (createPointer / createProgress in the update) }
        if FSt[s].Kind in [sskMap, sskGauge] then
        begin
          item^.Host.HoverState := TyStHoverNormal;
          item^.Host.HighByOuter := 0;
        end
        else if prev <> [] then TyStUseItemStates(item^, prev);
      end;
    end;
    { updateSeriesElementSelection, then applyElementStates }
    SelSyncFlags(slot);
    for raw := 0 to High(FSt[s].Rows) do
      if FSt[s].Rows[raw].Host.Exists then TyStApplyItem(FSt[s].Rows[raw]);
    if FSt[s].IsLine then StDeclareLine(slot, AList);
    { a sankey's links [Batch 114]; their selection from the series' one
      map [F3a] }
    if FSt[s].Kind = sskSankey then
    begin
      ed := SelEdgeData(slot);
      for raw := 0 to High(FSt[s].EdgeRows) do
        if (raw > High(FSt[s].EdgeHostIdx)) or (FSt[s].EdgeHostIdx[raw] < 0) then
          FSt[s].EdgeRows[raw] := Default(TTyStItem)
        else
        begin
          StDeclareEdge(slot, raw, AList);
          FSt[s].EdgeRows[raw].Host.Selected := (s <= High(FSel)) and FSelInit[s]
            and TySelIsSelected(FSel[s], ed, raw);
          TyStApplyItem(FSt[s].EdgeRows[raw]);
        end;
    end;
    { a chord's ribbons [Batch 120] }
    if FSt[s].Kind = sskChord then
      for raw := 0 to High(FSt[s].EdgeRows) do
        if (raw > High(FSt[s].EdgeHostIdx)) or (FSt[s].EdgeHostIdx[raw] < 0) then
          FSt[s].EdgeRows[raw] := Default(TTyStItem)
        else
          StDeclareChordEdge(slot, raw, AList);
    { [F2a] a graph's edges (their selection from the series' one map) and
      a tree's }
    if FSt[s].Kind in [sskGraph, sskTree] then
    begin
      if FSt[s].Kind = sskGraph then ed := SelEdgeData(slot);
      for raw := 0 to High(FSt[s].EdgeRows) do
        if (raw > High(FSt[s].EdgeHostIdx)) or (FSt[s].EdgeHostIdx[raw] < 0) then
          FSt[s].EdgeRows[raw] := Default(TTyStItem)
        else
        begin
          if FSt[s].Kind = sskGraph then
          begin
            StDeclareGraphEdge(slot, raw, AList);
            i := StGraphEdgeInner(slot, raw);
            FSt[s].EdgeRows[raw].Host.Selected := (s <= High(FSel)) and FSelInit[s]
              and (i >= 0) and TySelIsSelected(FSel[s], ed, i);
          end
          else
            StDeclareTreeEdge(slot, raw, AList);
          TyStApplyItem(FSt[s].EdgeRows[raw]);
        end;
    end;
    { a gauge's arcs [F2b] }
    for raw := 0 to High(FSt[s].PeerRows) do
      if (raw > High(FSt[s].PeerHostIdx)) or (FSt[s].PeerHostIdx[raw] < 0) then
        FSt[s].PeerRows[raw] := Default(TTyStItem)
      else
        StDeclarePeer(slot, raw, AList);
  end;
  FStInkHold := False;
  FStInkHeld := False;
  FStMemoOk := False;
  FStMemoNodes := nil;
  FStMemoSpecNode := nil;
  FStDirty := False;
  { WHAT THE STATES ARE WRITTEN OVER, kept from here to the end of the
    build: a frame whose states alone change puts it back and writes them
    again (StPatchList) [P2] }
  AList.JournalOpen;
  StWrite(AList);
  { THE POINTER STILL OVER A REUSED ELEMENT: zrender's hover target is the
    same element, so the next move sends neither an out nor an over }
  if (hoverS >= 0) and (hoverS <= High(FSt)) and (FSt[hoverS].Kind <> sskNone)
    and (FStCarryHoverRaw <= High(FSt[hoverS].HostIdx))
    and (FSt[hoverS].HostIdx[FStCarryHoverRaw] >= 0) then
  begin
    FEvHover := TargetOfElement(FSt[hoverS].HostIdx[FStCarryHoverRaw]);
    slot := SlotOfSeries(hoverS);
    FEvHover.HdRow := FStores[slot].IndexOfRawIndex(FStCarryHoverRaw);
  end;
end;

procedure TTyAdvanceChart.StCarryTake(const AViewKeys: TTyStringArray);
var
  slot, si: Integer;
  vk: TTyStringArray;
begin
  { ONE TAKE A RENDER: a second setOption before the render finds FSt
    gone already, and the records are still the last render's [Batch 99] }
  if FStCarryHeld then Exit;
  FStCarryHeld := True;
  FStCarry := FSt;
  FStCarryKeys := nil;
  FStCarryHover := False;
  { -2 - the NEW series index once StCarryApply found the hovered row }
  FStCarryHoverSeries := -1;
  FStCarryHoverRaw := -1;
  if Length(FSt) = 0 then Exit;
  vk := AViewKeys;
  SetLength(FStCarryKeys, Length(FSt));
  for slot := 0 to High(FBindings) do
  begin
    si := FBindings[slot].SeriesIndex;
    if (si < 0) or (si > High(FSt)) or FBindings[slot].Hidden then Continue;
    if (slot > High(FStores)) or (FStores[slot] = nil) then Continue;
    if FSt[si].Kind = sskNone then Continue;
    FStCarryKeys[si].Present := True;
    if si <= High(vk) then FStCarryKeys[si].ViewKey := vk[si]
    else FStCarryKeys[si].ViewKey := 'x:' + IntToStr(si);
    FStCarryKeys[si].SeriesType := FBindings[slot].SeriesType;
    AnimRowKeys(FStores[slot], FStCarryKeys[si].Keys, FStCarryKeys[si].Raws);
  end;
  { the hovered data item, which the pointer keeps hovering if it is reused }
  if (FEvHover.Id > 0) and (FEvHover.HdKind = 1) then
  begin
    FStCarryHoverSeries := FEvHover.HdSeries;
    FStCarryHoverRaw := StInnerRaw(FEvHover.HdSeries, FEvHover.HdRow);
    FStCarryHover := FStCarryHoverRaw >= 0;
  end;
end;

procedure TTyAdvanceChart.StCarryApply;
var
  slot, s, o, k, n, oldRaw, newRaw: Integer;
  vk, keys: TTyStringArray;
  raws: TTyIntegerArray;
  cmds: TTyDataDiffCmdArray;
begin
  vk := AnimViewKeys;
  n := 0;
  for slot := 0 to High(FBindings) do
    if FBindings[slot].SeriesIndex >= n then n := FBindings[slot].SeriesIndex + 1;
  if Length(FSt) < n then SetLength(FSt, n);
  for slot := 0 to High(FBindings) do
  begin
    s := FBindings[slot].SeriesIndex;
    if (s < 0) or FBindings[slot].Hidden then Continue;
    if (slot > High(FStores)) or (FStores[slot] = nil) then Continue;
    { a brand new model asks for a new view: new elements [Batch 99] }
    if (s <= High(FAnimFresh)) and FAnimFresh[s] then Continue;
    { the view upstream keeps: the same model id and type }
    o := -1;
    for k := 0 to High(FStCarryKeys) do
      if FStCarryKeys[k].Present and (k <= High(vk)) and (s <= High(vk))
        and (FStCarryKeys[k].ViewKey = vk[s])
        and (FStCarryKeys[k].SeriesType = FBindings[slot].SeriesType) then
      begin
        o := k;
        Break;
      end;
    if (o < 0) or (o > High(FStCarry)) then Continue;
    AnimRowKeys(FStores[slot], keys, raws);
    cmds := TyDataDiff(FStCarryKeys[o].Keys, keys);
    if Length(FSt[s].Rows) < FStores[slot].RawCount then
      SetLength(FSt[s].Rows, FStores[slot].RawCount);
    for k := 0 to High(cmds) do
    begin
      if cmds[k].Kind <> ddkUpdate then Continue;
      oldRaw := FStCarryKeys[o].Raws[cmds[k].OldIdx];
      newRaw := raws[cmds[k].NewIdx];
      if (oldRaw < 0) or (oldRaw > High(FStCarry[o].Rows)) then Continue;
      if (newRaw < 0) or (newRaw > High(FSt[s].Rows)) then Continue;
      { THE SAME ELEMENT: its flags and its lists }
      FSt[s].Rows[newRaw] := FStCarry[o].Rows[oldRaw];
      if FStCarryHover and (o = FStCarryHoverSeries) and (oldRaw = FStCarryHoverRaw) then
      begin
        { found: re-targeted after the sync }
        FStCarryHover := False;
        FStCarryHoverSeries := -2 - s;
        FStCarryHoverRaw := newRaw;
      end;
    end;
    { a line's polyline and area are kept with the view }
    FSt[s].Run := FStCarry[o].Run;
    FSt[s].Area := FStCarry[o].Area;
  end;
  FStCarryHover := False;
  FStCarry := nil;
  FStCarryKeys := nil;
end;

procedure TTyAdvanceChart.StWrite(AList: TTyPaintList);
begin
  { a state write: journaled, where a build's session is open [P2] }
  AList.JournalRecord(True);
  try
    StWriteRows(AList);
  finally
    AList.JournalRecord(False);
  end;
end;

procedure TTyAdvanceChart.StWriteRows(AList: TTyPaintList);
var
  s, raw, k: Integer;
  el: TTyChartElement;
  item: PTyStItem;
begin
  for s := 0 to High(FSt) do
  begin
    if FSt[s].Kind = sskNone then Continue;
    { a map region's elements are the geo's to write [Batch 152] }
    if FSt[s].Kind = sskMap then Continue;
    for raw := 0 to High(FSt[s].HostIdx) do
    begin
      if FSt[s].HostIdx[raw] < 0 then Continue;
      item := @FSt[s].Rows[raw];
      if item^.Host.States <> [] then
      begin
        el := AList.Element(FSt[s].HostIdx[raw]);
        StWriteHost(el, item^.Host, FStProxied);
        AList.SetElement(FSt[s].HostIdx[raw], el);
        { the rest of the same path: the host's changes [Batch 90] }
        if raw <= High(FSt[s].FollowIdx) then
          for k := 0 to High(FSt[s].FollowIdx[raw]) do
          begin
            el := AList.Element(FSt[s].FollowIdx[raw][k]);
            StWriteFollower(el, item^.Host, FStProxied);
            AList.SetElement(FSt[s].FollowIdx[raw][k], el);
          end;
      end;
      { the other paths, their own values [Batch 90] }
      if raw <= High(FSt[s].PartIdx) then
        for k := 0 to Min(High(FSt[s].PartIdx[raw]), High(item^.Parts)) do
          if item^.Parts[k].States <> [] then
          begin
            el := AList.Element(FSt[s].PartIdx[raw][k]);
            StWriteHost(el, item^.Parts[k], FStProxied);
            AList.SetElement(FSt[s].PartIdx[raw][k], el);
          end;
      if (FSt[s].LabelIdx[raw] >= 0) and item^.Label_.Exists
        and (item^.Label_.States <> []) then
      begin
        el := AList.Element(FSt[s].LabelIdx[raw]);
        StWriteLabel(el, item^.Label_, FStProxied);
        AList.SetElement(FSt[s].LabelIdx[raw], el);
      end;
      if (FSt[s].GuideIdx[raw] >= 0) and item^.Guide.Exists
        and (item^.Guide.States <> []) then
      begin
        el := AList.Element(FSt[s].GuideIdx[raw]);
        StWriteGuide(el, item^.Guide, FStProxied);
        AList.SetElement(FSt[s].GuideIdx[raw], el);
      end;
    end;
    if FSt[s].Run.Host.Exists and (FSt[s].Run.Host.States <> []) then
      for k := 0 to High(FSt[s].RunIdx) do
      begin
        el := AList.Element(FSt[s].RunIdx[k]);
        StWriteHost(el, FSt[s].Run.Host, FStProxied);
        AList.SetElement(FSt[s].RunIdx[k], el);
      end;
    if FSt[s].Area.Host.Exists and (FSt[s].Area.Host.States <> []) then
      for k := 0 to High(FSt[s].AreaIdx) do
      begin
        el := AList.Element(FSt[s].AreaIdx[k]);
        StWriteHost(el, FSt[s].Area.Host, FStProxied);
        AList.SetElement(FSt[s].AreaIdx[k], el);
      end;
    { a gauge's arcs and their caps [F2b] }
    for raw := 0 to Min(High(FSt[s].PeerHostIdx), High(FSt[s].PeerRows)) do
    begin
      if FSt[s].PeerHostIdx[raw] < 0 then Continue;
      item := @FSt[s].PeerRows[raw];
      if item^.Host.States = [] then Continue;
      el := AList.Element(FSt[s].PeerHostIdx[raw]);
      StWriteHost(el, item^.Host, FStProxied);
      AList.SetElement(FSt[s].PeerHostIdx[raw], el);
      for k := 0 to High(FSt[s].PeerFollowIdx[raw]) do
      begin
        el := AList.Element(FSt[s].PeerFollowIdx[raw][k]);
        StWriteFollower(el, item^.Host, FStProxied);
        AList.SetElement(FSt[s].PeerFollowIdx[raw][k], el);
      end;
    end;
    { a sankey's links and their labels [Batch 114] }
    for raw := 0 to Min(High(FSt[s].EdgeHostIdx), High(FSt[s].EdgeRows)) do
    begin
      if FSt[s].EdgeHostIdx[raw] < 0 then Continue;
      item := @FSt[s].EdgeRows[raw];
      if item^.Host.States <> [] then
      begin
        el := AList.Element(FSt[s].EdgeHostIdx[raw]);
        StWriteHost(el, item^.Host, FStProxied);
        AList.SetElement(FSt[s].EdgeHostIdx[raw], el);
      end;
      { a graph edge's arrows, their own values [F2a] }
      if raw <= High(FSt[s].EdgePartIdx) then
        for k := 0 to Min(High(FSt[s].EdgePartIdx[raw]), High(item^.Parts)) do
          if item^.Parts[k].States <> [] then
          begin
            el := AList.Element(FSt[s].EdgePartIdx[raw][k]);
            StWriteHost(el, item^.Parts[k], FStProxied);
            AList.SetElement(FSt[s].EdgePartIdx[raw][k], el);
          end;
      if (FSt[s].EdgeLabelIdx[raw] >= 0) and item^.Label_.Exists
        and (item^.Label_.States <> []) then
      begin
        el := AList.Element(FSt[s].EdgeLabelIdx[raw]);
        StWriteLabel(el, item^.Label_, FStProxied);
        AList.SetElement(FSt[s].EdgeLabelIdx[raw], el);
      end;
    end;
  end;
end;

{ A FRAME WHOSE STATES ALONE CHANGED [P2]: the list back to what the last
  build's state writes went over (its journal), and those writes again --
  StWrite, the breadcrumb's, the maps', the markers' -- in the build's order.
  Not where a geo's flags changed (only TyBuildGeo draws those), a relayout
  or an update is pending, or anything else wrote to the list since the
  build: then it is built again, as before. }
function TTyAdvanceChart.StPatchList: Boolean;
begin
  Result := False;
  if GStPatchOff or FStGeoApplied or (FPaintList = nil) or not FPaintListValid
    or FDirty or FAnimPending or FExporting or not FPaintList.JournalReady then Exit;
  FPaintList.JournalRewind;
  { the incremental layer holds the chunks as they were written: drawn
    again, as after a build [Batch 119] }
  FProgLayerOk := False;
  StWrite(FPaintList);
  TmCrumbStates(FPaintList);
  MapRepatch(FPaintListPPI, True);
  StSyncMarks(FPaintList);
  FPaintList.JournalClose;
  Inc(GStPatches);
  Result := True;
end;

function TTyAdvanceChart.StApplyChanged: Boolean;
var s, raw: Integer;
begin
  Result := False;
  { the geos' flags too [Batch 148] -- which only a build draws [P2] }
  FStGeoApplied := GeoApplyChanged;
  if FStGeoApplied then Result := True;
  { and a map picture's, which are its series' rows' [Batch 152] }
  if MapApplyChanged then Result := True;
  { a breadcrumb item's hover [F2a] }
  if FTmCrumbDirty then Result := True;
  if not FStDirty then Exit;
  FStDirty := False;
  for s := 0 to High(FSt) do
  begin
    if FSt[s].Kind = sskNone then Continue;
    for raw := 0 to High(FSt[s].Rows) do
      if FSt[s].Rows[raw].Host.Exists and TyStApplyItem(FSt[s].Rows[raw]) then
        Result := True;
    if FSt[s].Run.Host.Exists
      and TyStUseStates(FSt[s].Run.Host, TyStTargetStates(FSt[s].Run.Host)) then
      Result := True;
    if FSt[s].Area.Host.Exists
      and TyStUseStates(FSt[s].Area.Host, TyStTargetStates(FSt[s].Area.Host)) then
      Result := True;
    for raw := 0 to High(FSt[s].EdgeRows) do
      if FSt[s].EdgeRows[raw].Host.Exists and TyStApplyItem(FSt[s].EdgeRows[raw]) then
        Result := True;
    { a gauge's arcs and the markers [F2b] }
    for raw := 0 to High(FSt[s].PeerRows) do
      if FSt[s].PeerRows[raw].Host.Exists and TyStApplyItem(FSt[s].PeerRows[raw]) then
        Result := True;
    if StApplyMarks(s) then Result := True;
  end;
end;

{ ==================== state transitions [Batch 94, AN3b] ====================

  updateStates (echarts.ts:2697-2747) gives every element with an emphasis
  state -- and its label and label line -- the series' stateAnimation as its
  stateTransition when the series animates; zrender's useStates then
  transitions the transform keys, the animatable style keys and the shape's
  primitive keys (Anim.pas, TTyAnimElement.UseStates). Here the element is
  its proxy: the role's where upstream's element is the one the enter and
  update animations run on, else one of the states' own. The state machine
  (States.pas) still decides the lists and the merged objects; this turns a
  merged object into the proxy's keys and lets the engine run it. }

const
  { the element kinds a proxy's state keys are seeded for }
  cStPxPath = 0;
  cStPxLabel = 1;
  cStPxGuide = 2;
  cStPxPart = 3;
  cStPxLine = 4;

function StNamesOf(const AText: string): TTyStNames;
var n: TTyStName; parts: TStringArray; i: Integer;
begin
  Result := [];
  parts := AText.Split([',']);
  for i := 0 to High(parts) do
    for n := Low(TTyStName) to High(TTyStName) do
      if parts[i] = cStNames[n] then Include(Result, n);
end;

{ a colour key of a state object as the engine takes it: 'none', null for
  no stroke, a lifted colour as liftColor's rgba() string }
function StColourValue(const AObj: TTyStObject; AKey: TTyStKey): TTyAnimValue;
var d: TJSONData;
begin
  if AObj.None[AKey] then
  begin
    if AKey = stkStroke then Result := TyAnimNull
    else Result := TyAnimStr('none');
  end
  { [F3d] A GRADIENT: the object as written -- its track interpolates it
    against another gradient, and against a colour it is discrete (set at
    once); lifted, every stop (liftColor) }
  else if AObj.GradJson[AKey] <> '' then
  begin
    d := GetJSON(AObj.GradJson[AKey]);
    try
      Result := TyGfxAnimOf(d);
    finally
      d.Free;
    end;
    if AObj.Lifted[AKey] then Result := TyAnimLiftGradient(Result);
  end
  else
    Result := TyAnimColorValue(AObj.Color[AKey], AObj.Lifted[AKey]);
end;

{ A MERGED STATE OBJECT as the proxy's keys: the style keys, and the place,
  the scale and the radius where the proxy carries them }
function StAnimStateOf(const AEl: TTyStElement; const AM: TTyStObject;
  AKind: Integer; P: TTyChartAnimProxy): TTyAnimState;
var
  rx, ry: TTyAnimValue;
  f: Double;
begin
  Result := Default(TTyAnimState);
  { setStatesStylesFromModel gives every state a style object }
  Result.HasStyle := True;
  if AKind = cStPxLabel then
  begin
    { a label's opacity is a factor over its own (as its fade's) -- or, on a
      proxy of the states' own, upstream's [F3a] }
    if AM.Has[stkOpacity] then
    begin
      f := AM.Num[stkOpacity];
      if StPositive(AEl.Rest.Num[stkOpacity]) and not P.StAbsOpacity then
        f := f / AEl.Rest.Num[stkOpacity];
      TyAnimPropPut(Result.Props, 'style.opacity', TyAnimNum(f));
    end;
  end
  else
  begin
    if AM.Has[stkFill] and P.HasStKey('style.fill') then
      TyAnimPropPut(Result.Props, 'style.fill', StColourValue(AM, stkFill));
    if AM.Has[stkStroke] and P.HasStKey('style.stroke') then
      TyAnimPropPut(Result.Props, 'style.stroke', StColourValue(AM, stkStroke));
    if AM.Has[stkLineWidth] and P.HasStKey('style.lineWidth') then
      TyAnimPropPut(Result.Props, 'style.lineWidth', TyAnimNum(AM.Num[stkLineWidth]));
    if AM.Has[stkOpacity] then
      TyAnimPropPut(Result.Props, 'style.opacity', TyAnimNum(AM.Num[stkOpacity]));
  end;
  if AM.Has[stkX] and P.HasStKey('x') then
    TyAnimPropPut(Result.Props, 'x', TyAnimNum(AM.Num[stkX]));
  if AM.Has[stkY] and P.HasStKey('y') then
    TyAnimPropPut(Result.Props, 'y', TyAnimNum(AM.Num[stkY]));
  { Symbol.ts: emphasisState.scaleX = this._sizeX * scaleRatio }
  if AM.Has[stkScale] and P.HasStKey('scaleX') and P.StRestOf('scaleX', rx)
    and P.StRestOf('scaleY', ry) then
  begin
    TyAnimPropPut(Result.Props, 'scaleX', TyAnimNum(rx.Num * AM.Num[stkScale]));
    TyAnimPropPut(Result.Props, 'scaleY', TyAnimNum(ry.Num * AM.Num[stkScale]));
  end;
  { PieView: the emphasis shape is r = layout.r + scaleSize }
  if AM.Has[stkR] and P.HasStKey('shape.r') then
  begin
    TyAnimPropPut(Result.Props, 'shape.r', TyAnimNum(AM.Num[stkR]));
    Result.HasShape := True;
  end;
end;

procedure TTyAdvanceChart.StAnimClearAll;
var
  i: Integer;
  p: TTyChartAnimProxy;
begin
  if FAnimSet = nil then Exit;
  for i := 0 to FAnimSet.Count - 1 do
  begin
    p := FAnimSet.Item(i);
    if p.CurrentStates = '' then Continue;
    { clearStates (echarts.ts:2667-2695): the transition nulled, prevStates
      kept, back to normal without one }
    p.StPrev := p.CurrentStates;
    p.ClearStateTransition;
    p.ClearStates(True);
  end;
end;

function TTyAdvanceChart.StAnimCfg(ASeriesIndex: Integer; out ACfg: TTyAnimCfg): Boolean;
var
  slot, n: Integer;
  model: TTyAnimModel;
  own, root: TJSONObject;
  dur, delay: Double;
  easing: string;

  { stateAnimation.<key>: the series', the root's, the global default }
  function Find(const AKey: string): TJSONData;
  var d: TJSONData;
  begin
    Result := nil;
    if own <> nil then
    begin
      d := own.Find(AKey);
      if (d <> nil) and (d.JSONType <> jtNull) then Exit(d);
    end;
    if root <> nil then
    begin
      d := root.Find(AKey);
      if (d <> nil) and (d.JSONType <> jtNull) then Exit(d);
    end;
  end;

var d: TJSONData;
begin
  ACfg := Default(TTyAnimCfg);
  Result := False;
  slot := SlotOfSeries(ASeriesIndex);
  n := 0;
  if (slot >= 0) and (slot <= High(FStores)) and (FStores[slot] <> nil) then
    n := FStores[slot].Count;
  model := TyAnimSeriesModel(FOption.Root, ASeriesIndex, n);
  { model.isAnimationEnabled(): `animation` and the threshold }
  if not TyAnimIsEnabled(model) then Exit;
  own := nil;
  root := nil;
  if model.Own is TJSONObject then
  begin
    d := TJSONObject(model.Own).Find('stateAnimation');
    if d is TJSONObject then own := TJSONObject(d);
  end;
  if FOption.Root is TJSONObject then
  begin
    d := TJSONObject(FOption.Root).Find('stateAnimation');
    if d is TJSONObject then root := TJSONObject(d);
  end;
  d := Find('duration');
  if d = nil then dur := 300
  else if d.JSONType = jtNumber then dur := d.AsFloat
  else dur := NaN;
  d := Find('easing');
  if (d <> nil) and (d.JSONType = jtString) then easing := d.AsString
  else easing := 'cubicOut';
  d := Find('delay');
  if (d <> nil) and (d.JSONType = jtNumber) then delay := d.AsFloat
  else delay := 0;
  { a duration above 0 makes a stateTransition, anything else none }
  if IsNan(dur) or not (dur > 0) then Exit;
  ACfg := TyAnimCfg(dur, delay, easing);
  Result := True;
end;

procedure TTyAdvanceChart.StAnimEl(var AEl: TTyStElement; AListIdx, ASeries,
  ARaw: Integer; const AName: string; AKind: Integer; const ACfg: TTyAnimCfg;
  AHasCfg, AOver: Boolean);
var
  el: TTyChartElement;
  p, role: TTyChartAnimProxy;
  isPie: Boolean;
  tmp: TTyStElement;
  want: string;
  noAnim: Boolean;
  st: TTyAnimState;

  { a state key at rest: re-seeded on a full update unless the role's own
    animation holds it }
  procedure Seed(const AKey: string; const AValue: TTyAnimValue);
  begin
    p.StSeed(AKey, AValue, FStRerender and (p.FinalOf(AKey).Kind = avkNull));
  end;

begin
  if (AListIdx < 0) or (AListIdx >= FPaintList.Count) then Exit;
  el := FPaintList.Element(AListIdx);
  role := nil;
  if AListIdx <= High(FAnimBind) then role := FAnimBind[AListIdx];
  { UPSTREAM'S SAME ELEMENT: the proxy its enter and update animations run
    on; anything else (a line symbol's group is not its path, a clip is not
    its polyline) a proxy of the states' own }
  if (role <> nil) and (el.Anim.Role in [carBar, carPolarBar, carSymbol, carSector, carFunnel,
    carCandleBody, carCandleWickHigh, carCandleWickLow, carLabel, carGuide,
    carBoxplot, carTreeNode,
    { [F3a] a gauge's pointer and arc, a radar's polyline and polygon: the
      paths their enter turns and grows }
    carGaugePointer, carGaugeProgress, carRadarLine, carRadarArea,
    { and a graph edge's label, the text its fade runs on }
    carGraphEdgeLabel]) then
    p := role
  else
  begin
    p := FAnimSet.Find(ASeries, ARaw, 'st:' + AName);
    if p = nil then p := FAnimSet.MakeState(ASeries, ARaw, 'st:' + AName);
  end;
  FAnimStBind[AListIdx] := p;
  { a Text's style animates only its opacity }
  p.StatePath := AKind <> cStPxLabel;
  { [F3a] a label on a proxy of the states' own: no fade shares its
    opacity, which is upstream's own }
  p.StAbsOpacity := (AKind = cStPxLabel)
    and ((p <> role) or (el.Anim.Role = carGraphEdgeLabel));
  isPie := FSt[ASeries].Kind = sskPie;
  { ---- the rest values ---- }
  if AKind = cStPxLabel then
  begin
    if p.StAbsOpacity then Seed('style.opacity', TyAnimNum(AEl.Rest.Num[stkOpacity]))
    else Seed('style.opacity', TyAnimNum(1));
    { a pie's label is placed by its layout: x / y are its anchor }
    if isPie then
    begin
      Seed('x', TyAnimNum(AEl.Rest.Num[stkX]));
      Seed('y', TyAnimNum(AEl.Rest.Num[stkY]));
    end;
  end
  else
  begin
    if AKind <> cStPxGuide then
    begin
      Seed('style.fill', StColourValue(AEl.Rest, stkFill));
      Seed('style.stroke', StColourValue(AEl.Rest, stkStroke));
      Seed('style.lineWidth', TyAnimNum(AEl.Rest.Num[stkLineWidth]));
    end;
    Seed('style.opacity', TyAnimNum(AEl.Rest.Num[stkOpacity]));
    if isPie and (AKind in [cStPxPath, cStPxGuide]) then
    begin
      Seed('x', TyAnimNum(0));
      Seed('y', TyAnimNum(0));
    end;
    if isPie and (AKind = cStPxPath) and (el.Shape.Kind = cskSector) then
      Seed('shape.r', TyAnimNum(AEl.Rest.Num[stkR]));
    { a symbol path's scale is half its size; a pictorial glyph's its own }
    if AKind = cStPxPath then
      case el.Anim.Role of
        { [F3a] a graph's node is a carSymbol, a tree's a carTreeNode: the
          Symbol path's own scale, its half size }
        carSymbol, carEffectSymbol, carTreeNode:
          begin
            Seed('scaleX', TyAnimNum(el.Anim.G[2]));
            Seed('scaleY', TyAnimNum(el.Anim.G[3]));
          end;
        carLineSymbol:
          begin
            Seed('scaleX', TyAnimNum(el.Anim.G[7]));
            Seed('scaleY', TyAnimNum(el.Anim.G[8]));
          end;
      else
        { a pictorial glyph's emphasis.scale: a factor over its own scale;
          a graph's and a tree's Symbol path too (the port's factor over the
          size it drew) [F2a] }
        if (FSt[ASeries].Kind in [sskPictorial, sskGraph, sskTree])
          and AEl.Decl[stnEmphasis].Has[stkScale] then
        begin
          Seed('scaleX', TyAnimNum(1));
          Seed('scaleY', TyAnimNum(1));
        end;
      end
    else if (AKind = cStPxPart) and (FSt[ASeries].Kind = sskPictorial)
      and AEl.Decl[stnEmphasis].Has[stkScale] then
    begin
      Seed('scaleX', TyAnimNum(1));
      Seed('scaleY', TyAnimNum(1));
    end;
  end;
  { ---- a full update: the previous list back at once (no transition: the
    render nulled it), the merged object made on the new element ---- }
  if p.StPrev <> '' then
  begin
    tmp := AEl;
    tmp.Cur := tmp.Rest;
    tmp.States := [];
    TyStUseStates(tmp, StNamesOf(p.StPrev));
    p.UseStates(p.StPrev, StAnimStateOf(tmp, tmp.Merged, AKind, p), True);
    p.StPrev := '';
  end;
  { ---- the series' stateTransition, only when it animates ---- }
  if AHasCfg then p.SetStateTransition(ACfg) else p.ClearStateTransition;
  want := TyStNamesText(AEl.States);
  if want = p.CurrentStates then Exit;
  { no timer, no transition; and an element in the hover layer has none }
  noAnim := not AnimAllowed or (AOver and ((Pos('emphasis', want) > 0)
    or (Pos('emphasis', p.CurrentStates) > 0)));
  if want = '' then p.ClearStates(noAnim)
  else
  begin
    st := StAnimStateOf(AEl, AEl.Merged, AKind, p);
    p.UseStates(want, st, noAnim);
    { a pie label's select place, for the next update's move from it }
    if (AKind = cStPxLabel) and (stnSelect in AEl.States)
      and (TyAnimPropIndex(st.Props, 'x') >= 0) and (TyAnimPropIndex(st.Props, 'y') >= 0) then
      p.StNoteSelect(st.Props[TyAnimPropIndex(st.Props, 'x')].Value.Num,
        st.Props[TyAnimPropIndex(st.Props, 'y')].Value.Num);
  end;
end;

procedure TTyAdvanceChart.StAnimSync;
var
  s, raw, k, clips: Integer;
  item: PTyStItem;
  cfg: TTyAnimCfg;
  hasCfg, over: Boolean;
  hostP: TTyChartAnimProxy;
  d: TJSONData;
  threshold: Double;
begin
  if not FStProxied or (FPaintList = nil) then Exit;
  if FAnim = nil then FAnim := NewAnimDriver;
  if FAnimSet = nil then FAnimSet := TTyChartAnimSet.Create(FAnim);
  SetLength(FAnimStBind, FPaintList.Count);
  for k := 0 to High(FAnimStBind) do FAnimStBind[k] := nil;
  clips := FAnim.ClipCount;
  { THE HOVER LAYER: past hoverLayerThreshold elements upstream's canvas
    hovers an element in a layer of its own, where it never transitions
    (canTransition, __inHover) }
  threshold := 3000;
  if FOption.Root is TJSONObject then
  begin
    d := TJSONObject(FOption.Root).Find('hoverLayerThreshold');
    if (d <> nil) and (d.JSONType = jtNumber) then threshold := d.AsFloat;
  end;
  over := FPaintList.Count > threshold;
  for s := 0 to High(FSt) do
  begin
    if FSt[s].Kind = sskNone then Continue;
    hasCfg := StAnimCfg(s, cfg);
    for raw := 0 to High(FSt[s].HostIdx) do
    begin
      if FSt[s].HostIdx[raw] < 0 then Continue;
      if raw > High(FSt[s].Rows) then Continue;
      item := @FSt[s].Rows[raw];
      if not item^.Host.Exists then Continue;
      StAnimEl(item^.Host, FSt[s].HostIdx[raw], s, raw, 'host', cStPxPath,
        cfg, hasCfg, over);
      { the rest of the same path: the host's proxy }
      hostP := FAnimStBind[FSt[s].HostIdx[raw]];
      if raw <= High(FSt[s].FollowIdx) then
        for k := 0 to High(FSt[s].FollowIdx[raw]) do
          FAnimStBind[FSt[s].FollowIdx[raw][k]] := hostP;
      if raw <= High(FSt[s].PartIdx) then
        for k := 0 to Min(High(FSt[s].PartIdx[raw]), High(item^.Parts)) do
          StAnimEl(item^.Parts[k], FSt[s].PartIdx[raw][k], s, raw,
            'part' + IntToStr(k), cStPxPart, cfg, hasCfg, over);
      if (FSt[s].LabelIdx[raw] >= 0) and item^.Label_.Exists then
        StAnimEl(item^.Label_, FSt[s].LabelIdx[raw], s, raw, 'label', cStPxLabel,
          cfg, hasCfg, over);
      if (FSt[s].GuideIdx[raw] >= 0) and item^.Guide.Exists then
        StAnimEl(item^.Guide, FSt[s].GuideIdx[raw], s, raw, 'guide', cStPxGuide,
          cfg, hasCfg, over);
    end;
    { A GAUGE'S ARC: its own proxy, its caps drawn from it [F2b] }
    for raw := 0 to Min(High(FSt[s].PeerHostIdx), High(FSt[s].PeerRows)) do
      if (FSt[s].PeerHostIdx[raw] >= 0) and FSt[s].PeerRows[raw].Host.Exists then
      begin
        StAnimEl(FSt[s].PeerRows[raw].Host, FSt[s].PeerHostIdx[raw], s, raw,
          'peer', cStPxPath, cfg, hasCfg, over);
        hostP := FAnimStBind[FSt[s].PeerHostIdx[raw]];
        for k := 0 to High(FSt[s].PeerFollowIdx[raw]) do
          FAnimStBind[FSt[s].PeerFollowIdx[raw][k]] := hostP;
      end;
    { [F3a] A SANKEY'S BANDS and their labels: states of their own, each its
      own proxy (the main group's clip is their role) }
    if FSt[s].Kind = sskSankey then
      for raw := 0 to Min(High(FSt[s].EdgeHostIdx), High(FSt[s].EdgeRows)) do
      begin
        if (FSt[s].EdgeHostIdx[raw] < 0) or not FSt[s].EdgeRows[raw].Host.Exists then Continue;
        item := @FSt[s].EdgeRows[raw];
        StAnimEl(item^.Host, FSt[s].EdgeHostIdx[raw], s, raw, 'edge', cStPxPath,
          cfg, hasCfg, over);
        if (raw <= High(FSt[s].EdgeLabelIdx)) and (FSt[s].EdgeLabelIdx[raw] >= 0)
          and item^.Label_.Exists then
          StAnimEl(item^.Label_, FSt[s].EdgeLabelIdx[raw], s, raw, 'edgelabel', cStPxLabel,
            cfg, hasCfg, over);
      end;
    { A CHORD'S RIBBONS have states of their own, each its own proxy
      (the series' view group is their role) [Batch 120] }
    if FSt[s].Kind = sskChord then
      for raw := 0 to Min(High(FSt[s].EdgeHostIdx), High(FSt[s].EdgeRows)) do
        if (FSt[s].EdgeHostIdx[raw] >= 0) and FSt[s].EdgeRows[raw].Host.Exists then
          StAnimEl(FSt[s].EdgeRows[raw].Host, FSt[s].EdgeHostIdx[raw], s, raw,
            'edge', cStPxPath, cfg, hasCfg, over);
    { [F2a] A GRAPH'S EDGES (the Line group's path, its arrows, its label)
      and A TREE'S (the edge path): states of their own, proxies of their
      own -- their stateTransition the series' as every other element's }
    if FSt[s].Kind in [sskGraph, sskTree] then
      for raw := 0 to Min(High(FSt[s].EdgeHostIdx), High(FSt[s].EdgeRows)) do
      begin
        if (FSt[s].EdgeHostIdx[raw] < 0) or not FSt[s].EdgeRows[raw].Host.Exists then Continue;
        item := @FSt[s].EdgeRows[raw];
        StAnimEl(item^.Host, FSt[s].EdgeHostIdx[raw], s, raw, 'edge', cStPxPath,
          cfg, hasCfg, over);
        if raw <= High(FSt[s].EdgePartIdx) then
          for k := 0 to Min(High(FSt[s].EdgePartIdx[raw]), High(item^.Parts)) do
            StAnimEl(item^.Parts[k], FSt[s].EdgePartIdx[raw][k], s, raw,
              'edgepart' + IntToStr(k), cStPxPart, cfg, hasCfg, over);
        if (FSt[s].EdgeLabelIdx[raw] >= 0) and item^.Label_.Exists then
          StAnimEl(item^.Label_, FSt[s].EdgeLabelIdx[raw], s, raw, 'edgelabel', cStPxLabel,
            cfg, hasCfg, over);
      end;
    { a line's polyline and area: one element each upstream, its runs here }
    if FSt[s].Run.Host.Exists and (Length(FSt[s].RunIdx) > 0) then
    begin
      StAnimEl(FSt[s].Run.Host, FSt[s].RunIdx[0], s, -1, 'poly', cStPxLine,
        cfg, hasCfg, over);
      for k := 1 to High(FSt[s].RunIdx) do
        FAnimStBind[FSt[s].RunIdx[k]] := FAnimStBind[FSt[s].RunIdx[0]];
    end;
    if FSt[s].Area.Host.Exists and (Length(FSt[s].AreaIdx) > 0) then
    begin
      StAnimEl(FSt[s].Area.Host, FSt[s].AreaIdx[0], s, -1, 'area', cStPxLine,
        cfg, hasCfg, over);
      for k := 1 to High(FSt[s].AreaIdx) do
        FAnimStBind[FSt[s].AreaIdx[k]] := FAnimStBind[FSt[s].AreaIdx[0]];
    end;
  end;
  { A TRANSITION BEGAN: the series go to the dynamic layer until it ends
    (an armed option's flush decides that itself) }
  if (FAnim.ClipCount > clips) and not FAnimFlush then
  begin
    FAnimLive := True;
    FAnimContinuous := AnimLoopOnly;
    AnimArmTimer;
  end;
end;

function TTyAdvanceChart.StPeerAt(ASeriesIndex, AInnerRow: Integer): PTyStItem;
var raw: Integer;
begin
  Result := nil;
  raw := StInnerRaw(ASeriesIndex, AInnerRow);
  if (raw < 0) or (ASeriesIndex > High(FSt)) then Exit;
  if (raw > High(FSt[ASeriesIndex].PeerRows)) or not FSt[ASeriesIndex].PeerRows[raw].Host.Exists then Exit;
  Result := @FSt[ASeriesIndex].PeerRows[raw];
end;

function TTyAdvanceChart.StItemAt(ASeriesIndex, AInnerRow: Integer): PTyStItem;
var slot, raw: Integer;
begin
  Result := nil;
  if (ASeriesIndex < 0) or (ASeriesIndex > High(FSt)) then Exit;
  if FSt[ASeriesIndex].Kind = sskNone then Exit;
  slot := SlotOfSeries(ASeriesIndex);
  if FSt[ASeriesIndex].Kind = sskSankey then
    raw := AInnerRow
  else
  begin
    if (slot < 0) or (slot > High(FStores)) or (FStores[slot] = nil) then Exit;
    if (AInnerRow < 0) or (AInnerRow >= FStores[slot].Count) then Exit;
    raw := FStores[slot].GetRawIndex(AInnerRow);
  end;
  if (raw < 0) or (raw > High(FSt[ASeriesIndex].Rows)) then Exit;
  if not FSt[ASeriesIndex].Rows[raw].Host.Exists then Exit;
  Result := @FSt[ASeriesIndex].Rows[raw];
end;

{ ---- focus and blur [Batch 90] ---- }

function TTyAdvanceChart.StPolyOf(ASeriesIndex: Integer): Integer;
begin
  Result := -1;
  if (ASeriesIndex < 0) or (ASeriesIndex > High(FSt)) then Exit;
  if FSt[ASeriesIndex].IsLine and FSt[ASeriesIndex].Run.Host.Exists then
    Result := FSt[ASeriesIndex].Run.Host.HoverState;
end;

{ LineView._changePolyState: setStatesFlag on the polyline and the area }
procedure TTyAdvanceChart.StPolyTo(ASeriesIndex, AState: Integer);
begin
  if (ASeriesIndex < 0) or (ASeriesIndex > High(FSt)) then Exit;
  if not FSt[ASeriesIndex].IsLine then Exit;
  FSt[ASeriesIndex].Run.Host.HoverState := AState;
  FSt[ASeriesIndex].Area.Host.HoverState := AState;
  FStDirty := True;
end;

function TTyAdvanceChart.StCoordKey(ASlot: Integer): string;
begin
  Result := '';
  if (ASlot < 0) or (ASlot > High(FBindings)) then Exit;
  { coordinateSystem.master: a cartesian's is its GRID, so two axis pairs
    of one grid are one system }
  if FBindings[ASlot].Cart <> nil then
  begin
    if FBindings[ASlot].XAxis <> nil then
      Result := 'grid' + IntToStr(FBindings[ASlot].XAxis.GridIndex)
    else
      Result := 'cart' + IntToStr(PtrUInt(FBindings[ASlot].Cart));
  end
  else if FBindings[ASlot].Polar <> nil then
    { a polar is its own master [Batch 113] }
    Result := 'polar' + IntToStr(FBindings[ASlot].PolarIndex)
  { a single axis is too [Batch 118] }
  else if FBindings[ASlot].Single <> nil then
    Result := 'single' + IntToStr(FBindings[ASlot].SingleIndex)
  else if FBindings[ASlot].CalendarIndex >= 0 then
    Result := 'calendar' + IntToStr(FBindings[ASlot].CalendarIndex)
  else if FBindings[ASlot].MatrixIndex >= 0 then
    Result := 'matrix' + IntToStr(FBindings[ASlot].MatrixIndex)
  { the geo component [Batch 152] }
  else if FBindings[ASlot].GeoIndex >= 0 then
    Result := 'geo' + IntToStr(FBindings[ASlot].GeoIndex)
  else if FBindings[ASlot].RadarIndex >= 0 then
    Result := 'radar' + IntToStr(FBindings[ASlot].RadarIndex)
  { the parallel the series is on [Batch 128] }
  else if FBindings[ASlot].ParallelIndex >= 0 then
    Result := 'parallel' + IntToStr(FBindings[ASlot].ParallelIndex);
end;

{ an item's model chain: the item, a sunburst row's level, the series }
function TTyAdvanceChart.StNodes(ASeriesIndex, ARaw: Integer): TTyStNodeArray;
var slot, d: Integer;
begin
  Result := nil;
  slot := SlotOfSeries(ASeriesIndex);
  if (slot >= 0) and (slot <= High(FSunbursts)) and FSunbursts[slot].Valid
    and (ARaw >= 0) and (ARaw <= High(FSunbursts[slot].Hier.Nodes)) then
  begin
    SetLength(Result, 3);
    Result[0] := StItemNode(ASeriesIndex, ARaw);
    d := FSunbursts[slot].Hier.Nodes[ARaw].Depth;
    Result[1] := nil;
    if (d >= 0) and (d <= High(FSunbursts[slot].Levels)) then
      Result[1] := FSunbursts[slot].Levels[d];
    Result[2] := StSeriesNode(ASeriesIndex);
    Exit;
  end;
  { A SANKEY NODE'S CHAIN: its item, the level of its layout depth, the
    series (SankeySeries' wrapped getItemModel) [Batch 114] }
  if (slot >= 0) and (slot <= High(FSankeys)) and FSankeys[slot].Valid
    and (FBindings[slot].SeriesType = TySankeySeriesTypeName) then
  begin
    SetLength(Result, 3);
    Result[0] := nil;
    Result[1] := nil;
    if (ARaw >= 0) and (ARaw <= High(FSankeys[slot].Nodes)) then
    begin
      Result[0] := FSankeys[slot].Nodes[ARaw].Item;
      Result[1] := TySankeyLevel(FSankeys[slot], FSankeys[slot].Nodes[ARaw].Depth);
    end;
    Result[2] := StSeriesNode(ASeriesIndex);
    Exit;
  end;
  { [F2a] A GRAPH NODE'S CHAIN: its item, the category it names by index,
    the series (GraphSeries' wrapped getItemModel) }
  if (slot >= 0) and (FBindings[slot].SeriesType = TyGraphSeriesTypeName) then
  begin
    SetLength(Result, 3);
    Result[0] := StItemNode(ASeriesIndex, ARaw);
    Result[1] := nil;
    d := StGraphNodeOfRaw(slot, ARaw);
    if d >= 0 then Result[1] := GraphCategoryNode(slot, FGraphNodes[slot][d].ModelCategory);
    Result[2] := StSeriesNode(ASeriesIndex);
    Exit;
  end;
  { A TREE NODE'S: its item, `leaves` for a leaf-modelled one, the series }
  if (slot >= 0) and (FBindings[slot].SeriesType = TyTreeSeriesTypeName)
    and (slot <= High(FTrees)) and FTrees[slot].Valid then
  begin
    SetLength(Result, 3);
    Result[0] := StItemNode(ASeriesIndex, ARaw);
    Result[1] := nil;
    if (ARaw >= 0) and (ARaw <= High(FTrees[slot].LeafModelled))
      and FTrees[slot].LeafModelled[ARaw] then Result[1] := FTrees[slot].Spec.Leaves;
    Result[2] := StSeriesNode(ASeriesIndex);
    Exit;
  end;
  { A TREEMAP NODE'S: its item, the level of its depth, the series }
  if (slot >= 0) and (FBindings[slot].SeriesType = TyTreemapSeriesTypeName)
    and (slot <= High(FTreemaps)) and FTreemaps[slot].Valid then
  begin
    SetLength(Result, 3);
    Result[0] := StItemNode(ASeriesIndex, ARaw);
    Result[1] := nil;
    if (ARaw >= 0) and (ARaw <= High(FTreemaps[slot].Hier.Nodes)) then
    begin
      d := FTreemaps[slot].Hier.Nodes[ARaw].Depth;
      if (d >= 0) and (d <= High(FTreemaps[slot].Levels)) then
        Result[1] := FTreemaps[slot].Levels[d];
    end;
    Result[2] := StSeriesNode(ASeriesIndex);
    Exit;
  end;
  SetLength(Result, 2);
  Result[0] := StItemNode(ASeriesIndex, ARaw);
  Result[1] := StSeriesNode(ASeriesIndex);
end;

{ A SANKEY LINK'S CHAIN: its item, the level of its SOURCE's depth, the
  series [Batch 114] }
function TTyAdvanceChart.StEdgeNodes(ASeriesIndex, AEdge: Integer): TTyStNodeArray;
var slot: Integer; sNode: TJSONObject; links: TJSONData;
begin
  Result := nil;
  SetLength(Result, 3);
  slot := SlotOfSeries(ASeriesIndex);
  { [F2a] A GRAPH EDGE'S CHAIN: its link, the series }
  if (slot >= 0) and (FBindings[slot].SeriesType = TyGraphSeriesTypeName)
    and (slot <= High(FGraphEdges)) then
  begin
    sNode := StSeriesNode(ASeriesIndex);
    Result[2] := sNode;
    if (sNode = nil) or (AEdge < 0) or (AEdge > High(FGraphEdges[slot])) then Exit;
    links := sNode.Find('edges');
    if (links = nil) or (links.JSONType = jtNull) then links := sNode.Find('links');
    if (links is TJSONArray) and (FGraphEdges[slot][AEdge].Row >= 0)
      and (FGraphEdges[slot][AEdge].Row < links.Count)
      and (TJSONArray(links).Items[FGraphEdges[slot][AEdge].Row] is TJSONObject) then
      Result[0] := TJSONObject(TJSONArray(links).Items[FGraphEdges[slot][AEdge].Row]);
    Exit;
  end;
  { A CHORD LINK'S CHAIN: its item, the series (no levels) [Batch 120] }
  if (slot >= 0) and (slot <= High(FChords)) and FChords[slot].Valid then
  begin
    if (AEdge >= 0) and (AEdge <= High(FChords[slot].Edges)) then
      Result[0] := FChords[slot].Edges[AEdge].Item;
    Result[2] := StSeriesNode(ASeriesIndex);
    Exit;
  end;
  if (slot >= 0) and (slot <= High(FSankeys)) and FSankeys[slot].Valid
    and (AEdge >= 0) and (AEdge <= High(FSankeys[slot].Edges)) then
  begin
    Result[0] := FSankeys[slot].Edges[AEdge].Item;
    Result[1] := TySankeyLevel(FSankeys[slot],
      FSankeys[slot].Nodes[FSankeys[slot].Edges[AEdge].Source].Depth);
  end;
  Result[2] := StSeriesNode(ASeriesIndex);
end;

function TTyAdvanceChart.StIsSankey(ASeriesIndex: Integer): Boolean;
begin
  Result := (ASeriesIndex >= 0) and (ASeriesIndex <= High(FSt))
    and (FSt[ASeriesIndex].Kind = sskSankey);
end;

function TTyAdvanceChart.StIsChord(ASeriesIndex: Integer): Boolean;
begin
  Result := (ASeriesIndex >= 0) and (ASeriesIndex <= High(FSt))
    and (FSt[ASeriesIndex].Kind = sskChord);
end;

function TTyAdvanceChart.StHasEdges(ASeriesIndex: Integer): Boolean;
begin
  Result := StIsSankey(ASeriesIndex) or StIsChord(ASeriesIndex)
    { a graph's edge data [F2a] }
    or ((ASeriesIndex >= 0) and (ASeriesIndex <= High(FSt))
      and (FSt[ASeriesIndex].Kind = sskGraph));
end;

{ ONE CHORD RIBBON INTO THE STATE MACHINE [Batch 120]: a path whose states
  are setStatesStylesFromModel(el, edgeModel, 'lineStyle') -- getLineStyle
  of [state].lineStyle along link -> series: the colour a STROKE, the width
  its width -- the series' emphasis opacity 0.5 under what is declared. It
  has no label. }
procedure TTyAdvanceChart.StDeclareChordEdge(ASlot, AEdge: Integer; AList: TTyPaintList);
var
  s: Integer;
  item: PTyStItem;
  ph: PTyChartElement;
  nodes: TTyStNodeArray;
  has, bolder, disabled, prevWas: Boolean;
  prev: TTyStNames;
  n: TTyStName;
begin
  s := FBindings[ASlot].SeriesIndex;
  item := @FSt[s].EdgeRows[AEdge];
  ph := AList.Ref(FSt[s].EdgeHostIdx[AEdge]);
  nodes := StEdgeNodes(s, AEdge);
  prevWas := item^.Host.Exists;
  prev := item^.Host.States;
  item^.Host.Exists := True;
  item^.Host.IsPath := True;
  disabled := TyStReadBool(nodes, ['emphasis', 'disabled'], has);
  item^.Host.Proxy := not disabled;
  for n := Low(TTyStName) to High(TTyStName) do item^.Host.HasState[n] := True;
  item^.Host.Rest := StRestOf(ph^);
  for n := Low(TTyStName) to High(TTyStName) do
    item^.Host.Decl[n] := TyStReadStyle(nodes, cStNames[n], 'lineStyle', bolder);
  { ChordSeries' defaultOption: emphasis.lineStyle.opacity 0.5 }
  if not item^.Host.Decl[stnEmphasis].Has[stkOpacity] then
    TyStSetNum(item^.Host.Decl[stnEmphasis], stkOpacity, 0.5);
  item^.Label_ := Default(TTyStElement);
  if not prevWas then
  begin
    item^.Host.Cur := item^.Host.Rest;
    item^.Host.States := [];
  end
  else if FStRerender then
  begin
    TyStClearItem(item^);
    if prev <> [] then TyStUseItemStates(item^, prev);
  end;
  TyStApplyItem(item^);
end;

function TTyAdvanceChart.EdgeStates(ASeriesIndex, AIndex: Integer;
  out AItem: TTyStItem): Boolean;
begin
  AItem := Default(TTyStItem);
  Result := (ASeriesIndex >= 0) and (ASeriesIndex <= High(FSt)) and (AIndex >= 0)
    and (AIndex <= High(FSt[ASeriesIndex].EdgeRows))
    and FSt[ASeriesIndex].EdgeRows[AIndex].Host.Exists;
  if Result then AItem := FSt[ASeriesIndex].EdgeRows[AIndex];
end;

function TTyAdvanceChart.ChordEdgeStates(ASeriesIndex, AEdge: Integer;
  out AItem: TTyStItem): Boolean;
begin
  AItem := Default(TTyStItem);
  Result := StIsChord(ASeriesIndex) and (AEdge >= 0)
    and (AEdge <= High(FSt[ASeriesIndex].EdgeRows))
    and FSt[ASeriesIndex].EdgeRows[AEdge].Host.Exists;
  if Result then AItem := FSt[ASeriesIndex].EdgeRows[AEdge];
end;

{ applyCurveStyle on a state's style: 'source' / 'target' take that end
  node's colour [Batch 114] }
procedure TTyAdvanceChart.StSankeyCurveFill(ASlot, AEdge: Integer;
  const ANodes: TTyStNodeArray; const AState: string; var AObj: TTyStObject);
var w: string; has: Boolean; n: Integer;
begin
  w := TyStReadString(ANodes, [AState, 'lineStyle', 'color'], has);
  if not has then Exit;
  if (w <> 'source') and (w <> 'target') then Exit;
  if w = 'source' then n := FSankeys[ASlot].Edges[AEdge].Source
  else n := FSankeys[ASlot].Edges[AEdge].Target;
  if FSankeys[ASlot].Nodes[n].HasColour then
    TyStSetColor(AObj, stkFill, FSankeys[ASlot].Nodes[n].Colour);
end;

{ ONE SANKEY LINK INTO THE STATE MACHINE [Batch 114]: the band a path whose
  states are setStatesStylesFromModel(curve, edgeModel, 'lineStyle') --
  getItemStyle of [state].lineStyle, the words through applyCurveStyle --
  the series' emphasis opacity 0.5 under what is declared; its label the
  band's list. }
procedure TTyAdvanceChart.StDeclareEdge(ASlot, AEdge: Integer; AList: TTyPaintList);
var
  s, idx: Integer;
  item: PTyStItem;
  cap: TTyChartElement;
  ph: PTyChartElement;
  nodes: TTyStNodeArray;
  has, bolder, disabled, was, prevWas: Boolean;
  prev: TTyStNames;
  n: TTyStName;
  ss: Double;
  obj: TTyStObject;
begin
  s := FBindings[ASlot].SeriesIndex;
  item := @FSt[s].EdgeRows[AEdge];
  ph := AList.Ref(FSt[s].EdgeHostIdx[AEdge]);
  nodes := StEdgeNodes(s, AEdge);
  prevWas := item^.Host.Exists;
  prev := item^.Host.States;
  item^.Host.Exists := True;
  item^.Host.IsPath := True;
  disabled := TyStReadBool(nodes, ['emphasis', 'disabled'], has);
  item^.Host.Proxy := not disabled;
  for n := Low(TTyStName) to High(TTyStName) do item^.Host.HasState[n] := True;
  item^.Host.Rest := StRestOf(ph^);
  for n := Low(TTyStName) to High(TTyStName) do
  begin
    obj := TyStReadStyle(nodes, cStNames[n], 'lineStyle:item', bolder);
    StSankeyCurveFill(ASlot, AEdge, nodes, cStNames[n], obj);
    item^.Host.Decl[n] := obj;
  end;
  { SankeySeries' defaultOption: emphasis.lineStyle.opacity 0.5 }
  if not item^.Host.Decl[stnEmphasis].Has[stkOpacity] then
    TyStSetNum(item^.Host.Decl[stnEmphasis], stkOpacity, 0.5);
  { the label: the band's list, the blur proxy's tenth }
  idx := FSt[s].EdgeLabelIdx[AEdge];
  was := item^.Label_.Exists;
  if idx < 0 then
    item^.Label_ := Default(TTyStElement)
  else
  begin
    cap := AList.Element(idx);
    item^.Label_.Exists := True;
    item^.Label_.IsPath := False;
    item^.Label_.Proxy := not disabled;
    for n := Low(TTyStName) to High(TTyStName) do
    begin
      item^.Label_.HasState[n] := True;
      obj := TyStNoObject;
      ss := TyStReadNumber(nodes, [cStNames[n], 'edgeLabel', 'opacity'], has);
      if has and not IsNan(ss) then TyStSetNum(obj, stkOpacity, ss);
      item^.Label_.Decl[n] := obj;
    end;
    item^.Label_.Rest := StLabelRestOf(cap);
    if not was then
    begin
      item^.Label_.Cur := item^.Label_.Rest;
      item^.Label_.States := [];
      if item^.Host.Exists and (item^.Host.States <> []) then
        TyStUseStates(item^.Label_, item^.Host.States);
    end;
  end;
  if not prevWas then
  begin
    item^.Host.Cur := item^.Host.Rest;
    item^.Host.States := [];
  end
  else if FStRerender then
  begin
    TyStClearItem(item^);
    if prev <> [] then TyStUseItemStates(item^, prev);
  end;
  TyStApplyItem(item^);
end;

{ ==================== graph, tree and treemap states [F2a] ==================== }

function TTyAdvanceChart.StGraphNodeOfRaw(ASlot, ARaw: Integer): Integer;
var j: Integer;
begin
  Result := -1;
  if (ASlot < 0) or (ASlot > High(FGraphNodes)) then Exit;
  for j := 0 to High(FGraphNodes[ASlot]) do
    if FGraphNodes[ASlot][j].RawRow = ARaw then Exit(j);
end;

function TTyAdvanceChart.StGraphEdgeOfRow(ASlot, ARow: Integer): Integer;
var j: Integer;
begin
  Result := -1;
  if (ASlot < 0) or (ASlot > High(FGraphEdges)) then Exit;
  for j := 0 to High(FGraphEdges[ASlot]) do
    if FGraphEdges[ASlot][j].Row = ARow then Exit(j);
end;

{ the edge data after Graph.update's filterSelf: an edge whose two ends both
  survive the legend }
function GraphEdgeSurvives(const ANodes: TTyGraphNodeArray; const AEdge: TTyGraphEdge): Boolean;
begin
  Result := (AEdge.Source >= 0) and (AEdge.Source <= High(ANodes))
    and (AEdge.Target >= 0) and (AEdge.Target <= High(ANodes))
    and (ANodes[AEdge.Source].Row >= 0) and (ANodes[AEdge.Target].Row >= 0);
end;

function TTyAdvanceChart.StGraphEdgeInner(ASlot, AEdge: Integer): Integer;
var j: Integer;
begin
  Result := -1;
  if (ASlot < 0) or (ASlot > High(FGraphEdges)) then Exit;
  if (AEdge < 0) or (AEdge > High(FGraphEdges[ASlot])) then Exit;
  if not GraphEdgeSurvives(FGraphNodes[ASlot], FGraphEdges[ASlot][AEdge]) then Exit;
  Result := 0;
  for j := 0 to AEdge - 1 do
    if GraphEdgeSurvives(FGraphNodes[ASlot], FGraphEdges[ASlot][j]) then Inc(Result);
end;

function TTyAdvanceChart.StGraphEdgeOfInner(ASlot, AInner: Integer): Integer;
var j, n: Integer;
begin
  Result := -1;
  if (ASlot < 0) or (ASlot > High(FGraphEdges)) or (AInner < 0) then Exit;
  n := 0;
  for j := 0 to High(FGraphEdges[ASlot]) do
    if GraphEdgeSurvives(FGraphNodes[ASlot], FGraphEdges[ASlot][j]) then
    begin
      if n = AInner then Exit(j);
      Inc(n);
    end;
end;

{ [F3a] the slot holds a solved sankey }
function TTyAdvanceChart.StSankeySlot(ASlot: Integer): Boolean;
begin
  Result := (ASlot >= 0) and (ASlot <= High(FBindings)) and (ASlot <= High(FSankeys))
    and FSankeys[ASlot].Valid and (FBindings[ASlot].SeriesType = TySankeySeriesTypeName);
end;

function TTyAdvanceChart.StChordSlot(ASlot: Integer): Boolean;
begin
  Result := (ASlot >= 0) and (ASlot <= High(FBindings)) and (ASlot <= High(FChords))
    and FChords[ASlot].Valid and (FBindings[ASlot].SeriesType = TyChordSeriesTypeName);
end;

function TTyAdvanceChart.SelEdgeData(ASlot: Integer): TTySelData;
var
  j, n, s: Integer;
  links: TJSONData;
  sNode, item: TJSONObject;
  has: Boolean;
begin
  Result := Default(TTySelData);
  { [F3b] A CHORD'S EDGE DATA: every link the graph took, keyed by its name
    (createGraphFromNodeEdge's: the id, else 'source > target'), its index
    its own }
  if StChordSlot(ASlot) then
  begin
    s := FBindings[ASlot].SeriesIndex;
    sNode := StSeriesNode(s);
    n := Length(FChords[ASlot].Edges);
    SetLength(Result.Keys, n);
    SetLength(Result.Raws, n);
    SetLength(Result.Disabled, n);
    for j := 0 to n - 1 do
    begin
      Result.Keys[j] := FChords[ASlot].Edges[j].Name;
      if Result.Keys[j] = '' then Result.Keys[j] := 'e'#0#0 + IntToStr(j);
      Result.Raws[j] := j;
      Result.Disabled[j] := TyStReadBool([FChords[ASlot].Edges[j].Item, sNode],
        ['select', 'disabled'], has);
    end;
    Exit;
  end;
  { [F3a] A SANKEY'S EDGE DATA: every link of the solve, keyed by its name
    (the link's id, else 'source > target'), its raw index its own }
  if StSankeySlot(ASlot) then
  begin
    s := FBindings[ASlot].SeriesIndex;
    sNode := StSeriesNode(s);
    n := Length(FSankeys[ASlot].Edges);
    SetLength(Result.Keys, n);
    SetLength(Result.Raws, n);
    SetLength(Result.Disabled, n);
    for j := 0 to n - 1 do
    begin
      Result.Keys[j] := FSankeys[ASlot].Edges[j].DataName;
      if Result.Keys[j] = '' then Result.Keys[j] := 'e'#0#0 + IntToStr(j);
      Result.Raws[j] := j;
      Result.Disabled[j] := TyStReadBool([FSankeys[ASlot].Edges[j].Item, sNode],
        ['select', 'disabled'], has);
    end;
    Exit;
  end;
  if (ASlot < 0) or (ASlot > High(FGraphEdges)) then Exit;
  s := FBindings[ASlot].SeriesIndex;
  sNode := StSeriesNode(s);
  links := nil;
  if sNode <> nil then
  begin
    links := sNode.Find('edges');
    if (links = nil) or (links.JSONType = jtNull) then links := sNode.Find('links');
  end;
  n := 0;
  for j := 0 to High(FGraphEdges[ASlot]) do
    if GraphEdgeSurvives(FGraphNodes[ASlot], FGraphEdges[ASlot][j]) then Inc(n);
  SetLength(Result.Keys, n);
  SetLength(Result.Raws, n);
  SetLength(Result.Disabled, n);
  n := 0;
  for j := 0 to High(FGraphEdges[ASlot]) do
  begin
    if not GraphEdgeSurvives(FGraphNodes[ASlot], FGraphEdges[ASlot][j]) then Continue;
    { the edge data's name: the link's id, else 'source > target' }
    Result.Keys[n] := FGraphEdges[ASlot][j].DataName;
    if Result.Keys[n] = '' then Result.Keys[n] := 'e'#0#0 + IntToStr(FGraphEdges[ASlot][j].RawIndex);
    Result.Raws[n] := FGraphEdges[ASlot][j].RawIndex;
    item := nil;
    if (links is TJSONArray) and (FGraphEdges[ASlot][j].Row >= 0)
      and (FGraphEdges[ASlot][j].Row < links.Count)
      and (TJSONArray(links).Items[FGraphEdges[ASlot][j].Row] is TJSONObject) then
      item := TJSONObject(TJSONArray(links).Items[FGraphEdges[ASlot][j].Row]);
    Result.Disabled[n] := TyStReadBool([item, sNode], ['select', 'disabled'], has);
    Inc(n);
  end;
end;

{ queryDataIndex on the edge data (dataIndexInside as it is, dataIndex raw,
  else the edge data's name), as solved edge indices }
function TTyAdvanceChart.QueryEdgeIndex(ASlot: Integer; APayload: TJSONObject;
  out AEdges: TTyIntegerArray): Boolean;
var
  d: TJSONData;
  mode, k: Integer;

  function One(AItem: TJSONData): Integer;
  var j: Integer;
  begin
    Result := -1;
    { [F3a] a sankey's edge data is every link: an index as it is }
    if StSankeySlot(ASlot) then
    begin
      if mode = 2 then
      begin
        if not (AItem.JSONType in [jtString, jtNumber]) then Exit;
        for j := 0 to High(FSankeys[ASlot].Edges) do
          if FSankeys[ASlot].Edges[j].DataName = AItem.AsString then Exit(j);
        Exit;
      end;
      if (AItem.JSONType <> jtNumber) or (Frac(AItem.AsFloat) <> 0) then Exit;
      j := Trunc(AItem.AsFloat);
      if (j >= 0) and (j <= High(FSankeys[ASlot].Edges)) then Result := j;
      Exit;
    end;
    { [F3b] a chord's too }
    if StChordSlot(ASlot) then
    begin
      if mode = 2 then
      begin
        if not (AItem.JSONType in [jtString, jtNumber]) then Exit;
        for j := 0 to High(FChords[ASlot].Edges) do
          if FChords[ASlot].Edges[j].Name = AItem.AsString then Exit(j);
        Exit;
      end;
      if (AItem.JSONType <> jtNumber) or (Frac(AItem.AsFloat) <> 0) then Exit;
      j := Trunc(AItem.AsFloat);
      if (j >= 0) and (j <= High(FChords[ASlot].Edges)) then Result := j;
      Exit;
    end;
    if mode = 2 then
    begin
      if not (AItem.JSONType in [jtString, jtNumber]) then Exit;
      for j := 0 to High(FGraphEdges[ASlot]) do
        if GraphEdgeSurvives(FGraphNodes[ASlot], FGraphEdges[ASlot][j])
          and (FGraphEdges[ASlot][j].DataName = AItem.AsString) then Exit(j);
      Exit;
    end;
    if (AItem.JSONType <> jtNumber) or (Frac(AItem.AsFloat) <> 0) then Exit;
    if mode = 0 then Exit(StGraphEdgeOfInner(ASlot, Trunc(AItem.AsFloat)));
    for j := 0 to High(FGraphEdges[ASlot]) do
      if (FGraphEdges[ASlot][j].RawIndex = Trunc(AItem.AsFloat))
        and GraphEdgeSurvives(FGraphNodes[ASlot], FGraphEdges[ASlot][j]) then Exit(j);
  end;

begin
  AEdges := nil;
  Result := False;
  if not (StSankeySlot(ASlot) or StChordSlot(ASlot))
    and ((ASlot < 0) or (ASlot > High(FGraphEdges))) then Exit;
  mode := 0;
  d := APayload.Find('dataIndexInside');
  if (d = nil) or (d.JSONType = jtNull) then
  begin
    mode := 1;
    d := APayload.Find('dataIndex');
  end;
  if (d = nil) or (d.JSONType = jtNull) then
  begin
    mode := 2;
    d := APayload.Find('name');
  end;
  if (d = nil) or (d.JSONType = jtNull) then Exit;
  Result := True;
  if d is TJSONArray then
  begin
    SetLength(AEdges, d.Count);
    for k := 0 to d.Count - 1 do AEdges[k] := One(d.Items[k]);
  end
  else
  begin
    SetLength(AEdges, 1);
    AEdges[0] := One(d);
  end;
end;

{ A GRAPH'S EDGE (Line.ts _updateCommonStl): the line's states are its
  lineStyle's along link -> series; the arrows take the line's state stroke
  as their fill and its opacity; the label's states are the link's `label`,
  the series' `edgeLabel` (resolveParentPath), its emphasis show defaulting
  to the normal one (defaultEmphasis). emphasis.disabled: no dispatcher, no
  proxy on any of them. }
procedure TTyAdvanceChart.StDeclareGraphEdge(ASlot, AEdge: Integer; AList: TTyPaintList);
var
  s, idx, k: Integer;
  item: PTyStItem;
  cap: TTyChartElement;
  ph: PTyChartElement;
  nodes: TTyStNodeArray;
  has, bolder, disabled, was, prevWas, normalShow, stShow: Boolean;
  prev: TTyStNames;
  n: TTyStName;
  obj: TTyStObject;
  d: TJSONData;
  ss: Double;
  c: TTyChartColor;

  function EdgeLab(const AState, AKey: string): TJSONData;
  begin
    Result := TyStFind([nodes[0]], [AState, 'label', AKey]);
    if Result = nil then Result := TyStFind([nodes[2]], [AState, 'edgeLabel', AKey]);
  end;

begin
  s := FBindings[ASlot].SeriesIndex;
  item := @FSt[s].EdgeRows[AEdge];
  ph := AList.Ref(FSt[s].EdgeHostIdx[AEdge]);
  nodes := StEdgeNodes(s, AEdge);
  prevWas := item^.Host.Exists;
  prev := item^.Host.States;
  item^.Host.Exists := True;
  item^.Host.IsPath := True;
  disabled := TyStReadBool(nodes, ['emphasis', 'disabled'], has);
  item^.Host.Proxy := not disabled;
  for n := Low(TTyStName) to High(TTyStName) do item^.Host.HasState[n] := True;
  item^.Host.Rest := StRestOf(ph^);
  for n := Low(TTyStName) to High(TTyStName) do
    item^.Host.Decl[n] := TyStReadStyle(nodes, cStNames[n], 'lineStyle', bolder);
  { ---- the arrows ---- }
  if Length(item^.Parts) <> Length(FSt[s].EdgePartIdx[AEdge]) then SetLength(item^.Parts, 0);
  was := Length(item^.Parts) > 0;
  SetLength(item^.Parts, Length(FSt[s].EdgePartIdx[AEdge]));
  for k := 0 to High(item^.Parts) do
  begin
    item^.Parts[k].Exists := True;
    item^.Parts[k].IsPath := True;
    item^.Parts[k].Proxy := not disabled;
    item^.Parts[k].Rest := StRestOf(AList.Element(FSt[s].EdgePartIdx[AEdge][k]));
    for n := Low(TTyStName) to High(TTyStName) do
    begin
      item^.Parts[k].HasState[n] := True;
      obj := TyStNoObject;
      if item^.Host.Decl[n].Has[stkStroke] then
      begin
        obj.Has[stkFill] := True;
        obj.Color[stkFill] := item^.Host.Decl[n].Color[stkStroke];
        obj.None[stkFill] := item^.Host.Decl[n].None[stkStroke];
      end;
      if item^.Host.Decl[n].Has[stkOpacity] then
        TyStSetNum(obj, stkOpacity, item^.Host.Decl[n].Num[stkOpacity]);
      item^.Parts[k].Decl[n] := obj;
    end;
    if not was then
    begin
      item^.Parts[k].Cur := item^.Parts[k].Rest;
      item^.Parts[k].States := [];
      if item^.Host.States <> [] then TyStUseStates(item^.Parts[k], item^.Host.States);
    end;
  end;
  { ---- the label ---- }
  idx := FSt[s].EdgeLabelIdx[AEdge];
  was := item^.Label_.Exists;
  if idx < 0 then
    item^.Label_ := Default(TTyStElement)
  else
  begin
    cap := AList.Element(idx);
    item^.Label_.Exists := True;
    item^.Label_.IsPath := False;
    item^.Label_.Proxy := not disabled;
    item^.Label_.Rest := StLabelRestOf(cap);
    normalShow := not cap.Ignore;
    for n := Low(TTyStName) to High(TTyStName) do
    begin
      item^.Label_.HasState[n] := True;
      obj := TyStNoObject;
      d := EdgeLab(cStNames[n], 'show');
      if (d = nil) and (n = stnEmphasis) then stShow := normalShow
      else if d <> nil then stShow := (d.JSONType = jtBoolean) and d.AsBoolean
      else stShow := normalShow;
      if stShow <> normalShow then TyStSetNum(obj, stkIgnore, Ord(not stShow));
      d := EdgeLab(cStNames[n], 'color');
      if (d <> nil) and (d.JSONType = jtString) and (d.AsString <> 'inherit')
        and (d.AsString <> 'auto') and TyTryParseChartColor(d.AsString, c) then
        TyStSetColor(obj, stkFill, c);
      d := EdgeLab(cStNames[n], 'opacity');
      if (d <> nil) and (d.JSONType = jtNumber) then
      begin
        ss := d.AsFloat;
        if not IsNan(ss) then TyStSetNum(obj, stkOpacity, ss);
      end;
      item^.Label_.Decl[n] := obj;
    end;
    if not was then
    begin
      item^.Label_.Cur := item^.Label_.Rest;
      item^.Label_.States := [];
      if item^.Host.Exists and (item^.Host.States <> []) then
        TyStUseStates(item^.Label_, item^.Host.States);
    end;
  end;
  if not prevWas then
  begin
    item^.Host.Cur := item^.Host.Rest;
    item^.Host.States := [];
  end
  else if FStRerender then
  begin
    TyStClearItem(item^);
    if prev <> [] then TyStUseItemStates(item^, prev);
  end;
end;

{ A TREE'S EDGE (TreeView.ts drawEdge): setStatesStylesFromModel(edge,
  itemModel, 'lineStyle') along the node's chain and the default proxy --
  installed whatever the node's emphasis says; no label, no dispatcher }
procedure TTyAdvanceChart.StDeclareTreeEdge(ASlot, ARaw: Integer; AList: TTyPaintList);
var
  s: Integer;
  item: PTyStItem;
  nodes: TTyStNodeArray;
  bolder, prevWas: Boolean;
  prev: TTyStNames;
  n: TTyStName;
begin
  s := FBindings[ASlot].SeriesIndex;
  item := @FSt[s].EdgeRows[ARaw];
  nodes := StNodes(s, ARaw);
  prevWas := item^.Host.Exists;
  prev := item^.Host.States;
  item^.Host.Exists := True;
  item^.Host.IsPath := True;
  item^.Host.Proxy := True;
  item^.NoDispatch := True;
  for n := Low(TTyStName) to High(TTyStName) do
  begin
    item^.Host.HasState[n] := True;
    item^.Host.Decl[n] := TyStReadStyle(nodes, cStNames[n], 'lineStyle', bolder);
  end;
  item^.Host.Rest := StRestOf(AList.Element(FSt[s].EdgeHostIdx[ARaw]));
  item^.Label_ := Default(TTyStElement);
  if not prevWas then
  begin
    item^.Host.Cur := item^.Host.Rest;
    item^.Host.States := [];
  end
  else if FStRerender then
  begin
    TyStClearItem(item^);
    if prev <> [] then TyStUseItemStates(item^, prev);
  end;
end;

{ A TREEMAP NODE (TreemapView.ts renderNode): every state's style is
  getStateItemStyle of [state].itemStyle -- color the fill, strokeColor the
  stroke, strokeWidth the width, never an opacity -- and a background's
  fill is the state's borderColor, written whether or not it is declared (an
  undeclared one takes the fill away). The proxy always; a disabled
  emphasis only stops the dispatcher. A leaf's group dispatches (its content
  hosts, its background is a part with states of its own); a parent's
  background alone. The labels: the content's `label`, a header's
  `upperLabel` (shown under emphasis by default). }
procedure TTyAdvanceChart.StDeclareTreemap(ASlot, ARaw: Integer; AList: TTyPaintList);
var
  s, idx, k: Integer;
  item: PTyStItem;
  cap: TTyChartElement;
  ph: PTyChartElement;
  nodes: TTyStNodeArray;
  has, was, normalShow, stShow, isBg: Boolean;
  n: TTyStName;
  obj: TTyStObject;
  key, txt: string;
  ss: Double;
  c: TTyChartColor;

  function StateStyle(AIsBg: Boolean; AState: TTyStName): TTyStObject;
  var t: string; h: Boolean; col: TTyChartColor; v: Double;
  begin
    Result := TyStNoObject;
    if AIsBg then
    begin
      t := TyStReadString(nodes, [cStNames[AState], 'itemStyle', 'borderColor'], h);
      if h and TyTryParseChartColor(t, col) then TyStSetColor(Result, stkFill, col)
      else TyStSetNone(Result, stkFill);
    end
    else
    begin
      t := TyStReadString(nodes, [cStNames[AState], 'itemStyle', 'color'], h);
      if h and TyTryParseChartColor(t, col) then TyStSetColor(Result, stkFill, col);
    end;
    t := TyStReadString(nodes, [cStNames[AState], 'itemStyle', 'strokeColor'], h);
    if h and TyTryParseChartColor(t, col) then TyStSetColor(Result, stkStroke, col);
    v := TyStReadNumber(nodes, [cStNames[AState], 'itemStyle', 'strokeWidth'], h);
    if h and not IsNan(v) then TyStSetNum(Result, stkLineWidth, v);
  end;

  procedure Declare(var AEl: TTyStElement; const AFrom: TTyChartElement);
  var m: TTyStName;
  begin
    AEl.Exists := True;
    AEl.IsPath := True;
    AEl.Proxy := True;
    AEl.Rest := StRestOf(AFrom);
    for m := Low(TTyStName) to High(TTyStName) do
    begin
      AEl.HasState[m] := True;
      AEl.Decl[m] := StateStyle(AFrom.Anim.Sub = 0, m);
    end;
  end;

begin
  s := FBindings[ASlot].SeriesIndex;
  item := @FSt[s].Rows[ARaw];
  ph := AList.Ref(FSt[s].HostIdx[ARaw]);
  nodes := StNodes(s, ARaw);
  item^.NoDispatch := TyStReadBool(nodes, ['emphasis', 'disabled'], has);
  { a leaf's node group dispatches: its content (or its lone background)
    hosts; a parent's background alone }
  item^.HasGroup := (ph^.Anim.Sub = 1) or (ph^.Anim.G[4] <> 0);
  Declare(item^.Host, ph^);
  if Length(item^.Parts) <> Length(FSt[s].PartIdx[ARaw]) then SetLength(item^.Parts, 0);
  was := Length(item^.Parts) > 0;
  SetLength(item^.Parts, Length(FSt[s].PartIdx[ARaw]));
  for k := 0 to High(item^.Parts) do
  begin
    Declare(item^.Parts[k], AList.Element(FSt[s].PartIdx[ARaw][k]));
    if not was then
    begin
      item^.Parts[k].Cur := item^.Parts[k].Rest;
      item^.Parts[k].States := [];
      if item^.Host.States <> [] then TyStUseStates(item^.Parts[k], item^.Host.States);
    end;
  end;
  item^.Guide := Default(TTyStElement);
  { the label of the host: a content's `label`, a background's `upperLabel` }
  idx := FSt[s].LabelIdx[ARaw];
  was := item^.Label_.Exists;
  if idx < 0 then
    item^.Label_ := Default(TTyStElement)
  else
  begin
    cap := AList.Element(idx);
    isBg := ph^.Anim.Sub = 0;
    if isBg then key := 'upperLabel' else key := 'label';
    item^.Label_.Exists := True;
    item^.Label_.IsPath := False;
    item^.Label_.Proxy := True;
    item^.Label_.Rest := StLabelRestOf(cap);
    normalShow := not cap.Ignore;
    for n := Low(TTyStName) to High(TTyStName) do
    begin
      item^.Label_.HasState[n] := True;
      obj := TyStNoObject;
      stShow := TyStReadBool(nodes, [cStNames[n], key, 'show'], has);
      { TreemapSeries' emphasis.upperLabel.show }
      if (n = stnEmphasis) and isBg and not has then
      begin
        stShow := True;
        has := True;
      end;
      if has and (stShow <> normalShow) then TyStSetNum(obj, stkIgnore, Ord(not stShow));
      txt := TyStReadString(nodes, [cStNames[n], key, 'color'], has);
      if has and (txt <> 'inherit') and (txt <> 'auto') and TyTryParseChartColor(txt, c) then
        TyStSetColor(obj, stkFill, c);
      ss := TyStReadNumber(nodes, [cStNames[n], key, 'opacity'], has);
      if has and not IsNan(ss) then TyStSetNum(obj, stkOpacity, ss);
      item^.Label_.Decl[n] := obj;
    end;
    if not was then
    begin
      item^.Label_.Cur := item^.Label_.Rest;
      item^.Label_.States := [];
      if item^.Host.Exists and (item^.Host.States <> []) then
        TyStUseStates(item^.Label_, item^.Host.States);
    end;
  end;
end;

procedure TTyAdvanceChart.StTreeFollow(ASeriesIndex, ARaw, AOld: Integer);
var
  slot, par, nw: Integer;
begin
  if (ASeriesIndex < 0) or (ASeriesIndex > High(FSt)) then Exit;
  if FSt[ASeriesIndex].Kind <> sskTree then Exit;
  if (ARaw < 0) or (ARaw > High(FSt[ASeriesIndex].Rows)) then Exit;
  nw := FSt[ASeriesIndex].Rows[ARaw].GroupHover;
  if (nw = AOld) or (nw = TyStHoverBlur) then Exit;
  if (ARaw > High(FSt[ASeriesIndex].EdgeRows))
    or not FSt[ASeriesIndex].EdgeRows[ARaw].Host.Exists then Exit;
  slot := SlotOfSeries(ASeriesIndex);
  if (slot < 0) or (slot > High(FTrees)) or not FTrees[slot].Valid then Exit;
  if ARaw > High(FTrees[slot].Hier.Nodes) then Exit;
  par := FTrees[slot].Hier.Nodes[ARaw].Parent;
  { the parent's symbol blurred at this moment: the edge stays }
  if (par >= 0) and (par <= High(FSt[ASeriesIndex].Rows))
    and FSt[ASeriesIndex].Rows[par].Host.Exists
    and (FSt[ASeriesIndex].Rows[par].GroupHover = TyStHoverBlur) then Exit;
  FSt[ASeriesIndex].EdgeRows[ARaw].Host.HoverState := nw;
  FStDirty := True;
end;

function TTyAdvanceChart.StItemFocus(ASeriesIndex, ARaw: Integer;
  out AScope: TTyStScope): TTyStFocus;
var
  nodes: TTyStNodeArray;
  d, legacy: TJSONData;
  w: string;
  slot, i, p: Integer;
  anc, ns, es: TTyIntegerArray;
  adj: Boolean;
  hier: TTyHierarchy;
  info: TTyCustomElInfo;
  txt: TJSONString;

  procedure Add(AIndex: Integer);
  begin
    SetLength(Result.Indices, Length(Result.Indices) + 1);
    Result.Indices[High(Result.Indices)] := AIndex;
  end;

begin
  nodes := StNodes(ASeriesIndex, ARaw);
  d := TyStFind(nodes, ['emphasis', 'focus']);
  AScope := TyStScopeOf(TyStFind(nodes, ['emphasis', 'blurScope']));
  slot := SlotOfSeries(ASeriesIndex);
  { A CUSTOM ITEM'S focus and blurScope are its root option's
    (toggleHoverEmphasis(el, elOption.focus, elOption.blurScope)), never the
    series' emphasis: none written is no focus [Batch 124] }
  if (slot >= 0) and (FBindings[slot].SeriesType = TyCustomSeriesType) then
  begin
    Result := Default(TTyStFocus);
    AScope := TyStScopeOf(nil);
    info := nil;
    if (ASeriesIndex >= 0) and (ASeriesIndex <= High(FCustomViews))
      and (FCustomViews[ASeriesIndex] <> nil)
      and (FCustomViews[ASeriesIndex].ElOfRaw(ARaw) <> nil)
      and (FCustomViews[ASeriesIndex].ElOfRaw(ARaw).Custom is TTyCustomElInfo) then
      info := TTyCustomElInfo(FCustomViews[ASeriesIndex].ElOfRaw(ARaw).Custom);
    if (info = nil) or (info.Focus = '') then Exit;
    txt := TJSONString.Create(info.Focus);
    try
      Result := TyStFocusOf(txt);
    finally
      txt.Free;
    end;
    if info.BlurScope <> '' then
    begin
      txt := TJSONString.Create(info.BlurScope);
      try
        AScope := TyStScopeOf(txt);
      finally
        txt.Free;
      end;
    end;
    Exit;
  end;
  { A SANKEY'S WORDS ARE TWO INDEX SETS (SankeyView: adjacency and
    trajectory become getAdjacentDataIndices / getTrajectoryDataIndices)
    [Batch 114] }
  if StIsSankey(ASeriesIndex) and (d <> nil) and (d.JSONType = jtString)
    and ((d.AsString = 'adjacency') or (d.AsString = 'trajectory')) then
  begin
    Result := Default(TTyStFocus);
    Result.Kind := sfkIndices;
    TySankeyFocusSets(FSankeys[slot], False, ARaw, d.AsString = 'trajectory',
      Result.Indices, Result.EdgeIndices);
    Exit;
  end;
  { A CHORD NODE'S 'adjacency' -- the series' default -- is getAdjacentData-
    Indices: its kept links and their ends (ChordPiece) [Batch 120] }
  if StIsChord(ASeriesIndex) then
  begin
    if (d = nil) or ((d.JSONType = jtString) and (d.AsString = 'adjacency')) then
    begin
      Result := Default(TTyStFocus);
      Result.Kind := sfkIndices;
      TyChordFocusSets(FChords[slot], False, ARaw, Result.Indices, Result.EdgeIndices);
      Exit;
    end;
    Exit(TyStFocusOf(d));
  end;
  { [F2a] A GRAPH NODE'S 'adjacency' (the legacy focusNodeAdjacency where no
    focus is written, any value but null): getAdjacentDataIndices -- its
    edges and both ends of each -- in two index sets }
  if (ASeriesIndex >= 0) and (ASeriesIndex <= High(FSt))
    and (FSt[ASeriesIndex].Kind = sskGraph) then
  begin
    adj := False;
    if d = nil then
    begin
      legacy := nil;
      if nodes[2] <> nil then legacy := nodes[2].Find('focusNodeAdjacency');
      adj := (legacy <> nil) and (legacy.JSONType <> jtNull);
    end
    else
      adj := (d.JSONType = jtString) and (d.AsString = 'adjacency');
    if not adj then Exit(TyStFocusOf(d));
    Result := Default(TTyStFocus);
    Result.Kind := sfkIndices;
    TyGraphFocusSets(FGraphNodes[slot], FGraphEdges[slot], False,
      StGraphNodeOfRaw(slot, ARaw), ns, es);
    for i := 0 to High(ns) do
      if (ns[i] >= 0) and (ns[i] <= High(FGraphNodes[slot]))
        and (FGraphNodes[slot][ns[i]].Row >= 0) then Add(FGraphNodes[slot][ns[i]].Row);
    Result.EdgeIndices := es;
    Exit;
  end;
  { [F2a] A TREE'S WORDS (TreeView.ts:447-457): ancestor, descendant,
    relative as data indices -- the virtual root and the node itself among
    them; A TREEMAP'S (TreemapView.ts:822-825) ancestor and descendant only }
  if (ASeriesIndex >= 0) and (ASeriesIndex <= High(FSt))
    and (FSt[ASeriesIndex].Kind in [sskTree, sskTreemap]) then
  begin
    if (d <> nil) and (d.JSONType = jtString) then w := d.AsString else w := '';
    if (w <> 'ancestor') and (w <> 'descendant')
      and not ((w = 'relative') and (FSt[ASeriesIndex].Kind = sskTree)) then
      Exit(TyStFocusOf(d));
    Result := Default(TTyStFocus);
    Result.Kind := sfkIndices;
    if FSt[ASeriesIndex].Kind = sskTree then hier := FTrees[slot].Hier
    else hier := FTreemaps[slot].Hier;
    if (ARaw < 0) or (ARaw > High(hier.Nodes)) then Exit;
    if (w = 'ancestor') or (w = 'relative') then
    begin
      anc := nil;
      p := ARaw;
      while p >= 0 do
      begin
        SetLength(anc, Length(anc) + 1);
        anc[High(anc)] := p;
        p := hier.Nodes[p].Parent;
      end;
      for i := High(anc) downto 0 do Add(anc[i]);
    end;
    if (w = 'descendant') or (w = 'relative') then
    begin
      Add(ARaw);
      i := ARaw + 1;
      while (i <= High(hier.Nodes)) and (hier.Nodes[i].Depth > hier.Nodes[ARaw].Depth) do
      begin
        Add(i);
        Inc(i);
      end;
    end;
    Exit;
  end;
  if not ((slot >= 0) and (slot <= High(FSunbursts)) and FSunbursts[slot].Valid
    and (ARaw >= 0) and (ARaw <= High(FSunbursts[slot].Hier.Nodes))) then
    Exit(TyStFocusOf(d));
  { A SUNBURST'S WORDS ARE INDICES (SunburstPiece.ts:152-160), its default
    'descendant' (SunburstSeries.ts:271): the row's ancestors from the root
    down, its subtree in pre-order, or both [Batch 90] }
  if d = nil then w := 'descendant'
  else if d.JSONType = jtString then w := d.AsString
  else w := '';
  if (w <> 'descendant') and (w <> 'ancestor') and (w <> 'relative') then
    Exit(TyStFocusOf(d));
  Result := Default(TTyStFocus);
  Result.Kind := sfkIndices;
  if (w = 'ancestor') or (w = 'relative') then
  begin
    anc := nil;
    p := ARaw;
    while p >= 0 do
    begin
      SetLength(anc, Length(anc) + 1);
      anc[High(anc)] := p;
      p := FSunbursts[slot].Hier.Nodes[p].Parent;
    end;
    { the root's index finds no element (the return circle is not
      registered under it) [Batch 115] }
    for i := High(anc) downto 0 do
      if anc[i] <> 0 then Add(anc[i]);
  end;
  if (w = 'descendant') or (w = 'relative') then
    for i := 0 to High(FSunbursts[slot].Hier.Nodes) do
    begin
      p := i;
      while (p >= 0) and (p <> ARaw) do p := FSunbursts[slot].Hier.Nodes[p].Parent;
      if (p = ARaw) and (i <> 0) then Add(i);
    end;
end;

{ A SANKEY LINK'S focus: along link -> level -> series, the two words its
  index sets [Batch 114] }
function TTyAdvanceChart.StEdgeFocus(ASeriesIndex, AEdge: Integer;
  out AScope: TTyStScope): TTyStFocus;
var
  nodes: TTyStNodeArray;
  d, legacy: TJSONData;
  slot: Integer;
  adj: Boolean;
begin
  nodes := StEdgeNodes(ASeriesIndex, AEdge);
  d := TyStFind(nodes, ['emphasis', 'focus']);
  AScope := TyStScopeOf(TyStFind(nodes, ['emphasis', 'blurScope']));
  slot := SlotOfSeries(ASeriesIndex);
  { [F2a] A GRAPH EDGE'S 'adjacency': itself and its two ends (GraphView) }
  if (ASeriesIndex >= 0) and (ASeriesIndex <= High(FSt))
    and (FSt[ASeriesIndex].Kind = sskGraph) then
  begin
    adj := (d <> nil) and (d.JSONType = jtString) and (d.AsString = 'adjacency');
    if (d = nil) and (nodes[2] <> nil) then
    begin
      legacy := nodes[2].Find('focusNodeAdjacency');
      adj := (legacy <> nil) and (legacy.JSONType <> jtNull);
    end;
    if not adj or (AEdge < 0) or (AEdge > High(FGraphEdges[slot])) then Exit(TyStFocusOf(d));
    Result := Default(TTyStFocus);
    Result.Kind := sfkIndices;
    SetLength(Result.EdgeIndices, 1);
    Result.EdgeIndices[0] := AEdge;
    SetLength(Result.Indices, 2);
    Result.Indices[0] := FGraphNodes[slot][FGraphEdges[slot][AEdge].Source].Row;
    Result.Indices[1] := FGraphNodes[slot][FGraphEdges[slot][AEdge].Target].Row;
    Exit;
  end;
  { A CHORD RIBBON'S 'adjacency' -- the series' default -- itself and its two
    ends (ChordEdge) [Batch 120] }
  if StIsChord(ASeriesIndex) then
  begin
    if (d = nil) or ((d.JSONType = jtString) and (d.AsString = 'adjacency')) then
    begin
      Result := Default(TTyStFocus);
      Result.Kind := sfkIndices;
      TyChordFocusSets(FChords[slot], True, AEdge, Result.Indices, Result.EdgeIndices);
      Exit;
    end;
    Exit(TyStFocusOf(d));
  end;
  if (d <> nil) and (d.JSONType = jtString)
    and ((d.AsString = 'adjacency') or (d.AsString = 'trajectory')) then
  begin
    Result := Default(TTyStFocus);
    Result.Kind := sfkIndices;
    TySankeyFocusSets(FSankeys[slot], True, AEdge, d.AsString = 'trajectory',
      Result.Indices, Result.EdgeIndices);
    Exit;
  end;
  Result := TyStFocusOf(d);
end;

function TTyAdvanceChart.StSeriesFocus(ASeriesIndex: Integer;
  out AScope: TTyStScope): TTyStFocus;
var nodes: array[0..0] of TJSONObject;
begin
  nodes[0] := StSeriesNode(ASeriesIndex);
  Result := TyStFocusOf(TyStFind(nodes, ['emphasis', 'focus']));
  AScope := TyStScopeOf(TyStFind(nodes, ['emphasis', 'blurScope']));
end;

function TTyAdvanceChart.StInnerRaw(ASeriesIndex, AInner: Integer): Integer;
var slot: Integer;
begin
  Result := -1;
  if StIsSankey(ASeriesIndex) then Exit(AInner);
  slot := SlotOfSeries(ASeriesIndex);
  if (slot < 0) or (slot > High(FStores)) or (FStores[slot] = nil) then Exit;
  if (AInner < 0) or (AInner >= FStores[slot].Count) then Exit;
  Result := FStores[slot].GetRawIndex(AInner);
end;

{ blurSeries (util/states.ts:429-517): every SHOWN series the scope reaches
  -- by series, by coordinate system (a series with none matches only
  itself), or all -- except the target itself under focus 'series': every
  element enters blur, but one held by an action stays in the target series
  under focus 'self'; data indices of a focus list leave the blur again. }
procedure TTyAdvanceChart.StBlurSeries(ATarget: Integer; const AFocus: TTyStFocus;
  AScope: TTyStScope);
var
  slot, s, raw, k, poly, tslot, old: Integer;
  tkey, key: string;
  same, sameCoord, spare: Boolean;
  item: PTyStItem;
begin
  if ATarget < 0 then Exit;
  if AFocus.Kind = sfkNone then Exit;
  tslot := SlotOfSeries(ATarget);
  if tslot < 0 then Exit;
  tkey := StCoordKey(tslot);
  for slot := 0 to High(FBindings) do
  begin
    if FBindings[slot].Hidden then Continue;
    s := FBindings[slot].SeriesIndex;
    if (s < 0) or (s > High(FSt)) or (FSt[s].Kind = sskNone) then Continue;
    same := s = ATarget;
    key := StCoordKey(slot);
    if (key <> '') and (tkey <> '') then sameCoord := key = tkey
    else sameCoord := same;
    if not TyStBlursSeries(AFocus, AScope, same, sameCoord) then Continue;
    spare := same and (AFocus.Kind = sfkSelf);
    poly := StPolyOf(s);
    { the polyline and the area are elements of the group too }
    if poly >= 0 then poly := TyStHoverBlur;
    for raw := 0 to High(FSt[s].Rows) do
      if FSt[s].Rows[raw].Host.Exists then
        TyStItemEnterBlur(FSt[s].Rows[raw], spare, poly);
    if poly >= 0 then StPolyTo(s, poly);
    { the view group holds the links as well [Batch 114], a gauge's arcs
      too [F2b] }
    for raw := 0 to High(FSt[s].EdgeRows) do
      if FSt[s].EdgeRows[raw].Host.Exists then
      begin
        poly := -1;
        TyStItemEnterBlur(FSt[s].EdgeRows[raw], spare, poly);
      end;
    for raw := 0 to High(FSt[s].PeerRows) do
      if FSt[s].PeerRows[raw].Host.Exists then
      begin
        poly := -1;
        TyStItemEnterBlur(FSt[s].PeerRows[raw], spare, poly);
      end;
    if AFocus.Kind = sfkIndices then
    begin
      for k := 0 to High(AFocus.Indices) do
      begin
        item := StItemAt(s, AFocus.Indices[k]);
        if item = nil then Continue;
        poly := StPolyOf(s);
        old := item^.GroupHover;
        TyStItemLeaveBlur(item^, poly);
        if poly >= 0 then StPolyTo(s, poly);
        StTreeFollow(s, StInnerRaw(s, AFocus.Indices[k]), old);
      end;
      { the edge data's, by the same indices in every series blurred }
      for k := 0 to High(AFocus.EdgeIndices) do
        if (AFocus.EdgeIndices[k] >= 0) and (AFocus.EdgeIndices[k] <= High(FSt[s].EdgeRows))
          and FSt[s].EdgeRows[AFocus.EdgeIndices[k]].Host.Exists then
        begin
          poly := -1;
          TyStItemLeaveBlur(FSt[s].EdgeRows[AFocus.EdgeIndices[k]], poly);
        end;
    end;
    FSt[s].IsBlured := True;
    FStDirty := True;
  end;
end;

{ allLeaveBlur (util/states.ts:404-427): every series blurSeries reached
  leaves blur, whole; none is blured after }
procedure TTyAdvanceChart.StAllLeaveBlur;
var s, raw, poly, old: Integer;
begin
  for s := 0 to High(FSt) do
  begin
    if FSt[s].IsBlured then
    begin
      poly := StPolyOf(s);
      if poly = TyStHoverBlur then poly := TyStHoverNormal;
      for raw := 0 to High(FSt[s].Rows) do
        if FSt[s].Rows[raw].Host.Exists then
        begin
          old := FSt[s].Rows[raw].GroupHover;
          TyStItemLeaveBlur(FSt[s].Rows[raw], poly);
          StTreeFollow(s, raw, old);
        end;
      if poly >= 0 then StPolyTo(s, poly);
      for raw := 0 to High(FSt[s].EdgeRows) do
        if FSt[s].EdgeRows[raw].Host.Exists then
        begin
          poly := -1;
          TyStItemLeaveBlur(FSt[s].EdgeRows[raw], poly);
        end;
      for raw := 0 to High(FSt[s].PeerRows) do
        if FSt[s].PeerRows[raw].Host.Exists then
        begin
          poly := -1;
          TyStItemLeaveBlur(FSt[s].PeerRows[raw], poly);
        end;
      { the area on its own, should it be blurred apart from the polyline }
      if FSt[s].Area.Host.HoverState = TyStHoverBlur then
        FSt[s].Area.Host.HoverState := TyStHoverNormal;
      FStDirty := True;
    end;
    FSt[s].IsBlured := False;
  end;
  { [Batch 148] and every geo blurComponent reached }
  for s := 0 to High(FGeos) do
    if (FGeos[s] <> nil) and FGeos[s].IsBlured then
    begin
      if FGeos[s].LeaveBlurAll then
      begin
        FGeoDirty := True;
        FStDirty := True;
      end;
      FGeos[s].IsBlured := False;
    end;
end;

function TTyAdvanceChart.StDispatcher(const ATarget: TTyChartEventTarget;
  out AItem: PTyStItem; out APart: Integer): Boolean;
var
  s, idx, k: Integer;
  info: TTyCustomElInfo;
begin
  Result := False;
  AItem := nil;
  APart := -1;
  s := ATarget.HdSeries;
  if ATarget.HdKind = 1 then
  begin
    if ATarget.HdEdge then
    begin
      { a sankey link is a dispatcher of its own [Batch 114]; a chord
        ribbon too [Batch 120] }
      if not StHasEdges(s) then Exit;
      k := ATarget.HdRow;
      { a graph's elements carry the link's row [F2a] }
      if FSt[s].Kind = sskGraph then k := StGraphEdgeOfRow(SlotOfSeries(s), k);
      if (k < 0) or (k > High(FSt[s].EdgeRows)) then Exit;
      AItem := @FSt[s].EdgeRows[k];
      if not TyStItemDispatches(AItem^) then Exit;
      APart := 0;
      Exit(True);
    end;
    { a gauge's progress arc: the row's second dispatcher [F2b] }
    if ATarget.HdPeer then
    begin
      AItem := StPeerAt(s, ATarget.HdRow);
      if (AItem = nil) or not AItem^.Host.Proxy then Exit;
      APart := 0;
      Exit(True);
    end;
    AItem := StItemAt(s, ATarget.HdRow);
    { emphasis.disabled: not a highDownDispatcher at all }
    if (AItem = nil) or not TyStItemDispatches(AItem^) then Exit;
    { a custom item whose root option says emphasisDisabled
      (disableHoverEmphasis: no dispatcher) [Batch 124] }
    if (s >= 0) and (s <= High(FSt)) and (FSt[s].Kind = sskCustom) then
    begin
      info := CustomRootInfo(s, ATarget.HdRow);
      if (info <> nil) and info.EmphasisDisabled then Exit;
    end;
    APart := 0;
    Exit(True);
  end;
  if ATarget.HdKind <> 2 then Exit;
  if (s < 0) or (s > High(FSt)) or (FSt[s].Kind = sskNone) or not FSt[s].IsLine then Exit;
  idx := Integer(ATarget.Id) - 1;
  for k := 0 to High(FSt[s].RunIdx) do
    if FSt[s].RunIdx[k] = idx then
    begin
      AItem := @FSt[s].Run;
      APart := 1;
    end;
  for k := 0 to High(FSt[s].AreaIdx) do
    if FSt[s].AreaIdx[k] = idx then
    begin
      AItem := @FSt[s].Area;
      APart := 2;
    end;
  Result := (AItem <> nil) and AItem^.Host.Exists and AItem^.Host.Proxy;
end;

{ handleGlobalMouseOutForHighDown: allLeaveBlur, then the dispatcher leaves
  emphasis unless an action holds it }
procedure TTyAdvanceChart.StHoverOut(const ATarget: TTyChartEventTarget);
var item: PTyStItem; part, s, poly, old: Integer;
begin
  { [Batch 148] a geo region's group }
  if ATarget.HdKind = 14 then
  begin
    GeoHoverOut(ATarget);
    Exit;
  end;
  { [Batch 116] a visualMap's thumb is a highDownDispatcher of no series:
    allLeaveBlur, and it leaves emphasis; nothing else of it has states }
  if ATarget.HdKind = 7 then
  begin
    if (ATarget.HdRow in [3, 4]) and VmContinuous(ATarget.HdSeries) then
    begin
      StAllLeaveBlur;
      if ATarget.HdGen = FVmLive[ATarget.HdSeries].Gen then
        FVmLive[ATarget.HdSeries].ThumbHover[ATarget.HdRow - 3] := 0;
      if FStDirty then InvalidateFrame;
    end;
    Exit;
  end;
  { a legend item's own mouseout: the downplay action [Batch 93] }
  if ATarget.HdKind = 4 then
  begin
    LegendHighDown(ATarget, 'downplay');
    Exit;
  end;
  { [Batch 98] a selector button: allLeaveBlur, and it leaves emphasis;
    a page button has no states }
  if ATarget.HdKind = 5 then
  begin
    StAllLeaveBlur;
    LegendSelHover(-1, -1);
    if FStDirty then InvalidateFrame;
    Exit;
  end;
  if ATarget.HdKind = 6 then Exit;
  { [F2a] a breadcrumb item: allLeaveBlur, and it leaves emphasis }
  if ATarget.HdKind = 15 then
  begin
    StAllLeaveBlur;
    if (FTmCrumbHoverS = ATarget.HdSeries) and (FTmCrumbHoverK = ATarget.HdRow)
      and (FTmCrumbHoverGen = ATarget.HdGen) then
    begin
      FTmCrumbHoverS := -1;
      FTmCrumbHoverK := -1;
      FTmCrumbDirty := True;
    end;
    if FStDirty or FTmCrumbDirty then InvalidateFrame;
    Exit;
  end;
  if not StDispatcher(ATarget, item, part) then Exit;
  s := ATarget.HdSeries;
  StAllLeaveBlur;
  if part = 0 then
  begin
    poly := StPolyOf(s);
    old := item^.GroupHover;
    if TyStItemHoverLeave(item^, poly) then FStDirty := True;
    if poly >= 0 then StPolyTo(s, poly);
    if not ATarget.HdEdge then StTreeFollow(s, StInnerRaw(s, ATarget.HdRow), old);
  end
  else if (item^.Host.HighByOuter = 0) and (item^.Host.HoverState = TyStHoverEmphasis) then
  begin
    { the polyline's own change carries the area; the area is alone }
    if part = 1 then StPolyTo(s, TyStHoverNormal)
    else item^.Host.HoverState := TyStHoverNormal;
    FStDirty := True;
  end;
  if FStDirty then InvalidateFrame;
end;

{ handleGlobalMouseOverForHighDown: blurSeries by the dispatcher's focus,
  then it enters emphasis unless an action holds it }
procedure TTyAdvanceChart.StHoverOver(const ATarget: TTyChartEventTarget);
begin
  { [Batch 148] a geo region's group }
  if ATarget.HdKind = 14 then
  begin
    GeoHoverOver(ATarget);
    Exit;
  end;
  { [Batch 116] a thumb enters emphasis (no series to blur) }
  if ATarget.HdKind = 7 then
  begin
    if (ATarget.HdRow in [3, 4]) and VmContinuous(ATarget.HdSeries)
      and (ATarget.HdGen = FVmLive[ATarget.HdSeries].Gen) then
      FVmLive[ATarget.HdSeries].ThumbHover[ATarget.HdRow - 3] := 2;
    Exit;
  end;
  StHoverOverSeries(ATarget);
end;

procedure TTyAdvanceChart.StHoverOverSeries(const ATarget: TTyChartEventTarget);
var
  item: PTyStItem;
  part, s, poly, old: Integer;
  focus: TTyStFocus;
  scope: TTyStScope;
begin
  { a legend item's own mouseover: the highlight action [Batch 93] }
  if ATarget.HdKind = 4 then
  begin
    LegendHighDown(ATarget, 'highlight');
    Exit;
  end;
  { [Batch 98] a selector button enters emphasis (enableHoverEmphasis) }
  if ATarget.HdKind = 5 then
  begin
    LegendSelHover(ATarget.HdSeries, ATarget.HdRow);
    Exit;
  end;
  if ATarget.HdKind = 6 then Exit;
  { [F2a] a breadcrumb item enters emphasis (its ecData has no series: no
    blur) }
  if ATarget.HdKind = 15 then
  begin
    FTmCrumbHoverS := ATarget.HdSeries;
    FTmCrumbHoverK := ATarget.HdRow;
    FTmCrumbHoverGen := ATarget.HdGen;
    FTmCrumbDirty := True;
    InvalidateFrame;
    Exit;
  end;
  if not StDispatcher(ATarget, item, part) then Exit;
  s := ATarget.HdSeries;
  if (part = 0) and ATarget.HdEdge and (FSt[s].Kind = sskGraph) then
    focus := StEdgeFocus(s, StGraphEdgeOfRow(SlotOfSeries(s), ATarget.HdRow), scope)
  else if (part = 0) and ATarget.HdEdge then
    focus := StEdgeFocus(s, ATarget.HdRow, scope)
  else if part = 0 then
    focus := StItemFocus(s, StInnerRaw(s, ATarget.HdRow), scope)
  else
    focus := StSeriesFocus(s, scope);
  StBlurSeries(s, focus, scope);
  if part = 0 then
  begin
    poly := StPolyOf(s);
    old := item^.GroupHover;
    if TyStItemHoverEnter(item^, poly) then FStDirty := True;
    if poly >= 0 then StPolyTo(s, poly);
    if not ATarget.HdEdge then StTreeFollow(s, StInnerRaw(s, ATarget.HdRow), old);
  end
  else if item^.Host.HighByOuter = 0 then
  begin
    if part = 1 then StPolyTo(s, TyStHoverEmphasis)
    else item^.Host.HoverState := TyStHoverEmphasis;
    FStDirty := True;
  end;
  if FStDirty then InvalidateFrame;
end;

function TTyAdvanceChart.StOwnsElement(AIndex: Integer): Boolean;
var d: TTyChartDatumRef;
begin
  Result := False;
  if (FPaintList = nil) or (AIndex < 0) or (AIndex >= FPaintList.Count) then Exit;
  d := FPaintList.Element(AIndex).Datum;
  if (d.Kind <> ctkSeries) or (d.SeriesIndex < 0) or (d.SeriesIndex > High(FSt)) then Exit;
  Result := FSt[d.SeriesIndex].Kind <> sskNone;
end;

function TTyAdvanceChart.StEmphasised(AIndex: Integer): Boolean;
var d: TTyChartDatumRef; item: PTyStItem; k: Integer;
begin
  Result := False;
  if not StOwnsElement(AIndex) then Exit;
  d := FPaintList.Element(AIndex).Datum;
  if d.IsEdge then
  begin
    k := d.DataIndex;
    if FSt[d.SeriesIndex].Kind = sskGraph then
      k := StGraphEdgeOfRow(SlotOfSeries(d.SeriesIndex), k);
    Result := StHasEdges(d.SeriesIndex) and (k >= 0)
      and (k <= High(FSt[d.SeriesIndex].EdgeRows))
      and (stnEmphasis in FSt[d.SeriesIndex].EdgeRows[k].Host.States);
    Exit;
  end;
  item := StItemAt(d.SeriesIndex, d.DataIndex);
  Result := (item <> nil) and (stnEmphasis in item^.Host.States);
end;

{ ---- the selection model ---- }

function TTyAdvanceChart.SelData(ASlot: Integer): TTySelData;
var
  st: TTyDataStore;
  i, n, raw, s: Integer;
  key: string;
  has: Boolean;
begin
  Result := Default(TTySelData);
  if (ASlot < 0) or (ASlot > High(FStores)) or (FStores[ASlot] = nil) then Exit;
  st := FStores[ASlot];
  s := FBindings[ASlot].SeriesIndex;
  n := st.Count;
  SetLength(Result.Keys, n);
  SetLength(Result.Raws, n);
  SetLength(Result.Disabled, n);
  for i := 0 to n - 1 do
  begin
    raw := st.GetRawIndex(i);
    Result.Raws[i] := raw;
    { getSelectionKey: the name, else the id (SeriesData's own 'e\0\0' + raw
      for an item that has neither) }
    key := st.GetItemName(i);
    if key = '' then key := st.GetId(i);
    if key = '' then key := 'e'#0#0 + IntToStr(raw);
    Result.Keys[i] := key;
    { the item model's select.disabled: the item's, else the series' }
    Result.Disabled[i] := TyStReadBool([StItemNode(s, raw), StSeriesNode(s)],
      ['select', 'disabled'], has);
  end;
end;

procedure TTyAdvanceChart.SelEnsure(ASlot: Integer);
var
  s, i: Integer;
  tb: TJSONBoolean;
  node: TJSONObject;
  data: TTySelData;
  flags: TTyBoolArray;
  has: Boolean;
begin
  if (ASlot < 0) or (ASlot > High(FBindings)) then Exit;
  s := FBindings[ASlot].SeriesIndex;
  if s < 0 then Exit;
  if Length(FSel) <= s then
  begin
    SetLength(FSel, s + 1);
    SetLength(FSelInit, s + 1);
  end;
  if FSelInit[s] then Exit;
  if (ASlot > High(FStores)) or (FStores[ASlot] = nil) then Exit;
  node := StSeriesNode(s);
  { a map series' selectedMode is true unless written (MapSeries.
    defaultOption) [Batch 152] }
  if (node <> nil) and (node.Find('selectedMode') = nil)
    and (FBindings[ASlot].SeriesType = TyMapSeriesTypeName) then
  begin
    tb := TJSONBoolean.Create(True);
    try
      FSel[s] := TySelNew(TySelModeOf(tb));
    finally
      tb.Free;
    end;
  end
  else if node <> nil then FSel[s] := TySelNew(TySelModeOf(node.Find('selectedMode')))
  else FSel[s] := TySelNew(ssmOff);
  FSelInit[s] := True;
  { _initSelectedMapFromData: `selected: true` on a data item }
  data := SelData(ASlot);
  flags := nil;
  SetLength(flags, Length(data.Raws));
  for i := 0 to High(data.Raws) do
    flags[i] := TyStReadBool([StItemNode(s, data.Raws[i])], ['selected'], has);
  TySelInitFromData(FSel[s], data, flags);
end;

procedure TTyAdvanceChart.SelSyncFlags(ASlot: Integer);
var
  s, raw, inner, k: Integer;
  data: TTySelData;
  st: TTyDataStore;
  was: Boolean;
begin
  if (ASlot < 0) or (ASlot > High(FBindings)) then Exit;
  s := FBindings[ASlot].SeriesIndex;
  if (s < 0) or (s > High(FSt)) or (s > High(FSel)) or not FSelInit[s] then Exit;
  if (ASlot > High(FStores)) or (FStores[ASlot] = nil) then Exit;
  st := FStores[ASlot];
  data := SelData(ASlot);
  for raw := 0 to High(FSt[s].Rows) do
  begin
    if not FSt[s].Rows[raw].Host.Exists then Continue;
    inner := st.IndexOfRawIndex(raw);
    was := FSt[s].Rows[raw].Host.Selected;
    FSt[s].Rows[raw].Host.Selected := (inner >= 0)
      and TySelIsSelected(FSel[s], data, inner);
    if was <> FSt[s].Rows[raw].Host.Selected then FStDirty := True;
    { the rest of the group: enterSelect traverses it [F2a] }
    for k := 0 to High(FSt[s].Rows[raw].Parts) do
      FSt[s].Rows[raw].Parts[k].Selected := FSt[s].Rows[raw].Host.Selected;
  end;
  { a graph's edges, from the same map [F2a]; a sankey's [F3a]; a chord's
    [F3b] }
  if FSt[s].Kind in [sskGraph, sskSankey, sskChord] then
  begin
    data := SelEdgeData(ASlot);
    for raw := 0 to High(FSt[s].EdgeRows) do
    begin
      if not FSt[s].EdgeRows[raw].Host.Exists then Continue;
      if FSt[s].Kind in [sskSankey, sskChord] then inner := raw
      else inner := StGraphEdgeInner(ASlot, raw);
      was := FSt[s].EdgeRows[raw].Host.Selected;
      FSt[s].EdgeRows[raw].Host.Selected := (inner >= 0)
        and TySelIsSelected(FSel[s], data, inner);
      if was <> FSt[s].EdgeRows[raw].Host.Selected then FStDirty := True;
    end;
  end;
end;

{ makeQueryConditionKindA + findComponents: seriesIndex (a number or a
  list, in its order), else seriesId, else seriesName (in series order);
  none of them is every series }
function TTyAdvanceChart.MatchSeries(APayload: TJSONObject): TTyIntegerArray;
var
  d: TJSONData;
  i, k, n, cnt: Integer;
  want: TTyStringArray;
  byId: Boolean;
  v: string;

  procedure Add(AIndex: Integer);
  begin
    SetLength(Result, Length(Result) + 1);
    Result[High(Result)] := AIndex;
  end;

  function KeyText(AData: TJSONData; out AText: string): Boolean;
  begin
    Result := (AData <> nil) and (AData.JSONType in [jtString, jtNumber]);
    if Result then AText := AData.AsString;
  end;

begin
  Result := nil;
  cnt := FOption.ComponentCount('series');
  d := APayload.Find('seriesIndex');
  if (d <> nil) and (d.JSONType <> jtNull) then
  begin
    if d is TJSONArray then
    begin
      for k := 0 to TJSONArray(d).Count - 1 do
        if TJSONArray(d).Items[k].JSONType = jtNumber then
        begin
          n := Trunc(TJSONArray(d).Items[k].AsFloat);
          if (n >= 0) and (n < cnt) then Add(n);
        end;
    end
    else if d.JSONType = jtNumber then
    begin
      n := Trunc(d.AsFloat);
      if (n >= 0) and (n < cnt) then Add(n);
    end;
    Exit;
  end;
  byId := True;
  d := APayload.Find('seriesId');
  if (d = nil) or (d.JSONType = jtNull) then
  begin
    byId := False;
    d := APayload.Find('seriesName');
  end;
  if (d = nil) or (d.JSONType = jtNull) then
  begin
    for i := 0 to cnt - 1 do Add(i);
    Exit;
  end;
  want := nil;
  if d is TJSONArray then
  begin
    for k := 0 to TJSONArray(d).Count - 1 do
      if KeyText(TJSONArray(d).Items[k], v) then
      begin
        SetLength(want, Length(want) + 1);
        want[High(want)] := v;
      end;
  end
  else if KeyText(d, v) then
  begin
    SetLength(want, 1);
    want[0] := v;
  end;
  for i := 0 to cnt - 1 do
  begin
    if byId then v := SeriesModelId(i) else v := SeriesModelName(i);
    for k := 0 to High(want) do
      if want[k] = v then
      begin
        Add(i);
        Break;
      end;
  end;
end;

{ queryDataIndex (util/model.ts:704-726): dataIndexInside as it is, else
  dataIndex (raw) through indexOfRawIndex, else name -- the first inner index
  of that name. False when the payload names no item at all. }
function TTyAdvanceChart.QueryDataIndex(ASlot: Integer; APayload: TJSONObject;
  out AInner: TTyIntegerArray): Boolean;
var
  d: TJSONData;
  st: TTyDataStore;
  mode, k: Integer;

  function One(AItem: TJSONData): Integer;
  var i: Integer; nm: string;
  begin
    Result := -1;
    if mode = 2 then
    begin
      if not (AItem.JSONType in [jtString, jtNumber]) then Exit;
      nm := AItem.AsString;
      for i := 0 to st.Count - 1 do
        if st.GetItemName(i) = nm then Exit(i);
      Exit;
    end;
    if AItem.JSONType <> jtNumber then Exit;
    if Frac(AItem.AsFloat) <> 0 then Exit;
    i := Trunc(AItem.AsFloat);
    if mode = 0 then Result := i
    else Result := st.IndexOfRawIndex(i);
  end;

begin
  AInner := nil;
  Result := False;
  if (ASlot < 0) or (ASlot > High(FStores)) or (FStores[ASlot] = nil) then Exit;
  st := FStores[ASlot];
  mode := 0;
  d := APayload.Find('dataIndexInside');
  if (d = nil) or (d.JSONType = jtNull) then
  begin
    mode := 1;
    d := APayload.Find('dataIndex');
  end;
  if (d = nil) or (d.JSONType = jtNull) then
  begin
    mode := 2;
    d := APayload.Find('name');
  end;
  if (d = nil) or (d.JSONType = jtNull) then Exit;
  Result := True;
  if d is TJSONArray then
  begin
    SetLength(AInner, TJSONArray(d).Count);
    for k := 0 to TJSONArray(d).Count - 1 do
      AInner[k] := One(TJSONArray(d).Items[k]);
  end
  else
  begin
    SetLength(AInner, 1);
    AInner[0] := One(d);
  end;
end;

{ model/Series.ts's id: the written one, else '\0' + name + '\0' + n, n the
  first number no earlier series took (util/model.ts:500-525) }
function TTyAdvanceChart.SeriesModelId(ASeriesIndex: Integer): string;
var
  ids: TTyStringArray;
  i, k, num: Integer;
  n, d: TJSONData;
  taken: Boolean;
  cand: string;
begin
  { THE MODEL'S, which a merge keeps [Batch 95]; made afresh below only
    where there is no model }
  Result := FOption.ComponentId('series', ASeriesIndex);
  if Result <> '' then Exit;
  ids := nil;
  SetLength(ids, ASeriesIndex + 1);
  { the written ids first: they are reserved before any is generated }
  for i := 0 to FOption.ComponentCount('series') - 1 do
  begin
    n := FOption.ComponentAt('series', i);
    if not (n is TJSONObject) then Continue;
    d := TJSONObject(n).Find('id');
    if (d <> nil) and (d.JSONType in [jtString, jtNumber]) and (i <= ASeriesIndex) then
      ids[i] := d.AsString;
  end;
  for i := 0 to ASeriesIndex do
  begin
    if ids[i] <> '' then Continue;
    num := 0;
    repeat
      cand := #0 + SeriesModelName(i) + #0 + IntToStr(num);
      Inc(num);
      taken := False;
      for k := 0 to High(ids) do
        if ids[k] = cand then taken := True;
    until not taken;
    ids[i] := cand;
  end;
  Result := ids[ASeriesIndex];
end;

function TTyAdvanceChart.HasChartHandler(const AType: string): Boolean;
var i: Integer;
begin
  for i := 0 to High(FEventRegs) do
    if FEventRegs[i].EventType = AType then Exit(True);
  Result := False;
end;

{ an action's event: no params, no pointer, the object as JSON; a query
  never filters it (upstream's eventInfo is empty for these) }
procedure TTyAdvanceChart.EmitPayloadEvent(const AType, APayloadJson: string;
  AObj: TJSONObject);
var
  ev: TTyChartEvent;
  regs: array of TTyChartEventReg;
  i, saved: Integer;
begin
  { a silent dispatch publishes nothing -- and so sends nothing to its
    group [Batch 141] }
  if FEvSilent > 0 then Exit;
  { [F4b] A BATCH'S ITEMS publish nothing of their own: their events (and
    a refined action's refined ones) are the batch's }
  if FBatchCapDepth > 0 then
  begin
    if AType = FBatchCapType then
    begin
      SetLength(FBatchCapList, Length(FBatchCapList) + 1);
      FBatchCapList[High(FBatchCapList)] := APayloadJson;
      Exit;
    end;
    if (FBatchCapRefined <> '') and (AType = FBatchCapRefined) then
    begin
      SetLength(FBatchCapRef, Length(FBatchCapRef) + 1);
      FBatchCapRef[High(FBatchCapRef)] := APayloadJson;
      Exit;
    end;
  end;
  ev := Default(TTyChartEvent);
  ev.EventType := AType;
  ev.HasParams := False;
  ev.Params := TyChartBlankParams;
  ev.HasOffset := False;
  ev.Payload := APayloadJson;
  { [F4b] THE EVENT IS OUTSIDE THE CYCLE: doDispatchAction clears
    IN_EC_CYCLE before it triggers, so what a handler (or the group a
    connect sends it to) dispatches runs at once -- and flushes the
    actions this one left pending }
  saved := FActCycle;
  FActCycle := 0;
  try
    if Assigned(FOnChartEvent) then FOnChartEvent(Self, ev);
    regs := Copy(FEventRegs);
    for i := 0 to High(regs) do
      if regs[i].EventType = AType then regs[i].Handler(Self, ev);
    { THE CONNECT LISTENER, registered after the chart's own forwarders
      (_initEvents runs in the constructor, enableConnect after init): the
      chart's handlers hear the event first [Batch 141] }
    ConnectBroadcast(AType, APayloadJson, AObj);
  finally
    FActCycle := saved;
  end;
end;

function JsTruthy(AData: TJSONData): Boolean;
begin
  if (AData = nil) or (AData.JSONType = jtNull) then Exit(False);
  case AData.JSONType of
    jtBoolean: Result := AData.AsBoolean;
    jtNumber: Result := (AData.AsFloat <> 0) and not IsNan(AData.AsFloat);
    jtString: Result := AData.AsString <> '';
  else
    Result := True;
  end;
end;

procedure TTyAdvanceChart.DoSelectAction(APayload: TJSONObject);
var ev: TJSONObject;
begin
  SelApply(APayload, APayload.Strings['type']);
  { the action's own event: a copy of the payload, the type lowercased }
  ev := TJSONObject(APayload.Clone);
  try
    ev.Strings['type'] := LowerCase(APayload.Strings['type']);
    SelPublish(APayload, ev.AsJSON);
  finally
    ev.Free;
  end;
end;

procedure TTyAdvanceChart.SelApply(APayload: TJSONObject; const AType: string);
var
  t: string;
  series, inner: TTyIntegerArray;
  i, slot, s, kind, k: Integer;
  data: TTySelData;
  d: TJSONData;
begin
  { toggleSelectionFromPayload reads the ITEM's type -- a batch item keeps
    its own over the action's (defaults of a copy of the item over the
    payload) -- and
    does nothing for one that is no select type: the lowercased
    'toggleselect' a connected chart's event hands its items, say.
    [Milestone D5-D8: the action's type was read for every item.] }
  t := AType;
  d := APayload.Find('type');
  if (d <> nil) and (d.JSONType = jtString) then t := d.AsString;
  if t = 'select' then kind := 0
  else if t = 'unselect' then kind := 1
  else if t = 'toggleSelect' then kind := 2
  else Exit;
  { updateDirectly: every series the query names }
  series := MatchSeries(APayload);
  for i := 0 to High(series) do
  begin
    slot := SlotOfSeries(series[i]);
    if (slot < 0) or (slot > High(FStores)) or (FStores[slot] = nil) then Continue;
    SelEnsure(slot);
    s := series[i];
    if (s > High(FSel)) or not FSelInit[s] then Continue;
    { A GRAPH'S LINKS share the series' one map, keyed by the edge data's
      names (Series.select(dataIndex, dataType)) [F2a]; any other series'
      edge data is not this model's }
    d := APayload.Find('dataType');
    if (d <> nil) and (d.JSONType = jtString) and (d.AsString = 'edge') then
    begin
      { [F3b] and a chord's }
      if not ((s <= High(FSt)) and (FSt[s].Kind in [sskGraph, sskSankey, sskChord])) then Continue;
      if not QueryEdgeIndex(slot, APayload, inner) then Continue;
      if FSt[s].Kind = sskGraph then
        for k := 0 to High(inner) do inner[k] := StGraphEdgeInner(slot, inner[k]);
      data := SelEdgeData(slot);
    end
    else
    begin
      if not QueryDataIndex(slot, APayload, inner) then Continue;
      data := SelData(slot);
    end;
    case kind of
      0: TySelSelect(FSel[s], data, inner);
      1: TySelUnselect(FSel[s], data, inner);
    else
      TySelToggle(FSel[s], data, inner);
    end;
    SelSyncFlags(slot);
  end;
  if FStDirty then InvalidateFrame;
end;

procedure TTyAdvanceChart.SelPublish(APayload: TJSONObject; const AOwnEvent: string);
var
  t, lt, sel, selMap, nm: string;
  inner: TTyIntegerArray;
  k, slot, s, q, nd: Integer;
  dts: array[0..1] of string;
  idx: TTyIntegerArray;
  fromPayload: TJSONObject;
  d: TJSONData;
  legacy: array[0..1] of string;
  post: string;
begin
  t := APayload.Strings['type'];
  { THE EVENTS. First the action's own, a copy of the payload with the type
    lowercased (a batch's: see DoBatchAction); then selectchanged }
  lt := LowerCase(t);
  EmitPayloadEvent(lt, AOwnEvent);
  { getAllSelectedIndices: the shown series with a selection, in order }
  sel := '';
  for slot := 0 to High(FBindings) do
  begin
    if FBindings[slot].Hidden then Continue;
    s := FBindings[slot].SeriesIndex;
    if (s < 0) or (s > High(FSel)) or not FSelInit[s] then Continue;
    idx := TySelIndices(FSel[s], SelData(slot));
    if Length(idx) = 0 then Continue;
    { getAllSelectedIndices: one entry per data of getAllData -- a graph's
      node and edge data (the same indices, the map is one), a tree's and a
      treemap's 'main' [F2a] }
    { [F3a] a sankey's too: its node and edge data; [F3b] and a chord's
      (createGraphFromNodeEdge links them) }
    if (FBindings[slot].SeriesType = TyGraphSeriesTypeName)
      or (FBindings[slot].SeriesType = TySankeySeriesTypeName)
      or (FBindings[slot].SeriesType = TyChordSeriesTypeName) then
    begin
      dts[0] := 'node';
      dts[1] := 'edge';
      nd := 2;
    end
    else if (FBindings[slot].SeriesType = TyTreeSeriesTypeName)
      or (FBindings[slot].SeriesType = TyTreemapSeriesTypeName) then
    begin
      dts[0] := 'main';
      nd := 1;
    end
    else
    begin
      dts[0] := '';
      nd := 1;
    end;
    for q := 0 to nd - 1 do
    begin
      if sel <> '' then sel := sel + ',';
      sel := sel + '{"dataIndex":[';
      for k := 0 to High(idx) do
      begin
        if k > 0 then sel := sel + ',';
        sel := sel + IntToStr(idx[k]);
      end;
      sel := sel + '],"seriesIndex":' + IntToStr(s);
      if dts[q] <> '' then sel := sel + ',"dataType":"' + dts[q] + '"';
      sel := sel + '}';
    end;
  end;
  d := APayload.Find('isFromClick');
  if JsTruthy(d) then post := d.AsJSON else post := 'false';
  EmitPayloadEvent('selectchanged', '{"type":"selectchanged","selected":[' + sel
    + '],"isFromClick":' + post + ',"fromAction":' + '"' + StringToJSONString(t)
    + '","fromActionPayload":' + APayload.AsJSON + ',"escapeConnect":true}');

  { THE LEGACY EVENTS (legacy/dataSelectAction.ts), only to a handler that
    asked: a click -> map/pie selectchanged, an action select -> selected,
    unselect -> unselected; once per PIE series in the selection, the map
    variant included }
  if JsTruthy(APayload.Find('isFromClick')) then post := 'selectchanged'
  else if t = 'select' then post := 'selected'
  else if t = 'unselect' then post := 'unselected'
  else post := '';
  if post = '' then Exit;
  legacy[0] := 'map' + post;
  legacy[1] := 'pie' + post;
  for k := 0 to 1 do
  begin
    if not HasChartHandler(legacy[k]) then Continue;
    for slot := 0 to High(FBindings) do
    begin
      if FBindings[slot].SeriesType <> TyPieSeriesTypeName then Continue;
      if FBindings[slot].Hidden then Continue;
      s := FBindings[slot].SeriesIndex;
      if (s < 0) or (s > High(FSel)) or not FSelInit[s] then Continue;
      if Length(TySelIndices(FSel[s], SelData(slot))) = 0 then Continue;
      nm := '';
      fromPayload := APayload;
      if QueryDataIndex(slot, fromPayload, inner) and (Length(inner) > 0)
        and (inner[0] >= 0) and (inner[0] < FStores[slot].Count) then
        nm := FStores[slot].GetItemName(inner[0]);
      selMap := TySelMapJson(FSel[s]);
      EmitPayloadEvent(legacy[k], '{"type":"' + legacy[k] + '","seriesId":"'
        + StringToJSONString(SeriesModelId(s)) + '","name":"'
        + StringToJSONString(nm) + '","selected":' + selMap + '}');
    end;
  end;
end;

{ highlight / downplay (echarts.ts:2178-2205, 1792-1865): allLeaveBlur once;
  for a highlight without notBlur, every queried series whose emphasis is
  not disabled blurs by the focus of the element the payload names (its
  first, the first element there is when that one is missing); then each
  series' view enters / leaves emphasis on the queried items (all of them
  when none) with highlightKey's bit -- a line's one-point highlight on the
  symbol PATH, with the polyline (LineView.ts:937-1026). [Batch 90] }
procedure TTyAdvanceChart.DoHighDownAction(APayload: TJSONObject; ABatchItem: Boolean);
var
  t, key: string;
  series, inner, kept: TTyIntegerArray;
  excl: TTyStringArray;
  i, k, slot, s, digit, raw, q, poly: Integer;
  d: TJSONData;
  item: PTyStItem;
  skip, has, isArr, single, isHigh: Boolean;
  ev: TJSONObject;
  focus: TTyStFocus;
  scope: TTyStScope;
  nodes: array[0..0] of TJSONObject;

  procedure Apply(var AItem: TTyStItem; AOnPath: Boolean; ARaw: Integer);
  var old: Integer;
  begin
    poly := StPolyOf(s);
    old := AItem.GroupHover;
    if isHigh then
    begin
      if TyStItemEnterEmphasisBy(AItem, digit, AOnPath, poly) then FStDirty := True;
    end
    else if TyStItemLeaveEmphasisBy(AItem, digit, AOnPath, poly) then
      FStDirty := True;
    if poly >= 0 then StPolyTo(s, poly);
    { a tree node's edge [F2a] }
    if ARaw >= 0 then StTreeFollow(s, ARaw, old);
  end;

  { A SANKEY'S EDGE DATA [Batch 114]: `dataType: 'edge'` makes queryDataIndex
    read the links -- dataIndex as given, a number or a list }
  function EdgeQuery(ASeries: Integer; out AIdx: TTyIntegerArray): Boolean;
  var x: TJSONData; j: Integer;
  begin
    AIdx := nil;
    Result := False;
    { a chord's links too, by their raw index [Batch 120] }
    if not StHasEdges(ASeries) then Exit;
    x := APayload.Find('dataType');
    if not ((x <> nil) and (x.JSONType = jtString) and (x.AsString = 'edge')) then Exit;
    { a graph's: queryDataIndex on its edge data [F2a] }
    if FSt[ASeries].Kind = sskGraph then
    begin
      QueryEdgeIndex(SlotOfSeries(ASeries), APayload, AIdx);
      Exit(True);
    end;
    Result := True;
    x := APayload.Find('dataIndex');
    if x is TJSONArray then
    begin
      for j := 0 to x.Count - 1 do
        if (x.Items[j].JSONType = jtNumber) and (Frac(x.Items[j].AsFloat) = 0) then
        begin
          SetLength(AIdx, Length(AIdx) + 1);
          AIdx[High(AIdx)] := Trunc(x.Items[j].AsFloat);
        end;
    end
    else if (x <> nil) and (x.JSONType = jtNumber) and (Frac(x.AsFloat) = 0) then
    begin
      SetLength(AIdx, 1);
      AIdx[0] := Trunc(x.AsFloat);
    end;
  end;

  { which field queryDataIndex reads, and whether it is a list }
  function QueryIsArray: Boolean;
  var x: TJSONData;
  begin
    x := APayload.Find('dataIndexInside');
    if (x = nil) or (x.JSONType = jtNull) then x := APayload.Find('dataIndex');
    if (x = nil) or (x.JSONType = jtNull) then x := APayload.Find('name');
    Result := x is TJSONArray;
  end;

begin
  t := APayload.Strings['type'];
  isHigh := t = 'highlight';
  { getHighlightDigit: in order of first use, 1 to 32, then bit 0 }
  digit := 0;
  d := APayload.Find('highlightKey');
  if (d <> nil) and (d.JSONType in [jtString, jtNumber]) then
  begin
    key := d.AsString;
    digit := -1;
    for i := 0 to High(FHighlightKeys) do
      if FHighlightKeys[i] = key then digit := i + 1;
    if (digit < 0) and (Length(FHighlightKeys) < 32) then
    begin
      SetLength(FHighlightKeys, Length(FHighlightKeys) + 1);
      FHighlightKeys[High(FHighlightKeys)] := key;
      digit := Length(FHighlightKeys);
    end;
    if digit < 0 then digit := 0;
  end;
  excl := nil;
  d := APayload.Find('excludeSeriesId');
  if d is TJSONArray then
  begin
    for k := 0 to TJSONArray(d).Count - 1 do
      if TJSONArray(d).Items[k].JSONType in [jtString, jtNumber] then
      begin
        SetLength(excl, Length(excl) + 1);
        excl[High(excl)] := TJSONArray(d).Items[k].AsString;
      end;
  end
  else if (d <> nil) and (d.JSONType in [jtString, jtNumber]) then
  begin
    SetLength(excl, 1);
    excl[0] := d.AsString;
  end;

  { ONCE PER DISPATCH, before anything: every blur goes -- a batch did it
    already, once for all its items [Batch 116] }
  if not ABatchItem then StAllLeaveBlur;

  series := MatchSeries(APayload);
  kept := nil;
  for i := 0 to High(series) do
  begin
    s := series[i];
    skip := False;
    for k := 0 to High(excl) do
      if excl[k] = SeriesModelId(s) then skip := True;
    if skip then Continue;
    if (s > High(FSt)) or (FSt[s].Kind = sskNone) then Continue;
    SetLength(kept, Length(kept) + 1);
    kept[High(kept)] := s;
  end;

  { THE BLUR, a pass of its own before any series highlights }
  if isHigh and not JsTruthy(APayload.Find('notBlur')) then
    for i := 0 to High(kept) do
    begin
      s := kept[i];
      nodes[0] := StSeriesNode(s);
      if TyStReadBool(nodes, ['emphasis', 'disabled'], has) then Continue;
      slot := SlotOfSeries(s);
      { a sankey's links: the first named link's focus [Batch 114] }
      if EdgeQuery(s, inner) then
      begin
        q := 0;
        if Length(inner) > 0 then q := inner[0];
        if (q >= 0) and (q <= High(FSt[s].EdgeRows)) and FSt[s].EdgeRows[q].Host.Exists then
          focus := StEdgeFocus(s, q, scope)
        else
        begin
          if TyStFind(nodes, ['emphasis', 'focus']) = nil then Continue;
          focus := StSeriesFocus(s, scope);
        end;
        StBlurSeries(s, focus, scope);
        Continue;
      end;
      { the first index of a list; || 0 }
      q := 0;
      if QueryDataIndex(slot, APayload, inner) and (Length(inner) > 0) then q := inner[0];
      item := StItemAt(s, q);
      if item = nil then
      begin
        q := 0;
        while (item = nil) and (slot >= 0) and (slot <= High(FStores))
          and (FStores[slot] <> nil) and (q < FStores[slot].Count) do
        begin
          item := StItemAt(s, q);
          if item = nil then Inc(q);
        end;
      end;
      if item <> nil then
        focus := StItemFocus(s, StInnerRaw(s, q), scope)
      else
      begin
        { no element at all: the series' own option, only when written }
        if TyStFind(nodes, ['emphasis', 'focus']) = nil then Continue;
        focus := StSeriesFocus(s, scope);
      end;
      StBlurSeries(s, focus, scope);
    end;

  { THE EMPHASIS }
  for i := 0 to High(kept) do
  begin
    s := kept[i];
    slot := SlotOfSeries(s);
    { a sankey's links by their own indices [Batch 114] }
    if EdgeQuery(s, inner) then
    begin
      for k := 0 to High(inner) do
        if (inner[k] >= 0) and (inner[k] <= High(FSt[s].EdgeRows))
          and TyStItemDispatches(FSt[s].EdgeRows[inner[k]]) then
          Apply(FSt[s].EdgeRows[inner[k]], False, -1);
      Continue;
    end;
    has := QueryDataIndex(slot, APayload, inner);
    isArr := QueryIsArray;
    if FSt[s].IsLine then
    begin
      { _changePolyState first, whatever the payload names }
      if isHigh then StPolyTo(s, TyStHoverEmphasis) else StPolyTo(s, TyStHoverNormal);
      { one index (`dataIndex >= 0`: a list of one coerces on the downplay
        side only) -> Symbol.highlight / downplay: the path, bit 0 }
      if has and (Length(inner) > 0) then
      begin
        if isHigh then single := not isArr and (inner[0] >= 0)
        else single := (not isArr or (Length(inner) = 1)) and (inner[0] >= 0);
      end
      else
        single := False;
      if single then
      begin
        item := StItemAt(s, inner[0]);
        if item <> nil then
        begin
          if isHigh then
          begin
            if TyStItemEnterEmphasisBy(item^, 0, True, poly) then FStDirty := True;
          end
          else if TyStItemLeaveEmphasisBy(item^, 0, True, poly) then
            FStDirty := True;
        end;
        Continue;
      end;
    end;
    if not has then
    begin
      for raw := 0 to High(FSt[s].Rows) do
        { only a highDownDispatcher: emphasis not disabled }
        if TyStItemDispatches(FSt[s].Rows[raw]) then
          Apply(FSt[s].Rows[raw], False, raw);
    end
    else
      for k := 0 to High(inner) do
      begin
        item := StItemAt(s, inner[k]);
        if (item <> nil) and TyStItemDispatches(item^) then
          Apply(item^, False, StInnerRaw(s, inner[k]));
      end;
  end;
  if FStDirty then InvalidateFrame;
  if ABatchItem then Exit;
  ev := TJSONObject(APayload.Clone);
  try
    ev.Strings['type'] := t;
    EmitPayloadEvent(t, ev.AsJSON);
  finally
    ev.Free;
  end;
end;

{ A NUL SURVIVES THE PARSE [Batch 93]. fpjson decodes `\u0000` to nothing
  (its scanner parks a zero code unit as half a surrogate pair), and
  upstream's generated ids are '\0' + name + '\0' + n -- so the ids a legend
  hover puts in excludeSeriesId came back as 'H0' and matched no series. The
  escape is swapped for a noncharacter (U+FDD0) before the parse and back to
  #0 in every string after it. }
function NulSafeJson(const AText: string): string;
var i, n: Integer;
begin
  Result := '';
  i := 1;
  n := Length(AText);
  while i <= n do
  begin
    if AText[i] = '\' then
    begin
      if (i + 5 <= n) and (Copy(AText, i, 6) = '\u0000') then
      begin
        Result := Result + '\ufdd0';
        Inc(i, 6);
        Continue;
      end;
      { any other escape pair passes whole, so `\\u0000` stays a backslash }
      Result := Result + Copy(AText, i, 2);
      Inc(i, 2);
      Continue;
    end;
    Result := Result + AText[i];
    Inc(i);
  end;
end;

procedure NulRestore(AData: TJSONData);
var i: Integer;
begin
  if AData = nil then Exit;
  case AData.JSONType of
    jtString:
      if Pos(#$EF#$B7#$90, AData.AsString) > 0 then
        AData.AsString := StringReplace(AData.AsString, #$EF#$B7#$90, #0, [rfReplaceAll]);
    jtArray, jtObject:
      for i := 0 to AData.Count - 1 do NulRestore(AData.Items[i]);
  end;
end;

const
  { a continuous view's parts }
  cVmOut = 1;
  cVmIn = 2;
  cVmThumb0 = 3;
  cVmLabel0 = 5;
  cVmText0 = 7;
  { a piecewise one's: 100 + 2 * piece (+ 1 its label), 1000 + j an ends text }
  cVmPiece = 100;
  cVmEnds = 1000;
  { '≈ ' }
  cVmAbout = #$E2#$89#$88' ';

{ JSON.stringify of a parsed value: numbers as JavaScript prints them (a
  not-a-number or an infinity is null), an object's keys in JavaScript's
  order -- integer-like first, ascending, then the rest as inserted }
function VmJsJson(AData: TJSONData): string;
var
  i: Integer;
  keys: TTyLegendNames;
  v: Double;
begin
  if AData = nil then Exit('null');
  case AData.JSONType of
    jtNumber:
      begin
        v := AData.AsFloat;
        if IsNan(v) or IsInfinite(v) then Result := 'null'
        else Result := TyJsNumberToString(v);
      end;
    jtString: Result := '"' + StringToJSONString(AData.AsString) + '"';
    jtBoolean: if AData.AsBoolean then Result := 'true' else Result := 'false';
    jtArray:
      begin
        Result := '[';
        for i := 0 to AData.Count - 1 do
        begin
          if i > 0 then Result := Result + ',';
          Result := Result + VmJsJson(AData.Items[i]);
        end;
        Result := Result + ']';
      end;
    jtObject:
      begin
        keys := TyJsKeyOrder(TJSONObject(AData));
        Result := '{';
        for i := 0 to High(keys) do
        begin
          if i > 0 then Result := Result + ',';
          Result := Result + '"' + StringToJSONString(keys[i]) + '":'
            + VmJsJson(TJSONObject(AData).Find(keys[i]));
        end;
        Result := Result + '}';
      end;
  else
    Result := 'null';
  end;
end;

{ ==================== the jitter [Batch 110] ==================== }

{ jitterLayout's gate: a scatter on a cartesian whose base axis is a
  category one with `jitter > 0` -- `jitterOverlap` true unless written
  falsy, `jitterMargin` 2 unless written (`|| 0` after that) }
procedure TTyAdvanceChart.JitterFor(ASlot, APPI: Integer; var AVisual: TTySeriesVisual);
var
  base: TTyAxis;
  node: TJSONData;
  d: TJSONData;
  jit, margin, scale, band: Double;
  overlap, single, singleY: Boolean;
  s: TTySingle;

  function NumOf(AData: TJSONData): Double;
  begin
    case AData.JSONType of
      jtNumber: Result := AData.AsFloat;
      jtString: Result := TyJsToNumber(AData.AsString);
      jtBoolean: if AData.AsBoolean then Result := 1 else Result := 0;
    else
      Result := NaN;
    end;
  end;

begin
  AVisual.Jitter := nil;
  AVisual.JitterOnX := False;
  if (ASlot < 0) or (ASlot > High(FBindings)) or (FJitter = nil) then Exit;
  if FBindings[ASlot].SeriesType <> 'scatter' then Exit;
  { ON A SINGLE AXIS any type of axis jitters (needFixJitter's
    COORD_SYS_TYPE_SINGLE) [Batch 118] }
  single := FBindings[ASlot].Single <> nil;
  if single then
    base := FBindings[ASlot].BaseAxis
  else
  begin
    if (FBindings[ASlot].Cart = nil) or (FBindings[ASlot].CalendarIndex >= 0) then Exit;
    base := FBindings[ASlot].Cart.GetBaseAxis;
    if (base = nil) or (base.AxisType <> atCategory) then Exit;
  end;
  if base = nil then Exit;
  node := FOption.ComponentAt(base.MainType, base.ComponentIndex);
  if not (node is TJSONObject) then Exit;
  jit := 0;
  d := TJSONObject(node).Find('jitter');
  if (d <> nil) and (d.JSONType <> jtNull) then jit := NumOf(d);
  if IsNan(jit) or not (jit > 0) then Exit;
  overlap := True;
  d := TJSONObject(node).Find('jitterOverlap');
  if (d <> nil) and (d.JSONType <> jtNull) then overlap := TyJsTruthy(d);
  margin := 2;
  d := TJSONObject(node).Find('jitterMargin');
  if (d <> nil) and (d.JSONType <> jtNull) then
  begin
    margin := NumOf(d);
    if IsNan(margin) then margin := 0;
  end;
  if APPI > 0 then scale := APPI / 96 else scale := 1;
  if single then
  begin
    { a band only on a category axis: elsewhere nothing clamps (an
      infinite band is none) }
    if base.AxisType = atCategory then band := base.BandWidth
    else band := Infinity;
    AVisual.Jitter := FJitter.AxisFor(base.Uid, jit * scale, margin * scale,
      overlap, band);
    { isSingleY: a horizontal non-category axis or a vertical category one
      floats y }
    s := TTySingle(FBindings[ASlot].Single);
    singleY := (s.OrientHorizontal and (base.AxisType <> atCategory))
      or ((s.Orient = 'vertical') and (base.AxisType = atCategory));
    AVisual.JitterOnX := not singleY;
    Exit;
  end;
  AVisual.Jitter := FJitter.AxisFor(base.Uid, jit * scale, margin * scale,
    overlap, base.BandWidth);
  AVisual.JitterOnX := base.Horizontal;
end;

{ ==================== the coordinate conversions [Batch 110] ==================== }

procedure TTyAdvanceChart.ConvertReady;
var m: ITyTextMeasurer;
begin
  { upstream's setOption lays the chart out before it returns: a layout
    the option has made stale is made again here, as a roam does }
  if FDirty and (FLastPPI > 0) then
  begin
    m := NewTextMeasurer(FLastPPI);
    Relayout(nil, FLastRect, FLastPPI, m);
    DropStatic;
    LazyUpdateDone;
    FZrDirty := True;
    inherited Invalidate;
  end;
end;

{ Grid.convertToPixel / convertFromPixel: _findConvertTarget -- the
  series' own cartesian when a series is named (and only if it is this
  grid's), else the cartesian of the x and y axes named, else the one axis
  named, else -- lowest -- the grid's first cartesian when the grid named is
  this one }
function TTyAdvanceChart.ConvertOnGrid(AGrid: TTyGridBuild; const AF: TTyParsedFinder;
  AValue: TJSONData; AFrom: Boolean): TTyConvertResult;
var
  s, xm, ym, gm, slot, k: Integer;
  cart, own: TTyCartesian2D;
  axis: TTyAxis;
begin
  Result := TyConvertNone;
  cart := nil;
  axis := nil;
  s := TyFinderModel(AF, 'series');
  xm := TyFinderModel(AF, 'xAxis');
  ym := TyFinderModel(AF, 'yAxis');
  gm := TyFinderModel(AF, 'grid');
  if s >= 0 then
  begin
    slot := SlotOfSeries(s);
    if slot >= 0 then
    begin
      own := FBindings[slot].Cart;
      if own <> nil then
        for k := 0 to AGrid.CartesianCount - 1 do
          if AGrid.CartesianByIndex(k) = own then
          begin
            cart := own;
            Break;
          end;
    end;
  end
  else if (xm >= 0) and (ym >= 0) then
    cart := AGrid.CartesianAt(xm, ym)
  else if xm >= 0 then
  begin
    if AGrid.CartesianCount > 0 then
      for k := 0 to AGrid.XAxisCount - 1 do
        if AGrid.XAxis(k).ComponentIndex = xm then axis := AGrid.XAxis(k);
  end
  else if ym >= 0 then
  begin
    if AGrid.CartesianCount > 0 then
      for k := 0 to AGrid.YAxisCount - 1 do
        if AGrid.YAxis(k).ComponentIndex = ym then axis := AGrid.YAxis(k);
  end
  else if (gm >= 0) and (gm = AGrid.ComponentIndex) and (AGrid.CartesianCount > 0) then
    cart := AGrid.CartesianByIndex(0);
  if cart <> nil then
  begin
    if AFrom then Result := TyCartesianFromPixel(cart, AValue)
    else Result := TyCartesianToPixel(cart, AValue);
  end
  else if axis <> nil then
  begin
    if AFrom then Result := TyAxisFromPixel(axis, AValue)
    else Result := TyAxisToPixel(axis, AValue);
  end;
end;

procedure ConvertUnmask(const AMask: TFPUExceptionMask);
begin
  ClearExceptions(False);
  {$IFDEF CPUX86_64}
  { the SSE flags too, which ClearExceptions leaves standing on this CPU }
  SetMXCSR(GetMXCSR and not LongWord($3F));
  {$ENDIF}
  SetExceptionMask(AMask);
end;

{ Calendar.convertToPixel: dataToPoint of the value (its first element when
  it is an array), clamped to the range; convertFromPixel: the time of the
  day under the point, nothing off the range }
{ Geo.convertToPixel / convertFromPixel: dataToPoint of a region's name or
  a [lng, lat] pair, pointToData of a pixel; upstream's undefined (a name no
  region has, a projection's null point) answers nothing [Batch 146] }
function TTyAdvanceChart.ConvertOnGeo(AGeo: TTyGeo; AValue: TJSONData;
  AFrom: Boolean): TTyConvertResult;
var
  p: TTyPointF;
  q: TTyGeoPt;
begin
  Result := TyConvertNone;
  if AFrom then
  begin
    if TyJsonNullish(AValue) then Exit;
    if AGeo.FromPixelJson(AValue, q) then Result := TyConvertXY(q.X, q.Y);
    Exit;
  end;
  if AGeo.ToPixelJson(AValue, p) then Result := TyConvertXY(p.X, p.Y);
end;

function TTyAdvanceChart.ConvertOnCalendar(ACal: TTyCalendar; AValue: TJSONData;
  AFrom: Boolean): TTyConvertResult;
var
  v, own: TJSONData;
  dv: TTyDataValue;
  p: TTyPointF;
  d: TTyDoubleArray;
  mask: TFPUExceptionMask;
begin
  Result := TyConvertNone;
  own := nil;
  mask := SetExceptionMask([exInvalidOp, exDenormalized, exZeroDivide,
    exOverflow, exUnderflow, exPrecision]);
  try
    if AFrom then
    begin
      p := TyJsonPoint(AValue);
      if ACal.PointToData(p, d) and (Length(d) > 0) then
        Result := TyConvertNum(d[0]);
      Exit;
    end;
    v := AValue;
    if TyJsonIsArray(AValue) then v := TyJsonElement(AValue, 0, own);
    { getDateInfo's parseDate: a string through TIME_REG, nothing for null
      and undefined, anything else new Date(Math.round(v)) }
    dv := Default(TTyDataValue);
    dv.Kind := dvkNone;
    if not TyJsonNullish(v) then
    begin
      if v.JSONType = jtString then dv := TyDataText(v.AsString)
      else dv := TyDataNum(TyJsonToNumber(v));
    end;
    p := ACal.DatePoint(ACal.ParseDate(dv), True);
    Result := TyConvertXY(p.X, p.Y);
  finally
    own.Free;
    ConvertUnmask(mask);
  end;
end;

{ View.convertToPixel / convertFromPixel: the overall matrix -- whose zero
  terms carry a not-a-number or an infinity across, as zrender's
  applyTransform does -- or its inverse }
function TTyAdvanceChart.ConvertOnView(AView: TTyGraphView; AValue: TJSONData;
  AFrom: Boolean): TTyConvertResult;
var
  pt, p: TTyPointF;
  d: TTyDoubleArray;
  mask: TFPUExceptionMask;
begin
  Result := TyConvertNone;
  pt := TyJsonPoint(AValue);
  mask := SetExceptionMask([exInvalidOp, exDenormalized, exZeroDivide,
    exOverflow, exUnderflow, exPrecision]);
  try
    if not AFrom then
    begin
      p := AView.DataToPoint([pt.X, pt.Y]);
      Exit(TyConvertXY(p.X, p.Y));
    end;
    { no inverse: vectorCopy }
    if not AView.PointToData(pt, d) or (Length(d) < 2) then
      Exit(TyConvertXY(pt.X, pt.Y));
    if IsNan(pt.Y) or IsInfinite(pt.Y) then d[0] := NaN;
    if IsNan(pt.X) or IsInfinite(pt.X) then d[1] := NaN;
    Result := TyConvertXY(d[0], d[1]);
  finally
    ConvertUnmask(mask);
  end;
end;

{ doConvertPixel: every coordinate system in the manager's order -- the
  grids, the radars (which answer nothing), the graphs' views, then the
  parallels (which have no convertToPixel / convertFromPixel at all
  [Batch 128]), the polars and (were it here) singleAxis, then the
  calendars -- and the first answer that is not null/undefined }
function TTyAdvanceChart.ConvertDispatch(AFinder, AValue: TJSONData;
  AFrom: Boolean; AOpt: TJSONData): TTyConvertResult;
var
  pf: TTyParsedFinder;
  g, slot, s, c, target: Integer;
begin
  Result := TyConvertNone;
  ConvertReady;
  if (FBuild = nil) or (FOption = nil) then Exit;
  pf := TyParseFinder(AFinder, FOption.Keys);
  try
    for g := 0 to FBuild.GridCount - 1 do
    begin
      Result := ConvertOnGrid(FBuild.Grid(g), pf, AValue, AFrom);
      if Result.Kind <> cvkNone then Exit;
    end;
    { THE GEOS [Batch 146], registered before the graph's view: the geo the
      finder names -- [Batch 152] or the geo the series it names is on
      (Geo's getCoordSys: geoModel, else seriesModel.coordinateSystem) }
    target := TyFinderModel(pf, 'geo');
    if (target >= 0) and (target <= High(FGeos)) and (FGeos[target] <> nil) then
    begin
      Result := ConvertOnGeo(FGeos[target], AValue, AFrom);
      if Result.Kind <> cvkNone then Exit;
    end
    else if target < 0 then
    begin
      slot := SlotOfSeries(TyFinderModel(pf, 'series'));
      if (slot >= 0) and (GeoOfSlot(slot) <> nil) then
      begin
        Result := ConvertOnGeo(GeoOfSlot(slot), AValue, AFrom);
        if Result.Kind <> cvkNone then Exit;
      end
      else if (slot >= 0) and (MapGeoOfSlot(slot) <> nil) and MapGeoOfSlot(slot).Valid then
      begin
        Result := ConvertOnGeo(MapGeoOfSlot(slot), AValue, AFrom);
        if Result.Kind <> cvkNone then Exit;
      end;
    end;
    { the graphs' views: one per graph series laid out on 'view', in series
      order; each answers only for its own series }
    s := TyFinderModel(pf, 'series');
    for slot := 0 to High(FGraphs) do
      if (FGraphs[slot] <> nil) and (slot <= High(FBindings))
        and (FBindings[slot].SeriesIndex = s) then
      begin
        Result := ConvertOnView(FGraphs[slot], AValue, AFrom);
        if Result.Kind <> cvkNone then Exit;
      end;
    { THE POLARS [Batch 111]: getCoordSys -- the polar named, else the
      series' own [Batch 113: a series on a polar] }
    for c := 0 to High(FPolars) do
    begin
      if FPolars[c] = nil then Continue;
      target := TyFinderModel(pf, 'polar');
      if (target < 0) and (s >= 0) then
      begin
        slot := SlotOfSeries(s);
        if (slot >= 0) and (FBindings[slot].Polar <> nil) then
          target := FBindings[slot].PolarIndex;
      end;
      if target <> c then Continue;
      Result := ConvertOnPolar(FPolars[c], AValue, AFrom);
      if Result.Kind <> cvkNone then Exit;
    end;
    { THE SINGLE AXES [Batch 118]: getCoordSys -- the single named, else
      the series' own }
    for c := 0 to High(FSingles) do
    begin
      if FSingles[c] = nil then Continue;
      target := TyFinderModel(pf, TySingleCoordSysName);
      if (target < 0) and (s >= 0) then
      begin
        slot := SlotOfSeries(s);
        if (slot >= 0) and (FBindings[slot].Single <> nil) then
          target := FBindings[slot].SingleIndex;
      end;
      if target <> c then Continue;
      Result := ConvertOnSingle(FSingles[c], AValue, AFrom);
      if Result.Kind <> cvkNone then Exit;
    end;
    { THE PARALLELS answer nothing: Parallel has no convertToPixel or
      convertFromPixel [Batch 128] }
    for c := 0 to High(FCalendars) do
    begin
      if FCalendars[c] = nil then Continue;
      { getCoordSys: the calendar named, else the series' own }
      target := TyFinderModel(pf, 'calendar');
      if (target < 0) and (s >= 0) then
      begin
        slot := SlotOfSeries(s);
        if slot >= 0 then target := FBindings[slot].CalendarIndex;
      end;
      if target <> c then Continue;
      Result := ConvertOnCalendar(FCalendars[c], AValue, AFrom);
      if Result.Kind <> cvkNone then Exit;
    end;
    { THE MATRICES, last (registered after the calendar, both non-series
      box creators) [Batch 147] }
    target := FinderMatrix(pf);
    if (target >= 0) and (target <= High(FMatrices)) and (FMatrices[target] <> nil) then
    begin
      Result := ConvertOnMatrix(FMatrices[target], AValue, AOpt, AFrom);
      if Result.Kind <> cvkNone then Exit;
    end;
  except
    on ETyConvertNull do
    begin
      Result.Kind := cvkError;
      Result.Values := nil;
    end;
  end;
end;

{ containPixel for a series: its coordinate system's containPoint -- a
  cartesian's area, a graph's, tree's or sankey's view; a calendar's and a
  radar's are always false -- or, with none, its view's: a pie's ring of
  its first item }
{ Polar.convertToPixel / convertFromPixel: dataToPoint of [radius, angle],
  or pointToData of a pixel [Batch 111] }
function TTyAdvanceChart.ConvertOnPolar(APolar: TTyPolar; AValue: TJSONData;
  AFrom: Boolean): TTyConvertResult;
begin
  if AFrom then Result := TyPolarFromPixel(APolar, AValue)
  else Result := TyPolarToPixel(APolar, AValue);
end;

function TTyAdvanceChart.ContainSeries(ASeriesIndex: Integer; APoint: TJSONData): Boolean;
var
  slot, k: Integer;
  b: TTySeriesBinding;
  pt: TTyPointF;
  bx: TTyXYWH;
  dx, dy, r: Double;
begin
  Result := False;
  slot := SlotOfSeries(ASeriesIndex);
  if slot < 0 then Exit;
  b := FBindings[slot];
  if b.Cart <> nil then Exit(TyCartesianContainJson(b.Cart, APoint));
  { a polar's containPoint [Batch 113] }
  if b.Polar <> nil then Exit(TyPolarContainJson(TTyPolar(b.Polar), APoint));
  { a single axis' [Batch 118] }
  if b.Single <> nil then Exit(TySingleContainJson(TTySingle(b.Single), APoint));
  { a parallel's containPoint [Batch 128] }
  if b.Parallel is TTyParallel then
    Exit(TyParallelContainJson(TTyParallel(b.Parallel), APoint));
  { A SERIES ON A MATRIX per item: the matrix's containPoint, its rect
    edges included; a pie or a funnel laid out in a cell has no coordinate
    system and its view answers [Batch 147] }
  if (b.MatrixIndex >= 0) and not b.MatrixBox then
  begin
    if (b.MatrixIndex <= High(FMatrices)) and (FMatrices[b.MatrixIndex] <> nil) then
      Exit(FMatrices[b.MatrixIndex].ContainPoint(TyJsonPoint(APoint)));
    Exit;
  end;
  if (b.CalendarIndex >= 0) or (b.RadarIndex >= 0) then Exit;
  pt := TyJsonPoint(APoint);
  if IsNan(pt.X) or IsNan(pt.Y) then Exit;
  if (b.SeriesType = TyGraphSeriesTypeName) and (slot <= High(FGraphs))
    and (FGraphs[slot] <> nil) then
    Exit(FGraphs[slot].ContainPoint(pt));
  if (b.SeriesType = TyTreeSeriesTypeName) and (slot <= High(FTreeViews))
    and (FTreeViews[slot] <> nil) then
    Exit(FTreeViews[slot].ContainPoint(pt));
  { a sankey's View: its box through the roam's overall transform [Batch 114:
    the box itself before -- there was no sankey roam] }
  if (b.SeriesType = TySankeySeriesTypeName) and (slot <= High(FSankeyViews))
    and (FSankeyViews[slot] <> nil) then
    Exit(FSankeyViews[slot].ContainPoint(pt));
  if (b.SeriesType = TySankeySeriesTypeName) and (slot <= High(FSankeys))
    and FSankeys[slot].Valid then
  begin
    bx := FSankeys[slot].Box;
    Exit((pt.X >= bx.X) and (pt.X <= bx.X + bx.W) and (pt.Y >= bx.Y)
      and (pt.Y <= bx.Y + bx.H));
  end;
  { A SUNBURST: the virtual root's layout, set by a drill and kept after
    it -- none before the first [Batch 115: never before] }
  if b.SeriesType = TySunburstSeriesTypeName then
  begin
    if (ASeriesIndex > High(FSunVirt)) or not FSunVirt[ASeriesIndex].Has then Exit;
    dx := pt.X - FSunVirt[ASeriesIndex].CX;
    dy := pt.Y - FSunVirt[ASeriesIndex].CY;
    r := Sqrt(dx * dx + dy * dy);
    Exit((r <= FSunVirt[ASeriesIndex].R) and (r >= FSunVirt[ASeriesIndex].R0));
  end;
  if (b.SeriesType = TyPieSeriesTypeName) and (slot <= High(FPies))
    and FPies[slot].Valid then
    for k := 0 to High(FPies[slot].Sectors) do
      if FPies[slot].Sectors[k].Index = 0 then
      begin
        { PieView.containPoint: the first item's layout, r0 <= d <= r }
        dx := pt.X - FPies[slot].Sectors[k].CX;
        dy := pt.Y - FPies[slot].Sectors[k].CY;
        if IsNan(dx) or IsNan(dy) then Exit;
        r := Sqrt(dx * dx + dy * dy);
        Exit((r <= FPies[slot].Sectors[k].R1) and (r >= FPies[slot].Sectors[k].R0));
      end;
end;

function TTyAdvanceChart.ContainPixelData(AFinder, APoint: TJSONData): Boolean;
var
  pf: TTyParsedFinder;
  t, k, g: Integer;
  mt: string;
  gb: TTyGridBuild;
begin
  Result := False;
  ConvertReady;
  if (FBuild = nil) or (FOption = nil) then Exit;
  pf := TyParseFinder(AFinder, FOption.Keys);
  try
    for t := 0 to High(pf.Types) do
    begin
      mt := pf.Types[t].MainType;
      for k := 0 to High(pf.Types[t].Models) do
      begin
        if mt = 'series' then
        begin
          if ContainSeries(pf.Types[t].Models[k], APoint) then Exit(True);
        end
        else if mt = 'grid' then
        begin
          { Grid.containPoint: its first cartesian's }
          for g := 0 to FBuild.GridCount - 1 do
          begin
            gb := FBuild.Grid(g);
            if (gb.ComponentIndex = pf.Types[t].Models[k]) and (gb.CartesianCount > 0)
              and TyCartesianContainJson(gb.CartesianByIndex(0), APoint) then
              Exit(True);
          end;
        end
        { Polar.containPoint: the radius and the angle each in their
          extent [Batch 111] }
        else if mt = 'polar' then
        begin
          g := pf.Types[t].Models[k];
          if (g >= 0) and (g <= High(FPolars)) and (FPolars[g] <> nil)
            and TyPolarContainJson(FPolars[g], APoint) then
            Exit(True);
        end
        { Single.containPoint [Batch 118] }
        else if mt = TySingleCoordSysName then
        begin
          g := pf.Types[t].Models[k];
          if (g >= 0) and (g <= High(FSingles)) and (FSingles[g] <> nil)
            and TySingleContainJson(FSingles[g], APoint) then
            Exit(True);
        end
        { Parallel.containPoint, asked by the parallel and by each of its
          axes (the axis model carries its coordinate system) [Batch 128] }
        else if mt = 'parallel' then
        begin
          g := pf.Types[t].Models[k];
          if (g >= 0) and (g <= High(FParallels)) and (FParallels[g] <> nil)
            and TyParallelContainJson(FParallels[g], APoint) then
            Exit(True);
        end
        else if mt = 'parallelAxis' then
        begin
          g := ParallelOfAxis(pf.Types[t].Models[k]);
          if (g >= 0) and TyParallelContainJson(FParallels[g], APoint) then
            Exit(True);
        end
        { Matrix.containPoint: its rect, edges included [Batch 147] }
        else if mt = TyMatrixCoordSysName then
        begin
          g := pf.Types[t].Models[k];
          if (g >= 0) and (g <= High(FMatrices)) and (FMatrices[g] <> nil)
            and FMatrices[g].ContainPoint(TyJsonPoint(APoint)) then
            Exit(True);
        end
        { Geo.containPoint: the data rect through the overall matrix
          [Batch 146] }
        else if mt = 'geo' then
        begin
          g := pf.Types[t].Models[k];
          if (g >= 0) and (g <= High(FGeos)) and (FGeos[g] <> nil)
            and FGeos[g].ContainPoint(TyJsonPoint(APoint)) then
            Exit(True);
        end;
        { a calendar's and a radar's containPoint are not implemented
          upstream (false); an axis has no coordinate system }
      end;
    end;
  except
    { upstream throws where it indexes a null point }
    on ETyConvertNull do Result := False;
  end;
end;

function TTyAdvanceChart.ConvertToPixelData(AFinder, AValue: TJSONData;
  AOpt: TJSONData): TTyConvertResult;
begin
  Result := ConvertDispatch(AFinder, AValue, False, AOpt);
