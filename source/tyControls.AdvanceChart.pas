{ ---- the markers' own tooltip [Batch 100] ---- }

function TTyAdvanceChart.MarkerItemOf(const ADatum: TTyChartDatumRef;
  out AKind: TTyMarkerKind; out ABlock: TTyMkBlock; out AItem: Integer): Boolean;
var k, q: Integer;
begin
  Result := False;
  AItem := -1;
  ABlock := Default(TTyMkBlock);
  case ADatum.Kind of
    ctkMarkPoint: AKind := mkPoint;
    ctkMarkLine: AKind := mkLine;
    ctkMarkArea: AKind := mkArea;
  else
    AKind := mkPoint;
    Exit;
  end;
  for k := 0 to High(FMarkers) do
    if FMarkers[k].SeriesIndex = ADatum.ComponentIndex then
    begin
      ABlock := FMarkers[k].Blocks[AKind];
      case AKind of
        mkPoint:
          for q := 0 to High(ABlock.Points) do
            if ABlock.Points[q].DataIndex = ADatum.DataIndex then
            begin
              AItem := q;
              Exit(True);
            end;
        mkLine:
          for q := 0 to High(ABlock.Lines) do
            if ABlock.Lines[q].DataIndex = ADatum.DataIndex then
            begin
              AItem := q;
              Exit(True);
            end;
        mkArea:
          for q := 0 to High(ABlock.Areas) do
            if ABlock.Areas[q].DataIndex = ADatum.DataIndex then
            begin
              AItem := q;
              Exit(True);
            end;
      end;
      Exit;
    end;
end;

function MkValName(const AV: TTyMkVal): string;
begin
  case AV.Kind of
    mvkStr: Result := AV.Str;
    mvkNum: Result := TyJsNumberToString(AV.Num);
  else
    Result := '';
  end;
end;

procedure TTyAdvanceChart.MarkerNameValue(const ADatum: TTyChartDatumRef;
  out AName: string; out AValue: TTyMkVal);
var
  kind: TTyMarkerKind;
  blk: TTyMkBlock;
  it, k, n: Integer;
  e: TTyMkEnd;
  ax: TTyAxis;
  v: TTyMkVal;
  d: TJSONData;
begin
  AName := '';
  AValue := TyMkUndef;
  if not MarkerItemOf(ADatum, kind, blk, it) then Exit;
  case kind of
    mkPoint:
      begin
        e := blk.Points[it].E;
        AValue := e.Value;
        AName := MkValName(e.Name);
        { getName: the item's own name, else the data's NAME DIMENSION --
          its first category coordinate, read through the axis' categories
          (a coord ['B', 70] is named 'B') }
        if not (e.Name.Kind in [mvkStr, mvkNum]) then
          for k := 0 to 1 do
          begin
            if k = 0 then ax := blk.XAxis else ax := blk.YAxis;
            if (ax = nil) or (ax.Categories = nil) then Continue;
            v := e.Values[k];
            if (v.Kind = mvkStr) and (ax.Categories.GetOrdinal(v.Str) >= 0) then
              AName := v.Str
            else if (v.Kind = mvkNum) and not IsNan(v.Num)
              and not IsInfinite(v.Num) then
            begin
              n := Round(v.Num);
              if (n = v.Num) and (n >= 0) and (n < ax.Categories.Count) then
                AName := ax.Categories.CategoryAt(n);
            end;
            Break;
          end;
      end;
    mkLine:
      begin
        AName := MkValName(blk.Lines[it].LineName);
        AValue := blk.Lines[it].LineValue;
      end;
    mkArea:
      begin
        AName := MkValName(blk.Areas[it].Name);
        { the merged item's value: the first corner's, else the second's }
        d := nil;
        if blk.Areas[it].LtSrc <> nil then d := blk.Areas[it].LtSrc.Find('value');
        if (d = nil) and (blk.Areas[it].RbSrc <> nil) then
          d := blk.Areas[it].RbSrc.Find('value');
        if d <> nil then AValue := TyMkOf(d);
      end;
  end;
end;

function TTyAdvanceChart.MarkerTooltipContent(
  const ADatum: TTyChartDatumRef): TTyTooltipBlock;
var
  nm, header, valueText: string;
  v: TTyMkVal;
  noValue: Boolean;
begin
  MarkerNameValue(ADatum, nm, v);
  { MarkerModel.formatTooltip: a section headed by the marker model's name
    -- its HOST's model name, an auto name included, and no noHeader: a
    blank one reads '-' -- holding one marker-less row }
  header := SeriesModelName(ADatum.ComponentIndex);
  if Trim(header) = '' then header := '-';
  noValue := v.Kind in [mvkUndef, mvkNull];
  case v.Kind of
    mvkNum: valueText := TyReadableCell(TyDataNum(v.Num), ddtFloat);
    mvkStr: valueText := TyReadableCell(TyDataText(v.Str), ddtFloat);
  else
    valueText := '-';
  end;
  { noName is `!itemName`; any other name goes through makeValueReadable }
  if nm <> '' then nm := TipRowName(nm);
  Result := TTyTooltipBlock.CreateSection(header, False);
  Result.Add(TTyTooltipBlock.CreateNameValue(ttmNone, 0, nm, nm = '',
    valueText, noValue));
end;

function TTyAdvanceChart.MarkerTooltipParams(
  const ADatum: TTyChartDatumRef): TTyChartCallbackParams;
var
  nm: string;
  v: TTyMkVal;
  kind: TTyMarkerKind;
  blk: TTyMkBlock;
  it, slot: Integer;
begin
  Result := TyChartBlankParams;
  MarkerNameValue(ADatum, nm, v);
  if not MarkerItemOf(ADatum, kind, blk, it) then
    case ADatum.Kind of
      ctkMarkLine: kind := mkLine;
      ctkMarkArea: kind := mkArea;
    else
      kind := mkPoint;
    end;
  { MarkerModel.getDataParams: the marker's own, with the HOST's series
    fields }
  Result.ComponentType := TyMarkerKey[kind];
  Result.SeriesIndex := ADatum.ComponentIndex;
  slot := SlotOfSeries(ADatum.ComponentIndex);
  if slot >= 0 then Result.SeriesType := FBindings[slot].SeriesType;
  Result.SeriesName := SeriesModelName(ADatum.ComponentIndex);
  Result.SeriesId := SeriesIdOf(FOption, ADatum.ComponentIndex);
  Result.DataIndex := ADatum.DataIndex;
  Result.RawDataIndex := ADatum.DataIndex;
  Result.Name := nm;
  { the colour the box's border takes: one answer, DatumColour's }
  Result.Color := DatumColour(ADatum);
  case v.Kind of
    mvkNum:
      begin
        SetLength(Result.Values, 1);
        Result.Values[0] := v.Num;
        Result.ValueText := TyJsNumberToString(v.Num);
      end;
    mvkStr:
      begin
        Result.Raw.Shape := rshScalar;
        Result.Raw.Scalar := TyDataText(v.Str);
        Result.ValueText := v.Str;
      end;
  else
    Result.Raw.Shape := rshAbsent;
  end;
end;

function TTyAdvanceChart.MarkerColour(const ADatum: TTyChartDatumRef): TTyChartColor;
var
  kind: TTyMarkerKind;
  blk: TTyMkBlock;
  it, q: Integer;
  c: TTyChartColor;
  pp: TTyMkPointPicArray;
  lp: TTyMkLinePicArray;
  ap: TTyMkAreaPicArray;
begin
  Result := 0;
  if not MarkerItemOf(ADatum, kind, blk, it) then Exit;
  case kind of
    mkPoint:
      begin
        pp := MarkPointPictures(ADatum.ComponentIndex);
        for q := 0 to High(pp) do
          if (pp[q].Item = it) and TyTryParseChartColor(pp[q].Fill, c) then
            Exit(c);
      end;
    mkLine:
      begin
        lp := MarkLinePictures(ADatum.ComponentIndex);
        for q := 0 to High(lp) do
          if (lp[q].Item = it) and TyTryParseChartColor(lp[q].Stroke, c) then
            Exit(c);
      end;
    mkArea:
      begin
        ap := MarkAreaPictures(ADatum.ComponentIndex);
        for q := 0 to High(ap) do
          if (ap[q].Item = it) and ap[q].HasFill
            and TyTryParseChartColor(ap[q].Fill, c) then
            Exit(c);
      end;
  end;
end;

{ ---- the hierarchies' tooltip [Batch 100] ---- }

{ a node's `name` as upstream's getName answers it: a string, a number's
  text, or nothing }
function HierItemName(AItem: TJSONData): string;
var d: TJSONData;
begin
  Result := '';
  if not (AItem is TJSONObject) then Exit;
  d := TJSONObject(AItem).Find('name');
  if d = nil then Exit;
  if d.JSONType = jtString then Result := d.AsString
  else if d.JSONType = jtNumber then Result := TyJsNumberToString(d.AsFloat);
end;

{ JavaScript's String() of an option value, for `source + ' -- ' + target` }
function TipJsString(AData: TJSONData): string;
begin
  if AData = nil then Exit('undefined');
  case AData.JSONType of
    jtString: Result := AData.AsString;
    jtNumber: Result := TyJsNumberToString(AData.AsFloat);
    jtBoolean: if AData.AsBoolean then Result := 'true' else Result := 'false';
    jtNull: Result := 'null';
    jtObject: Result := '[object Object]';
  else
    Result := '';
  end;
end;

{ makeValueReadable of one raw cell, no type }
function TipCellText(AData: TJSONData): string;
begin
  if AData = nil then Exit('-');
  case AData.JSONType of
    jtNumber: Result := TyReadableCell(TyDataNum(AData.AsFloat), ddtFloat);
    jtString: Result := TyReadableCell(TyDataText(AData.AsString), ddtFloat);
    jtBoolean: Result := TyReadableCell(TyDataBool(AData.AsBoolean), ddtFloat);
  else
    Result := '-';
  end;
end;

function TTyAdvanceChart.HierTooltipContent(const ADatum: TTyChartDatumRef;
  const AColour: TTyChartColor; out ABlock: TTyTooltipBlock): Boolean;
var
  slot, row, k: Integer;
  st, nm, valueText: string;
  item, d: TJSONData;
  v: Double;
  has: Boolean;
begin
  ABlock := nil;
  Result := False;
  if ADatum.SeriesIndex < 0 then Exit;
  slot := SlotOfSeries(ADatum.SeriesIndex);
  if slot < 0 then Exit;
  row := ADatum.DataIndex;
  st := FBindings[slot].SeriesType;

  { SUNBURST: upstream's default series tooltip -- headed by the series'
    name when it was written, one row with the item marker, the node's
    name and its value (a parent's is the sum completeTreeValue wrote) }
  if (st = TySunburstSeriesTypeName) and (slot <= High(FSunbursts))
    and FSunbursts[slot].Valid then
  begin
    { the virtual root only as the return circle [Batch 115] }
    if (row < 0) or (row > High(FSunbursts[slot].Nodes)) then Exit;
    if (row = 0) and (FSunbursts[slot].ViewRoot = 0) then Exit;
    Result := True;
    nm := SeriesNameOf(ADatum.SeriesIndex);
    if (nm <> '') and (Trim(nm) = '') then nm := '-';
    ABlock := TTyTooltipBlock.CreateSection(nm, False);
    if row = 0 then nm := HierItemName(FOption.ComponentAt('series', ADatum.SeriesIndex))
    else nm := HierItemName(FSunbursts[slot].Hier.Nodes[row].Item);
    v := FSunbursts[slot].Nodes[row].Value;
    ABlock.Add(TTyTooltipBlock.CreateNameValue(ttmItem, AColour, nm, False,
      TyTooltipValueText(v), False));
    Exit;
  end;

  { TREEMAP: one bare nameValue -- no marker, no section; a missing name
    reads '-' (no noName); the value is the raw one, an array's cells joined
    by two spaces, the first being the value completeTreeValue settled }
  if (st = TyTreemapSeriesTypeName) and (slot <= High(FTreemaps))
    and FTreemaps[slot].Valid then
  begin
    { the root's background takes the pointer too, named after the series
      [Batch 115] }
    if (row < 0) or (row > High(FTreemaps[slot].Nodes)) then Exit;
    Result := True;
    if row = 0 then item := FOption.ComponentAt('series', ADatum.SeriesIndex)
    else item := FTreemaps[slot].Hier.Nodes[row].Item;
    nm := TipRowName(HierItemName(item));
    v := FTreemaps[slot].Nodes[row].Value;
    valueText := TyTooltipValueText(v);
    d := nil;
    if item is TJSONObject then d := TJSONObject(item).Find('value');
    if (d <> nil) and (d.JSONType = jtArray) and (d.Count > 1) then
      for k := 1 to d.Count - 1 do
        valueText := valueText + '  ' + TipCellText(d.Items[k]);
    ABlock := TTyTooltipBlock.CreateSection('', True);
    ABlock.Add(TTyTooltipBlock.CreateNameValue(ttmNone, 0, nm, False,
      valueText, False));
    Exit;
  end;

  { SANKEY: a bare nameValue too. A node: its `name` ('-' without one) and
    its LAYOUT value -- the larger of its own and its flow; a link: the
    written `source -- target` and its value. NaN is no value. }
  if (st = TySankeySeriesTypeName) and (slot <= High(FSankeys))
    and FSankeys[slot].Valid then
  begin
    if ADatum.IsEdge then
    begin
      if (row < 0) or (row > High(FSankeys[slot].Edges)) then Exit;
      item := FSankeys[slot].Edges[row].Item;
      if item is TJSONObject then
        nm := TipJsString(TJSONObject(item).Find('source')) + ' -- '
          + TipJsString(TJSONObject(item).Find('target'))
      else
        nm := 'undefined -- undefined';
      v := FSankeys[slot].Edges[row].Value;
    end
    else
    begin
      if (row < 0) or (row > High(FSankeys[slot].Nodes)) then Exit;
      nm := TipRowName(HierItemName(FSankeys[slot].Nodes[row].Item));
      v := FSankeys[slot].Nodes[row].Value;
    end;
    Result := True;
    ABlock := TTyTooltipBlock.CreateSection('', True);
    ABlock.Add(TTyTooltipBlock.CreateNameValue(ttmNone, 0, nm, False,
      TyTooltipValueText(v), IsNan(v)));
    Exit;
  end;

  { CHORD: a bare nameValue (ChordSeries.formatTooltip). A node: its name
    ('-' without one) and its value -- the raw one, else the layout's; a
    link: its two nodes' names joined by ' > ' and its own value, none when
    it has none [Batch 120] }
  if (st = TyChordSeriesTypeName) and (slot <= High(FChords))
    and FChords[slot].Valid then
  begin
    if ADatum.IsEdge then
    begin
      row := ADatum.RawDataIndex;
      if (row < 0) or (row > High(FChords[slot].Edges)) then Exit;
      nm := FChords[slot].Nodes[FChords[slot].Edges[row].Source].Name + ' > '
        + FChords[slot].Nodes[FChords[slot].Edges[row].Target].Name;
      has := TyChordEdgeRawValue(FChords[slot], row, v, valueText);
    end
    else
    begin
      row := ADatum.RawDataIndex;
      if (row < 0) or (row > High(FChords[slot].Nodes)) then Exit;
      nm := FChords[slot].Nodes[row].Name;
      has := TyChordNodeValue(FChords[slot], row, v, valueText);
    end;
    { makeValueReadable: a number grouped, a string as it is ('-' blank) }
    if has and not IsNan(v) then valueText := TyTooltipValueText(v)
    else if has and (Trim(valueText) = '') then valueText := '-';
    Result := True;
    ABlock := TTyTooltipBlock.CreateSection('', True);
    ABlock.Add(TTyTooltipBlock.CreateNameValue(ttmNone, 0, TipRowName(nm), False,
      valueText, not has));
  end;
end;

procedure TTyAdvanceChart.PaintTooltip(APainter: TTyPainter; const ARect: TRect;
  APPI: Integer; const AMeasurer: ITyTextMeasurer);
var
  onAxis: Boolean;
  spec: TTyTooltipSpec;
  ink: TTyTooltipInk;
  block: TTyTooltipBlock;
  lines: TTyTooltipLineArray;
  st: TTyStyleSet;
  params: TTyChartParams;
  tipText, fmtText: string;
  k, m: Integer;
  hasSeries: Boolean;
  w, h, lineH, gap, cx, cy: Double;
  padL, padT, padR, padB, radius, borderW: Double;
  box: TTyRectF;
  r: TRect;
  i, j, row, lineTop: Integer;
  corners: TTyCorners;
  surface: TTyFill;
  borderCol: TTyColor;
  snap: TTyTipSnap;
  pin: TTyTooltipPlaceIn;
  at: TTyPointF;
  elRect: TTyRectF;
begin
  FTipBox := TyInvalidRectF;
  FTipRect := TyInvalidRectF;
  FTipFormatterText := '';
  { [Batch 100] WHAT IS SHOWN, NOT WHAT IS HOVERED: the box's own state
    decides -- a show waiting out showDelay is not drawn yet, a hide waiting
    out hideDelay still is, at the place and with the content of the show }
  if not FTipShown then Exit;
  { [F4b] a box that outlived a re-render: its axes and element from the
    build standing now }
  TipSnapRefresh;
  snap := FTipSnap;
  onAxis := Length(snap.Hits) > 0;
  if not TipTargetValid(snap.Datum) and not onAxis then Exit;
  { UNDER AN AXIS TRIGGER THERE IS NO CASCADE. Upstream builds the axis
    tooltip's model from the global component and a positioning hint and
    nothing else -- no series level, no data item -- so every option but
    valueFormatter is global there. }
  spec := TipSpecOf(snap);
  if not spec.HasComponent then Exit;
  if not spec.Show or not spec.ShowContent then Exit;
  { AN AXIS HIT OUTRANKS AN ITEM ONE. Upstream routes on the payload's SHAPE --
    if a coordinate system reported axes, the axis path runs and the item
    trigger is never consulted. }
  if not onAxis and (spec.Trigger <> tttItem) and not IsGeoDatum(snap.Datum) then Exit;
  ink := TooltipInk(spec);

  st := ActiveController.Model.ResolveStyle('TyAdvChartTooltip', StyleClass,
    [tysNormal]);
  { NO BOX WITHOUT A BACKGROUND. A theme that defines no tooltip surface gets
    no tooltip -- never a hard-coded colour, which is the rule the old chart
    already follows and the reason the key lives in the base layer where every
    theme inherits it. }
  if not (tpBackground in st.Present) then Exit;

  block := nil;
  try
    if (not onAxis) and IsGeoDatum(snap.Datum) then
    begin
      { [Batch 148] A GEO REGION'S TEXT: the formatter through formatTpl
        with the component's params, else the content (the name) }
      tipText := GeoTipText(snap.Datum, spec);
      FTipFormatterText := tipText;
      if tipText = '' then Exit;
      block := TTyTooltipBlock.CreateSection('', True);
      block.Add(TTyTooltipBlock.CreateNameValue(ttmNone, 0, tipText, False,
        '', True));
    end
    else if spec.HasFormatter then
    begin
      { A FORMATTER REPLACES THE CONTENT, it does not decorate it. Upstream
        builds the default markup first and then throws it away, so a
        formatter with side effects still sees them run; here the default is
        simply not built, which is the same picture for less. }
      SetLength(params, 1);
      { A FORMATTER UNDER AN AXIS TRIGGER IS GIVEN EVERY SERIES, in the order
        the sections hold them -- which is what makes `{a1}` and `{c2}` mean
        anything at all. }
      if onAxis then params := AxisTooltipParams(snap.Hits)
      else params[0] := TooltipParams(snap.Datum);
      if Length(params) = 0 then Exit;
      fmtText := spec.Formatter;
      { A TEMPLATE UNDER A TIME AXIS IS A TIME TEMPLATE FIRST: TooltipView
        runs the string through util/time.ts format at the first series'
        axis value before formatTpl sees it -- so `{a}` there is am / pm and
        `{d}` the day, never the series name or the percent. Only an axis
        trigger's params carry an axis type, and only an axis trigger has
        sections to walk: an item tooltip is left alone. [Batch 104] }
      if not TyChartIsHandlerRef(fmtText) then
        for k := 0 to High(snap.Hits) do
        begin
          { params[0] is the first series of the first section that has one }
          hasSeries := False;
          for m := 0 to High(snap.Hits[k].Slots) do
            if (snap.Hits[k].Slots[m] >= 0)
              and (snap.Hits[k].Slots[m] <= High(FBindings)) then hasSeries := True;
          if snap.Hits[k].Cross or not hasSeries then Continue;
          if (snap.Hits[k].Axis <> nil) and (snap.Hits[k].Axis.Scale is TTyTimeScale) then
            fmtText := TyFormatTime(snap.Hits[k].SnapValue, fmtText,
              TTyTimeScale(snap.Hits[k].Axis.Scale).UTC);
          Break;
        end;
      { a matrix cell's template is formatTpl over its own $vars [Batch 147] }
      if TipIsMatrix(snap.Datum) and not TyChartIsHandlerRef(fmtText) then
        tipText := MatrixTipText(fmtText, snap.Datum)
      else if not TyChartResolveText(fmtText, params, tipText) then
        { A named handler that is not registered says so rather than drawing
          nothing -- TyChartResolveText puts the message in the text. }
        ;
      FTipFormatterText := tipText;
      if Trim(tipText) = '' then Exit;
      block := TTyTooltipBlock.CreateSection('', True);
      { THE WHOLE STRING AS ONE NAME. A formatter's output is words, not a
        name/value pair, so it takes the name ink and no gutter -- and with
        neither marker nor name flag set the row is the third case upstream
        has and most ports do not: no marker, no right-alignment. }
      block.Add(TTyTooltipBlock.CreateNameValue(ttmNone, 0, tipText, False,
        '', True));
    end
    else if onAxis then
      block := AxisTooltipContent(snap.Hits, spec)
    else
      block := TooltipContent(snap.Datum, spec);
    if block = nil then Exit;

    lines := TyTooltipFlatten(block, ink);
    if Length(lines) = 0 then Exit;

    if spec.HasPadding then
    begin
      padL := APainter.ScaleF(spec.PadLeft);
      padT := APainter.ScaleF(spec.PadTop);
      padR := APainter.ScaleF(spec.PadRight);
      padB := APainter.ScaleF(spec.PadBottom);
    end
    else
    begin
      padL := APainter.Scale(st.Padding.Left);
      padT := APainter.Scale(st.Padding.Top);
      padR := APainter.Scale(st.Padding.Right);
      padB := APainter.Scale(st.Padding.Bottom);
    end;

    TyTooltipMeasure(lines, ink, AMeasurer, APPI, padL, padT, padR, padB, w, h);
    TooltipContentSize(w, h);
    if (w <= 0) or (h <= 0) then Exit;

    borderW := st.BorderWidth;
    if spec.HasBorderWidth then borderW := spec.BorderWidthLogical;

    { [Batch 100] WHERE IT GOES: TooltipView._updatePosition -- the option's
      position (a handler's answer read the same way), align, confine -- in
      the control's own coordinates, the pointer of the SHOW and, for an item,
      the element it was over. The gap is the theme's (upstream's 20). }
    gap := APainter.ScaleF(ActiveController.Metric(TyAdvChartTooltipGapVar,
      TyAdvChartTooltipGap));
    pin := Default(TTyTooltipPlaceIn);
    pin.PointX := snap.X - ARect.Left;
    pin.PointY := snap.Y - ARect.Top;
    pin.ContentW := w;
    pin.ContentH := h;
    pin.ViewW := ARect.Right - ARect.Left;
    pin.ViewH := ARect.Bottom - ARect.Top;
    pin.Gap := gap;
    pin.BorderWidth := APainter.ScaleF(borderW);
    pin.IsAxis := onAxis;
    elRect := TyInvalidRectF;
    if (not onAxis) and (FPaintList <> nil) and FPaintListValid
      and (snap.Element >= 0) and (snap.Element < FPaintList.Count) then
      elRect := TipElementRect(snap.Element, APPI);
    if TyRectFIsValid(elRect) then
    begin
      pin.HasRect := True;
      pin.Rect := TyXYWH(elRect.Left - ARect.Left, elRect.Top - ARect.Top,
        elRect.Right - elRect.Left, elRect.Bottom - elRect.Top);
      FTipRect := elRect;
    end;
    if spec.PositionHandler <> '' then
    begin
      if onAxis then pin.Params := AxisTooltipParams(snap.Hits)
      else if IsGeoDatum(snap.Datum) then
        pin.Params := TyChartOneParams(GeoTipParams(snap.Datum))
      else pin.Params := TyChartOneParams(TooltipParams(snap.Datum));
    end;
    at := TyTooltipPlace(spec, pin);
    { [F4b] the box a re-render left up stays where it was until a show
      places it again }
    if snap.Frozen then
    begin
      at.X := snap.FrozenX - ARect.Left;
      at.Y := snap.FrozenY - ARect.Top;
    end;
    box := TyRectF(ARect.Left + at.X, ARect.Top + at.Y,
      ARect.Left + at.X + w, ARect.Top + at.Y + h);
    FTipBox := box;
    r := Rect(Round(box.Left), Round(box.Top),
              Round(box.Right), Round(box.Bottom));

    corners := TyEffectiveCorners(st);
    if spec.HasBorderRadius then
    begin
      radius := spec.BorderRadiusLogical;
      corners.TL := Round(radius);
      corners.TR := corners.TL;
      corners.BR := corners.TL;
      corners.BL := corners.TL;
    end;

    { NOT DrawFrame. That is the CONTROL's frame path and it pushes tpOpacity
      onto the painter, which EndPaint then applies to the WHOLE bitmap -- a
      tooltip style carrying an opacity would fade the entire chart. So the
      box paints its own surface, and a translucent panel has to arrive as an
      alpha-bearing background colour rather than as an opacity. }
    if (tpShadow in st.Present) and (TyAlphaOf(st.ShadowColor) > 0) then
      APainter.DropShadow(r, st.BorderRadius, st.ShadowColor, st.ShadowBlur,
        st.ShadowOffset);
    { THE THEME'S FILL, with only its COLOUR replaced when the option named
      one -- so a skin that made the tooltip a gradient or an image keeps that
      treatment for every chart whose author did not overrule it. }
    surface := st.Background;
    if spec.HasBackground then
    begin
      surface.Kind := tfkSolid;
      surface.Color := TTyColor(spec.Background);
    end;
    APainter.FillBackground(r, surface, corners);

    { THE BORDER IS TINTED WITH THE HOVERED ITEM'S COLOUR, which is the
      signature ECharts 6 look and is easy to miss: the grey token is the
      fallback for an AXIS tooltip, and an item tooltip takes the datum's own
      colour. A written borderColor still wins over both. }
    if spec.HasBorderColour then borderCol := TTyColor(spec.BorderColour)
    else if not onAxis and not IsGeoDatum(snap.Datum) and (DatumColour(snap.Datum) <> 0) then
      borderCol := TTyColor(DatumColour(snap.Datum))
    else
      { THE GREY IS THE AXIS TOOLTIP'S ANSWER, not a chart-wide default: a box
        describing several series cannot take one of their colours. }
      borderCol := st.BorderColor;
    if (borderW > 0) and (TyAlphaOf(borderCol) > 0) then
      APainter.StrokeBorder(r, corners, Round(borderW), borderCol);

    lineH := APainter.ScaleF(ink.LineHeightLogical);
    row := 0;
    for i := 0 to High(lines) do
    begin
      row := row + lines[i].BlankLinesBefore;
      lineTop := Round(box.Top + padT + row * lineH);
      for j := 0 to High(lines[i].Runs) do
        if lines[i].Runs[j].Kind = ttrMarker then
        begin
          cx := box.Left + padL + lines[i].Runs[j].X
                + lines[i].Runs[j].W / 2;
          cy := lineTop + lineH / 2;
          { BeginPath FIRST. CirclePath APPENDS to the canvas' current path,
            it does not start one -- so without this the fill takes in
            whatever the static pass left half-built and paints it in the
            marker's colour. It drew a blue rectangle over a legend label,
            and the pixel test that counts what changed between two frames
            went green on it, because the wrong pixels are still pixels. }
          APainter.BeginPath;
          APainter.CirclePath(cx, cy, lines[i].Runs[j].W / 2);
          APainter.FillPath(TTyColor(lines[i].Runs[j].Colour));
        end
        else
        begin
          { NO ELLIPSIS. The box was measured to fit these exact runs, and
            upstream never wraps or truncates a tooltip in either mode -- its
            width is content-driven and its CSS says `white-space: nowrap`. }
          APainter.DrawText(
            Rect(Round(box.Left + padL + lines[i].Runs[j].X), lineTop,
                 Round(box.Left + padL + lines[i].Runs[j].X
                       + lines[i].Runs[j].W) + 1,
                 Round(lineTop + lineH)),
            TyInkText(lines[i].Runs[j].Text), lines[i].Runs[j].FontName,
            lines[i].Runs[j].FontSizeLogical, lines[i].Runs[j].FontWeight,
            TTyColor(lines[i].Runs[j].Colour), taLeftJustify, tlCenter, False);
        end;
      Inc(row);
    end;
  finally
    block.Free;
  end;
end;

procedure TTyAdvanceChart.MouseMove(Shift: TShiftState; X, Y: Integer);
var
  d, preD: TTyChartDatumRef;
  spec: TTyTooltipSpec;
  el, preEl: Integer;
  wasOn, tipWas, pre, roamed: Boolean;
  dx, dy, pdx, pdy: Double;
begin
  { the frame between two pointer events [Batch 125] }
  TbFrame;
  inherited MouseMove(Shift, X, Y);
  if csDesigning in ComponentState then Exit;
  { THE HOVER BEFORE THE PAN [Milestone D9-D14]: zrender's Handler finds
    the element under the pointer first; the RoamController (and the
    thumbnail's) listens on the zr-level mousemove and moves the picture
    after, so this move's events and tooltip name what was under the
    pointer before it moved -- a region the graph slides over, a node it
    slides away from }
  pre := ((FThumbDrag >= 0) and (FThumbDrag <= High(FThumbs))) or (FRoamSeries >= 0);
  roamed := False;
  if pre then
  begin
    preD := HitTestAt(X, Y, preEl);
    FEvPresetT := EventTargetAt(X, Y);
  end;
  { THE DRAG FIRST: the delta from where the pointer was last, wherever it is
    now -- a drag that leaves the control keeps panning. }
  if (FThumbDrag >= 0) and (FThumbDrag <= High(FThumbs)) then
  begin
    { THE THUMBNAIL'S PAN consumes the move: the graph's controller, armed
      beside it, hears nothing [Batch 140] }
    if not PanTaken then
    begin
      dx := X - FThumbDragX;
      dy := Y - FThumbDragY;
      if FThumbs[FThumbDrag].View.Valid and FThumbs[FThumbDrag].Enabled then
      begin
        TyThumbPanPayload(FThumbs[FThumbDrag].View, FThumbDragX, FThumbDragY,
          dx, dy, pdx, pdy);
        FThumbDragX := X;
        FThumbDragY := Y;
        roamed := GraphRoam(FThumbs[FThumbDrag].Target, pdx, pdy);
      end
      else
      begin
        FThumbDragX := X;
        FThumbDragY := Y;
      end;
    end;
  end
  else if FRoamSeries >= 0 then
  begin
    dx := X - FRoamX;
    dy := Y - FRoamY;
    FRoamX := X;
    FRoamY := Y;
    if IsTreeSeries(FRoamSeries) then TreeRoam(FRoamSeries, dx, dy)
    else if IsSankeySeries(FRoamSeries) then SankeyRoam(FRoamSeries, dx, dy)
    { a treemap's pan: past 3 px, else the delta is lost [Batch 115] }
    else if IsTreemapSeries(FRoamSeries) then TreemapPan(FRoamSeries, Round(dx), Round(dy))
    else roamed := GraphRoam(FRoamSeries, dx, dy);
  end;
  { A NODE DRAG: one 'drag' per move, the delta from the last move [Batch 114] }
  if FGraphDragSlot >= 0 then GraphDragMove(X, Y);
  if FSankeyDragSlot >= 0 then SankeyDragMove(X, Y);
  DataZoomPointer(dpMove, X, Y, Shift, 0);
  { the toolbox's brush [Batch 125] }
  TbCtlMove(X, Y);
  { NOTHING ABOUT THE TOOLTIP IS CHECKED HERE, and that is the point. What is
    under the pointer is a fact about geometry; whether a BOX is drawn for it
    is a question for the tooltip's own listener (below). A chart with
    a tooltip with show false still highlights the mark under the cursor --
    upstream highlights from zrender's own hover and the tooltip is a
    separate listener -- and gating the hover on the tooltip made switching
    the box off switch the highlight off too. }

  wasOn := TyChartDatumValid(FTipDatum) or (Length(FTipHits) > 0);
  if pre then
  begin
    d := preD;
    el := preEl;
    { A GRAPH'S ROAM RENDERS ITS VIEW AGAIN: its symbols and edges are new
      elements, none of them in the emphasis the hovered one had }
    if roamed and IsGraphDatum(d) then
    begin
      d := TyChartNoDatum;
      el := -1;
    end;
  end
  else
    d := HitTestAt(X, Y, el);
  { [F2a] a graph's, a tree's and a treemap's hover are the state machine's
    flags (StHoverOver / StHoverOut, from EventMove): the frame applies
    them }
  FTipDatum := d;
  FTipElement := el;
  FTipX := X;
  FTipY := Y;
  tipWas := FTipShown;
  { the chart's own mouse events [Batch 84] -- zrender hears the chart's
    listeners before the pointer's global one }
  FEvPreset := pre;
  EventMove(X, Y);
  { THE AXIS POINTER AND THE BOX THROUGH THEIR ACTIONS [Batch 153]: the
    global listener turns the move into updateAxisPointer (the pointer's
    hits, an independent piece of state held in FTipHits -- live whenever
    the point is in a coordinate system and something asks for an axis
    pointer, a mark under it or not -- that DropBuild clears because it
    holds axis POINTERS into the build) and the item tooltip's _tryShow,
    then the last showTip or hideTip. The box's own state machine
    [Batch 100] takes them as requests: a show now or after showDelay, a
    hide after hideDelay. }
  PtrListener('mousemove', X, Y, FTipDatum, FTipElement);
  { zrender's Draggable on a brush cover -- the hover above was found before
    it moved -- then the brush controllers' own mousemove [Batch 126] }
  BrushPointerMove(X, Y);
  { ParallelView's mousemove, after the axes' controllers [Batch 140] }
  ParExpMove(X, Y);
  { an icon's pointer, the brush's crosshair [Batch 125] }
  TbApplyCursor(X, Y);
  { REPAINT ON MOVEMENT, not only when the datum changes. The box is anchored
    to the CURSOR -- upstream positions against the raw pointer offsets and
    never against the snapped datum -- so a repaint gated on the datum would
    leave it standing still while the pointer walked away from it. The frame
    this asks for is a blit of the static layer plus one box; the gate the old
    TTyChart needed was compensating for a control that re-rendered everything
    from scratch each paint, and that is what the cache removed. }
  if wasOn or TyChartDatumValid(FTipDatum) or (Length(FTipHits) > 0)
    or tipWas or FTipShown then
    HoverInvalidate;
end;

procedure TTyAdvanceChart.MouseLeave;
var wasOn: Boolean;
begin
  TbFrame;
  if not (csDesigning in ComponentState) then EventLeave(FEvLastX, FEvLastY);
  wasOn := TyChartDatumValid(FTipDatum) or (Length(FTipHits) > 0) or FTipShown;
  FTipDatum := TyChartNoDatum;
  FTipElement := -1;
  { globalout through the pointer's listener [Batch 153]: the axis
    pointer's updateAxisPointer with currTrigger 'leave' hides the pointers
    (unless its triggerOn is 'none'), the tooltip's _hide the box -- after
    hideDelay, or never under alwaysShowContent }
  if not (csDesigning in ComponentState) then
  begin
    if not FOptPtrGone then wasOn := True;
    PtrListener('leave', 0, 0, TyChartNoDatum, -1);
  end;
  { the pointer left the canvas: a mouseout to what it was over }
  if FDzHover.Kind <> dtkNone then
  begin
    DzMouseOut(FDzHover);
    FDzHover := Default(TTyDzTarget);
    DzViewUpdate;
  end;
  { INHERITED LAST. The base class ends in PointerStateChanged, which this
    control answers with a repaint -- and a repaint before the hover was
    cleared would draw the tooltip one more time on the way out. }
  inherited MouseLeave;
  if wasOn then HoverInvalidate;
end;

{ ==================== the enter animation [Batch 89] ==================== }

function TTyAdvanceChart.AnimClock: Double;
begin
  if IsNan(FAnimNow) then Result := TyAnimClockMs else Result := FAnimNow;
end;

function TTyAdvanceChart.AnimAllowed: Boolean;
begin
  { the designer streams and repaints at will and runs no timer: never }
  if csDesigning in ComponentState then Exit(False);
  case FAnimMode of
    camAlways: Result := True;
    camOff: Result := False;
  else
    Result := FAnimWindow;
  end;
end;

procedure TTyAdvanceChart.SetAnimMode(AValue: TTyChartAnimationMode);
begin
  if FAnimMode = AValue then Exit;
  FAnimMode := AValue;
  { switched off mid-flight: the picture finishes at once }
  if AValue = camOff then
  begin
    AnimDropAll;
    FAnimPending := False;
    DropStatic;
    FZrDirty := True;
    inherited Invalidate;
  end;
  { the spinner stops under camOff and turns again out of it [Batch 106] }
  if FLoadShown then AnimArmTimer;
end;

procedure TTyAdvanceChart.AnimDropAll;
var i: Integer;
begin
  if FAnimSet <> nil then FAnimSet.Clear;
  { the graphic elements at their last frames [Batch 122] }
  if FGfxView <> nil then FGfxView.Snap;
  { and the custom series' [Batch 124] }
  for i := 0 to High(FCustomViews) do
    if FCustomViews[i] <> nil then FCustomViews[i].Snap;
  AxisAnimDrop;
  { a treemap's drill-down snaps with the rest [Batch 115] }
  TmAnimDropAll;
  FAnimBind := nil;
  FAnimStBind := nil;
  FAnimFlush := False;
  FAnimLive := False;
  FAnimContinuous := False;
  AnimDropPrev;
  AnimArmTimer;
end;

{ ==================== the axes' groupTransition [Batch 96] ==================== }

procedure TTyAdvanceChart.AxisAnimDrop;
var i: Integer;
begin
  if FAxisList = nil then Exit;
  { the proxies free their clips off the driver }
  for i := 0 to FAxisList.Count - 1 do TObject(FAxisList[i]).Free;
  FAxisList.Clear;
  FAxisProxies.Clear;
end;

function TTyAdvanceChart.AxisProxyOf(const AKey: string): TTyChartAnimProxy;
begin
  if FAxisProxies = nil then Exit(nil);
  Result := TTyChartAnimProxy(FAxisProxies.Find(AKey));
end;

function TTyAdvanceChart.AnimAxisProxyCount: Integer;
begin
  if FAxisList = nil then Result := 0 else Result := FAxisList.Count;
end;

function TTyAdvanceChart.AnimAxisProxy(const AAxisKey, AAnid: string): TTyChartAnimProxy;
begin
  Result := AxisProxyOf(TyAxisAnimKey(AAxisKey, AAnid));
end;

function TTyAdvanceChart.AxesDynamic: Boolean;
begin
  Result := FAnimLive and not FAnimContinuous and (AnimAxisProxyCount > 0);
end;

function TTyAdvanceChart.AxisAnimElementsOf(ABuild: TTyChartBuild; APPI: Integer;
  out AKeys: TTyStringArray; out AAxisKeys: TTyStringArray): TTyAxisAnimElArray;
var
  g, a, k, n: Integer;
  gb: TTyGridBuild;
  ax: TTyAxis;
  spec: PTyAxisLayoutSpec;
  furn: TTyAxisFurniture;
  inp: TTyAxisAnimInput;
  els, all_: TTyAxisAnimElArray;
  keys, axKeys: TTyStringArray;
  akey: string;
  model: TTyStyleModel;
  scale: Double;

  { the width a pen is drawn in, device px (PaintAxis' LineWidth) }
  function PenWidth(const AKey: string): Double;
  var st: TTyStyleSet;
  begin
    st := model.ResolveStyle(AKey, '', []);
    if tpBorderWidth in st.Present then Result := st.BorderWidth else Result := 1;
    if Result < 0.05 then Result := 0.05;
    Result := Result * scale;
  end;

  procedure Take(AAxis: TTyAxis);
  var i: Integer;
  begin
    if (AAxis = nil) or not AAxis.Visible then Exit;
    spec := gb.SpecFor(AAxis);
    if spec = nil then Exit;
    furn := gb.FurnitureFor(AAxis);
    inp := Default(TTyAxisAnimInput);
    inp.ShowLine := furn.ShowLine;
    inp.ShowTicks := furn.ShowTicks and not AAxis.Scale.Blank;
    inp.ShowLabels := furn.ShowLabels and spec^.ShowLabels;
    inp.ShowSplitLine := furn.ShowSplitLine;
    inp.TickInside := furn.TickInside;
    inp.TickLength := spec^.TickLengthLogical * scale;
    inp.LineWidth := PenWidth('TyAdvChartAxisLine');
    inp.TickWidth := PenWidth('TyAdvChartAxisTick');
    inp.SplitWidth := PenWidth('TyAdvChartSplitLine');
    inp.Horizontal := AAxis.Horizontal;
    inp.Plot := gb.PlotXYWH;
    inp.ByTick := AxisByTick(AAxis);
    els := TyAxisAnimElements(spec^, inp);
    akey := AAxis.MainType + IntToStr(AAxis.ComponentIndex);
    SetLength(all_, n + Length(els));
    SetLength(keys, n + Length(els));
    SetLength(axKeys, n + Length(els));
    for i := 0 to High(els) do
    begin
      all_[n] := els[i];
      keys[n] := TyAxisAnimKey(akey, els[i].Anid);
      axKeys[n] := akey;
      Inc(n);
    end;
  end;

begin
  Result := nil;
  AKeys := nil;
  AAxisKeys := nil;
  all_ := nil;
  keys := nil;
  axKeys := nil;
  n := 0;
  if ABuild = nil then Exit;
  model := ActiveController.Model;
  scale := APPI / 96;
  for g := 0 to ABuild.GridCount - 1 do
  begin
    gb := ABuild.Grid(g);
    for a := 0 to gb.XAxisCount - 1 do Take(gb.XAxis(a));
    for a := 0 to gb.YAxisCount - 1 do Take(gb.YAxis(a));
  end;
  k := n;
  SetLength(all_, k);
  Result := all_;
  AKeys := keys;
  AAxisKeys := axKeys;
end;

procedure TTyAdvanceChart.AxisAnimArm(AOldBuild, ANewBuild: TTyChartBuild);
var
  oldEls, newEls: TTyAxisAnimElArray;
  oldKeys, newKeys, oldAx, newAx, nowAxes: TTyStringArray;
  kept: TStringList;
  oldIdx, oldMap: TFPHashList;
  oldList: TFPList;
  i, k: Integer;
  p, q: TTyChartAnimProxy;
  props, from: TTyAnimProps;
  model: TTyAnimModel;
  v: Pointer;
  ak: string;
begin
  if FAnim = nil then Exit;
  if FAxisList = nil then
  begin
    FAxisList := TFPList.Create;
    FAxisProxies := TFPHashList.Create;
  end;
  oldEls := AxisAnimElementsOf(AOldBuild, FLastPPI, oldKeys, oldAx);
  newEls := AxisAnimElementsOf(ANewBuild, FLastPPI, newKeys, newAx);
  oldList := FAxisList;
  oldMap := FAxisProxies;
  FAxisList := TFPList.Create;
  FAxisProxies := TFPHashList.Create;
  oldIdx := TFPHashList.Create;
  { WHICH AXIS VIEWS ARE KEPT [Batch 99]: prepareView's '_ec_' + model id +
    '_' + type is the same and the model does not ask for a new view. A
    replaced axis, or one whose type changed, is a new view: its leaves
    appear where they are. }
  kept := TStringList.Create;
  nowAxes := AxisViewKeys;
  for i := 0 to High(nowAxes) do
  begin
    ak := Copy(nowAxes[i], 1, Pos('=', nowAxes[i]) - 1);
    v := nil;
    for k := 0 to High(FAnimFreshAxes) do
      if FAnimFreshAxes[k] = ak then v := Pointer(1);
    if v <> nil then Continue;
    for k := 0 to High(FAnimOldAxisKeys) do
      if FAnimOldAxisKeys[k] = nowAxes[i] then kept.Add(ak);
  end;
  try
    { the old group's leaves by anid (getElMap) }
    for i := 0 to High(oldEls) do
      if oldIdx.Find(oldKeys[i]) = nil then
        oldIdx.Add(oldKeys[i], Pointer(PtrInt(i + 1)));
    for i := 0 to High(newEls) do
    begin
      props := TyAxisAnimProps(newEls[i]);
      p := TTyChartAnimProxy.Create(-1, -1, newKeys[i]);
      p.Animation := FAnim;
      FAxisList.Add(p);
      if FAxisProxies.Find(newKeys[i]) = nil then FAxisProxies.Add(newKeys[i], p);
      v := oldIdx.Find(newKeys[i]);
      if kept.IndexOf(newAx[i]) < 0 then v := nil;
      if v = nil then
      begin
        { NO OLD LEAF OF THAT ANID: it appears where it is }
        p.Attr(props);
        p.SetFinal(props);
        Continue;
      end;
      { the old leaf's props as they are NOW: its proxy's, while it moves }
      from := TyAxisAnimProps(oldEls[PtrInt(v) - 1]);
      q := TTyChartAnimProxy(oldMap.Find(newKeys[i]));
      if q <> nil then
        for k := 0 to High(from) do
          if q.GetAnimProp(from[k].Key).Kind = avkNumber then
            from[k].Value := q.GetAnimProp(from[k].Key);
      p.Attr(from);
      p.SetFinal(props);
      { updateProps on the axis model, at no data index }
      ak := newAx[i];
      model := TyAnimComponentModel(FOption.ComponentAt(Copy(ak, 1, 5),
        StrToIntDef(Copy(ak, 6, MaxInt), 0)), FOption.Root, 'axis');
      model.Payload := FAnimPayload;
      model.HasPayload := FAnimHasPayload;
      TyUpdateProps(p, props, model, TyAnimCallNoIndex);
    end;
  finally
    kept.Free;
    oldIdx.Free;
    for i := 0 to oldList.Count - 1 do TObject(oldList[i]).Free;
    oldList.Free;
    oldMap.Free;
  end;
end;

{ a render's sunburst pieces (not the return circle, which no item is
  morphed from), each replacing the one its row had [milestone D5-D8] }
procedure TTyAdvanceChart.UtStaleHarvest;
var
  i, k: Integer;
  el: TTyChartElement;
  idx: TFPHashList;
  key: string;
  v: Pointer;
begin
  if FPaintList = nil then Exit;
  idx := nil;
  try
    for i := 0 to FPaintList.Count - 1 do
    begin
      el := FPaintList.Element(i);
      if (el.Anim.Role <> carSunPiece) or (el.Anim.Index <= 0) then Continue;
      if idx = nil then
      begin
        idx := TFPHashList.Create;
        for k := 0 to High(FUtStale) do
          idx.Add(IntToStr(FUtStale[k].Anim.Series) + ':' + IntToStr(FUtStale[k].Anim.Index),
            Pointer(PtrInt(k + 1)));
      end;
      key := IntToStr(el.Anim.Series) + ':' + IntToStr(el.Anim.Index);
      v := idx.Find(key);
      if v <> nil then
        FUtStale[PtrInt(v) - 1] := el
      else
      begin
        SetLength(FUtStale, Length(FUtStale) + 1);
        FUtStale[High(FUtStale)] := el;
        idx.Add(key, Pointer(PtrInt(Length(FUtStale))));
      end;
    end;
  finally
    idx.Free;
  end;
end;

procedure TTyAdvanceChart.AnimDropPrev;
begin
  FAnimPrev := Default(TTyChartAnimPrev);
  FreeAndNil(FAnimOldBuild);
  FAnimOldBindings := nil;
end;

function TTyAdvanceChart.AnimViewKeys: TTyStringArray;
var
  i, n: Integer;
  id: string;
begin
  { the view id is '_ec_' + model.id + '_' + type, the type compared apart:
    makeIdAndName's id -- the written one, else from the name, else the
    dummy name -- which a merge never changes [Batch 95] }
  Result := nil;
  n := FOption.ComponentCount('series');
  SetLength(Result, n);
  for i := 0 to n - 1 do
  begin
    id := FOption.ComponentId('series', i);
    if id <> '' then Result[i] := 'i:' + id
    else Result[i] := 'x:' + IntToStr(i);
  end;
end;

function TTyAdvanceChart.AnimUtKeys: TTyUtSeriesKeysArray;
var
  i, n: Integer;
  own, t: TJSONData;
  typ: string;
begin
  Result := nil;
  if FOption = nil then Exit;
  n := FOption.ComponentCount('series');
  SetLength(Result, n);
  for i := 0 to n - 1 do
  begin
    own := TyAnimSeriesModel(FOption.Root, i, 0).Own;
    typ := '';
    if own is TJSONObject then
    begin
      t := TJSONObject(own).Find('type');
      if (t <> nil) and (t.JSONType = jtString) then typ := t.AsString;
    end;
    Result[i] := TyUtSeriesKeysOf(own, FOption.Root, typ, FOption.ComponentId('series', i));
  end;
end;

function TTyAdvanceChart.AxisViewKeys: TTyStringArray;
var
  t, i, n: Integer;
  mt: string;
begin
  Result := nil;
  for t := 0 to 1 do
  begin
    if t = 0 then mt := 'xAxis' else mt := 'yAxis';
    n := FOption.ComponentCount(mt);
    for i := 0 to n - 1 do
    begin
      SetLength(Result, Length(Result) + 1);
      Result[High(Result)] := mt + IntToStr(i) + '=' + FOption.ComponentId(mt, i) + #1
        + FOption.ComponentSubType(mt, i);
    end;
  end;
end;

function TTyAdvanceChart.AnimAliveKeys: TTyStringArray;
var
  slot, si: Integer;
  vk: TTyStringArray;
  k: string;
begin
  Result := nil;
  vk := AnimViewKeys;
  for slot := 0 to High(FBindings) do
  begin
    si := FBindings[slot].SeriesIndex;
    if si < 0 then Continue;
    if si <= High(vk) then k := vk[si] else k := 'x:' + IntToStr(si);
    if (si <= High(FAnimFresh)) and FAnimFresh[si] then k := 'n:' + k;
    SetLength(Result, Length(Result) + 1);
    Result[High(Result)] := k + #1 + FBindings[slot].SeriesType;
  end;
end;

procedure TTyAdvanceChart.AnimRowKeys(AStore: TTyDataStore; out AKeys: TTyStringArray;
  out ARaws: TTyIntegerArray);
var
  rawKeys: TTyStringArray;
  counts: TStringList;
  d, ord_, raw, k, c: Integer;
  id, nm: string;
  v: Double;
begin
  AKeys := nil;
  ARaws := nil;
  if AStore = nil then Exit;
  { the first category dimension names a row that has no name of its own
    (createSeriesData gives it the item-name role) }
  ord_ := -1;
  for d := 0 to AStore.DimCount - 1 do
    if AStore.DimType(d) = ddtOrdinal then
    begin
      ord_ := d;
      Break;
    end;
  { getId over the raw rows, in order: an id; else the name, '__ec__' and
    its count from the second time on; else 'e\0\0' + the raw index }
  SetLength(rawKeys, AStore.RawCount);
  counts := TStringList.Create;
  try
    { THE NAMES AS JAVASCRIPT KEYS: compared byte for byte, and looked up by
      halves. [Milestone D5-D8: an unsorted list compared through the
      locale -- UTF-16 conversions per comparison, every name against every
      earlier one -- made the gallery's grid-multiple (two series of 3,079
      categories) spend a minute and a half here on each update.] }
    counts.CaseSensitive := True;
    counts.UseLocale := False;
    counts.Sorted := True;
    for raw := 0 to AStore.RawCount - 1 do
    begin
      id := AStore.GetIdByRaw(raw);
      if id <> '' then
      begin
        rawKeys[raw] := id;
        Continue;
      end;
      nm := AStore.GetNameByRaw(raw);
      if (nm = '') and (ord_ >= 0) then
      begin
        v := AStore.GetByRaw(ord_, raw);
        if (not IsNan(v)) and (Frac(v) = 0) and (v >= 0)
          and (v < AStore.CategoryCount(ord_)) then
          nm := AStore.CategoryAt(ord_, Trunc(v));
      end;
      if nm = '' then
      begin
        rawKeys[raw] := 'e'#0#0 + IntToStr(raw);
        Continue;
      end;
      k := counts.IndexOf(nm);
      if k < 0 then
      begin
        counts.AddObject(nm, TObject(PtrInt(1)));
        c := 1;
      end
      else
      begin
        c := PtrInt(counts.Objects[k]) + 1;
        counts.Objects[k] := TObject(PtrInt(c));
      end;
      if c > 1 then rawKeys[raw] := nm + '__ec__' + IntToStr(c)
      else rawKeys[raw] := nm;
    end;
  finally
    counts.Free;
  end;
  SetLength(AKeys, AStore.Count);
  SetLength(ARaws, AStore.Count);
  for k := 0 to AStore.Count - 1 do
  begin
    raw := AStore.GetRawIndex(k);
    ARaws[k] := raw;
    if (raw >= 0) and (raw <= High(rawKeys)) then AKeys[k] := rawKeys[raw]
    else AKeys[k] := 'e'#0#0 + IntToStr(raw);
  end;
end;

procedure TTyAdvanceChart.AnimFullBegin(const APayload: TTyAnimOverride;
  AHasPayload: Boolean);
begin
  { off, or the designer: the layout snaps (Relayout drops every proxy) }
  if (FAnimMode = camOff) or (csDesigning in ComponentState) then Exit;
  { AN UPDATE ALREADY WAITS for its arming: that render is still the one it
    starts from -- a new option's stays notMerge, a full update takes the
    latest payload }
  if FAnimPending then
  begin
    if FAnimFull then
    begin
      FAnimPayload := APayload;
      FAnimHasPayload := AHasPayload;
    end;
    { A LAZY UPDATE STILL WAITING is the action's render: doDispatchAction
      runs `update` with the action's payload and drops the pending one
      ("Still dirty"), so a hand-dispatched init sort lays a lazily added
      bar out at once. Its option's models stay the merge's (or the
      notMerge's). [Milestone D1-D4: the payload and the changeAxisOrder
      flag were dropped and the merge armed at the next paint.] }
    if FLazyPending then
    begin
      FAnimPayload := APayload;
      FAnimHasPayload := AHasPayload;
      FAnimRtChange := FRtChange;
      FAnimLazyTaken := True;
    end;
    Exit;
  end;
  { the same option: its series views are the ones there are now, its axis
    views too [Batch 99] }
  FAnimOldViewKeys := AnimViewKeys;
  FAnimOldUtKeys := AnimUtKeys;
  FAnimOldAxisKeys := AxisViewKeys;
  FAnimFreshAxes := nil;
  FAnimPayload := APayload;
  FAnimHasPayload := AHasPayload;
  FAnimFull := True;
  FAnimPending := True;
  { a changeAxisOrder's render [Batch 135] }
  FAnimRtChange := FRtChange;
end;

procedure TTyAdvanceChart.AnimFullEnd;
var lazyTaken: Boolean;
begin
  lazyTaken := FAnimLazyTaken;
  FAnimLazyTaken := False;
  if not (FAnimPending and (FAnimFull or lazyTaken)) then Exit;
  { a chart that animates only in its window's paint is armed there }
  if not AnimAllowed then Exit;
  AnimAfterBuild;
  StAnimSync;
  { NO FLUSH: dispatchAction renders and returns, and the clips the render
    made take their first step on the next frame }
  FAnimFlush := False;
  FAnimLive := (FAnim <> nil) and (FAnim.ClipCount > 0);
  FAnimContinuous := FAnimLive and AnimLoopOnly;
  AnimArmTimer;
end;

procedure TTyAdvanceChart.AnimSnapshot;
var
  slot, si, i, n, k: Integer;
  r: TTyChartAnimSeries;
  el: TTyChartElement;
  drawnNow: Boolean;
begin
  AnimDropPrev;
  { NOTHING DRAWN BEFORE: the option enters }
  if FPaintList = nil then Exit;
  FAnimPrev.Valid := True;
  FAnimPrev.FullUpdate := FAnimFull;
  FAnimPrev.Merge := FAnimMerge;
  for slot := 0 to High(FBindings) do
  begin
    si := FBindings[slot].SeriesIndex;
    if si < 0 then Continue;
    { A SERIES THE LEGEND SWITCHED OFF drew nothing: switched back on it
      enters, its view having kept no data (BarView._clear nulls _data)
      [Batch 96] }
    if FBindings[slot].Hidden then Continue;
    if si > High(FAnimPrev.Series) then SetLength(FAnimPrev.Series, si + 1);
    r := Default(TTyChartAnimSeries);
    r.Present := True;
    r.SeriesType := FBindings[slot].SeriesType;
    { the same option, or a merge -- the same model object, its option
      merged: its model, for the view's remove() [Batch 99] }
    if FAnimFull or FAnimMerge then
    begin
      n := 0;
      if (slot <= High(FStores)) and (FStores[slot] <> nil) then n := FStores[slot].Count;
      r.Model := TyAnimSeriesModel(FOption.Root, si, n);
      r.Model.Payload := FAnimPayload;
      r.Model.HasPayload := FAnimHasPayload;
      r.Enabled := TyAnimIsEnabled(r.Model);
    end;
    if si <= High(FAnimOldViewKeys) then r.ViewKey := FAnimOldViewKeys[si]
    else r.ViewKey := 'x:' + IntToStr(si);
    if (slot <= High(FStores)) and (FStores[slot] <> nil) then
      AnimRowKeys(FStores[slot], r.Keys, r.Raws);
    { its universal transition, read off the old option [Batch 136]: the
      key, a list's items, its divideShape, its rows' groups [Batch 137]
      and child groups [Batch 138] }
    if (si <= High(FAnimOldUtKeys)) and (FAnimOldUtKeys[si].Key <> '') then
    begin
      r.UtKeyList := FAnimOldUtKeys[si].List;
      r.UtKey := FAnimOldUtKeys[si].Key;
      r.UtKeyItems := FAnimOldUtKeys[si].Items;
      r.UtDivide := FAnimOldUtKeys[si].Divide;
      r.UtGroupIds := TyUtRowGroups(FAnimOldUtKeys[si], r.Raws);
      r.UtChildGroupIds := TyUtRowChildGroups(FAnimOldUtKeys[si], r.Raws);
    end;
    FAnimPrev.Series[si] := r;
  end;
  n := 0;
  SetLength(FAnimPrev.Elements, FPaintList.Count);
  for i := 0 to FPaintList.Count - 1 do
  begin
    el := FPaintList.Element(i);
    if el.Anim.Role = carNone then Continue;
    FAnimPrev.Elements[n] := el;
    Inc(n);
  end;
  SetLength(FAnimPrev.Elements, n);
  { the pieces the data still names that the last render did not draw
    [milestone D5-D8] }
  FAnimPrev.UtStale := nil;
  if not FAnimFull then
    for i := 0 to High(FUtStale) do
    begin
      drawnNow := False;
      for k := 0 to n - 1 do
        if (FAnimPrev.Elements[k].Anim.Role = carSunPiece)
          and (FAnimPrev.Elements[k].Anim.Series = FUtStale[i].Anim.Series)
          and (FAnimPrev.Elements[k].Anim.Index = FUtStale[i].Anim.Index) then
        begin
          drawnNow := True;
          Break;
        end;
      if drawnNow then Continue;
      SetLength(FAnimPrev.UtStale, Length(FAnimPrev.UtStale) + 1);
      FAnimPrev.UtStale[High(FAnimPrev.UtStale)] := FUtStale[i];
    end;
  FAnimPrev.ToOldPoint := @AnimToOldPoint;
  { THE OLD BUILD STAYS ALIVE for its coordinate systems; Rebuild's
    DropBuild finds nothing to free }
  FAnimOldBuild := FBuild;
  FBuild := nil;
  FAnimOldBindings := Copy(FBindings, 0, Length(FBindings));
end;

function TTyAdvanceChart.AnimToOldPoint(AOldSeries: Integer; AX, AY: Double): TTyPointF;
var i: Integer;
begin
  Result := TyPointF(NaN, NaN);
  for i := 0 to High(FAnimOldBindings) do
    if (FAnimOldBindings[i].SeriesIndex = AOldSeries)
      and (FAnimOldBindings[i].Cart <> nil) then
      Exit(FAnimOldBindings[i].Cart.DataToPoint([AX, AY]));
end;

function TTyAdvanceChart.AnimSeriesInfo: TTyChartAnimSeriesArray;
var
  slot, si, n, k: Integer;
  r: TTyChartAnimSeries;
  t: string;
  ser, lbl, va, mk: TJSONData;
  v: TTyAnimOptValue;
  viewKeys: TTyStringArray;
  utk: TTyUtSeriesKeys;
begin
  Result := nil;
  viewKeys := AnimViewKeys;
  for slot := 0 to High(FBindings) do
  begin
    si := FBindings[slot].SeriesIndex;
    if si < 0 then Continue;
    { switched off by the legend: no view content [Batch 96] }
    if FBindings[slot].Hidden then Continue;
    if si > High(Result) then SetLength(Result, si + 1);
    r := Default(TTyChartAnimSeries);
    r.Present := True;
    n := 0;
    if (slot <= High(FStores)) and (FStores[slot] <> nil) then
      n := FStores[slot].Count;
    r.Model := TyAnimSeriesModel(FOption.Root, si, n);
    { the update payload's animation, every timing of this render [Batch 96] }
    r.Model.Payload := FAnimPayload;
    r.Model.HasPayload := FAnimHasPayload;
    r.Enabled := TyAnimIsEnabled(r.Model);
    r.On_ := TyAnimOptTruthy(TyAnimGetShallow(r.Model, 'animation'));
    t := FBindings[slot].SeriesType;
    { THE TYPES WHOSE LABELS FADE IN HERE: the ones this batch animates,
      and the heatmap, whose cells never move but whose labels upstream's
      LabelManager fades all the same }
    r.LabelFade := (t = 'bar') or (t = 'scatter') or (t = 'heatmap')
      or (t = TyPieSeriesTypeName) or (t = TyFunnelSeriesTypeName)
      or (t = 'effectScatter') or (t = TyThemeRiverSeriesTypeName)
      { a chord's node labels [Batch 120] }
      or (t = TyChordSeriesTypeName);
    { A SUNBURST'S DRILL-DOWN: its pieces transition, its new labels fade
      [Batch 115] }
    r.HierDrill := (si <= High(FHierDrill)) and FHierDrill[si];
    if r.HierDrill then r.LabelFade := True;
    ser := r.Model.Own;
    if ser is TJSONObject then
    begin
      lbl := TJSONObject(ser).Find('label');
      if lbl is TJSONObject then
      begin
        va := TJSONObject(lbl).Find('valueAnimation');
        { only a bar counts (BarView's setLabelValueAnimation): every other
          series' labels fade whatever the key says [Batch 92] }
        r.LabelValueAnim := (t = 'bar') and (va <> nil)
          and (va.JSONType = jtBoolean) and va.AsBoolean;
      end;
      { THE MARKERS' MODELS: MarkerModel.isAnimationEnabled is the marker's
        `animation` and the host's isAnimationEnabled [Batch 92] }
      r.MarkLine := TyAnimNoModel;
      r.MarkPoint := TyAnimNoModel;
      if r.Enabled then
      begin
        mk := TJSONObject(ser).Find('markLine');
        if mk is TJSONObject then
        begin
          r.MarkLine := TyAnimComponentModel(mk, FOption.Root, 'markLine');
          r.MarkLine.Payload := FAnimPayload;
          r.MarkLine.HasPayload := FAnimHasPayload;
        end;
        mk := TJSONObject(ser).Find('markPoint');
        if mk is TJSONObject then
        begin
          r.MarkPoint := TyAnimComponentModel(mk, FOption.Root, 'markPoint');
          r.MarkPoint.Payload := FAnimPayload;
          r.MarkPoint.HasPayload := FAnimHasPayload;
        end;
      end;
    end;
    r.BaseHoriz := (FBindings[slot].BaseAxis = nil)
      or FBindings[slot].BaseAxis.Horizontal;
    { A BAR RACE: the base axis' model for the place along it, and the
      render's changeAxisOrder for every bar [Batch 135] }
    r.RtSort := RtSortOf(slot);
    if r.RtSort then
    begin
      r.RtAxis := TyAnimComponentModel(FOption.ComponentAt(
        FBindings[slot].BaseAxis.MainType, FBindings[slot].BaseAxis.ComponentIndex),
        FOption.Root, 'axis');
      r.RtAxis.Payload := FAnimPayload;
      r.RtAxis.HasPayload := FAnimHasPayload;
    end;
    r.ChangeOrder := FAnimRtChange;
    { AN UPDATE'S VIEW [Batch 90] }
    r.SeriesType := t;
    { the universal transition [Batch 136] }
    TyUtSeriesInfo(r, FOption.Root, FOption.ComponentId('series', si));
    if si <= High(viewKeys) then r.ViewKey := viewKeys[si]
    else r.ViewKey := 'x:' + IntToStr(si);
    { brand new: a key no old view has [Batch 97] }
    if (si <= High(FAnimFresh)) and FAnimFresh[si] then r.ViewKey := 'n:' + r.ViewKey;
    if (slot <= High(FStores)) and (FStores[slot] <> nil) then
      AnimRowKeys(FStores[slot], r.Keys, r.Raws);
    { the groups of its rows [Batch 137] and their child groups [Batch 138] }
    utk := TyUtSeriesKeysOf(r.Model.Own, FOption.Root, t, FOption.ComponentId('series', si));
    r.UtGroupIds := TyUtRowGroups(utk, r.Raws);
    r.UtChildGroupIds := TyUtRowChildGroups(utk, r.Raws);
    if t = TyPieSeriesTypeName then
    begin
      v := TyAnimGetShallow(r.Model, 'animationTypeUpdate');
      r.PieExpandAlways := (v.Kind = aokString) and (v.Str = 'expansion');
      v := TyAnimGetShallow(r.Model, 'animationType');
      r.PieScale := (v.Kind = aokString) and (v.Str = 'scale');
      { A FIRST RENDER'S SHARED START: the first slice's whose start is a
        number (PieView.ts:248-256) }
      if (slot <= High(FPies)) and FPies[slot].Valid then
        for k := 0 to High(FPies[slot].Sectors) do
          if not IsNan(FPies[slot].Sectors[k].StartRad) then
          begin
            r.HasPieStart := True;
            r.PieStart := FPies[slot].Sectors[k].StartRad;
            Break;
          end;
    end;
    Result[si] := r;
  end;
end;

procedure TTyAdvanceChart.AnimAfterBuild;
begin
  if FAnimPending then
  begin
    if AnimAllowed then
    begin
      FAnimPending := False;
      if FAnim = nil then FAnim := TTyAnimation.Create;
      if FAnimSet = nil then FAnimSet := TTyChartAnimSet.Create(FAnim);
      { AN UPDATE when there was a render before, an entry otherwise
        [Batch 90] }
      if FAnimPrev.Valid then
      begin
        { the views alive after it: an old one that is not among them was
          disposed [Batch 99] }
        FAnimPrev.AliveKeys := AnimAliveKeys;
        FAnimSet.ArmUpdate(FPaintList, AnimSeriesInfo, FAnimPrev);
      end
      else
      begin
        FAnimSet.Clear;
        FAnimSet.Arm(FPaintList, AnimSeriesInfo);
      end;
      { THE AXES: a full update of the same option renders the same axis
        views again and groupTransitions them; a new option's are new views,
        which never do (probed: under notMerge only the series move)
        [Batch 96] }
      { A MERGE keeps its axis models and their views: the same groupTransition,
        an axis whose model is new (replaced, its type changed) excepted
        [Batch 99] }
      { THE INIT SORT'S RENDER is laid out as it lands, no groupTransition
        (CartesianAxisView: isInitialSortFromBarRacing) [Batch 135] }
      if FAnimPrev.Valid and (FAnimPrev.FullUpdate or FAnimPrev.Merge)
        and (FAnimOldBuild <> nil) and (FAnimRtChange <> 2) then
        AxisAnimArm(FAnimOldBuild, FBuild)
      else
        AxisAnimDrop;
      FAnimRtChange := 0;
      FAnimFull := False;
      FAnimMerge := False;
      FAnimHasPayload := False;
      AnimDropPrev;
      { the views are paired: __requireNewView works once }
      FAnimFresh := nil;
      FAnimFreshAxes := nil;
      { THE FLUSH: upstream's setOption ends with a synchronous update, so
        every clip it made starts NOW and this same paint shows the from
        values. A step on the next tick would shift every timeline by up
        to 16 ms. It waits for the states (AnimFlushArmed). }
      FAnimFlush := True;
    end
    else if FAnimMode = camOff then
    begin
      FAnimPending := False;
      FAnimFull := False;
      FAnimMerge := False;
      FAnimHasPayload := False;
      AnimDropPrev;
      FAnimFresh := nil;
      FAnimFreshAxes := nil;
    end;
  end;
  FAnimStBind := nil;
  { A LIST WAITING FOR ITS ARMING is drawn as laid out: the proxies are the
    old render's, keyed by the old rows [Batch 90] }
  if FAnimPending then
    FAnimBind := nil
  else if (FAnimSet <> nil) and (FAnimSet.Count > 0) then
    FAnimBind := FAnimSet.Bind(FPaintList)
  else
    FAnimBind := nil;
end;

procedure TTyAdvanceChart.AnimFlushArmed;
begin
  if not FAnimFlush then Exit;
  FAnimFlush := False;
  if FAnim = nil then Exit;
  FAnim.Update(AnimClock, True);
  FAnimLive := FAnim.ClipCount > 0;
  FAnimContinuous := FAnimLive and AnimLoopOnly;
  AnimArmTimer;
end;

procedure TTyAdvanceChart.AnimArmTimer;
begin
  if (FAnimLive or PtrLive or LegLive or LoadLive or VmLive_ or ProgLive or GfxLive
    or CuLive or TlLive)
    and IsNan(FAnimNow)
    and not (csDesigning in ComponentState) then
  begin
    if FAnimTimer = nil then
    begin
      FAnimTimer := TTimer.Create(nil);
      FAnimTimer.Enabled := False;
      FAnimTimer.Interval := 16;
      FAnimTimer.OnTimer := @AnimTimerFired;
    end;
    FAnimTimer.Enabled := True;
  end
  else if FAnimTimer <> nil then
    FAnimTimer.Enabled := False;
end;

procedure TTyAdvanceChart.AnimTimerFired(Sender: TObject);
begin
  AnimTick(AnimClock);
end;

{ ==================== the bar race (realtimeSort) [Batch 135] ==================== }

function TTyAdvanceChart.RtSortOf(ASlot: Integer): Boolean;
var s: TJSONObject;
begin
  Result := False;
  if (ASlot < 0) or (ASlot > High(FBindings)) then Exit;
  { shouldRealtimeSort: realtimeSort (the series' own, ignoreParent), a
    category base axis, a cartesian2d }
  if (FBindings[ASlot].SeriesType <> 'bar') or not FBindings[ASlot].Resolved
    or not FBindings[ASlot].HasAxes or (FBindings[ASlot].Cart = nil)
    or (FBindings[ASlot].BaseAxis = nil) or (FBindings[ASlot].ValueAxis = nil) then Exit;
  if not (FBindings[ASlot].BaseAxis.Scale is TTyOrdinalScale) then Exit;
  { _renderLarge has no race }
  if LargeKindOf(ASlot) <> lgkNone then Exit;
  s := StSeriesNode(FBindings[ASlot].SeriesIndex);
  Result := (s <> nil) and JsTruthy(s.Find('realtimeSort'));
end;

function TTyAdvanceChart.RtKeyOf(ASlot: Integer; const AViewKeys: TTyStringArray): string;
var si: Integer;
begin
  si := FBindings[ASlot].SeriesIndex;
  if (si >= 0) and (si <= High(AViewKeys)) then Result := AViewKeys[si]
  else Result := 'x:' + IntToStr(si);
  Result := Result + #1 + FBindings[ASlot].SeriesType;
end;

function TTyAdvanceChart.AxisByTick(AAxis: TTyAxis): TTyIntegerArray;
begin
  Result := nil;
  if (AAxis <> nil) and (AAxis.Scale is TTyOrdinalScale)
    and TTyOrdinalScale(AAxis.Scale).Sorted then
    Result := TTyOrdinalScale(AAxis.Scale).ByTick;
end;

procedure TTyAdvanceChart.RtApplySortInfos;
var
  g, a: Integer;
  gb: TTyGridBuild;

  procedure Apply(AAxis: TTyAxis);
  var
    node, si, arr: TJSONData;
    ords: TTyIntegerArray;
    k: Integer;
  begin
    if (AAxis = nil) or not (AAxis.Scale is TTyOrdinalScale) then Exit;
    node := FOption.ComponentAt(AAxis.MainType, AAxis.ComponentIndex);
    si := nil;
    if node is TJSONObject then si := TJSONObject(node).Find('categorySortInfo');
    { setSortInfo(axis.model.get('categorySortInfo')): none drops it }
    if not (si is TJSONObject) then
    begin
      TTyOrdinalScale(AAxis.Scale).SetSortInfo(nil, False);
      Exit;
    end;
    ords := nil;
    arr := TJSONObject(si).Find('ordinalNumbers');
    if arr is TJSONArray then
    begin
      SetLength(ords, arr.Count);
      for k := 0 to arr.Count - 1 do
        if (TJSONArray(arr).Items[k].JSONType = jtNumber)
          and not IsNan(TJSONArray(arr).Items[k].AsFloat) then
          ords[k] := Trunc(TJSONArray(arr).Items[k].AsFloat)
        else
          ords[k] := -1;
    end;
    TTyOrdinalScale(AAxis.Scale).SetSortInfo(ords, True);
  end;

begin
  if (FBuild = nil) or (FOption = nil) then Exit;
  for g := 0 to FBuild.GridCount - 1 do
  begin
    gb := FBuild.Grid(g);
    for a := 0 to gb.XAxisCount - 1 do Apply(gb.XAxis(a));
    for a := 0 to gb.YAxisCount - 1 do Apply(gb.YAxis(a));
  end;
end;

function TTyAdvanceChart.CategorySortInfoText(const AMainType: string;
  AIndex: Integer): string;
var node, si, arr: TJSONData;
begin
  Result := 'null';
  if FOption = nil then Exit;
  node := FOption.ComponentAt(AMainType, AIndex);
  if not (node is TJSONObject) then Exit;
  si := TJSONObject(node).Find('categorySortInfo');
  if not (si is TJSONObject) then Exit;
  arr := TJSONObject(si).Find('ordinalNumbers');
  if arr <> nil then Result := arr.AsJSON;
end;

function TTyAdvanceChart.RtCompare(A, B: Integer): Integer;
var d: Double;
begin
  { b.mappedValue - a.mappedValue: not a number is 0 to V8's sort }
  d := FRtLens[B] - FRtLens[A];
  if d < 0 then Result := -1
  else if d > 0 then Result := 1
  else Result := 0;
end;

{ the payload's ordinalNumbers: the rows' ordinals in the order of
  _dataSort -- every row by its mapped value, descending, V8's stable sort }
function RtOrdinalsJson(const AOrds: TTyDoubleArray; const AIdx: TTyIntegerArray): string;
var k: Integer;
begin
  Result := '';
  for k := 0 to High(AIdx) do
  begin
    if k > 0 then Result := Result + ',';
    if IsNan(AOrds[AIdx[k]]) then Result := Result + 'null'
    else Result := Result + TyJsNumberToString(AOrds[AIdx[k]]);
  end;
end;

procedure TTyAdvanceChart.RtRenderPass;
var
  slot, k, n, baseCol, valCol: Integer;
  keys, live: TTyStringArray;
  key: string;
  st: TTyDataStore;
  ords: TTyDoubleArray;
  idx: TTyIntegerArray;
  base: TTyAxis;
  queued: Boolean;
begin
  if (FBuild = nil) or (FOption = nil) then Exit;
  keys := AnimViewKeys;
  live := nil;
  for slot := 0 to High(FBindings) do
  begin
    if FBindings[slot].SeriesType <> 'bar' then Continue;
    key := RtKeyOf(slot, keys);
    { a view the legend took away: _clear, its first frame again }
    if FBindings[slot].Hidden then Continue;
    SetLength(live, Length(live) + 1);
    live[High(live)] := key;
    if not RtSortOf(slot) then Continue;
    st := nil;
    if slot <= High(FStores) then st := FStores[slot];
    { no data yet: it waits for some }
    if (st = nil) or (st.Count = 0) then Continue;
    queued := False;
    for k := 0 to High(FRtInit) do
      if FRtInit[k] = key then queued := True;
    for k := 0 to High(FRtQueueInit) do
      if FRtQueueInit[k] = key then queued := True;
    if queued then Continue;
    { _dispatchInitSort: the rows by the value on the other axis }
    base := FBindings[slot].BaseAxis;
    baseCol := -1;
    valCol := -1;
    if Length(st.DimsOfCoord(base.Dim)) > 0 then baseCol := st.DimsOfCoord(base.Dim)[0];
    if Length(st.DimsOfCoord(FBindings[slot].ValueAxis.Dim)) > 0 then
      valCol := st.DimsOfCoord(FBindings[slot].ValueAxis.Dim)[0];
    if (baseCol < 0) or (valCol < 0) then Continue;
    n := st.Count;
    SetLength(ords, n);
    SetLength(FRtLens, n);
    SetLength(idx, n);
    for k := 0 to n - 1 do
    begin
      ords[k] := st.Get(baseCol, k);
      FRtLens[k] := st.Get(valCol, k);
      idx[k] := k;
    end;
    TyJsArraySort(idx, @RtCompare);
    SetLength(FRtQueue, Length(FRtQueue) + 1);
    FRtQueue[High(FRtQueue)] := '{"type":"changeAxisOrder","componentType":"'
      + base.MainType + '","isInitSort":true,"axisId":' + IntToStr(base.ComponentIndex)
      + ',"sortInfo":{"ordinalNumbers":[' + RtOrdinalsJson(ords, idx) + ']}}';
    SetLength(FRtQueueInit, Length(FRtQueue));
    FRtQueueInit[High(FRtQueueInit)] := key;
  end;
  { the views still shown keep their state; the rest start over }
  n := 0;
  for k := 0 to High(FRtInit) do
  begin
    queued := False;
    for slot := 0 to High(live) do
      if live[slot] = FRtInit[k] then queued := True;
    if not queued then Continue;
    FRtInit[n] := FRtInit[k];
    Inc(n);
  end;
  SetLength(FRtInit, n);
end;

procedure TTyAdvanceChart.RtRendered;
var
  slot, k, n, i, cats, baseCol, rawIdx, row, si: Integer;
  keys: TTyStringArray;
  key, ordJson: string;
  st: TTyDataStore;
  base: TTyAxis;
  sc: TTyOrdinalScale;
  ords, byRow: TTyDoubleArray;
  idx, elAt: TTyIntegerArray;
  el: TTyChartElement;
  p: TTyChartAnimProxy;
  last, v, t, tMax: Double;
  known, ordMoved, differs: Boolean;
  e: TTyRange;
  minValue: Double;
  minBits: Int64;
begin
  { a layout still to come reads its own frame }
  if (FBuild = nil) or (FOption = nil) or (FPaintList = nil) or FDirty then Exit;
  { Number.MIN_VALUE, the least subnormal }
  minBits := 1;
  Move(minBits, minValue, SizeOf(Double));
  keys := nil;
  for slot := 0 to High(FBindings) do
  begin
    if FBindings[slot].Hidden or not RtSortOf(slot) then Continue;
    if keys = nil then keys := AnimViewKeys;
    key := RtKeyOf(slot, keys);
    { a first frame has no listener yet }
    known := False;
    for k := 0 to High(FRtInit) do
      if FRtInit[k] = key then known := True;
    if not known then Continue;
    st := nil;
    if slot <= High(FStores) then st := FStores[slot];
    if (st = nil) or (st.Count = 0) then Continue;
    base := FBindings[slot].BaseAxis;
    sc := TTyOrdinalScale(base.Scale);
    if Length(st.DimsOfCoord(base.Dim)) = 0 then Continue;
    baseCol := st.DimsOfCoord(base.Dim)[0];
    si := FBindings[slot].SeriesIndex;
    n := st.Count;
    { orderMapping: the bar's CURRENT length -- |height| on a horizontal
      base axis, |width| on a vertical one -- its proxy's while it moves;
      no bar, or not a number, is 0 }
    SetLength(elAt, n);
    for i := 0 to n - 1 do elAt[i] := -1;
    for i := 0 to FPaintList.Count - 1 do
    begin
      el := FPaintList.Element(i);
      if (el.Anim.Role = carBar) and (el.Anim.Series = si)
        and (el.Anim.Index >= 0) and (el.Anim.Index < n) then
        elAt[el.Anim.Index] := i;
    end;
    SetLength(byRow, n);
    for i := 0 to n - 1 do
    begin
      byRow[i] := 0;
      if elAt[i] < 0 then Continue;
      el := FPaintList.Element(elAt[i]);
      p := nil;
      if FAnimSet <> nil then p := FAnimSet.Find(si, i, 'bar');
      if base.Horizontal then
      begin
        if p <> nil then v := p.Num('shape.height') else v := el.Anim.G[3];
      end
      else
      begin
        if p <> nil then v := p.Num('shape.width') else v := el.Anim.G[2];
      end;
      if IsNan(v) then v := 0;
      byRow[i] := Abs(v);
    end;
    { _isOrderChangedWithinSameData: tick by tick, a value above the one
      before; a tick with no bar is Number.MIN_VALUE }
    ordMoved := False;
    last := MaxDouble;
    cats := sc.CategoryCount;
    for k := 0 to cats - 1 do
    begin
      v := sc.TickToOrdinal(k);
      rawIdx := -1;
      if not IsNan(v) then rawIdx := st.RawIndexOfOrdinal(baseCol, Trunc(v));
      if rawIdx < 0 then v := minValue
      else
      begin
        row := st.IndexOfRawIndex(rawIdx);
        if row < 0 then v := 0 else v := byRow[row];
      end;
      if v > last then
      begin
        ordMoved := True;
        Break;
      end;
      last := v;
    end;
    if not ordMoved then Continue;
    { _dataSort over the rows }
    SetLength(ords, n);
    SetLength(FRtLens, n);
    SetLength(idx, n);
    for i := 0 to n - 1 do
    begin
      ords[i] := st.Get(baseCol, i);
      FRtLens[i] := byRow[i];
      idx[i] := i;
    end;
    TyJsArraySort(idx, @RtCompare);
    { _isOrderDifferentInView: inside the extent, a tick whose ordinal
      changed }
    differs := False;
    e := sc.GetExtent;
    t := Math.Max(Double(0), e.Start);
    tMax := Math.Min(e.Stop, Double(cats - 1));
    while t <= tMax do
    begin
      if (Frac(t) <> 0) or (t >= n) then
      begin
        differs := True;
        Break;
      end;
      v := sc.TickToOrdinal(t);
      if IsNan(ords[idx[Trunc(t)]]) or IsNan(v) or (ords[idx[Trunc(t)]] <> v) then
      begin
        differs := True;
        Break;
      end;
      t := t + 1;
    end;
    if not differs then Continue;
    ordJson := RtOrdinalsJson(ords, idx);
    SetLength(FRtQueue, Length(FRtQueue) + 1);
    FRtQueue[High(FRtQueue)] := '{"type":"changeAxisOrder","componentType":"'
      + base.MainType + '","axisId":' + IntToStr(base.ComponentIndex)
      + ',"sortInfo":{"ordinalNumbers":[' + ordJson + ']}}';
    SetLength(FRtQueueInit, Length(FRtQueue));
    FRtQueueInit[High(FRtQueueInit)] := '';
  end;
end;

procedure TTyAdvanceChart.RtFlushQueue;
var
  payload, key: string;
begin
  if FRtFlushing then Exit;
  FRtFlushing := True;
  try
    while Length(FRtQueue) > 0 do
    begin
      payload := FRtQueue[0];
      key := FRtQueueInit[0];
      Delete(FRtQueue, 0, 1);
      Delete(FRtQueueInit, 0, 1);
      { the view's first frame is over: its listener is on from this render }
      if key <> '' then
      begin
        SetLength(FRtInit, Length(FRtInit) + 1);
        FRtInit[High(FRtInit)] := key;
      end;
      DispatchAction(payload);
    end;
  finally
    FRtFlushing := False;
  end;
end;

procedure TTyAdvanceChart.DoChangeAxisOrder(APayload: TJSONObject);
var
  main: string;
  d, si: TJSONData;
  ev: TJSONObject;
  idx: TTyIntegerArray;
  i, n, c: Integer;
  ax: TTyAxis;
  node: TJSONData;

  procedure Add(AIndex: Integer);
  var z: Integer;
  begin
    if (AIndex < 0) or (AIndex >= c) then Exit;
    for z := 0 to High(idx) do
      if idx[z] = AIndex then Exit;
    SetLength(idx, Length(idx) + 1);
    idx[High(idx)] := AIndex;
  end;

  function Wanted(AData: TJSONData; const AText: string): Boolean;
  var z: Integer;
  begin
    Result := False;
    if AData is TJSONArray then
    begin
      for z := 0 to AData.Count - 1 do
        if (TJSONArray(AData).Items[z].JSONType in [jtString, jtNumber])
          and (TJSONArray(AData).Items[z].AsString = AText) then Exit(True);
    end
    else if AData.JSONType in [jtString, jtNumber] then
      Result := AData.AsString = AText;
  end;

begin
  { payload.componentType || 'series' }
  main := 'series';
  d := APayload.Find('componentType');
  if JsTruthy(d) and (d.JSONType = jtString) then main := d.AsString;
  si := APayload.Find('sortInfo');
  { eachComponent with the payload as the query: <main>Index, else <main>Id,
    else <main>Name when one is written -- the payload's axisId is none of
    them -- else every component of the type }
  idx := nil;
  c := FOption.ComponentCount(main);
  d := APayload.Find(main + 'Index');
  if (d <> nil) and (d.JSONType <> jtNull) then
  begin
    if d is TJSONArray then
    begin
      for i := 0 to d.Count - 1 do
        if TJSONArray(d).Items[i].JSONType = jtNumber then
          Add(Trunc(TJSONArray(d).Items[i].AsFloat));
    end
    else if d.JSONType = jtNumber then Add(Trunc(d.AsFloat));
  end
  else
  begin
    d := APayload.Find(main + 'Id');
    if (d <> nil) and (d.JSONType <> jtNull) then
    begin
      for i := 0 to c - 1 do
        if (ComponentModelId(main, i) <> '') and Wanted(d, ComponentModelId(main, i)) then Add(i);
    end
    else
    begin
      d := APayload.Find(main + 'Name');
      if (d <> nil) and (d.JSONType <> jtNull) then
      begin
        for i := 0 to c - 1 do
          if Wanted(d, ComponentModelName(main, i)) then Add(i);
      end
      else
        for i := 0 to c - 1 do Add(i);
    end;
  end;
  { axis.setCategorySortInfo: a category axis only, its model's option
    takes the info as it is }
  if JsTruthy(si) and ((main = 'xAxis') or (main = 'yAxis')) and (FBuild <> nil) then
    for n := 0 to High(idx) do
    begin
      ax := FBuild.Axis(main, idx[n]);
      if (ax = nil) or not (ax.Scale is TTyOrdinalScale) then Continue;
      node := FOption.ComponentAt(main, idx[n]);
      if not (node is TJSONObject) then Continue;
      if TJSONObject(node).Find('categorySortInfo') <> nil then
        TJSONObject(node).Delete('categorySortInfo');
      TJSONObject(node).Add('categorySortInfo', si.Clone);
    end;
  { the update renders for the order: 2 for the init sort }
  if JsTruthy(APayload.Find('isInitSort')) then FRtChange := 2 else FRtChange := 1;
  try
    FullUpdate;
  finally
    FRtChange := 0;
  end;
  { the event: the payload, its type the event's }
  ev := TJSONObject(APayload.Clone);
  try
    ev.Strings['type'] := 'changeaxisorder';
    EmitPayloadEvent('changeaxisorder', ev.AsJSON);
  finally
    ev.Free;
  end;
end;

procedure TTyAdvanceChart.AnimTick(ANowMs: Double);
var ran, was: Boolean;
begin
  { ONE FRAME: zrender's clips step, then the chart's _onframe draws its
    chunks, then the flush -- `rendered` once for the frame, and `finished`
    when nothing is left moving or to draw [Batch 119] }
  ran := ProgFrame(False);
  was := FAnimLive;
  AnimTickBody(ANowMs);
  if ran then AnimArmTimer;
  if ran or was then
  begin
    { [F4b] the frame's flush: what it drew is no longer dirty }
    FZrDirty := False;
    FTipPaintedKey := TipStateKey;
    EmitRendered(0);
    if ProgIdle then EmitPlain('finished');
    { the bar race's `rendered` listeners read the frame [Batch 135] }
    RtRendered;
    RtFlushQueue;
  end;
end;

procedure TTyAdvanceChart.AnimTickBody(ANowMs: Double);
var ptrWas: Boolean;
begin
  { the pointer's own driver first [Batch 92] }
  if FPtrAnim <> nil then
  begin
    ptrWas := FPtrAnim.ClipCount > 0;
    FPtrAnim.Update(ANowMs);
    if ptrWas then
    begin
      InvalidateFrame;
      if (FPtrAnim.ClipCount = 0) and not FAnimLive then AnimArmTimer;
    end;
  end;
  { the legend's scroll [Batch 98]: a frame of the static layer }
  if LegLive then
  begin
    FLegAnim.Update(ANowMs);
    DropStatic;
    InvalidateFrame;
    if not LegLive and not FAnimLive then AnimArmTimer;
  end;
  { the spinner's own driver: a frame of the dynamic layer [Batch 106] }
  if LoadLive then
  begin
    FLoadAnim.Update(ANowMs);
    InvalidateFrame;
  end;
  { the graphic elements' transitions: frames of the static layer
    [Batch 122] }
  if GfxLive then
  begin
    FGfxAnim.Update(ANowMs);
    DropStatic;
    InvalidateFrame;
    if not GfxLive and not FAnimLive then AnimArmTimer;
  end;
  { the custom elements' transitions: frames of the static layer
    [Batch 124] }
  if CuLive then
  begin
    FCuAnim.Update(ANowMs);
    DropStatic;
    InvalidateFrame;
    if not CuLive and not FAnimLive then AnimArmTimer;
  end;
  { the timeline's checkpoint, its progress line and its hover
    transitions: frames of the static layer [Batch 129] }
  if TlLive then
  begin
    FTlAnim.Update(ANowMs);
    DropStatic;
    InvalidateFrame;
    if not TlLive and not FAnimLive then AnimArmTimer;
  end;
  { the visualMap indicator's slide: a frame of the static layer [Batch 116] }
  if VmLive_ then
  begin
    FVmAnim.Update(ANowMs);
    DropStatic;
    InvalidateFrame;
    if not VmLive_ and not FAnimLive then AnimArmTimer;
  end;
  if FAnim = nil then Exit;
  FAnim.Update(ANowMs);
  { a fade that ended removed its element [Batch 90] }
  if FAnimSet <> nil then FAnimSet.Purge;
  { a treemap's wrap that ended: renderFinally [Batch 115] }
  TmWrapCheck;
  if FAnimLive and (FAnim.ClipCount = 0) then
  begin
    { AT REST: the series go back into the static layer, drawn once more
      at the values they rest at }
    FAnimLive := False;
    FAnimContinuous := False;
    AnimArmTimer;
    DropStatic;
  end
  else if FAnimLive and not FAnimContinuous and AnimLoopOnly then
  begin
    { ONLY LOOPS LEFT: the rest settles into the static layer [Batch 92] }
    FAnimContinuous := True;
    DropStatic;
  end;
  InvalidateFrame;
end;

{ ==================== the axis pointer's slide [Batch 92] ====================

  BaseAxisPointer.render: the first show is direct; a move -- the pointer's
  props differing from the last ones (propsEqual) -- is updateProps on the
  pointer's model when determineAnimation says so, else a stop and attr.
  The model is the axis' axisPointer over the tooltip's (makeAxisPointerModel:
  animation 'auto', 200 ms, exponentialOut), the root below. A hidden pointer
  keeps its place: the next show slides from it. The label goes with the
  pointer (upstream tweens its x / y with the same timing). }

function TTyAdvanceChart.PtrLive: Boolean;
begin
  Result := (FPtrAnim <> nil) and (FPtrAnim.ClipCount > 0);
end;

function TTyAdvanceChart.PtrKeyOf(AAxis: TTyAxis): string;
begin
  Result := AAxis.MainType + IntToStr(AAxis.ComponentIndex);
end;

procedure TTyAdvanceChart.PtrAnimDrop;
var i: Integer;
begin
  if FPtrProxies <> nil then
  begin
    for i := 0 to FPtrProxies.Count - 1 do TObject(FPtrProxies[i]).Free;
    FPtrProxies.Clear;
  end;
end;

{ propsEqual: every key of AProps at the value AFinal holds }
function PtrPropsSame(const AFinal, AProps: TTyAnimProps): Boolean;
var i, k: Integer; hit: Boolean;
begin
  Result := False;
  for i := 0 to High(AProps) do
  begin
    hit := False;
    for k := 0 to High(AFinal) do
      if AFinal[k].Key = AProps[i].Key then
      begin
        if not TyAnimValueSame(AFinal[k].Value, AProps[i].Value) then Exit;
        hit := True;
        Break;
      end;
    if not hit then Exit;
  end;
  Result := True;
end;

function TTyAdvanceChart.PtrModelOf(const AHit: TTyAxisHit; out AOwn: TJSONObject): TTyAnimModel;
const
  cKeys: array[0..3] of string = ('animation', 'animationDurationUpdate',
    'animationEasingUpdate', 'animationDelayUpdate');
var
  axisNode, tip, ap, tap, d: TJSONData;
  k: Integer;
begin
  { the axis' own axisPointer over the tooltip's, key by key }
  AOwn := TJSONObject.Create;
  ap := nil;
  tap := nil;
  axisNode := FOption.ComponentAt(AHit.Axis.MainType, AHit.Axis.ComponentIndex);
  if axisNode is TJSONObject then ap := TJSONObject(axisNode).Find('axisPointer');
  if FOption.Root is TJSONObject then
  begin
    tip := TJSONObject(FOption.Root).Find('tooltip');
    if (tip is TJSONArray) and (tip.Count > 0) then tip := tip.Items[0];
    if tip is TJSONObject then tap := TJSONObject(tip).Find('axisPointer');
  end;
  for k := 0 to High(cKeys) do
  begin
    d := nil;
    if ap is TJSONObject then d := TJSONObject(ap).Find(cKeys[k]);
    if ((d = nil) or (d.JSONType = jtNull)) and (tap is TJSONObject) then
      d := TJSONObject(tap).Find(cKeys[k]);
    if (d <> nil) and (d.JSONType <> jtNull) then AOwn.Add(cKeys[k], d.Clone);
  end;
  Result := TyAnimComponentModel(AOwn, FOption.Root, 'tooltip.axisPointer');
end;

function TTyAdvanceChart.PtrMoves(const AHit: TTyAxisHit; const AModel: TTyAnimModel): Boolean;
var
  v: TTyAnimOptValue;
  isCat: Boolean;
  s, cnt: Integer;
begin
  { determineAnimation (BaseAxisPointer.ts:211-242) }
  isCat := AHit.Axis.Scale is TTyOrdinalScale;
  if (not AHit.Spec.Snap) and not isCat then Exit(False);
  v := TyAnimGetShallow(AModel, 'animation');
  if (v.Kind in [aokUndefined, aokNull]) or ((v.Kind = aokString) and (v.Str = 'auto')) then
  begin
    if isCat and (AHit.Axis.BandWidth > 15) then Exit(True);
    if AHit.Spec.Snap then
    begin
      { the series on the axis' coordinate system, all their data }
      cnt := 0;
      for s := 0 to High(FBindings) do
        if (s <= High(FStores)) and (FStores[s] <> nil)
          and ((FBindings[s].XAxis = AHit.Axis) or (FBindings[s].YAxis = AHit.Axis)) then
          Inc(cnt, FStores[s].Count);
      Exit(Abs(AHit.Axis.PxStart - AHit.Axis.PxStop) / cnt > 15);
    end;
    Exit(False);
  end;
  Result := (v.Kind = aokBool) and (v.Num <> 0);
end;

function TTyAdvanceChart.PtrProps(const AHit: TTyAxisHit; AAt: Double): TTyAnimProps;
var sh: TTyXYWH;
begin
  { CartesianAxisPointer's shapes: a line across the other axis' extent, or
    the band -- clamped to the axis, across the other axis as its extent
    runs [Batch 101]
    [Revised in batch 101: a category's band about the value, unclamped,
    from the plot's bottom (left) edge.] }
  if AHit.Spec.PointerType = aptShadow then
  begin
    if not PointerShadowShapeAt(AHit, AAt, sh) then sh := Default(TTyXYWH);
    Result := TyAnimProps([TyAnimProp('shape.x', TyAnimNum(sh.X)),
      TyAnimProp('shape.y', TyAnimNum(sh.Y)),
      TyAnimProp('shape.width', TyAnimNum(sh.W)),
      TyAnimProp('shape.height', TyAnimNum(sh.H))]);
  end
  else if AHit.Axis.Horizontal then
    Result := TyAnimProps([TyAnimProp('shape.x1', TyAnimNum(AAt)),
      TyAnimProp('shape.y1', TyAnimNum(AHit.Plot.Bottom)),
      TyAnimProp('shape.x2', TyAnimNum(AAt)),
      TyAnimProp('shape.y2', TyAnimNum(AHit.Plot.Top))])
  else
    Result := TyAnimProps([TyAnimProp('shape.x1', TyAnimNum(AHit.Plot.Left)),
      TyAnimProp('shape.y1', TyAnimNum(AAt)),
      TyAnimProp('shape.x2', TyAnimNum(AHit.Plot.Right)),
      TyAnimProp('shape.y2', TyAnimNum(AAt))]);
end;

procedure TTyAdvanceChart.PtrAnimSync;
var
  i, k: Integer;
  hit: TTyAxisHit;
  at: Double;
  key: string;
  p: TTyChartAnimProxy;
  props: TTyAnimProps;
  model: TTyAnimModel;
  own: TJSONObject;
begin
  { a mouse moves only over a live window: every mode but camOff }
  if (FAnimMode = camOff) or (csDesigning in ComponentState) then Exit;
  for i := 0 to High(FTipHits) do
  begin
    hit := FTipHits[i];
    if (hit.Axis = nil) or (hit.Spec.PointerType = aptNone) then Continue;
    { a polar pointer does not slide [Batch 111], nor a single's
      [Batch 118] }
    if (hit.Polar <> nil) or (hit.Single <> nil) then Continue;
    at := hit.Axis.DataToCoord(PointerValue(hit), True);
    if IsNan(at) then Continue;
    key := PtrKeyOf(hit.Axis);
    props := PtrProps(hit, at);
    if FPtrProxies = nil then FPtrProxies := TFPList.Create;
    if FPtrAnim = nil then FPtrAnim := TTyAnimation.Create;
    p := nil;
    for k := 0 to FPtrProxies.Count - 1 do
      if TTyChartAnimProxy(FPtrProxies[k]).Role = key then
      begin
        p := TTyChartAnimProxy(FPtrProxies[k]);
        Break;
      end;
    if p = nil then
    begin
      { THE FIRST SHOW IS DIRECT }
      p := TTyChartAnimProxy.Create(-1, -1, key);
      p.Animation := FPtrAnim;
      p.Attr(props);
      p.SetFinal(props);
      FPtrProxies.Add(p);
      Continue;
    end;
    { propsEqual: nothing new, nothing done }
    if PtrPropsSame(p.Final, props) then Continue;
    model := PtrModelOf(hit, own);
    try
      p.SetFinal(props);
      if PtrMoves(hit, model) then
        TyUpdateProps(p, props, model, TyAnimCallNoIndex)
      else
      begin
        p.StopAnimation;
        p.Attr(props);
      end;
    finally
      own.Free;
    end;
  end;
  AnimArmTimer;
end;

function TTyAdvanceChart.PtrShadowNow(const AHit: TTyAxisHit;
  out AShape: TTyXYWH): Boolean;
var
  k: Integer;
  p: TTyChartAnimProxy;
  key: string;
begin
  { an export draws the pointer where it rests [Batch 106] }
  if (FPtrProxies <> nil) and (AHit.Axis <> nil) and not FExporting then
  begin
    key := PtrKeyOf(AHit.Axis);
    for k := 0 to FPtrProxies.Count - 1 do
    begin
      p := TTyChartAnimProxy(FPtrProxies[k]);
      if p.Role <> key then Continue;
      if p.AtFinal then Break;
      AShape.X := p.Num('shape.x');
      AShape.Y := p.Num('shape.y');
      AShape.W := p.Num('shape.width');
      AShape.H := p.Num('shape.height');
      if not (IsNan(AShape.X) or IsNan(AShape.Y) or IsNan(AShape.W)
        or IsNan(AShape.H)) then Exit(True);
      Break;
    end;
  end;
  Result := PointerShadowShape(AHit, AShape);
end;

function TTyAdvanceChart.PtrAt(const AHit: TTyAxisHit; AAt: Double): Double;
var
  k: Integer;
  p: TTyChartAnimProxy;
  key: string;
begin
  Result := AAt;
  if (FPtrProxies = nil) or (AHit.Axis = nil) or FExporting then Exit;
  key := PtrKeyOf(AHit.Axis);
  for k := 0 to FPtrProxies.Count - 1 do
  begin
    p := TTyChartAnimProxy(FPtrProxies[k]);
    if p.Role <> key then Continue;
    if p.AtFinal then Exit;
    if AHit.Spec.PointerType = aptShadow then
    begin
      if AHit.Axis.Horizontal then Result := p.Num('shape.x') + p.Num('shape.width') / 2
      else Result := p.Num('shape.y') + p.Num('shape.height') / 2;
    end
    else if AHit.Axis.Horizontal then Result := p.Num('shape.x1')
    else Result := p.Num('shape.y1');
    if IsNan(Result) then Result := AAt;
    Exit;
  end;
end;

function TTyAdvanceChart.AnimPointerClipCount: Integer;
begin
  if FPtrAnim = nil then Result := 0 else Result := FPtrAnim.ClipCount;
end;

function TTyAdvanceChart.AnimPointerProxy(const AKey: string): TTyChartAnimProxy;
var k: Integer;
begin
  Result := nil;
  if FPtrProxies = nil then Exit;
  for k := 0 to FPtrProxies.Count - 1 do
    if TTyChartAnimProxy(FPtrProxies[k]).Role = AKey then
      Exit(TTyChartAnimProxy(FPtrProxies[k]));
end;

function TTyAdvanceChart.AnimLoopOnly: Boolean;
var i: Integer;
begin
  Result := (FAnim <> nil) and (FAnim.ClipCount > 0);
  if not Result then Exit;
  for i := 0 to FAnim.ClipCount - 1 do
    if not FAnim.ClipAt(i).Loop then Exit(False);
end;

function TTyAdvanceChart.AnimPart(AContinuous: Boolean): TTyPaintList;
var
  frame: TTyPaintList;
  i, h: Integer;
  el: TTyChartElement;
  cont: Boolean;
begin
  frame := AnimFrame;
  if FAnimSplit = nil then FAnimSplit := TTyPaintList.Create;
  FAnimSplit.Clear;
  Result := FAnimSplit;
  if frame = nil then Exit;
  for i := 0 to frame.Count - 1 do
  begin
    el := frame.Element(i);
    { a ripple, an effect symbol, and a label hanging off one; a lines
      effect symbol, and every element of a lines series with a trail
      (its layer is redrawn every frame) [Batch 121] }
    cont := el.Anim.Role in [carRipple, carEffectSymbol, carLinesEffect];
    if (not cont) and (el.Datum.Kind = ctkSeries)
      and (LinesTrailAlpha(el.Datum.SeriesIndex) > 0) then cont := True;
    if (not cont) and (el.Anim.Role = carLabel) then
    begin
      h := el.Anim.HostPlus1 - 1;
      cont := (h >= 0) and (h < frame.Count)
        and (frame.Element(h).Anim.Role = carEffectSymbol);
    end;
    if cont = AContinuous then FAnimSplit.Add(el);
  end;
end;

function TTyAdvanceChart.AnimClipCount: Integer;
begin
  if FAnim = nil then Result := 0 else Result := FAnim.ClipCount;
end;

function TTyAdvanceChart.AnimLoopClipCount: Integer;
var i: Integer;
begin
  Result := 0;
  if FAnim = nil then Exit;
  for i := 0 to FAnim.ClipCount - 1 do
    if FAnim.ClipAt(i).Loop then Inc(Result);
end;

{ the states' own proxies ('st:' roles) are not the animations' [Batch 94] }
function IsStateOnlyProxy(P: TTyChartAnimProxy): Boolean;
begin
  Result := Copy(P.Role, 1, 3) = 'st:';
end;

function TTyAdvanceChart.AnimProxyCount: Integer;
var i: Integer;
begin
  Result := 0;
  if FAnimSet = nil then Exit;
  for i := 0 to FAnimSet.Count - 1 do
    if not IsStateOnlyProxy(FAnimSet.Item(i)) then Inc(Result);
end;

function TTyAdvanceChart.AnimProxy(AIndex: Integer): TTyChartAnimProxy;
var i, n: Integer;
begin
  Result := nil;
  if (FAnimSet = nil) or (AIndex < 0) then Exit;
  n := 0;
  for i := 0 to FAnimSet.Count - 1 do
  begin
    if IsStateOnlyProxy(FAnimSet.Item(i)) then Continue;
    if n = AIndex then Exit(FAnimSet.Item(i));
    Inc(n);
  end;
end;

function TTyAdvanceChart.AnimFindProxy(ASeries, AIndex: Integer;
  const ARole: string): TTyChartAnimProxy;
begin
  if FAnimSet = nil then Exit(nil);
  Result := FAnimSet.Find(ASeries, AIndex, ARole);
end;

function TTyAdvanceChart.AnimFindGhost(ASeries, AIndex: Integer;
  const ARole: string): TTyChartAnimProxy;
begin
  if FAnimSet = nil then Exit(nil);
  Result := FAnimSet.FindGhost(ASeries, AIndex, ARole);
end;

function TTyAdvanceChart.AnimStateProxy(ASeries, ARow: Integer;
  const APart: string): TTyChartAnimProxy;
var idx: Integer;
begin
  Result := nil;
  idx := StatePartIndex(ASeries, ARow, APart);
  if (idx >= 0) and (idx <= High(FAnimStBind)) then Result := FAnimStBind[idx];
end;

function TTyAdvanceChart.StatePartRecord(ASeries, ARow: Integer;
  const APart: string; out AEl: TTyStElement): Boolean;
var
  item: TTyStItem;
  idx, k: Integer;
begin
  AEl := Default(TTyStElement);
  Result := False;
  if APart = 'peer' then
  begin
    if not PeerStates(ASeries, ARow, item) then Exit;
    AEl := item.Host;
    Exit(True);
  end;
  if not ItemStates(ASeries, ARow, item) then Exit;
  if APart = 'host' then AEl := item.Host
  else if APart = 'label' then AEl := item.Label_
  else if APart = 'guide' then AEl := item.Guide
  else
  begin
    { a part: the one whose list index is the part's }
    idx := StatePartIndex(ASeries, ARow, APart);
    if idx < 0 then Exit;
    k := StInnerRaw(ASeries, ARow);
    if (k < 0) or (k > High(FSt[ASeries].PartIdx)) then Exit;
    for k := 0 to Min(High(FSt[ASeries].PartIdx[StInnerRaw(ASeries, ARow)]), High(item.Parts)) do
      if FSt[ASeries].PartIdx[StInnerRaw(ASeries, ARow)][k] = idx then
      begin
        AEl := item.Parts[k];
        Exit(True);
      end;
    Exit;
  end;
  Result := AEl.Exists;
end;

function TTyAdvanceChart.StatePartIndex(ASeries, ARow: Integer;
  const APart: string): Integer;
var slot, raw, idx, k, j, n: Integer;
begin
  Result := -1;
  if (ASeries < 0) or (ASeries > High(FSt)) or (FSt[ASeries].Kind = sskNone) then Exit;
  idx := -1;
  if APart = 'poly' then
  begin
    if Length(FSt[ASeries].RunIdx) > 0 then idx := FSt[ASeries].RunIdx[0];
  end
  else if APart = 'area' then
  begin
    if Length(FSt[ASeries].AreaIdx) > 0 then idx := FSt[ASeries].AreaIdx[0];
  end
  { [F2a] the second set of rows by its own index: 'edge', 'edgelabel',
    'edgepart<k>' }
  else if Copy(APart, 1, 4) = 'edge' then
  begin
    if (ARow < 0) or (ARow > High(FSt[ASeries].EdgeHostIdx)) then Exit;
    if APart = 'edge' then idx := FSt[ASeries].EdgeHostIdx[ARow]
    else if APart = 'edgelabel' then idx := FSt[ASeries].EdgeLabelIdx[ARow]
    else if (Copy(APart, 1, 8) = 'edgepart') and (ARow <= High(FSt[ASeries].EdgePartIdx)) then
    begin
      raw := StrToIntDef(Copy(APart, 9, MaxInt), -1);
      if (raw >= 0) and (raw <= High(FSt[ASeries].EdgePartIdx[ARow])) then
        idx := FSt[ASeries].EdgePartIdx[ARow][raw];
    end;
  end
  else
  begin
    slot := SlotOfSeries(ASeries);
    if (slot < 0) or (slot > High(FStores)) or (FStores[slot] = nil) then Exit;
    if (ARow < 0) or (ARow >= FStores[slot].Count) then Exit;
    raw := FStores[slot].GetRawIndex(ARow);
    if (raw < 0) or (raw > High(FSt[ASeries].HostIdx)) then Exit;
    if APart = 'host' then idx := FSt[ASeries].HostIdx[raw]
    else if APart = 'label' then idx := FSt[ASeries].LabelIdx[raw]
    else if APart = 'guide' then idx := FSt[ASeries].GuideIdx[raw]
    { [F2b] a gauge's arc; the k-th other path; a radar's polygon and its
      j-th symbol }
    else if APart = 'peer' then
    begin
      if raw <= High(FSt[ASeries].PeerHostIdx) then idx := FSt[ASeries].PeerHostIdx[raw];
    end
    else if (Copy(APart, 1, 4) = 'part') and (raw <= High(FSt[ASeries].PartIdx)) then
    begin
      k := StrToIntDef(Copy(APart, 5, MaxInt), -1);
      if (k >= 0) and (k <= High(FSt[ASeries].PartIdx[raw])) then
        idx := FSt[ASeries].PartIdx[raw][k];
    end
    else if ((APart = 'rarea') or (Copy(APart, 1, 4) = 'rsym'))
      and (raw <= High(FSt[ASeries].PartIdx)) and (FPaintList <> nil) then
    begin
      j := StrToIntDef(Copy(APart, 5, MaxInt), -1);
      n := 0;
      for k := 0 to High(FSt[ASeries].PartIdx[raw]) do
        if FPaintList.Element(FSt[ASeries].PartIdx[raw][k]).Anim.Role = carRadarArea then
        begin
          if APart = 'rarea' then idx := FSt[ASeries].PartIdx[raw][k];
        end
        else
        begin
          if n = j then idx := FSt[ASeries].PartIdx[raw][k];
          Inc(n);
        end;
    end;
  end;
  Result := idx;
end;

function TTyAdvanceChart.AnimGhostCount: Integer;
begin
  if FAnimSet = nil then Result := 0 else Result := FAnimSet.LiveGhostCount;
end;

function TTyAdvanceChart.AnimFrame: TTyPaintList;
begin
  if (FPaintList = nil) or ((Length(FAnimBind) = 0) and (Length(FAnimStBind) = 0)
    and ((FAnimSet = nil) or (FAnimSet.GhostCount = 0)) and not TmAnimAny) then
    Exit(FPaintList);
  if FAnimFrame = nil then FAnimFrame := TTyPaintList.Create;
  TyAnimBuildFrame(FPaintList, FAnimFrame, FAnimBind, FAnimSet, FAnimStBind);
  { a treemap's drill-down, its own wrap [Batch 115] }
  if TmAnimAny then TreemapFrame(FAnimFrame);
  Result := FAnimFrame;
end;

procedure TTyAdvanceChart.PaintDynamic(APainter: TTyPainter; const ARect: TRect;
  APPI: Integer; const AMeasurer: ITyTextMeasurer);
begin
  { AN EXPORT'S: the finished picture has no frame of an animation and no
    hover -- an option's own pointers, and the loading effect over all
    [Batch 106] }
  if FExporting then
  begin
    PaintAxisPointers(APainter, ARect, APPI, AMeasurer, OptionPointerHits);
    PaintLoading(APainter, ARect, APPI, AMeasurer);
    Exit;
  end;
  { WHAT IS DRAWN HERE IS COMPOSITED OVER the blitted static layer: BeginPaint
    fills its bitmap transparent and EndPaint blends it (TBGRABitmap.Draw with
    AOpaque = False), so an overlay painter adds ink without erasing what is
    underneath. That is what makes two painters onto one canvas correct.

    ANYTHING ADDED HERE MUST BE VISIBLE TO HasDynamicContent, or RenderCached
    skips the whole pass and the new thing is written, compiled and never
    drawn. That is the failure this body's empty version was left here to
    prevent, and the tooltip is the first thing to test it. }
  { THE SERIES IN MOTION, and the title over them: this frame's values,
    read from the proxies [Batch 89] }
  if FAnimContinuous then
    PaintTrail(APainter, AnimPart(True))
  else if FAnimLive then
  begin
    { the trail is the continuous phase's: an enter or an update in motion
      draws every series as it stands [Batch 121] }
    FreeAndNil(FTrailLayer);
    { the axes in their groupTransition under the series, as the static
      layer draws them [Batch 96] }
    if AxesDynamic then PaintAxes(APainter, APPI, AMeasurer, True);
    TyRenderPaintList(APainter, AnimFrame);
    { the parallel axes over the lines in motion [Batch 128] }
    PaintParallels(APainter, APPI, AMeasurer);
    PaintTitles(APainter);
  end;
  { THE POINTER UNDER THE HIGHLIGHT UNDER THE BOX. A shadow band drawn over
    the bars is the layer debt showing -- series marks live in the static
    layer, so the band cannot go beneath them -- and re-drawing the hovered
    marks on top of the band is what hides it. }
  { and before any pointer event, the ones the option shows itself
    [Batch 100] }
  if Length(FTipHits) > 0 then
    PaintAxisPointers(APainter, ARect, APPI, AMeasurer, FTipHits)
  else
    PaintAxisPointers(APainter, ARect, APPI, AMeasurer, OptionPointerHits);
  PaintEmphasis(APainter, APPI, FTipHits);
  { THE KEYBOARD'S RING over the marks and under the box [Batch 144] }
  PaintKbRing(APainter);
  { THE POINTER FIRST, THE BOX OVER IT. A tooltip with the pointer's own line
    drawn across it would read as two things at one depth. }
  PaintTooltip(APainter, ARect, APPI, AMeasurer);
  { THE LOADING EFFECT OVER EVERYTHING: upstream's mask is z 10000
    [Batch 106] }
  PaintLoading(APainter, ARect, APPI, AMeasurer);
end;

function TTyAdvanceChart.HasDynamicContent: Boolean;
begin
  { A REAL QUESTION NOW: is anything hovered. A second painter means allocating
    a BGRA bitmap the size of the control, filling it, blending it and freeing
    it -- roughly the 13 ms floor a frame has even with no axes -- so the
    answer has to be cheap and it has to be exact. It is deliberately not
    "would the tooltip draw": resolving the option cascade and the theme to
    find out costs more than the pass it would save. }
  Result := TyChartDatumValid(FTipDatum) or (Length(FTipHits) > 0)
    or FAnimLive or FTipShown or FLoadShown
    or ((not FOptPtrGone) and (Length(OptionPointerHits) > 0))
    { the keyboard's ring [Batch 144] }
    or FKbActive;
end;

procedure TTyAdvanceChart.DropStatic;
begin
  StaticDrop;
  FProgReuse := False;
  { AND THE LIST WITH IT. The two describe the same frame: the list is what
    the static pass added up to, so a kept list beside a dropped cache would
    answer questions about a picture no longer on screen. Not freed -- the
    next build reuses the object and only the answer is stale. }
  FPaintListValid := False;
end;

procedure TTyAdvanceChart.DropStaticKeepList;
var had: Boolean;
begin
  had := (FPaintList <> nil) and FPaintListValid;
  DropStatic;
  if had and (FLastPPI > 0) and not FExporting then
  begin
    BuildSeriesList(NewTextMeasurer(FLastPPI), FLastPPI);
    StaticDrop;
  end;
end;

procedure TTyAdvanceChart.PointerStateChanged;
begin
  { [F4b] the base class' pointer bookkeeping: a repaint, nothing marked }
  InvalidateFrameQuiet;
end;

procedure TTyAdvanceChart.RenderCached(ACanvas: TCanvas; const ARect: TRect;
  APPI: Integer);
var
  P: TTyPainter;
  R: TRect;
  w, h: Integer;
  measurer: ITyTextMeasurer;
begin
  { [F4b] the flush's start, for `rendered`'s elapsedTime }
  FPaintT0 := AnimClock;
  { THE DIRTY-RECT PATH [Batch 142]: the canvas holds the last frame, and
    only what changed is drawn on it }
  if FUseDirtyRect then
  begin
    DrPrepare(ARect, APPI);
    DrComposite(ACanvas, ARect);
    Exit;
  end;
  w := ARect.Right - ARect.Left;
  h := ARect.Bottom - ARect.Top;
  if (w <= 0) or (h <= 0) then Exit;
  R := Rect(0, 0, w, h);

  if FStatic = nil then FStatic := TTyPaintCache.Create;
  { PPI IS PART OF THE KEY and TTyPaintCache does not know it: NeedsRender only
    notices a size change, and a per-monitor DPI move can hand back the same
    size at a different PPI -- a chart drawn for 96 blitted onto a 192 window. }
  if APPI <> FStaticPPI then
  begin
    FStatic.Drop;
    FStaticPPI := APPI;
  end;
  { upstream's frame: the flags become state lists, and a changed element
    is a changed static layer [Batch 88] }
  if StApplyChanged then
  begin
    FStatic.Drop;
    { the states restyle the list: it is built again [Batch 119] }
    FProgReuse := False;
  end;

  if FStatic.NeedsRender(w, h) then
  begin
    measurer := NewTextMeasurer(APPI);
    P := TTyPainter.Create;
    try
      P.BeginPaint(FStatic.Canvas, R, APPI);
      PaintStatic(P, R, APPI, measurer);
      P.EndPaint;
    finally
      P.Free;
    end;
  end;
  FStatic.Blit(ACanvas);

  { A SECOND PAINTER ONLY WHEN THERE IS SOMETHING TO PUT IN IT. Creating one
    means allocating a BGRA bitmap the size of the control, filling it,
    blending it and freeing it -- roughly the 13 ms floor a frame has even with
    no axes, so paying it to draw nothing would give back most of what the
    cache just saved. }
  if HasDynamicContent then
  begin
    measurer := NewTextMeasurer(APPI);
    P := TTyPainter.Create;
    try
      P.BeginPaint(ACanvas, ARect, APPI);
      PaintDynamic(P, R, APPI, measurer);
      P.EndPaint;
    finally
      P.Free;
    end;
  end;
  { the update painted: `rendered` [Batch 119] }
  EmitFlush;
  { the bar race, as RenderTo's [Batch 135] }
  if FRtAfterRelayout then
  begin
    FRtAfterRelayout := False;
    RtRenderPass;
    RtRendered;
  end;
  RtFlushQueue;
end;

procedure TTyAdvanceChart.Paint;
begin
  { a paint is a frame: the toolbox's hover states land [Batch 125] -- a
    dirty-rect window's frame is its flush, and a paint that only
    composites is not one [Batch 142] }
  if not (csDesigning in ComponentState) and not FUseDirtyRect then TbFrame;
  { THE DESIGNER RENDERS STRAIGHT THROUGH, as TTyPanel's does: it repaints
    rarely and streams while it does, so a cache buys nothing there and is one
    more thing that can be holding a frame from before the last property
    change. }
  if csDesigning in ComponentState then
  begin
    RenderTo(Canvas, ClientRect, Font.PixelsPerInch);
    Exit;
  end;
  { A WINDOW'S PAINT: the one render camAuto animates [Batch 89] }
  FAnimWindow := True;
  try
    { the dirty-rect window: the clip composited [Batch 142] }
    if FUseDirtyRect then DrPaintWindow
    else RenderCached(Canvas, ClientRect, Font.PixelsPerInch);
  finally
    FAnimWindow := False;
  end;
  { THE ACCESSIBLE TREE follows a new layout -- only while somebody reads it:
    a client has asked for it, or the keyboard is in the chart [Batch 144] }
  if (FAccGen <> FStGen) and ((FAccLink <> nil) and FAccLink.InUse or Focused) then
    AccessibleSync;
end;

{ ==================== the keyboard and the accessible tree [Batch 144] ====================

  UPSTREAM HAS NO KEYBOARD. ECharts' accessibility is the aria description
  (the canvas' aria-label) and the decals; a page that wants keys writes
  them itself, with dispatchAction. So this is the port's design, and it is
  built the way such a page would build it, out of upstream's own actions:

  - The focus item moves over the walked series' view rows
    (tyControls.AdvChart.KeyNav has the keys). A move DISPATCHES downplay
    for the old item and highlight for the new one -- type, seriesIndex
    and the RAW dataIndex, the payload a page would write -- so the
    emphasis, the blur a focus rule asks for, and the highlight / downplay
    events are exactly the actions'.
  - Its tooltip is upstream's showTip for that item: the tooltip and the
    axis pointer resolved at the element's centre, which is where
    findPointFromSeries puts the point for a mark with no tooltip position
    of its own; the tooltip's triggerOn is not asked, as showTip does not
    ask it.
  - Enter / Space dispatch what a click on the item dispatches -- select,
    or unselect when it is selected, isFromClick true -- but only when the
    series has a selectedMode: a click on a series without one still
    dispatches (and upstream's events fire with nothing selected), a key
    does nothing there and leaves Enter to the form.
  - The ring is the theme's TyAdvChartFocusItem outline around the item's
    element, in the dynamic layer, while the keyboard holds the item.

  THE TAB STOP IS UNCHANGED: False, as it was declared and constructed. A
  host that wants the keyboard sets TabStop := True; a click then focuses
  the chart (TTyCustomControl.MouseDown) and Tab reaches it. }

const
  { the accessible items a series lists at most: the tree is built on every
    new layout, and a hundred thousand LCL objects would make every one of
    them slow. The keyboard walks every row regardless. }
  cTyAccMaxItems = 1000;

function TTyAdvanceChart.KbSeriesList: TTyKbSeriesArray;
var
  si, slot, n: Integer;
begin
  Result := nil;
  if FOption = nil then Exit;
  for si := 0 to FOption.ComponentCount('series') - 1 do
  begin
    slot := SlotOfSeries(si);
    if (slot < 0) or (slot > High(FBindings)) or (slot > High(FStores))
      or (FStores[slot] = nil) or FBindings[slot].Hidden then Continue;
    n := Length(Result);
    SetLength(Result, n + 1);
    Result[n].SeriesIndex := si;
    Result[n].Count := FStores[slot].Count;
  end;
end;

function TTyAdvanceChart.KbRawOf(ASeries, ARow: Integer): Integer;
var slot: Integer;
begin
  Result := -1;
  slot := SlotOfSeries(ASeries);
  if (slot < 0) or (slot > High(FStores)) or (FStores[slot] = nil) then Exit;
  if (ARow < 0) or (ARow >= FStores[slot].Count) then Exit;
  Result := FStores[slot].GetRawIndex(ARow);
end;

function TTyAdvanceChart.KbValid: Boolean;
var slot: Integer;
begin
  Result := False;
  if (FKbSeries < 0) or (FKbRow < 0) then Exit;
  slot := SlotOfSeries(FKbSeries);
  if (slot < 0) or (slot > High(FBindings)) or (slot > High(FStores))
    or (FStores[slot] = nil) or FBindings[slot].Hidden then Exit;
  Result := FKbRow < FStores[slot].Count;
end;

function TTyAdvanceChart.KbList: TTyPaintList;
begin
  if FAnimLive or (Length(FAnimStBind) > 0) then Result := AnimFrame
  else Result := FPaintList;
end;

function TTyAdvanceChart.KbElementOf(ASeries, ARow: Integer): Integer;
var
  raw, i, h: Integer;
  el: TTyChartElement;
begin
  Result := -1;
  if (FPaintList = nil) or not FPaintListValid then Exit;
  raw := KbRawOf(ASeries, ARow);
  if raw < 0 then Exit;
  { the state machine's host for the row, where the series has one }
  if (ASeries <= High(FSt)) and (FSt[ASeries].Kind <> sskNone)
    and (raw <= High(FSt[ASeries].HostIdx)) then
  begin
    h := FSt[ASeries].HostIdx[raw];
    if (h >= 0) and (h < FPaintList.Count) then Exit(h);
  end;
  for i := 0 to FPaintList.Count - 1 do
  begin
    el := FPaintList.Element(i);
    if (el.Datum.SeriesIndex <> ASeries) or (el.Datum.DataIndex <> ARow)
      or el.Datum.IsEdge or (el.Datum.Kind <> ctkSeries) or el.Ignore
      or el.ProgHidden or el.IsGuide or (el.Shape.Kind = cskLarge) then Continue;
    { the mark itself before its label }
    if (el.Caption.Text = '') and not el.Silent then Exit(i);
    if Result < 0 then Result := i;
  end;
end;

procedure TTyAdvanceChart.KbShowTip;
var raw: Integer;
begin
  raw := KbRawOf(FKbSeries, FKbRow);
  if raw < 0 then
  begin
    KbHideTip;
    Exit;
  end;
  { THE showTip ACTION on the item [Batch 153], as a page would dispatch
    it: under an axis trigger the axis tooltip through updateAxisPointer at
    the item's point, else the item's own box below its element; triggerOn
    is not asked }
  DispatchAction(Format('{"type":"showTip","seriesIndex":%d,"dataIndex":%d}',
    [FKbSeries, raw]));
end;

procedure TTyAdvanceChart.KbHideTip;
begin
  { the pointer and the box: updateAxisPointer with currTrigger 'leave' hides
    the pointers and dispatches the hideTip; with no pointer up, the hideTip
    alone [Batch 153] }
  if Length(FTipHits) > 0 then
    DispatchAction('{"type":"updateAxisPointer","currTrigger":"leave"}')
  else
    DispatchAction('{"type":"hideTip"}');
end;

procedure TTyAdvanceChart.KbGo(ASeries, ARow: Integer);
var raw: Integer;
begin
  raw := KbRawOf(ASeries, ARow);
  if raw < 0 then Exit;
  if not (FKbActive and (ASeries = FKbSeries) and (ARow = FKbRow)) then
  begin
    if FKbActive and KbValid then
      DispatchAction(Format('{"type":"downplay","seriesIndex":%d,"dataIndex":%d}',
        [FKbSeries, KbRawOf(FKbSeries, FKbRow)]));
    FKbSeries := ASeries;
    FKbRow := ARow;
    FKbActive := True;
    DispatchAction(Format('{"type":"highlight","seriesIndex":%d,"dataIndex":%d}',
      [ASeries, raw]));
  end;
  KbShowTip;
  if (FAccLink <> nil) and FAccLink.InUse then
  begin
    AccessibleSync;
    FAccLink.NotifyFocus(AccessibleFocusedChild);
  end;
  InvalidateFrame;
end;

procedure TTyAdvanceChart.KbRelease(ADownplay: Boolean);
begin
  if not FKbActive then Exit;
  if ADownplay and KbValid then
    DispatchAction(Format('{"type":"downplay","seriesIndex":%d,"dataIndex":%d}',
      [FKbSeries, KbRawOf(FKbSeries, FKbRow)]));
  FKbActive := False;
  KbHideTip;
  if (FAccLink <> nil) and FAccLink.InUse and Focused then FAccLink.NotifyFocus(nil);
  InvalidateFrame;
end;

function TTyAdvanceChart.KbActivate: Boolean;
var
  slot: Integer;
  t: TTyChartEventTarget;
begin
  Result := False;
  if not (FKbActive and KbValid) then Exit;
  slot := SlotOfSeries(FKbSeries);
  SelEnsure(slot);
  if (FKbSeries > High(FSel)) or not FSelInit[FKbSeries]
    or (FSel[FKbSeries].Mode = ssmOff) then Exit;
  t := Default(TTyChartEventTarget);
  t.HdKind := 1;
  t.HdSeries := FKbSeries;
  t.HdRow := FKbRow;
  t.HdEdge := False;
  StClickSelect(t);
  Result := True;
end;

procedure TTyAdvanceChart.PaintKbRing(APainter: TTyPainter);
var
  idx, off: Integer;
  b: TTyRectF;
  st: TTyStyleSet;
  r: TRect;
begin
  if not (FKbActive and KbValid) then Exit;
  idx := KbElementOf(FKbSeries, FKbRow);
  if idx < 0 then Exit;
  st := ActiveController.Model.ResolveStyle('TyAdvChartFocusItem', '', []);
  if not ((tpOutline in st.Present) and (st.OutlineWidth > 0)) then Exit;
  b := TyShapeBounds(KbList.Element(idx).Shape);
  { the library's ring convention (TTyCustomControl.DrawFrame): the offset
    insets the ring, so the theme's negative one sets it off the mark }
  off := APainter.Scale(st.OutlineOffset);
  r := Rect(Floor(b.Left) + off, Floor(b.Top) + off, Ceil(b.Right) - off, Ceil(b.Bottom) - off);
  if (r.Right <= r.Left) or (r.Bottom <= r.Top) then Exit;
  APainter.StrokeBorder(r, TyEffectiveCorners(st), st.OutlineWidth, st.OutlineColor);
end;

procedure TTyAdvanceChart.KeyDown(var Key: Word; Shift: TShiftState);
var
  cmd: TTyKbCommand;
  list: TTyKbSeriesArray;
  pos, row, i: Integer;
begin
  inherited KeyDown(Key, Shift);
  if (Key = 0) or (csDesigning in ComponentState) then Exit;
  cmd := TyKbCommandOf(Key, Shift);
  case cmd of
    kbcNone: ;
    kbcActivate:
      if KbActivate then Key := 0;
    kbcClear:
      if FKbActive then
      begin
        KbRelease(True);
        FKbSeries := -1;
        FKbRow := -1;
        Key := 0;
      end;
  else
    { A MOVING KEY IS ALWAYS TAKEN, with or without an item to move to:
      left over, LCL's DoArrowKey would hand the focus to a sibling }
    Key := 0;
    { coming back: the first key takes up the item the exit let go }
    if not FKbActive and KbValid then
    begin
      KbGo(FKbSeries, FKbRow);
      Exit;
    end;
    list := KbSeriesList;
    pos := -1;
    row := FKbRow;
    if KbValid then
      for i := 0 to High(list) do
        if list[i].SeriesIndex = FKbSeries then pos := i;
    if TyKbMove(list, cmd, pos, row) then KbGo(list[pos].SeriesIndex, row);
  end;
end;

procedure TTyAdvanceChart.DoExit;
begin
  KbRelease(True);
  inherited DoExit;
end;

procedure TTyAdvanceChart.CreateWnd;
begin
  inherited CreateWnd;
  if FAccLink <> nil then FAccLink.Attach;
end;

procedure TTyAdvanceChart.DestroyWnd;
begin
  if FAccLink <> nil then FAccLink.Detach;
  inherited DestroyWnd;
end;

function TTyAdvanceChart.KeyboardItem: TTyChartDatumRef;
begin
  if FKbActive and KbValid then
    Result := TyChartDatum(FKbSeries, FKbRow, KbRawOf(FKbSeries, FKbRow))
  else
    Result := TyChartNoDatum;
end;

function TTyAdvanceChart.SetKeyboardItem(ASeriesIndex, ADataIndex: Integer): Boolean;
var
  slot, r: Integer;
begin
  Result := False;
  slot := SlotOfSeries(ASeriesIndex);
  if (slot < 0) or (slot > High(FBindings)) or (slot > High(FStores))
    or (FStores[slot] = nil) or FBindings[slot].Hidden then Exit;
  for r := 0 to FStores[slot].Count - 1 do
    if FStores[slot].GetRawIndex(r) = ADataIndex then
    begin
      KbGo(ASeriesIndex, r);
      Exit(True);
    end;
end;

procedure TTyAdvanceChart.ClearKeyboardItem;
begin
  KbRelease(True);
  FKbSeries := -1;
  FKbRow := -1;
end;

function TTyAdvanceChart.AccItemIndexOf(AObj: TLazAccessibleObject): Integer;
var i: Integer;
begin
  for i := 0 to High(FAccItemObjs) do
    if FAccItemObjs[i] = AObj then Exit(i);
  Result := -1;
end;

procedure TTyAdvanceChart.AccessibleSync;
var
  root: TLazAccessibleObject;
  aria, d: TJSONData;
  facts: TTyAriaFacts;
  loc: TTyAriaLocale;
  sObjs, iObjs: TTyAccObjectArray;
  i, j, n, cnt, idx: Integer;
  b, u: TTyRectF;
  has: Boolean;
  nm: string;
begin
  if FAccSyncing or (FOption = nil) then Exit;
  FAccSyncing := True;
  try
    { a layout that is due is made first: the tree describes it }
    ConvertReady;
    if FAccGen = FStGen then Exit;
    FAccGen := FStGen;
    root := GetAccessibleObject;
    if root = nil then Exit;
    root.AccessibleRole := larChart;
    { the name: the first title, as getTitle reads it; else the word }
    nm := rsTyChartTypeChart;
    d := FOption.ComponentAt('title', 0);
    if d is TJSONObject then
    begin
      d := TJSONObject(d).Find('text');
      if TyDecalTruthy(d) then nm := TyJsonJsString(d);
    end;
    root.AccessibleName := nm;
    root.AccessibleDescription := AccessibleSummary;
    root.ClearChildAccessibleObjects;
    FAccItemObjs := nil;
    FAccItemSeries := nil;
    FAccItemRows := nil;
    { the phrases: the option's aria templates, when it writes aria }
    aria := nil;
    if FOption.Root is TJSONObject then aria := TJSONObject(FOption.Root).Find('aria');
    if not (aria is TJSONObject) then aria := nil;
    AriaGather(TJSONObject(aria), facts);
    loc := TyAriaLocaleOf(TJSONObject(aria), TyAriaDefaultLocale);
    sObjs := TyAccAddChildren(root, Length(facts.Series));
    for i := 0 to High(sObjs) do
    begin
      sObjs[i].AccessibleRole := larListBox;
      sObjs[i].AccessibleName := Trim(TyAriaSeriesPhrase(loc, facts, i));
      cnt := Length(facts.Series[i].Rows);
      if cnt > cTyAccMaxItems then cnt := cTyAccMaxItems;
      iObjs := TyAccAddChildren(sObjs[i], cnt);
      has := False;
      u := TyRectF(0, 0, 0, 0);
      for j := 0 to High(iObjs) do
      begin
        iObjs[j].AccessibleRole := larListItem;
        iObjs[j].AccessibleName := TyAriaRowPhrase(loc, facts.Series[i].Rows[j]);
        idx := KbElementOf(facts.Series[i].Index, j);
        if idx >= 0 then
        begin
          b := TyShapeBounds(FPaintList.Element(idx).Shape);
          iObjs[j].Position := Point(Floor(b.Left), Floor(b.Top));
          iObjs[j].Size := Types.Size(Ceil(b.Right) - Floor(b.Left), Ceil(b.Bottom) - Floor(b.Top));
          if not has then u := b
          else
          begin
            u.Left := Math.Min(u.Left, b.Left);
            u.Top := Math.Min(u.Top, b.Top);
            u.Right := Math.Max(u.Right, b.Right);
            u.Bottom := Math.Max(u.Bottom, b.Bottom);
          end;
          has := True;
        end;
        n := Length(FAccItemObjs);
        SetLength(FAccItemObjs, n + 1);
        SetLength(FAccItemSeries, n + 1);
        SetLength(FAccItemRows, n + 1);
        FAccItemObjs[n] := iObjs[j];
        FAccItemSeries[n] := facts.Series[i].Index;
        FAccItemRows[n] := j;
      end;
      if has then
      begin
        sObjs[i].Position := Point(Floor(u.Left), Floor(u.Top));
        sObjs[i].Size := Types.Size(Ceil(u.Right) - Floor(u.Left), Ceil(u.Bottom) - Floor(u.Top));
      end;
    end;
  finally
    FAccSyncing := False;
  end;
  if (FAccLink <> nil) and FAccLink.InUse then FAccLink.NotifyReorder;
end;

function TTyAdvanceChart.AccessibleItem(ASeriesIndex, ARow: Integer): TLazAccessibleObject;
var i: Integer;
begin
  Result := nil;
  for i := 0 to High(FAccItemObjs) do
    if (FAccItemSeries[i] = ASeriesIndex) and (FAccItemRows[i] = ARow) then
      Exit(FAccItemObjs[i]);
end;

function TTyAdvanceChart.AccessibleFocusedChild: TLazAccessibleObject;
begin
  Result := nil;
  if FKbActive and KbValid then Result := AccessibleItem(FKbSeries, FKbRow);
end;

function TTyAdvanceChart.AccessibleSelected(AObj: TLazAccessibleObject): Boolean;
var
  i, s, slot: Integer;
begin
  Result := False;
  i := AccItemIndexOf(AObj);
  if i < 0 then Exit;
  s := FAccItemSeries[i];
  slot := SlotOfSeries(s);
  if slot < 0 then Exit;
  SelEnsure(slot);
  if (s > High(FSel)) or not FSelInit[s] then Exit;
  Result := TySelIsSelected(FSel[s], SelData(slot), FAccItemRows[i]);
end;

function TTyAdvanceChart.AccessibleTakeFocus(AObj: TLazAccessibleObject): Boolean;
var i: Integer;
begin
  Result := False;
  i := AccItemIndexOf(AObj);
  if i < 0 then Exit;
  KbGo(FAccItemSeries[i], FAccItemRows[i]);
  Result := FKbActive;
end;

{ ==================== the coarse pointer and the dirty rectangles [Batch 142] ====================

  THE COARSE POINTER is a fallback of the display list's hit test: the
  direct test first -- without the port's pad, so it answers what
  upstream's Path.contain answers -- and only when it finds nothing,
  zrender's rings of samples over the candidates near the pointer
  (AdvChart.DirtyRect). What the port hit-tests apart from the list (the
  brush covers, break areas, titles, the toolbox, the timeline, the
  visualMaps, the dataZoom handles) stays direct: in upstream they are
  display-list elements and candidates like any other.

  THE DIRTY RECTANGLES keep both layers and make each cheaper, never
  different: what the dirty path puts on the canvas is, pixel for pixel,
  what the full path puts there.

  - THE STATIC LAYER, when only states changed (a hover's emphasis, a
    selection: StApplyChanged): the list is built and prepared exactly as a
    full static paint builds it, but not drawn; it is compared element by
    element with the list the cache holds (FDrSnap) and createRepaintRects
    makes the rects. Each rect starts from the ground captured before the
    series (FDrBase), the elements whose rects meet one are drawn in paint
    order, then what the static paint draws after the series (break areas,
    parallel axes, titles) -- on the static painter's own surface, which is
    then copied into the cache in those rects only. Anything else that
    drops the static layer -- a relayout, a roam step, a legend selector's
    hover, an animation leaving the static layer -- repaints it whole, and
    so does a change the rects cannot hold (see TyDirtyDiff).
  - THE DYNAMIC LAYER is kept from frame to frame and transparent outside
    the tiles it inked last (FDrDynTiles): those are cleared, the layer is
    painted as always, and its ink is found again. Its old and new tiles
    join the static rects in createRepaintRects' pool, so a frame of a
    moving tooltip costs the tooltip's area, not the control's -- the
    control-sized bitmap the full path allocates, fills and blends every
    frame (Q7's floor) is gone.
  - THE WINDOW: InvalidateFrame queues one flush (QueueAsyncCall); the
    flush prepares the frame and invalidates its rects only, and the paint
    composites the clip it was given. A paint nobody flushed for (an
    Invalidate, a window uncovered) prepares the frame itself. }

procedure TTyAdvanceChart.StaticDrop;
begin
  if FStatic <> nil then FStatic.Drop;
  { the cache no longer holds what the snapshot says [Batch 142] }
  FDrSnapOk := False;
end;

procedure TTyAdvanceChart.SetUseDirtyRect(AValue: Boolean);
begin
  if FUseDirtyRect = AValue then Exit;
  FUseDirtyRect := AValue;
  StaticDrop;
  FDrDynTiles := nil;
  FreeAndNil(FDrDyn);
  FDrPending := True;
  FZrDirty := True;
  inherited Invalidate;
end;

function TTyAdvanceChart.CoarseSize: Integer;
begin
  Result := TyCoarsePointerSize(FCoarsePointer, FPointerSize, TyTouchPlatform);
end;

function TTyAdvanceChart.ListHitAt(AX, AY: Double): Integer;
var
  L: TTyPaintList;
  sz: Integer;
begin
  Result := -1;
  if (FPaintList = nil) or not FPaintListValid then Exit;
  { IN MOTION, WHAT IS DRAWN IS WHAT IS HIT, and at rest on a state proxy
    (see HitTestAt) }
  if FAnimLive or (Length(FAnimStBind) > 0) then L := AnimFrame else L := FPaintList;
  sz := CoarseSize;
  if sz <= 0 then Exit(L.HitTestElement(AX, AY, FPaintListPPI));
  Result := L.HitTestElement(AX, AY, FPaintListPPI, False);
  if Result < 0 then Result := TyCoarseHitTest(L, AX, AY, FPaintListPPI, sz);
end;

function TTyAdvanceChart.LastRepaintFull: Boolean;
begin
  Result := FDrLastFull;
end;

function TTyAdvanceChart.LastRepaintRects: TTyZrRectArray;
begin
  Result := Copy(FDrLastRects);
end;

procedure TTyAdvanceChart.DrCaptureBase(ABmp: TBGRABitmap);
begin
  if ABmp = nil then Exit;
  if (FDrBase = nil) or (FDrBase.Width <> ABmp.Width) or (FDrBase.Height <> ABmp.Height) then
  begin
    FreeAndNil(FDrBase);
    FDrBase := TBGRABitmap.Create(ABmp.Width, ABmp.Height);
  end;
  FDrBase.PutImage(0, 0, ABmp, dmSet);
  FDrBaseOk := True;
end;

function TTyAdvanceChart.DrCanPartial(AW, AH: Integer): Boolean;
begin
  { the cache holds the snapshot's list over the captured ground, at this
    size, with nothing to lay out again and the series at rest in it }
  Result := FDrSnapOk and FDrBaseOk and (FDrWork <> nil) and (FDrBase <> nil)
    and (FDrWork.Width = AW) and (FDrWork.Height = AH)
    and (FDrBase.Width = AW) and (FDrBase.Height = AH)
    and not FDirty and (FLastRect.Right = AW) and (FLastRect.Bottom = AH)
    and not FExporting and not FAnimLive and not FAnimContinuous;
end;

procedure TTyAdvanceChart.DrStaticFull(const R: TRect; APPI: Integer);
var
  P: TTyPainter;
  measurer: ITyTextMeasurer;
begin
  if (FDrWork = nil) or (FDrWork.Width <> R.Right) or (FDrWork.Height <> R.Bottom) then
  begin
    FreeAndNil(FDrWork);
    FDrWork := TBGRABitmap.Create(R.Right, R.Bottom);
  end;
  { what BeginPaint's own bitmap starts as }
  FDrWork.Fill(BGRAPixelTransparent);
  FDrBaseOk := False;
  FDrSnapOk := False;
  FDrSnap := nil;
  measurer := NewTextMeasurer(APPI);
  P := TTyPainter.Create;
  try
    P.BeginPaintOn(FStatic.Canvas, R, APPI, FDrWork);
    FDrCapture := True;
    try
      PaintStatic(P, R, APPI, measurer);
    finally
      FDrCapture := False;
    end;
    P.EndPaint;
  finally
    P.Free;
  end;
  if FDrBaseOk and (FDrStaticList <> nil) then
  begin
    FDrSnap := TyDirtySnapshot(FDrStaticList, APPI);
    FDrSnapOk := True;
  end;
end;

function TTyAdvanceChart.DrStaticPartial(const R: TRect; APPI: Integer;
  var APool: TTyRepaintPool): Boolean;
var
  measurer: ITyTextMeasurer;
  snap: TTyDirtySnap;
  rects, zr: TTyZrRectArray;
  px: array of TRect;
  pr, oldClip: TRect;
  box: TTyXYWH;
  i, k, n, idx: Integer;
  hit: Boolean;
  P: TTyPainter;
begin
  Result := False;
  measurer := NewTextMeasurer(APPI);
  { THE LIST AS A FULL STATIC PAINT WOULD BUILD AND PREPARE IT -- the
    graphic component's elements, the states, the proxies -- and not drawn }
  GfxBuild(APPI);
  FDrMode := 1;
  try
    PaintSeries(nil, measurer, APPI);
  finally
    FDrMode := 0;
  end;
  { from here a fallback must not build it again }
  FDrPrepDone := True;
  { a state's transition took the series into the dynamic layer, or the
    static layer would not hold one list: everything }
  if FAnimLive or FAnimContinuous or (FDrStaticList = nil) then Exit;
  snap := TyDirtySnapshot(FDrStaticList, APPI);
  if not TyDirtyDiff(FDrSnap, snap, rects) then Exit;
  FDrPrepDone := False;
  FDrSnap := snap;
  Result := True;
  n := 0;
  SetLength(px, Length(rects));
  SetLength(zr, Length(rects));
  for i := 0 to High(rects) do
    if TyZrRectToPixels(rects[i], R.Right, R.Bottom, pr) then
    begin
      px[n] := pr;
      zr[n] := rects[i];
      Inc(n);
    end;
  if n = 0 then Exit;
  { EACH RECT FROM THE GROUND, then what meets it in paint order }
  for i := 0 to n - 1 do
  begin
    FDrWork.PutImagePart(px[i].Left, px[i].Top, FDrBase, px[i], dmSet);
    box.X := px[i].Left;
    box.Y := px[i].Top;
    box.W := px[i].Right - px[i].Left;
    box.H := px[i].Bottom - px[i].Top;
    TyRepaintPoolAdd(APool, box);
  end;
  P := TTyPainter.Create;
  oldClip := FDrWork.ClipRect;
  try
    P.BeginPaintOn(nil, R, APPI, FDrWork);
    { ONE PASS UNDER THE RECTS' BOUNDS: the bitmap's clip is the box round
      every rect, and an element is drawn once when it meets any of them.
      zrender clips and draws rect by rect; drawn that way here an element
      crossing several rects -- a line's polyline across the plot -- is
      stroked once per rect, and stroking a long polyline costs the same
      however small the clip. What lands outside the rects is never copied
      out. }
    box := TyRectToXYWH(TyRectF(px[0].Left, px[0].Top, px[0].Right, px[0].Bottom));
    for k := 1 to n - 1 do
      TyZrRectUnion(box, TyRectToXYWH(TyRectF(px[k].Left, px[k].Top, px[k].Right, px[k].Bottom)));
    FDrWork.ClipRect := Rect(Round(box.X), Round(box.Y), Round(box.X + box.W), Round(box.Y + box.H));
    for i := 0 to FDrStaticList.Count - 1 do
    begin
      idx := FDrStaticList.PaintOrder(i);
      if (idx < 0) or (idx > High(snap)) then Continue;
      { TyRenderPaintList's own skips }
      if snap[idx].El.Ignore or snap[idx].El.ProgHidden or snap[idx].El.GfxUnder then
        Continue;
      { an element nothing bounds is drawn wherever it is: unchanged, it may
        still be under a rect }
      if snap[idx].Bounded then
      begin
        hit := False;
        for k := 0 to n - 1 do
          if TyZrRectIntersect(snap[idx].Rect, zr[k]) then
          begin
            hit := True;
            Break;
          end;
        if not hit then Continue;
      end;
      TyRenderElement(P, snap[idx].El);
    end;
    { what the static paint draws over the series, as it draws it }
    PaintBreakAreas(P);
    PaintParallels(P, APPI, measurer);
    PaintTitles(P);
    FDrWork.ClipRect := oldClip;
    P.EndPaint;
  finally
    FDrWork.ClipRect := oldClip;
    P.Free;
  end;
  { INTO THE CACHE, those rects only, blended as EndPaint blends }
  for i := 0 to n - 1 do
    FDrWork.DrawPart(px[i], FStatic.Canvas, px[i].Left, px[i].Top, False);
end;

const
  { the dynamic layer's ink is found in tiles this many px square }
  cDrInkTile = 32;

procedure TTyAdvanceChart.DrDynamic(const R: TRect; APPI: Integer;
  var APool: TTyRepaintPool; var AFull: Boolean);
var
  i: Integer;
  pr: TRect;
  cur: TTyZrRectArray;
  P: TTyPainter;
  measurer: ITyTextMeasurer;
begin
  if (FDrDyn = nil) or (FDrDyn.Width <> R.Right) or (FDrDyn.Height <> R.Bottom) then
  begin
    FreeAndNil(FDrDyn);
    FDrDyn := TBGRABitmap.Create(R.Right, R.Bottom, BGRAPixelTransparent);
    FDrDynTiles := nil;
    AFull := True;
  end;
  { THE LAST INK GOES: the layer is transparent again everywhere }
  for i := 0 to High(FDrDynTiles) do
  begin
    if TyZrRectToPixels(FDrDynTiles[i], R.Right, R.Bottom, pr) then
      FDrDyn.FillRect(pr, BGRAPixelTransparent, dmSet);
    TyRepaintPoolAdd(APool, FDrDynTiles[i]);
  end;
  cur := nil;
  { A PAINTER ONLY WHEN THERE IS SOMETHING TO PUT IN IT -- as the full path }
  if HasDynamicContent then
  begin
    measurer := NewTextMeasurer(APPI);
    P := TTyPainter.Create;
    try
      P.BeginPaintOn(nil, R, APPI, FDrDyn);
      PaintDynamic(P, R, APPI, measurer);
      P.EndPaint;
    finally
      P.Free;
    end;
    TyInkTiles(FDrDyn, cDrInkTile, cur);
    for i := 0 to High(cur) do TyRepaintPoolAdd(APool, cur[i]);
  end;
  FDrDynTiles := cur;
end;

procedure TTyAdvanceChart.DrPrepare(const ARect: TRect; APPI: Integer);
var
  w, h: Integer;
  R: TRect;
  pool: TTyRepaintPool;
  full, partial: Boolean;
begin
  { [F4b] the flush's start, for `rendered`'s elapsedTime }
  FPaintT0 := AnimClock;
  FDrLastRects := nil;
  FDrLastFull := True;
  w := ARect.Right - ARect.Left;
  h := ARect.Bottom - ARect.Top;
  if (w <= 0) or (h <= 0) then Exit;
  R := Rect(0, 0, w, h);
  if FStatic = nil then FStatic := TTyPaintCache.Create;
  { PPI IS PART OF THE KEY -- see RenderCached }
  if APPI <> FStaticPPI then
  begin
    StaticDrop;
    FStaticPPI := APPI;
  end;
  TyRepaintPoolInit(pool);
  full := False;
  { upstream's frame: the flags become state lists [Batch 88] -- and a
    change of them is repainted in rects where it can be }
  if StApplyChanged then
  begin
    FProgReuse := False;
    partial := DrCanPartial(w, h) and DrStaticPartial(R, APPI, pool);
    if not partial then StaticDrop;
  end;
  if FStatic.NeedsRender(w, h) then
  begin
    DrStaticFull(R, APPI);
    full := True;
  end;
  DrDynamic(R, APPI, pool, full);
  FDrLastFull := full;
  if not full then FDrLastRects := TyRepaintPoolFinish(pool);
  { the update painted: `rendered` [Batch 119] }
  EmitFlush;
  { the bar race, as RenderTo's [Batch 135] }
  if FRtAfterRelayout then
  begin
    FRtAfterRelayout := False;
    RtRenderPass;
    RtRendered;
  end;
  RtFlushQueue;
end;

procedure TTyAdvanceChart.DrComposite(ACanvas: TCanvas; const ARect: TRect);
var
  i, k, w, h: Integer;
  px: TRect;
  ink: Boolean;
begin
  if (FStatic = nil) or (ACanvas = nil) then Exit;
  if FDrLastFull then
  begin
    FStatic.Blit(ACanvas);
    if (FDrDyn <> nil) and (Length(FDrDynTiles) > 0) then
      FDrDyn.Draw(ACanvas, ARect.Left, ARect.Top, False);
    Exit;
  end;
  w := ARect.Right - ARect.Left;
  h := ARect.Bottom - ARect.Top;
  for i := 0 to High(FDrLastRects) do
  begin
    if not TyZrRectToPixels(FDrLastRects[i], w, h, px) then Continue;
    { the static layer at the canvas origin, as Blit puts it }
    ACanvas.CopyRect(px, FStatic.Canvas, px);
    ink := False;
    if FDrDyn <> nil then
      for k := 0 to High(FDrDynTiles) do
        if TyZrRectIntersect(FDrDynTiles[k], FDrLastRects[i]) then
        begin
          ink := True;
          Break;
        end;
    if ink then
      FDrDyn.DrawPart(px, ACanvas, ARect.Left + px.Left, ARect.Top + px.Top, False);
  end;
end;

procedure TTyAdvanceChart.DrPaintWindow;
var
  clip, px, client, ink: TRect;
  i: Integer;
  prepared: Boolean;
begin
  client := ClientRect;
  clip := Canvas.ClipRect;
  if (clip.Right <= clip.Left) or (clip.Bottom <= clip.Top) then clip := client;
  { A PAINT NOBODY FLUSHED FOR prepares its own frame: an Invalidate, a
    window uncovered, a flush overtaken by a newer request }
  prepared := not FDrFlushed or FDrPending or (FStatic = nil);
  if prepared then
  begin
    TbFrame;
    DrPrepare(client, Font.PixelsPerInch);
  end;
  FDrFlushed := False;
  FDrPending := False;
  if FStatic = nil then Exit;
  { THE CLIP, whatever invalidated it }
  Canvas.CopyRect(clip, FStatic.Canvas, clip);
  if (FDrDyn <> nil) and (Length(FDrDynTiles) > 0) then
  begin
    ink := Rect(MaxInt, MaxInt, -MaxInt, -MaxInt);
    for i := 0 to High(FDrDynTiles) do
      if TyZrRectToPixels(FDrDynTiles[i], client.Right, client.Bottom, px) then
      begin
        if px.Left < ink.Left then ink.Left := px.Left;
        if px.Top < ink.Top then ink.Top := px.Top;
        if px.Right > ink.Right then ink.Right := px.Right;
        if px.Bottom > ink.Bottom then ink.Bottom := px.Bottom;
      end;
    if IntersectRect(px, ink, clip) then
      FDrDyn.DrawPart(px, Canvas, px.Left, px.Top, False);
  end;
  { A FRAME LARGER THAN THE CLIP is invalidated again where the clip did
    not reach; that paint only composites }
  if prepared and HandleAllocated then
  begin
    if FDrLastFull then
    begin
      if (clip.Left > 0) or (clip.Top > 0) or (clip.Right < client.Right)
        or (clip.Bottom < client.Bottom) then
      begin
        FDrFlushed := True;
        LCLIntf.InvalidateRect(Handle, nil, False);
      end;
    end
    else
      for i := 0 to High(FDrLastRects) do
        if TyZrRectToPixels(FDrLastRects[i], client.Right, client.Bottom, px)
          and not ((px.Left >= clip.Left) and (px.Top >= clip.Top)
            and (px.Right <= clip.Right) and (px.Bottom <= clip.Bottom)) then
        begin
          FDrFlushed := True;
          LCLIntf.InvalidateRect(Handle, @px, False);
        end;
  end;
end;

procedure TTyAdvanceChart.DrFlushAsync(AData: PtrInt);
var
  i: Integer;
  px: TRect;
begin
  FDrQueued := False;
  if not FUseDirtyRect or not FDrPending or not HandleAllocated
    or (csDestroying in ComponentState) then Exit;
  { the window's frame: camAuto animates it, the toolbox's hover lands }
  FAnimWindow := True;
  try
    TbFrame;
    DrPrepare(ClientRect, Font.PixelsPerInch);
  finally
    FAnimWindow := False;
  end;
  FDrPending := False;
  FDrFlushed := True;
  if FDrLastFull then
    LCLIntf.InvalidateRect(Handle, nil, False)
  else
    for i := 0 to High(FDrLastRects) do
      if TyZrRectToPixels(FDrLastRects[i], ClientWidth, ClientHeight, px) then
        LCLIntf.InvalidateRect(Handle, @px, False);
end;

{ ==================== the graphic component [Batch 122] ==================== }

procedure TTyAdvanceChart.GfxWriteBack;
var
  node: TJSONData;
  i: Integer;
begin
  if (FGfxModel = nil) or (FOption = nil) then Exit;
  node := FOption.ComponentAt('graphic', 0);
  if not (node is TJSONObject) then Exit;
  i := TJSONObject(node).IndexOfName('elements');
  if i >= 0 then TJSONObject(node).Items[i] := FGfxModel.Elements.Clone
  else TJSONObject(node).Add('elements', FGfxModel.Elements.Clone);
end;

procedure TTyAdvanceChart.GfxInitFromTree;
var node: TJSONData;
begin
  FGfxFresh := False;
  { A NEW MODEL: the view clears the old one's elements at its next
    render (GraphicView's _lastGraphicModel) }
  FGfxView.ForgetModel;
  FreeAndNil(FGfxModel);
  FGfxPending := True;
  if FOption = nil then Exit;
  node := FOption.ComponentAt('graphic', 0);
  if not (node is TJSONObject) then Exit;
  FGfxModel := TTyGfxModel.Create;
  FGfxModel.OptionUpdated(TJSONObject(node).Find('elements'), True);
  GfxWriteBack;
end;

procedure TTyAdvanceChart.GfxPass(const AReport: TTyMergeReport);
var
  si: Integer;
  newOpt: TJSONObject;
begin
  if FGfxFresh then
  begin
    GfxInitFromTree;
    Exit;
  end;
  si := TyMergeSlotsIndex(AReport, 'graphic');
  if (si < 0) or (Length(AReport.Slots[si].Fate) = 0) then Exit;
  case AReport.Slots[si].Fate[0] of
    mfNew:
      GfxInitFromTree;
    mfMerged:
      begin
        if FGfxModel = nil then
        begin
          GfxInitFromTree;
          Exit;
        end;
        newOpt := nil;
        if Length(AReport.Slots[si].NewOpt) > 0 then newOpt := AReport.Slots[si].NewOpt[0];
        if newOpt <> nil then
          FGfxModel.OptionUpdated(newOpt.Find('elements'), False)
        else
          FGfxModel.OptionUpdated(nil, False);
        GfxWriteBack;
        FGfxPending := True;
      end;
    mfRemoved, mfHole:
      begin
        FGfxView.ForgetModel;
        FreeAndNil(FGfxModel);
        FGfxPending := True;
      end;
  end;
end;

{ isAnimationEnabled and getShallow over the graphic model: its own option,
  else the root's, else globalDefault }
function TTyAdvanceChart.GfxAnimSettings: TTyGfxAnimSettings;
var
  node, root: TJSONObject;
  d: TJSONData;

  function Get(const AKey: string): TJSONData;
  begin
    Result := nil;
    if node <> nil then Result := node.Find(AKey);
    if ((Result = nil) or (Result.JSONType = jtNull)) and (root <> nil) then
      Result := root.Find(AKey);
    if (Result <> nil) and (Result.JSONType = jtNull) then Result := nil;
  end;

  function Num(const AKey: string; ADefault: Double): Double;
  begin
    d := Get(AKey);
    if (d <> nil) and (d.JSONType = jtNumber) then Result := d.AsFloat
    else Result := ADefault;
  end;

  function Str(const AKey, ADefault: string): string;
  begin
    d := Get(AKey);
    if (d <> nil) and (d.JSONType = jtString) then Result := d.AsString
    else Result := ADefault;
  end;

begin
  Result := Default(TTyGfxAnimSettings);
  node := nil;
  root := nil;
  if FOption <> nil then
  begin
    d := FOption.ComponentAt('graphic', 0);
    if d is TJSONObject then node := TJSONObject(d);
    if FOption.Root is TJSONObject then root := TJSONObject(FOption.Root);
  end;
  Result.Enabled := AnimAllowed;
  d := nil;
  if node <> nil then d := node.Find('animation');
  if (d = nil) or (d.JSONType = jtNull) then
  begin
    if root <> nil then d := root.Find('animation') else d := nil;
    { the root's 'auto' by default; a written null is no animation }
    if d = nil then
    else if d.JSONType = jtNull then Result.Enabled := False
    else if (d.JSONType = jtBoolean) and not d.AsBoolean then Result.Enabled := False
    else if (d.JSONType = jtNumber) and (d.AsFloat = 0) then Result.Enabled := False
    else if (d.JSONType = jtString) and (d.AsString = '') then Result.Enabled := False;
  end
  else if ((d.JSONType = jtBoolean) and not d.AsBoolean)
    or ((d.JSONType = jtNumber) and (d.AsFloat = 0))
    or ((d.JSONType = jtString) and (d.AsString = '')) then
    Result.Enabled := False;
  Result.Duration := Num('animationDuration', 1000);
  { globalDefault's: an easing of cubicInOut both ways (a series' own
    defaults say cubicOut, a component's do not) }
  Result.Easing := Str('animationEasing', 'cubicInOut');
  Result.Delay := Num('animationDelay', 0);
  Result.DurationUpdate := Num('animationDurationUpdate', 500);
  Result.EasingUpdate := Str('animationEasingUpdate', 'cubicInOut');
  Result.DelayUpdate := Num('animationDelayUpdate', 0);
end;

function TTyAdvanceChart.GfxLive: Boolean;
begin
  Result := (FGfxAnim <> nil) and (FGfxAnim.ClipCount > 0);
end;

function GfxImageSize(const ASource: string; out AW, AH: Double): Boolean;
var bmp: TBGRABitmap;
begin
  bmp := TyPatternImage(ASource);
  Result := (bmp <> nil) and (bmp.Width > 0) and (bmp.Height > 0);
  if Result then
  begin
    AW := bmp.Width;
    AH := bmp.Height;
  end
  else
  begin
    AW := 0;
    AH := 0;
  end;
end;

procedure TTyAdvanceChart.GfxBuild(APPI: Integer);
var
  scale, w, h, z, zl: Double;
  meas: ITyTextMeasurer;
  node, d: TJSONData;
  ground: TTyGfxGround;
  ctx: TTyGfxPaintCtx;
  n: Integer;

  procedure Add(AEl: TTyGfxEl; ASilent: Boolean);
  var pe: TTyChartElement;
  begin
    if not TyGfxPaintElement(AEl, meas, ctx, pe) then Exit;
    pe.Silent := ASilent;
    pe.Datum := TyChartComponentDatum(ctkGraphic, 0, n);
    { zlevel over z, as zrender sorts; z and z2 whole }
    pe.Z := Round(AEl.ZLevel) * 100000 + Round(AEl.Z);
    pe.Z2 := Round(AEl.Z2);
    pe.GfxUnder := (AEl.ZLevel = 0) and (AEl.Z <= 0);
    SetLength(FGfxPaint, n + 1);
    SetLength(FGfxPaintEl, n + 1);
    FGfxPaint[n] := pe;
    FGfxPaintEl[n] := AEl;
    AEl.Serial := n;
    Inc(n);
  end;

  procedure Walk(AEl: TTyGfxEl; ASilent: Boolean);
  var i: Integer; s: Boolean;
  begin
    if AEl.Ignore then Exit;
    s := ASilent or AEl.Silent;
    if AEl.IsGroup then
    begin
      for i := 0 to High(AEl.Children) do Walk(AEl.Children[i], s);
      Exit;
    end;
    Add(AEl, s);
    if (AEl.TextContent <> nil) and not AEl.TextContent.Ignore then
      Add(AEl.TextContent, s or AEl.TextContent.Silent);
  end;

begin
  FGfxPaint := nil;
  FGfxPaintEl := nil;
  if FGfxView = nil then Exit;
  FGfxView.FreeGone;
  if APPI <= 0 then APPI := 96;
  scale := APPI / 96;
  w := (FLastRect.Right - FLastRect.Left) / scale;
  h := (FLastRect.Bottom - FLastRect.Top) / scale;
  { the layout measures in css px }
  meas := NewTextMeasurer(96);
  if FGfxPending then
  begin
    FGfxPending := False;
    z := NaN;
    zl := NaN;
    node := nil;
    if FOption <> nil then node := FOption.ComponentAt('graphic', 0);
    if node is TJSONObject then
    begin
      d := TJSONObject(node).Find('z');
      if (d <> nil) and (d.JSONType = jtNumber) then z := d.AsFloat;
      d := TJSONObject(node).Find('zlevel');
      if (d <> nil) and (d.JSONType = jtNumber) then zl := d.AsFloat;
    end;
    FGfxView.Render(FGfxModel, w, h, meas, GfxAnimSettings, z, zl);
    FGfxW := w;
    FGfxH := h;
    { the flush that steps every new clip at the setOption instant }
    FGfxAnim.Update(AnimClock, True);
    AnimArmTimer;
  end
  { NOT BEFORE THE FIRST RENDER: the size is NaN until then, and comparing
    against it raises with the invalid-operation trap unmasked -- a chart
    that never had an option painted nothing but an exception }
  else if (not IsNan(FGfxW)) and ((w <> FGfxW) or (h <> FGfxH)) then
  begin
    FGfxView.Place(w, h, meas);
    FGfxW := w;
    FGfxH := h;
  end;
  MarkerGround(ground.Background, ground.IsDark);
  FGfxView.Prepare(meas, ground);
  ctx := Default(TTyGfxPaintCtx);
  ctx.Scale := scale;
  ctx.HasInk := True;
  ctx.Ink := TTyChartColor(ActiveController.Model.ResolveStyle(GetStyleTypeKey,
    StyleClass, [tysNormal]).TextColor);
  ctx.ImageSize := @GfxImageSize;
  n := 0;
  Walk(FGfxView.Root, False);
end;

procedure TTyAdvanceChart.GfxPaintUnder(APainter: TTyPainter);
var
  i: Integer;
  el: TTyChartElement;
begin
  FGfxUnder.Clear;
  for i := 0 to High(FGfxPaint) do
    if FGfxPaint[i].GfxUnder then FGfxUnder.Add(FGfxPaint[i]);
  for i := 0 to FGfxUnder.Count - 1 do
  begin
    el := FGfxUnder.Element(FGfxUnder.PaintOrder(i));
    if not el.Ignore then TyRenderElement(APainter, el);
  end;
end;

function TTyAdvanceChart.GfxElementEvent(const AType: string;
  const ATarget: TTyChartEventTarget; AX, AY: Integer): Boolean;
var
  el: TTyGfxEl;
  spec: string;
  ev: TTyChartElementEvent;
begin
  Result := False;
  if (ATarget.HdKind <> 8) or (FGfxView = nil) then Exit;
  el := FGfxView.Find(ATarget.HdName);
  if el = nil then Exit;
  ev := Default(TTyChartElementEvent);
  ev.EventType := AType;
  ev.TargetId := el.Id;
  ev.OffsetX := AX;
  ev.OffsetY := AY;
  { up the groups to the root: the handler, then the parent unless the
    handler stopped it }
  while (el <> nil) and (el <> FGfxView.Root) do
  begin
    spec := el.Handlers.Values['on' + AType];
    if spec <> '' then
    begin
      ev.Id := el.Id;
      ev.Name := el.Name;
      ev.Handler := spec;
      if TyChartRunElementHandler(spec, Self, ev) then Result := True;
    end;
    if Result then Break;
    el := el.Parent;
  end;
end;

procedure TTyAdvanceChart.GfxDragStart(const ATarget: TTyChartEventTarget;
  AX, AY: Integer);
var el: TTyGfxEl;
begin
  FGfxDragOn := False;
  if (ATarget.HdKind <> 8) or (FGfxView = nil) then Exit;
  el := FGfxView.Find(ATarget.HdName);
  while (el <> nil) and (el <> FGfxView.Root) and (el.Draggable = '') do el := el.Parent;
  if (el = nil) or (el = FGfxView.Root) then Exit;
  FGfxDragOn := True;
  FGfxDragId := el.Id;
  FGfxDragX := AX;
  FGfxDragY := AY;
end;

procedure TTyAdvanceChart.GfxDragMove(AX, AY: Integer);
var
  el: TTyGfxEl;
  dx, dy, scale, vx, vy: Double;
  inv: TTyMat2D;
begin
  if not FGfxDragOn or (FGfxView = nil) then Exit;
  el := FGfxView.Find(FGfxDragId);
  if el = nil then
  begin
    FGfxDragOn := False;
    Exit;
  end;
  if FPaintListPPI > 0 then scale := FPaintListPPI / 96 else scale := 1;
  dx := (AX - FGfxDragX) / scale;
  dy := (AY - FGfxDragY) / scale;
  FGfxDragX := AX;
  FGfxDragY := AY;
  if (dx = 0) and (dy = 0) then Exit;
  { Element.drift: 'horizontal' keeps y, 'vertical' keeps x }
  if el.Draggable = 'horizontal' then dy := 0
  else if el.Draggable = 'vertical' then dx := 0;
  { the move in the parent's frame }
  vx := dx;
  vy := dy;
  if (el.Parent <> nil) and el.Parent.HasTransform
    and TyMatInvert(el.Parent.Transform, inv) then
  begin
    vx := inv[0] * dx + inv[2] * dy;
    vy := inv[1] * dx + inv[3] * dy;
  end;
  el.X := el.X + vx;
  el.Y := el.Y + vy;
  DropStatic;
  InvalidateFrame;
end;

