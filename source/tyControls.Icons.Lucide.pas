var
  GFont: TTyIconFont = nil;
  GData: RawByteString = '';

function TyLucideCodepoint(const AName: string): Cardinal;
var lo, hi, mid, c: Integer;
begin
  lo := Low(LucideMap); hi := High(LucideMap);
  while lo <= hi do
  begin
    mid := (lo + hi) div 2;
    c := CompareText(LucideMap[mid].Name, AName);
    if c = 0 then Exit(LucideMap[mid].Codepoint);
    if c < 0 then lo := mid + 1 else hi := mid - 1;
  end;
  Result := 0;
end;

function TyLucideGlyphName(AIndex: Integer): string;
begin
  if (AIndex < Low(LucideMap)) or (AIndex > High(LucideMap)) then Exit('');
  Result := LucideMap[AIndex].Name;
end;

{ The resolver TTyIconFont consults when its own Glyphs map has no entry. Declining by
  family is what lets several bundled fonts coexist. }
function LucideResolver(const AFamily, AName: string; out ACodepoint: Cardinal): Boolean;
begin
  ACodepoint := 0;
  if not SameText(AFamily, TyLucideFamily) then Exit(False);
  ACodepoint := TyLucideCodepoint(AName);
  Result := ACodepoint > 0;
end;

function DecodeFont: RawByteString;
var
  i, n: Integer;
  b64: RawByteString;
  src, dst: TMemoryStream;
  unz: Tdecompressionstream;
  buf: array[0..65535] of Byte;
begin
  if GData <> '' then Exit(GData);
  { Sized in one go: appending 541 chunks to a string reallocates 541 times. }
  n := 0;
  for i := Low(LucideB64) to High(LucideB64) do Inc(n, Length(LucideB64[i]));
  SetLength(b64, n);
  n := 1;
  for i := Low(LucideB64) to High(LucideB64) do
  begin
    Move(LucideB64[i][1], b64[n], Length(LucideB64[i]));
    Inc(n, Length(LucideB64[i]));
  end;
  src := TMemoryStream.Create;
  dst := TMemoryStream.Create;
  try
    b64 := DecodeStringBase64(b64);
    if b64 = '' then Exit('');
    src.WriteBuffer(b64[1], Length(b64));
    src.Position := 0;
    unz := Tdecompressionstream.Create(src);
    try
      { Read to EOF: an inflate stream cannot report its size in advance. }
      repeat
        n := unz.Read(buf, SizeOf(buf));
        if n > 0 then dst.WriteBuffer(buf, n);
      until n <= 0;
    finally
      unz.Free;
    end;
    SetLength(GData, dst.Size);
    if dst.Size > 0 then Move(dst.Memory^, GData[1], dst.Size);
  finally
    dst.Free;
    src.Free;
  end;
  Result := GData;
end;

function TyLucideFont: TTyIconFont;
var d: RawByteString;
begin
  if GFont = nil then
  begin
    GFont := TTyIconFont.Create(nil);
    d := DecodeFont;
    if d <> '' then
      GFont.LoadFontFromMemory(@d[1], Length(d), TyLucideFamily)
    else
      GFont.FontFamily := TyLucideFamily;
  end;
  Result := GFont;
end;

initialization
  { Registered here, not in TyLucideFont, so a name resolves on a TTyIconFont the
    application created itself -- the singleton is a convenience, not the gate. }
  TyRegisterGlyphResolver(@LucideResolver);

finalization
  TyUnregisterGlyphResolver(@LucideResolver);
  FreeAndNil(GFont);

end.
