unit tyControls.Icons.Lucide;
{$mode objfpc}{$H+}

{ Lucide, bundled. GENERATED by scripts/gen-lucide.py from assets/lucide/ -- do NOT edit
  by hand; change the assets and re-run the script. Source: lucide-static@1.30.0.

  THIS UNIT IS OPTIONAL AND MUST STAY THAT WAY. The font is ~850KB and it lives in the
  const array below, inside the unit, precisely so that smart linking drops the whole
  thing from any application that never writes `uses tyControls.Icons.Lucide`. An .lrs
  resource would have been linked whole-file regardless. The rule that keeps this true:
  NO other unit in this library may reference this one. The dependency points inwards,
  from the application, and tests/test.lucide.pas asserts it.

  Usage is one line each way:

      CharImage1.IconFont  := TyLucideFont;
      CharImage1.GlyphName := TyIconHouse;   { or just 'house' }

  and any TTyIconFont whose FontFamily is 'lucide' resolves Lucide names without a
  Glyphs entry, because this unit registers a resolver on startup.

  LICENCE. ISC (Lucide) plus MIT for the Feather-derived icons; both texts are in
  assets/lucide/LICENSE and reproduced in THIRD-PARTY-NOTICES.md, which is what an
  application shipping this unit has to carry. Nothing is required of the END USER: no
  attribution on screen, no link, no notice at run time. }

interface

uses
  tyControls.IconFont;

const
  { The sfnt family name of the vendored file, read out of the file by the generator.
    Assign it to any TTyIconFont you want served by the resolver below. }
  TyLucideFamily = 'lucide';
  { The exact upstream package these bytes came from. }
  TyLucideVersion = 'lucide-static@1.30.0';
  { SHA-1 over lucide.ttf + codepoints.json as generated. tests/test.lucide.pas
    recomputes it from assets/lucide/, so editing an asset without re-running the
    generator is a red test rather than a wrong glyph in someone's application. }
  TyLucideAssetDigest = '91D710D648B2DFB772FB7C043E5BE7AD14A9D3AD';
  { Icons in the bundled font (names plus upstream aliases). }
  TyLucideGlyphCount = 2022;
  { 20 upstream names are NOT here, and that is deliberate. Lucide keeps a codepoint
    forever once allocated -- the property that makes these constants survive a font
    upgrade -- so codepoints.json still lists every icon it has ever had, including the
    brand logos v1.0 removed. Their glyf records are zero bytes long: rendering one
    gives a blank square. The generator checks the outline and drops the name, so
    HasGlyph answers honestly instead of promising an icon that draws nothing:
      chrome
      chromium
      circle-euro-sign
      codepen
      codesandbox
      dribbble
      facebook
      figma
      framer
      github
      gitlab
      instagram
      linkedin
      pocket
      rail-symbol
      slack
      trello
      twitch
      twitter
      youtube
  }

{ The shared icon font, created on first use and registered from the embedded bytes.
  Owned by this unit and freed at finalization -- do not free it. Check Available on the
  result if you want to know whether the registration actually took. }
function TyLucideFont: TTyIconFont;

{ The codepoint for a Lucide name, or 0. Exposed because the picker and the drift guard
  both want the table without going through a component. }
function TyLucideCodepoint(const AName: string): Cardinal;
{ Name at AIndex in 0..TyLucideGlyphCount-1, sorted; '' when out of range. }
function TyLucideGlyphName(AIndex: Integer): string;

const
  { Named glyphs. Strings, not codepoints: the name is the stable identity across a font
    upgrade, and it is what GlyphName takes. Unreferenced ones cost nothing.

    36 of them are spelled with underscores (TyIconArrow_Down_A_Z rather than
    TyIconArrowDownAZ) because dropping the dashes would make them the SAME Pascal
    identifier as a sibling -- identifiers here are case-insensitive, so ...AZ and
    ...Az collide. Both members of such a pair are spelled out, so which one gets the
    short name does not depend on the order of the upstream file:
      arrow-down-0-1           -> TyIconArrow_Down_0_1
      arrow-down-01            -> TyIconArrow_Down_01
      arrow-down-1-0           -> TyIconArrow_Down_1_0
