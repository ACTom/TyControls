unit tyControls.BuiltinSkins;
{ The structural skins (classic, xp, office, win11, ...) compiled IN from themes/builtin/*.tycss,
  so an app ships them without a themes/ folder. GENERATED by gen-builtinskins.ps1 -- do NOT edit
  by hand; edit themes/builtin/<name>.tycss then re-run the generator. test.builtinskins guards
  that each compiled-in const stays byte-identical to its file. }
{$mode objfpc}{$H+}
interface
uses Classes, SysUtils;
{ Register every built-in structural skin by name (via TyRegisterThemeCss), so ThemeName := 'office'
  etc. resolves with no file. Idempotent; call from TyRegisterBuiltinThemes. }
procedure TyRegisterBuiltinSkins;
{ The built-in skin names (sorted), for a host to populate a theme picker. }
function TyBuiltinSkinNames: TStringArray;

implementation
uses tyControls.ThemeRegistry;

procedure TyRegisterBuiltinSkins;
begin
  TyRegisterThemeCss('adwaita',
    '/* adwaita — GNOME libadwaita, re-authored to read GENUINELY NATIVE (not "zoomed").' + LineEnding +
    '   Restrained and flat. LIGHT: soft off-white window, a slightly darker flat headerbar with' + LineEnding +
    '   dark ink, crisp white fields, hairline borders, gentle 6px radii, and the GNOME blue as the' + LineEnding +
    '   single accent. DARK: ~#242424 surfaces, a #303030 headerbar, ~#1E1E1E fields, light ink,' + LineEnding +
    '   subtle borders, the same blue. Only the PALETTE flips per @mode — every radius/gradient/' + LineEnding +
    '   padding/render-style is shared. Default buttons are NORMAL weight with compact 5x9 padding so' + LineEnding +
    '   short CJK/label captions fit without truncation. --accent is the brand seed the picker recolours. */' + LineEnding +
    '' + LineEnding +
    '/* --- palette: light ------------------------------------------------------ */' + LineEnding +
    '@mode light {' + LineEnding +
    '  :root {' + LineEnding +
    '    --accent:       #3584E4;   /* GNOME blue — brand/accent seed              */' + LineEnding +
    '    --window:       #FAFAFA;   /* window background                            */' + LineEnding +
    '    --header:       #EBEBEB;   /* headerbar / title bar (a touch darker)       */' + LineEnding +
    '    --field:        #FFFFFF;   /* text-entry wells                             */' + LineEnding +
    '    --ink:          #2E3436;   /* primary dark text                            */' + LineEnding +
    '    --muted:        #9A9996;   /* disabled / secondary ink                     */' + LineEnding +
    '    --border:       #DCDCDC;   /* hairline separators & field edges            */' + LineEnding +
    '    --btn-face:     #FFFFFF;   /* default button face (top gradient stop)      */' + LineEnding +
    '    --btn-face2:    #F6F6F6;   /* default button face (bottom gradient stop)   */' + LineEnding +
    '    --btn-border:   #DBDBDB;   /* default button edge                          */' + LineEnding +
    '    --btn-hover:    #F2F2F2;   /* default button hover fill                    */' + LineEnding +
    '    --btn-active:   #E8E8E8;   /* default button pressed fill                  */' + LineEnding +
    '    --check-border: #C0C0C0;   /* checkbox / radio edge                        */' + LineEnding +
    '    --track:        #DCDCDC;   /* progress trough                              */' + LineEnding +
    '    --ghost-hover:  #0000000D; /* flat/ghost hover wash                        */' + LineEnding +
    '    --ghost-active: #0000001A; /* flat/ghost pressed wash                      */' + LineEnding +
    '    --shadow:       #0000001A; /* subtle button lift                           */' + LineEnding +
    '  }' + LineEnding +
    '}' + LineEnding +
    '' + LineEnding +
    '/* --- palette: dark ------------------------------------------------------- */' + LineEnding +
    '@mode dark {' + LineEnding +
    '  :root {' + LineEnding +
    '    --accent:       #3584E4;   /* same GNOME blue — brand/accent seed          */' + LineEnding +
    '    --window:       #242424;   /* window background                            */' + LineEnding +
    '    --header:       #303030;   /* headerbar / title bar                        */' + LineEnding +
    '    --field:        #1E1E1E;   /* text-entry wells                             */' + LineEnding +
    '    --ink:          #FFFFFF;   /* primary light text                           */' + LineEnding +
    '    --muted:        #8A8A8A;   /* disabled / secondary ink                     */' + LineEnding +
    '    --border:       #3A3A3A;   /* subtle separators & field edges              */' + LineEnding +
    '    --btn-face:     #363636;   /* default button face (top gradient stop)      */' + LineEnding +
    '    --btn-face2:    #323232;   /* default button face (bottom gradient stop)   */' + LineEnding +
    '    --btn-border:   #4A4A4A;   /* default button edge                          */' + LineEnding +
    '    --btn-hover:    #404040;   /* default button hover fill                    */' + LineEnding +
    '    --btn-active:   #2E2E2E;   /* default button pressed fill                  */' + LineEnding +
    '    --check-border: #5A5A5A;   /* checkbox / radio edge                        */' + LineEnding +
    '    --track:        #3A3A3A;   /* progress trough                              */' + LineEnding +
    '    --ghost-hover:  #FFFFFF14; /* flat/ghost hover wash                        */' + LineEnding +
    '    --ghost-active: #FFFFFF26; /* flat/ghost pressed wash                      */' + LineEnding +
    '    --shadow:       #00000040; /* subtle button lift                           */' + LineEnding +
    '  }' + LineEnding +
    '}' + LineEnding +
    '' + LineEnding +
    '/* --- window + chrome ----------------------------------------------------- */' + LineEnding +
    'TyForm            { background: var(--window); }' + LineEnding +
    'TyTitleBar        { background: var(--header); color: var(--ink); border-bottom: 1px solid var(--border); border-radius: 0; }' + LineEnding +
    'TyCaptionButton   { render-style: flat; background: transparent; color: var(--ink); border-radius: 6; }' + LineEnding +
    'TyCaptionButton:hover  { background: var(--ghost-hover);  color: var(--ink); }' + LineEnding +
    'TyCaptionButton:active { background: var(--ghost-active); color: var(--ink); }' + LineEnding +
    'TyCaptionButton.close:hover  { background: var(--ghost-hover);  color: var(--ink); }' + LineEnding +
    'TyCaptionButton.close:active { background: var(--ghost-active); color: var(--ink); }' + LineEnding +
    '' + LineEnding +
    'TyLabel           { color: var(--ink); }' + LineEnding +
    '' + LineEnding +
    '/* --- buttons ------------------------------------------------------------- */' + LineEnding +
    '/* Native GNOME default: near-white face with a whisper of top-to-bottom shading, a hairline' + LineEnding +
    '   edge, a 6px radius, a soft lift, and NORMAL-weight ink. Compact 5x9 padding. */' + LineEnding +
    'TyButton                { render-style: flat; background: linear-gradient(90deg, var(--btn-face), var(--btn-face2)); color: var(--ink); border: 1px solid var(--btn-border); border-radius: 6; padding: 5px 9px; font-weight: normal; shadow: 0 1 1 var(--shadow); }' + LineEnding +
    'TyButton:hover          { background: var(--btn-hover);  border-color: darken(var(--btn-border), 5); }' + LineEnding +
    'TyButton:active         { background: var(--btn-active); border-color: darken(var(--btn-border), 10); shadow: 0 0 0 transparent; }' + LineEnding +
    'TyButton:focus          { border-color: var(--accent); outline: 2 alpha(var(--accent), 0.4); outline-offset: 1; }' + LineEnding +
    'TyButton:disabled       { background: var(--btn-face); color: var(--muted); border-color: lighten(var(--btn-border), 2); shadow: 0 0 0 transparent; }' + LineEnding +
    '' + LineEnding +
    '/* Suggested-action = solid accent, auto-contrast ink, NORMAL weight (GNOME never bolds it). */' + LineEnding +
    'TyButton.primary          { background: var(--accent); color: on(var(--accent)); border: 1px solid darken(var(--accent), 8); border-radius: 6; padding: 5px 9px; font-weight: normal; shadow: 0 1 1 var(--shadow); }' + LineEnding +
    'TyButton.primary:hover    { background: lighten(var(--accent), 6); border-color: darken(var(--accent), 4); }' + LineEnding +
    'TyButton.primary:active   { background: darken(var(--accent), 10); border-color: darken(var(--accent), 16); shadow: 0 0 0 transparent; }' + LineEnding +
    'TyButton.primary:focus    { border-color: darken(var(--accent), 12); outline: 2 alpha(var(--accent), 0.5); outline-offset: 1; }' + LineEnding +
    'TyButton.primary:disabled { background: alpha(var(--accent), 0.4); color: alpha(#FFFFFF, 0.85); border-color: transparent; shadow: 0 0 0 transparent; }' + LineEnding +
    '' + LineEnding +
    '/* Flat/ghost = borderless; a faint wash appears on interaction. */' + LineEnding +
    'TyButton.ghost          { render-style: flat; background: transparent; color: var(--ink); border: 1px solid transparent; border-radius: 6; padding: 5px 9px; font-weight: normal; shadow: 0 0 0 transparent; }' + LineEnding +
    'TyButton.ghost:hover    { background: var(--ghost-hover);  border-color: transparent; }' + LineEnding +
    'TyButton.ghost:active   { background: var(--ghost-active); border-color: transparent; }' + LineEnding +
    'TyButton.ghost:disabled { background: transparent; color: var(--muted); border-color: transparent; }' + LineEnding +
    '' + LineEnding +
    '/* --- text inputs --------------------------------------------------------- */' + LineEnding +
    'TyEdit            { background: var(--field); color: var(--ink); border: 1px solid var(--border); border-radius: 6; padding: 5px 8px; }' + LineEnding +
    'TyEdit:hover      { border-color: darken(var(--border), 8); }' + LineEnding +
    'TyEdit:focus      { border-color: var(--accent); outline: 2 alpha(var(--accent), 0.45); outline-offset: 1; }' + LineEnding +
    'TyEdit:disabled   { background: var(--window); color: var(--muted); border-color: lighten(var(--border), 3); }' + LineEnding +
    '' + LineEnding +
    'TyComboBox        { background: var(--field); color: var(--ink); border: 1px solid var(--border); border-radius: 6; padding: 5px 8px; }' + LineEnding +
    'TyComboBox:hover  { border-color: darken(var(--border), 8); }' + LineEnding +
    'TyComboBox:focus  { border-color: var(--accent); outline: 2 alpha(var(--accent), 0.45); outline-offset: 1; }' + LineEnding +
    'TyComboBox:disabled { background: var(--window); color: var(--muted); border-color: lighten(var(--border), 3); }' + LineEnding +
    '' + LineEnding +
    '/* --- checkbox ------------------------------------------------------------ */' + LineEnding +
    '/* White well, hairline edge, accent tick; checked = solid-accent box with white tick. */' + LineEnding +
    'TyCheckBox        { background: var(--field); color: var(--accent); border: 1px solid var(--check-border); border-radius: 5; }' + LineEnding +
    'TyCheckBox:hover  { border-color: var(--accent); }' + LineEnding +
    'TyCheckBox:active { background: var(--accent); color: #FFFFFF; border: 1px solid var(--accent); border-radius: 5; }' + LineEnding +
    'TyCheckBox:disabled { background: var(--window); color: var(--muted); border-color: lighten(var(--check-border), 3); }' + LineEnding +
    '' + LineEnding +
    '/* --- radio --------------------------------------------------------------- */' + LineEnding +
    'TyRadioButton        { background: var(--field); color: var(--accent); border: 1px solid var(--check-border); }' + LineEnding +
    'TyRadioButton:hover  { border-color: var(--accent); }' + LineEnding +
    'TyRadioButton:active { background: var(--accent); color: #FFFFFF; border: 1px solid var(--accent); }' + LineEnding +
    'TyRadioButton:disabled { background: var(--window); color: var(--muted); border-color: lighten(var(--check-border), 3); }' + LineEnding +
    '' + LineEnding +
    '/* --- progress ------------------------------------------------------------ */' + LineEnding +
    '/* Slim, fully-rounded trough with a solid accent fill. */' + LineEnding +
    'TyProgressBar     { background: var(--track); border: none; border-radius: 100; }' + LineEnding +
    'TyProgressFill    { background: var(--accent); border-radius: 100; }');
  TyRegisterThemeCss('aero',
    '/* Aero — authentic Windows 7 "Aero" glossy glass. Light steel-glass window, wet-gloss' + LineEnding +
    '   3-stop buttons, thin cool blue borders, 3px corners, crisp white fields, soft shadow.' + LineEnding +
    '   Gradient angle note: 90deg runs TOP->BOTTOM, so the first stop is the top sheen.' + LineEnding +
    '' + LineEnding +
    '   DUAL-MODE: Aero glass is inherently light and has no natural dark variant, so @mode dark is' + LineEnding +
    '   made IDENTICAL to @mode light — the palette below is duplicated verbatim in both blocks.' + LineEnding +
    '   --accent stays the brand seed (used via var(--accent) in both modes) so the runtime' + LineEnding +
    '   accent-picker still recolours the whole skin. */' + LineEnding +
    '' + LineEnding +
    '/* Mode-invariant derived value: focus ring is always the accent at 55% (accent is per-mode). */' + LineEnding +
    ':root {' + LineEnding +
    '  --focus-ring: alpha(var(--accent), 0.55);' + LineEnding +
    '}' + LineEnding +
    '' + LineEnding +
    '/* ---- LIGHT palette (authentic Aero glass) ---- */' + LineEnding +
    '@mode light {' + LineEnding +
    '  :root {' + LineEnding +
    '    --accent:            #2C7FD6;   /* brand blue — runtime accent-picker recolours from here */' + LineEnding +
    '    --ink:               #1E2B3A;   /* cool dark-slate body text */' + LineEnding +
    '    --titlebar-ink:      #0A1A2A;   /* deep glass-caption ink */' + LineEnding +
    '' + LineEnding +
    '    --form-1:            #EEF3F9;   /* window steel-glass wash, top */' + LineEnding +
    '    --form-2:            #DCE6F0;   /* window steel-glass wash, bottom */' + LineEnding +
    '' + LineEnding +
    '    --titlebar-1:        #E4EEF7;   /* Aero glass caption, top sheen */' + LineEnding +
    '    --titlebar-2:        #C4D8EC;   /* Aero glass caption, base */' + LineEnding +
    '' + LineEnding +
    '    --field-bg:          #FFFFFF;   /* crisp white field well */' + LineEnding +
    '    --field-border:      #7DA2CE;   /* cool blue field / check border */' + LineEnding +
    '    --field-focus:       #3C7FB1;   /* focus border blue */' + LineEnding +
    '' + LineEnding +
    '    --btn-1:             #FDFEFF;   /* button gloss: wet upper sheen */' + LineEnding +
    '    --btn-2:             #ECF2F9;   /* button gloss: mid */' + LineEnding +
    '    --btn-3:             #DBE7F4;   /* button gloss: deeper base */' + LineEnding +
    '    --btn-border:        #718DB5;   /* button cool steel border */' + LineEnding +
    '    --btn-shadow:        #00000014; /* soft neutral drop shadow */' + LineEnding +
    '' + LineEnding +
    '    --btn-h1:            #EAF6FD;   /* hover glow, top */' + LineEnding +
    '    --btn-h2:            #D2ECFB;   /* hover glow, base */' + LineEnding +
    '' + LineEnding +
    '    --btn-a1:            #C4DCF0;   /* pressed, top (darker -> sunken) */' + LineEnding +
    '    --btn-a2:            #D9E9F8;   /* pressed, base (lifts back up) */' + LineEnding +
    '' + LineEnding +
    '    --check-bg:          #FFFFFF;   /* white check box well */' + LineEnding +
    '' + LineEnding +
    '    --track:             #DCE6F0;   /* progress track */' + LineEnding +
    '    --progress-border:   #A7C0D8;   /* progress track border */' + LineEnding +
    '' + LineEnding +
    '    --glass:             #FFFFFF;   /* white glass base for translucent lifts */' + LineEnding +
    '' + LineEnding +
    '    --close:             #E04747;   /* close-button warm glow */' + LineEnding +
    '    --close-active:      #C23030;' + LineEnding +
    '    --close-ink:         #FFFFFF;' + LineEnding +
    '' + LineEnding +
    '    --primary-shadow:    #10467A33; /* deeper accent shadow under primary */' + LineEnding +
    '  }' + LineEnding +
    '}' + LineEnding +
    '' + LineEnding +
    '/* ---- DARK palette (Aero has no natural dark variant — IDENTICAL to light) ---- */' + LineEnding +
    '@mode dark {' + LineEnding +
    '  :root {' + LineEnding +
    '    --accent:            #2C7FD6;' + LineEnding +
    '    --ink:               #1E2B3A;' + LineEnding +
    '    --titlebar-ink:      #0A1A2A;' + LineEnding +
    '' + LineEnding +
    '    --form-1:            #EEF3F9;' + LineEnding +
    '    --form-2:            #DCE6F0;' + LineEnding +
    '' + LineEnding +
    '    --titlebar-1:        #E4EEF7;' + LineEnding +
    '    --titlebar-2:        #C4D8EC;' + LineEnding +
    '' + LineEnding +
    '    --field-bg:          #FFFFFF;' + LineEnding +
    '    --field-border:      #7DA2CE;' + LineEnding +
    '    --field-focus:       #3C7FB1;' + LineEnding +
    '' + LineEnding +
    '    --btn-1:             #FDFEFF;' + LineEnding +
    '    --btn-2:             #ECF2F9;' + LineEnding +
    '    --btn-3:             #DBE7F4;' + LineEnding +
    '    --btn-border:        #718DB5;' + LineEnding +
    '    --btn-shadow:        #00000014;' + LineEnding +
    '' + LineEnding +
    '    --btn-h1:            #EAF6FD;' + LineEnding +
    '    --btn-h2:            #D2ECFB;' + LineEnding +
    '' + LineEnding +
    '    --btn-a1:            #C4DCF0;' + LineEnding +
    '    --btn-a2:            #D9E9F8;' + LineEnding +
    '' + LineEnding +
    '    --check-bg:          #FFFFFF;' + LineEnding +
    '' + LineEnding +
    '    --track:             #DCE6F0;' + LineEnding +
    '    --progress-border:   #A7C0D8;' + LineEnding +
    '' + LineEnding +
    '    --glass:             #FFFFFF;' + LineEnding +
    '' + LineEnding +
    '    --close:             #E04747;' + LineEnding +
    '    --close-active:      #C23030;' + LineEnding +
    '    --close-ink:         #FFFFFF;' + LineEnding +
    '' + LineEnding +
    '    --primary-shadow:    #10467A33;' + LineEnding +
    '  }' + LineEnding +
    '}' + LineEnding +
    '' + LineEnding +
    '/* Window: light steel-glass wash, top lighter, bottom a touch deeper. */' + LineEnding +
    'TyForm { background: linear-gradient(90deg, var(--form-1), var(--form-2)); }' + LineEnding +
    '' + LineEnding +
    '/* Title bar: Aero glass — pale sheen fading to steel blue; deep caption ink, normal weight. */' + LineEnding +
    'TyTitleBar {' + LineEnding +
    '  background: linear-gradient(90deg, var(--titlebar-1), var(--titlebar-2));' + LineEnding +
    '  color: var(--titlebar-ink);' + LineEnding +
    '  font-weight: normal;' + LineEnding +
    '}' + LineEnding +
    '' + LineEnding +
    '/* Caption buttons: glassy translucent lift; a warm red glow on close. */' + LineEnding +
    'TyCaptionButton        { background: alpha(var(--glass), 0); color: var(--titlebar-ink); border-radius: 0; }' + LineEnding +
    'TyCaptionButton:hover  { background: alpha(var(--glass), 0.55); }' + LineEnding +
    'TyCaptionButton:active { background: alpha(var(--glass), 0.78); }' + LineEnding +
    'TyCaptionButton.min:hover    { background: alpha(var(--glass), 0.55); }' + LineEnding +
    'TyCaptionButton.max:hover    { background: alpha(var(--glass), 0.55); }' + LineEnding +
    'TyCaptionButton.close:hover  { background: var(--close); color: var(--close-ink); }' + LineEnding +
    'TyCaptionButton.close:active { background: var(--close-active); color: var(--close-ink); }' + LineEnding +
    '' + LineEnding +
    'TyLabel          { background: alpha(var(--glass), 0); color: var(--ink); font-weight: normal; }' + LineEnding +
    'TyLabel:disabled { opacity: 0.5; }' + LineEnding +
    '' + LineEnding +
    '/* Buttons: the classic wet-glass gloss — 3-stop vertical gradient (bright sheen -> mid -> deeper' + LineEnding +
    '   base), thin cool steel border, 3px corners, a soft neutral shadow. Compact padding so demo' + LineEnding +
    '   captions never truncate. */' + LineEnding +
    'TyButton {' + LineEnding +
    '  background: linear-gradient(90deg, var(--btn-1), var(--btn-2), var(--btn-3));' + LineEnding +
    '  color: var(--ink);' + LineEnding +
    '  border-color: var(--btn-border);' + LineEnding +
    '  border-width: 1px;' + LineEnding +
    '  border-radius: 3px;' + LineEnding +
    '  padding: 6px;' + LineEnding +
    '  font-weight: normal;' + LineEnding +
    '  shadow: 0 1 2 var(--btn-shadow);' + LineEnding +
    '}' + LineEnding +
    'TyButton:hover {' + LineEnding +
    '  background: linear-gradient(90deg, var(--btn-h1), var(--btn-h2));' + LineEnding +
    '  border-color: var(--field-focus);' + LineEnding +
    '}' + LineEnding +
    'TyButton:active {' + LineEnding +
    '  background: linear-gradient(90deg, var(--btn-a1), var(--btn-a2));' + LineEnding +
    '  border-color: var(--field-focus);' + LineEnding +
    '  shadow: 0 1 1 var(--btn-shadow);' + LineEnding +
    '}' + LineEnding +
    'TyButton:focus    { border-color: var(--accent); outline: 2px var(--focus-ring); outline-offset: 1px; }' + LineEnding +
    'TyButton:disabled { opacity: 0.5; }' + LineEnding +
    '' + LineEnding +
    '/* Primary: glossy accent glass — bright accent sheen up top fading into the solid accent base. */' + LineEnding +
    'TyButton.primary {' + LineEnding +
    '  background: linear-gradient(90deg, lighten(var(--accent), 18%), var(--accent));' + LineEnding +
    '  color: on(var(--accent));' + LineEnding +
    '  border-color: darken(var(--accent), 10%);' + LineEnding +
    '  shadow: 0 1 2 var(--primary-shadow);' + LineEnding +
    '}' + LineEnding +
    'TyButton.primary:hover {' + LineEnding +
    '  background: linear-gradient(90deg, lighten(var(--accent), 26%), lighten(var(--accent), 6%));' + LineEnding +
    '  border-color: darken(var(--accent), 6%);' + LineEnding +
    '}' + LineEnding +
    'TyButton.primary:active {' + LineEnding +
    '  background: linear-gradient(90deg, darken(var(--accent), 4%), darken(var(--accent), 12%));' + LineEnding +
    '  border-color: darken(var(--accent), 16%);' + LineEnding +
    '  shadow: 0 1 1 var(--primary-shadow);' + LineEnding +
    '}' + LineEnding +
    'TyButton.primary:disabled { opacity: 0.5; }' + LineEnding +
    '' + LineEnding +
    '/* Ghost: transparent with accent text; fades into a faint glass panel on hover/press. */' + LineEnding +
    'TyButton.ghost {' + LineEnding +
    '  background: alpha(var(--glass), 0);' + LineEnding +
    '  color: var(--accent);' + LineEnding +
    '  border-color: alpha(var(--field-border), 0);' + LineEnding +
    '  border-width: 1px;' + LineEnding +
    '  border-radius: 3px;' + LineEnding +
    '  padding: 6px;' + LineEnding +
    '  font-weight: normal;' + LineEnding +
    '}' + LineEnding +
    'TyButton.ghost:hover    { background: alpha(var(--glass), 0.5); border-color: var(--field-focus); }' + LineEnding +
    'TyButton.ghost:active   { background: alpha(var(--btn-a1), 0.9); border-color: var(--field-focus); }' + LineEnding +
    'TyButton.ghost:selected { background: alpha(var(--btn-a1), 0.95); border-color: var(--accent); }' + LineEnding +
    'TyButton.ghost:focus    { outline: 2px var(--focus-ring); outline-offset: 1px; }' + LineEnding +
    'TyButton.ghost:disabled { opacity: 0.5; }' + LineEnding +
    '' + LineEnding +
    '/* Fields: crisp white wells, cool blue border, 3px corners, blue focus glow. */' + LineEnding +
    'TyEdit {' + LineEnding +
    '  background: var(--field-bg);' + LineEnding +
    '  color: var(--ink);' + LineEnding +
    '  border-color: var(--field-border);' + LineEnding +
    '  border-width: 1px;' + LineEnding +
    '  border-radius: 3px;' + LineEnding +
    '  padding: 4px;' + LineEnding +
    '}' + LineEnding +
