  TyRegisterThemeCss('xp',
    '/* xp — Windows XP "Luna" (blue), the authentic look (an ORIGINAL take, not a bitmap clone):' + LineEnding +
    '   a glossy ROYAL-BLUE caption that STAYS blue top-to-bottom (a bright top highlight + a lower' + LineEnding +
    '   gloss band, NOT a fade to white); the signature ALWAYS-ON caption buttons — glossy blue' + LineEnding +
    '   min/max + a glossy RED close, rounded squares with white glyphs, slightly inset with a hair' + LineEnding +
    '   of gap; the Luna beige client; silver-white rounded buttons with the orange "Luna glow" on' + LineEnding +
    '   hover and a blue focus edge; and the green XP progress fill. Accent-driven, so the runtime' + LineEnding +
    '   picker recolours the blue chrome. @mode dark == light (Luna has no dark variant).' + LineEnding +
    '   90deg = a vertical top->bottom gradient here. */' + LineEnding +
    '' + LineEnding +
    ':root {' + LineEnding +
    '  --radius: 3px;' + LineEnding +
    '  /* XP caption buttons: small glossy rounded squares (a touch wider than tall), each white-ringed. */' + LineEnding +
    '  --caption-button-width:    24;' + LineEnding +
    '  --caption-button-margin:    4;' + LineEnding +
    '  --caption-button-margin-y:  6;' + LineEnding +
    '  --caption-button-gap:       3;' + LineEnding +
    '}' + LineEnding +
    '' + LineEnding +
    '/* Light palette = the authentic XP Luna look. */' + LineEnding +
    '@mode light {' + LineEnding +
    '  :root {' + LineEnding +
    '    --accent:       #2F6FE0;   /* Luna royal blue — caption + primary + accent chrome */' + LineEnding +
    '    --on-accent:    #FFFFFF;' + LineEnding +
    '    --surface:      #ECE9D8;    /* the iconic XP client "beige" */' + LineEnding +
    '    --on-surface:   #1B1B1B;' + LineEnding +
    '    --field:        #FFFFFF;' + LineEnding +
    '    --field-border: #7B9EBD;    /* soft steel-blue field edge */' + LineEnding +
    '    --focus:        #E58B00;    /* orange focus edge */' + LineEnding +
    '    --btn-border:   #7A94B5;    /* soft blue-grey default-button edge (NOT navy) */' + LineEnding +
    '' + LineEnding +
    '    --title-ink:    #FFFFFF;' + LineEnding +
    '    /* Glossy RED close-button stops. */' + LineEnding +
    '    --close-top:    #F4AB92;' + LineEnding +
    '    --close-mid:    #DC4E31;' + LineEnding +
    '    --close-bot:    #B23018;' + LineEnding +
    '  }' + LineEnding +
    '}' + LineEnding +
    '' + LineEnding +
    '/* Dark palette — IDENTICAL to light (no natural dark Luna variant). */' + LineEnding +
    '@mode dark {' + LineEnding +
    '  :root {' + LineEnding +
    '    --accent:       #2F6FE0;' + LineEnding +
    '    --on-accent:    #FFFFFF;' + LineEnding +
    '    --surface:      #ECE9D8;' + LineEnding +
    '    --on-surface:   #1B1B1B;' + LineEnding +
    '    --field:        #FFFFFF;' + LineEnding +
    '    --field-border: #7B9EBD;' + LineEnding +
    '    --focus:        #E58B00;' + LineEnding +
    '    --btn-border:   #7A94B5;' + LineEnding +
    '' + LineEnding +
    '    --title-ink:    #FFFFFF;' + LineEnding +
    '    --close-top:    #F4AB92;' + LineEnding +
    '    --close-mid:    #DC4E31;' + LineEnding +
    '    --close-bot:    #B23018;' + LineEnding +
    '  }' + LineEnding +
    '}' + LineEnding +
    '' + LineEnding +
    '/* Window: the Luna beige client area, wrapped in the iconic blue XP window frame (drawn on the' + LineEnding +
    '   side + bottom edges; the caption bar is the top). */' + LineEnding +
    'TyForm { background: var(--surface); border-color: var(--accent); border-width: 3px; }' + LineEnding +
    '' + LineEnding +
    '/* Caption: glossy Luna blue that STAYS blue — a bright highlight at the very top, the body' + LineEnding +
    '   blue, then a subtle lower gloss band and a slightly darker bottom edge. Accent-derived. */' + LineEnding +
    'TyTitleBar {' + LineEnding +
    '  background: linear-gradient(90deg,' + LineEnding +
    '    lighten(var(--accent), 30%) 0%,' + LineEnding +
    '    lighten(var(--accent), 6%)  7%,' + LineEnding +
    '    darken(var(--accent), 4%)   46%,' + LineEnding +
    '    var(--accent)               54%,' + LineEnding +
    '    lighten(var(--accent), 6%)  90%,' + LineEnding +
    '    darken(var(--accent), 16%)  100%);' + LineEnding +
    '  color: var(--title-ink);' + LineEnding +
    '  font-weight: bold;' + LineEnding +
    '  border-radius: 0;' + LineEnding +
    '}' + LineEnding +
    '' + LineEnding +
    '/* Caption buttons: ALWAYS-ON glossy rounded squares. Base (min/max) = glossy blue; .close = the' + LineEnding +
    '   iconic glossy red. White glyphs; hover brightens; press darkens. */' + LineEnding +
    'TyCaptionButton {' + LineEnding +
    '  background: linear-gradient(90deg, lighten(var(--accent), 34%) 0%, lighten(var(--accent), 4%) 46%, darken(var(--accent), 10%) 100%);' + LineEnding +
    '  color: #FFFFFF;' + LineEnding +
    '  border-color: #FFFFFF;' + LineEnding +
    '  border-width: 1px;' + LineEnding +
    '  border-radius: 3px;' + LineEnding +
    '}' + LineEnding +
    'TyCaptionButton:hover        { background: linear-gradient(90deg, lighten(var(--accent), 46%) 0%, lighten(var(--accent), 16%) 46%, var(--accent) 100%); }' + LineEnding +
    'TyCaptionButton:active       { background: linear-gradient(90deg, darken(var(--accent), 6%) 0%, darken(var(--accent), 18%) 100%); }' + LineEnding +
    'TyCaptionButton.close        { background: linear-gradient(90deg, var(--close-top) 0%, var(--close-mid) 46%, var(--close-bot) 100%); border-color: #FFFFFF; }' + LineEnding +
    'TyCaptionButton.close:hover  { background: linear-gradient(90deg, #F9C4AF 0%, #EE6046 46%, #CB3B1E 100%); }' + LineEnding +
    'TyCaptionButton.close:active { background: linear-gradient(90deg, #B23018 0%, #8C2310 100%); }' + LineEnding +
    '' + LineEnding +
    'TyLabel          { color: var(--on-surface); }' + LineEnding +
    'TyLabel:disabled { opacity: 0.5; }' + LineEnding +
    '' + LineEnding +
    '/* Default button: silver-white rounded gradient, soft blue-grey edge; orange Luna glow on hover,' + LineEnding +
    '   pressed silver, blue+orange focus. */' + LineEnding +
    'TyButton {' + LineEnding +
    '  background: linear-gradient(90deg, #FDFEFF 0%, #F4F5F1 48%, #E4E6DE 100%);' + LineEnding +
    '  color: var(--on-surface);' + LineEnding +
    '  border-color: var(--btn-border);' + LineEnding +
    '  border-width: 1px;' + LineEnding +
    '  border-radius: var(--radius);' + LineEnding +
    '  padding: 5px 12px;' + LineEnding +
    '  font-weight: normal;' + LineEnding +
    '}' + LineEnding +
    'TyButton:hover    { background: linear-gradient(90deg, #FFF7E9 0%, #FDE7C4 100%); border-color: #E0A020; }' + LineEnding +
    'TyButton:active   { background: linear-gradient(90deg, #DDE1DA 0%, #ECEEE8 100%); border-color: #6A84A5; }' + LineEnding +
    'TyButton:focus    { border-color: var(--accent); outline: 2px var(--focus); outline-offset: 1px; }' + LineEnding +
    'TyButton:disabled { opacity: 0.5; }' + LineEnding +
    '' + LineEnding +
    '/* Primary = the glossy blue Luna action button (pale-blue top -> accent -> darker bottom). */' + LineEnding +
    'TyButton.primary {' + LineEnding +
    '  background: linear-gradient(90deg, lighten(var(--accent), 24%) 0%, var(--accent) 55%, darken(var(--accent), 12%) 100%);' + LineEnding +
    '  color: var(--on-accent);' + LineEnding +
    '  border-color: darken(var(--accent), 22%);' + LineEnding +
    '  border-width: 1px;' + LineEnding +
    '  border-radius: var(--radius);' + LineEnding +
    '  padding: 5px 12px;' + LineEnding +
    '  font-weight: normal;' + LineEnding +
    '}' + LineEnding +
    'TyButton.primary:hover    { background: linear-gradient(90deg, lighten(var(--accent), 34%) 0%, lighten(var(--accent), 8%) 100%); border-color: #E0A020; }' + LineEnding +
    'TyButton.primary:active   { background: linear-gradient(90deg, darken(var(--accent), 8%) 0%, darken(var(--accent), 18%) 100%); }' + LineEnding +
    'TyButton.primary:focus    { outline: 2px var(--focus); outline-offset: 1px; }' + LineEnding +
    'TyButton.primary:disabled { opacity: 0.5; }' + LineEnding +
    '' + LineEnding +
    '/* Ghost: transparent with accent text; a soft blue wash on touch. */' + LineEnding +
    'TyButton.ghost {' + LineEnding +
    '  background: alpha(var(--accent), 0);' + LineEnding +
    '  color: var(--accent);' + LineEnding +
    '  border-color: alpha(var(--accent), 0);' + LineEnding +
    '  border-width: 1px;' + LineEnding +
    '  border-radius: var(--radius);' + LineEnding +
    '  padding: 5px 12px;' + LineEnding +
    '  font-weight: normal;' + LineEnding +
    '}' + LineEnding +
    'TyButton.ghost:hover    { background: alpha(var(--accent), 0.12); border-color: alpha(var(--accent), 0.40); }' + LineEnding +
    'TyButton.ghost:active   { background: alpha(var(--accent), 0.20); }' + LineEnding +
    'TyButton.ghost:selected { background: alpha(var(--accent), 0.20); border-color: var(--accent); }' + LineEnding +
    'TyButton.ghost:focus    { outline: 2px var(--focus); outline-offset: 1px; }' + LineEnding +
    'TyButton.ghost:disabled { opacity: 0.5; }' + LineEnding +
    '' + LineEnding +
    '/* Fields: crisp white wells, steel-blue border, orange focus edge. */' + LineEnding +
    'TyEdit {' + LineEnding +
    '  background: var(--field);' + LineEnding +
    '  color: var(--on-surface);' + LineEnding +
    '  border-color: var(--field-border);' + LineEnding +
    '  border-width: 1px;' + LineEnding +
    '  border-radius: var(--radius);' + LineEnding +
    '  padding: 4px 6px;' + LineEnding +
    '}' + LineEnding +
    'TyEdit:hover    { border-color: var(--accent); }' + LineEnding +
    'TyEdit:focus    { border-color: var(--focus); outline: 2px var(--focus); }' + LineEnding +
    'TyEdit:disabled { opacity: 0.5; }' + LineEnding +
    '' + LineEnding +
    'TyComboBox {' + LineEnding +
    '  background: var(--field);' + LineEnding +
    '  color: var(--on-surface);' + LineEnding +
    '  border-color: var(--field-border);' + LineEnding +
    '  border-width: 1px;' + LineEnding +
    '  border-radius: var(--radius);' + LineEnding +
    '  padding: 4px 6px;' + LineEnding +
    '}' + LineEnding +
    'TyComboBox:hover    { border-color: var(--accent); }' + LineEnding +
    'TyComboBox:focus    { border-color: var(--focus); outline: 2px var(--focus); }' + LineEnding +
    'TyComboBox:disabled { opacity: 0.5; }' + LineEnding +
    '' + LineEnding +
    '/* Check box: white box, blue-grey border, accent tick; checked = solid accent fill. */' + LineEnding +
    'TyCheckBox {' + LineEnding +
    '  background: var(--field);' + LineEnding +
    '  color: var(--accent);' + LineEnding +
    '  border-color: var(--field-border);' + LineEnding +
    '  border-width: 1px;' + LineEnding +
    '  border-radius: 2px;' + LineEnding +
    '  padding: 4px;' + LineEnding +
    '}' + LineEnding +
    'TyCheckBox:hover    { border-color: var(--accent); }' + LineEnding +
    'TyCheckBox:active   { background: var(--accent); color: var(--on-accent); border-color: darken(var(--accent), 12%); }' + LineEnding +
    'TyCheckBox:focus    { outline: 2px var(--focus); }' + LineEnding +
    'TyCheckBox:disabled { opacity: 0.5; }' + LineEnding +
    '' + LineEnding +
    '/* Radio: sibling of the check box, fully rounded. */' + LineEnding +
    'TyRadioButton {' + LineEnding +
    '  background: var(--field);' + LineEnding +
    '  color: var(--accent);' + LineEnding +
    '  border-color: var(--field-border);' + LineEnding +
    '  border-width: 1px;' + LineEnding +
    '  border-radius: 9px;' + LineEnding +
    '  padding: 4px;' + LineEnding +
    '}' + LineEnding +
    'TyRadioButton:hover    { border-color: var(--accent); }' + LineEnding +
    'TyRadioButton:active   { background: var(--accent); color: var(--on-accent); border-color: darken(var(--accent), 12%); }' + LineEnding +
    'TyRadioButton:focus    { outline: 2px var(--focus); }' + LineEnding +
    'TyRadioButton:disabled { opacity: 0.5; }' + LineEnding +
    '' + LineEnding +
    '/* Progress: a sunken white trough with the iconic XP green fill. */' + LineEnding +
    'TyProgressBar {' + LineEnding +
    '  background: var(--field);' + LineEnding +
    '  border-color: var(--field-border);' + LineEnding +
    '  border-width: 1px;' + LineEnding +
    '  border-radius: 3px;' + LineEnding +
    '  render-style: inset3d;' + LineEnding +
    '}' + LineEnding +
    'TyProgressBar:disabled { opacity: 0.5; }' + LineEnding +
    '' + LineEnding +
    'TyProgressFill {' + LineEnding +
    '  background: linear-gradient(90deg, #9BE06B 0%, #6BBF3A 55%, #4E9E27 100%);' + LineEnding +
    '  border-radius: 2px;' + LineEnding +
    '}');
end;

function TyBuiltinSkinNames: TStringArray;
const N: array[0..14] of string = ('adwaita', 'aero', 'antdesign', 'bootstrap', 'breeze', 'classic', 'fluent', 'macos', 'material3', 'office', 'showcase', 'ubuntu', 'win10', 'win11', 'xp');
var i: Integer;
begin
  SetLength(Result, Length(N));
  for i := 0 to High(N) do Result[i] := N[i];
end;

end.
