unit tyControls.AdvChart.Catalog;
{$mode objfpc}{$H+}
{ GENERATED FILE -- DO NOT EDIT BY HAND.

  The Apache ECharts 6.1.0 option vocabulary, as a deduplicated DAG.
  Regenerate with:  node tools/advchart/gen-catalog.js
  and, when the targeted ECharts version moves, re-extract first with:
                    node tools/advchart/extract-catalog.js <schemaDir>

  WHY A DAG. The schema repeats itemStyle, label and textStyle physically under
  every parent: 57,785 node occurrences collapse to 2,455 distinct records,
  a 23.5x reduction. A flat table of every path would be tens of megabytes
  of literals and would not compile in practice.

  WHAT IS ABSENT: the option descriptions. This repo keeps its source ASCII --
  no unit carries a non-ASCII string literal -- and translatable text goes
  through .po. The English and Chinese summaries live in the committed
  tools/advchart/catalog.json, indexed by the SAME node index this unit uses
  (TyOptDescEn / TyOptDescZh below are those indices), so a design-time editor
  reads them from there without any of it reaching a compiled runtime unit.

  Lookup, path normalisation and validation are NOT here: they are hand-written
  in tyControls.AdvChart.Complete, so they stay readable and testable while this
  file stays pure data. Same split as Css.Catalog / Css.Complete. }
interface

type
  { One node of the option DAG. Every string field is an index into TyOptStr;
    0 is the empty string, so "not set" needs no sentinel. DefaultStr and
    EnumStr use -1 for absent, because an empty default and no default are
    different things. }
  TTyOptNode = record
    TypeStr: Integer;       // e.g. 'number', 'string|Array', 'Object'
    DefaultStr: Integer;    // -1 when the schema states no default
    UiStr: Integer;         // uiControl.type: 'color', 'percent', 'enum', ...
    EnumStr: Integer;       // comma-separated allowed values, -1 when none
    MinStr, MaxStr, StepStr: Integer;
    SinceStr: Integer;      // '6.1.0' etc, 0 when the option is not versioned
    DescEn, DescZh: Integer;// indices into catalog.json's desc pool, not into TyOptStr
    FirstChild, ChildCount: Integer;   // slice of TyOptEdge
  end;

  { One parent -> child edge. NameStr is the property name, except for two
    structural spellings the schema itself uses:
      '[]'      the element type of a homogeneous array
      '=<tag>' one member of a discriminated union, tagged by the value of
                its own `type` option -- '=line', '=bar', '=slider'. Five
                containers use these: series (23), graphic.elements (13),
                dataset.transform (3), dataZoom (2), visualMap (2). }
  TTyOptEdge = record
    NameStr: Integer;
    Node: Integer;
  end;

