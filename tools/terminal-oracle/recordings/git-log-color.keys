export GIT_AUTHOR_NAME=Test GIT_AUTHOR_EMAIL=test@example.com GIT_COMMITTER_NAME=Test GIT_COMMITTER_EMAIL=test@example.com GIT_CONFIG_NOSYSTEM=1
git init -q -b main repo && cd repo
for i in $(seq 1 30); do f=notes.txt; if [ $i -gt 10 ] && [ $i -le 20 ]; then f=side.txt; fi; echo "change $i" >> $f; git add $f; d="2026-01-$(printf %02d $(( (i % 28) + 1 )))T12:00:00Z"; GIT_AUTHOR_DATE=$d GIT_COMMITTER_DATE=$d git commit -qm "Commit number $i"; if [ $i = 10 ]; then git checkout -qb side; fi; if [ $i = 20 ]; then git checkout -q main; fi; done
#sleep 3
GIT_AUTHOR_DATE=2026-02-01T12:00:00Z GIT_COMMITTER_DATE=2026-02-01T12:00:00Z git merge -q --no-edit side; clear
git log --color --graph --oneline --decorate -n 40 | cat
#sleep 1
git log --color --stat -n 3 | cat
#sleep 1
