#: tycontrols.strconsts.rsricheditincomplete
msgid "The document was not loaded completely, so it cannot be saved."
msgstr "文档没有完整载入,不能保存。"

#: tycontrols.strconsts.rsricheditcannotchange
msgid "The document cannot be changed now: it is still loading, incomplete or being saved."
msgstr "文档现在不能修改:它还在载入、没有载入完整,或者正在保存。"

#: tycontrols.strconsts.rsricheditcannotreplace
msgid "The file %s could not be replaced; it was left as it was."
msgstr "无法替换文件 %s,原文件保持不变。"

#: tycontrols.strconsts.rsricheditcannotwrite
msgid "The file %s cannot be written; it was left as it was."
msgstr "无法写入文件 %s,原文件保持不变。"

#: tycontrols.strconsts.rsricheditbusy
msgid "The document cannot be replaced now: it is being loaded or saved."
msgstr "文档正在载入或保存，现在不能替换。"

#: tycontrols.strconsts.rsricheditreplaceinedit
msgid "The document cannot be replaced between BeginEdit and EndEdit: the block is one undo step, and a new content has no undo."
msgstr "在 BeginEdit 与 EndEdit 之间不能替换文档：这一段是一个撤销步骤，而新内容无法撤销。"

#: tycontrols.strconsts.rsricheditrefusedloading
msgid "The document is still being loaded: it cannot be changed yet."
msgstr "文档还在载入，现在还不能修改。"

#: tycontrols.strconsts.rsricheditrefusedincomplete
msgid "The document holds only a part of its file (the load was cancelled): it cannot be changed."
msgstr "文档只有文件的一部分（载入被取消了），不能修改。"

#: tycontrols.strconsts.rsricheditrefusedsaving
msgid "The document is being saved: it cannot be changed meanwhile."
msgstr "文档正在保存，保存完之前不能修改。"

#: tycontrols.strconsts.rsricheditrefusedfixedrow
msgid "This table row holds a nested table and is kept as the file has it: its text cannot be changed."
msgstr "这一行表格里套着另一个表格，按文件原样保留，里面的文字不能修改。"

#: tycontrols.strconsts.rsricheditrefusedrange
msgid "This part of the document cannot be edited."
msgstr "文档的这一部分不能编辑。"

#: tycontrols.strconsts.rsricheditrefusedcells
msgid "This selection across table cells cannot be cut or changed this way (cells selected alone can be cleared or typed over)."
msgstr "这个跨越表格单元格的选区不能这样剪切或修改（只选中单元格时可以清空或改写）。"

#: tycontrols.strconsts.rsricheditrefusedpicture
msgid "The picture is too large to go into the document."
msgstr "图片太大，不能放进文档。"

#: tycontrols.strconsts.rsricheditrefusedplainpaste
msgid "A plain text document takes only text: a picture or formatted text cannot be pasted into it."
msgstr "纯文本文档只能粘贴文字，不能粘贴图片或带格式的文字。"

#: tycontrols.strconsts.rsricheditrefusedmemory
msgid "There is not enough memory to paste this."
msgstr "内存不足，无法粘贴。"

#: tycontrols.strconsts.rsricheditrefusedpasterows
msgid "Table rows cannot be pasted over rows of a table: paste them outside the table, or into a cell as its text."
msgstr "复制的表格行不能粘贴到表格的行上：请粘贴到表格外面，或者粘贴到一个单元格里作为它的文字。"

#: tycontrols.strconsts.rsricheditrefusedfield
msgid "This text is a field's result (a link, a page number, a table of contents). It cannot be changed here; select the whole field to delete it."
msgstr "这段文字是域的结果（链接、页码、目录），不能在这里修改；要删除它，请选中整个域。"

#: tycontrols.strconsts.rsricheditrefusedplainpicture
msgid "A plain text document cannot hold a picture."
msgstr "纯文本文档里不能有图片。"

#: tycontrols.strconsts.rsricheditrefusedmetafile
msgid "A metafile (WMF or EMF) cannot be inserted as a picture."
msgstr "图元文件（WMF 或 EMF）不能作为图片插入。"

#: tycontrols.strconsts.rsricheditrefusednopicture
msgid "This is not a picture that can be read."
msgstr "这不是能读取的图片。"

#: tycontrols.strconsts.rsricheditrefusedpicturefile
#, object-pascal-format
msgid "The picture file cannot be read: %s"
msgstr "无法读取图片文件：%s"

#: tycontrols.strconsts.rsricheditrefusedpage
msgid "The page's margins leave no width for the text."
msgstr "页边距没有给正文留下宽度。"

#: tycontrols.strconsts.rsricheditrefusedplainlink
msgid "A plain text document cannot hold a link."
msgstr "纯文本文档里不能有链接。"

#: tycontrols.strconsts.rsricheditrefusedlinkaddress
msgid "A link needs an address."
msgstr "链接需要一个地址。"

#: tycontrols.strconsts.rsricheditrefusedlinkparagraphs
msgid "A link's text lies within one paragraph: select text inside a paragraph (or a table cell)."
msgstr "链接的文字只能在一个段落里：请在一个段落（或一个单元格）之内选择文字。"

#: tycontrols.strconsts.rsricheditrefusedlinkaroundfield
msgid "A link cannot be made around a link or another field."
msgstr "不能在链接或其他域的外面再套一个链接。"

#: tycontrols.strconsts.rsricheditrefusednolink
msgid "There is no link at the caret."
msgstr "光标处没有链接。"

#: tycontrols.strconsts.rsricheditrefusedplainbookmark
msgid "A plain text document cannot hold a bookmark."
msgstr "纯文本文档里不能有书签。"

#: tycontrols.strconsts.rsricheditrefusedbookmarkname
msgid "A bookmark's name begins with a letter and holds only letters, digits and \"_\" - at most 40 of them."
msgstr "书签名必须以字母或汉字开头，只能含字母、数字和“_”，最多 40 个字符。"

#: tycontrols.strconsts.rsricheditrefusednobookmark
msgid "There is no bookmark of that name."
msgstr "没有这个名字的书签。"

#: tycontrols.strconsts.rsricheditrefusedbookmarkexists
msgid "There is a bookmark of that name already."
msgstr "已经有这个名字的书签了。"

#: tycontrols.strconsts.rsrichpicturenotshown
msgid "This picture cannot be made an image: it is a metafile that draws more than one bitmap, or of a format the control does not read."
msgstr "这张图片无法转成图像：它是画了不止一个位图的图元文件，或是控件读不了的格式。"

#: tycontrols.strconsts.rsricheditrefusedplaintable
msgid "A plain text document cannot hold a table."
msgstr "纯文本文档里不能有表格。"

#: tycontrols.strconsts.rsricheditrefusednotable
msgid "The caret is not in a table."
msgstr "光标不在表格里。"

#: tycontrols.strconsts.rsricheditrefusedtableintable
msgid "A table cannot be inserted into a table."
msgstr "不能在表格里插入表格。"

#: tycontrols.strconsts.rsricheditrefusedmergedcells
msgid "This table has merged cells: its rows and columns cannot be inserted or deleted."
msgstr "这个表格有合并的单元格，不能插入或删除它的行和列。"

#: tycontrols.strconsts.rsricheditrefusednestedtable
msgid "This table has a table inside one of its cells: its rows and columns cannot be inserted or deleted."
msgstr "这个表格的单元格里套着另一个表格，不能插入或删除它的行和列。"

#: tycontrols.strconsts.rsricheditrefusedtablenotwhole
msgid "This table is too large, or not complete in its file, for its rows and columns to be inserted or deleted."
msgstr "这个表格太大，或者在文件里不完整，不能插入或删除它的行和列。"

#: tycontrols.strconsts.rsricheditrefuseddeletenotwhole
msgid "This table is too large, or not complete in its file, to be deleted as a whole."
msgstr "这个表格太大，或者在文件里不完整，不能整个删除。"

#: tycontrols.strconsts.rsricheditrefusedselectnotwhole
msgid "This table is too large, or not complete in its file, for a whole column or the whole table to be selected."
msgstr "这个表格太大，或者在文件里不完整，不能选中整列或整个表格。"

#: tycontrols.strconsts.rsricheditrefusedresizenotwhole
msgid "This table is too large, or not complete in its file, for a whole column to be resized."
msgstr "这个表格太大，或者在文件里不完整，不能调整整列的宽度。"

#: tycontrols.strconsts.rsricheditrefusedresizenested
msgid "This row holds a table inside one of its cells: its cells' widths, its height and its look cannot be changed."
msgstr "这一行的单元格里有表格：不能改它的列宽、行高和格式。"

#: tycontrols.strconsts.rsricheditrefusednotrectangle
msgid "The selected cells do not form a rectangle: they cannot be merged into one cell."
msgstr "选中的单元格不成矩形，不能合并成一个单元格。"

#: tycontrols.strconsts.rsricheditrefusedmergewhich
msgid "Select two or more cells of one table to merge them."
msgstr "请选中同一个表格里的两个或更多单元格再合并。"

#: tycontrols.strconsts.rsricheditrefusedmergenested
msgid "This table has a table inside one of its cells: its cells cannot be merged."
msgstr "这个表格的单元格里套着另一个表格，不能合并它的单元格。"

#: tycontrols.strconsts.rsricheditrefusedsplitnested
msgid "This table has a table inside one of its cells: its cells cannot be split."
msgstr "这个表格的单元格里套着另一个表格，不能拆分它的单元格。"

#: tycontrols.strconsts.rsricheditrefusedsplitnumbers
msgid "A cell is split into 1 or more columns and 1 or more rows, two parts at least."
msgstr "拆分单元格时列数和行数都至少为 1，且至少拆成两部分。"

#: tycontrols.strconsts.rsricheditrefusedsplitrows
msgid "The rows must divide the %d rows the cell covers."
msgstr "行数必须能整除这个单元格所跨的 %d 行。"

#: tycontrols.strconsts.rsricheditrefusedsplitcells
msgid "A row has at most %d cells."
msgstr "一行最多有 %d 个单元格。"

#: tycontrols.strconsts.rsricheditrefusedsplittablerows
msgid "A table has at most %d rows."
msgstr "一个表格最多有 %d 行。"

#: tycontrols.strconsts.rsricheditrefusedsplitwhich
msgid "Put the caret in a cell, or select one cell, to split it."
msgstr "请把光标放在一个单元格里，或选中一个单元格，再拆分。"

#: tycontrols.strconsts.rsricheditrefuseddistributemerged
msgid "This table has merged cells: its columns cannot be made equally wide."
msgstr "这个表格有合并的单元格：不能把各列调成一样宽。"

#: tycontrols.strconsts.rsricheditrefusedformatnotwhole
msgid "This table is too large, or not complete in its file, for all of its rows to be changed."
msgstr "这个表格太大，或者在文件里不完整，不能修改它的所有行。"

#: tycontrols.strconsts.rsricheditpastecellsdropped
msgid "Some of the pasted cells did not fit in the table's columns and were left out."
msgstr "粘贴的单元格有一部分超出了表格的列，没有粘贴进去。"

#: tycontrols.strconsts.rsricheditrefusedirregularrows
msgid "The rows of this table do not all have the same number of cells: its columns cannot be inserted or deleted."
msgstr "这个表格各行的单元格数不一样，不能插入或删除它的列。"

#: tycontrols.strconsts.rsricheditrefusedtablesize
#, object-pascal-format
msgid "A table can have 1 to %d rows and 1 to %d columns."
msgstr "表格可以有 1 到 %d 行、1 到 %d 列。"

#: tycontrols.strconsts.rsricheditrefusedtablecolumns
#, object-pascal-format
msgid "This table has as many columns as a table can have (%d)."
msgstr "这个表格的列数已经是表格能有的最多列数（%d）。"

#: tycontrols.strconsts.rsricheditrefusedlongpara
msgid "This paragraph is too long to edit here: what is typed past the part shown would not be seen."
msgstr "这个段落太长，不能在这里编辑：在显示部分之外输入的文字会看不到。"

#: tycontrols.strconsts.rsrichmodelnestedrow
msgid "This row holds a nested table and is kept as the file has it: its text cannot be changed"
msgstr "这一行表格里套着另一个表格，按文件原样保留，里面的文字不能修改"

#: tycontrols.strconsts.rsrichmodelpartrefused
#, object-pascal-format
msgid "Part %d of the command (%s) cannot be carried out"
msgstr "命令的第 %d 部分（%s）无法执行"

#: tycontrols.strconsts.rsricheditparanotshown
msgid "%s more characters of this paragraph are not shown."
msgstr "本段还有 %s 个字符没有显示。"

