<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <Flags>
        <MainUnitHasCreateFormStatements Value="True"/>
        <MainUnitHasTitleStatement Value="False"/>
      </Flags>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="Theme Builder"/>
      <Scaled Value="True"/>
      <UseXPManifest Value="True"/>
      <XPManifest>
        <DpiAware Value="True/PM_V2"/>
      </XPManifest>
    </General>
    <i18n>
      <EnableI18N Value="True"/>
      <OutDir Value="languages"/>
    </i18n>
    <BuildModes Count="1"><Item1 Name="Default" Default="True"/></BuildModes>
    <RequiredPackages Count="3">
      <Item1><PackageName Value="LCL"/></Item1>
      <Item2><PackageName Value="BGRABitmapPack"/></Item2>
      <Item3><PackageName Value="SynEdit"/></Item3>
    </RequiredPackages>
    <Units Count="13">
      <Unit0><Filename Value="themebuilder.lpr"/><IsPartOfProject Value="True"/></Unit0>
      <Unit1><Filename Value="tbdocument.pas"/><IsPartOfProject Value="True"/><UnitName Value="tbdocument"/></Unit1>
      <Unit2><Filename Value="tbsettings.pas"/><IsPartOfProject Value="True"/><UnitName Value="tbsettings"/></Unit2>
      <Unit3><Filename Value="tbthemesource.pas"/><IsPartOfProject Value="True"/><UnitName Value="tbthemesource"/></Unit3>
      <Unit4><Filename Value="tbtemplates.pas"/><IsPartOfProject Value="True"/><UnitName Value="tbtemplates"/></Unit4>
      <Unit5><Filename Value="tbproblems.pas"/><IsPartOfProject Value="True"/><UnitName Value="tbproblems"/></Unit5>
      <Unit6><Filename Value="tbpreview.pas"/><IsPartOfProject Value="True"/><ComponentName Value="PreviewFrame"/><HasResources Value="True"/><ResourceBaseClass Value="Frame"/><UnitName Value="tbpreview"/></Unit6>
      <Unit7><Filename Value="tbsamplewin.pas"/><IsPartOfProject Value="True"/><ComponentName Value="TbSampleForm"/><HasResources Value="True"/><ResourceBaseClass Value="Form"/><UnitName Value="tbsamplewin"/></Unit7>
      <Unit8><Filename Value="tbmain.pas"/><IsPartOfProject Value="True"/><ComponentName Value="TbMainForm"/><HasResources Value="True"/><ResourceBaseClass Value="Form"/><UnitName Value="tbmain"/></Unit8>
      <Unit9><Filename Value="tbeditorlook.pas"/><IsPartOfProject Value="True"/><UnitName Value="tbeditorlook"/></Unit9>
      <Unit10><Filename Value="tbcssscan.pas"/><IsPartOfProject Value="True"/><UnitName Value="tbcssscan"/></Unit10>
      <Unit11><Filename Value="tbseeds.pas"/><IsPartOfProject Value="True"/><UnitName Value="tbseeds"/></Unit11>
      <Unit12><Filename Value="tbseedsframe.pas"/><IsPartOfProject Value="True"/><ComponentName Value="SeedsFrame"/><HasResources Value="True"/><ResourceBaseClass Value="Frame"/><UnitName Value="tbseedsframe"/></Unit12>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="lib/$(TargetCPU)-$(TargetOS)/themebuilder"/>
    </Target>
    <SearchPaths>
      <OtherUnitFiles Value=".;../../source;../../designtime"/>
      <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <SyntaxOptions><SyntaxMode Value="ObjFPC"/></SyntaxOptions>
    <Linking>
      <Options>
        <Win32>
          <GraphicApplication Value="True"/>
        </Win32>
      </Options>
    </Linking>
  </CompilerOptions>
</CONFIG>
