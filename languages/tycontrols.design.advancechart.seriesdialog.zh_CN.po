#: tycontrols.design.advancechart.seriesdialog.rsserdlgaddcolumn
msgid "Add column"
msgstr "加一列"

#: tycontrols.design.advancechart.seriesdialog.rsserdlgaddrow
msgid "Add row"
msgstr "加一行"

