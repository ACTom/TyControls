#: tycontrols.advancechart.strconsts.rstychartnosuchhandler
#, object-pascal-format
msgid "No formatter named '%s' is registered."
msgstr "没有注册名为 '%s' 的格式化器。"

#: tycontrols.advancechart.strconsts.rstyopttoodeep
#, object-pascal-format
msgid "The option is nested more than %d levels deep."
msgstr "选项的嵌套超过了 %d 层。"

#: tycontrols.advancechart.strconsts.rstyoptfunctionvalue
msgid "JavaScript functions cannot be used here. Write a template string such as '{b}: {c}', or the name of a registered handler such as '@MyFormatter'."
msgstr "这里不能写 JavaScript 函数。请改用模板串，例如 '{b}: {c}'，或已注册的处理器名，例如 '@MyFormatter'。"

#: tycontrols.advancechart.strconsts.rstyoptmergenotobject
msgid "An option to merge must be an object."
msgstr "要合并的选项必须是一个对象。"

#: tycontrols.advancechart.strconsts.rstyoptduplicateid
#, object-pascal-format
msgid "Two %s components carry the id \"%s\"."
msgstr "有两个 %s 组件用了同一个 id \"%s\"。"

#: tycontrols.advancechart.strconsts.rstyoptreplacemergebadtype
#, object-pascal-format
msgid "replaceMerge names \"%s\", which is not a component main type."
msgstr "replaceMerge 里的 \"%s\" 不是组件主类型。"

#: tycontrols.advancechart.strconsts.rstyoptsetoptsnotobject
msgid "The setOption options must be an object."
msgstr "setOption 的选项必须是一个对象。"

#: tycontrols.advancechart.strconsts.rstychartaxistypeunknown
#, object-pascal-format
msgid "%s[%d].type: \"%s\" is not one of value, category, time or log; treated as value"
msgstr "%s[%d].type：“%s”不是 value、category、time 或 log 之一，按 value 处理"

#: tycontrols.advancechart.strconsts.rstychartaxiswithoutpair
msgid "xAxis or yAxis without the other: no grid was created, so neither is drawn"
msgstr "xAxis 与 yAxis 只有一个：没有生成 grid，两条轴都不会画"

#: tycontrols.advancechart.strconsts.rstychartxaxisnogrid
#, object-pascal-format
msgid "xAxis[%d] names no grid, so it is not drawn"
msgstr "xAxis[%d] 没有指向任何 grid，因此不会画"

#: tycontrols.advancechart.strconsts.rstychartyaxisnogrid
#, object-pascal-format
msgid "yAxis[%d] names no grid, so it is not drawn"
msgstr "yAxis[%d] 没有指向任何 grid，因此不会画"

#: tycontrols.advancechart.strconsts.rstychartgridonedirection
#, object-pascal-format
msgid "grid[%d] has axes in only one direction, so it draws nothing"
msgstr "grid[%d] 只有一个方向上有轴，因此什么都不会画"

#: tycontrols.advancechart.strconsts.rstychartpolarnoaxis
#, object-pascal-format
msgid "polar[%d] has no %s, so it is not drawn"
msgstr "polar[%d] 没有 %s，因此不会画"

#: tycontrols.advancechart.strconsts.rstychartseriesnotype
#, object-pascal-format
msgid "series[%d] has no type, so it is not drawn"
msgstr "series[%d] 没有 type，因此不会画"

#: tycontrols.advancechart.strconsts.rstychartseriesbadtype
#, object-pascal-format
msgid "series[%d]: \"%s\" is not a series type"
msgstr "series[%d]：“%s”不是一种 series 类型"

#: tycontrols.advancechart.strconsts.rstychartseriescoordsys
#, object-pascal-format
msgid "series[%d]: coordinateSystem \"%s\" is not built yet"
msgstr "series[%d]：coordinateSystem“%s”尚未实现"

#: tycontrols.advancechart.strconsts.rstychartseriesnorenderer
#, object-pascal-format
msgid "series[%d]: the \"%s\" series type is not drawn yet"
msgstr "series[%d]：“%s”这个系列类型还画不出来"

#: tycontrols.advancechart.strconsts.rstychartseriesshortencode
#, object-pascal-format
msgid "series[%d]: encode.%s reaches %d of the %d dimensions a %s needs, so it is not drawn"
msgstr "series[%d]：encode.%s 只到了 %d 个维，要 %d 个才能画 %s，所以不画"

#: tycontrols.advancechart.strconsts.rstychartcustomnorenderitem
#, object-pascal-format
msgid "series[%d]: no renderItem is registered as \"%s\", so nothing is drawn"
msgstr "series[%d]：没有登记名为“%s”的 renderItem，所以什么都不画"

#: tycontrols.advancechart.strconsts.rstychartcustomrenderitemfailed
#, object-pascal-format
msgid "series[%d]: renderItem \"%s\" failed: %s"
msgstr "series[%d]：renderItem“%s”失败：%s"

#: tycontrols.advancechart.strconsts.rstychartmapnotregistered
#, object-pascal-format
msgid "%s: no map is registered as \"%s\", so nothing is drawn"
msgstr "%s：没有登记名为“%s”的地图，所以什么都不画"

#: tycontrols.advancechart.strconsts.rstychartseriesnoaxis
#, object-pascal-format
msgid "series[%d] names an axis that does not exist"
msgstr "series[%d] 指向了一条不存在的轴"

#: tycontrols.advancechart.strconsts.rstychartseriesaxessplit
#, object-pascal-format
msgid "series[%d]: xAxis[%d] and yAxis[%d] are not on one grid"
msgstr "series[%d]：xAxis[%d] 与 yAxis[%d] 不在同一个 grid 上"

#: tycontrols.advancechart.strconsts.rstychartdatasetnotable
#, object-pascal-format
msgid "dataset[%d] has no table: %s"
msgstr "dataset[%d] 没有数据表：%s"

#: tycontrols.advancechart.strconsts.rstydsreadsitself
msgid "it reads itself"
msgstr "它读的是自己"

#: tycontrols.advancechart.strconsts.rstydsupstreamfailed
#, object-pascal-format
msgid "dataset[%d], which it reads, has no table"
msgstr "它读的 dataset[%d] 没有数据表"

#: tycontrols.advancechart.strconsts.rstydsnoresult
#, object-pascal-format
msgid "its upstream has no result %s"
msgstr "上游没有第 %s 个结果"

#: tycontrols.advancechart.strconsts.rstydsoneupstream
msgid "fromTransformResult needs exactly one upstream dataset"
msgstr "fromTransformResult 只能有一个上游 dataset"

#: tycontrols.advancechart.strconsts.rstydsemptypipe
msgid "the transform list is empty"
msgstr "transform 列表是空的"

#: tycontrols.advancechart.strconsts.rstydsnotobject
msgid "a transform is not an object"
msgstr "有一个 transform 不是对象"

#: tycontrols.advancechart.strconsts.rstydsunknowntype
#, object-pascal-format
msgid "no transform is registered as \"%s\""
msgstr "没有注册名为“%s”的 transform"

#: tycontrols.advancechart.strconsts.rstydsupstreammissing
msgid "a transform has no input"
msgstr "有一个 transform 没有输入"

#: tycontrols.advancechart.strconsts.rstydsupstreambyrow
msgid "its upstream is laid out by row"
msgstr "上游是按行排的"

#: tycontrols.advancechart.strconsts.rstydsupstreamformat
msgid "its upstream is not a table"
msgstr "上游不是数据表"

#: tycontrols.advancechart.strconsts.rstydsduplicatedim
#, object-pascal-format
msgid "the dimension name \"%s\" is used twice"
msgstr "维度名“%s”重复了"

#: tycontrols.advancechart.strconsts.rstydscopyhasnometa
msgid "it reads a fromTransformResult copy, which has no dimensions to pass on"
msgstr "它读的是 fromTransformResult 的副本，副本没有可以沿用的维度"

#: tycontrols.advancechart.strconsts.rstydsbadresult
msgid "a transform result is not a table of arrays or of objects"
msgstr "transform 的结果不是数组行或对象行的表"

#: tycontrols.advancechart.strconsts.rstydsnotsupported
#, object-pascal-format
msgid "%s is not available to a transform registered outside ECharts"
msgstr "%s 只有 ECharts 自带的 transform 能用"

#: tycontrols.advancechart.strconsts.rstydskeyednodims
msgid "its upstream table of columns has no dimensions"
msgstr "上游的按列表没有维度"

#: tycontrols.advancechart.strconsts.rstydsrownotlist
msgid "a row of the table is not a list"
msgstr "表里有一行不是数组"

#: tycontrols.advancechart.strconsts.rstydscondnotobject
msgid "a filter condition is not an object"
msgstr "filter 的条件不是对象"

#: tycontrols.advancechart.strconsts.rstydscondandor
#, object-pascal-format
msgid "\"%s\" must be a non-empty list of conditions"
msgstr "“%s”必须是非空的条件列表"

#: tycontrols.advancechart.strconsts.rstydscondnot
msgid "\"not\" must be a condition object"
msgstr "“not”必须是一个条件对象"

#: tycontrols.advancechart.strconsts.rstydscondnodimension
msgid "a filter condition has no dimension"
msgstr "filter 的条件没有写 dimension"

#: tycontrols.advancechart.strconsts.rstydsnodimension
#, object-pascal-format
msgid "there is no dimension %s"
msgstr "没有维度 %s"

#: tycontrols.advancechart.strconsts.rstydscondnooperator
msgid "a filter condition has no operator"
msgstr "filter 的条件没有运算符"

#: tycontrols.advancechart.strconsts.rstydscondbadoperator
#, object-pascal-format
msgid "\"%s\" is not a filter operator"
msgstr "“%s”不是 filter 的运算符"

#: tycontrols.advancechart.strconsts.rstydscondneedsnumber
#, object-pascal-format
msgid "\"%s\" compares with a number only"
msgstr "“%s”只能和数比较"

#: tycontrols.advancechart.strconsts.rstydscondreg
#, object-pascal-format
msgid "\"reg\" is not a regular expression: %s"
msgstr "“reg”不是正则表达式：%s"

#: tycontrols.advancechart.strconsts.rstydscondregslow
#, object-pascal-format
msgid "the regular expression in \"reg\" runs too long: %s"
msgstr "“reg”里的正则表达式运行太久：%s"

#: tycontrols.advancechart.strconsts.rstydssortempty
msgid "the sort has no config"
msgstr "sort 没有 config"

#: tycontrols.advancechart.strconsts.rstydssortnodimension
msgid "a sort key has no dimension"
msgstr "sort 的排序键没有 dimension"

#: tycontrols.advancechart.strconsts.rstydssortorder
msgid "a sort key's order must be \"asc\" or \"desc\""
msgstr "sort 的 order 必须是“asc”或“desc”"

#: tycontrols.advancechart.strconsts.rstydssortincomparable
msgid "\"incomparable\" must be \"min\" or \"max\""
msgstr "“incomparable”必须是“min”或“max”"

#: tycontrols.advancechart.strconsts.rstydssortparser
#, object-pascal-format
msgid "\"%s\" is not a parser"
msgstr "“%s”不是 parser"

#: tycontrols.advancechart.strconsts.rstydssortformat
msgid "the sort reads only a table of arrays or of objects"
msgstr "sort 只能读数组行或对象行的表"

#: tycontrols.advancechart.strconsts.rstydsboxplotrows
msgid "the boxplot reads only a table of arrays"
msgstr "boxplot 只能读数组行的表"

#: tycontrols.advancechart.strconsts.rstystatregmethod
#, object-pascal-format
msgid "\"%s\" is not a regression method"
msgstr "“%s”不是回归方法"

#: tycontrols.advancechart.strconsts.rstystatpolyorder
#, object-pascal-format
msgid "the polynomial order must be a whole number from -1 to %d"
msgstr "多项式的阶数必须是 -1 到 %d 之间的整数"

#: tycontrols.advancechart.strconsts.rstystatbinmethod
#, object-pascal-format
msgid "\"%s\" is not a binning method"
msgstr "“%s”不是分箱方法"

#: tycontrols.advancechart.strconsts.rstystatbinlayout
msgid "the bins cannot be laid out over these values"
msgstr "这些值排不出分箱"

#: tycontrols.advancechart.strconsts.rstystatbinprecision
msgid "the bins are finer than 20 decimal places"
msgstr "分箱比 20 位小数还细"

#: tycontrols.advancechart.strconsts.rstystattoomanybins
#, object-pascal-format
msgid "more than %d bins"
msgstr "分箱超过 %d 个"

#: tycontrols.advancechart.strconsts.rstystatclustercount
msgid "\"clusterCount\" must be a number of 2 or more"
msgstr "clusterCount 必须是不小于 2 的数"

#: tycontrols.advancechart.strconsts.rstystatclusterindex
msgid "\"outputClusterIndexDimension\" is required, as a number"
msgstr "必须写 outputClusterIndexDimension，而且要写成数"

#: tycontrols.advancechart.strconsts.rstystatnewdim
msgid "a new dimension must be an index or { name, index }"
msgstr "新维度必须是下标或 { name, index }"

#: tycontrols.advancechart.strconsts.rstystatindexnotnumber
msgid "the index of a new dimension must be written as a number"
msgstr "新维度的下标必须写成数"

#: tycontrols.advancechart.strconsts.rstystattoomanyclusters
#, object-pascal-format
msgid "more than %d clusters"
msgstr "聚类超过 %d 个"

#: tycontrols.advancechart.strconsts.rstystatnosplit
msgid "no cluster could be split"
msgstr "没有哪个聚类能再分"

#: tycontrols.advancechart.strconsts.rstystatunassigned
msgid "a point belongs to no cluster"
msgstr "有一个点不属于任何聚类"

#: tycontrols.advancechart.strconsts.rstystatnoconverge
msgid "k-means did not settle"
msgstr "k-means 没有收敛"

#: tycontrols.advancechart.strconsts.rstystatdimhole
msgid "a dimension of the result is left undefined"
msgstr "结果有一个维度没有定义"

#: tycontrols.advancechart.strconsts.rstystatindextoofar
#, object-pascal-format
msgid "a new dimension's index is past %d"
msgstr "新维度的下标超过了 %d"

#: tycontrols.advancechart.strconsts.rstyoptsummarydefault
#, object-pascal-format
msgid "default %s"
msgstr "默认 %s"

#: tycontrols.advancechart.strconsts.rstyoptsummaryrange
#, object-pascal-format
msgid "range %s..%s"
msgstr "取值 %s..%s"

#: tycontrols.advancechart.strconsts.rstyoptsummarysince
#, object-pascal-format
msgid "since %s"
msgstr "始于 %s"

#: tycontrols.advancechart.strconsts.rstyoptstatusroot
msgid "(the option root)"
msgstr "（option 根）"

#: tycontrols.advancechart.strconsts.rstyoptstatusneedstype
msgid "write a type first -- what is under here depends on which one"
msgstr "先写 type —— 这里面有什么取决于它是哪一种"

#: tycontrols.advancechart.strconsts.rstyoptdiagunknown
#, object-pascal-format
msgid "%s is not an option ECharts 6.1 knows."
msgstr "%s 不是 ECharts 6.1 认识的 option。"

#: tycontrols.advancechart.strconsts.rstyoptdiagdidyoumean
#, object-pascal-format
msgid "Did you mean \"%s\"?"
msgstr "你是想写 “%s” 吗？"

#: tycontrols.advancechart.strconsts.rstyoptdiagbadenum
#, object-pascal-format
msgid "%s: \"%s\" is not one of %s."
msgstr "%s：“%s” 不在 %s 之中。"

#: tycontrols.advancechart.strconsts.rstyoptdiagnotype
#, object-pascal-format
msgid "%s[%d] has no type yet, so nothing under it can be checked. One of: %s."
msgstr "%s[%d] 还没写 type，所以它下面的东西无从校验。可选：%s。"

#: tycontrols.advancechart.strconsts.rstyoptdiagnothingpaintsyet
msgid "The option is understood. Series marks are not painted yet, so this draws its axes and nothing else."
msgstr "option 已读懂。series 图元尚未实现，所以现在只画得出坐标轴。"

#: tycontrols.advancechart.strconsts.rstyoptdiagmorerows
#, object-pascal-format
msgid "and %d more like these."
msgstr "另有 %d 条同类。"

#: tycontrols.advancechart.strconsts.rstyserednotobject
msgid "The option is not an object, so it has no series to edit."
msgstr "option 不是一个对象，没有可以编辑的系列。"

#: tycontrols.advancechart.strconsts.rstyseredemptyliteral
msgid "Write a value here, or clear the field to remove the key."
msgstr "这里要写一个值；清空就是删掉这个键。"

#: tycontrols.advancechart.strconsts.rstyseredonevalue
msgid "Write exactly one value here."
msgstr "这里只能写一个值。"

#: tycontrols.advancechart.strconsts.rstyserednotinteger
#, object-pascal-format
msgid "\"%s\" is not a whole number."
msgstr "“%s”不是整数。"

#: tycontrols.advancechart.strconsts.rstyserednotboolean
#, object-pascal-format
msgid "\"%s\" is neither true nor false."
msgstr "“%s”既不是 true 也不是 false。"

#: tycontrols.advancechart.strconsts.rstyseredcaption
#, object-pascal-format
msgid "%d: %s"
msgstr "%d：%s"

#: tycontrols.advancechart.strconsts.rstyseredcaptionnamed
#, object-pascal-format
msgid "%d: %s \"%s\""
msgstr "%d：%s “%s”"

#: tycontrols.advancechart.strconsts.rstyseredhole
msgid "(empty slot)"
msgstr "（空位）"

#: tycontrols.advancechart.strconsts.rstyserednotype
msgid "(no type)"
msgstr "（没有 type）"

#: tycontrols.advancechart.strconsts.rstyseredcolcategory
#, object-pascal-format
msgid "%s category"
msgstr "%s 类目"

#: tycontrols.advancechart.strconsts.rstyseredcolname
msgid "name"
msgstr "名称"

#: tycontrols.advancechart.strconsts.rstyseredcolvalue
msgid "value"
msgstr "值"

#: tycontrols.advancechart.strconsts.rstyseredcoldim
#, object-pascal-format
msgid "dim %d"
msgstr "维 %d"

#: tycontrols.advancechart.strconsts.rstyserednotehole
msgid "This slot holds no object, so there is nothing to edit in it."
msgstr "这个位置上不是对象，没有可以编辑的内容。"

#: tycontrols.advancechart.strconsts.rstyserednotenotlist
msgid "This data is not a list; edit it as text."
msgstr "这份数据不是列表，请在文本里编辑。"

#: tycontrols.advancechart.strconsts.rstyserednotetree
msgid "This data is a tree (items have children); edit it as text."
msgstr "这份数据是树（数据项带 children），请在文本里编辑。"

#: tycontrols.advancechart.strconsts.rstyserednotenodata
msgid "This series has no data of its own and reads a dataset. Rows added here give it data of its own, which then wins over the dataset."
msgstr "这个系列没有自己的数据，读的是 dataset。在这里加行就给了它自己的数据，之后以它为准，不再读 dataset。"

#: tycontrols.advancechart.strconsts.rstyserednotecategory
#, object-pascal-format
msgid "Each row is a category of %s. Deleting a row deletes that category, and its value in every series on that axis."
msgstr "每一行是 %s 的一个类目。删掉一行会删掉这个类目，以及这根轴上每个系列在这个类目上的值。"

#: tycontrols.advancechart.strconsts.rstyserednotetransform
msgid "This dataset is made from another one by a transform; edit the source dataset instead."
msgstr "这个 dataset 是从另一个经 transform 得来的，请去编辑源 dataset。"

#: tycontrols.advancechart.strconsts.rstyserednotedatasetform
msgid "This dataset is not a table of rows; edit it as text."
msgstr "这个 dataset 不是按行排的表，请在文本里编辑。"

#: tycontrols.advancechart.strconsts.rstyoptdiagallclear
msgid "The option is understood."
msgstr "option 没有问题。"

#: tycontrols.advancechart.strconsts.rstyoptdiagsomenotpainted
#, object-pascal-format
msgid "The option is understood. Not painted yet: %s."
msgstr "option 没有问题。还画不出来的：%s。"

#: tycontrols.advancechart.strconsts.rstyoptdiagnomarksatall
msgid "The option is understood. Series marks are not painted yet, and this chart has no axes, so nothing is drawn."
msgstr "option 没有问题。series 的图元还没有实现绘制，而这张图也没有坐标轴，所以画面上不会有任何东西。"

#: tycontrols.advancechart.strconsts.rstyoptdiagnoseries
msgid "The option is understood. There are no series, so only the axes would draw."
msgstr "option 没有问题。没有任何 series，所以只会画出坐标轴。"
