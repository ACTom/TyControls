# --- .lfm captions/text/hints (auto-generated, msgid=English source) ---

#: tmainform.caption
msgid "Labels example"
msgstr "Labels 示例"

#: tmainform.darkswitch.caption
msgid "Dark"
msgstr "暗色"

#: tmainform.lblplain.caption
msgid "Plain label TTyLabel"
msgstr "普通标签 TTyLabel"

#: tmainform.lbllink.caption
msgid "Right-aligned hyperlink (AutoOpen = True opens the browser)"
msgstr "右对齐超链接（AutoOpen = True 会调起浏览器）"

#: tmainform.lblshadow.caption
msgid "Centred shadow label — ShadowOffset = (2, 2), falling down-right"
msgstr "居中投影标签 —— ShadowOffset = (2, 2)，向右下投"

#: tmainform.lblglow.caption
msgid "GlowRadius = 5 — a soft halo around the text"
msgstr "GlowRadius = 5 —— 文字周围一圈柔光"

#: tmainform.lblhdrlink.caption
msgid "TTyLinkLabel — AutoOpen picks who handles the click; Alignment aligns it"
msgstr "TTyLinkLabel —— AutoOpen 决定谁处理点击；Alignment 负责对齐"

#: tmainform.lblaction.caption
msgid "In-app link (AutoOpen = False) — click me, no browser opens"
msgstr "应用内链接（AutoOpen = False）—— 点我，不会打开浏览器"

#: tmainform.lblhdrshadow.caption
msgid "TTyShadowLabel — ShadowOffsetX/Y aim the shadow; ShadowColor set in code"
msgstr "TTyShadowLabel —— ShadowOffsetX/Y 定投影方向；ShadowColor 在代码里设"

#: tmainform.lblshadowup.caption
msgid "ShadowOffset = (-2, -2): the shadow can fall up-left too"
msgstr "ShadowOffset = (-2, -2)：投影也能落向左上"

#: tmainform.lblhdrglow.caption
msgid "TTyGlowLabel — GlowRadius scales the halo (clamped to 0..64)"
msgstr "TTyGlowLabel —— GlowRadius 缩放光晕（钳制在 0..64）"

#: tmainform.lblglow0.caption
msgid "GlowRadius = 0 — no blur, a crisp colour backing under the text"
msgstr "GlowRadius = 0 —— 不模糊，文字下是一块清晰底色"

#: tmainform.lblglow14.caption
msgid "GlowRadius = 14 — a wide soft halo (bigger values clamp at 64)"
msgstr "GlowRadius = 14 —— 一圈宽而柔的光晕（更大的值钳到 64）"

#: tmainform.bar.caption
msgid "Labels  · TyControls"
msgstr "Labels  · TyControls"

# --- code resourcestrings (msgid=Pascal source) ---

#: umain.rsactionclicked
msgid "OnClick fired — AutoOpen = False lets the app decide"
msgstr "OnClick 已触发 —— AutoOpen = False 让应用自己决定"
