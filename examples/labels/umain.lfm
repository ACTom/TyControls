object MainForm: TMainForm
  Left = 0
  Height = 300
  Top = 0
  Width = 420
  Caption = 'Labels example'
  ClientHeight = 300
  ClientWidth = 420
  Position = poScreenCenter
  LCLVersion = '4.4.0.0'
  OnCreate = FormCreate
  TitleBar = Bar
  object Surface: TTyFormSurface
    Left = 0
    Height = 300
    Top = 0
    Width = 420
    Align = alClient
    object Bar: TTyTitleBar
      Left = 0
      Height = 34
      Top = 0
      Width = 420
      Align = alTop
      Caption = 'Labels  · TyControls'
      TitleAlignment = taLeftJustify
      object DarkSwitch: TTyToggleSwitch
        Left = 72
        Height = 24
        Top = 5
        Width = 74
        Anchors = [akTop, akRight]
        Caption = 'Dark'
        OnChange = DarkSwitchChange
      end
      object ThemeCombo: TTyComboBox
        Left = 154
        Height = 26
        Top = 4
        Width = 120
        Anchors = [akTop, akRight]
        OnChange = ThemeComboChange
      end
    end
    object LblPlain: TTyLabel
      Left = 24
      Height = 24
      Top = 56
      Width = 360
      Caption = 'Plain label TTyLabel'
    end
    object LblLink: TTyLinkLabel
      Left = 24
      Height = 24
      Top = 100
      Width = 360
      Caption = 'Hyperlink label TTyLinkLabel (click to open the homepage)'
      URL = 'https://github.com/ACTom/TyControls'
    end
    object LblShadow: TTyShadowLabel
      Left = 24
      Height = 30
      Top = 144
      Width = 360
      Caption = 'Shadow label TTyShadowLabel'
      ShadowOffsetX = 2
      ShadowOffsetY = 2
    end
    object LblGlow: TTyGlowLabel
      Left = 24
      Height = 32
      Top = 192
      Width = 360
      Caption = 'Glow label TTyGlowLabel'
      GlowRadius = 5
    end
  end
end
