object MainForm: TMainForm
  Left = 0
  Height = 428
  Top = 0
  Width = 520
  Caption = 'Labels example'
  ClientHeight = 428
  ClientWidth = 520
  Position = poScreenCenter
  LCLVersion = '4.4.0.0'
  OnCreate = FormCreate
  TitleBar = Bar
  object Surface: TTyFormSurface
    Left = 0
    Height = 428
    Top = 0
    Width = 520
    Align = alClient
    object Bar: TTyTitleBar
      Left = 0
      Height = 34
      Top = 0
      Width = 520
      Align = alTop
      Caption = 'Labels  · TyControls'
      TitleAlignment = taLeftJustify
      object DarkSwitch: TTyToggleSwitch
        Left = 72
        Height = 24
        Top = 5
        Width = 74
        Anchors = [akTop, akRight]
        Caption = 'Dark'
        OnChange = DarkSwitchChange
      end
      object ThemeCombo: TTyComboBox
        Left = 154
        Height = 26
        Top = 4
        Width = 120
        Anchors = [akTop, akRight]
        OnChange = ThemeComboChange
      end
    end
    object LblPlain: TTyLabel
      Left = 24
      Height = 24
      Top = 56
      Width = 360
      Caption = 'Plain label TTyLabel'
    end
    object LblHdrLink: TTyLabel
      Left = 24
      Height = 20
      Top = 88
      Width = 470
      Caption = 'TTyLinkLabel — AutoOpen picks who handles the click; Alignment aligns it'
    end
    object LblLink: TTyLinkLabel
      Left = 24
      Height = 24
      Top = 112
      Width = 470
      Caption = 'Right-aligned hyperlink (AutoOpen = True opens the browser)'
      URL = 'https://github.com/ACTom/TyControls'
      Alignment = taRightJustify
    end
    object LblAction: TTyLinkLabel
      Left = 24
      Height = 24
      Top = 140
      Width = 470
      Caption = 'In-app link (AutoOpen = False) — click me, no browser opens'
      OnClick = LblActionClick
      AutoOpen = False
    end
    object LblHdrShadow: TTyLabel
      Left = 24
      Height = 20
      Top = 172
      Width = 470
      Caption = 'TTyShadowLabel — ShadowOffsetX/Y aim the shadow; ShadowColor set in code'
    end
    object LblShadow: TTyShadowLabel
      Left = 24
      Height = 30
      Top = 196
      Width = 470
      Caption = 'Centred shadow label — ShadowOffset = (2, 2), falling down-right'
      Alignment = taCenter
      ShadowOffsetX = 2
      ShadowOffsetY = 2
    end
    object LblShadowUp: TTyShadowLabel
      Left = 24
      Height = 30
      Top = 230
      Width = 470
      Caption = 'ShadowOffset = (-2, -2): the shadow can fall up-left too'
      ShadowOffsetX = -2
      ShadowOffsetY = -2
    end
    object LblHdrGlow: TTyLabel
      Left = 24
      Height = 20
      Top = 266
      Width = 470
      Caption = 'TTyGlowLabel — GlowRadius scales the halo (clamped to 0..64)'
    end
    object LblGlow: TTyGlowLabel
      Left = 24
      Height = 32
      Top = 290
      Width = 470
      Caption = 'GlowRadius = 5 — a soft halo around the text'
      GlowRadius = 5
    end
    object LblGlow0: TTyGlowLabel
      Left = 24
      Height = 32
      Top = 328
      Width = 470
      Caption = 'GlowRadius = 0 — no blur, a crisp colour backing under the text'
      GlowRadius = 0
    end
    object LblGlow14: TTyGlowLabel
      Left = 24
      Height = 40
      Top = 366
      Width = 470
      Caption = 'GlowRadius = 14 — a wide soft halo (bigger values clamp at 64)'
      GlowRadius = 14
    end
  end
end
