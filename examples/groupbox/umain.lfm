object MainForm: TMainForm
  Left = 0
  Height = 320
  Top = 0
  Width = 620
  Caption = 'TTyGroupBox 示例'
  ClientHeight = 320
  ClientWidth = 620
  Position = poScreenCenter
  LCLVersion = '4.4.0.0'
  OnCreate = FormCreate
  TitleBar = Bar
  object Bar: TTyTitleBar
    Left = 0
    Height = 34
    Top = 0
    Width = 620
    Align = alTop
    Caption = 'GroupBox  ·  TyControls'
    TitleAlignment = taLeftJustify
    object DarkSwitch: TTyToggleSwitch
      Left = 362
      Height = 24
      Top = 5
      Width = 74
      Caption = '暗色'
      OnChange = DarkSwitchChange
    end
    object ThemeCombo: TTyComboBox
      Left = 446
      Height = 26
      Top = 4
      Width = 120
      OnChange = ThemeComboChange
    end
  end
  object GroupSize: TTyGroupBox
    Left = 16
    Height = 130
    Top = 52
    Width = 185
    Caption = '字体大小（左对齐）'
    Alignment = taLeftJustify
    object RadioA: TTyRadioButton
      Left = 10
      Height = 26
      Top = 24
      Width = 160
      Caption = '小（12pt）'
      OnClick = RadioClick
    end
    object RadioB: TTyRadioButton
      Left = 10
      Height = 26
      Top = 54
      Width = 160
      Caption = '中（14pt）'
      Checked = True
      OnClick = RadioClick
    end
    object RadioC: TTyRadioButton
      Left = 10
      Height = 26
      Top = 84
      Width = 160
      Caption = '大（18pt）'
      OnClick = RadioClick
    end
  end
  object GroupOpt: TTyGroupBox
    Left = 217
    Height = 130
    Top = 52
    Width = 185
    Caption = '样式（居中）'
    Alignment = taCenter
    object CheckBold: TTyCheckBox
      Left = 10
      Height = 26
      Top = 24
      Width = 160
      Caption = '加粗'
      OnClick = CheckClick
    end
    object CheckItalic: TTyCheckBox
      Left = 10
      Height = 26
      Top = 54
      Width = 160
      Caption = '斜体'
      OnClick = CheckClick
    end
  end
  object GroupName: TTyGroupBox
    Left = 418
    Height = 130
    Top = 52
    Width = 185
    Caption = '名称（右对齐）'
    Alignment = taRightJustify
    object NameEdit: TTyEdit
      Left = 10
      Height = 30
      Top = 28
      Width = 160
      TextHint = '请输入名称…'
      OnChange = NameChange
    end
  end
  object LblStatus: TTyLabel
    Left = 16
    Height = 60
    Top = 200
    Width = 588
    Caption = ''
  end
end
