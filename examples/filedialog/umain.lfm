  end
  object BtnOpenPic: TTyButton
    Left = 16
    Height = 32
    Top = 144
    Width = 130
    Caption = '打开图片'
    OnClick = BtnOpenPicClick
  end
  object BtnSavePic: TTyButton
    Left = 156
    Height = 32
    Top = 144
    Width = 130
    Caption = '保存图片'
