  end
  object BtnSave: TTyButton
    Left = 156
    Height = 32
    Top = 72
    Width = 130
    Caption = '保存'
    OnClick = BtnSaveClick
  end
  object DivPic: TTyDivider
    Left = 16
    Height = 22
    Top = 116
    Width = 688
    Caption = '图片对话框(右侧图片预览)'
