  object DlgOpen: TTyOpenDialog
    Title = 'Open file'
    Filter = 'Text (*.txt;*.md)|*.txt;*.md|All files (*.*)|*.*'
    FilterIndex = 2
    Options = [fdoFileMustExist, fdoPathMustExist, fdoAllowMultiSelect]
    OnShow = DlgOpenShow
    OnClose = DlgOpenClose
    Left = 480
    Top = 60
  end
  object DlgSave: TTySaveDialog
    Title = 'Save file'
    Filter = 'Text (*.txt)|*.txt|All files (*.*)|*.*'
    FileName = 'untitled.txt'
    DefaultExt = 'txt'
    Options = [fdoOverwritePrompt]
    OnCanClose = DlgSaveCanClose
    Left = 560
    Top = 60
  end
  object DlgOpenPic: TTyOpenPictureDialog
    Title = 'Open picture'
