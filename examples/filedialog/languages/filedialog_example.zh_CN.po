#: umain.rscancelsuffix
msgid ":(cancel)"
msgstr "：（取消）"

#: umain.rscustomprevfmt
#, object-pascal-format
msgid "Custom preview (OnPreview)\r\n\r\nFile:%s\r\nExtension:%s\r\n\r\nThis format has no built-in previewer; it is handled by the app's OnPreview.\r\nIn a real scenario you could decode it into a bitmap (ShowImage) or text (ShowText)."
msgstr "自定义预览（OnPreview）\n\n文件：%s\n扩展名：%s\n\n这种格式没有内置预览器；由应用的 OnPreview 处理。\n真实场景里可以把它解码成位图（ShowImage）或文本（ShowText）。"

#: umain.rsemptyfile
msgid "Empty file (0 bytes) — nothing to preview"
msgstr "空文件（0 字节）—— 没有可预览的内容"

#: umain.rsfilterall
msgid "All files (*.*)|*.*"
msgstr "所有文件 (*.*)|*.*"

#: umain.rsfiltertext
msgid "Text (*.txt)|*.txt|All files (*.*)|*.*"
msgstr "文本 (*.txt)|*.txt|所有文件 (*.*)|*.*"

#: umain.rsmanyfmt
#, object-pascal-format
msgid "%s: %d item(s) selected"
msgstr "%s：选了 %d 项"

