# --- .lfm captions/text/hints (auto-generated, msgid=English source) ---

#: tmainform.caption
msgid "TTyProgressBar example"
msgstr "TTyProgressBar 示例"

#: tmainform.darkswitch.caption
msgid "Dark"
msgstr "暗色"

#: tmainform.lbldesc.caption
msgid "Progress bar: Min=0  Max=100, Position driven by button / timer"
msgstr "进度条：Min=0  Max=100，按钮 / 定时器驱动 Position"

#: tmainform.lblreadout.caption
msgid "Progress: 0 / 100  (0%)"
msgstr "进度：0 / 100  (0%)"

#: tmainform.animchk.caption
msgid "Enable fill animation (AnimationsEnabled)"
msgstr "启用填充动画 (AnimationsEnabled)"

#: tmainform.btnstart.caption
msgid "Start / Pause"
msgstr "开始 / 暂停"

#: tmainform.btnstep.caption
msgid "Forward +10"
msgstr "前进 +10"

#: tmainform.btnreset.caption
msgid "Reset to zero"
msgstr "归零"

#: tmainform.lblorient.caption
msgid "Orientation = tpoVertical - fills bottom-up, same Position"
msgstr "Orientation = tpoVertical —— 自下而上填充，Position 相同"

#: tmainform.vertbar.hint
msgid "Same Position as the wide bar, but the fill grows upward"
msgstr "与宽条的 Position 相同，但填充向上增长"

#: tmainform.lblrange.caption
msgid "Min / Max are free - this one runs 20..60"
msgstr "Min / Max 可自由设定 —— 这条跑 20..60"

#: tmainform.lblrangereadout.caption
msgid "Position 20 in 20..60  (0%)"
msgstr "位置 20，范围 20..60  (0%)"

#: tmainform.lbloverride.caption
msgid "StyleOverride - square accent track. Click to seek."
msgstr "StyleOverride —— 直角强调色轨道。点击可定位。"

#: tmainform.lbldisabled.caption
msgid "Enabled = False - the theme dims track and fill together"
msgstr "Enabled = False —— 主题把轨道与填充一起变暗"

#: tmainform.lbldock.caption
msgid "Align = alBottom - a strip that stretches with the window"
msgstr "Align = alBottom —— 随窗口拉伸的条带"

#: tmainform.bar.caption
msgid "TTyProgressBar  ·  TyControls"
msgstr "TTyProgressBar  ·  TyControls"

# --- code resourcestrings (msgid=Pascal source) ---

#: umain.rsprogressfmt
#, object-pascal-format
msgid "Progress: %d / %d  (%d%%)"
msgstr "进度：%d / %d  （%d%%）"

#: umain.rsrangefmt
#, object-pascal-format
msgid "Position %d in %d..%d  (%d%%)"
msgstr "Position %d 位于 %d..%d  （%d%%）"
