object MainForm: TMainForm
  Left = 0
  Height = 540
  Top = 0
  Width = 1000
  Caption = 'TrackBar example'
  ClientHeight = 540
  ClientWidth = 1000
  Position = poScreenCenter
  LCLVersion = '4.4.0.0'
