# --- .lfm captions/text/hints (auto-generated, msgid=English source) ---

#: tmainform.caption
msgid "TrackBar example"
msgstr "TrackBar 示例"

#: tmainform.darkswitch.caption
msgid "Dark"
msgstr "暗色"

#: tmainform.lblvolume.caption
msgid "Volume (0..100, Min/Max/Position):"
msgstr "音量（0..100，Min/Max/Position）："

#: tmainform.lblbalance.caption
msgid "Balance (-50..50):"
msgstr "平衡（-50..50）："

#: tmainform.lblbrightness.caption
msgid "Brightness (Freq/PageSize 25, ShowValue on):"
msgstr "亮度（Freq/PageSize 25，ShowValue 开）："

#: tmainform.lblvertical.caption
msgid "Vertical:"
msgstr "垂直："

#: tmainform.lblstatus.caption
msgid "Volume: 50"
msgstr "音量：50"

#: tmainform.lblshowvaluehint.caption
msgid "ShowValue = True: the number is drawn by the bar itself."
msgstr "ShowValue = True：数字由控件自己绘制。"

#: tmainform.lblverticalhint.caption
msgid "Vertical: ticks and their labels on the right, its number below."
msgstr "垂直：刻度和刻度标签在右，数字在下。"

#: tmainform.lbllinesize.caption
msgid "Fine step (LineSize = 5 - arrows and the wheel move by 5):"
msgstr "微调步进（LineSize = 5，方向键与滚轮每次走 5）："

#: tmainform.lblanimhint.caption
msgid "Flips AnimationsEnabled (code only)."
msgstr "切换 AnimationsEnabled（仅代码可设）。"

#: tmainform.lblkeystitle.caption
msgid "Keyboard and wheel (click a bar to focus it first):"
msgstr "键盘与滚轮（先点滑杆使其获得焦点）："

#: tmainform.lblkeys1.caption
msgid "Left/Right (Up/Down when vertical) step by LineSize."
msgstr "左/右（垂直时为上/下）按 LineSize 步进。"

#: tmainform.lblkeys2.caption
msgid "PageUp/PageDown step by PageSize; Home/End jump to Min/Max."
msgstr "PageUp/PageDown 按 PageSize 步进；Home/End 跳到 Min/Max。"

#: tmainform.lblkeys3.caption
msgid "The wheel steps by LineSize; a click jumps the thumb there."
msgstr "滚轮按 LineSize 步进；点击轨道滑块直接跳过去。"

#: tmainform.bar.caption
msgid "TrackBar  · TyControls"
msgstr "TrackBar  · TyControls"

#: tmainform.animswitch.caption
msgid "Animate thumb"
msgstr "滑块动画"

#: tmainform.lblrange.caption
msgid "Two ranges (TTyRangeTrackBar, MinGap = 5, tick labels):"
msgstr "两个区间（TTyRangeTrackBar，MinGap = 5，带刻度标签）："

#: tmainform.lblmulti.caption
msgid "Thresholds (TTyMultiTrackBar, coloured segments):"
msgstr "阈值（TTyMultiTrackBar，分段着色）："

#: tmainform.lblmultihint.caption
msgid "Tab steps through the thumbs; the arrows move the ringed one."
msgstr "Tab 在滑块之间切换；方向键移动带圆环的那个。"

#: tmainform.divsingle.caption
msgid "One thumb: TTyTrackBar"
msgstr "单滑块：TTyTrackBar"

#: tmainform.divmulti.caption
msgid "Several thumbs: TTyRangeTrackBar, TTyMultiTrackBar"
msgstr "多滑块：TTyRangeTrackBar、TTyMultiTrackBar"

#: tmainform.lblrangehint.caption
msgid "Click the bare track between two ranges to add one there."
msgstr "点两个区间之间的空白轨道，就在那里加一个区间。"

#: tmainform.lblstops.caption
msgid "Gradient stops (TTyMultiTrackBar, OnDrawSegment):"
msgstr "渐变色标（TTyMultiTrackBar，OnDrawSegment）："

#: tmainform.lblstopshint.caption
msgid "Click the track to add a stop in a mixed colour."
msgstr "点轨道加一个色标，颜色由两侧的色标混合而来。"

#: tmainform.lblmonths.caption
msgid "Months (labels from OnFormatTickLabel):"
msgstr "月份（刻度标签由 OnFormatTickLabel 给出）："

#: tmainform.lblmultistatus.caption
msgid "Drag a thumb, or click the track."
msgstr "拖动滑块，或点击轨道。"

