#: tmainform.caption
msgid "TrackBar example"
msgstr "TrackBar 示例"

#: tmainform.darkswitch.caption
msgid "Dark"
msgstr "暗色"

#: tmainform.lblvolume.caption
msgid "Volume (0..100, Min/Max/Position):"
msgstr "音量（0..100，Min/Max/Position）："

#: tmainform.lblbalance.caption
msgid "Balance (-50..50):"
msgstr "平衡（-50..50）："

#: tmainform.lblbrightness.caption
msgid "Brightness (Freq/PageSize 25, ShowValue on):"
msgstr "亮度（Freq/PageSize 25，ShowValue 开）："

#: tmainform.lblvertical.caption
msgid "Vertical:"
msgstr "垂直："

#: tmainform.lblstatus.caption
msgid "Volume: 50"
msgstr "音量：50"

#: tmainform.lblshowvaluehint.caption
msgid "ShowValue = True: the number is drawn by the bar itself."
msgstr "ShowValue = True：数字由控件自己绘制。"

#: tmainform.lblverticalhint.caption
msgid "Vertical: ticks (Frequency = 10) right, its number below."
msgstr "垂直：刻度（Frequency = 10）在右，数字在下。"

#: tmainform.lbllinesize.caption
msgid "Fine step (LineSize = 5 - arrows and the wheel move by 5):"
msgstr "微调步进（LineSize = 5，方向键与滚轮每次走 5）："

#: tmainform.lblanimhint.caption
msgid "Flips AnimationsEnabled (code only)."
msgstr "切换 AnimationsEnabled（仅代码可设）。"

#: tmainform.lblkeystitle.caption
msgid "Keyboard and wheel (click a bar to focus it first):"
msgstr "键盘与滚轮（先点滑杆使其获得焦点）："

#: tmainform.lblkeys1.caption
msgid "Left/Right (Up/Down when vertical) step by LineSize."
msgstr "左/右（垂直时为上/下）按 LineSize 步进。"

#: tmainform.lblkeys2.caption
msgid "PageUp/PageDown step by PageSize; Home/End jump to Min/Max."
msgstr "PageUp/PageDown 按 PageSize 步进；Home/End 跳到 Min/Max。"

#: tmainform.lblkeys3.caption
msgid "The wheel steps by LineSize; a click jumps the thumb there."
msgstr "滚轮按 LineSize 步进；点击轨道滑块直接跳过去。"

#: tmainform.bar.caption
msgid "TrackBar  · TyControls"
msgstr "TrackBar  · TyControls"

#: tmainform.animswitch.caption
msgid "Animate thumb"
msgstr "滑块动画"
