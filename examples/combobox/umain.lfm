object MainForm: TMainForm
  Left = 0
  Height = 320
  Top = 0
  Width = 520
  Caption = 'TTyComboBox example'
  ClientHeight = 320
  ClientWidth = 520
  Position = poScreenCenter
  LCLVersion = '4.4.0.0'
  OnCreate = FormCreate
  TitleBar = Bar
  object Surface: TTyFormSurface
    Left = 0
    Height = 320
    Top = 0
    Width = 520
    Align = alClient
    object Bar: TTyTitleBar
      Left = 0
      Height = 34
      Top = 0
      Width = 520
      Align = alTop
      Caption = 'TTyComboBox  ·  TyControls'
      TitleAlignment = taLeftJustify
      object DarkSwitch: TTyToggleSwitch
        Left = 172
        Height = 24
        Top = 5
        Width = 74
        Anchors = [akTop, akRight]
        Caption = 'Dark'
        OnChange = DarkSwitchChange
      end
      object ThemeCombo: TTyComboBox
        Left = 254
        Height = 26
        Top = 4
        Width = 120
        Anchors = [akTop, akRight]
        OnChange = ThemeComboChange
      end
    end
    object LblList: TTyLabel
      Left = 24
      Height = 20
      Top = 52
      Width = 224
      Caption = 'Read-only dropdown (Sorted, keyboard type-ahead):'
    end
    object ListCombo: TTyComboBox
      Left = 24
      Height = 26
      Top = 76
      Width = 224
      Style = csDropDownList
      Sorted = True
      DropDownCount = 5
      OnChange = ComboChange
      OnSelect = ComboSelect
      OnDropDown = ComboDropDown
      OnCloseUp = ComboCloseUp
    end
    object LblEdit: TTyLabel
      Left = 272
      Height = 20
      Top = 52
      Width = 224
      Caption = 'Editable (Text preset, prefix autocomplete / uppercase / max length 10):'
    end
    object EditCombo: TTyComboBox
      Left = 272
      Height = 26
      Top = 76
      Width = 224
      Style = csDropDown
      DropDownCount = 6
      MaxLength = 10
      CharCase = ecUppercase
      Items.Strings = (
        'APPLE'
        'APRICOT'
        'AVOCADO'
        'BANANA'
        'BLUEBERRY'
        'CHERRY'
        'GRAPE'
        'MANGO'
      )
      Text = 'MANGO'
      OnChange = ComboChange
      OnSelect = ComboSelect
      OnDropDown = ComboDropDown
      OnCloseUp = ComboCloseUp
    end
    object LblStatus: TTyLabel
      Left = 24
      Height = 22
      Top = 140
      Width = 472
      Caption = 'Event state: (awaiting action, try expanding or typing a prefix)'
    end
    object LblApi: TTyLabel
      Left = 24
      Height = 20
      Top = 180
      Width = 472
      Caption = 'Programmatic DropDown / CloseUp — watch the same events fire:'
    end
    object BtnToggleList: TTyButton
      Left = 24
      Height = 28
      Top = 206
      Width = 160
      Caption = 'Open / close the list'
      OnClick = BtnToggleListClick
    end
  end
end
