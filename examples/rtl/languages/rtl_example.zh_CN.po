#: tmainform.caption
msgid "TyControls - right-to-left mirroring and bidirectional text"
msgstr "TyControls —— 从右往左镜像与双向文本"

#: tmainform.titlebar1.caption
msgid "RTL / BiDi  -  TyControls"
msgstr "RTL / BiDi  ·  TyControls"

#: tmainform.darkswitch.caption
msgid "Dark"
msgstr "暗色"

#: tmainform.dirswitch.caption
msgid "Right-to-left (BiDiMode)"
