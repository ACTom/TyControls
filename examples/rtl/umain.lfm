        object LblDataNote: TTyLabel
          Left = 732
          Height = 110
          Top = 372
          Width = 452
          AutoSize = False
          WordWrap = True
          Alignment = taLeftJustify
          Caption = 'Side by side on purpose - the contrast is the documentation. Flip the switch: the grid turns round whole, these two do not move at all. That is a stated gap. Their column model writes a per-column left field that nine separate expressions independently turn into a screen x, so mirroring the paint alone would leave every click behind.'
        end
      end
