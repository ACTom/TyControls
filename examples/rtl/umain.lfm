        object LblGridNote: TTyLabel
          Left = 16
          Height = 110
          Top = 372
          Width = 700
          AutoSize = False
          WordWrap = True
          Alignment = taLeftJustify
          Caption = 'MIRRORS: column order, the row-number gutter, the two frozen columns, header captions, the sort triangle, the filter funnel, the tree chevron and its indent, the check-box cell and the button cell. DELIBERATELY DOES NOT: the vertical scroll bar stays on the right, and the filter drop-down does not mirror its own rows - both are pinned by tests, not accidents. Note a resize grip is a column''s LEFT edge under RTL, and dragging it left widens the column.'
        end
