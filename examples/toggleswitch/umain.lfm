object MainForm: TMainForm
  Left = 0
  Height = 460
  Top = 0
  Width = 400
  Caption = 'ToggleSwitch example'
  ClientHeight = 460
  ClientWidth = 400
  Position = poScreenCenter
  LCLVersion = '4.4.0.0'
  OnCreate = FormCreate
  TitleBar = Bar
  object Surface: TTyFormSurface
    Left = 0
    Height = 460
    Top = 0
    Width = 400
    Align = alClient
    object Bar: TTyTitleBar
      Left = 0
      Height = 34
      Top = 0
      Width = 400
      Align = alTop
      Caption = 'ToggleSwitch  · TyControls'
      TitleAlignment = taLeftJustify
      object DarkSwitch: TTyToggleSwitch
        Left = 52
        Height = 24
        Top = 5
        Width = 74
        Anchors = [akTop, akRight]
        Caption = 'Dark'
        OnChange = DarkSwitchChange
      end
      object ThemeCombo: TTyComboBox
        Left = 134
        Height = 26
        Top = 4
        Width = 120
        Anchors = [akTop, akRight]
        OnChange = ThemeComboChange
      end
    end
    object LblDark: TTyLabel
      Left = 24
      Height = 24
      Top = 56
      Width = 220
      Caption = 'Dark mode'
    end
    object SwitchDark: TTyToggleSwitch
      Left = 250
      Height = 24
      Top = 56
      Width = 44
      Checked = False
      OnChange = SwitchChange
    end
    object LblNotify: TTyLabel
      Left = 24
      Height = 24
      Top = 100
      Width = 220
      Caption = 'Receive notifications:'
    end
    object SwitchNotify: TTyToggleSwitch
      Left = 250
      Height = 24
      Top = 100
      Width = 44
      Checked = True
      OnChange = SwitchChange
    end
    object SwitchCaption: TTyToggleSwitch
      Left = 24
      Height = 24
      Top = 144
      Width = 220
      Caption = 'Auto-save'
      Checked = True
      OnChange = SwitchChange
    end
    object SwitchDisabled: TTyToggleSwitch
      Left = 24
      Height = 24
      Top = 188
      Width = 220
      Caption = 'Experimental feature (disabled)'
      Checked = False
      Enabled = False
      OnChange = SwitchChange
    end
    object LblSecEvents: TTyLabel
      Left = 24
      Height = 20
      Top = 224
      Width = 352
      Caption = 'OnChange vs OnClick — click the switch, then press the button:'
    end
    object SwitchEvents: TTyToggleSwitch
      Left = 24
      Height = 24
      Top = 250
      Width = 220
      Caption = 'OnChange vs OnClick'
      Checked = False
      OnChange = SwitchEventsChange
      OnClick = SwitchEventsClick
    end
    object BtnToggleAll: TTyButton
      Left = 252
      Height = 28
      Top = 248
      Width = 128
      Caption = 'Toggle from code'
      OnClick = BtnToggleAllClick
    end
    object LblEvents: TTyLabel
      Left = 24
      Height = 20
      Top = 282
      Width = 352
      Caption = 'Last gesture: (none yet)'
    end
    object LblSecAnim: TTyLabel
      Left = 24
      Height = 20
      Top = 312
      Width = 352
      Caption = 'AnimationsEnabled — public, so it is set in code, not here:'
    end
    object SwitchNoAnim: TTyToggleSwitch
      Left = 24
      Height = 24
      Top = 338
      Width = 352
      Caption = 'AnimationsEnabled = False (the knob snaps)'
      Checked = False
    end
    object LblHint: TTyLabel
      Left = 24
      Height = 36
      Top = 372
      Width = 352
      Caption = 'Keyboard: Tab to a switch, then press Space or Enter — it toggles and draws the theme focus ring.'
      Layout = tlTop
      WordWrap = True
    end
    object LblStatus: TTyLabel
      Left = 24
      Height = 40
      Top = 414
      Width = 360
      Caption = ''
    end
  end
end
