#: umain.rscurrenttab
msgid "Current tab: %s (TabIndex=%d)"
msgstr "当前标签：%s（TabIndex=%d）"

#: umain.rsvetoedselect
msgid "The \"Notice (locked)\" tab was vetoed by OnChanging and cannot be selected."
msgstr "“通知（锁定）”标签被 OnChanging 否决，无法选中。"

#: umain.rsvetoedclose
msgid "The \"Overview\" tab was vetoed by OnTabClose and will not close."
msgstr "“总览”标签被 OnTabClose 否决，不会关闭。"

#: umain.rsclosingtab
msgid "Closing tab: %s"
msgstr "正在关闭标签：%s"

#: umain.rsreordered
msgid "Tabs reordered: %d → %d (current: %s)"
msgstr "标签已重排：%d → %d（当前：%s）"

#: umain.rsnewtabname
msgid "Tab %d"
msgstr "标签 %d"

#: umain.rsaddedtab
msgid "Added a tab through Tabs.Add — Tabs.Count is now %d. Keep going and the top strip overflows too."
msgstr "通过 Tabs.Add 添加了一个标签 —— Tabs.Count 现在是 %d。继续加下去，上面那条标签栏也会溢出。"

#: umain.rsoverflowstrip
msgid "Overflow strip: %s (TabIndex=%d) — selecting a tab scrolls it into view."
msgstr "溢出标签栏：%s（TabIndex=%d）—— 选中某个标签会把它滚动到可见范围内。"
