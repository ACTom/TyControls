object MainForm: TMainForm
  Left = 0
  Height = 280
  Top = 0
  Width = 440
  Caption = 'Hint example'
  ClientHeight = 280
  ClientWidth = 440
  Position = poScreenCenter
  LCLVersion = '4.4.0.0'
  OnCreate = FormCreate
  TitleBar = Bar
  object Surface: TTyFormSurface
    Left = 0
    Height = 280
    Top = 0
    Width = 440
    Align = alClient
    object Bar: TTyTitleBar
      Left = 0
      Height = 34
      Top = 0
      Width = 440
      Align = alTop
      Caption = 'Hint  ·  TyControls'
      TitleAlignment = taLeftJustify
      object DarkSwitch: TTyToggleSwitch
        Left = 92
        Height = 24
        Top = 5
        Width = 74
        Anchors = [akTop, akRight]
        Caption = 'Dark'
        OnChange = DarkSwitchChange
      end
      object ThemeCombo: TTyComboBox
        Left = 174
        Height = 26
        Top = 4
        Width = 120
        Anchors = [akTop, akRight]
        OnChange = ThemeComboChange
      end
    end
    object LblIntro: TTyLabel
      Left = 24
      Height = 24
      Top = 52
      Width = 392
      Caption = 'Hover the button for the themed tooltip; click "Show popover" for a pointer popover.'
    end
    object BtnSave: TTyButton
      Left = 24
      Height = 34
      Top = 92
      Width = 120
      Caption = 'Save'
      Hint = 'Save the current document (Ctrl+S)'
      ShowHint = True
    end
    object BtnDel: TTyButton
      Left = 160
      Height = 34
      Top = 92
      Width = 120
      Caption = 'Delete'
      Hint = 'Delete selected items'#13#10'This action cannot be undone'
      ShowHint = True
    end
    object BtnBalloon: TTyButton
      Left = 24
      Height = 34
      Top = 150
      Width = 160
      Caption = 'Show popover'
      OnClick = ShowBalloon
    end
  end
  object AppHint: TTyHint
  end
  object Balloon: TTyBalloonHint
    Title = 'Saved'
    Description = 'The document has been written to disk.'
    Icon = biInfo
  end
end
