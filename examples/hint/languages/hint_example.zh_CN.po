# --- .lfm captions/text/hints (auto-generated, msgid=English source) ---

#: tmainform.caption
msgid "Hint example"
msgstr "Hint 示例"

#: tmainform.darkswitch.caption
msgid "Dark"
msgstr "暗色"

#: tmainform.lblintro.caption
msgid "Hover for a themed tooltip; \"Show popover\" for a pointer one."
msgstr "悬停按钮看主题化 tooltip;点“显示气泡”看带指针气泡。"

#: tmainform.btnsave.caption
msgid "Save"
msgstr "保存"

#: tmainform.btnsave.hint
msgid "Save the current document (Ctrl+S)"
msgstr "保存当前文档 (Ctrl+S)"

#: tmainform.btndel.caption
msgid "Delete"
msgstr "删除"

#: tmainform.btnballoon.caption
msgid "Show popover"
msgstr "显示气泡"

#: tmainform.balloon.title
msgid "Saved"
msgstr "已保存"

#: tmainform.btndel.hint
msgid "Delete selected items\nThis action cannot be undone"
msgstr "删除选中的项目\n此操作无法撤销"

#: tmainform.lblhintnote.caption
msgid "Switch \"Themed hints\" off and hover Save: the OS tooltip returns."
msgstr "关掉“主题化提示”再悬停“保存”:系统 tooltip 就回来了。"

#: tmainform.lblballoons.caption
msgid "Popovers: \"Show popover\" is the biInfo icon; the next three are biWarning, biError and biNone."
msgstr "气泡:“显示气泡”是 biInfo 图标;后三个分别是 biWarning、biError 和 biNone。"

#: tmainform.btnwarn.caption
msgid "Warning popover"
msgstr "警告气泡"

#: tmainform.btnerr.caption
msgid "Error popover"
msgstr "错误气泡"

#: tmainform.btnplain.caption
msgid "No-icon popover"
msgstr "无图标气泡"

#: tmainform.lblsticky.caption
msgid "HideInterval: those four fade out after 2 s; the sticky popover sets 0, so only HideHint closes it."
msgstr "HideInterval:那四个 2 秒后淡出;常驻气泡设为 0,只有 HideHint 能关掉。"

#: tmainform.btnsticky.caption
msgid "Sticky popover"
msgstr "常驻气泡"

#: tmainform.btnhide.caption
msgid "Hide it (HideHint)"
msgstr "隐藏它 (HideHint)"

#: tmainform.lblscreen.caption
msgid "ShowAt aims at any screen rect - with no room below, the body flips above and the pointer moves to its bottom edge."
msgstr "ShowAt 可指向任意屏幕矩形 - 下方没空间时主体翻到上方,指针移到下边缘。"

#: tmainform.btnscreen.caption
msgid "Popover at the bottom of the screen"
msgstr "屏幕底部的气泡"

#: tmainform.bar.caption
msgid "Hint  ·  TyControls"
msgstr "Hint  ·  TyControls"

#: tmainform.hintswitch.caption
msgid "Themed hints"
msgstr "主题化提示"

#: tmainform.balloonwarn.title
msgid "Low disk space"
msgstr "磁盘空间不足"

#: tmainform.balloonerr.title
msgid "Save failed"
msgstr "保存失败"

#: tmainform.balloonplain.title
msgid "Copied"
msgstr "已复制"

#: tmainform.balloonsticky.title
msgid "Sticky popover"
msgstr "常驻气泡"
