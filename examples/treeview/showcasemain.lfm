object ShowcaseForm: TShowcaseForm
  Left = 0
  Height = 700
  Top = 0
  Width = 900
  Caption = 'TTyTreeView Feature Showcase'
  ClientHeight = 700
  ClientWidth = 900
  Position = poScreenCenter
  LCLVersion = '4.4.0.0'
  OnCreate = FormCreate
  TitleBar = ChromeBar
  object Surface: TTyFormSurface
    Left = 0
    Height = 700
    Top = 0
    Width = 900
    TabOrder = 0
    Align = alClient
    object ChromeBar: TTyTitleBar
      Left = 0
      Height = 34
      Top = 0
      Width = 900
      Align = alTop
      Caption = 'TTyTreeView Feature Showcase'
      TitleAlignment = taCenter
      object BtnLight: TTyButton
        Left = 8
        Height = 24
        Top = 4
        Width = 76
        Anchors = [akTop, akLeft]
        Caption = 'Light'
        StyleClass = 'ghost'
        OnClick = LightClick
      end
      object BtnDark: TTyButton
        Left = 88
        Height = 24
        Top = 4
        Width = 76
        Anchors = [akTop, akLeft]
        Caption = 'Dark'
        StyleClass = 'ghost'
        OnClick = DarkClick
      end
      object ThemeCombo: TTyComboBox
        Left = 610
        Height = 26
        Top = 4
        Width = 140
        Anchors = [akTop, akRight]
        OnChange = ThemeComboChange
      end
    end
    object Pages: TTyPageControl
      Left = 0
      Height = 640
      Top = 34
      Width = 900
      Align = alClient
      ActivePageIndex = 0
      object PgVirtual: TTyTabSheet
        Left = 0
        Height = 612
        Top = 28
        Width = 900
        Caption = 'Virtual (1M nodes)'
        object LblVirtual: TTyLabel
          Left = 0
          Height = 52
          Top = 0
          Width = 900
          Align = alTop
          BorderSpacing.Left = 8
          Caption = 'Virtual engine: 1 000 000 root nodes; up to level 4 each has 10 children. All nodes initialised lazily (OnInitNode / OnInitChildren).  OnExpanding VETOES every level-3 expansion - try opening one; OnExpanded / OnCollapsed / OnNodeClick / OnNodeDblClick report below.'
          Layout = tlTop
          WordWrap = True
        end
        object VirtualBar: TTyPanel
          Left = 0
          Height = 36
          Top = 52
          Width = 900
          Align = alTop
          object BtnGoToNode: TTyButton
            Left = 8
            Height = 26
            Top = 5
            Width = 132
            Caption = 'Go to node 1000'
            OnClick = BtnGoToNodeClick
          end
        end
        object VirtualTree: TTyTreeView
          Left = 0
          Height = 524
          Top = 88
          Width = 900
          Align = alClient
        end
      end
      object PgCol: TTyTabSheet
        Left = 0
        Height = 612
        Top = 28
        Width = 900
        Caption = 'Columns + Sort'
        object LblCol: TTyLabel
          Left = 0
          Height = 116
          Top = 0
          Width = 900
          Align = alTop
          BorderSpacing.Left = 8
          Caption = 'Data lives in the node (NodeDataSize = SizeOf(TRowRec)). Sort reads PRowRec(GetNodeData(Node)) — never Node^.Index — so column sorts are always stable.  Click a column header to sort.  Each Name shows an Explorer-style icon (folder / file / image / archive) via Images + OnGetImageIndex.  Double-click / F2 a Name to edit it (OnNewText writes the text into the node blob, so it survives re-sorts).  HotTrack lights the hovered row, hoHotTrack the hovered header section.  Modified fills the leftover width (hoAutoResize + AutoSizeIndex).  Name is pinned - no coDraggable, so it cannot be dragged out of first place - and Size is clamped to 60..140 px (MinWidth / MaxWidth) and right-aligns its caption.  Header clicks, resizes, reorders and Esc-cancelled renames all report below.'
          Layout = tlTop
          WordWrap = True
        end
        object ColBar: TTyPanel
          Left = 0
          Height = 36
          Top = 116
          Width = 900
          Align = alTop
          object BtnExpandAll: TTyButton
            Left = 8
            Height = 26
            Top = 5
            Width = 92
            Caption = 'Expand all'
            OnClick = BtnExpandAllClick
          end
          object BtnCollapseAll: TTyButton
            Left = 108
            Height = 26
            Top = 5
            Width = 100
            Caption = 'Collapse all'
            OnClick = BtnCollapseAllClick
          end
        end
        object ColTree: TTyTreeView
          Left = 0
          Height = 460
          Top = 152
          Width = 900
          Align = alClient
          HotTrack = True
        end
      end
      object PgCheck: TTyTabSheet
        Left = 0
        Height = 612
        Top = 28
        Width = 900
        Caption = 'Checkboxes'
        object LblCheck: TTyLabel
          Left = 0
          Height = 48
          Top = 0
          Width = 900
          Align = alTop
          BorderSpacing.Left = 8
          Caption = 'Folders: tri-state checkboxes (auto-propagate). Music/Videos files: plain checkboxes. Games entries: radio buttons (one active at a time).  One row is locked: OnChecking refuses to let Music / cover.jpg toggle at all.'
          Layout = tlTop
          WordWrap = True
        end
        object CheckTree: TTyTreeView
          Left = 0
          Height = 564
          Top = 48
          Width = 900
          Align = alClient
        end
      end
      object PgMulti: TTyTabSheet
        Left = 0
        Height = 612
        Top = 28
        Width = 900
        Caption = 'Multi-Select'
        object LblMulti: TTyLabel
          Left = 0
          Height = 84
          Top = 0
          Width = 900
          Align = alTop
          BorderSpacing.Left = 8
          Caption = 'Multi-select + full-row highlight. Ctrl+click / Shift+click / Ctrl+A. OnSelectionChanged shows live count in the status bar.  Ctrl+Space toggles the focused row in or out of the selection; OnFocusChanged names it on the right.  Type a few characters to jump to a row (toIncrementalSearch) - OnIncrementalSearch turns the built-in prefix test into a substring match, and 1.5 s of idle clears the buffer (SearchTimeout).  The strip below drives ShowButtons / ShowTreeLines / ShowRoot / Indent live; DefaultNodeHeight is left unset, so rows follow the theme item-height token.'
          Layout = tlTop
          WordWrap = True
        end
        object MultiBar: TTyPanel
          Left = 0
          Height = 40
          Top = 84
          Width = 900
          Align = alTop
          object ChkButtons: TTyCheckBox
            Left = 8
            Height = 22
            Top = 9
            Width = 116
            Caption = 'Expand buttons'
            Checked = True
            OnChange = MultiLookChange
          end
          object ChkLines: TTyCheckBox
            Left = 132
            Height = 22
            Top = 9
            Width = 92
            Caption = 'Tree lines'
            Checked = True
            OnChange = MultiLookChange
          end
          object ChkRoot: TTyCheckBox
            Left = 232
            Height = 22
            Top = 9
            Width = 92
            Caption = 'Show root'
            Checked = True
            OnChange = MultiLookChange
          end
          object LblIndent: TTyLabel
            Left = 332
            Height = 20
            Top = 10
            Width = 44
            Caption = 'Indent'
          end
          object TrkIndent: TTyTrackBar
            Left = 380
            Height = 24
            Top = 8
            Width = 220
            Min = 8
            Max = 40
            Position = 16
            ShowValue = True
            OnChange = TrkIndentChange
          end
        end
        object MultiTree: TTyTreeView
          Left = 0
          Height = 488
          Top = 124
          Width = 900
          Align = alClient
          SearchTimeout = 1500
        end
      end
      object PgDrag: TTyTabSheet
        Left = 0
        Height = 612
        Top = 28
        Width = 900
        Caption = 'Drag to Move'
        object LblDrag: TTyLabel
          Left = 0
          Height = 68
          Top = 0
          Width = 900
          Align = alTop
          BorderSpacing.Left = 8
          Caption = 'Drag to move: drag a node ABOVE / ONTO / BELOW another to reorder or reparent it (toNodeDrag). Each node keeps its name when moved.  Reordering is free, but OnDragOver refuses dropping ONTO a leaf.  Double-click no longer expands here (ToggleOnDblClick = False).  Delete or Clear rows and OnFreeNode counts what it releases; empty the tree and the control paints its own centred EmptyListMessage.'
          Layout = tlTop
          WordWrap = True
        end
        object DragBar: TTyPanel
          Left = 0
          Height = 36
          Top = 68
          Width = 900
          Align = alTop
          object BtnDragDelete: TTyButton
            Left = 8
            Height = 26
            Top = 5
            Width = 114
            Caption = 'Delete selected'
            OnClick = BtnDragDeleteClick
          end
          object BtnDragClear: TTyButton
            Left = 130
            Height = 26
            Top = 5
            Width = 72
            Caption = 'Clear'
            OnClick = BtnDragClearClick
          end
          object BtnDragRebuild: TTyButton
            Left = 210
            Height = 26
            Top = 5
            Width = 80
            Caption = 'Rebuild'
            OnClick = BtnDragRebuildClick
          end
        end
        object DragTree: TTyTreeView
          Left = 0
          Height = 508
          Top = 104
          Width = 900
          Align = alClient
          EmptyListMessage = 'Nothing here - press Rebuild to add the groups back.'
          ToggleOnDblClick = False
        end
      end
      object PgOwnerDraw: TTyTabSheet
        Left = 0
        Height = 612
        Top = 28
        Width = 900
        Caption = 'Owner-draw'
        object LblDraw: TTyLabel
          Left = 0
          Height = 68
          Top = 0
          Width = 900
          Align = alTop
          BorderSpacing.Left = 8
          Caption = 'toOwnerDraw + OnDrawNode replaces the cell content: every caption and progress pill here is drawn by the example, over the theme row background, expand button and tree lines.  OnAfterCellPaint runs for EVERY cell (with or without the option) and stamps the NEW badge on each fifth build.  Row heights come from OnMeasureItem (toVariableNodeHeight) - 40 px builds, 22 px stages.  Click a row and OnChange reports it below.'
          Layout = tlTop
          WordWrap = True
        end
        object DrawTree: TTyTreeView
          Left = 0
          Height = 544
          Top = 68
          Width = 900
          Align = alClient
          Options = [toVariableNodeHeight, toOwnerDraw]
          OnInitNode = DrawInitNode
          OnInitChildren = DrawInitChildren
          OnGetText = DrawGetText
          OnMeasureItem = DrawMeasureItem
          OnDrawNode = DrawDrawNode
          OnAfterCellPaint = DrawAfterCellPaint
          OnChange = DrawChange
          RootNodeCount = 30
        end
      end
    end
    object StatusBar: TTyStatusBar
      Left = 0
      Height = 26
      Top = 674
      Width = 900
      Align = alBottom
    end
  end
end
