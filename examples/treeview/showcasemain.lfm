object ShowcaseForm: TShowcaseForm
  Left = 0
  Height = 650
  Top = 0
  Width = 900
  Caption = 'TTyTreeView Feature Showcase'
  ClientHeight = 650
  ClientWidth = 900
  Position = poScreenCenter
  LCLVersion = '4.4.0.0'
  OnCreate = FormCreate
  TitleBar = ChromeBar
  object ChromeBar: TTyTitleBar
    Left = 0
    Height = 34
    Top = 0
    Width = 900
    Align = alTop
    Caption = 'TTyTreeView Feature Showcase'
    TitleAlignment = taCenter
    object BtnLight: TTyButton
      Left = 8
      Height = 24
      Top = 4
      Width = 76
      Anchors = [akTop, akLeft]
      Caption = 'Light'
      StyleClass = 'ghost'
      OnClick = LightClick
    end
    object BtnDark: TTyButton
      Left = 88
      Height = 24
      Top = 4
      Width = 76
      Anchors = [akTop, akLeft]
      Caption = 'Dark'
      StyleClass = 'ghost'
      OnClick = DarkClick
    end
    object ThemeCombo: TTyComboBox
      Left = 610
      Height = 26
      Top = 4
      Width = 140
      Anchors = [akTop, akRight]
      OnChange = ThemeComboChange
    end
  end
  object Pages: TTyPageControl
    Left = 0
    Height = 590
    Top = 34
    Width = 900
    Align = alClient
    ActivePageIndex = 0
    object PgVirtual: TTyTabSheet
      Left = 0
      Height = 562
      Top = 28
      Width = 900
      Caption = 'Virtual (1M nodes)'
      object LblVirtual: TTyLabel
        Left = 0
        Height = 26
        Top = 0
        Width = 900
        Align = alTop
        BorderSpacing.Left = 8
        Caption = 'Virtual engine: 1 000 000 root nodes; up to level 4 each has 10 children. All nodes initialised lazily (OnInitNode / OnInitChildren).'
      end
      object VirtualTree: TTyTreeView
        Left = 0
        Height = 536
        Top = 26
        Width = 900
        Align = alClient
      end
    end
    object PgCol: TTyTabSheet
      Left = 0
      Height = 562
      Top = 28
      Width = 900
      Caption = 'Columns + Sort'
      object LblCol: TTyLabel
        Left = 0
        Height = 26
        Top = 0
        Width = 900
        Align = alTop
        BorderSpacing.Left = 8
        Caption = 'Data lives in the node (NodeDataSize = SizeOf(TRowRec)). Sort reads PRowRec(GetNodeData(Node)) — never Node^.Index — so column sorts are always stable.  Click a column header to sort.  Each Name shows an Explorer-style icon (folder / file / image / archive) via Images + OnGetImageIndex.  Double-click / F2 a Name to edit it (OnNewText writes the text into the node blob, so it survives re-sorts).'
      end
      object ColTree: TTyTreeView
        Left = 0
        Height = 536
        Top = 26
        Width = 900
        Align = alClient
      end
    end
    object PgCheck: TTyTabSheet
      Left = 0
      Height = 562
      Top = 28
      Width = 900
      Caption = 'Checkboxes'
      object LblCheck: TTyLabel
        Left = 0
        Height = 26
        Top = 0
        Width = 900
        Align = alTop
        BorderSpacing.Left = 8
        Caption = 'Folders: tri-state checkboxes (auto-propagate). Music/Videos files: plain checkboxes. Games entries: radio buttons (one active at a time).'
      end
      object CheckTree: TTyTreeView
        Left = 0
        Height = 536
        Top = 26
        Width = 900
        Align = alClient
      end
    end
    object PgMulti: TTyTabSheet
      Left = 0
      Height = 562
      Top = 28
      Width = 900
      Caption = 'Multi-Select'
      object LblMulti: TTyLabel
        Left = 0
        Height = 26
        Top = 0
        Width = 900
        Align = alTop
        BorderSpacing.Left = 8
        Caption = 'Multi-select + full-row highlight. Ctrl+click / Shift+click / Ctrl+A. OnSelectionChanged shows live count in the status bar.'
      end
      object MultiTree: TTyTreeView
        Left = 0
        Height = 536
        Top = 26
        Width = 900
        Align = alClient
      end
    end
    object PgDrag: TTyTabSheet
      Left = 0
      Height = 562
      Top = 28
      Width = 900
      Caption = 'Drag to Move'
      object LblDrag: TTyLabel
        Left = 0
        Height = 26
        Top = 0
        Width = 900
        Align = alTop
        BorderSpacing.Left = 8
        Caption = 'Drag to move: drag a node ABOVE / ONTO / BELOW another to reorder or reparent it (toNodeDrag). Each node keeps its name when moved.'
      end
      object DragTree: TTyTreeView
        Left = 0
        Height = 536
        Top = 26
        Width = 900
        Align = alClient
      end
    end
  end
  object StatusBar: TTyStatusBar
    Left = 0
    Height = 26
    Top = 624
    Width = 900
    Align = alBottom
  end
end
