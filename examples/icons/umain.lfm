object MainForm: TMainForm
  Left = 0
  Height = 320
  Top = 0
  Width = 460
  Caption = 'Icons & Images example'
  ClientHeight = 320
  ClientWidth = 460
  Position = poScreenCenter
  LCLVersion = '4.4.0.0'
  OnCreate = FormCreate
  TitleBar = Bar
  object Surface: TTyFormSurface
    Left = 0
    Height = 320
    Top = 0
    Width = 460
    Align = alClient
    object Bar: TTyTitleBar
      Left = 0
      Height = 34
      Top = 0
      Width = 460
      Align = alTop
      Caption = 'Icons & Images  · TyControls'
      TitleAlignment = taLeftJustify
      object DarkSwitch: TTyToggleSwitch
        Left = 112
        Height = 24
        Top = 5
        Width = 74
        Anchors = [akTop, akRight]
        Caption = 'Dark'
        OnChange = DarkSwitchChange
      end
      object ThemeCombo: TTyComboBox
        Left = 194
        Height = 26
        Top = 4
        Width = 120
        Anchors = [akTop, akRight]
        OnChange = ThemeComboChange
      end
    end
    object Cap1: TTyLabel
      Left = 16
      Height = 20
      Top = 52
      Width = 120
      Caption = 'Stretch'
    end
    object Img1: TTyImage
      Left = 16
      Height = 100
      Top = 74
      Width = 120
      Stretch = True
      Transparent = False
    end
    object Cap2: TTyLabel
      Left = 168
      Height = 20
      Top = 52
      Width = 120
      Caption = 'Proportional'
    end
    object Img2: TTyImage
      Left = 168
      Height = 100
      Top = 74
      Width = 120
      Proportional = True
      Transparent = False
    end
    object Cap3: TTyLabel
      Left = 320
      Height = 20
      Top = 52
      Width = 120
      Caption = 'Center'
    end
    object Img3: TTyImage
      Left = 320
      Height = 100
      Top = 74
      Width = 120
      Transparent = False
    end
    object Ch: TTyCharImage
      Left = 16
      Height = 40
      Top = 196
      Width = 40
      IconFont = Icons
      GlyphName = 'star'
    end
    object Note: TTyLabel
      Left = 64
      Height = 60
      Top = 196
      Width = 380
      Caption = 'TTyIconFont/TTyCharImage: point FontFile at an icon .ttf (such as FontAwesome), set FontFamily to its family name, then render vector icons via a name→codepoint map. On the left it tries to render a star (★) with the system symbol font; the family differs per platform, so the result may vary.'
      WordWrap = True
    end
  end
  object Icons: TTyIconFont
    FontFamily = 'Segoe UI Symbol'
    Glyphs.Strings = (
      'star=2605'
    )
  end
end
