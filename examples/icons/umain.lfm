      Height = 100
      Top = 74
      Width = 120
      Proportional = True
      Transparent = False
    end
    object Cap3: TTyLabel
      Left = 320
      Height = 20
      Top = 52
      Width = 120
      Caption = 'Center'
    end
    object Img3: TTyImage
      Left = 320
      Height = 100
      Top = 74
      Width = 120
      Center = True
      Transparent = False
    end
    object Cap4: TTyLabel
      Left = 472
      Height = 20
      Top = 52
      Width = 132
      Caption = 'Center = False'
    end
    object Img5: TTyImage
      Left = 472
      Height = 100
      Top = 74
      Width = 120
      Center = False
      Transparent = False
    end
    object LblTrans: TTyLabel
      Left = 16
      Height = 20
      Top = 186
      Width = 290
      Caption = 'Transparent: left True · right False (default)'
    end
    object Img4: TTyImage
      Left = 16
      Height = 100
      Top = 208
      Width = 120
      Proportional = True
      Transparent = True
    end
    object Img7: TTyImage
      Left = 152
      Height = 100
      Top = 208
      Width = 120
      Proportional = True
      Transparent = False
    end
    object LblAuto: TTyLabel
      Left = 320
      Height = 20
      Top = 186
      Width = 284
      Caption = 'AutoSize: the box shrinks to the 120x80 picture'
    end
    object Img6: TTyImage
      Left = 320
      Height = 90
      Top = 208
      Width = 90
      AutoSize = True
      Transparent = False
    end
    object LblIcon: TTyLabel
      Left = 16
      Height = 20
      Top = 320
      Width = 588
      Caption = 'TTyIconFont: glyph names map to codepoints, rendered from one font family'
    end
    object Note: TTyLabel
      Left = 16
      Height = 76
      Top = 342
      Width = 588
      Caption = 'TTyIconFont/TTyCharImage: point FontFile at an icon .ttf (such as FontAwesome), set FontFamily to its family name, then render vector icons via a name→codepoint map. On the left it tries to render a star (★) with the system symbol font; the family differs per platform, so the result may vary.'
      WordWrap = True
    end
    object LblColor: TTyLabel
      Left = 16
      Height = 20
      Top = 428
      Width = 588
      Caption = 'GlyphColor: left explicit blue, right unset → follows the theme text colour (try Dark)'
    end
    object Ch: TTyCharImage
      Left = 16
      Height = 40
      Top = 450
      Width = 40
      IconFont = Icons
      GlyphName = 'star'
      OnClick = IconClick
    end
    object ChThemed: TTyCharImage
      Left = 64
      Height = 40
      Top = 450
      Width = 40
      IconFont = Icons
      GlyphName = 'star'
    end
    object LblSizes: TTyLabel
      Left = 16
      Height = 20
      Top = 498
      Width = 588
      Caption = 'GlyphSize 12 / 24 / 40 in identical 48x48 boxes — 0 (the default) auto-fits the box'
    end
    object ChS1: TTyCharImage
      Left = 16
      Height = 48
      Top = 520
      Width = 48
      IconFont = Icons
      GlyphName = 'star'
      GlyphSize = 12
    end
    object ChS2: TTyCharImage
      Left = 72
      Height = 48
      Top = 520
      Width = 48
      IconFont = Icons
      GlyphName = 'star'
      GlyphSize = 24
    end
    object ChS3: TTyCharImage
      Left = 128
      Height = 48
      Top = 520
      Width = 48
      IconFont = Icons
      GlyphName = 'star'
      GlyphSize = 40
    end
    object LblList: TTyLabel
      Left = 16
      Height = 20
      Top = 580
      Width = 588
      Caption = 'TTyGlyphImageList: the same ordered list drawn twice below — DefaultSize, then half size'
    end
    object GlyphStrip: TTyPaintPanel
      Left = 16
      Height = 64
      Top = 602
      Width = 588
      OnPaintSurface = GlyphStripPaint
    end
    object LblFontFile: TTyLabel
      Left = 16
      Height = 20
      Top = 678
      Width = 588
      Caption = 'FontFile: register a .ttf PRIVATE to the process — no install needed. Set family, then load.'
    end
    object FontFamilyEdit: TTyEdit
      Left = 16
      Height = 30
      Top = 700
      Width = 200
      Text = 'Segoe UI Symbol'
      TextHint = 'Font family name…'
      OnChange = FontFamilyEditChange
    end
    object BtnLoadFont: TTyButton
      Left = 228
      Height = 30
      Top = 700
      Width = 190
      Caption = 'Load icon font (.ttf)…'
      OnClick = BtnLoadFontClick
    end
    object LblStatus: TTyLabel
      Left = 16
      Height = 20
      Top = 740
      Width = 588
      Caption = 'Click the star or the stretched picture — TTyImage and TTyCharImage both publish OnClick.'
    end
    object LblPack: TTyLabel
      Left = 16
      Height = 20
      Top = 776
      Width = 588
      Caption = 'Bundled pack — 2000+ icons compiled in, opt-in: they cost nothing until you use the unit.'
    end
    object BtnBrowse: TTyButton
      Left = 16
      Height = 30
      Top = 800
      Width = 190
      Caption = 'Icon browser…'
      OnClick = BtnBrowseClick
    end
    object PackName: TTyEdit
      Left = 216
      Height = 30
      Top = 800
      Width = 200
      Text = 'house'
      TextHint = 'A Lucide glyph name…'
      OnChange = PackNameChange
    end
    object PackIcon: TTyCharImage
      Left = 428
      Height = 30
      Top = 800
      Width = 30
      IconFont = Lucide
      GlyphName = 'house'
      GlyphSize = 0
    end
    object LblChain: TTyLabel
      Left = 16
      Height = 62
      Top = 842
      Width = 588
      WordWrap = True
      Caption = 'The bundled pack drops on the form; a TTyVirtualImageList names the icons it wants; it IS an image list, so it goes straight to the tree''s Images. The tree below is fed that way.'
    end
    object IconTree: TTyTreeView
      Left = 16
      Height = 150
      Top = 908
      Width = 588
      Images = PackNames
    end
  end
  object Icons: TTyIconFont
    FontFamily = 'Segoe UI Symbol'
    Glyphs.Strings = (
      'star=2605'
      'heart=2665'
      'check=2714'
      'cross=2716'
      'gear=2699'
      'mail=2709'
    )
  end
  object Lucide: TTyLucideIconFont
  end
  object PackNames: TTyVirtualImageList
    IconFont = Lucide
    DefaultSize = 16
    Names.Strings = (
      'folder'
      'file-text'
      'image'
      'music'
      'settings'
    )
  end
  object GlyphList: TTyGlyphImageList
    IconFont = Icons
    DefaultSize = 24
    Glyphs.Strings = (
      'star'
      'heart'
      'check'
      'cross'
      'gear'
      'mail'
    )
  end
end
