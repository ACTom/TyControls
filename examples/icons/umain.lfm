object MainForm: TMainForm
  Left = 0
  Height = 1075
  Top = 0
  Width = 620
  Caption = 'Icons & Images example'
  ClientHeight = 1075
  ClientWidth = 620
  Position = poScreenCenter
  LCLVersion = '4.4.0.0'
  OnCreate = FormCreate
  TitleBar = Bar
  object Surface: TTyFormSurface
    Left = 0
    Height = 1075
    Top = 0
    Width = 620
    Align = alClient
    object Bar: TTyTitleBar
      Left = 0
      Height = 34
      Top = 0
      Width = 620
      Align = alTop
      Caption = 'Icons & Images  · TyControls'
      TitleAlignment = taLeftJustify
      object DarkSwitch: TTyToggleSwitch
        Left = 272
        Height = 24
        Top = 5
        Width = 74
        Anchors = [akTop, akRight]
        Caption = 'Dark'
        OnChange = DarkSwitchChange
      end
      object ThemeCombo: TTyComboBox
        Left = 354
        Height = 26
        Top = 4
        Width = 120
        Anchors = [akTop, akRight]
        OnChange = ThemeComboChange
      end
    end
    object Cap1: TTyLabel
      Left = 16
      Height = 20
      Top = 52
      Width = 120
      Caption = 'Stretch'
    end
    object Img1: TTyImage
      Left = 16
      Height = 100
      Top = 74
      Width = 120
      Stretch = True
      Transparent = False
      OnClick = IconClick
    end
    object Cap2: TTyLabel
      Left = 168
      Height = 20
      Top = 52
      Width = 120
      Caption = 'Proportional'
    end
    object Img2: TTyImage
