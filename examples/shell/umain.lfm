    Left = 0
    Height = 34
    Top = 0
    Width = 1024
    Align = alTop
  end
  object BtnUp: TTyButton
    Left = 16
    Height = 30
    Top = 46
    Width = 90
    Caption = '上一级'
    OnClick = BtnUpClick
  end
  object ChkHidden: TTyCheckBox
    Left = 120
    Height = 22
    Top = 50
    Width = 100
    Caption = '显示隐藏'
