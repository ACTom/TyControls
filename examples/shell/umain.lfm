  end
  object ChkGroup: TTyCheckBox
    Left = 232
    Height = 22
    Top = 50
    Width = 120
    Caption = '按类型分组'
    OnChange = ChkGroupChange
  end
  object BtnMaskAll: TTyButton
    Left = 452
    Height = 30
    Top = 46
    Width = 84
    Caption = '全部'
    OnClick = BtnMaskAllClick
  end
  object BtnMaskCode: TTyButton
    Left = 544
    Height = 30
    Top = 46
    Width = 132
    Caption = '代码文件'
