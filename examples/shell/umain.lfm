  end
  object BtnMaskDoc: TTyButton
    Left = 684
    Height = 30
    Top = 46
    Width = 132
    Caption = '文档文件'
    OnClick = BtnMaskDocClick
  end
  object LblPath: TTyLabel
    Left = 16
    Height = 20
    Top = 88
    Width = 992
