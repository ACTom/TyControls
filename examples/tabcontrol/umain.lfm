object MainForm: TMainForm
  Left = 0
  Height = 420
  Top = 0
  Width = 560
  Caption = 'TTyPageControl example'
  ClientHeight = 420
  ClientWidth = 560
  Position = poScreenCenter
  LCLVersion = '4.4.0.0'
  OnCreate = FormCreate
  TitleBar = Bar
