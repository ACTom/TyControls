        end
        object BtnCancel1: TTyButton
          Left = 116
          Height = 30
          Top = 60
          Width = 90
          Caption = 'Cancel'
        end
      end
      object PgAppearance: TTyTabSheet
        Left = 0
        Height = 264
        Top = 32
