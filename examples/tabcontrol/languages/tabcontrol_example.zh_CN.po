msgstr "当前页：常规（索引 0，共 3 页）"

#: tmainform.btnremovepage.caption
msgid "Remove page"
msgstr "移除页面"

#: tmainform.lblheadersection.caption
msgid "Tab-header features - all of them live in the strip above:"
msgstr "标签头功能，全在上方的标签条里："

#: tmainform.btntogglestrip.caption
msgid "Hide tab strip"
msgstr "隐藏标签条"

#: tmainform.lblstriphint.caption
msgid "TabHeight = 0 removes the strip entirely."
msgstr "TabHeight = 0 可完全去掉标签条。"

#: tmainform.lblclosehint.caption
msgid "Click the x on a tab to close it; OnTabClose keeps the fixed pages."
msgstr "点标签上的 x 关闭它；OnTabClose 会保住固定页面。"

#: tmainform.lblreorderhint.caption
msgid "Drag a tab header sideways to reorder the pages (OnReorder reports it)."
msgstr "横向拖动标签头可重排页面（OnReorder 会报告）。"

#: tmainform.lblkeyshint.caption
msgid "Alt+N / Alt+P / Alt+B jump to a page; Ctrl+Tab cycles; Home / End jump."
msgstr "Alt+N / Alt+P / Alt+B 跳到某页；Ctrl+Tab 循环；Home / End 跳首尾。"

#: tmainform.lbloverflowhint.caption
msgid "Add pages until the headers overflow: arrows appear, the wheel scrolls."
msgstr "一直加页直到标签头放不下：出现箭头，滚轮可滚动。"

