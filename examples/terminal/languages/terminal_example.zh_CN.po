msgstr "接收远端 sz 发来的文件，向远端 rz 发送文件"

#: tmainform.chkpipe.caption
msgid "Pipe"
msgstr "管道"

#: tmainform.chkpipe.hint
msgid "Run the command on two plain pipes instead of ConPTY (binary safe, for ZModem); the list then offers commands that open a terminal on the far side. Takes effect at the next start"
msgstr "不经 ConPTY、用两条普通管道运行命令（二进制安全，给 ZModem 用）；命令列表随之换成在对端自己开终端的命令。下次启动生效"

#: tmainform.btncanceltransfer.caption
msgid "Cancel"
msgstr "取消"

#: tmainform.btncanceltransfer.hint
msgid "Stop the transfer (five Ctrl+X in the terminal do the same)"
msgstr "停止传输（在终端里连按五次 Ctrl+X 也一样）"

#: tmainform.dlgupload.title
msgid "Files to send"
msgstr "要发送的文件"

#: tmainform.dlgdownloaddir.caption
msgid "Save received files in"
msgstr "收到的文件保存到"

