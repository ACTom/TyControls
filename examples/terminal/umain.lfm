object MainForm: TMainForm
  Left = 0
  Height = 640
  Top = 0
  Width = 980
  Caption = 'TTyTerminalView example'
  ClientHeight = 640
  ClientWidth = 980
  ActiveControl = Term
  Position = poScreenCenter
  LCLVersion = '4.4.0.0'
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  TitleBar = Bar
  object Surface: TTyFormSurface
    Left = 0
    Height = 640
    Top = 0
    Width = 980
    Align = alClient
    object Bar: TTyTitleBar
      Left = 0
      Height = 34
      Top = 0
      Width = 980
      Align = alTop
      Caption = 'Terminal replay  · TyControls'
      TitleAlignment = taLeftJustify
      object DarkSwitch: TTyToggleSwitch
        Left = 632
        Height = 24
        Top = 5
        Width = 74
        Anchors = [akTop, akRight]
        Caption = 'Dark'
        OnChange = DarkSwitchChange
      end
      object ThemeCombo: TTyComboBox
        Left = 714
        Height = 26
        Top = 4
        Width = 120
        Anchors = [akTop, akRight]
        OnChange = ThemeComboChange
      end
    end
    object Tools1: TTyPanel
      Left = 0
      Height = 40
      Top = 34
      Width = 980
      Align = alTop
      Caption = ''
      object CmbMode: TTyComboBox
        Left = 10
        Height = 26
        Top = 7
        Width = 100
        Hint = 'Replay a recording, or run a real shell in the terminal'
        Items.Strings = (
          'Replay'
          'Shell'
        )
        ItemIndex = 0
        ShowHint = True
        OnChange = ModeChange
      end
      object LblRecording: TTyLabel
        Left = 120
        Height = 20
        Top = 11
        Width = 76
        Caption = 'Recording:'
      end
      object CmbRecording: TTyComboBox
        Left = 202
        Height = 26
        Top = 7
        Width = 150
        OnChange = RecordingChange
      end
      object BtnOpen: TTyButton
        Left = 362
        Height = 28
        Top = 6
        Width = 84
        AutoSize = True
        Caption = 'Open...'
        Hint = 'Open another asciicast v2 recording'
        ShowHint = True
        OnClick = OpenClick
      end
      object BtnPlay: TTyButton
        Left = 456
        Height = 28
        Top = 6
        Width = 76
        AutoSize = True
        Caption = 'Play'
        StyleClass = 'primary'
        OnClick = PlayClick
      end
      object BtnStep: TTyButton
        Left = 542
        Height = 28
        Top = 6
        Width = 76
        AutoSize = True
        Caption = 'Step'
        Hint = 'Write the next output event'
        ShowHint = True
        OnClick = StepClick
      end
      object LblSpeed: TTyLabel
        Left = 628
        Height = 20
        Top = 11
        Width = 50
        Caption = 'Speed:'
      end
      object CmbSpeed: TTyComboBox
        Left = 684
        Height = 26
        Top = 7
        Width = 100
        Items.Strings = (
          '0.5x'
          '1x'
          '2x'
          '4x'
          'All at once'
        )
        ItemIndex = 1
      end
      object BtnFit: TTyButton
        Left = 794
        Height = 28
        Top = 6
        Width = 150
        AutoSize = True
        Caption = 'Fit to recording'
        Hint = 'Size the window so the grid is the recording''s'
        ShowHint = True
        OnClick = FitClick
      end
    end
    object Tools2: TTyPanel
      Left = 0
      Height = 40
      Top = 74
      Width = 980
      Align = alTop
      Caption = ''
      object ChkReadOnly: TTyCheckBox
        Left = 10
        Height = 24
        Top = 8
        Width = 110
        AutoSize = True
        Caption = 'Read-only'
        Checked = True
        OnClick = ReadOnlyClick
      end
      object ChkEcho: TTyCheckBox
        Left = 140
        Height = 24
        Top = 8
        Width = 120
        AutoSize = True
        Caption = 'Local echo'
      end
      object LblUnicode: TTyLabel
        Left = 284
        Height = 20
        Top = 11
        Width = 64
        Caption = 'Unicode:'
      end
      object CmbUnicode: TTyComboBox
        Left = 354
        Height = 26
        Top = 7
        Width = 140
        Items.Strings = (
          '6'
          '11'
          '15'
          '15-graphemes'
        )
        ItemIndex = 1
        OnChange = UnicodeChange
      end
      object ChkAmbiguous: TTyCheckBox
        Left = 514
        Height = 24
        Top = 8
        Width = 160
        AutoSize = True
        Caption = 'Ambiguous wide'
        OnClick = AmbiguousClick
      end
      object LblFontSize: TTyLabel
        Left = 700
        Height = 20
        Top = 11
        Width = 70
        Caption = 'Font size:'
      end
      object SpnFontSize: TTySpinEdit
        Left = 776
        Height = 26
        Top = 7
        Width = 76
        MinValue = 6
        MaxValue = 32
        Value = 9
        OnChange = FontSizeChange
      end
      object BtnPaste: TTyButton
        Left = 872
        Height = 28
        Top = 6
        Width = 80
        AutoSize = True
        Caption = 'Paste'
        Hint = 'Paste the clipboard into the terminal (what Ctrl+Shift+V does)'
        ShowHint = True
        OnClick = PasteClick
      end
    end
    object Tools3: TTyPanel
      Left = 0
      Height = 40
      Top = 114
      Width = 980
      Align = alTop
      Caption = ''
      Visible = False
      object LblCommand: TTyLabel
        Left = 10
        Height = 20
        Top = 11
        Width = 76
        AutoSize = True
        Caption = 'Command:'
      end
      object CmbCommand: TTyComboBox
        Left = 96
        Height = 26
        Top = 7
        Width = 300
        Hint = 'The program to run; pick one or type a command line'
        ShowHint = True
        Style = csDropDown
      end
      object BtnStart: TTyButton
        Left = 408
        Height = 28
        Top = 6
        Width = 84
        AutoSize = True
        Caption = 'Start'
        Hint = 'Start the command, or start it again'
        ShowHint = True
        StyleClass = 'primary'
        OnClick = StartClick
      end
      object ChkLogPty: TTyCheckBox
        Left = 512
        Height = 24
        Top = 8
        Width = 160
        AutoSize = True
        Caption = 'Log PTY output'
        Hint = 'Show the first 4 KB the PTY sends in the panel on the right, in hex'
        ShowHint = True
      end
      object ChkZmodem: TTyCheckBox
        AnchorSideLeft.Control = ChkLogPty
        AnchorSideLeft.Side = asrBottom
        Left = 690
        Height = 24
        Top = 8
        Width = 90
        AutoSize = True
        BorderSpacing.Left = 18
        Caption = 'ZModem'
        Checked = True
        Hint = 'Receive the files a remote sz sends, send files to a remote rz'
        ShowHint = True
        OnChange = ZmodemChange
      end
      object ChkPipe: TTyCheckBox
        AnchorSideLeft.Control = ChkZmodem
        AnchorSideLeft.Side = asrBottom
        Left = 798
        Height = 24
        Top = 8
        Width = 70
        AutoSize = True
        BorderSpacing.Left = 18
        Caption = 'Pipe'
        Hint = 'Run the command on two plain pipes instead of ConPTY (binary safe, for ZModem); the list then offers commands that open a terminal on the far side. Takes effect at the next start'
        ShowHint = True
        OnChange = PipeChange
      end
    end
    object Tools4: TTyPanel
      Left = 0
      Height = 40
      Top = 154
      Width = 980
      Align = alTop
      Caption = ''
      object ChkCopyOnSelect: TTyCheckBox
        Left = 10
        Height = 24
        Top = 8
        Width = 140
        AutoSize = True
        Caption = 'Copy on select'
        OnClick = CopyOnSelectClick
      end
      object ChkDetectUrls: TTyCheckBox
        Left = 170
        Height = 24
        Top = 8
        Width = 190
        AutoSize = True
        Caption = 'Detect web addresses'
        Checked = True
        Hint = 'Ctrl+click (Cmd+click on macOS) a web address to open it'
        ShowHint = True
        OnClick = DetectUrlsClick
      end
      object LblOsc52: TTyLabel
        Left = 384
        Height = 20
        Top = 11
        Width = 60
        AutoSize = True
        Caption = 'OSC 52:'
      end
      object CmbOsc52: TTyComboBox
        Left = 450
        Height = 26
        Top = 7
        Width = 160
        Hint = 'What a program may do with the clipboard'
        Items.Strings = (
          'Off'
          'Write only'
          'Read and write'
        )
        ItemIndex = 0
        ShowHint = True
        OnChange = Osc52Change
      end
      object LblContrast: TTyLabel
        Left = 630
        Height = 20
        Top = 11
        Width = 118
        AutoSize = True
        Caption = 'Minimum contrast:'
      end
      object CmbContrast: TTyComboBox
        Left = 760
        Height = 26
        Top = 7
        Width = 80
        Hint = 'Push text colours off their background until they reach this contrast ratio (1 = off)'
        ItemIndex = 0
        Items.Strings = (
          '1'
          '3'
          '4.5'
          '7'
        )
        ShowHint = True
        OnChange = ContrastChange
      end
    end
    object Tools5: TTyPanel
      Left = 0
      Height = 40
      Top = 194
      Width = 980
      Align = alTop
      Caption = ''
      object LblColors: TTyLabel
        Left = 10
        Height = 20
        Top = 11
        Width = 56
        AutoSize = True
        Caption = 'Colours:'
      end
      object CmbColors: TTyComboBox
        Left = 80
        Height = 26
        Top = 7
        Width = 240
        Hint = 'Follow the theme, or give the terminal a colour scheme of its own'
        ShowHint = True
        OnChange = ColorsChange
      end
      object BtnImportColors: TTyButton
        Left = 332
        Height = 28
        Top = 6
        Width = 90
        AutoSize = True
        Caption = 'Import...'
        Hint = 'Load a Windows Terminal colour scheme or settings.json'
        ShowHint = True
        OnClick = ImportColorsClick
      end
      object LblCursor: TTyLabel
        Left = 444
        Height = 20
        Top = 11
        Width = 52
        AutoSize = True
        Caption = 'Cursor:'
      end
      object CmbCursor: TTyComboBox
        Left = 502
        Height = 26
        Top = 7
        Width = 110
        Hint = 'The cursor''s shape when the program does not ask for one'
        ItemIndex = 0
        Items.Strings = (
          'Block'
          'Underline'
          'Bar'
        )
        ShowHint = True
        OnChange = CursorStyleChange
      end
      object ChkCursorBlink: TTyCheckBox
        Left = 624
        Height = 24
        Top = 8
        Width = 70
        AutoSize = True
        Caption = 'Blink'
        OnClick = CursorBlinkClick
      end
      object LblCursorInactive: TTyLabel
        Left = 708
        Height = 20
        Top = 11
        Width = 76
        AutoSize = True
        Caption = 'Unfocused:'
      end
      object CmbCursorInactive: TTyComboBox
        Left = 790
        Height = 26
        Top = 7
        Width = 110
        Hint = 'The cursor when the terminal does not have the focus'
        ItemIndex = 0
        Items.Strings = (
          'Outline'
          'Block'
          'Bar'
          'Underline'
          'None'
        )
        ShowHint = True
        OnChange = CursorInactiveChange
      end
    end
    object Tools6: TTyPanel
      Left = 0
      Height = 40
      Top = 575
      Width = 980
      Align = alBottom
      Caption = ''
      Visible = False
      object LblTransfer: TTyLabel
        Left = 10
        Height = 20
        Top = 10
        Width = 60
        Align = alLeft
        AutoSize = True
        BorderSpacing.Left = 10
        BorderSpacing.Top = 10
        BorderSpacing.Bottom = 10
        Caption = ''
      end
      object BtnCancelTransfer: TTyButton
        Left = 888
        Height = 28
        Top = 6
        Width = 84
        Align = alRight
        AutoSize = True
        BorderSpacing.Top = 6
        BorderSpacing.Right = 8
        BorderSpacing.Bottom = 6
        Caption = 'Cancel'
        Hint = 'Stop the transfer (five Ctrl+X in the terminal do the same)'
        ShowHint = True
        OnClick = CancelTransferClick
      end
      object BarTransfer: TTyProgressBar
        Left = 80
        Height = 16
        Top = 12
        Width = 796
        Align = alClient
        AnimationsEnabled = False
        BorderSpacing.Left = 12
        BorderSpacing.Top = 12
        BorderSpacing.Right = 12
        BorderSpacing.Bottom = 12
        Max = 1000
      end
    end
    object Status: TTyStatusBar
      Left = 0
      Height = 24
      Top = 616
      Width = 980
      Align = alBottom
      Panels = <
        item
          Text = ''
          Width = 0
          Alignment = taLeftJustify
        end
        item
          Text = ''
          Width = 110
          Alignment = taCenter
        end
        item
          Text = ''
          Width = 320
          Alignment = taLeftJustify
        end>
    end
    object Keys: TTyMemo
      Left = 690
      Height = 382
      Top = 234
      Width = 290
      Align = alRight
      ReadOnly = True
      ScrollBars = ssAutoVertical
      WordWrap = False
    end
    object Split: TTySplitter
      Left = 684
      Height = 382
      Top = 234
      Width = 6
      Align = alRight
      MinSize = 120
      ResizeStyle = rsUpdate
    end
    object Term: TTyTerminalView
      Left = 0
      Height = 382
      Top = 234
      Width = 684
      Align = alClient
      ReadOnly = True
      CopyOnSelect = False
      DetectUrls = True
      Osc52 = to52Off
      OnData = TermData
      OnGridResize = TermGridResize
      OnTitleChange = TermTitleChange
      OnLinkActivate = TermLinkActivate
      OnOsc52 = TermOsc52
      OnClaimedInput = TermClaimedInput
    end
  end
  object DlgOpen: TTyOpenDialog
    Title = 'Open a recording'
    Filter = 'asciicast (*.cast)|*.cast|All files (*.*)|*.*'
    Left = 40
    Top = 160
  end
  object DlgColors: TTyOpenDialog
    Title = 'Import a colour scheme'
    Filter = 'Windows Terminal colour schemes (*.json)|*.json|All files (*.*)|*.*'
    Left = 160
    Top = 160
  end
  object Player: TTimer
    Enabled = False
    Interval = 15
    OnTimer = PlayerTimer
    Left = 100
    Top = 160
  end
  object DlgUpload: TTyOpenDialog
    Title = 'Files to send'
    Options = [fdoFileMustExist, fdoAllowMultiSelect]
    Left = 220
    Top = 160
  end
  object DlgDownloadDir: TTySelectPathDialog
    Caption = 'Save received files in'
    Left = 280
    Top = 160
  end
  object ZmTimer: TTimer
    Enabled = False
    Interval = 100
    OnTimer = ZmTimerTimer
    Left = 340
    Top = 160
  end
end
