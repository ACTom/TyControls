#: tmainform.caption
msgid "TTySpinEdit example"
msgstr "TTySpinEdit 示例"

#: tmainform.darkswitch.caption
msgid "Dark"
msgstr "暗色"

#: tmainform.lblqty.caption
msgid "Quantity (0..100, step 1; arrow keys / wheel / typing):"
msgstr "数量（0..100，步进 1；箭头/方向键/滚轮/键入）："

#: tmainform.lblofs.caption
msgid "Offset (-50..50, step 5, includes negatives):"
msgstr "偏移（-50..50，步进 5，含负值范围）："

#: tmainform.lblyear.caption
msgid "Year (right-aligned Alignment, MaxLength=4):"
msgstr "年份（右对齐 Alignment，MaxLength=4）："

#: tmainform.lbllock.caption
msgid "Locked (ReadOnly=True: no edit/step/wheel):"
msgstr "锁定（ReadOnly=True：不可编辑/步进/滚轮）："

#: tmainform.lblstatuscap.caption
msgid "Status:"
msgstr "状态："

#: tmainform.lblstatus.caption
msgid "(change any value to see the OnChange output)"
msgstr "（改变任一数值以查看 OnChange 输出）"

#: tmainform.btnpoke.caption
msgid "Value := 999 in code"
msgstr "代码里 Value := 999"

#: tmainform.lblcentre.caption
msgid "Centred text (Alignment=taCenter):"
msgstr "文本居中（Alignment=taCenter）："

#: tmainform.lblcommit.caption
msgid "Type digits into any box: Enter commits them, Esc reverts to the last value. An out-of-range number is clamped into the range, never rejected."
msgstr "在任一框中键入数字：Enter 提交，Esc 还原为上一个值。超出范围的数字会被钳制回范围内，而不会被拒绝。"

#: tmainform.lblclickcap.caption
