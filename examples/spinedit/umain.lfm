object MainForm: TMainForm
  Left = 0
  Height = 504
  Top = 0
  Width = 440
  Caption = 'TTySpinEdit example'
  ClientHeight = 504
  ClientWidth = 440
  Position = poScreenCenter
  LCLVersion = '4.4.0.0'
  OnCreate = FormCreate
  TitleBar = Bar
  object Surface: TTyFormSurface
    Left = 0
    Height = 504
    Top = 0
    Width = 440
    TabOrder = 0
    Align = alClient
    object Bar: TTyTitleBar
      Left = 0
      Height = 34
      Top = 0
      Width = 440
      Align = alTop
      Caption = 'TTySpinEdit  ·  TyControls'
      TitleAlignment = taLeftJustify
      object DarkSwitch: TTyToggleSwitch
        Left = 92
        Height = 24
        Top = 5
        Width = 74
        Anchors = [akTop, akRight]
        Caption = 'Dark'
        OnChange = DarkSwitchChange
      end
      object ThemeCombo: TTyComboBox
        Left = 174
        Height = 26
        Top = 4
        Width = 120
        Anchors = [akTop, akRight]
        OnChange = ThemeComboChange
      end
    end
    object LblQty: TTyLabel
      Left = 24
      Height = 20
      Top = 52
      Width = 380
      Caption = 'Quantity (0..100, step 1; arrow keys / wheel / typing):'
    end
    object SpinQty: TTySpinEdit
      Left = 24
      Height = 28
      Top = 76
      Width = 130
      MinValue = 0
      MaxValue = 100
      Increment = 1
      Value = 10
      OnChange = SpinChange
      OnClick = SpinClick
    end
    object LblOfs: TTyLabel
      Left = 24
      Height = 20
      Top = 120
      Width = 380
      Caption = 'Offset (-50..50, step 5, includes negatives):'
    end
    object SpinOfs: TTySpinEdit
      Left = 24
      Height = 28
      Top = 144
      Width = 130
      MinValue = -50
      MaxValue = 50
      Increment = 5
      Value = 0
      OnChange = SpinChange
    end
    object LblYear: TTyLabel
      Left = 24
      Height = 20
      Top = 188
      Width = 380
      Caption = 'Year (right-aligned Alignment, MaxLength=4):'
    end
    object SpinYear: TTySpinEdit
      Left = 24
      Height = 28
      Top = 212
      Width = 130
      MinValue = 1900
      MaxValue = 2100
      Value = 2026
      Alignment = taRightJustify
      MaxLength = 4
      OnChange = SpinChange
    end
    object LblLock: TTyLabel
      Left = 24
      Height = 20
      Top = 256
      Width = 380
      Caption = 'Locked (ReadOnly=True: no edit/step/wheel):'
    end
    object SpinLock: TTySpinEdit
      Left = 24
      Height = 28
      Top = 280
      Width = 130
      MinValue = 0
      MaxValue = 999
      Value = 42
      ReadOnly = True
      OnChange = SpinChange
    end
    object LblStatusCap: TTyLabel
      Left = 24
      Height = 20
      Top = 444
      Width = 60
      Caption = 'Status:'
    end
    object LblStatus: TTyLabel
      Left = 84
      Height = 20
      Top = 444
      Width = 336
      Caption = '(change any value to see the OnChange output)'
    end
    object BtnPoke: TTyButton
      Left = 180
      Height = 28
      Top = 76
      Width = 180
      Caption = 'Value := 999 in code'
      OnClick = PokeClick
    end
    object LblCentre: TTyLabel
      Left = 24
      Height = 20
      Top = 320
      Width = 380
      Caption = 'Centred text (Alignment=taCenter):'
    end
    object SpinCentre: TTySpinEdit
      Left = 24
      Height = 28
      Top = 344
      Width = 130
      MinValue = 0
      MaxValue = 100
      Value = 50
      Alignment = taCenter
      OnChange = SpinChange
    end
    object LblCommit: TTyLabel
      Left = 24
      Height = 40
      Top = 384
      Width = 380
      Caption = 'Type digits into any box: Enter commits them, Esc reverts to the last value. An out-of-range number is clamped into the range, never rejected.'
      WordWrap = True
    end
    object LblClickCap: TTyLabel
      Left = 24
      Height = 20
      Top = 468
      Width = 60
      Caption = 'Click:'
    end
    object LblClick: TTyLabel
      Left = 84
      Height = 20
      Top = 468
      Width = 336
      Caption = '(click the quantity box to see OnClick)'
    end
  end
end
