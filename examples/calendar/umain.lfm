object MainForm: TMainForm
  Left = 0
  Height = 620
  Top = 0
  Width = 720
  Caption = 'Calendar example'
  ClientHeight = 620
  ClientWidth = 720
  Position = poScreenCenter
  LCLVersion = '4.4.0.0'
  OnCreate = FormCreate
  TitleBar = Bar
  object Surface: TTyFormSurface
    Left = 0
    Height = 620
    Top = 0
    Width = 720
    TabOrder = 0
    Align = alClient
    object Bar: TTyTitleBar
      Left = 0
      Height = 34
      Top = 0
      Width = 720
      Align = alTop
      Caption = 'TTyCalendar  ·  TyControls'
      TitleAlignment = taLeftJustify
      object DarkSwitch: TTyToggleSwitch
        Left = 372
        Height = 24
        Top = 5
        Width = 74
        Anchors = [akTop, akRight]
        Caption = 'Dark'
        OnChange = DarkSwitchChange
      end
      object ThemeCombo: TTyComboBox
        Left = 454
        Height = 26
        Top = 4
        Width = 120
        Anchors = [akTop, akRight]
        OnChange = ThemeComboChange
      end
    end
    object LblMainHdr: TTyLabel
      Left = 20
      Height = 22
      Top = 48
      Width = 320
      Caption = 'Interactive calendar (week starts Monday · shows week numbers · today highlighted):'
    end
    object Cal: TTyCalendar
      Left = 20
      Height = 300
      Top = 74
      Width = 320
      FirstDayOfWeek = wdMonday
      WeekNumbers = True
      ShowToday = True
      OnChange = CalChange
      OnAccept = CalAccept
      OnViewChange = CalViewChange
    end
    object LblPicked: TTyLabel
      Left = 360
      Height = 22
      Top = 74
      Width = 340
    end
    object LblAccepted: TTyLabel
      Left = 360
      Height = 44
      Top = 100
      Width = 340
    end
    object LblView: TTyLabel
      Left = 360
      Height = 44
      Top = 150
      Width = 340
    end
    object LblRange: TTyLabel
      Left = 360
      Height = 88
      Top = 206
      Width = 340
    end
    object LblReadOnlyHdr: TTyLabel
      Left = 360
      Height = 60
      Top = 300
      Width = 340
      Caption = 'Read-only calendar (ReadOnly=True · Sunday start · ShowToday=False - today gets no outline here):'
      WordWrap = True
    end
    object ROCal: TTyCalendar
      Left = 360
      Height = 230
      Top = 364
      Width = 320
      FirstDayOfWeek = wdSunday
      ShowToday = False
      ReadOnly = True
    end
    object LblLimitHdr: TTyLabel
      Left = 20
      Height = 22
      Top = 386
      Width = 320
      Caption = 'MinDate / MaxDate - watch which cells grey out:'
    end
    object SwLimit: TTyToggleSwitch
      Left = 20
      Height = 24
      Top = 412
      Width = 250
      Checked = True
      Caption = 'Limit the range to 3 months'
      OnChange = SwLimitChange
    end
    object LblLimitHint: TTyLabel
      Left = 20
      Height = 100
      Top = 442
      Width = 320
      Caption = 'Off = both bounds are 0 (the documented no-bound sentinel): every month is reachable, so PageUp/PageDown really walk the grid. On = only the 3 months either side of today stay selectable.'
      WordWrap = True
    end
  end
end
