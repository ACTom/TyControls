msgid "Row %d unchecked"
msgstr "第 %d 行已取消勾选"

#: umain.rssamplecomment
msgid "This is a sample comment — hover the small triangle in the top-right to show it"
msgstr "这是一条示例批注 —— 悬停右上角的小三角就能看到"

#: umain.rssat
msgid "Sat"
msgstr "周六"

#: umain.rsscrollbarnote
msgid "The scrollbar \"hidden\" only means it is not shown — the wheel, arrow keys and PageDown still reach the bottom"
msgstr "滚动条「隐藏」只是不显示 —— 滚轮、方向键和 PageDown 照样能到底"

#: umain.rsscrollhintfmt
#, object-pascal-format
msgid "Row %d / %d total"
msgstr "第 %d 行 / 共 %d 行"

#: umain.rsselcsvhead
msgid "Selection CSV:"
msgstr "选区 CSV："

#: umain.rsselexportedfmt
#, object-pascal-format
msgid "Exported %d rows x %d columns of the selection"
msgstr "导出了选区的 %d 行 x %d 列"

#: umain.rsselmanyfmt
#, object-pascal-format
msgid "Current (col %d, row %d)  ·  %d rows / %d shown / %d cells stored  ·  %d cells selected, sum %.2f, average %.2f"
msgstr "当前 (列 %d, 行 %d)  ·  %d 行 / 显示 %d 行 / 已存 %d 格  ·  选中 %d 格，合计 %.2f，平均 %.2f"

#: umain.rsselmodenote
msgid "In whole-row/whole-column mode the focused cell still has its own background — you can see which cell the cursor is on"
msgstr "整行/整列模式下焦点格仍有自己的底色 —— 看得出光标在哪一格"

#: umain.rsselonefmt
#, object-pascal-format
msgid "Current (col %d, row %d) = %s  ·  %d rows / %d shown / %d cells stored"
msgstr "当前 (列 %d, 行 %d) = %s  ·  %d 行 / 显示 %d 行 / 已存 %d 格"

#: umain.rsseltexthead
msgid "Selection text (tab-separated, clipboard untouched):"
msgstr "选区文本（制表符分隔，不动剪贴板）："

#: umain.rssortaddedfmt
#, object-pascal-format
msgid "Added a secondary sort column — there are now %d sort keys, the header shows order badges"
msgstr "追加了次级排序列 —— 现在有 %d 个排序键，表头出现顺位徽标"

#: umain.rssortcleared
msgid "Sort cleared — the row order jumps back to the original import order"
msgstr "排序已清除 —— 行序跳回原始导入顺序"

#: umain.rssortqtyasc
msgid "Sort \"Qty\" ascending — column-level SortKind = gskNumber, so 9 comes before 100"
msgstr "按「数量」升序 —— 列级 SortKind = gskNumber，所以 9 排在 100 前面"

#: umain.rssortqtydesc
msgid "Sort \"Qty\" descending"
msgstr "按「数量」降序"

#: umain.rsstreamfmt
#, object-pascal-format
msgid "Stream round trip: %d rows → %d bytes → %d rows"
msgstr "流往返：%d 行 → %d 字节 → %d 行"

#: umain.rssun
msgid "Sun"
msgstr "周日"

#: umain.rsthu
msgid "Thu"
msgstr "周四"

#: umain.rstreeoff
msgid "Tree column off"
msgstr "树形列已关"

#: umain.rstreeon
