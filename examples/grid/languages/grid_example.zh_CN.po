#: umain.rsratingfmt
#, object-pascal-format
msgid "Rating changed to %d star(s) (row %d) — the star you click is the score, no editor pops up"
msgstr "评分改为 %d 星（第 %d 行）—— 点第几颗星就是几分，不弹编辑器"

