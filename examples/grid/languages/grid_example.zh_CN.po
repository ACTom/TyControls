msgstr "在当前行上方插入了一行"

#: umain.rsrowlockedfmt
#, object-pascal-format
msgid "Row %d is locked and cannot be checked (but the cursor can still move over it)"
msgstr "第 %d 行被锁定，勾不上（但光标仍能移过去）"

#: umain.rsrowmovevetofmt
#, object-pascal-format
msgid "OnRowMove vetoed: row %d may not be dragged to the first row"
msgstr "OnRowMove 否决：第 %d 行不许拖到首行"

#: umain.rsrowsautofit
