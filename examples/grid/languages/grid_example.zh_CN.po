msgstr "树形列已开 —— 点第一列的三角可折叠/展开；层级由宿主提供，控件不持有树"

#: umain.rstue
msgid "Tue"
msgstr "周二"

#: umain.rstypingfmt
#, object-pascal-format
msgid "Typing at (%d, %d): \"%s\" — fired on every keystroke, not on commit"
msgstr "正在 (%d, %d) 输入：\"%s\" —— 每次击键都发，不是提交才发"

#: umain.rsunbolded
msgid "Unbolded"
msgstr "已取消加粗"

#: umain.rsundone
