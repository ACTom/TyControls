msgid "Row 2 is not editable — note its checkbox is still drawn as a checkbox, it just cannot be clicked"
msgstr "第 2 行不可编辑 —— 注意它的勾选框仍画成勾选框，只是点不动"

#: umain.rsrowcheckedfmt
#, object-pascal-format
msgid "Row %d checked"
msgstr "第 %d 行已勾选"

#: umain.rsrowcoloredfmt
#, object-pascal-format
msgid "Row %d whole-row coloured"
msgstr "第 %d 行整行着色"

#: umain.rsrowdeleted
