msgstr "替换了 %d 处（只读格自动跳过）"

#: umain.rsrestored200
msgid "Restored 200 rows"
msgstr "已恢复 200 行"

#: umain.rsrightclickfmt
#, object-pascal-format
msgid "Right-clicked at (col %d, row %d) — note the selection box on the left did not follow"
msgstr "右键点在 (列 %d, 行 %d) —— 注意左边的选中框没有跟过来"

