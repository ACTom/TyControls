#, object-pascal-format
msgid "OnClipboardPaste saw the whole block first: %d line(s), uppercased before the grid parsed it"
msgstr "OnClipboardPaste 先看到了整块：%d 行，在网格解析之前被转成了大写"

#: umain.rspasted2lines
msgid "Pasted 2 lines from a hardcoded text — via the same path as the clipboard"
msgstr "从硬编码文本粘了 2 行进来 —— 与剪贴板走同一条路"

#: umain.rspastedgridfmt
#, object-pascal-format
msgid "Pasted — now %d rows x %d columns"
msgstr "已粘贴 —— 现在是 %d 行 x %d 列"

#: umain.rspastewrotefmt
#, object-pascal-format
msgid "This paste wrote %d cell(s) (changed cells are tinted)"
msgstr "这次粘贴写入了 %d 格（被改过的格已染色）"

#: umain.rsphysicaloff
msgid "Sort only changes the display order, the data does not move (default)"
msgstr "排序只改显示顺序，数据不动（默认）"

#: umain.rsphysicalon
msgid "Sorting really moves the data (undoable) — after sorting, merge and row-drag are no longer refused; attaching a filter or grouping falls back to ordinary sort automatically"
msgstr "排序真的搬动数据（可撤销）—— 排完之后合并、拖行不再被拒绝；挂上筛选或分组会自动退回普通排序"

#: umain.rspickcellcolor
msgid "Pick a background colour for the selected cells"
msgstr "为选中的单元格挑一个底色"

#: umain.rspickproduct
msgid "Choose product"
msgstr "选择产品"

#: umain.rspickproductfmt
#, object-pascal-format
msgid "Product for row %d (available: %s)"
msgstr "第 %d 行的产品（可选：%s）"

#: umain.rsprodcdn
