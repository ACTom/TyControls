msgstr "大区列不许本地排序 —— 真实场景里这会变成一次服务端请求"

#: umain.rsregionnw
msgid "Northwest"
msgstr "西北"

#: umain.rsregions
msgid "South China"
msgstr "华南"

#: umain.rsregionsw
msgid "Southwest"
msgstr "西南"

#: umain.rsreplacedfmt
