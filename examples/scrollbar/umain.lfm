object MainForm: TMainForm
  Left = 0
  Height = 720
  Top = 0
  Width = 820
  Caption = 'Scrollbar example'
  ClientHeight = 720
  ClientWidth = 820
  Position = poScreenCenter
  LCLVersion = '4.4.0.0'
  OnCreate = FormCreate
  TitleBar = Bar
  object Surface: TTyFormSurface
    Left = 0
    Height = 720
    Top = 0
    Width = 820
    Align = alClient
    object Bar: TTyTitleBar
      Left = 0
      Height = 34
      Top = 0
      Width = 820
      Align = alTop
      Caption = 'TTyScrollBar  ·  TyControls'
      TitleAlignment = taLeftJustify
      object DarkSwitch: TTyToggleSwitch
        Left = 472
        Height = 24
        Top = 5
        Width = 74
        Anchors = [akTop, akRight]
        Caption = 'Dark'
        OnChange = DarkSwitchChange
      end
      object ThemeCombo: TTyComboBox
        Left = 554
        Height = 26
        Top = 4
        Width = 120
        Anchors = [akTop, akRight]
        OnChange = ThemeComboChange
      end
    end
    object LblTip: TTyLabel
      Left = 24
      Height = 20
      Top = 48
      Width = 512
      Caption = 'Drag slider, click track/arrows, spin wheel, arrow keys, PageUp/PageDown, Home/End'
    end
    object VBar: TTyScrollBar
      Left = 28
      Height = 236
      Top = 80
      Width = 18
      Kind = sbVertical
      Min = 0
      Max = 200
      Position = 100
      PageSize = 20
      SmallChange = 5
      AutoHide = sbahAuto
      OnChange = BarChange
      OnScroll = BarScroll
    end
    object HBar: TTyScrollBar
      Left = 80
      Height = 18
      Top = 298
      Width = 372
      Kind = sbHorizontal
      Min = 0
      Max = 100
      Position = 25
      PageSize = 10
      SmallChange = 2
      AutoHide = sbahAuto
      OnChange = BarChange
      OnScroll = BarScroll
    end
    object LblStatus: TTyLabel
      Left = 80
      Height = 90
      Top = 96
      Width = 372
      WordWrap = True
    end
    object LblCodeTitle: TTyLabel
      Left = 24
      Height = 20
      Top = 332
      Width = 512
      Caption = 'OnScroll reports which gesture moved the bar, and can overrule the proposed value'
    end
    object LblCode: TTyLabel
      Left = 24
      Height = 40
      Top = 356
      Width = 512
      WordWrap = True
      Layout = tlTop
      Caption = 'Press Home on the vertical bar: the handler forces 10, not Min'
    end
    object LblViewTitle: TTyLabel
      Left = 24
      Height = 20
      Top = 408
      Width = 512
      Caption = 'The vertical bar scrolls this block of text; the buttons contrast eased vs snapped'
    end
    object Viewport: TTyPanel
      Left = 24
      Height = 160
      Top = 432
      Width = 340
      object LblContent: TTyLabel
        Left = 10
        Height = 360
        Top = 0
        Width = 320
        WordWrap = True
        Layout = tlTop
      end
    end
    object BtnSnap: TTyButton
      Left = 380
      Height = 30
      Top = 432
      Width = 156
      Caption = 'Top (snapped)'
      OnClick = BtnSnapClick
    end
    object BtnEase: TTyButton
      Left = 380
      Height = 30
      Top = 472
      Width = 156
      Caption = 'Middle (eased)'
      OnClick = BtnEaseClick
    end
    object LblSnapHint: TTyLabel
      Left = 380
      Height = 78
      Top = 510
      Width = 156
      WordWrap = True
      Layout = tlTop
      Caption = 'SetPositionSnapped lands at once; a plain Position write glides the thumb there'
    end
    object SwAnim: TTyToggleSwitch
      Left = 24
      Height = 24
      Top = 604
      Width = 140
      Caption = 'Animated thumb'
      Checked = True
      OnChange = SwAnimChange
    end
    object LblAnim: TTyLabel
      Left = 24
      Height = 20
      Top = 632
      Width = 512
      Caption = 'Turn it off, then click the track: the thumb jumps instead of gliding'
    end
    object LblFull: TTyLabel
      Left = 24
      Height = 20
      Top = 660
      Width = 512
      Caption = 'Max = Min: nothing to scroll, so the thumb fills the whole track'
    end
    object FullBar: TTyScrollBar
      Left = 24
      Height = 18
      Top = 684
      Width = 512
      Kind = sbHorizontal
      Min = 0
      Max = 0
      Position = 0
      PageSize = 10
      SmallChange = 1
    end
    object LblAutoTitle: TTyLabel
      Left = 560
      Height = 64
      Top = 48
      Width = 236
      WordWrap = True
      Layout = tlTop
      Caption = 'A bar nobody is using fades out; point at its list and it is back'
    end
    object RgAutoHide: TTyRadioGroup
      Left = 560
      Height = 140
      Top = 116
      Width = 236
      Caption = 'AutoHide - both bars and the list'
      Items.Strings = (
        'sbahDefault - theme decides'
        'sbahNever - never fades'
        'sbahAuto - always fades'
      )
      ItemIndex = 2
      OnSelectionChanged = RgAutoHideSelectionChanged
    end
    object LblAutoMs: TTyLabel
      Left = 560
      Height = 88
      Top = 264
      Width = 236
      WordWrap = True
      Layout = tlTop
    end
    object AutoList: TTyListBox
      Left = 560
      Height = 216
      Top = 360
      Width = 236
      ScrollBarAutoHide = sbahAuto
    end
    object LblAutoHint: TTyLabel
      Left = 560
      Height = 116
      Top = 584
      Width = 236
      WordWrap = True
      Layout = tlTop
      Caption = 'Move the pointer over the list and its bar appears; take it away and the bar fades after the delay above. Only win11, macOS, fluent, material3, adwaita and ubuntu ship it on'
    end
  end
end
