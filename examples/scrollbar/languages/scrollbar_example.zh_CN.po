msgstr "垂直：Position = %d   （Min %d / Max %d / PageSize %d / SmallChange %d）"

#: umain.rsbarsfmt2
#, object-pascal-format
msgid "Horizontal:  Position = %d   (Min %d / Max %d / PageSize %d / SmallChange %d)"
msgstr "水平：Position = %d   （Min %d / Max %d / PageSize %d / SmallChange %d）"

#: umain.rseffectivefmt
#, object-pascal-format
msgid "Bar EffectiveAutoHideMs: %s"
msgstr "本条 EffectiveAutoHideMs：%s"

#: umain.rslinefmt
#, object-pascal-format
msgid "Line %.2d - scrollable content"
msgstr "第 %.2d 行 —— 可滚动内容"

#: umain.rsscrollfmt
#, object-pascal-format
msgid "%s OnScroll: %s -> %d"
msgstr "%s OnScroll：%s -> %d"

#: umain.rsthemetokenfmt
