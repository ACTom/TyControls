# --- .lfm captions/text/hints (auto-generated, msgid=English source) ---

#: tmainform.caption
msgid "Scrollbar example"
msgstr "滚动条 示例"

#: tmainform.darkswitch.caption
msgid "Dark"
msgstr "暗色"

#: tmainform.lbltip.caption
msgid "Drag slider, click track/arrows, spin wheel, arrow keys, PageUp/PageDown, Home/End"
msgstr "拖动滑块、点击轨道/箭头、滚轮、方向键、PageUp/PageDown、Home/End"

#: tmainform.lblcodetitle.caption
msgid "OnScroll reports which gesture moved the bar, and can overrule the proposed value"
msgstr "OnScroll 报告是哪种手势移动了滚动条，并可改写建议值"

#: tmainform.lblcode.caption
msgid "Press Home on the vertical bar: the handler forces 10, not Min"
msgstr "在垂直条上按 Home：处理程序强制为 10，而不是 Min"

#: tmainform.lblviewtitle.caption
msgid "The vertical bar scrolls this block of text; the buttons contrast eased vs snapped"
msgstr "垂直条滚动这段文本；两个按钮对比缓动与瞬时"

#: tmainform.btnsnap.caption
msgid "Top (snapped)"
msgstr "顶部（瞬时）"

#: tmainform.btnease.caption
msgid "Middle (eased)"
msgstr "中部（缓动）"

#: tmainform.lblsnaphint.caption
msgid "SetPositionSnapped lands at once; a plain Position write glides the thumb there"
msgstr "SetPositionSnapped 立即到位；直接写 Position 则让滑块滑过去"

#: tmainform.lblanim.caption
msgid "Turn it off, then click the track: the thumb jumps instead of gliding"
msgstr "关掉它再点击轨道：滑块直接跳过去，不再滑行"

#: tmainform.lblfull.caption
msgid "Max = Min: nothing to scroll, so the thumb fills the whole track"
msgstr "Max = Min：没有可滚动的量，滑块铺满整条轨道"

#: tmainform.bar.caption
msgid "TTyScrollBar  ·  TyControls"
msgstr "TTyScrollBar  ·  TyControls"

#: tmainform.swanim.caption
msgid "Animated thumb"
msgstr "滑块动画"

#: tmainform.lblautotitle.caption
msgid "A bar nobody is using fades out; it comes back the moment you touch it"
msgstr "没人用的滚动条会淡出；一碰它就回来"

#: tmainform.rgautohide.caption
msgid "AutoHide - both bars and the list"
msgstr "AutoHide —— 两条滚动条和那个列表"

#: tmainform.rgautohide.items
msgid "sbahDefault - theme decides"
msgstr "sbahDefault —— 听主题的"

#: tmainform.rgautohide.items
msgid "sbahNever - never fades"
msgstr "sbahNever —— 从不淡出"

#: tmainform.rgautohide.items
msgid "sbahAuto - always fades"
msgstr "sbahAuto —— 一定淡出"

#: tmainform.lblautohint.caption
msgid "Scroll the list, then let go: its bar fades after the delay above. A bar that has not been used yet does not fade. Only win11, macOS, fluent, material3, adwaita and ubuntu ship it on"
msgstr "滚一下列表再松手：过了上面那个延时，它的滚动条就淡出。还没被用过的条不会淡。出厂开着它的只有 win11、macOS、fluent、material3、adwaita、ubuntu"

