    object LblWrapHint: TTyLabel
      Left = 24
      Height = 54
      Top = 336
      Width = 472
      Caption = 'Top bar — Wrapable = True (the default): the 12 tools wrap into 3 rows and the bar grows to 104 px to fit them. Flat = True hands every tool the ghost StyleClass.'
      WordWrap = True
    end
    object LblDownHint: TTyLabel
      Left = 24
      Height = 36
      Top = 396
      Width = 472
      Caption = 'Down = True — a pressed tool keeps the ghost:selected look. Bold starts pressed; click Bold / Italic / Underline to toggle one.'
      WordWrap = True
    end
    object LblGlyphHint: TTyLabel
      Left = 24
      Height = 36
      Top = 438
      Width = 472
      Caption = 'New / Open / Save are TTyGlyphButtons — the bar accepts any TTyButton descendant and gives it the same ghost style and row metrics.'
      WordWrap = True
    end
    object LblFramedHint: TTyLabel
      Left = 24
      Height = 90
      Top = 480
      Width = 472
      Caption = 'Second bar — Flat = False: the bar clears the ghost class, so its tools are framed push buttons. Wrapable = False: they stay on one row, so the last tool runs off the right edge instead of wrapping. ButtonHeight is left unset, so its tool height follows the theme --control-height (classic 24 / modern 38) — switch skins and watch this bar alone change height.'
      WordWrap = True
    end
    object LblToolBtnHint: TTyLabel
      Left = 24
      Height = 72
      Top = 576
      Width = 472
      Caption = 'Third bar — real TTyToolButtons, all six styles: Run = tbsButton, Pin = tbsCheck, a tbsSeparator gap, Day / Week / Month = adjacent Grouped checks (one exclusive group), a tbsDivider line, and both drop-down styles. Wrap = True on Month ends the first row there even though Wrapable is True.'
      WordWrap = True
    end
    object LblDropHint: TTyLabel
      Left = 24
      Height = 72
      Top = 654
      Width = 472
      Caption = 'Save (tbsDropDown) is split: only its arrow zone pops the DropdownMenu, the body is a plain click. Export has no menu, so its arrow fires OnArrowClick instead — an assigned menu suppresses that event. Share (tbsButtonDrop) pops its menu from a click anywhere on the face.'
      WordWrap = True
    end
    object LblPaintHint: TTyLabel
      Left = 24
      Height = 72
      Top = 732
      Width = 472
      Caption = 'Fourth and fifth bars — the same three buttons twice: the fourth draws the themed default, the fifth assigns OnPaintButton and that one handler replaces the paint of every button on its bar (LCL''s signature and AState integer). Crimson starts Down on both, so compare the checked state.'
      WordWrap = True
    end
    object LblLendHint: TTyLabel
      Left = 24
      Height = 72
      Top = 810
      Width = 472
      Caption = 'ShowCaptions and Images are wired: the bar lends its image collection to any icon-capable tool that has none of its own, and pushes ShowCaptions the same way — a tool the host configured itself is never overridden. This demo''s tools use TTyIconFont glyphs instead.'
      WordWrap = True
    end
    object LblStatus: TTyLabel
      Left = 24
      Height = 24
      Top = 888
      Width = 472
      Caption = 'Ready: click any toolbar button'
    end
  end
  object Icons: TTyIconFont
    FontFamily = 'Segoe UI Symbol'
    Glyphs.Strings = (
      'new=1F4C4'
      'open=1F4C2'
      'save=1F4BE'
    )
  end
  object SaveMenu: TTyPopupMenu
    object MnuSaveAs: TMenuItem
      Caption = 'Save as…'
      OnClick = MenuPicked
    end
    object MnuSaveCopy: TMenuItem
      Caption = 'Save a copy'
      OnClick = MenuPicked
    end
    object MnuSaveAll: TMenuItem
      Caption = 'Save all'
      OnClick = MenuPicked
    end
  end
  object ShareMenu: TTyPopupMenu
    object MnuShareLink: TMenuItem
      Caption = 'Copy link'
      OnClick = MenuPicked
    end
    object MnuShareMail: TMenuItem
      Caption = 'Send by mail'
      OnClick = MenuPicked
    end
  end
end
