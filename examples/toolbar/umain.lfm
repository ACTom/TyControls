    end
    object BtnCopy: TTyButton
      Left = 6
      Height = 28
      Top = 38
      Width = 72
      Caption = '复制'
      OnClick = ToolClicked
    end
    object BtnPaste: TTyButton
      Left = 82
      Height = 28
      Top = 38
      Width = 72
      Caption = '粘贴'
      OnClick = ToolClicked
    end
    object Sep2: TTyToolSeparator
      Left = 158
      Height = 28
      Top = 38
      Width = 8
    end
    object BtnFind: TTyButton
      Left = 170
      Height = 28
      Top = 38
