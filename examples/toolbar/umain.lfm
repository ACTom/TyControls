object MainForm: TMainForm
  Left = 0
  Height = 340
  Top = 0
  Width = 520
  Caption = 'TTyToolBar 示例'
  ClientHeight = 340
  ClientWidth = 520
  Position = poScreenCenter
  LCLVersion = '4.4.0.0'
  OnCreate = FormCreate
  TitleBar = Bar
  object Bar: TTyTitleBar
    Left = 0
    Height = 34
    Top = 0
    Width = 520
    Align = alTop
    Caption = 'TTyToolBar  · TyControls'
    TitleAlignment = taLeftJustify
    object DarkSwitch: TTyToggleSwitch
      Left = 172
      Height = 24
      Top = 5
      Width = 74
      Anchors = [akTop, akRight]
      Caption = '暗色'
      OnChange = DarkSwitchChange
    end
    object ThemeCombo: TTyComboBox
      Left = 254
      Height = 26
      Top = 4
      Width = 120
      Anchors = [akTop, akRight]
      OnChange = ThemeComboChange
    end
  end
  object ToolBar: TTyToolBar
    Left = 0
    Height = 104
    Top = 34
    Width = 520
    Align = alTop
    ButtonHeight = 28
    ButtonSpacing = 4
    Indent = 6
    object BtnNew: TTyButton
      Left = 6
      Height = 28
      Top = 6
      Width = 72
      Caption = '新建'
      OnClick = ToolClicked
    end
    object BtnOpen: TTyButton
      Left = 82
      Height = 28
      Top = 6
      Width = 72
