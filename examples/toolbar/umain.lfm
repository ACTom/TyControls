      OnClick = ToolClicked
    end
    object BtnSave: TTyButton
      Left = 158
      Height = 28
      Top = 6
      Width = 72
      Caption = '保存'
      OnClick = ToolClicked
    end
    object Sep1: TTyToolSeparator
      Left = 234
      Height = 28
      Top = 6
      Width = 8
    end
    object BtnCut: TTyButton
      Left = 246
      Height = 28
      Top = 6
      Width = 72
      Caption = '剪切'
