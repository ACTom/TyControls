# --- .lfm captions/text/hints (msgid=English source) ---

#: tmainform.caption
msgid "Chrome on top (pilot)"
msgstr "外框保持在最上面(样板)"

#: tmainform.bar.caption
msgid "Chrome on top  ·  TyControls (pilot)"
msgstr "外框保持在最上面  ·  TyControls(样板)"

#: tmainform.darkswitch.caption
msgid "Dark"
msgstr "暗色"

#: tmainform.overlayswitch.caption
msgid "Keep the frame on top"
msgstr "外框保持在最上面"

#: tmainform.btnmeasure.caption
msgid "Measure"
msgstr "测量"

#: tmainform.cardedges.title
msgid "Children on the frame"
msgstr "压在外框上的子控件"

#: tmainform.btnleftedge.caption
msgid "On the left edge"
msgstr "压着左边框"

#: tmainform.pnlheaderline.caption
msgid "Across the title line"
msgstr "跨过标题下的线"

#: tmainform.lblrightedge.caption
msgid "Label"
msgstr "标签"

#: tmainform.edtcorner.text
msgid "In the corner"
msgstr "在角上"

#: tmainform.btnoptedout.caption
msgid "Opted out: stays on top"
msgstr "已退出：留在最上面"

#: tmainform.cardnested.title
msgid "A panel inside, a button inside that"
msgstr "卡片里一个面板，面板里一个按钮"

#: tmainform.btninneredge.caption
msgid "Two levels down"
msgstr "隔了两层"

#: tmainform.cardactions.title
msgid "Over the actions line"
msgstr "压着底部操作栏的线"

#: tmainform.btnacrossactions.caption
msgid "Across the actions line"
msgstr "跨过操作栏的线"

#: tmainform.btnactionscorner.caption
msgid "In the corner"
msgstr "在角上"

#: tmainform.lblhint.caption
msgid "Each card keeps its frame, its rounded corners and the hairlines under its title and over its actions whole, whatever its children cover. Hover a card: its frame changes colour, and so does the part drawn over the children. Turn the switch off to see the cut lines as before."
msgstr "每张卡片的外框、圆角，以及标题下和操作栏上的分隔线，不管被子控件压住多少都保持完整。把鼠标移到卡片上，边框会变色，画在子控件上的那一段也跟着变。关掉开关，可以看到原来线被截断的样子。"

# --- resourcestrings ---

#: umain.rsmeasurefmt
#, object-pascal-format
msgid "One redraw of this window: %.1f ms with the frame on top, %.1f ms without"
msgstr "整个窗口重画一次：外框保持在最上面时 %.1f ms，关掉时 %.1f ms"

#: umain.rsitem
#, object-pascal-format
msgid "Item %d"
msgstr "第 %d 项"

#: umain.rsroundsfmt
#, object-pascal-format
msgid "Times per redraw are the fastest of %d runs of %d redraws, the four ways taking turns; the parts are averages over all runs."
msgstr "每次重画的耗时取 %d 轮里最快的一轮（每轮重画 %d 次，四种方式轮流测）；各部分是所有轮的平均值。"

#: umain.rsmodeoff
msgid "Off"
msgstr "关闭"

#: umain.rsmode0
msgid "Each band draws the frame afresh"
msgstr "每条带都重新画一遍外框"

#: umain.rsmode1
msgid "The same, but bands on a straight edge skip the corners"
msgstr "同上，但直边上的带不再铺圆角外的底色"

#: umain.rsmode2
msgid "Each card keeps a frame layer, and bands copy from it"
msgstr "每张卡片留一份外框层，各条带从里面拷"

#: umain.rsofflinefmt
#, object-pascal-format
msgid "%s: %.1f ms per redraw (runs from %.1f to %.1f)"
msgstr "%s：每次重画 %.1f ms（各轮 %.1f 到 %.1f）"

#: umain.rsmodelinefmt
#, object-pascal-format
msgid "%s: %.1f ms per redraw (runs from %.1f to %.1f), %.1f ms more than off; %d passes, %d bands"
msgstr "%s：每次重画 %.1f ms（各轮 %.1f 到 %.1f），比关闭时多 %.1f ms；补画 %d 次，共 %d 条带"

#: umain.rsdrawpartsfmt
#, object-pascal-format
msgid "    in the overlay %.2f ms: set-up %.2f, drawing %.2f (corners %.2f, frame %.2f, separators %.2f), the band onto the window %.2f, the signature %.2f, the free area %.2f, the rest %.2f"
msgstr "    外框层代码共 %.2f ms：准备 %.2f，绘制 %.2f（圆角外底色 %.2f、边框 %.2f、分隔线 %.2f），贴回窗口 %.2f，取签名 %.2f，算空闲区 %.2f，其余 %.2f"

#: umain.rscachepartsfmt
#, object-pascal-format
msgid "    in the overlay %.2f ms: set-up %.2f, the kept layer %.2f (its key %.2f), copying from it %.2f, the band onto the window %.2f, the signature %.2f, the free area %.2f, the rest %.2f"
msgstr "    外框层代码共 %.2f ms：准备 %.2f，取外框层 %.2f（其中算键 %.2f），从里面拷 %.2f，贴回窗口 %.2f，取签名 %.2f，算空闲区 %.2f，其余 %.2f"

#: umain.rscachebuiltfmt
#, object-pascal-format
msgid "    frame layers: %d built on the first redraw, %.2f ms each; %.1f KB kept"
msgstr "    外框层：第一次重画时建了 %d 份，每份 %.2f ms；共占 %.1f KB"

#: umain.rscachenonefmt
#, object-pascal-format
msgid "    frame layers: none built; %.1f KB kept"
msgstr "    外框层：没有新建；共占 %.1f KB"

#: umain.rsskippedfmt
#, object-pascal-format
msgid "%d runs left out: not every redraw reached the screen (the window was minimised or hidden)."
msgstr "有 %d 轮没算进去：不是每次重画都画到了屏幕上（窗口被最小化或隐藏了）。"

#: umain.rsnotshowing
msgid "Nothing measured: the window is not on screen."
msgstr "没有测：窗口不在屏幕上。"
