msgstr "确定"

#: tmainform.chklimit.caption
msgid "MaxLength = 800 - typing stops at the cap, a paste is truncated to fit"
msgstr "MaxLength = 800 - 打到上限就停，粘贴超出的部分被截断"

#: tmainform.lblscroll.caption
msgid "ScrollBars"
msgstr "ScrollBars"

#: tmainform.lblscrollhint.caption
