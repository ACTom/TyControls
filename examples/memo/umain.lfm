object MainForm: TMainForm
  Left = 0
  Height = 420
  Top = 0
  Width = 480
  Caption = 'TTyMemo example'
  ClientHeight = 420
  ClientWidth = 480
  Position = poScreenCenter
  LCLVersion = '4.4.0.0'
  OnCreate = FormCreate
  TitleBar = Bar
  object Surface: TTyFormSurface
    Left = 0
    Height = 420
    Top = 0
    Width = 480
    Align = alClient
    object Bar: TTyTitleBar
      Left = 0
      Height = 34
      Top = 0
      Width = 480
      Align = alTop
      Caption = 'TTyMemo  · TyControls'
      TitleAlignment = taLeftJustify
      object DarkSwitch: TTyToggleSwitch
        Left = 132
        Height = 24
        Top = 5
        Width = 74
        Anchors = [akTop, akRight]
        Caption = 'Dark'
        OnChange = DarkSwitchChange
      end
      object ThemeCombo: TTyComboBox
        Left = 214
        Height = 26
        Top = 4
        Width = 120
        Anchors = [akTop, akRight]
        OnChange = ThemeComboChange
      end
    end
    object LblPrompt: TTyLabel
      Left = 16
      Height = 20
      Top = 46
      Width = 448
      Caption = 'Multiline text editor (Enter for a new line, arrow keys to navigate, wheel to scroll):'
    end
    object Memo: TTyMemo
      Left = 16
      Height = 240
      Top = 72
      Width = 448
      ScrollBars = ssAutoVertical
      WordWrap = False
      Lines.Strings = (
        'Line 1: Welcome to the TyControls TTyMemo multi-line editor.'
        'Line 2: press Enter for a new line, Backspace/Delete can merge across lines.'
        'Line 3: arrow keys and Home/End move the cursor; selection, copy and paste are supported.'
        'Line 4: when the content exceeds the visible area a vertical scrollbar appears on the right.'
        'Line 5: you can also scroll up and down with the mouse wheel.'
        'Line 6: after ticking "word wrap" below, an over-long line breaks at word boundaries into several visual lines — this is a line long enough to demonstrate soft wrapping.'
        'Line 7: after ticking "read-only" it can no longer be edited, but you can still navigate and copy.'
        'Line 8: the last line.'
      )
      OnChange = MemoChange
    end
    object ChkReadOnly: TTyCheckBox
      Left = 16
      Height = 24
      Top = 322
      Width = 120
      Caption = 'Read-only (ReadOnly)'
      OnClick = ReadOnlyClick
    end
    object ChkWordWrap: TTyCheckBox
      Left = 150
      Height = 24
      Top = 322
      Width = 140
      Caption = 'Word wrap (WordWrap)'
      OnClick = WordWrapClick
    end
    object LblInfo: TTyLabel
      Left = 16
      Height = 20
      Top = 356
      Width = 448
    end
  end
end
