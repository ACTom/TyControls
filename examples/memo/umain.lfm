object MainForm: TMainForm
  Left = 0
  Height = 564
  Top = 0
  Width = 480
  Caption = 'TTyMemo example'
  ClientHeight = 564
  ClientWidth = 480
  Position = poScreenCenter
  LCLVersion = '4.4.0.0'
  OnCreate = FormCreate
  TitleBar = Bar
  object Surface: TTyFormSurface
    Left = 0
    Height = 564
    Top = 0
    Width = 480
    Align = alClient
    object Bar: TTyTitleBar
      Left = 0
      Height = 34
      Top = 0
      Width = 480
      Align = alTop
      Caption = 'TTyMemo  · TyControls'
      TitleAlignment = taLeftJustify
      object DarkSwitch: TTyToggleSwitch
        Left = 132
        Height = 24
        Top = 5
        Width = 74
        Anchors = [akTop, akRight]
        Caption = 'Dark'
        OnChange = DarkSwitchChange
      end
      object ThemeCombo: TTyComboBox
        Left = 214
        Height = 26
        Top = 4
        Width = 120
        Anchors = [akTop, akRight]
        OnChange = ThemeComboChange
      end
    end
    object LblPrompt: TTyLabel
      Left = 16
      Height = 20
      Top = 78
      Width = 448
      Caption = 'Multiline editor (Enter = new line, arrows navigate, wheel scrolls):'
    end
    object Memo: TTyMemo
      Left = 16
      Height = 200
      Top = 126
      Width = 448
      ScrollBars = ssAutoVertical
      WordWrap = False
      Lines.Strings = (
        'Line 1: Welcome to the TyControls TTyMemo multi-line editor.'
        'Line 2: press Enter for a new line, Backspace/Delete can merge across lines.'
        'Line 3: arrow keys and Home/End move the cursor; selection, copy and paste are supported.'
        'Line 4: when the content exceeds the visible area a vertical scrollbar appears on the right.'
        'Line 5: you can also scroll up and down with the mouse wheel.'
        'Line 6: after ticking "word wrap" below, an over-long line breaks at word boundaries into several visual lines — this is a line long enough to demonstrate soft wrapping.'
        'Line 7: after ticking "read-only" it can no longer be edited, but you can still navigate and copy.'
        'Line 8: the last line.'
      )
      OnChange = MemoChange
      OnSelectionChange = MemoSelectionChange
    end
    object ChkReadOnly: TTyCheckBox
      Left = 16
      Height = 24
      Top = 362
      Width = 120
      Caption = 'ReadOnly'
      OnClick = ReadOnlyClick
    end
    object ChkWordWrap: TTyCheckBox
      Left = 150
      Height = 24
      Top = 362
      Width = 140
      Caption = 'Word wrap'
      OnClick = WordWrapClick
    end
    object LblInfo: TTyLabel
      Left = 16
      Height = 20
      Top = 530
      Width = 448
    end
    object BtnSelectAll: TTyButton
      Left = 16
      Height = 26
      Top = 44
      Width = 84
      Caption = 'Select all'
      OnClick = SelectAllClick
    end
    object BtnCopy: TTyButton
      Left = 106
      Height = 26
      Top = 44
      Width = 60
      Caption = 'Copy'
      OnClick = CopyClick
    end
    object BtnCut: TTyButton
      Left = 172
      Height = 26
      Top = 44
      Width = 52
      Caption = 'Cut'
      OnClick = CutClick
    end
    object BtnPaste: TTyButton
      Left = 230
      Height = 26
      Top = 44
      Width = 62
      Caption = 'Paste'
      OnClick = PasteClick
    end
    object BtnUndo: TTyButton
      Left = 298
      Height = 26
      Top = 44
      Width = 84
      Caption = 'Undo'
      OnClick = UndoClick
    end
    object BtnRedo: TTyButton
      Left = 388
      Height = 26
      Top = 44
      Width = 84
      Caption = 'Redo'
      OnClick = RedoClick
    end
    object LblKeys: TTyLabel
      Left = 16
      Height = 20
      Top = 100
      Width = 448
      Caption = 'Same edits from the keyboard: Ctrl+Z undo, Ctrl+Y or Ctrl+Shift+Z redo.'
    end
    object LblOptions: TTyLabel
      Left = 16
      Height = 20
      Top = 336
      Width = 448
      Caption = 'Tick a property, then type in the memo (HideSelection dims on blur):'
    end
    object ChkHideSel: TTyCheckBox
      Left = 300
      Height = 24
      Top = 362
      Width = 164
      Caption = 'HideSelection'
      Checked = True
      State = cbChecked
      OnClick = HideSelectionClick
    end
    object ChkWantTabs: TTyCheckBox
      Left = 16
      Height = 24
      Top = 390
      Width = 448
      Caption = 'WantTabs - on: Tab inserts a tab; off: Tab jumps to the next control'
      OnClick = WantTabsClick
    end
    object ChkWantReturns: TTyCheckBox
      Left = 16
      Height = 24
      Top = 418
      Width = 352
      Caption = 'WantReturns - untick it and Enter fires the OK button'
      Checked = True
      State = cbChecked
      OnClick = WantReturnsClick
    end
    object BtnDefault: TTyButton
      Left = 380
      Height = 26
      Top = 417
      Width = 84
      Caption = 'OK'
      Default = True
      OnClick = DefaultButtonClick
    end
    object ChkLimit: TTyCheckBox
      Left = 16
      Height = 24
      Top = 446
      Width = 454
      Caption = 'MaxLength = 800 - typing stops at the cap, a paste is truncated to fit'
      OnClick = MaxLengthClick
    end
    object LblScroll: TTyLabel
      Left = 16
      Height = 20
      Top = 477
      Width = 76
      Caption = 'ScrollBars'
    end
    object CmbScroll: TTyComboBox
      Left = 98
      Height = 26
      Top = 474
      Width = 170
      Items.Strings = (
        'ssNone'
        'ssHorizontal'
        'ssVertical'
        'ssBoth'
        'ssAutoHorizontal'
        'ssAutoVertical'
        'ssAutoBoth'
      )
      ItemIndex = 5
      OnChange = ScrollBarsChange
    end
    object LblScrollHint: TTyLabel
      Left = 274
      Height = 20
      Top = 477
      Width = 190
      Caption = 'horizontal bar: WordWrap off'
    end
    object LblCaret: TTyLabel
      Left = 16
      Height = 20
      Top = 506
      Width = 448
    end
  end
end
