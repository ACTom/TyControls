object MainForm: TMainForm
  Left = 0
  Height = 750
  Top = 0
  Width = 480
  Caption = 'TTyLabel example'
  ClientHeight = 750
  ClientWidth = 480
  Position = poScreenCenter
  LCLVersion = '4.4.0.0'
  OnCreate = FormCreate
  TitleBar = Bar
  object Surface: TTyFormSurface
    Left = 0
    Height = 750
    Top = 0
    Width = 480
    Align = alClient
    object Bar: TTyTitleBar
      Left = 0
      Height = 34
      Top = 0
      Width = 480
      Align = alTop
      Caption = 'TTyLabel  ·  TyControls'
      TitleAlignment = taLeftJustify
      object DarkSwitch: TTyToggleSwitch
        Left = 132
        Height = 24
        Top = 5
        Width = 74
        Anchors = [akTop, akRight]
        Caption = 'Dark'
        OnChange = DarkSwitchChange
      end
      object ThemeCombo: TTyComboBox
        Left = 214
        Height = 26
        Top = 4
        Width = 120
        Anchors = [akTop, akRight]
        OnChange = ThemeComboChange
      end
    end
    object LblHead: TTyLabel
      Left = 20
      Height = 26
      Top = 46
      Width = 440
      Caption = 'Heading via StyleOverride (font-size 13px, weight 600)'
      StyleOverride = 'font-size: 13px; font-weight: 600;'
    end
    object LblLeft: TTyLabel
      Left = 20
      Height = 22
      Top = 82
      Width = 440
      AutoSize = False
      Alignment = taLeftJustify
      Caption = 'Left align (taLeftJustify)'
    end
    object LblCenter: TTyLabel
      Left = 20
      Height = 22
      Top = 108
      Width = 440
      AutoSize = False
      Alignment = taCenter
      Caption = 'Center align (taCenter)'
    end
    object LblRight: TTyLabel
      Left = 20
      Height = 22
      Top = 134
      Width = 440
      AutoSize = False
      Alignment = taRightJustify
      Caption = 'Right align (taRightJustify)'
    end
    object LblFilled: TTyLabel
      Left = 20
      Height = 22
      Top = 166
      Width = 440
      AutoSize = False
      Alignment = taCenter
      Transparent = False
      Caption = 'Transparent=False: filled background'
    end
    object LblAuto: TTyLabel
      Left = 20
      Height = 10
      Top = 194
      Width = 10
      AutoSize = True
      Caption = 'AutoSize=True: width and height fit the text'
    end
    object LblWrap: TTyLabel
      Left = 20
      Height = 60
      Top = 224
      Width = 440
      AutoSize = False
      WordWrap = True
      Alignment = taLeftJustify
      Caption = 'WordWrap=True : this label wraps onto several lines because the words are separated by spaces — 中文 and English mixed also wrap at spaces, and lines that exceed the control width wrap automatically.'
    end
    object EdName: TTyEdit
      Left = 180
      Height = 28
      Top = 300
      Width = 240
    end
    object LblFocus: TTyLabel
      Left = 20
      Height = 22
      Top = 304
      Width = 150
      Caption = 'Name(&N):'
      FocusControl = EdName
    end
    object LblLayoutHead: TTyLabel
      Left = 20
      Height = 22
      Top = 344
      Width = 440
      Caption = 'Layout: three 56px boxes, three vertical placements'
    end
    object LblLayoutTop: TTyLabel
      Left = 20
      Height = 56
      Top = 372
      Width = 440
      AutoSize = False
      Transparent = False
      Layout = tlTop
      StyleOverride = 'background: alpha(var(--on-surface), 0.06); border-color: var(--border); border-width: 1px; border-radius: 6px; padding: 6px;'
      Caption = 'Layout = tlTop (text sits at the top of a 56px box)'
    end
    object LblLayoutCenter: TTyLabel
      Left = 20
      Height = 56
      Top = 434
      Width = 440
      AutoSize = False
      Transparent = False
      Layout = tlCenter
      StyleOverride = 'background: alpha(var(--on-surface), 0.06); border-color: var(--border); border-width: 1px; border-radius: 6px; padding: 6px;'
      Caption = 'Layout = tlCenter (the default - vertically centred)'
    end
    object LblLayoutBottom: TTyLabel
      Left = 20
      Height = 56
      Top = 496
      Width = 440
      AutoSize = False
      Transparent = False
      Layout = tlBottom
      StyleOverride = 'background: alpha(var(--on-surface), 0.06); border-color: var(--border); border-width: 1px; border-radius: 6px; padding: 6px;'
      Caption = 'Layout = tlBottom (text sits on the bottom edge)'
    end
    object LblWrapAutoHead: TTyLabel
      Left = 20
      Height = 22
      Top = 564
      Width = 440
      Caption = 'AutoSize + WordWrap: the box keeps its width and grows its height'
    end
    object LblWrapAuto: TTyLabel
      Left = 20
      Height = 56
      Top = 592
      Width = 440
      Anchors = [akTop, akLeft, akRight]
      AutoSize = True
      WordWrap = True
      Transparent = False
      StyleOverride = 'background: alpha(var(--on-surface), 0.06); border-color: var(--border); border-width: 1px; border-radius: 6px; padding: 6px;'
      Caption = 'AutoSize=True + WordWrap=True: the label keeps its width and grows its HEIGHT to fit however many lines the text needs - widen the window and watch the box re-wrap and re-fit by itself.'
    end
    object LblClick: TTyLabel
      Left = 20
      Height = 24
      Top = 668
      Width = 440
      Cursor = crHandPoint
      Caption = 'Click me: TTyLabel fires OnClick like any other control'
      OnClick = LblClickClick
    end
    object LblAccent: TTyLabel
      Left = 20
      Height = 22
      Top = 704
      Width = 440
      StyleOverride = 'color: var(--accent);'
      Caption = 'StyleOverride = color: var(--accent) - still theme-aware'
    end
  end
end
