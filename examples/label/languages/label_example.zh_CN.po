# --- .lfm captions/text/hints (auto-generated, msgid=English source) ---

#: tmainform.caption
msgid "TTyLabel example"
msgstr "TTyLabel 示例"

#: tmainform.darkswitch.caption
msgid "Dark"
msgstr "暗色"

#: tmainform.lblhead.caption
msgid "Heading via StyleOverride (font-size 13px, weight 600)"
msgstr "用 StyleOverride 做标题（font-size 13px，weight 600）"

#: tmainform.lblleft.caption
msgid "Left align (taLeftJustify)"
msgstr "左对齐（taLeftJustify）"

#: tmainform.lblcenter.caption
msgid "Center align (taCenter)"
msgstr "居中对齐（taCenter）"

#: tmainform.lblright.caption
msgid "Right align (taRightJustify)"
msgstr "右对齐（taRightJustify）"

#: tmainform.lblfilled.caption
msgid "Transparent=False: filled background"
msgstr "Transparent=False：带填充背景"

#: tmainform.lblauto.caption
msgid "AutoSize=True: width and height fit the text"
msgstr "AutoSize=True：宽高随文字自适应"

#: tmainform.lblwrap.caption
msgid "WordWrap=True : this label wraps onto several lines because the words are separated by spaces — 中文 and English mixed also wrap at spaces, and lines that exceed the control width wrap automatically."
msgstr "WordWrap=True : this label wraps onto several lines because the words are separated by spaces — 中文 与 English 混排 也 能 在 空格 处 换行，超出 控件 宽度 就 自动 折行。"

#: tmainform.lblfocus.caption
msgid "&Name:"
msgstr "姓名(&N)："

#: tmainform.lbllayouthead.caption
msgid "Layout: three 56px boxes, three vertical placements"
msgstr "Layout：三个 56px 方框，三种垂直位置"

#: tmainform.lbllayouttop.caption
msgid "Layout = tlTop (text sits at the top of a 56px box)"
msgstr "Layout = tlTop（文字贴在 56px 框的顶部）"

#: tmainform.lbllayoutcenter.caption
msgid "Layout = tlCenter (the default - vertically centred)"
msgstr "Layout = tlCenter（默认值，垂直居中）"

#: tmainform.lbllayoutbottom.caption
msgid "Layout = tlBottom (text sits on the bottom edge)"
msgstr "Layout = tlBottom（文字贴在底边）"

#: tmainform.lblwrapautohead.caption
msgid "AutoSize + WordWrap: the box keeps its width and grows its height"
msgstr "AutoSize + WordWrap：宽度不变，高度自增"

#: tmainform.lblwrapauto.caption
msgid "AutoSize=True + WordWrap=True: the label keeps its width and grows its HEIGHT to fit however many lines the text needs - widen the window and watch the box re-wrap and re-fit by itself."
msgstr "AutoSize=True + WordWrap=True：标签保持宽度不变，按文字所需行数增长高度 —— 拉宽窗口，看它自己重新折行、重新适配。"

#: tmainform.lblclick.caption
msgid "Click me: TTyLabel fires OnClick like any other control"
msgstr "点我：TTyLabel 和其他控件一样会触发 OnClick"

#: tmainform.lblaccent.caption
msgid "StyleOverride = color: var(--accent) - still theme-aware"
msgstr "StyleOverride = color: var(--accent) —— 仍跟随主题"

#: tmainform.bar.caption
msgid "TTyLabel  ·  TyControls"
msgstr "TTyLabel  ·  TyControls"
