    Left = 16
    Height = 22
    Top = 44
    Width = 700
    Caption = '集合模式 — 点表头排序 · Ctrl / Shift 多选 · 空白处拖拽框选 · 敲字母定位'
    Alignment = taLeftJustify
  end
