object MainForm: TMainForm
  Left = 200
  Height = 700
  Top = 90
  Width = 1200
  Caption = 'TyControls — TTyListView(报表 / 图标 / 平铺 · 排序 · 多选 · 虚拟模式)'
  ClientHeight = 700
  ClientWidth = 1200
  Font.Height = -12
  Position = poScreenCenter
  LCLVersion = '4.4.0.0'
  OnCreate = FormCreate
  TitleBar = TitleBar1
