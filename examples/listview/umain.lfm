    Left = 16
    Height = 18
    Top = 644
    Width = 700
    Caption = '按「大小」降序排:没有大小的文件夹仍然排在最后 —— 方向不该翻转「不可解析排后」这条规则'
  end
  object DivRight: TTyDivider
    Left = 736
