object MainForm: TMainForm
  Left = 0
  Height = 420
  Top = 0
  Width = 460
  Caption = 'CheckBox example'
  ClientHeight = 420
  ClientWidth = 460
  Position = poScreenCenter
  LCLVersion = '4.4.0.0'
  OnCreate = FormCreate
  TitleBar = Bar
  object Surface: TTyFormSurface
    Left = 0
    Height = 420
    Top = 0
    Width = 460
    Align = alClient
    object Bar: TTyTitleBar
      Left = 0
      Height = 34
      Top = 0
      Width = 460
      Align = alTop
      Caption = 'TTyCheckBox  ·  TyControls'
      TitleAlignment = taLeftJustify
      object DarkSwitch: TTyToggleSwitch
        Left = 112
        Height = 24
        Top = 5
        Width = 74
        Anchors = [akTop, akRight]
        Caption = 'Dark'
        OnChange = DarkSwitchChange
      end
      object ThemeCombo: TTyComboBox
        Left = 194
        Height = 26
        Top = 4
        Width = 120
        Anchors = [akTop, akRight]
        OnChange = ThemeComboChange
      end
    end
    object LblTri: TTyLabel
      Left = 20
      Height = 22
      Top = 52
      Width = 420
      Caption = 'Tri-state check box (click cycles unchecked → checked → grayed):'
    end
    object CbTri: TTyCheckBox
      Left = 24
      Height = 24
      Top = 78
      Width = 280
      Caption = 'Include all children(&A)'
      AllowGrayed = True
      State = cbGrayed
      OnChange = TriChange
    end
    object LblTriStatus: TTyLabel
      Left = 24
      Height = 22
      Top = 106
      Width = 420
    end
    object LblPlain: TTyLabel
      Left = 20
      Height = 22
      Top = 148
      Width = 420
      Caption = 'Plain two-state checkbox (OnChange echo):'
    end
    object CbPlain: TTyCheckBox
      Left = 24
      Height = 24
      Top = 174
      Width = 280
      Caption = 'Receive email notifications(&N)'
      OnChange = PlainChange
    end
    object LblStatus: TTyLabel
      Left = 24
      Height = 22
      Top = 202
      Width = 420
    end
    object CbChecked: TTyCheckBox
      Left = 24
      Height = 24
      Top = 244
      Width = 280
      Caption = 'Checked by default (Checked)'
      Checked = True
      State = cbChecked
    end
    object CbDisabledChecked: TTyCheckBox
      Left = 24
      Height = 24
      Top = 274
      Width = 280
      Caption = 'Disabled and checked (Enabled=False)'
      Checked = True
      State = cbChecked
      Enabled = False
    end
    object CbDisabled: TTyCheckBox
      Left = 24
      Height = 24
      Top = 304
      Width = 280
      Caption = 'Disabled and unchecked'
      Enabled = False
    end
  end
end
