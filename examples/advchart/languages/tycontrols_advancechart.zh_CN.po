#: tycontrols.advancechart.strconsts.rstychartnosuchhandler
#, object-pascal-format
msgid "No formatter named '%s' is registered."
msgstr "没有注册名为 '%s' 的格式化器。"

#: tycontrols.advancechart.strconsts.rstyopttoodeep
#, object-pascal-format
msgid "The option is nested more than %d levels deep."
msgstr "选项的嵌套超过了 %d 层。"

#: tycontrols.advancechart.strconsts.rstyoptfunctionvalue
msgid "JavaScript functions cannot be used here. Write a template string such as '{b}: {c}', or the name of a registered handler such as '@MyFormatter'."
msgstr "这里不能写 JavaScript 函数。请改用模板串，例如 '{b}: {c}'，或已注册的处理器名，例如 '@MyFormatter'。"

#: tycontrols.advancechart.strconsts.rstycharttoolboxbar
msgid "Switch to Bar Chart"
msgstr "切换为柱状图"

#: tycontrols.advancechart.strconsts.rstycharttoolboxbrushclear
msgid "Clear Selections"
msgstr "清除选择"

#: tycontrols.advancechart.strconsts.rstycharttoolboxbrushkeep
msgid "Keep Selections"
msgstr "保持选择"

#: tycontrols.advancechart.strconsts.rstycharttoolboxbrushlinex
msgid "Horizontally Select"
msgstr "横向选择"

#: tycontrols.advancechart.strconsts.rstycharttoolboxbrushliney
msgid "Vertically Select"
msgstr "纵向选择"

#: tycontrols.advancechart.strconsts.rstycharttoolboxbrushpolygon
msgid "Lasso Select"
msgstr "圈选"

#: tycontrols.advancechart.strconsts.rstycharttoolboxbrushrect
msgid "Box Select"
msgstr "矩形选择"

#: tycontrols.advancechart.strconsts.rstycharttoolboxdataview
msgid "Data View"
msgstr "数据视图"

#: tycontrols.advancechart.strconsts.rstycharttoolboxdataviewbad
#, object-pascal-format
msgid "The data view's text could not be read back: %s"
msgstr "数据视图的文本无法读回：%s"

#: tycontrols.advancechart.strconsts.rstycharttoolboxdataviewrefresh
msgid "Refresh"
msgstr "刷新"

#: tycontrols.advancechart.strconsts.rstycharttoolboximagefilter
msgid "PNG image (*.png)|*.png|JPEG image (*.jpeg;*.jpg)|*.jpeg;*.jpg|All files (*.*)|*.*"
msgstr "PNG 图片 (*.png)|*.png|JPEG 图片 (*.jpeg;*.jpg)|*.jpeg;*.jpg|所有文件 (*.*)|*.*"

#: tycontrols.advancechart.strconsts.rstycharttoolboxline
msgid "Switch to Line Chart"
msgstr "切换为折线图"

#: tycontrols.advancechart.strconsts.rstycharttoolboxrestore
msgid "Restore"
msgstr "还原"

#: tycontrols.advancechart.strconsts.rstycharttoolboxsaveasimage
msgid "Save as Image"
msgstr "保存为图片"

#: tycontrols.advancechart.strconsts.rstycharttoolboxstack
msgid "Stack"
msgstr "切换为堆叠"

#: tycontrols.advancechart.strconsts.rstycharttoolboxtiled
msgid "Tile"
msgstr "切换为平铺"

#: tycontrols.advancechart.strconsts.rstycharttoolboxzoom
msgid "Zoom"
msgstr "区域缩放"

#: tycontrols.advancechart.strconsts.rstycharttoolboxzoomback
msgid "Zoom Reset"
msgstr "区域缩放还原"

#: tycontrols.advancechart.strconsts.rstyoptdiagunknown
#, object-pascal-format
msgid "%s is not an option ECharts 6.1 knows."
msgstr "%s 不是 ECharts 6.1 认识的 option。"

#: tycontrols.advancechart.strconsts.rstyoptdiagdidyoumean
#, object-pascal-format
msgid "Did you mean \"%s\"?"
msgstr "你是想写 “%s” 吗？"

#: tycontrols.advancechart.strconsts.rstyoptdiagbadenum
#, object-pascal-format
msgid "%s: \"%s\" is not one of %s."
msgstr "%s：“%s” 不在 %s 之中。"

#: tycontrols.advancechart.strconsts.rstyoptdiagnotype
#, object-pascal-format
msgid "%s[%d] has no type yet, so nothing under it can be checked. One of: %s."
msgstr "%s[%d] 还没写 type，所以它下面的东西无从校验。可选：%s。"

#: tycontrols.advancechart.strconsts.rstyoptdiagnothingpaintsyet
msgid "The option is understood. Series marks are not painted yet, so this draws its axes and nothing else."
msgstr "option 已读懂。series 图元尚未实现，所以现在只画得出坐标轴。"

#: tycontrols.advancechart.strconsts.rstyoptdiagmorerows
#, object-pascal-format
msgid "and %d more like these."
msgstr "另有 %d 条同类。"

#: tycontrols.advancechart.strconsts.rstyoptdiagallclear
msgid "The option is understood."
msgstr "option 没有问题。"

#: tycontrols.advancechart.strconsts.rstyoptdiagsomenotpainted
#, object-pascal-format
msgid "The option is understood. Not painted yet: %s."
msgstr "option 没有问题。还画不出来的：%s。"

#: tycontrols.advancechart.strconsts.rstyoptdiagnomarksatall
msgid "The option is understood. Series marks are not painted yet, and this chart has no axes, so nothing is drawn."
msgstr "option 没有问题。series 的图元还没有实现绘制，而这张图也没有坐标轴，所以画面上不会有任何东西。"

#: tycontrols.advancechart.strconsts.rstyoptdiagnoseries
msgid "The option is understood. There are no series, so only the axes would draw."
msgstr "option 没有问题。没有任何 series，所以只会画出坐标轴。"
