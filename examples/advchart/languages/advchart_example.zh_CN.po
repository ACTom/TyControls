# --- code resourcestrings (msgid=Pascal source) ---

#: umain.rsoptionok
msgid "The option parsed and this chart draws."
msgstr "option 解析成功。"

#: umain.rsdiagnostics
#, object-pascal-format
msgid "%d note(s) on this option:"
msgstr "这份 option 有 %d 条提示："

# --- code resourcestrings (msgid=Pascal source) ---

#: umain.rscounts
#, object-pascal-format
msgid "%s — %d example(s)"
msgstr "%s — %d 个示例"

#: umain.rsbordermapnotshipped
#, object-pascal-format
msgid "This example needs the map %s, which the demo does not include. Borders between countries are disputed, and some places require published maps to be reviewed, so neither TyControls nor this demo ships a map that draws them. To see the example, save a GeoJSON file under the map's name in %s (for instance china.json), or register one in code with TyChartRegisterMap. Natural Earth (naturalearthdata.com) offers public-domain country data."
msgstr "这个示例要用地图 %s，demo 没有附带。各国对边界的画法有争议，一些地区还要求公开的地图先经审核，所以 TyControls 和这个 demo 都不附带画国界的地图。要看这个示例，把一份 GeoJSON 以地图名存进 %s（例如 china.json），或者在代码里用 TyChartRegisterMap 注册。在中国大陆向社会公开的地图，依据《测绘法》第三十八条和《地图管理条例》第十五条须报送审核、取得审图号，国界、台湾、南海诸岛等的表示须符合《地图管理条例》第八条与国家有关规定；面向大陆用户请使用天地图等带审图号的数据。大陆以外可以用 Natural Earth（naturalearthdata.com）等公共领域数据。"

#: umain.rsnogallery
msgid "The gallery was not found. Run tools/advchart-gallery/harvest.js to build examples/advchart/gallery."
msgstr "没有找到示例语料。运行 tools/advchart-gallery/harvest.js 生成 examples/advchart/gallery。"

#: umain.rsnotconverted
#, object-pascal-format
msgid "Not converted: %s"
msgstr "未转换：%s"

#: umain.rspickone
msgid "Pick an example on the left."
msgstr "在左边挑一个示例。"

#: umain.rsstep
#, object-pascal-format
msgid "Step %d of %d of the page's setOption sequence."
msgstr "页面 setOption 序列的第 %d 步，共 %d 步。"

#: umain.rssavedto
#, object-pascal-format
msgid "Saved to %s"
msgstr "已保存到 %s"

#: umain.rsnoticetoobig
#, object-pascal-format
msgid "This example is converted, but its option is %s MB -- too large to ship with the demo."
msgstr "这个示例已经转换，但它的 option 有 %s MB，太大，demo 没有附带。"

#: umain.rsnoticebmap
msgid "This example draws on Baidu Map (bmap), which needs the online Baidu Maps API. TTyAdvanceChart has no bmap coordinate system."
msgstr "这个示例画在百度地图（bmap）上，要联网调用百度地图 API。TTyAdvanceChart 没有 bmap 坐标系。"

#: umain.rsnoticeunlicensedsvg
#, object-pascal-format
msgid "This example draws on the SVG map %s from the ECharts examples site, which has no recorded licence, so the demo does not include it. Save the SVG under the map's name in %s (for instance flight-seats.svg) to see the example."
msgstr "这个示例画在 ECharts 示例站点的 SVG 地图 %s 上。这张图没有记录许可证，demo 没有附带。把这份 SVG 以地图名存进 %s（例如 flight-seats.svg）就能看到这个示例。"

#: umain.rsnoticeprojection
#, object-pascal-format
msgid "This example projects its map with d3-geo's Albers USA projection, which the page loads from a CDN. Register handlers under the names %s with TyChartRegisterGeoProjection (ualbersusa.pas does) to draw it."
msgstr "这个示例用 d3-geo 的 Albers USA 投影画地图，页面从 CDN 加载它。用 TyChartRegisterGeoProjection 以 %s 这些名字注册投影处理函数（ualbersusa.pas 就是这样做的），就能画出来。"

#: umain.rsnoticenotconverted
#, object-pascal-format
msgid "This example could not be converted: %s"
msgstr "这个示例没能转换：%s"

#: umain.rsnotelostcanvas
msgid "The page draws a picture of its own on a canvas (here the background pattern); the harvest cannot carry it, so it is left out."
msgstr "页面自己在 canvas 上画了一张图（这里是背景图案），采集带不过来，所以没有它。"

#: umain.rsnotegenerated
msgid "The data of this example is made by ugenerated.pas, from the page's own code and random numbers; the editor shows the option without it."
msgstr "这个示例的数据由 ugenerated.pas 按页面自己的代码和随机数生成；编辑框里显示的是不含这些数据的 option。"

#: umain.rsnoteshortened
#, object-pascal-format
msgid "The option is %s MB; the editor shows its beginning, and Apply sets the whole of it while that is unchanged."
msgstr "这份 option 有 %s MB，编辑框只显示开头；只要没改动，“应用”设置的是完整的 option。"

#: umain.rsnoteimagemissing
#, object-pascal-format
msgid "The page shows the picture %s from the ECharts examples site, whose source the repository does not record, so the demo does not include it; saved in %s under that name it is drawn."
msgstr "页面显示 ECharts 示例站点的图片 %s。仓库没有记录这张图的来源，demo 没有附带；以这个文件名存进 %s 就能画出来。"

#: umain.rsnoteuntranscribed
#, object-pascal-format
msgid "The page's function %s is not transcribed: %s."
msgstr "页面的函数 %s 没有转写：%s。"
