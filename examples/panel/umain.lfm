object MainForm: TMainForm
  Left = 0
  Height = 636
  Top = 0
  Width = 560
  Caption = 'TTyPanel example'
  ClientHeight = 636
  ClientWidth = 560
  Position = poScreenCenter
  LCLVersion = '4.4.0.0'
  OnCreate = FormCreate
  TitleBar = Bar
  object Surface: TTyFormSurface
    Left = 0
    Height = 636
    Top = 0
    Width = 560
    Align = alClient
    object Bar: TTyTitleBar
      Left = 0
      Height = 34
      Top = 0
      Width = 560
      Align = alTop
      Caption = 'TTyPanel  ·  TyControls'
      TitleAlignment = taLeftJustify
      object DarkSwitch: TTyToggleSwitch
        Left = 212
        Height = 24
        Top = 5
        Width = 74
        Anchors = [akTop, akRight]
        Caption = 'Dark'
        OnChange = DarkSwitchChange
      end
      object ThemeCombo: TTyComboBox
        Left = 294
        Height = 26
        Top = 4
        Width = 120
        Anchors = [akTop, akRight]
        OnChange = ThemeComboChange
      end
    end
    object OuterPanel: TTyPanel
      Left = 16
      Height = 190
      Top = 50
      Width = 340
      Caption = 'User info (Caption left-aligned)'
      Alignment = taLeftJustify
      object NameLabel: TTyLabel
        Left = 12
        Height = 24
        Top = 40
        Width = 64
        Caption = 'Name:'
      end
      object NameEdit: TTyEdit
        Left = 80
        Height = 26
        Top = 40
        Width = 240
      end
      object GreetBtn: TTyButton
        Left = 80
        Height = 32
        Top = 80
        Width = 120
        Caption = 'Say hello'
        StyleClass = 'primary'
        OnClick = GreetClicked
      end
      object InnerPanel: TTyPanel
        Left = 12
        Height = 52
        Top = 124
        Width = 316
        Caption = 'Nested sub-panel (centered)'
        Alignment = taCenter
      end
    end
    object RightPanel: TTyPanel
      Left = 372
      Height = 190
      Top = 50
      Width = 172
      Caption = 'Description'
      object DescLabel: TTyLabel
        Left = 12
        Height = 140
        Top = 40
        Width = 148
        Caption = 'The panel''s background, border and corners all come from the theme''s TyPanel rule, no hand-written colours.'
      end
    end
    object ResultLabel: TTyLabel
      Left = 16
      Height = 24
      Top = 252
      Width = 528
      Caption = 'Click the "Say hello" button…'
    end
    object AlignHeader: TTyLabel
      Left = 16
      Height = 24
      Top = 288
      Width = 528
      Caption = 'Alignment — watch the caption slide from edge to edge across these three'
    end
    object AlignLeftPanel: TTyPanel
      Left = 16
      Height = 40
      Top = 316
      Width = 168
      Caption = 'taLeftJustify'
      Alignment = taLeftJustify
    end
    object AlignCenterPanel: TTyPanel
      Left = 196
      Height = 40
      Top = 316
      Width = 168
      Caption = 'taCenter (default)'
    end
    object AlignRightPanel: TTyPanel
      Left = 376
      Height = 40
      Top = 316
      Width = 168
      Caption = 'taRightJustify'
      Alignment = taRightJustify
    end
    object OverrideHeader: TTyLabel
      Left = 16
      Height = 24
      Top = 368
      Width = 528
      Caption = 'StyleOverride — only the left panel is restyled; switch skins, both still follow'
    end
    object AccentPanel: TTyPanel
      Left = 16
      Height = 52
      Top = 396
      Width = 260
      Caption = 'Accent tint, thicker edge, 12px corners'
      StyleOverride = 'background: alpha(var(--accent), 0.14); border-color: var(--accent); border-width: 2px; border-radius: 12px;'
    end
    object PlainPanel: TTyPanel
      Left = 284
      Height = 52
      Top = 396
      Width = 260
      Caption = 'No override — plain theme values'
    end
    object InteractHeader: TTyLabel
      Left = 16
      Height = 24
      Top = 460
      Width = 528
      Caption = 'A panel is a real control — hover it for a Hint, click it, or switch it off'
    end
    object HotPanel: TTyPanel
      Left = 16
      Height = 52
      Top = 488
      Width = 340
      Cursor = crHandPoint
      Caption = 'Hover and click me'
      Hint = 'ShowHint = True: panels carry hints like any other control'
      ShowHint = True
      OnClick = HotPanelClick
      OnMouseEnter = HotPanelMouseEnter
      OnMouseLeave = HotPanelMouseLeave
    end
    object DisabledPanel: TTyPanel
      Left = 372
      Height = 52
      Top = 488
      Width = 172
      Caption = 'Enabled = False'
      Enabled = False
    end
    object PanelEventLabel: TTyLabel
      Left = 16
      Height = 24
      Top = 552
      Width = 528
      Caption = 'Panel mouse events show up here…'
    end
    object BottomPanel: TTyPanel
      Left = 0
      Height = 44
      Top = 592
      Width = 560
      Align = alBottom
