object MainForm: TMainForm
  Left = 0
  Height = 320
  Top = 0
  Width = 440
  Caption = 'RadioButton example'
  ClientHeight = 320
  ClientWidth = 440
  Position = poScreenCenter
  LCLVersion = '4.4.0.0'
  OnCreate = FormCreate
  TitleBar = Bar
  object Surface: TTyFormSurface
    Left = 0
    Height = 320
    Top = 0
    Width = 440
    Align = alClient
    object Bar: TTyTitleBar
      Left = 0
      Height = 34
      Top = 0
      Width = 440
      Align = alTop
      Caption = 'RadioButton  · TyControls'
      TitleAlignment = taLeftJustify
      object DarkSwitch: TTyToggleSwitch
        Left = 92
        Height = 24
        Top = 5
        Width = 74
        Anchors = [akTop, akRight]
        Caption = 'Dark'
        OnChange = DarkSwitchChange
      end
      object ThemeCombo: TTyComboBox
        Left = 174
        Height = 26
        Top = 4
        Width = 120
        Anchors = [akTop, akRight]
        OnChange = ThemeComboChange
      end
    end
    object GroupA: TTyGroupBox
      Left = 16
      Height = 168
      Top = 52
      Width = 190
      Caption = 'Fruit'
      Alignment = taLeftJustify
      object FFruitApple: TTyRadioButton
        Left = 10
        Height = 26
        Top = 24
        Width = 160
        Caption = 'Apple'
        OnChange = RadioChanged
      end
      object FFruitBanana: TTyRadioButton
        Left = 10
        Height = 26
        Top = 56
        Width = 160
        Caption = 'Banana'
        OnChange = RadioChanged
      end
      object FFruitMango: TTyRadioButton
        Left = 10
        Height = 26
        Top = 88
        Width = 160
        Caption = 'Mango (out of stock)'
        Enabled = False
        OnChange = RadioChanged
      end
    end
    object GroupB: TTyGroupBox
      Left = 232
      Height = 168
      Top = 52
      Width = 190
      Caption = 'Colour'
      Alignment = taCenter
      object FColorRed: TTyRadioButton
        Left = 10
        Height = 26
        Top = 24
        Width = 160
        Caption = 'Red'
        OnChange = RadioChanged
      end
      object FColorGreen: TTyRadioButton
        Left = 10
        Height = 26
        Top = 56
        Width = 160
        Caption = 'Green'
        OnChange = RadioChanged
      end
      object FColorBlue: TTyRadioButton
        Left = 10
        Height = 26
        Top = 88
        Width = 160
        Caption = 'Blue'
        OnChange = RadioChanged
      end
    end
    object LblStatus: TTyLabel
      Left = 16
      Height = 24
      Top = 236
      Width = 408
      Caption = ''
    end
  end
end
