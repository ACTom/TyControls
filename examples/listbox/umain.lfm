object MainForm: TMainForm
  Left = 0
  Height = 530
  Top = 0
  Width = 420
  Caption = 'TTyListBox example'
  ClientHeight = 530
  ClientWidth = 420
  Position = poScreenCenter
  LCLVersion = '4.4.0.0'
  OnCreate = FormCreate
  TitleBar = Bar
  object Surface: TTyFormSurface
    Left = 0
    Height = 530
    Top = 0
    Width = 420
    TabOrder = 0
    Align = alClient
    object Bar: TTyTitleBar
      Left = 0
      Height = 34
      Top = 0
      Width = 420
      Align = alTop
      Caption = 'TTyListBox  ·  TyControls'
      TitleAlignment = taLeftJustify
      object DarkSwitch: TTyToggleSwitch
        Left = 72
        Height = 24
        Top = 5
        Width = 74
        Anchors = [akTop, akRight]
        Caption = 'Dark'
        OnChange = DarkSwitchChange
      end
      object ThemeCombo: TTyComboBox
        Left = 154
        Height = 26
        Top = 4
        Width = 120
        Anchors = [akTop, akRight]
        OnChange = ThemeComboChange
      end
    end
    object LblTitle: TTyLabel
      Left = 16
      Height = 20
      Top = 46
      Width = 388
      Caption = 'City list (arrows / PageUp/Down / wheel; double-click a row):'
    end
    object ListBox: TTyListBox
      Left = 16
      Height = 220
      Top = 70
      Width = 388
      OnChange = ListBoxChange
      OnDblClick = ListBoxDblClick
    end
    object ChkMulti: TTyCheckBox
      Left = 16
      Height = 24
      Top = 300
      Width = 130
      Caption = 'Multi-select mode'
      OnChange = MultiChange
    end
    object ChkSorted: TTyCheckBox
      Left = 150
      Height = 24
      Top = 300
      Width = 130
      Caption = 'Sort ascending'
      OnChange = SortedChange
    end
    object BtnHeight: TTyButton
      Left = 16
      Height = 30
      Top = 332
      Width = 132
      Caption = 'Pin height 24 / 32'
      OnClick = ToggleHeight
    end
    object BtnSelAll: TTyButton
      Left = 158
      Height = 30
      Top = 332
      Width = 120
      Caption = 'Select all'
      OnClick = DoSelectAll
    end
    object BtnClear: TTyButton
      Left = 288
      Height = 30
      Top = 332
      Width = 120
      Caption = 'Clear selection'
      OnClick = DoClear
    end
    object BtnScroll: TTyButton
      Left = 16
      Height = 30
      Top = 370
      Width = 120
      Caption = 'Scroll to row 20'
      OnClick = DoScroll
    end
    object BtnAlternate: TTyButton
      Left = 146
      Height = 30
      Top = 370
      Width = 120
      Caption = 'Select every 2nd'
      OnClick = DoAlternate
    end
    object LblHint: TTyLabel
      Left = 16
      Height = 60
      Top = 408
      Width = 388
      Caption = 'Row height follows the theme (--item-height) until you pin ItemHeight — switch skin first and watch it change on its own. In multi-select, Ctrl-click / Shift-click / Space toggle rows.'
      WordWrap = True
    end
    object LblStatus: TTyLabel
      Left = 16
      Height = 44
      Top = 476
      Width = 388
      WordWrap = True
    end
  end
end
