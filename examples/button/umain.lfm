object MainForm: TMainForm
  Left = 0
  Height = 500
  Top = 0
  Width = 460
  Caption = 'TTyButton example'
  ClientHeight = 500
  ClientWidth = 460
  Position = poScreenCenter
  LCLVersion = '4.4.0.0'
  OnCreate = FormCreate
  TitleBar = Bar
  TitleHeight = 34
  object Surface: TTyFormSurface
    Left = 0
    Height = 500
    Top = 0
    Width = 460
    TabOrder = 0
    Align = alClient
    object Bar: TTyTitleBar
      Left = 0
      Height = 34
      Top = 0
      Width = 460
      TabOrder = 0
      Caption = 'TTyButton  ·  TyControls'
      Align = alTop
      ButtonWidth = 46
      object DarkSwitch: TTyToggleSwitch
        Left = 112
        Height = 24
        Top = 5
        Width = 74
        TabOrder = 3
        TabStop = True
        Caption = 'Dark'
        OnChange = DarkSwitchChange
        Anchors = [akTop, akRight]
      end
      object ThemeCombo: TTyComboBox
        Left = 194
        Height = 26
        Top = 4
        Width = 120
        TabOrder = 4
        ItemIndex = -1
        OnChange = ThemeComboChange
        Anchors = [akTop, akRight]
      end
    end
    object BtnDefault: TTyButton
      Left = 24
      Height = 32
      Top = 52
      Width = 168
      TabOrder = 1
      OnClick = ButtonClicked
      Caption = '&Default button'
    end
    object BtnPrimary: TTyButton
      Left = 24
      Height = 32
      Top = 92
      Width = 168
      TabOrder = 2
      OnClick = ButtonClicked
      StyleClass = 'primary'
      Caption = '&Primary button'
    end
    object BtnDanger: TTyButton
      Left = 24
      Height = 32
      Top = 132
      Width = 168
      TabOrder = 3
      OnClick = ButtonClicked
      StyleClass = 'danger'
      Caption = 'D&anger button'
    end
    object BtnDisabled: TTyButton
      Left = 24
      Height = 32
      Top = 172
      Width = 168
      Enabled = False
      TabOrder = 4
      OnClick = ButtonClicked
      StyleClass = 'primary'
      Caption = 'Disabled button'
    end
    object BtnGhost: TTyButton
      Left = 24
      Height = 32
      Top = 212
      Width = 168
      TabOrder = 5
      OnClick = GhostToggle
      StyleClass = 'ghost'
      Down = True
      Caption = 'Ghost / selected'
    end
    object BtnMsg: TTyButton
      Left = 256
      Height = 32
      Top = 52
      Width = 168
      TabOrder = 6
      OnClick = ButtonClicked
      ShowBadge = True
      BadgeValue = 128
      BadgePosition = bpTopRight
      Caption = 'Message'
    end
    object BtnNotify: TTyButton
      Left = 256
      Height = 32
      Top = 92
      Width = 168
      TabOrder = 7
      OnClick = ButtonClicked
      ShowBadge = True
      BadgeValue = 3
      Caption = 'Notification'
    end
    object BtnOK: TTyButton
      Left = 256
      Height = 32
      Top = 132
      Width = 168
      TabOrder = 8
      OnClick = DefaultClicked
      StyleClass = 'primary'
      Default = True
      ModalResult = 1
      Caption = 'OK (Enter)'
    end
    object BtnCancel: TTyButton
      Left = 256
      Height = 32
      Top = 172
      Width = 168
      TabOrder = 9
      OnClick = CancelClicked
      Cancel = True
      ModalResult = 2
      Caption = 'Cancel (Esc)'
    end
    object BtnInbox: TTyButton
      Left = 256
      Height = 32
      Top = 212
      Width = 174
      TabOrder = 10
      OnBadgeDisplay = InboxBadgeDisplay
      ShowBadge = True
      BadgeValue = 0
      BadgePosition = bpTopLeft
      Caption = 'Inbox (badge hidden at 0)'
    end
    object LblAnimBadgeHint: TTyLabel
      Left = 24
      Height = 54
      Top = 252
      Width = 412
      WordWrap = True
      Caption = 'AnimationsEnabled = False makes the left button snap on hover instead of fading; OnBadgeDisplay keeps the Inbox badge hidden until its value passes 0.'
    end
    object BtnNoAnim: TTyButton
      Left = 24
      Height = 32
      Top = 314
      Width = 168
      TabOrder = 11
      OnClick = ButtonClicked
      AnimationsEnabled = False
      Caption = 'No hover fade'
    end
    object BtnInboxAdd: TTyButton
      Left = 256
      Height = 32
      Top = 314
      Width = 168
      TabOrder = 12
      OnClick = AddInbox
      Caption = 'Add one to Inbox'
    end
    object LblAutoHint: TTyLabel
      Left = 24
      Height = 54
      Top = 356
      Width = 412
      WordWrap = True
      Caption = 'AutoSize = True: the designed Width = 100 is overrun at run time so the whole caption fits, where a fixed-width button ellipsises it.'
    end
    object BtnAuto: TTyButton
      Left = 24
      Height = 32
      Top = 418
      Width = 100
      TabOrder = 13
      OnClick = ButtonClicked
      AutoSize = True
      Caption = 'AutoSize=True: I grow to fit this long caption'
    end
    object LblStatus: TTyLabel
      Left = 24
      Height = 24
      Top = 460
      Width = 412
      Caption = 'Click count: 0'
    end
  end
end
