# --- .lfm captions/text/hints (auto-generated, msgid=English source) ---

#: tmainform.caption
msgid "TTyDateTimePicker example"
msgstr "TTyDateTimePicker 示例"

#: tmainform.darkswitch.caption
msgid "Dark"
msgstr "暗色"

#: tmainform.lbldate.caption
msgid "Date (dtkDate):"
msgstr "日期 (dtkDate)："

#: tmainform.lbltime.caption
msgid "Time (dtkTime):"
msgstr "时间 (dtkTime)："

#: tmainform.lblcheck.caption
msgid "Nullable date:"
msgstr "可空日期："

#: tmainform.btnopen.caption
msgid "Open"
msgstr "打开"

#: tmainform.lblreadonly.caption
msgid "Read-only:"
msgstr "只读："

#: tmainform.lblreadonlyhint.caption
msgid "ReadOnly: typing and Up/Down are ignored, the calendar still opens. The 'mmmm' name follows the app language"
msgstr "ReadOnly：键入与 Up/Down 无效，日历仍可打开。'mmmm' 月份名跟随应用语言"

#: tmainform.lblrange.caption
msgid "Limited range:"
msgstr "受限范围："

#: tmainform.lblrangehint.caption
msgid "MinDate/MaxDate = today +/-3 days: stepping stops at the edge"
msgstr "MinDate/MaxDate = 今天 +/-3 天：步进到边界即停"

#: tmainform.lblampm.caption
msgid "12-hour time:"
msgstr "12 小时制："

#: tmainform.lblampmhint.caption
msgid "TimeFormat hh:nn am/pm: Up/Down flips the AM/PM segment"
msgstr "TimeFormat hh:nn am/pm：Up/Down 切换 AM/PM 段"

#: tmainform.lbllocale.caption
msgid "Locale format:"
msgstr "区域格式："

#: tmainform.lbllocalehint.caption
msgid "DateFormat left empty: follows the OS short-date format"
msgstr "DateFormat 留空：跟随系统短日期格式"

#: tmainform.lbldrophint.caption
msgid "Open sets DatePicker.DroppedDown := True; closing reads it back"
msgstr "打开按钮设 DatePicker.DroppedDown := True；关闭后回读"

#: tmainform.bar.caption
msgid "TTyDateTimePicker  ·  TyControls"
msgstr "TTyDateTimePicker  ·  TyControls"

# --- code resourcestrings (msgid=Pascal source) ---

#: umain.rscalopened
msgid "Calendar opened: click a date or press Enter to confirm, Esc to cancel."
msgstr "日历已打开：点日期或按回车确认，Esc 取消。"

#: umain.rsdroppedfmt
#, object-pascal-format
msgid "DroppedDown = %s"
msgstr "DroppedDown = %s"

#: umain.rsempty
msgid "(empty)"
msgstr "（空）"

#: umain.rsstatusfmt
#, object-pascal-format
msgid "Date:%s\r\nTime:%s\r\nNullable:%s\r\nTip: ←/→ switch field, ↑/↓ or wheel to step, type a digit directly, chevron opens the calendar."
msgstr "日期：%s\n时间：%s\n可空：%s\n提示：←/→ 切换字段，↑/↓ 或滚轮步进，可直接输入数字，点箭头打开日历。"
