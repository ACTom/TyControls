# The entry below is a LOAD MARKER, not prose: its being translated at all is
# how the library knows a catalogue was deliberately loaded, which switches
# TTyCalendar / TTyDateTimePicker month & weekday names from the OS locale to
# this catalogue's language (tyControls.Calendar.TyDateTimeNames). Set it to
# this catalogue's language code; never copy '__locale__' through. Leaving it
# untranslated is the deliberate opt-out that keeps OS-locale names.
#: tycontrols.strconsts.rstydatetimenameslang
msgid "__locale__"
msgstr "zh_CN"

