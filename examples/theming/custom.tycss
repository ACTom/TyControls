/* TyControls — Custom 自定义主题（紫色强调色，暖白底色） */
:root {
  --accent:     #7C3AED;
  --surface:    #FAF9F7;
  --on-surface: #1C1917;
  --border:     #C4B5FD;
  --radius:     8px;
}

TyButton, TyGlyphContainerButton, TyRibbonAppMenu, TySpeedButton, TyButtonGroup, TyUpDown {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: 1px;
  border-radius: var(--radius);
  padding: 6px;
  font-size: 10px;
  font-weight: 400;
}
TyButton:hover, TyGlyphContainerButton:hover, TyRibbonAppMenu:hover, TySpeedButton:hover, TyButtonGroup:hover, TyUpDown:hover    { background: darken(--surface, 4%); }
TyButton:focus, TyGlyphContainerButton:focus, TyRibbonAppMenu:focus, TySpeedButton:focus, TyButtonGroup:focus, TyUpDown:focus    { border-color: var(--accent); }
TyButton:active, TyGlyphContainerButton:active, TyRibbonAppMenu:active, TySpeedButton:active, TyButtonGroup:active, TyUpDown:active   { background: darken(--surface, 10%); }
TyButton:disabled, TyGlyphContainerButton:disabled, TyRibbonAppMenu:disabled, TySpeedButton:disabled, TyButtonGroup:disabled, TyUpDown:disabled { opacity: 0.4; }
TyButton.primary, TyGlyphContainerButton.primary, TyRibbonAppMenu.primary, TySpeedButton.primary, TyButtonGroup.primary, TyUpDown.primary  { background: var(--accent); color: #FFFFFF; border-color: var(--accent); }
TyButton.primary:hover, TyGlyphContainerButton.primary:hover, TyRibbonAppMenu.primary:hover, TySpeedButton.primary:hover, TyButtonGroup.primary:hover, TyUpDown.primary:hover  { background: lighten(--accent, 8%); }
TyButton.primary:active, TyGlyphContainerButton.primary:active, TyRibbonAppMenu.primary:active, TySpeedButton.primary:active, TyButtonGroup.primary:active, TyUpDown.primary:active { background: darken(--accent, 8%); }

TyLabel, TyHtmlLabel, TyLinkLabel, TyShadowLabel, TyGlowLabel, TyDivider, TyCharImage {
  background: alpha(#FFFFFF, 0);
  color: var(--on-surface);
  font-size: 10px;
  font-weight: 400;
}
TyLabel:disabled, TyHtmlLabel:disabled, TyLinkLabel:disabled, TyShadowLabel:disabled, TyGlowLabel:disabled, TyDivider:disabled, TyCharImage:disabled { opacity: 0.4; }

TyEdit {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: 1px;
  border-radius: var(--radius);
  padding: 4px;
  font-size: 10px;
}
TyEdit:hover  { border-color: var(--accent); }
TyEdit:focus  { border-color: var(--accent); }
TyEdit:disabled { opacity: 0.4; }

TyCheckBox {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: 1px;
  border-radius: 4px;
}
TyCheckBox:hover   { border-color: var(--accent); }
TyCheckBox:active  { background: var(--accent); }
TyCheckBox:disabled { opacity: 0.4; }

TyPanel, TyExPanel, TyScrollBox, TyChart, TyCalculator, TyBevel, TySizeBox, TyControlBar, TyCoolBar, TyColorGrid, TyShape, TyStarShape, TyArrow, TyImageView, TyImage, TyPreviewBox, TyListGroupPanel {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: 1px;
  border-radius: var(--radius);
  padding: 8px;
}
