#: tmainform.caption
msgid "Theme system example"
msgstr "主题系统 示例"

#: tmainform.bar.caption
msgid "Theme system  · TyControls"
msgstr "主题系统  · TyControls"

#: tmainform.btnlight.caption
msgid "Light"
msgstr "亮色 Light"

#: tmainform.btndark.caption
msgid "Dark"
msgstr "暗色 Dark"

#: tmainform.btngreen.caption
msgid "Green"
msgstr "绿色 Green"

#: tmainform.btnaccent.caption
msgid "Accent colour…"
msgstr "主题色…"

#: tmainform.btnaccentreset.caption
msgid "Reset to default"
msgstr "复位默认"

#: tmainform.lblstatus.caption
msgid "Current theme: default"
msgstr "当前主题：default"

#: tmainform.lblsample.caption
msgid "Sample label TTyLabel"
msgstr "示例标签 TTyLabel"

#: tmainform.btnsample.caption
msgid "Primary button"
msgstr "主要按钮"

#: tmainform.btnghost.caption
msgid "Ghost button"
msgstr "幽灵按钮"

#: tmainform.btndisabled.caption
msgid "Disabled"
msgstr "禁用态"

#: tmainform.edsample.text
msgid "Editable text box"
msgstr "可编辑文本框"

#: tmainform.chksample.caption
msgid "Checkbox example"
msgstr "复选框示例"

#: tmainform.lbladvanced.caption
msgid "Four more layers of the same theme system"
msgstr "同一主题系统的另外四个层次"

#: tmainform.btnauto.caption
msgid "Auto (follow OS)"
msgstr "自动（跟随系统）"

#: tmainform.lblfollowhint.caption
msgid "Auto re-checks the OS scheme every 750 ms - flip Windows dark mode and the window follows."
msgstr "自动模式每 750 ms 重查一次系统明暗 - 切换 Windows 暗色模式，窗口随之切换。"

#: tmainform.lbldensityhint.caption
msgid "Modern density keeps the skin colours but re-resolves radius, padding and control sizes."
msgstr "现代密度保留皮肤配色，只重算圆角、内边距与控件尺寸。"

#: tmainform.chkhotreload.caption
msgid "Hot-reload"
msgstr "热重载"

#: tmainform.lblhothint.caption
msgid "Watches ThemeFile only: ticking this loads green.tycss - edit and save it to see it reload."
msgstr "只监视 ThemeFile：勾选后加载 green.tycss - 编辑并保存即可看到重载。"

#: tmainform.btnoverlay.caption
msgid "Overlay a tweak"
msgstr "叠加一层微调"

#: tmainform.lbllayerhint.caption
msgid "Adds a CSS layer over the live theme: accent and radius change, the skin stays."
msgstr "在当前主题上叠一层 CSS：主题色与圆角改变，皮肤不变。"

#: tmainform.btncustom.caption
msgid "Custom file"
msgstr "自定义文件"

#: tmainform.lblcustomhint.caption
msgid "Loads custom.tycss from this example folder - the write-your-own-theme-file path."
msgstr "从本示例目录加载 custom.tycss - 这就是自己写主题文件的用法。"

#: tmainform.btnoverride.caption
msgid "Overridden"
msgstr "已覆盖"

#: tmainform.lblovrhint.caption
msgid "StyleOverride pins per-instance CSS above the theme; var(--accent) still tracks a skin switch."
msgstr "StyleOverride 把单实例 CSS 钉在主题之上；var(--accent) 仍随皮肤切换。"

#: tmainform.lbllistener.caption
msgid "Every theme, mode, accent, density or hot-reload change fires the change listeners on the controller - this window hooks one to re-skin its chrome."
msgstr "主题、模式、主题色、密度或热重载的任何变化都会触发控制器上的变更监听 - 本窗口挂了一个监听来重刷自身外框。"

#: tmainform.switchdensity.caption
msgid "Modern density"
msgstr "现代密度"

# --- code resourcestrings (msgid=Pascal source) ---

#: umain.rsaccentfmt
#, object-pascal-format
msgid "Accent colour: %s (overlaid on the current theme)"
msgstr "强调色：%s（叠加在当前主题上）"

#: umain.rsaccentreset
msgid "Accent colour: restored to theme default"
msgstr "强调色：已恢复为主题默认值"

#: umain.rscurthemefmt
#, object-pascal-format
msgid "Current theme: %s"
msgstr "当前主题：%s"

#: umain.rsdensityclassic
msgid "Density: classic"
msgstr "密度：经典"

#: umain.rsdensitymodern
msgid "Density: modern (Web scale) - same skin, roomier geometry"
msgstr "密度：现代（Web 尺度）—— 皮肤不变，几何更宽松"

#: umain.rsfollowsos
msgid "Appearance: follows the OS light/dark setting"
msgstr "外观：跟随操作系统的明暗设置"

#: umain.rshotoff
msgid "Hot-reload OFF"
msgstr "热重载已关"

#: umain.rshotonfmt
#, object-pascal-format
msgid "Hot-reload ON - save an edit to %s and the window re-themes"
msgstr "热重载已开 —— 编辑并保存 %s，窗口会随之重新换肤"

#: umain.rsmodedark
msgid "Mode: Dark (manual)"
msgstr "模式：暗色（手动）"

#: umain.rsmodelight
msgid "Mode: Light (manual)"
msgstr "模式：浅色（手动）"

#: umain.rsoverlaydone
msgid "Additive layer applied - skin kept, two tokens overridden"
msgstr "已叠加附加层 —— 皮肤保留，仅覆盖两个令牌"

#: umain.rspickaccent
msgid "Choose accent colour"
msgstr "选择强调色"

#: umain.rsthemecustom
msgid "Current theme: custom.tycss (hand-written, partial by design)"
msgstr "当前主题：custom.tycss（手写的主题文件，特意只写了一部分）"

#: umain.rsthemegreen
msgid "Current theme: green (image background)"
msgstr "当前主题：green（图片背景）"
