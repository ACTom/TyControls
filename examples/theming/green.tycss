/* TyControls — Green theme (nature background image demo) — DUAL-MODE (light + dark).
   Image-background theme: the nature photo stays IDENTICAL in both modes (see TyForm);
   only the CONTROL COLOURS flip. Light = white translucent controls with deep-green
   ink; Dark = near-black translucent controls with light-green ink. All translucency /
   glass tints derive from --surface, so they flip automatically. --accent stays the
   brand seed (brightened a touch in dark for contrast) so the runtime accent-picker
   still recolours the skin. Non-colour structure (radii, padding, glass-blur, gradients'
   shape, font-weight, render-style) is unchanged from the original. */
:root {
  --radius:        6px;
  /* derived tokens — reference the per-mode palette, so they flip automatically */
  --focus-ring:    var(--accent);
  --selection:     alpha(var(--accent), 0.30);
  --muted:         alpha(var(--on-surface), 0.5);
  --overlay-hover: alpha(var(--on-surface), 0.12);
}

/* @mode light = the CURRENT green look (unchanged colours). */
@mode light {
  :root {
    --accent:     #16A34A;
    --surface:    #FFFFFF;
    --on-surface: #14532D;
    --border:     #BBD8C4;
    --danger:     #EF4444;
  }
}

/* @mode dark = near-black translucent controls + light-green ink; same photo bg. */
@mode dark {
  :root {
    --accent:     #22C55E;   /* brightened green — stands out on dark, still the brand seed */
    --surface:    #0C1610;   /* near-#000000 with a faint green tint; glass/tints derive from this */
    --on-surface: #DCFCE7;   /* light-green ink for readability over the photo */
    --border:     #2E4A3A;   /* deep-green border */
    --danger:     #F87171;   /* brightened red for dark contrast */
  }
}

/* Window/form backdrop — a nature photo, covering the whole client. */
TyForm {
  background: darken(--surface, 4%);
  background-image: url(assets/background.jpg);
  background-size: cover;
  background-under-titlebar: true;
}

TyButton, TyGlyphContainerButton, TyRibbonAppMenu, TySpeedButton, TyButtonGroup, TyUpDown {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: 1px;
  border-radius: var(--radius);
  padding: 6px;
  font-size: 9px;
  font-weight: 400;
}
TyButton:hover, TyGlyphContainerButton:hover, TyRibbonAppMenu:hover, TySpeedButton:hover, TyButtonGroup:hover, TyUpDown:hover    { background: darken(--surface, 4%); border-color: darken(--border, 10%); }
TyButton:focus, TyGlyphContainerButton:focus, TyRibbonAppMenu:focus, TySpeedButton:focus, TyButtonGroup:focus, TyUpDown:focus    { border-color: var(--accent); outline: 2px var(--focus-ring); }
TyButton:active, TyGlyphContainerButton:active, TyRibbonAppMenu:active, TySpeedButton:active, TyButtonGroup:active, TyUpDown:active   { background: darken(--surface, 10%); }
TyButton:disabled, TyGlyphContainerButton:disabled, TyRibbonAppMenu:disabled, TySpeedButton:disabled, TyButtonGroup:disabled, TyUpDown:disabled { opacity: 0.5; }
TyButton.primary, TyGlyphContainerButton.primary, TyRibbonAppMenu.primary, TySpeedButton.primary, TyButtonGroup.primary, TyUpDown.primary  { background: var(--accent); color: #FFFFFF; border-color: var(--accent); }
TyButton.primary:hover, TyGlyphContainerButton.primary:hover, TyRibbonAppMenu.primary:hover, TySpeedButton.primary:hover, TyButtonGroup.primary:hover, TyUpDown.primary:hover    { background: lighten(--accent, 8%); }
TyButton.primary:active, TyGlyphContainerButton.primary:active, TyRibbonAppMenu.primary:active, TySpeedButton.primary:active, TyButtonGroup.primary:active, TyUpDown.primary:active   { background: darken(--accent, 8%); }
TyButton.danger, TyGlyphContainerButton.danger, TyRibbonAppMenu.danger, TySpeedButton.danger, TyButtonGroup.danger, TyUpDown.danger   { background: var(--danger); color: #FFFFFF; border-color: var(--danger); }
TyButton.danger:hover, TyGlyphContainerButton.danger:hover, TyRibbonAppMenu.danger:hover, TySpeedButton.danger:hover, TyButtonGroup.danger:hover, TyUpDown.danger:hover     { background: lighten(--danger, 8%); }
TyButton.danger:active, TyGlyphContainerButton.danger:active, TyRibbonAppMenu.danger:active, TySpeedButton.danger:active, TyButtonGroup.danger:active, TyUpDown.danger:active    { background: darken(--danger, 8%); }
/* Ghost (VS Code 风格): 平时透明,仅 hover/active/选中显示。 */
TyButton.ghost, TyGlyphContainerButton.ghost, TyRibbonAppMenu.ghost, TySpeedButton.ghost, TyButtonGroup.ghost, TyUpDown.ghost {
  background: alpha(var(--surface), 0);
  color: var(--on-surface);
  border-color: alpha(var(--border), 0);
  border-width: 1px;
  border-radius: var(--radius);
  padding: 6px;
  font-size: 9px;
  font-weight: 400;
}
TyButton.ghost:hover, TyGlyphContainerButton.ghost:hover, TyRibbonAppMenu.ghost:hover, TySpeedButton.ghost:hover, TyButtonGroup.ghost:hover, TyUpDown.ghost:hover    { background: darken(--surface, 4%); border-color: darken(--border, 10%); }
TyButton.ghost:active, TyGlyphContainerButton.ghost:active, TyRibbonAppMenu.ghost:active, TySpeedButton.ghost:active, TyButtonGroup.ghost:active, TyUpDown.ghost:active   { background: darken(--surface, 10%); }
TyButton.ghost:selected, TyGlyphContainerButton.ghost:selected, TyRibbonAppMenu.ghost:selected, TySpeedButton.ghost:selected, TyButtonGroup.ghost:selected, TyUpDown.ghost:selected { background: darken(--surface, 10%); border-color: var(--accent); }
TyButton.ghost:focus, TyGlyphContainerButton.ghost:focus, TyRibbonAppMenu.ghost:focus, TySpeedButton.ghost:focus, TyButtonGroup.ghost:focus, TyUpDown.ghost:focus    { outline: 2px var(--focus-ring); }
TyButton.ghost:disabled, TyGlyphContainerButton.ghost:disabled, TyRibbonAppMenu.ghost:disabled, TySpeedButton.ghost:disabled, TyButtonGroup.ghost:disabled, TyUpDown.ghost:disabled { opacity: 0.5; }

TyLabel, TyHtmlLabel, TyLinkLabel, TyShadowLabel, TyGlowLabel, TyDivider, TyCharImage {
  background: alpha(#FFFFFF, 0);
  color: var(--on-surface);
  font-size: 9px;
  font-weight: 400;
}
TyLabel:disabled, TyHtmlLabel:disabled, TyLinkLabel:disabled, TyShadowLabel:disabled, TyGlowLabel:disabled, TyDivider:disabled, TyCharImage:disabled { opacity: 0.5; }

TyEdit {
  background: alpha(#FFFFFF, 0);
  color: var(--on-surface);
  border-color: alpha(var(--border), 0.6);
  border-width: 1px;
  border-radius: var(--radius);
  padding: 4px;
  font-size: 9px;
  glass-blur: 16px;
  glass-tint: alpha(var(--surface), 0.42);
}
TyEdit:hover    { border-color: darken(--border, 10%); }
TyEdit:focus    { border-color: var(--accent); outline: 2px var(--focus-ring); }
TyEdit:disabled { opacity: 0.5; }

TyCheckBox {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: 1px;
  border-radius: 3px;
  padding: 4px;
}
TyCheckBox:hover    { border-color: var(--accent); }
TyCheckBox:active   { background: var(--accent); color: #FFFFFF; }
TyCheckBox:focus    { outline: 2px var(--focus-ring); }
TyCheckBox:disabled { opacity: 0.5; }

TyRadioButton {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: 1px;
  border-radius: 8px;
  padding: 4px;
}
TyRadioButton:hover    { border-color: var(--accent); }
TyRadioButton:active   { background: var(--accent); color: #FFFFFF; }
TyRadioButton:focus { outline: 2px var(--focus-ring); }
TyRadioButton:disabled { opacity: 0.5; }

TyPanel, TyExPanel, TyScrollBox, TyChart, TyCalculator, TyBevel, TySizeBox, TyControlBar, TyCoolBar, TyColorGrid, TyShape, TyStarShape, TyArrow, TyImageView, TyImage, TyPreviewBox, TyListGroupPanel {
  background: alpha(#FFFFFF, 0);   /* fully transparent: the sharp photo shows clean (no frosted glass) */
  color: var(--on-surface);
  border-color: alpha(var(--border), 0.6);
  border-width: 1px;
  border-radius: var(--radius);
  padding: 8px;
}

TyComboBox {
  background: alpha(#FFFFFF, 0);
  color: var(--on-surface);
  border-color: alpha(var(--border), 0.6);
  border-width: 1px;
  border-radius: var(--radius);
  padding: 4px;
  font-size: 9px;
  glass-blur: 16px;
  glass-tint: alpha(var(--surface), 0.42);
}
TyComboBox:hover    { border-color: darken(--border, 10%); }
TyComboBox:focus    { border-color: var(--accent); outline: 2px var(--focus-ring); }
TyComboBox:disabled { opacity: 0.5; }

TyScrollBar {
  background: alpha(#FFFFFF, 0);   /* transparent track: photo shows through (overlay-scrollbar look) */
  color: var(--border);
  border-radius: 4px;
}
TyScrollBar:hover  { color: darken(--border, 15%); }
TyScrollBar:active { color: var(--accent); }
TyScrollBar:focus  { outline: 2px var(--focus-ring); }
TyScrollBar:disabled { opacity: 0.5; }

TyTitleBar, TyRibbonQuickAccess {
  background: alpha(#FFFFFF, 0);   /* fully transparent: sharp photo under the titlebar (no frost) */
  color: var(--on-surface);
  font-size: 9px;
  font-weight: 700;
}

TyCaptionButton {
  background: alpha(#FFFFFF, 0);
  color: var(--on-surface);
  border-radius: 0px;
}
TyCaptionButton:hover  { background: alpha(var(--surface), 0.55); }   /* translucent: photo shows under the titlebar */
TyCaptionButton:active { background: alpha(var(--surface), 0.75); }
TyCaptionButton.close:hover  { background: var(--danger); color: #FFFFFF; }
TyCaptionButton.close:active { background: darken(--danger, 10%); color: #FFFFFF; }
TyCaptionButton.min:hover    { background: alpha(var(--surface), 0.55); }
TyCaptionButton.max:hover    { background: alpha(var(--surface), 0.55); }

TyListBox, TyValueListEditor, TyRibbonGallery {
  background: alpha(#FFFFFF, 0);
  color: var(--on-surface);
  border-color: alpha(var(--border), 0.6);
  border-width: 1px;
  border-radius: var(--radius);
  padding: 2px;
  glass-blur: 16px;
  glass-tint: alpha(var(--surface), 0.42);
}
TyListBox:hover, TyValueListEditor:hover, TyRibbonGallery:hover   { border-color: darken(--border, 10%); }
TyListBox:focus, TyValueListEditor:focus, TyRibbonGallery:focus   { border-color: var(--accent); outline: 2px var(--focus-ring); }
TyListBox:disabled, TyValueListEditor:disabled, TyRibbonGallery:disabled { opacity: 0.5; }

TyListItem, TyValueListEditorRow {
  background: alpha(#000000, 0);
  color: var(--on-surface);
  border-radius: var(--radius);
  padding: 4px;
}
TyListItem:hover, TyValueListEditorRow:hover  { background: darken(--surface, 5%); }
TyListItem:active, TyValueListEditorRow:active { background: var(--accent); color: #FFFFFF; border-radius: 0; }

TyProgressBar {
  background: alpha(#FFFFFF, 0);
  border-color: alpha(var(--border), 0.6);
  border-width: 1px;
  border-radius: var(--radius);
  glass-blur: 16px;
  glass-tint: alpha(var(--surface), 0.25);
}
TyProgressBar:disabled { opacity: 0.5; }

TyProgressFill {
  background: var(--accent);
  border-radius: var(--radius);
}

TyGauge, TyActivityBar, TyActivityIndicator, TyAnalogClock, TyAnalogClockHand, TyCircularProgress, TyColorArea, TyDial, TyGearActivityIndicator, TyGearDial, TyGearDialTeeth, TyHSColorPicker, TyLColorPicker, TyLevelMeter, TyMeter, TyMeterTick, TyRating, TySparkline {
  background: alpha(var(--surface), 0.35);
  color: var(--on-surface);
  border-color: alpha(var(--border), 0.6);
  border-width: 1px;
  border-radius: var(--radius);
}
TyGauge:disabled, TyActivityBar:disabled, TyActivityIndicator:disabled, TyAnalogClock:disabled, TyAnalogClockHand:disabled, TyCircularProgress:disabled, TyColorArea:disabled, TyDial:disabled, TyGearActivityIndicator:disabled, TyGearDial:disabled, TyGearDialTeeth:disabled, TyHSColorPicker:disabled, TyLColorPicker:disabled, TyLevelMeter:disabled, TyMeter:disabled, TyMeterTick:disabled, TyRating:disabled, TySparkline:disabled { opacity: var(--disabled-opacity); }

TyGaugeFill, TyActivityBarFill, TyActivityIndicatorFill, TyAnalogClockSecondHand, TyCircularProgressFill, TyDialPointer, TyGearActivityIndicatorFill, TyGearDialPointer, TyLevelMeterFill, TyLevelMeterPeak, TyMeterNeedle, TyRatingStar, TySparklineDot, TySparklineFill {
  background: var(--accent);
  border-radius: var(--radius);
}

/* Themed tooltip surface (TTyHintWindow — replaces the native LCL hint).
   Green is a standalone theme (no shared var set) — literal border/font like TyGauge. */
TyHint {
  background: var(--surface);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: 1px;
  border-radius: var(--radius);
  padding: 5px 9px;
}

/* Ribbon (Phase-3): command band surface + labelled group box.
   Image theme: transparent body so the sharp photo shows through (like TyPanel/TyTabControl);
   the buttons carry their own opaque surface. Caption uses on-surface (not muted) to stay
   readable over the photo. */
TyRibbon, TyRibbonBackstage {
  background: alpha(#FFFFFF, 0);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: 1px;
  border-radius: 0;
}
TyRibbonGroup {
  background: alpha(#FFFFFF, 0);
  color: var(--on-surface);
  border-color: var(--border);
  border-width: 1px;
  font-size: 9px;   /* without this the caption font-size is 0 -> the group name is invisible */
}


TyToggleSwitch {
  background: darken(--surface, 18%);
  color: var(--on-surface);
  border-radius: 12px;
}
TyToggleSwitch:hover    { background: darken(--surface, 22%); }
TyToggleSwitch:active   { background: var(--accent); }
TyToggleSwitch:focus { outline: 2px var(--focus-ring); }
TyToggleSwitch:disabled { opacity: 0.5; }

TyTrackBar {
  background: alpha(#FFFFFF, 0);
  border-radius: 3px;
  padding: 0px;
  glass-blur: 16px;
  glass-tint: alpha(var(--surface), 0.25);
}
TyTrackBar:focus    { outline: 2px var(--focus-ring); }
TyTrackBar:disabled { opacity: 0.5; }

TyTrackThumb {
  background: var(--accent);
  border-radius: 8px;
}
TyTrackThumb:hover  { background: lighten(--accent, 8%); }
TyTrackThumb:active { background: darken(--accent, 8%); }

TyGroupBox, TyToolGroupPanel {
  padding: 4px 12px;
  background: alpha(#FFFFFF, 0);   /* fully transparent: sharp photo shows clean (no frost) */
  color: var(--on-surface);
  border-color: alpha(var(--border), 0.6);
  border-width: 1px;
  border-radius: var(--radius);
}

TyTabControl, TyTabSet {
  background: alpha(#FFFFFF, 0);   /* fully transparent: sharp photo shows clean (no frost) */
  color: var(--on-surface);
  border-color: alpha(var(--border), 0.6);
  border-width: 1px;
  border-radius: var(--radius);
}
TyTabControl:hover, TyTabSet:hover  { border-color: darken(--border, 10%); }
TyTabControl:focus, TyTabSet:focus  { border-color: var(--accent); outline: 2px var(--focus-ring); }
TyTabControl:disabled, TyTabSet:disabled { opacity: 0.5; }

/* Image theme: keep the page container + body transparent so the photo shows
   through (same intent as TyTabControl above — the frost/glass is deliberate). */
TyPageControl {
  background: alpha(#FFFFFF, 0);
  color: var(--on-surface);
  border-color: alpha(var(--border), 0.6);
  border-width: 1px;
  border-radius: var(--radius);
}
TyPageControl:hover  { border-color: darken(--border, 10%); }
TyPageControl:focus  { border-color: var(--accent); outline: 2px var(--focus-ring); }
TyPageControl:disabled { opacity: 0.5; }
TyTabSheet {
  background: alpha(#FFFFFF, 0);
}

TyTab {
  background: alpha(#FFFFFF, 0);   /* transparent: photo shows through the tabs (no frost) */
  color: var(--on-surface);
  padding: 4px;
  border-radius: var(--radius) var(--radius) 0 0;
}
TyTab:hover  { color: var(--accent); }
TyTab:active { color: var(--accent); font-weight: 700; }   /* active = accent + bold, no bg (photo shows) */

TySpinEdit {
  background: alpha(#FFFFFF, 0);
  color: var(--on-surface);
  border-color: alpha(var(--border), 0.6);
  border-width: 1px;
  border-radius: var(--radius);
  padding: 4px;
  font-size: 9px;
  glass-blur: 16px;
  glass-tint: alpha(var(--surface), 0.42);
}
TySpinEdit:hover    { border-color: darken(--border, 10%); }
TySpinEdit:focus    { border-color: var(--accent); outline: 2px var(--focus-ring); }
TySpinEdit:disabled { opacity: 0.5; }

TyMemo {
  background: alpha(#FFFFFF, 0);
  color: var(--on-surface);
  border-color: alpha(var(--border), 0.6);
  border-width: 1px;
  border-radius: var(--radius);
  padding: 4px;
  font-size: 9px;
  glass-blur: 16px;
  glass-tint: alpha(var(--surface), 0.42);
}
TyMemo:hover    { border-color: darken(--border, 10%); }
TyMemo:focus    { border-color: var(--accent); outline: 2px var(--focus-ring); }
TyMemo:disabled { opacity: 0.5; }

TyTextSelection { background: var(--selection); }
TyTextHint      { color: var(--muted); }
TyTabClose      { background: var(--overlay-hover); border-radius: var(--radius); }

TyScrollThumb { background: alpha(var(--on-surface), 0.50); border-radius: 4px; }   /* translucent thumb over the photo */
TyScrollThumb:hover  { background: alpha(var(--on-surface), 0.65); }
TyScrollThumb:active { background: var(--accent); }
TyToggleKnob  { background: #FFFFFF; border-radius: 12px; }

/* 数字角标 (TTyButton badge): accent 绿胶囊。 */
TyBadge {
  background: var(--accent);
  color: #FFFFFF;
  border-radius: 12px;
  font-size: 9px;
  font-weight: 700;
  padding: 0px 4px;
}

/* ── Lightweight trio ──────────────────────────────────────────────────── */

TySplitter {
  background: none;
  color: var(--muted);
}
TySplitter:hover {
  background: var(--surface-hover);
  color: var(--accent);
}

TyStatusBar {
  background: alpha(#FFFFFF, 0);   /* fully transparent: sharp photo shows clean (no frost) */
  color: var(--on-surface);
  border-color: var(--border);
  border-width: 1px;
  font-size: 9px;
  font-weight: 400;
}

TyToolBar, TyToolSeparator {
  background: alpha(#FFFFFF, 0);   /* fully transparent: sharp photo shows clean (no frost) */
  border-color: var(--border);
  border-width: 1px;
}

/* ── Calendar + DateTimePicker ─────────────────────────────────────────── */
/* green lacks several token aliases; concrete equivalents used below:
   --input-bg          = alpha(#FFFFFF, 0) (glass, matching TyEdit/TyComboBox)
   --surface-hover     = darken(--surface, 4%)
   --surface-chrome    = darken(--surface, 6%)
   --input-border-width= 1px
   --font-size-base    = 9px
   --font-weight-bold  = 700
   --input-border-hover= darken(--border, 10%)
   --disabled-opacity  = 0.5
   --radius-sm         = 3px
   --on-accent         = #FFFFFF                                         */

TyCalendar { background: alpha(#FFFFFF, 0); color: var(--on-surface); border-color: var(--border); border-width: 1px; border-radius: var(--radius); padding: 6px; font-size: 9px; glass-blur: 16px; glass-tint: alpha(var(--surface), 0.42); }
TyCalendarTitle { color: var(--on-surface); font-weight: 700; }
TyCalendarTitle:hover { color: var(--accent); }
TyCalendarWeekday { color: var(--muted); font-size: 9px; }
TyCalendarCell { background: none; color: var(--on-surface); border-radius: 3px; }
TyCalendarCell:hover { background: darken(--surface, 4%); }
TyCalendarCell:selected { background: var(--accent); color: #FFFFFF; }
TyCalendarCell:disabled { color: var(--muted); }
TyDateTimePicker { background: alpha(#FFFFFF, 0); color: var(--on-surface); border-color: var(--border); border-width: 1px; border-radius: var(--radius); padding: 4px 6px; font-size: 9px; glass-blur: 16px; glass-tint: alpha(var(--surface), 0.42); }
TyDateTimePicker:hover { border-color: darken(--border, 10%); }
TyDateTimePicker:focus { border-color: var(--accent); outline: 2px var(--focus-ring); }
TyDateTimePicker:disabled { opacity: 0.5; }
TyDateTimeButton { background: darken(--surface, 6%); color: var(--on-surface); }
TyDateTimeButton:hover { background: darken(--surface, 4%); color: var(--accent); }

/* ── TreeView ──────────────────────────────────────────────────────────── */
/* green lacks several token aliases; concrete equivalents used below:
   --input-bg          = alpha(#FFFFFF, 0) (glass, matching TyEdit/TyCalendar)
   --surface-hover     = darken(--surface, 4%)
   --input-border-width= 1px
   --font-size-base    = 9px
   --on-accent         = #FFFFFF                                            */

TyTreeView, TyListView { background: alpha(#FFFFFF, 0); color: var(--on-surface); border-color: var(--border); border-width: 1px; border-radius: var(--radius); padding: 2px; font-size: 9px; glass-blur: 16px; glass-tint: alpha(var(--surface), 0.42); }
TyTreeNode, TyListViewItem { background: none; color: var(--on-surface); }
TyTreeNode:hover, TyListViewItem:hover { background: darken(--surface, 4%); }
TyTreeNode:selected, TyListViewItem:selected { background: var(--accent); color: #FFFFFF; }
TyTreeNode:disabled, TyListViewItem:disabled { color: var(--muted); }
/* green lacks --surface-chrome/hover/active/font-weight-bold/font-size-base tokens;
   concrete equivalents: chrome=darken(--surface,6%), hover=darken(--surface,4%),
   active=darken(--surface,10%), bold=700, base=9px                               */
TyTreeHeader, TyListViewGroupHeader, TyListViewHeader, TyHeaderControl { background: darken(--surface, 6%); border-color: var(--border); border-width: 1px; color: var(--on-surface); font-size: 9px; font-weight: 700; }
TyTreeHeaderSection, TyListViewHeaderSection { background: none; color: var(--on-surface); border-color: var(--border); }
TyTreeHeaderSection:hover, TyListViewHeaderSection:hover { background: darken(--surface, 4%); }
TyTreeHeaderSection:selected, TyListViewHeaderSection:selected { background: darken(--surface, 10%); }
/* TyTreeCheckBox: green lacks --input-bg/--input-border-width/--radius-sm/--on-accent;
   concrete equivalents: input-bg=alpha(#FFFFFF,0) (glass), border-width=1px,
   radius-sm=3px, on-accent=#FFFFFF (green accent is deep green, luma<0.5)    */
TyTreeCheckBox, TyListViewCheckBox { background: alpha(#FFFFFF, 0); color: var(--on-surface); border-color: var(--border); border-width: 1px; border-radius: 3px; }
TyTreeCheckBox:active, TyListViewCheckBox:active   { background: var(--accent); color: #FFFFFF; border-color: var(--accent); }
TyTreeCheckBox:selected, TyListViewCheckBox:selected { background: var(--accent); color: #FFFFFF; border-color: var(--accent); }
TyTreeCheckBox:disabled, TyListViewCheckBox:disabled { color: var(--muted); }