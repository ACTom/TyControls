  }
 ],
 "encode": [
  {
   "in": "plain",
   "out": "plain"
  },
  {
   "in": "a<b>&c",
   "out": "a&lt;b&gt;&amp;c"
  },
  {
   "in": "\"quoted\" & 'single'",
   "out": "&quot;quoted&quot; &amp; &#39;single&#39;"
  },
  {
   "in": "<span style=\"color:red\">x</span>",
   "out": "&lt;span style=&quot;color:red&quot;&gt;x&lt;/span&gt;"
  },
  {
   "in": "&nbsp;",
   "out": "&amp;nbsp;"
  },
  {
   "in": "",
   "out": ""
  }
 ],
 "tpl": [
  {
   "id": "item",
   "tpl": "{a}<br/>{b}: {c}",
   "params": [
    {
     "seriesName": "s<1>",
     "name": "A&B",
     "value": 5
    }
   ],
   "out": "s&lt;1&gt;<br/>A&amp;B: 5"
  },
  {
   "id": "item-quotes",
   "tpl": "<b>{b}</b> {c} ({a})",
   "params": [
    {
     "seriesName": "it's \"q\"",
     "name": "<i>n</i>",
     "value": "x<y"
    }
   ],
   "out": "<b>&lt;i&gt;n&lt;/i&gt;</b> x&lt;y (it&#39;s &quot;q&quot;)"
  },
  {
   "id": "axis",
   "tpl": "{b0}<br/>{a0}: {c0}<br/>{a1}: {c1}",
   "params": [
    {
     "seriesName": "p&q",
     "name": "cat<1>",
     "value": 3
    },
    {
     "seriesName": "r>s",
     "name": "cat<1>",
     "value": 4
    }
   ],
   "out": "cat&lt;1&gt;<br/>p&amp;q: 3<br/>r&gt;s: 4"
  },
  {
   "id": "axis-short",
   "tpl": "{a}: {c} / {a1}: {c1}",
   "params": [
    {
     "seriesName": "one",
     "name": "c",
     "value": 1
    },
    {
     "seriesName": "<two>",
     "name": "c",
     "value": 2
    }
   ],
   "out": "one: 1 / &lt;two&gt;: 2"
  }
 ],
 "guards": [
  {
   "id": "mk-span",
   "ok": true,
   "what": "an item marker is the inline-block span"
  },
  {
   "id": "mk-sub",
   "ok": true,
   "what": "a sub-item marker is 4 x 4"
  },
  {
   "id": "enc-lt",
   "ok": true,
   "what": "encodeHTML escapes < > &"
  },
  {
   "id": "tpl-enc",
   "ok": true,
   "what": "formatTpl(.., true) encodes the values, not the template"
  }
 ]
}
